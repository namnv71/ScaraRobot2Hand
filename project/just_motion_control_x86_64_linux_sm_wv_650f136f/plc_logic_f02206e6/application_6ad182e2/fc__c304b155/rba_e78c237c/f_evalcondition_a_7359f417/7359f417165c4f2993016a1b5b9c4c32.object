{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7359f417-165c-4f29-9301-6a1b5b9c4c32","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_EvalCondition_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)e78c237c-5698-4814-b7d2-7c8b55d80bb7"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF (CondNo < 1) OR (CondNo > 100) THEN\n    F_EvalCondition_A := FALSE;\n    RETURN;\nEND_IF;\n\nIF NOT GVL_1.Condition_Cr_A[CondNo].Enable THEN\n    F_EvalCondition_A := FALSE;\n    RETURN;\nEND_IF;\n\nfirstRow := TRUE;\nfinalResult := FALSE;\n\nFOR i := 1 TO 10 DO\n\n    IF GVL_1.Condition_Cr_A[CondNo].Row[i].Enable THEN\n\n        rowResult := F_EvalCondRow_A(GVL_1.Condition_Cr_A[CondNo].Row[i]);\n\n        IF firstRow THEN\n            finalResult := rowResult;\n            firstRow := FALSE;\n        ELSE\n            CASE GVL_1.Condition_Cr_A[CondNo].Row[i - 1].LinkNext OF\n                1: finalResult := finalResult AND rowResult;\n                2: finalResult := finalResult OR rowResult;\n            ELSE\n                finalResult := finalResult AND rowResult;\n            END_CASE;\n        END_IF;\n\n    END_IF;\n\nEND_FOR;\n\nGVL_1.Condition_Cr_A[CondNo].Result := finalResult;\nF_EvalCondition_A := finalResult;","LineInfoPersistence":"(string)7359f417-165c-4f29-9301-6a1b5b9c4c32_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_EvalCondition_A : BOOL\nVAR_INPUT\n    CondNo : INT;\nEND_VAR\n\nVAR\n    i : INT;\n    rowResult : BOOL;\n    finalResult : BOOL;\n    firstRow : BOOL;\nEND_VAR","LineInfoPersistence":"(string)7359f417-165c-4f29-9301-6a1b5b9c4c32_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)48","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}