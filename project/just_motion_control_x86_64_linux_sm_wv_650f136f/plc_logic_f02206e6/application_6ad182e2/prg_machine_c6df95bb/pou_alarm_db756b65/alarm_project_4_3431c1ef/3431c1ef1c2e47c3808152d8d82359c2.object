{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)3431c1ef-1c2e-47c3-8081-52d8d82359c2","ParentGuid":"(Guid)db756b65-33fb-4b33-be88-afe9c51840fc","Name":"(string)Alarm_Project_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Loi Tin hieu SS Press may TS 1\nT_Alarm[50](IN:= ((POU_MOTION.Pro_MC1_4 = 10 AND NOT GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q)) , PT := T#5S); \nIF T_Alarm[50].Q THEN\n\tGVL.Alarm_P4.Alarm_TS_SS_Up := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_TS_SS_Up := FALSE;\nEND_IF\n\n// Loi Tin hieu SS Press may VS 1\nT_Alarm[51](IN:= ((POU_MOTION.Pro_MC2_4 = 10 AND NOT GVL.Pro4_.Signal_In.T_Vs_detect.Q)) , PT := T#5S); \nIF T_Alarm[51].Q THEN\n\tGVL.Alarm_P4.Alarm_VS_SS_JigOut := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_VS_SS_JigOut := FALSE;\nEND_IF\n\n// Loi Tin hieu Pass/Fail Press may TS\nT_Alarm[52](IN:= ((POU_MOTION.Pro_MC1_4 = 20 AND POU_MOTION.on_centering = 20 AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q AND NOT GVL.Pro4_.Signal_In.T_Ts_Pass.Q AND NOT GVL.Pro4_.Signal_In.T_Ts_Fail.Q)) , PT := T#10S); \nIF T_Alarm[52].Q THEN\n\tGVL.Alarm_P4.Alarm_TS_NG_Pass_Fail_Signal := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_TS_NG_Pass_Fail_Signal := FALSE;\nEND_IF\n\n// Loi Tin hieu Pass/Fail Press may VS\nT_Alarm[53](IN:= ((POU_MOTION.Pro_MC2_4 = 20 AND POU_MOTION.T_MC2_4.q AND GVL.Pro4_.Signal_In.T_Vs_detect.Q AND NOT GVL.Pro4_.Signal_In.T_Vs_Pass.Q AND NOT GVL.Pro4_.Signal_In.T_Vs_Fail.Q)) , PT := T#10S); \nIF T_Alarm[53].Q THEN\n\tGVL.Alarm_P4.Alarm_VS_NG_Pass_Fail_Signal := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_VS_NG_Pass_Fail_Signal := FALSE;\nEND_IF\n\n// Loi qua thoi gian test may Test song\nIF POU_MOTION.Pro_MC1_4 = 20 AND POU_MOTION.on_centering = 20 AND NOT GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q AND POU_MOTION.Ton_Limit_Test_TS.Q THEN\n\tGVL.Alarm_P4.Alarm_Limit_Test_TS := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_Limit_Test_TS := FALSE;\nEND_IF\n\n// Loi qua thoi gian test may vision\nIF POU_MOTION.Pro_MC2_4 = 20 AND POU_MOTION.T_MC2_4.q AND NOT GVL.Pro4_.Signal_In.T_Vs_detect.Q AND POU_MOTION.Ton_Limit_Test_VS.Q THEN\n\tGVL.Alarm_P4.Alarm_Limit_Test_VS := TRUE;\nELSE\n\tGVL.Alarm_P4.Alarm_Limit_Test_VS := FALSE;\nEND_IF\n\n// Loi ko co hang dau vao sau 3P\nT_Alarm[54]( IN:= GVL.X[27] AND POU_MOTION.RUN_PROJECT, PT := T#180S);\nIF T_Alarm[54].Q THEN\n\tGVL.Alarm_P4.Wait_Product_Input := TRUE;\nELSE\n\tGVL.Alarm_P4.Wait_Product_Input := FALSE;\nEND_IF\n\n// Loi khong do cduoc code may test song\nT_Alarm[55]( IN := GVL.Pro4_.Auto.Alarm_Not_barcode, PT := T#1S);\nIF T_Alarm[55].Q THEN\n\tGVL.Alarm_P4.Read_Barcode_TS := TRUE;\nELSE\n\tGVL.Alarm_P4.Read_Barcode_TS := FALSE;\nEND_IF\n\n// Loi khong doc duoc code may vision\nT_Alarm[56]( IN := GVL.Pro4_.Auto.Alarm_Not_barcode_VS, PT := T#1S);\nIF T_Alarm[56].Q THEN\n\tGVL.Alarm_P4.Read_Barcode_VS := TRUE;\nELSE\n\tGVL.Alarm_P4.Read_Barcode_VS := FALSE;\nEND_IF\n\n// Loi day hang bang tai NG\nT_Alarm[57]( IN:= NOT GVL.X[42] AND POU_MOTION.RUN_PROJECT, PT := T#5S);\nIF T_Alarm[57].Q THEN\n\tGVL.Alarm_P4.Full_NG_CONV := TRUE;\nELSE\n\tGVL.Alarm_P4.Full_NG_CONV := FALSE;\nEND_IF","LineInfoPersistence":"(string)3431c1ef-1c2e-47c3-8081-52d8d82359c2_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)77"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}