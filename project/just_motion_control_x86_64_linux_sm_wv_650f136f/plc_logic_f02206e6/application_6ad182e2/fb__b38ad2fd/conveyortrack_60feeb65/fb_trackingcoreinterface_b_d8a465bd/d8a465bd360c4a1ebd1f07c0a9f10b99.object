{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d8a465bd-360c-4a1e-bd1f-07c0a9f10b99","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_TrackingCoreInterface_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFB_TrackingCoreInterface_A\n\nMỤC ĐÍCH\n    Chuẩn hóa handshake giữa MultiTool Controller và\n    FB_CONVEYOR_TRACKING_MANAGER.\n===============================================================================\n*)\n\n//=============================================================================\n// BẮT CẠNH TÍN HIỆU\n//=============================================================================\nrtStart(CLK := StartTracking);\nrtCoreReleased(CLK := CoreReleased);\n\n\n//=============================================================================\n// OUTPUT MẶC ĐỊNH MỖI VÒNG QUÉT\n//=============================================================================\nResetToCore := FALSE;\nAbortToCore := FALSE;\nReleased := FALSE;\n\nAccepted := CoreAccepted AND xRequestLatched;\nBusy := CoreBusy AND xRequestLatched;\nSyncOK := CoreSyncOK AND xRequestLatched;\nPCSInUse := CorePCSInUse AND xRequestLatched;\nError := CoreError AND xRequestLatched;\n\n\nIF Error THEN\n    ErrorID := CoreErrorID;\nELSE\n    ErrorID := 0;\nEND_IF;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF Reset OR NOT Enable THEN\n    ExecuteToCore := FALSE;\n    ResetToCore := Reset;\n    AbortToCore := FALSE;\n    PickerSafeToCore := FALSE;\n    Released := FALSE;\n\n    xRequestLatched := FALSE;\n    xReleaseRequested := FALSE;\n    xCoreWasBusy := FALSE;\n    xCoreWasInUse := FALSE;\n\n    ActiveObjectIndex := 0;\n    ActiveToolID := 0;\n    ActivePickOffset.X := 0.0;\n    ActivePickOffset.Y := 0.0;\n    ActivePickOffset.Z := 0.0;\n    ActivePickOffset.A := 0.0;\n    ActiveApproachHeight := 0.0;\n\n    Accepted := FALSE;\n    Busy := FALSE;\n    SyncOK := FALSE;\n    PCSInUse := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\tActiveUseUpDown := FALSE;\n\tActiveUpDownStroke := 0.0;\n\tActivePickSurfaceHeightMM := 0.0;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// ABORT\n//=============================================================================\nIF Abort THEN\n    ExecuteToCore := FALSE;\n    ResetToCore := FALSE;\n    AbortToCore := TRUE;\n    PickerSafeToCore := FALSE;\n    Released := FALSE;\n\n    xRequestLatched := FALSE;\n    xReleaseRequested := FALSE;\n    xCoreWasBusy := FALSE;\n    xCoreWasInUse := FALSE;\n\n    Accepted := FALSE;\n    Busy := FALSE;\n    SyncOK := FALSE;\n    PCSInUse := FALSE;\n\t\n\tActiveUseUpDown := FALSE;\n\tActiveUpDownStroke := 0.0;\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// START TRACKING REQUEST\n//=============================================================================\nIF rtStart.Q AND NOT xRequestLatched THEN\n    IF ObjectIndex >= 1\n    AND ObjectIndex <= GVL.C_MAX_TRACK_OBJECTS THEN\n\n        ActiveObjectIndex := ObjectIndex;\n        ActiveToolID := ToolID;\n        ActivePickOffset := PickOffset;\n        ActiveApproachHeight := ApproachHeight;\n\t\tActivePickSurfaceHeightMM := PickSurfaceHeightMM;\n        ActiveUseUpDown := UseUpDown;\n        ActiveUpDownStroke := UpDownStroke;\n\n        xRequestLatched := TRUE;\n        xReleaseRequested := FALSE;\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// GIỮ EXECUTE TRONG TOÀN BỘ REQUEST\n//=============================================================================\nExecuteToCore := xRequestLatched;\n\n// Nhận yêu cầu release từ Controller.\nIF ReleaseTracking AND xRequestLatched THEN\n    xReleaseRequested := TRUE;\nEND_IF;\n\nPickerSafeToCore := xRequestLatched AND xReleaseRequested;\n\n// Chỉ đóng request khi Manager đã phát Released.\nIF rtCoreReleased.Q\nAND xRequestLatched\nAND xReleaseRequested THEN\n    Released := TRUE;\n    ExecuteToCore := FALSE;\n    PickerSafeToCore := FALSE;\n\n    xRequestLatched := FALSE;\n    xReleaseRequested := FALSE;\n\n    ActiveObjectIndex := 0;\n    ActiveToolID := 0;\n\t\n\tActiveUseUpDown := FALSE;\n\tActiveUpDownStroke := 0.0;\n\t\nEND_IF;","LineInfoPersistence":"(string)d8a465bd-360c-4a1e-bd1f-07c0a9f10b99_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_TrackingCoreInterface_B\nVAR_INPUT\n    Enable : BOOL; // Biến nội bộ Enable.\n    Reset : BOOL; // Biến nội bộ Reset.\n    Abort : BOOL; // Biến nội bộ Abort.\n    StartTracking : BOOL; // Biến nội bộ StartTracking.\n    ReleaseTracking : BOOL; // Biến nội bộ ReleaseTracking.\n    ObjectIndex : UINT; // Biến nội bộ ObjectIndex.\n    ToolID : UINT; // Biến nội bộ ToolID.\n    PickOffset : ST_POS; // Biến nội bộ PickOffset.\n    ApproachHeight : REAL; // Biến nội bộ ApproachHeight.\n    PickSurfaceHeightMM : REAL; // Biến nội bộ PickSurfaceHeightMM.\n    CoreAccepted : BOOL; // Biến nội bộ CoreAccepted.\n    CoreBusy : BOOL; // Biến nội bộ CoreBusy.\n    CoreSyncOK : BOOL; // Biến nội bộ CoreSyncOK.\n    CorePCSInUse : BOOL; // Biến nội bộ CorePCSInUse.\n    CoreReleased : BOOL; // Biến nội bộ CoreReleased.\n    CoreError : BOOL; // Biến nội bộ CoreError.\n    CoreErrorID : UDINT; // Biến nội bộ CoreErrorID.\n    UseUpDown : BOOL; // Biến nội bộ UseUpDown.\n    UpDownStroke : REAL; // Biến nội bộ UpDownStroke.\nEND_VAR\n\nVAR_OUTPUT\n    ExecuteToCore : BOOL; // Biến nội bộ ExecuteToCore.\n    ResetToCore : BOOL; // Biến nội bộ ResetToCore.\n    AbortToCore : BOOL; // Biến nội bộ AbortToCore.\n    PickerSafeToCore : BOOL; // Biến nội bộ PickerSafeToCore.\n    ActiveObjectIndex : UINT; // Biến nội bộ ActiveObjectIndex.\n    ActiveToolID : UINT; // Biến nội bộ ActiveToolID.\n    ActivePickOffset : ST_POS; // Biến nội bộ ActivePickOffset.\n    ActiveApproachHeight : REAL; // Biến nội bộ ActiveApproachHeight.\n    ActivePickSurfaceHeightMM : REAL; // Biến nội bộ ActivePickSurfaceHeightMM.\n    Accepted : BOOL; // Biến nội bộ Accepted.\n    Busy : BOOL; // Biến nội bộ Busy.\n    SyncOK : BOOL; // Biến nội bộ SyncOK.\n    PCSInUse : BOOL; // Biến nội bộ PCSInUse.\n    Released : BOOL; // Biến nội bộ Released.\n    Error : BOOL; // Biến nội bộ Error.\n    ErrorID : UDINT; // Biến nội bộ ErrorID.\n    ActiveUseUpDown : BOOL; // Biến nội bộ ActiveUseUpDown.\n    ActiveUpDownStroke : REAL; // Biến nội bộ ActiveUpDownStroke.\nEND_VAR\n\nVAR\n    rtStart : R_TRIG; // Biến nội bộ rtStart.\n    xRequestLatched : BOOL := FALSE; // Biến nội bộ xRequestLatched.\n    xReleaseRequested : BOOL := FALSE; // TRUE sau khi Controller yêu cầu kết thúc Tracking.\n    rtCoreReleased : R_TRIG; // Bắt cạnh lên của tín hiệu CoreReleased.\n    xCoreWasBusy : BOOL := FALSE; // Biến nội bộ xCoreWasBusy.\n    xCoreWasInUse : BOOL := FALSE; // Biến nội bộ xCoreWasInUse.\nEND_VAR\n","LineInfoPersistence":"(string)d8a465bd-360c-4a1e-bd1f-07c0a9f10b99_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)206","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}