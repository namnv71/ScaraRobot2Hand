{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)402196b4-f410-4fb8-83b5-2e6cb72a7beb","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_BuildMotionItem","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c304b155-f8a4-4830-84be-3896f6bf1eaf"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Lấy dữ liệu Step hiện tại\nStep := GVL_1.Step_Cr_A[StepNo];\n\n// Xóa dữ liệu cũ trong item\nitem.Cmd        := Step.Cmd;\nitem.SourceStep := StepNo;\nitem.PointNo    := 0;\nitem.MidPointNo := 0;\nitem.EndPointNo := 0;\nitem.Speed      := 0.0;\nitem.BlendMode  := 0;\nitem.BlendRadius := 0.0;\nitem.CircleMode := 0;\nitem.PathChoice := 0;\nitem.SkipPositionCheck := FALSE;\n\n// Phân tích theo từng loại lệnh Motion\nCASE Step.Cmd OF\n\n    // MovP / MovL\n    E_RobotCmd.CMD_MovP,\n    E_RobotCmd.CMD_MovL:\n\n        // P1 = Point No\n        item.PointNo := Step.P1;\n\n        // P2 = Speed override\n        // Nếu P2 = 0 thì FB sẽ dùng tốc độ từ Set Speed\n        IF Step.P2 > 0 THEN\n            item.Speed := INT_TO_LREAL(Step.P2);\n        END_IF;\n\n        // P3 = BlendMode\n        // 0=None, 1=TMCornerDistance, 2=TMStartVelocity\n        item.BlendMode := TO_INT(Step.P3);\n\n        // P4 = BlendRadius\n        item.BlendRadius := INT_TO_LREAL(Step.P4);\n\t\tIF F_IsMotionCmd(GVL_1.Step_Cr_A[StepNo + 1].Cmd) AND (GVL_1.Step_Cr_A[StepNo + 1].P3 >0) THEN\n\t\t\titem.SkipPositionCheck := TRUE;\n\t\tEND_IF\n\n    // MovC\n    E_RobotCmd.CMD_MovC:\n\n        // P1 = Mid Point\n        item.MidPointNo := Step.P1;\n\n        // P2 = End Point\n        item.EndPointNo := Step.P2;\n\n        // P3 = CircleMode\n        item.CircleMode := TO_INT(Step.P3);\n\n        // P4 = PathChoice\n        item.PathChoice := Step.P4;\n\n        // P5 = Speed override\n        IF Step.P5 > 0 THEN\n            item.Speed := INT_TO_LREAL(Step.P5);\n        END_IF;\n\t\t\n\t\tIF F_IsMotionCmd(GVL_1.Step_Cr_A[StepNo + 1].Cmd) AND (GVL_1.Step_Cr_A[StepNo + 1].P3 >0) THEN\n\t\t\titem.SkipPositionCheck := TRUE;\n\t\tEND_IF\n\nEND_CASE;\n\n// Trả item cho Motion Queue\nF_BuildMotionItem := item;","LineInfoPersistence":"(string)402196b4-f410-4fb8-83b5-2e6cb72a7beb_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_BuildMotionItem  : ST_MotionQueueItem // Tao motion item dua vào queue\nVAR_INPUT\n\tStepNo : INT;\nEND_VAR\nVAR\n\tStep    : ST_RobotStep;\n    item : ST_MotionQueueItem;\nEND_VAR\n","LineInfoPersistence":"(string)402196b4-f410-4fb8-83b5-2e6cb72a7beb_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)79","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}