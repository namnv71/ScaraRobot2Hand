{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f25c1841-7182-43e0-9c76-41e1268d1f75","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_PALLETS","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)MaxID := RowCount * ColCount * ZCount;\n{region \"1. KHOI TAO PUT/GET\"}\nIF NOT Enable THEN\n    CASE PalletMode OF\n        0:\n            CurrentID := 0;\n        1:\n            CurrentID := MaxID - 1;\n    END_CASE;\nEND_IF;\n{endregion}\t \n{region \"2. LOGIC INC/DEC ID\"}\nIncTrig(CLK := Inc);\nDecTrig(CLK := Dec);\n\nIF Enable THEN\n    CASE PalletMode OF\n\n        // ===== GET =====\n        0:\n            IF IncTrig.Q AND (CurrentID < MaxID - 1) THEN\n                CurrentID := CurrentID + 1;\n            END_IF;\n\n            IF DecTrig.Q AND (CurrentID > 0) THEN\n                CurrentID := CurrentID - 1;\n            END_IF;\n\n        // ===== PUT =====\n        1:\n            IF IncTrig.Q AND (CurrentID > 0) THEN\n                CurrentID := CurrentID - 1;\n            END_IF;\n\n            IF DecTrig.Q AND (CurrentID < MaxID - 1) THEN\n                CurrentID := CurrentID + 1;\n            END_IF;\n\n    END_CASE;\nEND_IF;\n{endregion}\t \n{region \"3. LOGIC ROW/COLUMN/ZCOUNT\"}\t \n// Z TRƯỚC\nIF ZOrder = 0 THEN\n\n    ZIndex := CurrentID MOD ZCount;\n\n    IF RowFirst AND  ZCount <> 0 THEN\n        ColIndex := (CurrentID / ZCount) MOD ColCount;\n        RowIndex := CurrentID / (ZCount * ColCount);\n    ELSIF NOT  RowFirst AND ZCount <> 0 THEN\n        RowIndex := (CurrentID / ZCount) MOD RowCount;\n        ColIndex := CurrentID / (ZCount * RowCount);\n    END_IF;\n\nEND_IF;\n// Z SAU\t \nIF ZOrder = 1 THEN\n\n    ZIndex := CurrentID / (RowCount * ColCount);\n\n    IF RowFirst AND ColCount <> 0 THEN\n        RowIndex := (CurrentID MOD (RowCount * ColCount)) / ColCount;\n        ColIndex := (CurrentID MOD (RowCount * ColCount)) MOD ColCount;\n    ELSIF NOT RowFirst AND  ColCount <> 0 THEN\n        ColIndex := (CurrentID MOD (RowCount * ColCount)) / RowCount;\n        RowIndex := (CurrentID MOD (RowCount * ColCount)) MOD RowCount;\n    END_IF;\n\nEND_IF;\n{endregion}\t \t \n{region \"4. CACULATOR XYZ\"}\t \nPosX := StartX + ColIndex * PitchCol;\nPosY := StartY + RowIndex * PitchRow;\nPosZ := StartZ + ZIndex * PitchZ;\n{endregion}","LineInfoPersistence":"(string)f25c1841-7182-43e0-9c76-41e1268d1f75_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_PALLETS\nVAR_INPUT\n    Enable      : BOOL;\n    Inc         : BOOL;\n    Dec         : BOOL;\n\n    PalletMode  : INT; // 0:= PUT / 1 := GET\n    ZOrder      : INT; //0:= Z trước hay 1:= Z sau\n    RowFirst    : BOOL;// TRUE = Row trước, FALSE = Col trước\n\n    RowCount    : INT;\n    ColCount    : INT;\n    ZCount      : INT;\n\n    PitchRow    : REAL;\n    PitchCol    : REAL;\n    PitchZ      : REAL;\n\n    StartX      : REAL;\n    StartY      : REAL;\n    StartZ      : REAL;\nEND_VAR\nVAR_OUTPUT\n    CurrentID   : INT;\n\n    RowIndex    : INT;\n    ColIndex    : INT;\n    ZIndex      : INT;\n\n    PosX        : REAL;\n    PosY        : REAL;\n    PosZ        : REAL;\n\n    MaxID       : INT;\nEND_VAR\nVAR\n    IncTrig : R_TRIG;\n    DecTrig : R_TRIG;\nEND_VAR\n","LineInfoPersistence":"(string)f25c1841-7182-43e0-9c76-41e1268d1f75_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)116","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}