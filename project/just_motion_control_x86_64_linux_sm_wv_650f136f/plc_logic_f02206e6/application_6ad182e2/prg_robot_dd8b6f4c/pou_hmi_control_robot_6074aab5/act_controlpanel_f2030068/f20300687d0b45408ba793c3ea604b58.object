{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f2030068-7d0b-4540-8ba7-93c3ea604b58","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_ControlPanel","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)/// Control panel 1\nSR1(SET1 := gvl.RB_A.Home_Lock_All OR (NOT GVL.RB_A.Home_Free_All AND GVL.RB_A.M1_goHome ) AND D_HMI_SCREEN = 20, \n\tRESET:= GVL.RB_A.Home_Free_All OR NOT GVL.RB_A.M1_goHome OR D_HMI_SCREEN <> 20,\n\tQ1 => GVL.RB_A.M1_goHome);\nSR2(SET1 := gvl.RB_A.Home_Lock_All OR (NOT GVL.RB_A.Home_Free_All AND GVL.RB_A.M2_goHome) AND D_HMI_SCREEN = 20, \n\tRESET:= GVL.RB_A.Home_Free_All OR NOT GVL.RB_A.M2_goHome OR D_HMI_SCREEN <> 20,\n\tQ1 => GVL.RB_A.M2_goHome);\nSR3(SET1 := gvl.RB_A.Home_Lock_All OR (NOT GVL.RB_A.Home_Free_All AND GVL.RB_A.M3_goHome) AND D_HMI_SCREEN = 20, \n\tRESET:= GVL.RB_A.Home_Free_All OR NOT GVL.RB_A.M3_goHome OR D_HMI_SCREEN <> 20,\n\tQ1 => GVL.RB_A.M3_goHome);\nSR4(SET1 := gvl.RB_A.Home_Lock_All OR (NOT GVL.RB_A.Home_Free_All AND GVL.RB_A.M4_goHome) AND D_HMI_SCREEN = 20, \n\tRESET:= GVL.RB_A.Home_Free_All OR NOT GVL.RB_A.M4_goHome OR D_HMI_SCREEN <> 20,\n\tQ1 => GVL.RB_A.M4_goHome);\n/// Control panel 2\nSR5(SET1 := gvl.RB_B.Home_Lock_All OR (NOT GVL.RB_B.Home_Free_All AND GVL.RB_B.M1_goHome) AND D_HMI_SCREEN = 30, \n\tRESET:= GVL.RB_B.Home_Free_All OR NOT GVL.RB_B.M1_goHome OR D_HMI_SCREEN <> 30,\n\tQ1 => GVL.RB_B.M1_goHome);\nSR6(SET1 := gvl.RB_B.Home_Lock_All OR (NOT GVL.RB_B.Home_Free_All AND GVL.RB_B.M2_goHome) AND D_HMI_SCREEN = 30, \n\tRESET:= GVL.RB_B.Home_Free_All OR NOT GVL.RB_B.M2_goHome OR D_HMI_SCREEN <> 30,\n\tQ1 => GVL.RB_B.M2_goHome);\nSR7(SET1 := gvl.RB_B.Home_Lock_All OR (NOT GVL.RB_B.Home_Free_All AND GVL.RB_B.M3_goHome) AND D_HMI_SCREEN = 30, \n\tRESET:= GVL.RB_B.Home_Free_All OR NOT GVL.RB_B.M3_goHome OR D_HMI_SCREEN <> 30,\n\tQ1 => GVL.RB_B.M3_goHome);\nSR8(SET1 := gvl.RB_B.Home_Lock_All OR (NOT GVL.RB_B.Home_Free_All AND GVL.RB_B.M4_goHome) AND D_HMI_SCREEN = 30, \n\tRESET:= GVL.RB_B.Home_Free_All OR NOT GVL.RB_B.M4_goHome OR D_HMI_SCREEN <> 30,\n\tQ1 => GVL.RB_B.M4_goHome);","LineInfoPersistence":"(string)f2030068-7d0b-4540-8ba7-93c3ea604b58_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)26"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}