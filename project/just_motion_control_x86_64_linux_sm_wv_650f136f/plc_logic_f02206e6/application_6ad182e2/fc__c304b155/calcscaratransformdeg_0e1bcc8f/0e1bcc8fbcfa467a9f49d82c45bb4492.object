{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)0e1bcc8f-bcfa-467a-9f49-d82c45bb4492","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)CalcScaraTransformDeg","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c304b155-f8a4-4830-84be-3896f6bf1eaf"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Tf.Valid := FALSE;\nTf.Error := FALSE;\nTf.ErrorID := 0;\nTf.CosT := 0.0;\nTf.SineT := 0.0;\nTf.ThetaDeg := 0.0;\nTf.Dx := 0.0;\nTf.Dy := 0.0;\nTf.Dz := 0.0;\nTf.DeltaR := 0.0;\n\nrefLen := SQRT(RefX*RefX + RefY*RefY);\nIF refLen < Eps THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 99;\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n\nrefUx := RefX / refLen;\nrefUy := RefY / refLen;\n\n// OLD Tinh vector P1_old-> P2_old\nvx_o := P2_old.X - P1_old.X;\nvy_o := P2_old.Y - P1_old.Y;\n// Kiem tra neu toa do 2 diem qua gan nhau\nlen_o := SQRT(vx_o*vx_o + vy_o*vy_o);\nIF len_o < Eps THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 1; // Loi 2 diem trung nhau\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n// tinh vector theo don vi 1\nux_o := vx_o / len_o;\nuy_o := vy_o / len_o;\n// Kiem tra xem huong P1_0ld -> p2_old co bi nguoc hay khong\ndot_o := ux_o*refUx + uy_o*refUy;\nIF dot_o <= 0.0 THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 2;\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n\n// Kiem tra P3 co dung huong khong\ncross_o := vx_o*(P3_old.Y - P1_old.Y) - vy_o*(P3_old.X - P1_old.X);\nIF cross_o <= Eps THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 3;\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n\n//theta_o_rad := ATAN(vy_o/vx_o);\ntheta_o_rad := MyATAN2(vy_o,vx_o);\ntheta_o_deg := FC_Rad_To_Deg(theta_o_rad);\n\n// NEW\nvx_n := P2_new.X - P1_new.X;\nvy_n := P2_new.Y - P1_new.Y;\n\nlen_n := SQRT(vx_n*vx_n + vy_n*vy_n);\nIF len_n < Eps THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 4;\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n\nux_n := vx_n / len_n;\nuy_n := vy_n / len_n;\n\ndot_n := ux_n*refUx + uy_n*refUy;\nIF dot_n <= 0.0 THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 5;\n    CalcScaraTransformDeg := Tf;\n    //RETURN;\nEND_IF;\n\ncross_n := vx_n*(P3_new.Y - P1_new.Y) - vy_n*(P3_new.X - P1_new.X);\nIF cross_n <= Eps THEN\n    Tf.Error := TRUE;\n    Tf.ErrorID := 6;\n    CalcScaraTransformDeg := Tf;\n    RETURN;\nEND_IF;\n\ntheta_n_rad := MyATAN2(vy_n,vx_n);\ntheta_n_deg := FC_Rad_To_Deg(theta_n_rad);\n\n// TRANSFORM\nTf.ThetaDeg := FC_NormalizeAngleDeg(theta_n_deg - theta_o_deg);\nTf.CosT := COS(FC_Deg_To_Rad(Tf.ThetaDeg));\nTf.SineT := SIN(FC_Deg_To_Rad(Tf.ThetaDeg));\n\nTf.Dx := P1_new.X - (P1_old.X*Tf.CosT - P1_old.Y*Tf.SineT);\nTf.Dy := P1_new.Y - (P1_old.X*Tf.SineT + P1_old.Y*Tf.CosT);\nTf.Dz := P1_new.Z - P1_old.Z;\n\nTf.DeltaR := FC_NormalizeAngleDeg(P1_new.A - (P1_old.A + Tf.ThetaDeg));\n\nTf.Valid := TRUE;\nTf.Error := FALSE;\nTf.ErrorID := 0;\n\nCalcScaraTransformDeg := Tf;","LineInfoPersistence":"(string)0e1bcc8f-bcfa-467a-9f49-d82c45bb4492_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION CalcScaraTransformDeg  : ST_ScaraTransformDeg\nVAR_INPUT\n\tP1_old : Pos_Coordsystem;\n    P2_old : Pos_Coordsystem;\n    P3_old : Pos_Coordsystem;\n\n    P1_new : Pos_Coordsystem;\n    P2_new : Pos_Coordsystem;\n    P3_new : Pos_Coordsystem;\n\n    RefX : LREAL;\n    RefY : LREAL;\n\n    Eps  : LREAL;\nEND_VAR\nVAR\n\tTf : ST_ScaraTransformDeg;\n\n    vx_o, vy_o : LREAL;\n    vx_n, vy_n : LREAL;\n    len_o, len_n : LREAL;\n\n    ux_o, uy_o : LREAL;\n    ux_n, uy_n : LREAL;\n\n    theta_o_rad, theta_n_rad : LREAL;\n    theta_o_deg, theta_n_deg : LREAL;\n\n    cross_o, cross_n : LREAL;\n    dot_o, dot_n : LREAL;\n\n    refLen : LREAL;\n    refUx  : LREAL;\n    refUy  : LREAL;\nEND_VAR\n","LineInfoPersistence":"(string)0e1bcc8f-bcfa-467a-9f49-d82c45bb4492_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)144","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}