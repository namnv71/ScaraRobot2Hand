{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)056518ed-ba66-4f0e-bc24-bedc14ec4812","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_RunMoveP","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//============================================================\n// FB_RunMoveP\n// Mục tiêu kiểm nghiệm:\n// - Execute được giữ đến khi SoftMotion nhận lệnh.\n// - Accepted được latch, không bị mất xung.\n// - Done được giữ đến khi MotionManager hạ Start.\n//============================================================\n\n//------------------------------------------------------------\n// Phát hiện cạnh lên Start\n//------------------------------------------------------------\nStartEdge := Start AND NOT LastStart;\nLastStart := Start;\n\n\n//------------------------------------------------------------\n// Giá trị mặc định của Execute\n// Execute sẽ được bật trong MOVE_SEND và MOVE_WAIT_ACCEPT\n//------------------------------------------------------------\nExecutePulse := FALSE;\n\n\n//============================================================\n// STATE MACHINE\n//============================================================\nCASE State OF\n\n\t//========================================================\n\t// IDLE\n\t//========================================================\n\tE_MoveState.MOVE_IDLE:\n\n\t\t// Output trạng thái\n\t\tAccepted := FALSE;\n\t\tDone := FALSE;\n\t\tError := FALSE;\n\t\tTimeout := FALSE;\n\t\tAborted := FALSE;\n\t\tRelease := FALSE;\n \n\t\tErrorID_Custom := 0;\n\n\t\t// Reset timer\n\t\ttAcceptTimeout(IN := FALSE);\n\t\ttMoveTimeout(IN := FALSE);\n\t\ttPosCheckDelay(IN := FALSE);\n\n//         IF StartEdge THEN\n\t\tIF Start AND NOT fbMoveP.Busy AND NOT fbMoveP.Active THEN\t\n\t\t\t//------------------------------------------------\n\t\t\t// Chốt tọa độ tại thời điểm bắt đầu\n\t\t\t//------------------------------------------------\n\t\t\tPosBuf := PositionIn;\n\n\t\t\t//------------------------------------------------\n\t\t\t// MoveP dùng các hệ số Factor\n\t\t\t//------------------------------------------------\n\t\t\t\n\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n\t\t\t\tVelFacLocal    := GVL_1.DATA_RB_A.Fac_Vel;\n\t\t\t\tAccFacLocal    := GVL_1.DATA_RB_A.Fac_Acc;\n\t\t\t\tJerkFacLocal   := GVL_1.DATA_RB_A.Fac_Jerk;\n\t\t\t\tTorqueFacLocal := GVL_1.DATA_RB_A.Fac_Torque;\n\t\t\tELSE\n\t\t\t\tVelFacLocal    := GVL_1.DATA_RB_B.Fac_Vel;\n\t\t\t\tAccFacLocal    := GVL_1.DATA_RB_B.Fac_Acc;\n\t\t\t\tJerkFacLocal   := GVL_1.DATA_RB_B.Fac_Jerk;\n\t\t\t\tTorqueFacLocal := GVL_1.DATA_RB_B.Fac_Torque;\n\t\t\tEND_IF\n\n\t\t\t//------------------------------------------------\n\t\t\t// Giá trị dự phòng an toàn\n\t\t\t//------------------------------------------------\n\t\t\tIF VelFacLocal <= 0.0 THEN\n\t\t\t\tVelFacLocal := 0.1;\n\t\t\tEND_IF;\n\n\t\t\tIF AccFacLocal <= 0.0 THEN\n\t\t\t\tAccFacLocal := 0.1;\n\t\t\tEND_IF;\n\n\t\t\tIF JerkFacLocal <= 0.0 THEN\n\t\t\t\tJerkFacLocal := 0.1;\n\t\t\tEND_IF;\n\n\t\t\tIF TorqueFacLocal <= 0.0 THEN\n\t\t\t\tTorqueFacLocal := 0.1;\n\t\t\tEND_IF;\n\n\t\t\t//------------------------------------------------\n\t\t\t// Mapping Blend\n\t\t\t//------------------------------------------------\n\t\t\tIF (Item.BlendMode = 0)\n\t\t\t   OR (Item.BlendRadius <= 0.0)\n\t\t\tTHEN\n\t\t\t\t// Không blend\n\t\t\t\tBufferMode := C_BM_Buffered;\n\t\t\t\tTransMode := C_TM_None;\n\n\t\t\t\tTransParam[0] := 0.0;\n\t\t\t\tTransParam[1] := 0.0;\n\n\t\t\tELSE\n\t\t\t\t// Có blend\n\t\t\t\t//BufferMode := C_BM_BlendingNext;\n\t\t\t\tBufferMode := GVL.C_BM_BlendingHigh;\n\n\t\t\t\tCASE Item.BlendMode OF\n\n\t\t\t\t\t1:\n\t\t\t\t\t\tTransMode := C_TM_CornerDistance;\n\n\t\t\t\t\t2:\n\t\t\t\t\t\tTransMode := C_TM_StartVelocity;\n\n\t\t\t\tELSE\n\t\t\t\t\tTransMode := C_TM_CornerDistance;\n\n\t\t\t\tEND_CASE;\n\n\t\t\t\tTransParam[0] := Item.BlendRadius;\n\t\t\t\tTransParam[1] := 0.0;\n\t\t\tEND_IF;\n\n\t\t\t//------------------------------------------------\n\t\t\t// Reset output cho lệnh mới\n\t\t\t//------------------------------------------------\n\t\t\tAccepted := FALSE;\n\t\t\tDone := FALSE;\n\t\t\tError := FALSE;\n\t\t\tTimeout := FALSE;\n\t\t\tAborted := FALSE;\n\t\t\tErrorID_Custom := 0;\n\n\t\t\t//------------------------------------------------\n\t\t\t// Chuyển sang gửi lệnh\n\t\t\t//------------------------------------------------\n\t\t\tState := E_MoveState.MOVE_SEND;\n\n\t\tEND_IF;\n\n\n\t//========================================================\n\t// SEND COMMAND\n\t//========================================================\n\tE_MoveState.MOVE_SEND:\n\n\t\t// Giữ Execute TRUE\n\t\tExecutePulse := TRUE;\n\n\t\t// Bắt đầu timeout nhận lệnh\n\t\ttAcceptTimeout(\n\t\t\tIN := TRUE,\n\t\t\tPT := AcceptTimeoutTime\n\t\t);\n\n\t\tState := E_MoveState.MOVE_WAIT_ACCEPT;\n\n\n\t//========================================================\n\t// WAIT COMMAND ACCEPTED\n\t//========================================================\n\tE_MoveState.MOVE_WAIT_ACCEPT:\n\n\t\t//--------------------------------------------------------\n\t// Giữ Execute TRUE cho đến khi SoftMotion xác nhận\n\t// đã nhận đúng lệnh mới\n\t//--------------------------------------------------------\n\tExecutePulse := TRUE;\n\n\ttAcceptTimeout(\n\t\tIN := TRUE,\n\t\tPT := AcceptTimeoutTime\n\t);\n\n\t//--------------------------------------------------------\n\t// Chỉ CommandAccepted mới được coi là Accepted.\n\t// Không dùng Busy/Active vì có thể là trạng thái còn lại\n\t// của chuyển động trước.\n\t//--------------------------------------------------------\n\tIF fbMoveP.CommandAccepted THEN\n\n\t\tAccepted := TRUE;\n\t\tExecutePulse := FALSE;\n\n\t\ttAcceptTimeout(IN := FALSE);\n\n\t\ttMoveTimeout(\n\t\t\tIN := TRUE,\n\t\t\tPT := MoveTimeoutTime\n\t\t);\n\n\t\tState := E_MoveState.MOVE_WAIT_DONE;\n\n\tELSIF fbMoveP.CommandAborted THEN\n\n\t\tExecutePulse := FALSE;\n\n\t\tAborted := TRUE;\n\t\tError := TRUE;\n\t\tErrorID_Custom := 5003;\n\n\t\ttAcceptTimeout(IN := FALSE);\n\t\tState := E_MoveState.MOVE_ABORTED;\n\n\tELSIF fbMoveP.Error THEN\n\n\t\tExecutePulse := FALSE;\n\n\t\tError := TRUE;\n\t\tErrorID := fbMoveP.ErrorID;\n\t\tErrorID_Custom := 5004;\n\n\t\ttAcceptTimeout(IN := FALSE);\n\t\tState := E_MoveState.MOVE_ERROR;\n\n\tELSIF tAcceptTimeout.Q THEN\n\n\t\tExecutePulse := FALSE;\n\n\t\tTimeout := TRUE;\n\t\tError := TRUE;\n\t\tErrorID_Custom := 5005;\n\n\t\ttAcceptTimeout(IN := FALSE);\n\t\tState := E_MoveState.MOVE_TIMEOUT;\n\n\tEND_IF;\n\n\n\t//========================================================\n\t// WAIT MOTION DONE\n\t//========================================================\n\tE_MoveState.MOVE_WAIT_DONE:\n\n\t\t// Giữ Accepted để MotionManager chắc chắn đọc được\n\t\tAccepted := TRUE;\n\n\t\tExecutePulse := FALSE;\n\n\t\ttMoveTimeout(\n\t\t\tIN := TRUE,\n\t\t\tPT := MoveTimeoutTime\n\t\t);\n\n\t\tIF fbMoveP.Done THEN\n\n\t\t\ttMoveTimeout(IN := FALSE);\n\t\t\t//DonePosition := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t//------------------------------------------------\n\t\t\t// Không blend: kiểm tra vị trí cuối\n\t\t\t//------------------------------------------------\n\t\t\t//IF ((Item.BlendMode = 0) OR (Item.BlendRadius <= 0.0)) AND (NOT Item.SkipPositionCheck) THEN\n\t\t\tIF (NOT Item.SkipPositionCheck) THEN\n\t\t\t\ttPosCheckDelay(\n\t\t\t\t\tIN := TRUE,\n\t\t\t\t\tPT := PosCheckDelayTime\n\t\t\t\t);\n\n\t\t\t\tState := E_MoveState.MOVE_CHECK_POS;\n\t\t\t\t//State := E_MoveState.MOVE_DONE;\n\t\t\tELSE\n\t\t\t\t// Điểm blend không bắt buộc robot dừng chính xác\n\t\t\t\tState := E_MoveState.MOVE_DONE;\n\t\t\tEND_IF;\n\n\t\tELSIF fbMoveP.CommandAborted THEN\n\n\t\t\tAborted := TRUE;\n\t\t\tError := TRUE;\n\t\t\tErrorID_Custom := 5003;\n\n\t\t\ttMoveTimeout(IN := FALSE);\n\n\t\t\tState := E_MoveState.MOVE_ABORTED;\n\n\t\tELSIF fbMoveP.Error THEN\n\n\t\t\tError := TRUE;\n\t\t\tErrorID := fbMoveP.ErrorID;\n\t\t\tErrorID_Custom := 5004;\n\n\t\t\ttMoveTimeout(IN := FALSE);\n\n\t\t\tState := E_MoveState.MOVE_ERROR;\n\n\t\tELSIF tMoveTimeout.Q THEN\n\n\t\t\tTimeout := TRUE;\n\t\t\tError := TRUE;\n\t\t\tErrorID_Custom := 5006;\n\n\t\t\ttMoveTimeout(IN := FALSE);\n\n\t\t\tState := E_MoveState.MOVE_TIMEOUT;\n\n\t\tEND_IF;\n\n\n\t//========================================================\n\t// CHECK FINAL POSITION\n\t//========================================================\n\tE_MoveState.MOVE_CHECK_POS:\n\n\t\tAccepted := TRUE;\n\n\t\ttPosCheckDelay(\n\t\t\tIN := TRUE,\n\t\t\tPT := PosCheckDelayTime\n\t\t);\n\n\t\tIF tPosCheckDelay.Q THEN\n\n\t\t\ttPosCheckDelay(IN := FALSE);\n// \t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n// \t\t\t\tDonePosition := POU_MONITOR_ROBOT.RB1_POS;\n// \t\t\tELSE\n// \t\t\t\tDonePosition := POU_MONITOR_ROBOT.RB2_POS;\n// \t\t\tEND_IF\n\t\t\t\n\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n\t\t\t\tIF CoordSystem = SMC_COORD_SYSTEM.ACS THEN\n\t\t\t\t\tDonePosition := POU_MONITOR_ROBOT.RB1_POS_ACS;\n\t\t\t\tELSE\n\t\t\t\t\tDonePosition := POU_COORDINATE_.Pos_Out_A_MCS;\n\t\t\t\tEND_IF;\n\t\t\tELSE\n\t\t\t\tIF CoordSystem = SMC_COORD_SYSTEM.ACS THEN\n\t\t\t\t\tDonePosition := POU_MONITOR_ROBOT.RB2_POS_ACS;\n\t\t\t\tELSE\n\t\t\t\t\tDonePosition := POU_COORDINATE_.Pos_Out_B_MCS;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\tEND_IF;\n\n\t\t\tIF F_CheckPositionReached(\n\t\t\t\tTarget := PosBuf,\n\t\t\t\t//Actual := POU_MONITOR_ROBOT.RB1_POS,\n\t\t\t\tActual := DonePosition,\n\t\t\t\tTolXYZ := GVL.MotionTolXYZ,\n\t\t\t\tTolR := GVL.MotionTolR\n\t\t\t) THEN\n\t\t\t\tState := E_MoveState.MOVE_DONE;\n\n\t\t\tELSE\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID_Custom := 5001;\n\t\t\t\tState := E_MoveState.MOVE_ERROR;\n\t\t\tEND_IF;\n\t\t\t\n\n\t\tEND_IF;\n\n\n\t//========================================================\n\t// DONE\n\t//========================================================\n\tE_MoveState.MOVE_DONE:\n\n\t\t//--------------------------------------------------------\n\t\t// Giữ Done để MotionManager chắc chắn đọc được\n\t\t//--------------------------------------------------------\n\t\tAccepted := TRUE;\n\t\tDone := TRUE;\n\t\tExecutePulse := FALSE;\n\t\t\n\t\t//--------------------------------------------------------\n\t\t// Sau khi MotionManager hạ Start và FB gốc đã rảnh,\n\t\t// wrapper được phép trở về IDLE.\n\t\t//\n\t\t// Không hạ Done tại đây; MOVE_IDLE sẽ reset ở scan sau.\n\t\t//--------------------------------------------------------\n\t\tIF NOT Start\n\t\t   AND NOT fbMoveP.Busy\n\t\t   AND NOT fbMoveP.Active\n\t\tTHEN\n\t\t\tState := E_MoveState.MOVE_IDLE;\n\t\tEND_IF;\n// \t\tIF Release THEN\n// \t\t\tAccepted := FALSE;\n// \t\t\tDone := FALSE;\n// \t\t\tState := E_MoveState.MOVE_IDLE;\n// \t\t\t\n// \t\tEND_IF\n\n\n\n\t//========================================================\n\t// ERROR\n\t//========================================================\n\tE_MoveState.MOVE_ERROR:\n\n\t\tError := TRUE;\n\n\t\tIF NOT Start THEN\n\t\t\tState := E_MoveState.MOVE_IDLE;\n\t\tEND_IF;\n\n\n\t//========================================================\n\t// TIMEOUT\n\t//========================================================\n\tE_MoveState.MOVE_TIMEOUT:\n\n\t\tError := TRUE;\n\t\tTimeout := TRUE;\n\n\t\tIF NOT Start THEN\n\t\t\tState := E_MoveState.MOVE_IDLE;\n\t\tEND_IF;\n\n\n\t//========================================================\n\t// ABORTED\n\t//========================================================\n\tE_MoveState.MOVE_ABORTED:\n\n\t\tError := TRUE;\n\t\tAborted := TRUE;\n\n\t\tIF NOT Start THEN\n\t\t\tState := E_MoveState.MOVE_IDLE;\n\t\tEND_IF;\n\nEND_CASE;\n\n//============================================================\n// GỌI FB GỐC MỖI SCAN\n//============================================================\nfbMoveP(\n    AxisGroup := AxisGroup,\n    Execute := ExecutePulse,\n\n    Position := PosBuf,\n    CoordSystem := CoordSystem,\n\n    BufferMode := BufferMode,\n    TransitionMode := TransMode,\n    TransitionParameter := TransParam,\n\n    VelFactor := VelFacLocal,\n    AccFactor := AccFacLocal,\n    JerkFactor := JerkFacLocal,\n    TorqueFactor := TorqueFacLocal\n);\n\n\n//============================================================\n// PHẢN HỒI TRẠNG THÁI FB GỐC\n//============================================================\nBusy := fbMoveP.Busy;\nActive := fbMoveP.Active;","LineInfoPersistence":"(string)056518ed-ba66-4f0e-bc24-bedc14ec4812_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_RunMoveP\nVAR_INPUT\n    Start       : BOOL;\n    Item        : ST_MotionQueueItem;\n    PositionIn  : SMC_POS_REF;\n    CoordSystem : SMC_COORD_SYSTEM;\n    AcceptTimeoutTime : TIME := T#2S;\n    MoveTimeoutTime   : TIME := T#100S;\n    PosCheckDelayTime : TIME := T#13MS;\nEND_VAR\nVAR_IN_OUT\n\tAxisGroup   : AXIS_GROUP_REF_SM3;\n\tRelease : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Accepted       : BOOL;\n    Done           : BOOL;\n    Busy           : BOOL;\n    Active         : BOOL;\n    Error          : BOOL;\n    Timeout        : BOOL;\n    Aborted        : BOOL;\n    ErrorID        : SMC_ERROR;\n    ErrorID_Custom : INT;\n    State          : E_MoveState;\nEND_VAR\n\nVAR\n    fbMoveP : MC_MoveDirectAbsolute;\n\n    tAcceptTimeout : TON;\n    tMoveTimeout   : TON;\n    tPosCheckDelay : TON;\n\n    StartEdge    : BOOL;\n    LastStart    : BOOL;\n    ExecutePulse : BOOL;\n\n    PosBuf : SMC_POS_REF;\n\tDonePosition : SM3_Robotics.SMC_POS_REF;\n    BufferMode : SM3_Robotics.MC_BUFFER_MODE;\n    TransMode  : SM3_Robotics.MC_TRANSITION_MODE;\n    TransParam : ARRAY[0..(SMC_RCNST.MAX_TRANS_PARAMS - 1)] OF LREAL := [0.0, 0.0];\n\n    VelFacLocal    : LREAL;\n    AccFacLocal    : LREAL;\n    JerkFacLocal   : LREAL;\n    TorqueFacLocal : LREAL;\nEND_VAR\n\nVAR CONSTANT\n    C_BM_Buffered     : SM3_Robotics.MC_BUFFER_MODE := 1;\n    C_BM_BlendingNext : SM3_Robotics.MC_BUFFER_MODE := 4;\n\n    C_TM_CornerDistance : SM3_Robotics.MC_TRANSITION_MODE := 2;\n    C_TM_None           : SM3_Robotics.MC_TRANSITION_MODE := 0;\n    C_TM_StartVelocity  : SM3_Robotics.MC_TRANSITION_MODE := 1;\nEND_VAR","LineInfoPersistence":"(string)056518ed-ba66-4f0e-bc24-bedc14ec4812_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)510","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}