{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)cf43fec5-6fe3-4511-9082-e187a283768d","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionAlign_1","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)455bb68e-496e-4125-829d-ed46387b0a41"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_VisionAlign\n//-----------------------------------------------------------------------------\n// Chức năng:\n// 1. Trigger Camera.\n// 2. Chờ Vision Result đúng TriggerID.\n// 3. Kiểm tra Valid / Score.\n// 4. Có thể Bypass kiểm tra X/Y/A khi test.\n// 5. Kiểm tra MaxOffset.\n// 6. Kiểm tra Tolerance.\n// 7. Xuất NeedCorrectionMove nếu Robot cần chạy hiệu chỉnh.\n//\n// LƯU Ý:\n// - Phiên bản này CHƯA tự chạy Motion.\n// - RobotOffset hiện đang dùng trực tiếp RawOffset.\n// - Sau khi test flow ổn sẽ bổ sung Camera -> Robot Transform.\n//=============================================================================\n\n\n//=============================================================================\n// 1. FB TRIGGER VISION\n//=============================================================================\nfbTriggerVS(\n    Enable := Enable,\n    Start := xStartTrigger,\n    CameraID := CameraID,\n    JobID := JobID,\n    Application := E_VisionApplication.VIS_APP_ALIGN,\n    count_Vs_Align_max := TriggerRetryMax,\n    T_Delay_Trigger_time := TriggerDelayTime,\n    Trigger_Again := FALSE,\n    Pass_Triger_VS_NG := FALSE,\n    Mode_ByPass_VS := FALSE\n);\n\nCurrentTriggerID := fbTriggerVS.CurrentTriggerID;\n\n\n//=============================================================================\n// 2. FB WAIT VISION RESULT\n//=============================================================================\nfbWaitResult(\n    Enable := Enable,\n    Start := xStartWaitResult,\n    CameraID := CameraID,\n    ExpectedTriggerID := CurrentTriggerID,\n    ExpectedJobID := JobID,\n    ExpectedApplication := E_VisionApplication.VIS_APP_ALIGN\n);\n\n\n//=============================================================================\n// 3. DISABLE\n//=============================================================================\nIF NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n\n    Busy := FALSE;\n    Done := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    xStartTrigger := FALSE;\n    xStartWaitResult := FALSE;\n\n    CurrentTriggerID := 0;\n\n    ResultValid := FALSE;\n    ResultScore := 0.0;\n    ResultFeatureID := 0;\n    ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n\n    RawOffsetX := 0.0;\n    RawOffsetY := 0.0;\n    RawOffsetA := 0.0;\n\n    RobotOffsetX := 0.0;\n    RobotOffsetY := 0.0;\n    RobotOffsetA := 0.0;\n\n    InTolerance := FALSE;\n    NeedCorrectionMove := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// 4. STATE MACHINE\n//=============================================================================\nCASE State OF\n\n\n    //=========================================================================\n    // 0 - IDLE\n    //-------------------------------------------------------------------------\n    // Chờ cạnh lên của Start.\n    //=========================================================================\n    0:\n        Busy := FALSE;\n        Done := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        ResultValid := FALSE;\n        ResultScore := 0.0;\n        ResultFeatureID := 0;\n        ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n\n        RawOffsetX := 0.0;\n        RawOffsetY := 0.0;\n        RawOffsetA := 0.0;\n\n        RobotOffsetX := 0.0;\n        RobotOffsetY := 0.0;\n        RobotOffsetA := 0.0;\n\n        InTolerance := FALSE;\n        NeedCorrectionMove := FALSE;\n\n        IF Start AND NOT StartOld THEN\n\n            // Kiểm tra CameraID trước khi truy cập Array Vision.\n            IF CameraID < 1 OR CameraID > GVL.C_MAX_VISION_CHANNELS THEN\n                Error := TRUE;\n                ErrorID := 1;                   // CameraID không hợp lệ.\n                State := 900;\n\n            ELSE\n                Busy := TRUE;\n                xStartTrigger := TRUE;\n                State := 10;\n            END_IF;\n\n        END_IF;\n\n\n    //=========================================================================\n    // 10 - WAIT TRIGGER DONE\n    //-------------------------------------------------------------------------\n    // Chờ FB_TriggerVS hoàn tất Trigger handshake.\n    //=========================================================================\n    10:\n        Busy := TRUE;\n\n        IF fbTriggerVS.Error THEN\n            xStartTrigger := FALSE;\n\n            Error := TRUE;\n            ErrorID := 100 + fbTriggerVS.ErrorID;\n            State := 900;\n\n        ELSIF fbTriggerVS.DoneAll THEN\n            xStartTrigger := FALSE;\n\n            // Bắt đầu chờ Result của đúng Trigger vừa phát.\n            xStartWaitResult := TRUE;\n            State := 20;\n        END_IF;\n\n\n    //=========================================================================\n    // 20 - WAIT RESULT\n    //-------------------------------------------------------------------------\n    // Chờ Vision Result có cùng:\n    // - CameraID\n    // - JobID\n    // - Application\n    // - TriggerID\n    //=========================================================================\n    20:\n        Busy := TRUE;\n\n        IF fbWaitResult.Error THEN\n            xStartWaitResult := FALSE;\n\n            Error := TRUE;\n            ErrorID := 200 + fbWaitResult.ErrorID;\n            State := 900;\n\n        ELSIF fbWaitResult.Done THEN\n            xStartWaitResult := FALSE;\n\n            //-----------------------------------------------------------------\n            // Lưu thông tin chung của Result.\n            //-----------------------------------------------------------------\n            ResultValid := fbWaitResult.ResultValid;\n            ResultScore := fbWaitResult.ResultScore;\n            ResultFeatureID := fbWaitResult.ResultFeatureID;\n            ResultStatus := fbWaitResult.ResultStatus;\n\n            //-----------------------------------------------------------------\n            // MODE TEST:\n            // Không dùng X/Y/A Vision.\n            // Ép toàn bộ Offset = 0 để test handshake nhanh.\n            //-----------------------------------------------------------------\n            IF BypassOffsetCheck THEN\n                RawOffsetX := 0.0;\n                RawOffsetY := 0.0;\n                RawOffsetA := 0.0;\n\n            //-----------------------------------------------------------------\n            // MODE NORMAL:\n            // Lấy dữ liệu X/Y/A thực tế từ Vision.\n            //-----------------------------------------------------------------\n            ELSE\n                RawOffsetX := fbWaitResult.ResultX;\n                RawOffsetY := fbWaitResult.ResultY;\n                RawOffsetA := fbWaitResult.ResultA;\n            END_IF;\n\n            State := 30;\n        END_IF;\n\n\n    //=========================================================================\n\t// 30 - CHECK RESULT\n\t//-------------------------------------------------------------------------\n\t// BypassOffsetCheck = TRUE:\n\t// - Dùng để test handshake Vision.\n\t// - Không kiểm tra ResultValid.\n\t// - Không kiểm tra X/Y/A.\n\t// - Score chỉ kiểm tra khi CheckScore = TRUE.\n\t//\n\t// BypassOffsetCheck = FALSE:\n\t// - Chạy normal.\n\t// - Bắt buộc ResultValid = TRUE.\n\t// - Kiểm tra Score.\n\t// - Kiểm tra giới hạn X/Y/A.\n\t//=========================================================================\n\t30:\n\t\t//-------------------------------------------------------------------------\n\t\t// MODE TEST HANDSHAKE\n\t\t//-------------------------------------------------------------------------\n\t\tIF BypassOffsetCheck THEN\n\t\n\t\t\t// Có thể vẫn kiểm tra Score nếu người dùng yêu cầu.\n\t\t\tIF CheckScore AND ResultScore < MinScore THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 302;                      // Score thấp hơn MinScore.\n\t\t\t\tState := 900;\n\t\t\tELSE\n\t\t\t\t// Không kiểm tra Valid/X/Y/A trong mode test.\n\t\t\t\tRawOffsetX := 0.0;\n\t\t\t\tRawOffsetY := 0.0;\n\t\t\t\tRawOffsetA := 0.0;\n\t\t\t\tState := 40;\n\t\t\tEND_IF;\n\t\n\t\t//-------------------------------------------------------------------------\n\t\t// MODE NORMAL\n\t\t//-------------------------------------------------------------------------\n\t\tELSE\n\t\n\t\t\tIF NOT ResultValid THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 301;                      // Vision Result không hợp lệ.\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF CheckScore AND ResultScore < MinScore THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 302;                      // Score thấp hơn MinScore.\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF ABS(RawOffsetX) > MaxOffsetX THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 303;                      // Offset X vượt giới hạn.\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF ABS(RawOffsetY) > MaxOffsetY THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 304;                      // Offset Y vượt giới hạn.\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF ABS(RawOffsetA) > MaxOffsetA THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 305;                      // Offset A vượt giới hạn.\n\t\t\t\tState := 900;\n\t\n\t\t\tELSE\n\t\t\t\tState := 40;\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\n\n    //=========================================================================\n    // 40 - CAMERA OFFSET -> ROBOT OFFSET\n    //-------------------------------------------------------------------------\n    // Hiện tại chưa áp dụng Transform Camera -> Robot.\n    //\n    // Mode Test:\n    // RobotOffset luôn = 0.\n    //\n    // Mode Normal:\n    // Tạm copy RawOffset để test flow.\n    // Sau này sẽ thay bằng phép Rotate Vector Camera -> Robot.\n    //=========================================================================\n    40:\n        IF BypassOffsetCheck THEN\n            RobotOffsetX := 0.0;\n            RobotOffsetY := 0.0;\n            RobotOffsetA := 0.0;\n\n        ELSE\n            RobotOffsetX := RawOffsetX;\n            RobotOffsetY := RawOffsetY;\n            RobotOffsetA := RawOffsetA;\n        END_IF;\n\n        State := 50;\n\n\n    //=========================================================================\n    // 50 - CHECK TOLERANCE\n    //-------------------------------------------------------------------------\n    // Xác định Robot đã nằm trong sai số cho phép hay chưa.\n    //=========================================================================\n    50:\n        InTolerance :=\n            ABS(RobotOffsetX) <= ToleranceX\n            AND ABS(RobotOffsetY) <= ToleranceY\n            AND ABS(RobotOffsetA) <= ToleranceA;\n\n        //---------------------------------------------------------------------\n        // Đã nằm trong Tolerance -> Align hoàn thành.\n        //---------------------------------------------------------------------\n        IF InTolerance THEN\n            NeedCorrectionMove := FALSE;\n\n            Busy := FALSE;\n            Done := TRUE;\n\n            State := 100;\n\n        //---------------------------------------------------------------------\n        // Chưa đạt -> báo Motion bên ngoài cần chạy Correction.\n        //---------------------------------------------------------------------\n        ELSE\n            NeedCorrectionMove := TRUE;\n\n            Busy := TRUE;\n            State := 60;\n        END_IF;\n\n\n    //=========================================================================\n    // 60 - WAIT CORRECTION MOVE\n    //-------------------------------------------------------------------------\n    // Phiên bản hiện tại CHƯA điều khiển Motion.\n    //\n    // State này chỉ dùng để xác nhận:\n    // Vision Result hợp lệ nhưng Robot cần chạy correction.\n    //\n    // Phiên bản tiếp theo sẽ thêm:\n    // - CorrectionMoveDone\n    // - CorrectionMoveError\n    // - Trigger Vision lại sau khi Robot Move xong.\n    //=========================================================================\n    60:\n        Busy := TRUE;\n        Done := FALSE;\n        NeedCorrectionMove := TRUE;\n\n\n    //=========================================================================\n    // 100 - ALIGN DONE\n    //-------------------------------------------------------------------------\n    // Giữ Done cho tới khi Start được hạ.\n    //=========================================================================\n    100:\n        Busy := FALSE;\n        Done := TRUE;\n        Error := FALSE;\n        NeedCorrectionMove := FALSE;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\n\n    //=========================================================================\n    // 900 - ERROR\n    //-------------------------------------------------------------------------\n    // Giữ lỗi cho tới khi Start được hạ.\n    //=========================================================================\n    900:\n        Busy := FALSE;\n        Done := FALSE;\n\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        NeedCorrectionMove := FALSE;\n\n        IF NOT Start THEN\n            Error := FALSE;\n            ErrorID := 0;\n            State := 0;\n        END_IF;\n\nEND_CASE;\n\n\n//=============================================================================\n// 5. SAVE OLD SIGNAL\n//=============================================================================\nStartOld := Start;","LineInfoPersistence":"(string)cf43fec5-6fe3-4511-9082-e187a283768d_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionAlign_1\nVAR_INPUT\n    Enable : BOOL;                              // Cho phép FB hoạt động.\n    Start : BOOL;                               // Cạnh lên bắt đầu một chu trình Vision Align.\n\n    CameraID : UINT;                            // ID Camera sử dụng.\n    JobID : UINT;                               // JobID của Vision Align.\n\n    BypassOffsetCheck : BOOL;                   // TRUE = mode test, bỏ qua X/Y/A và ép Offset = 0.\n    CheckScore : BOOL;                          // TRUE = kiểm tra Score, FALSE = bỏ qua Score khi test.\n    MinScore : REAL;                            // Score nhỏ nhất được chấp nhận.\n\n    MaxOffsetX : REAL;                          // Giới hạn Offset X tối đa cho phép.\n    MaxOffsetY : REAL;                          // Giới hạn Offset Y tối đa cho phép.\n    MaxOffsetA : REAL;                          // Giới hạn Offset A tối đa cho phép.\n\n    ToleranceX : REAL;                          // Sai số X được coi là đã Align.\n    ToleranceY : REAL;                          // Sai số Y được coi là đã Align.\n    ToleranceA : REAL;                          // Sai số A được coi là đã Align.\n\n    TriggerRetryMax : INT;                      // Số lần thử Trigger tối đa.\n    TriggerDelayTime : INT;                     // Tham số Delay/Timeout dùng cho FB_TriggerVS.\nEND_VAR\n\n\nVAR_OUTPUT\n    Busy : BOOL;                                // FB đang thực hiện Align.\n    Done : BOOL;                                // Chu trình Align hoàn thành.\n    Error : BOOL;                               // Có lỗi.\n    ErrorID : INT;                              // Mã lỗi của FB.\n\n    CurrentTriggerID : UDINT;                   // TriggerID đang xử lý.\n\n    ResultValid : BOOL;                         // Result Vision hợp lệ.\n    ResultScore : REAL;                         // Score Vision trả về.\n    ResultFeatureID : UINT;                     // FeatureID Vision trả về.\n    ResultStatus : E_VisionResultStatus;        // Trạng thái Result Vision.\n\n    RawOffsetX : REAL;                          // Offset X gốc Vision trả về.\n    RawOffsetY : REAL;                          // Offset Y gốc Vision trả về.\n    RawOffsetA : REAL;                          // Offset A gốc Vision trả về.\n\n    RobotOffsetX : REAL;                        // Offset X dùng cho Robot.\n    RobotOffsetY : REAL;                        // Offset Y dùng cho Robot.\n    RobotOffsetA : REAL;                        // Offset A dùng cho Robot.\n\n    InTolerance : BOOL;                         // TRUE = Offset đã nằm trong tolerance.\n    NeedCorrectionMove : BOOL;                  // TRUE = cần Robot chạy correction.\n    State : INT;                                // State hiện tại để monitor/debug.\nEND_VAR\n\n\nVAR\n    StartOld : BOOL;                            // Giá trị Start của scan trước.\n\n    xStartTrigger : BOOL;                       // Start nội bộ cho FB_TriggerVS.\n    xStartWaitResult : BOOL;                    // Start nội bộ cho FB_VisionWaitResult.\n\n    fbTriggerVS : FB_TriggerVS;                 // FB phát Trigger Vision.\n    fbWaitResult : FB_VisionWaitResult;         // FB chờ Vision Result.\nEND_VAR","LineInfoPersistence":"(string)cf43fec5-6fe3-4511-9082-e187a283768d_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)473","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}