{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ec950e36-8804-41e3-8c7a-dda5c123cf82","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_ConveyorState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0710103f-fbdc-4582-87a9-dd50a9877f7d"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_ConveyorState :\n(\n    CONV_DISABLED := 0,             // Conveyor chưa được bật trong phần mềm.\n\n    CONV_INITIALIZING := 10,         // Đang kiểm tra AXIS encoder.\n    CONV_STANDSTILL := 20,           // Conveyor đang đứng yên.\n    CONV_RUNNING_FORWARD := 30,      // Conveyor chạy thuận.\n    CONV_RUNNING_REVERSE := 40,      // Conveyor chạy ngược.\n    CONV_TRACKING_ACTIVE := 50,      // Có robot đang tracking.\n    CONV_STOPPING := 60,             // Conveyor đang giảm tốc hoặc dừng.\n    CONV_SIMULATION := 70,           // Đang chạy chế độ mô phỏng.\n\n    CONV_ERROR := 900                // Encoder hoặc conveyor axis lỗi.\n);\nEND_TYPE","LineInfoPersistence":"(string)ec950e36-8804-41e3-8c7a-dda5c123cf82_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)17"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}