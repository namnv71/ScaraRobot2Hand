{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d0faf349-7661-440f-bd8c-16c13c254f33","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_SelectTrackingObject","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)a58e43ae-a679-42ea-a238-c9be97edd3b2"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Khởi tạo kết quả là index không hợp lệ.\nuiBestIndex := GVL.C_INVALID_INDEX;\n\n// Chưa có candidate nào được tìm thấy.\nxFoundCandidate := FALSE;\n\n// Khởi tạo biến so sánh.\nrBestValue := 0.0;\nuiBestPriority := 0;\ntBestCaptureTime := T#0MS;\n\n\n// Duyệt toàn bộ object trong Queue.\nFOR uiIndex := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n\n    // Lấy bản sao object hiện tại để code dễ đọc.\n    stCandidate := Queue.Objects[uiIndex];\n\n    // Chỉ tiếp tục nếu object đủ điều kiện tham gia Scheduler.\n    IF F_IsTrackingObjectSelectable(\n        TrackingObject := stCandidate,\n        MinimumVisionScore := MinimumVisionScore\n    ) THEN\n\n        CASE SelectMode OF\n\n            //===============================================================\n            // Không tự động chọn object.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_NONE:\n\n                // Không thay đổi uiBestIndex.\n                ;\n\n\n            //===============================================================\n            // Chọn đúng ObjectID do Application yêu cầu.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_SPECIFIC_ID:\n\n                IF stCandidate.ObjectID = SpecificID THEN\n                    // Tìm đúng ObjectID thì trả về ngay.\n                    F_SelectTrackingObject := uiIndex;\n                    RETURN;\n                END_IF;\n\n\n            //===============================================================\n            // FIFO: chọn object có CaptureTime nhỏ nhất.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_FIFO:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    tBestCaptureTime := stCandidate.CaptureTime;\n                    xFoundCandidate := TRUE;\n\n                ELSIF stCandidate.CaptureTime < tBestCaptureTime THEN\n                    // Object được ghi nhận sớm hơn sẽ được ưu tiên.\n                    uiBestIndex := uiIndex;\n                    tBestCaptureTime := stCandidate.CaptureTime;\n                END_IF;\n\n\n            //===============================================================\n            // Chọn object gần điểm thoát nhất.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_NEAREST_EXIT:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.ConveyorCoordinate;\n                    xFoundCandidate := TRUE;\n\n                ELSIF DirectionSign >= 0 THEN\n                    // Conveyor chạy chiều tăng:\n                    // tọa độ lớn hơn nghĩa là object đi trước hơn.\n                    IF stCandidate.ConveyorCoordinate > rBestValue THEN\n                        uiBestIndex := uiIndex;\n                        rBestValue := stCandidate.ConveyorCoordinate;\n                    END_IF;\n\n                ELSE\n                    // Conveyor chạy chiều giảm:\n                    // tọa độ nhỏ hơn nghĩa là object đi trước hơn.\n                    IF stCandidate.ConveyorCoordinate < rBestValue THEN\n                        uiBestIndex := uiIndex;\n                        rBestValue := stCandidate.ConveyorCoordinate;\n                    END_IF;\n                END_IF;\n\n\n            //===============================================================\n            // Earliest Deadline First:\n            // chọn object có TimeRemainingSec nhỏ nhất.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_MIN_TIME_REMAIN:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.TimeRemainingSec;\n                    xFoundCandidate := TRUE;\n\n                ELSIF stCandidate.TimeRemainingSec < rBestValue THEN\n                    // Object còn ít thời gian hơn được ưu tiên.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.TimeRemainingSec;\n                END_IF;\n\n\n            //===============================================================\n            // Chọn Priority lớn nhất.\n            // Nếu bằng Priority thì chọn TimeRemainingSec nhỏ hơn.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_HIGHEST_PRIORITY:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    uiBestPriority := stCandidate.Priority;\n                    rBestValue := stCandidate.TimeRemainingSec;\n                    xFoundCandidate := TRUE;\n\n                ELSIF stCandidate.Priority > uiBestPriority THEN\n                    // Priority lớn hơn thắng trực tiếp.\n                    uiBestIndex := uiIndex;\n                    uiBestPriority := stCandidate.Priority;\n                    rBestValue := stCandidate.TimeRemainingSec;\n\n                ELSIF (stCandidate.Priority = uiBestPriority)\n                   AND (stCandidate.TimeRemainingSec < rBestValue) THEN\n                    // Khi Priority bằng nhau, object gần deadline hơn thắng.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.TimeRemainingSec;\n                END_IF;\n\n\n            //===============================================================\n            // Chọn VisionScore lớn nhất.\n            // Nếu bằng VisionScore thì chọn TimeRemainingSec nhỏ hơn.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_HIGHEST_VISION_SCORE:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.VisionScore;\n                    xFoundCandidate := TRUE;\n\n                ELSIF stCandidate.VisionScore > rBestValue THEN\n                    // VisionScore cao hơn được ưu tiên.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.VisionScore;\n\n                ELSIF stCandidate.VisionScore = rBestValue THEN\n                    // Nếu score bằng nhau, dùng TimeRemainingSec làm tie-break.\n                    IF stCandidate.TimeRemainingSec\n                       < Queue.Objects[uiBestIndex].TimeRemainingSec THEN\n\n                        uiBestIndex := uiIndex;\n                    END_IF;\n                END_IF;\n\n\n            //===============================================================\n            // Chọn thời gian gắp ước tính nhỏ nhất.\n            //===============================================================\n            E_TrackingSelectMode.TRACK_SELECT_SHORTEST_PICK_TIME:\n\n                IF NOT xFoundCandidate THEN\n                    // Candidate đầu tiên tạm thời là tốt nhất.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.EstimatedPickTimeSec;\n                    xFoundCandidate := TRUE;\n\n                ELSIF stCandidate.EstimatedPickTimeSec < rBestValue THEN\n                    // Object có thời gian gắp ước tính ngắn hơn được ưu tiên.\n                    uiBestIndex := uiIndex;\n                    rBestValue := stCandidate.EstimatedPickTimeSec;\n                END_IF;\n\n\n            ELSE\n                // SelectMode không hợp lệ:\n                // không chọn object để tránh hành vi không xác định.\n                ;\n\n        END_CASE;\n\n    END_IF;\n\nEND_FOR;\n\n// Trả về index object được Scheduler chọn.\n// Nếu không có object phù hợp, kết quả là C_INVALID_INDEX.\nF_SelectTrackingObject := uiBestIndex;","LineInfoPersistence":"(string)d0faf349-7661-440f-bd8c-16c13c254f33_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_SelectTrackingObject  : UINT\nVAR_INPUT\n    // Thuật toán lựa chọn object.\n    SelectMode : E_TrackingSelectMode;\n\n    // ObjectID được yêu cầu khi chọn theo ID cụ thể.\n    SpecificID : UDINT;\n\n    // Chiều chuyển động conveyor.\n    // +1: tọa độ tăng.\n    // -1: tọa độ giảm.\n    DirectionSign : SINT;\n\n    // Điểm Vision tối thiểu.\n    MinimumVisionScore : REAL;\n\n    // Queue cần tìm object.\n    Queue : ST_TRACKING_QUEUE;\nEND_VAR\nVAR\n    // Index dùng duyệt toàn bộ Queue.\n    uiIndex : UINT;\n\n    // Index object tốt nhất đã tìm thấy.\n    uiBestIndex : UINT;\n\n    // TRUE sau khi đã tìm được ít nhất một candidate.\n    xFoundCandidate : BOOL;\n\n    // Giá trị so sánh REAL của object tốt nhất.\n    rBestValue : REAL;\n\n    // Giá trị so sánh UINT của object tốt nhất.\n    uiBestPriority : UINT;\n\n    // Thời điểm capture tốt nhất cho FIFO.\n    tBestCaptureTime : TIME;\n\n    // Object hiện tại trong vòng lặp.\n    stCandidate : ST_TRACKING_OBJECT;\nEND_VAR","LineInfoPersistence":"(string)d0faf349-7661-440f-bd8c-16c13c254f33_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)240","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}