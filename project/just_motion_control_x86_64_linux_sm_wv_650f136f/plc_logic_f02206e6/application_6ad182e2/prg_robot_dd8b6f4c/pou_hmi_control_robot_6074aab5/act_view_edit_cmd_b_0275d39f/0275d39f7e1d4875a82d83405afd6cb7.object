{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)0275d39f-7e1d-4875-a82d-83405afd6cb7","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_View_Edit_Cmd_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ============================================================\n// CREATE ACTION: ACT_View_Edit_Cmd_B\n// Parent POU: POU_HMI_CONTROL_ROBOT\n// Source mirrored from: ACT_View_Edit_Cmd\n// ============================================================\n\n// Lua chon Cac diem can View va Edit \n// CASE GVL.HMI_B_PointViewCmd OF\n//     1:\n//         GVL.HMI_B_ViewStartPoint := MAX(1, GVL.HMI_B_ViewStartPoint - 1);\n// \n//     2:\n//         GVL.HMI_B_ViewStartPoint := MIN(491, GVL.HMI_B_ViewStartPoint + 1);\n// \n//     3:\n//         GVL.HMI_B_ViewStartPoint := MAX(1, GVL.HMI_B_ViewStartPoint - 10);\n// \n//     4:\n//         GVL.HMI_B_ViewStartPoint := MIN(491, GVL.HMI_B_ViewStartPoint + 10);\n// \n//     5:\n//         GVL.HMI_B_ViewStartPoint := 1;\n// \n//     6:\n//         GVL.HMI_B_ViewStartPoint := 491;\n// \n// END_CASE;\n// \n// GVL.HMI_B_PointViewCmd := 0;\n\n// // Up 1\n// IF GVL.HMI_B_ViewCmd_Scroll_Up AND NOT GVL.HMI_B_ViewCmd_Scroll_Up_Old THEN\n// \tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep - 1);\n// END_IF\n// GVL.HMI_B_ViewCmd_Scroll_Up_Old := GVL.HMI_B_ViewCmd_Scroll_Up;\n// // Down 1\n// IF GVL.HMI_B_ViewCmd_Scroll_Down AND NOT GVL.HMI_B_ViewCmd_Scroll_Down_Old THEN\n// \tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep + 1);\n// END_IF\n// GVL.HMI_B_ViewCmd_Scroll_Down_Old := GVL.HMI_B_ViewCmd_Scroll_Down;\n// // Up 10\n// IF GVL.HMI_B_ViewCmd_Page_Up AND NOT GVL.HMI_B_ViewCmd_Page_Up_Old THEN\n// \tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep - 10);\n// END_IF\n// GVL.HMI_B_ViewCmd_Page_Up_Old := GVL.HMI_B_ViewCmd_Page_Up;\n// // Down 10\n// IF GVL.HMI_B_ViewCmd_Page_Down AND NOT GVL.HMI_B_ViewCmd_Page_Down_Old THEN\n// \tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep + 10);\n// END_IF\n// GVL.HMI_B_ViewCmd_Page_Down_Old := GVL.HMI_B_ViewCmd_Page_Down;\n// // Up Top\n// IF GVL.HMI_B_ViewCmd_Go_Top AND NOT GVL.HMI_B_ViewCmd_Go_Top_Old THEN\n// \tGVL.HMI_B_ViewStartStep := 1;\n// END_IF\n// GVL.HMI_B_ViewCmd_Go_Top_Old := GVL.HMI_B_ViewCmd_Go_Top;\n// // Down Bot\n// IF GVL.HMI_B_ViewCmd_Go_Bot AND NOT GVL.HMI_B_ViewCmd_Go_Bot_Old THEN\n// \tGVL.HMI_B_ViewStartStep := GVL.B_LengthStep - 9;\n// END_IF\n// GVL.HMI_B_ViewCmd_Go_Bot_Old := GVL.HMI_B_ViewCmd_Go_Bot;\n\n// Up 1\nIF GVL.HMI_B_ViewCmd_Scroll_Up THEN\n\tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep - 1);\nEND_IF\nGVL.HMI_B_ViewCmd_Scroll_Up := FALSE;\n// Down 1\nIF GVL.HMI_B_ViewCmd_Scroll_Down THEN\n\tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep + 1);\nEND_IF\nGVL.HMI_B_ViewCmd_Scroll_Down := FALSE;\n// Up 10\nIF GVL.HMI_B_ViewCmd_Page_Up THEN\n\tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep - 10);\n\tGVL.HMI_B_RowSelectedCmd := 0;\nEND_IF\nGVL.HMI_B_ViewCmd_Page_Up := FALSE;\n// Down 10\nIF GVL.HMI_B_ViewCmd_Page_Down THEN\n\tGVL.HMI_B_ViewStartStep := MAX (1, GVL.HMI_B_ViewStartStep + 10);\n\tGVL.HMI_B_RowSelectedCmd := 0;\nEND_IF\nGVL.HMI_B_ViewCmd_Page_Down := FALSE;\n// Up Top\nIF GVL.HMI_B_ViewCmd_Go_Top THEN\n\tGVL.HMI_B_ViewStartStep := 1;\n\tGVL.HMI_B_RowSelectedCmd := 0;\nEND_IF\nGVL.HMI_B_ViewCmd_Go_Top := FALSE;\n// Down Bot\nIF GVL.HMI_B_ViewCmd_Go_Bot THEN\n\tGVL.HMI_B_ViewStartStep := MAX(1, GVL.B_LengthStep - 9);\n\tGVL.HMI_B_RowSelectedCmd := 0;\nEND_IF\nGVL.HMI_B_ViewCmd_Go_Bot := FALSE;\n\n\n// Refresh 10 dòng\nFOR i := 1 TO 10 DO\n    idx := GVL.HMI_B_ViewStartStep + i - 1;\n\n    GVL.HMI_B_ViewStepNo[i]   := idx;\n    GVL.HMI_B_ViewGroupCmd[i] := GVL_1.Step_Cr_B[idx].GroupCmd;\n    GVL.HMI_B_ViewCmd[i]      := TO_INT(GVL_1.Step_Cr_B[idx].Cmd);\n\n    GVL.HMI_B_ViewP1[i] := GVL_1.Step_Cr_B[idx].P1;\n    GVL.HMI_B_ViewP2[i] := GVL_1.Step_Cr_B[idx].P2;\n    GVL.HMI_B_ViewP3[i] := GVL_1.Step_Cr_B[idx].P3;\n    GVL.HMI_B_ViewP4[i] := GVL_1.Step_Cr_B[idx].P4;\n    GVL.HMI_B_ViewP5[i] := GVL_1.Step_Cr_B[idx].P5;\n    GVL.HMI_B_ViewP6[i] := GVL_1.Step_Cr_B[idx].P6;\n\n    GVL.HMI_B_ViewNote[i] := GVL_1.Step_Cr_B[idx].Note;\nEND_FOR;\n\n// Refresh command hien thi tren HMI\nFOR i := 1 TO 10 DO\n    idx := GVL.HMI_B_ViewStartStep + i - 1;\n\n    GVL.HMI_B_ViewStepNo[i]   := idx;\n    GVL.HMI_B_ViewCmd[i]      := TO_INT(GVL_1.Step_Cr_B[idx].Cmd);\n    GVL.HMI_B_ViewP1[i]       := GVL_1.Step_Cr_B[idx].P1;\n\tGVL.HMI_B_ViewP2[i]       := GVL_1.Step_Cr_B[idx].P2;\n\tGVL.HMI_B_ViewP3[i]       := GVL_1.Step_Cr_B[idx].P3;\n\tGVL.HMI_B_ViewP4[i]       := GVL_1.Step_Cr_B[idx].P4;\n\tGVL.HMI_B_ViewP5[i]       := GVL_1.Step_Cr_B[idx].P5;\n\tGVL.HMI_B_ViewNote[i]     := GVL_1.Step_Cr_B[idx].Note;\nEND_FOR\n\n// Tinh diem lua chon thuc te tren PLC tu HMI\n//GVL.HMI_B_Poi := HMI_PointStartIndex + HMI_PointSelectedRow - 1;\n\n// Xu ly chon dong\nFOR i := 1 TO 10 DO\n\tIF NOT GVL.B_RunEnable THEN\n\t\tIF (GVL.HMI_B_RowSelectedCmd = i) THEN\n\t\t\tGVL.HMI_B_RowSelect[i] := TRUE;\n\t\t\tGVL.HMI_B_SelectedStepNo := i + GVL.HMI_B_ViewStartStep - 1;\n\t\t\tGVL.HMI_B_EditStepNo   := GVL.HMI_B_SelectedStepNo;\n\t\tELSE\n\t\t\tGVL.HMI_B_RowSelect[i] := FALSE;\n\t\tEND_IF;\n\tELSE\n\t\tIF (GVL.B_RunStep = i) THEN\n\t\t\tGVL.HMI_B_RowSelect[i] := TRUE;\n\t\tELSE\n\t\t\tGVL.HMI_B_RowSelect[i] := FALSE;\n\t\tEND_IF\n\tEND_IF\nEND_FOR;\n\n// Tao bien de chon windown edit command\n\nFOR i := 0 TO 10 DO\n\tIF GVL.HMI_B_EditGroupCmd = i THEN\n\t\tGVL.HMI_B_Edit_Trigger_Windown_Cmd[i] := TRUE;\n\tELSE\n\t\tGVL.HMI_B_Edit_Trigger_Windown_Cmd[i] := FALSE;\n\tEND_IF\nEND_FOR;\n\n// Edit Point\nCASE GVL.HMI_B_EditCmdReq OF\n\t// Load Command to Edit\n\t20:\n\t\t//GVL.HMI_B_EditStepNo   := GVL.HMI_B_SelectedStepNo;\n\t\tGVL.HMI_B_EditGroupCmd := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].GroupCmd;\n\t\tGVL.HMI_B_EditCmd      := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].Cmd;\n\t\tGVL.HMI_B_EditP1       := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].P1;\n\t\tGVL.HMI_B_EditP2       := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].P2;\n\t\tGVL.HMI_B_EditP3       := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].P3;\n\t\tGVL.HMI_B_EditP4       := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].P4;\n\t\tGVL.HMI_B_EditP5       := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].P5;\n\t\tGVL.HMI_B_EditNote     := GVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo].Note;\n\t\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\n\t// Save Command Data Edit to PLC\n\t24:\n\t\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].GroupCmd := GVL.HMI_B_EditGroupCmd;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].Cmd := GVL.HMI_B_EditCmd;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P1 := GVL.HMI_B_EditP1;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P2 := GVL.HMI_B_EditP2;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P3 := GVL.HMI_B_EditP3;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P4 := GVL.HMI_B_EditP4;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P5 := GVL.HMI_B_EditP5;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].Note := GVL.HMI_B_EditNote;\n\t\tIF (GVL.HMI_B_EditStepNo > GVL.B_LengthStep) THEN\n\t\t\tGVL.B_LengthStep := GVL.HMI_B_EditStepNo;\n\t\tEND_IF\n\t\tGVL.HMI_B_RowSelectedCmd := 0;\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\n\n\t// Add Command Data Edit to PLC\n\t21:\n\t\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo ;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].GroupCmd := GVL.HMI_B_EditGroupCmd;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].Cmd := GVL.HMI_B_EditCmd;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P1 := GVL.HMI_B_EditP1;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P2 := GVL.HMI_B_EditP2;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P3 := GVL.HMI_B_EditP3;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P4 := GVL.HMI_B_EditP4;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].P5 := GVL.HMI_B_EditP5;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo].Note := GVL.HMI_B_EditNote;\n\t\tGVL.B_LengthStep := GVL.B_LengthStep + 1;\n\t\tGVL.HMI_B_RowSelectedCmd := 0;\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\n\t// Insert Command Data To Step Table after line selected\n\t22:\n\t\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo;\n\t\tFOR i := GVL.B_LengthStep TO (GVL.HMI_B_EditStepNo + 1) BY -1 DO\n\t\t\tGVL_1.Step_Cr_B[i+1] := GVL_1.Step_Cr_B[i];\n\t\tEND_FOR\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].GroupCmd := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].Cmd := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].P1 := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].P2 := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].P3 := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].P4 := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].P5 := 0;\n\t\tGVL_1.Step_Cr_B[GVL.HMI_B_EditStepNo + 1].Note := '';\n\t\tGVL.B_LengthStep := GVL.B_LengthStep + 1;\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\n// \t// Delete Command Data From Step Table\n// \t23:\n// \t\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo;\n// \t\tFOR i := (GVL.HMI_B_EditStepNo) TO (GVL.B_LengthStep -1) BY 1 DO\n// \t\t\tGVL_1.Step_Cr_B[i] := GVL_1.Step_Cr_B[i+1];\n// \t\tEND_FOR\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].GroupCmd := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].Cmd := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P1 := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P2 := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P3 := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P4 := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P5 := 0;\n// \t\tGVL_1.Step_Cr_B[GVL.B_LengthStep].Note := '';\n// \t\tGVL.HMI_B_EditCmdReq := 0;\n// \t\tGVL.B_LengthStep := GVL.B_LengthStep - 1;\n\n\t//============================================================\n\t// COPY SINGLE STEP\n\t// HMI_A_EditCmdReq = 25\n\t//============================================================\n\t25:\n\t\n\t\tIF (GVL.HMI_B_SelectedStepNo >= 1)\n\t\t   AND (GVL.HMI_B_SelectedStepNo <= GVL.B_LengthStep)\n\t\tTHEN\n\t\n\t\t\tGVL.B_StepClipboard :=\n\t\t\t\tGVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo];\n\t\n\t\t\tGVL.B_StepClipboardValid := TRUE;\n\t\n\t\tEND_IF;\n\t\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\t\t\n\t//============================================================\n\t// PASTE SINGLE STEP\n\t// Ghi đè vào step đang chọn\n\t//============================================================\n\t26:\n\t\n\t\tIF GVL.B_StepClipboardValid\t\n\t\t   AND (GVL.HMI_B_SelectedStepNo >= 1)\n\t\tTHEN\n\t\n\t\t\tGVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo] :=\n\t\t\t\tGVL.B_StepClipboard;\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Nếu paste ra ngoài LengthStep hiện tại\n\t\t\t//----------------------------------------------------\n\t\t\tIF GVL.HMI_B_SelectedStepNo > GVL.B_LengthStep THEN\n\t\t\t\tGVL.B_LengthStep := GVL.HMI_B_SelectedStepNo;\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\t\n\t\tGVL.HMI_B_RowSelectedCmd := 0;\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\t\t\n\t//============================================================\n\t// COPY STEP BLOCK\n\t// HMI_A_EditCmdReq = 28\n\t//\n\t// Copy từ HMI_A_CopyStartStep đến HMI_A_CopyEndStep\n\t//============================================================\n\t28:\n\t\n\t\t//--------------------------------------------------------\n\t\t// Kiểm tra range hợp lệ\n\t\t//--------------------------------------------------------\n\t\tIF (GVL.HMI_B_CopyStartStep >= 1)\n\t\t   AND\n\t\t   (GVL.HMI_B_CopyEndStep >= GVL.HMI_B_CopyStartStep)\n\t\t   AND\n\t\t   (GVL.HMI_B_CopyEndStep <= GVL.B_LengthStep)\n\t\tTHEN\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Tính số step cần copy\n\t\t\t//----------------------------------------------------\n\t\t\tGVL.AB_StepCopyCount := GVL.HMI_B_CopyEndStep - GVL.HMI_B_CopyStartStep + 1;\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Giới hạn clipboard tối đa 1000 step\n\t\t\t//----------------------------------------------------\n\t\t\tIF GVL.AB_StepCopyCount <= 1000 THEN\n\t\n\t\t\t\tFOR i := 1 TO GVL.AB_StepCopyCount DO\n\t\n\t\t\t\t\tGVL.AB_StepBlockClipboard[i] := GVL_1.Step_Cr_B[GVL.HMI_B_CopyStartStep + i - 1];\n\t\n\t\t\t\tEND_FOR;\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Lưu range nguồn để debug / HMI\n\t\t\t\t//------------------------------------------------\n\t\t\t\tGVL.B_StepCopyStart := GVL.HMI_B_CopyStartStep;\n\t\n\t\t\t\tGVL.B_StepCopyEnd := GVL.HMI_B_CopyEndStep;\n\t\n\t\t\t\tGVL.AB_StepBlockClipboardValid := TRUE;\n\t\n\t\t\tELSE\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Có thể set alarm:\n\t\t\t\t// block copy quá 100 step\n\t\t\t\t//------------------------------------------------\n\t\t\t\tGVL.AB_StepBlockClipboardValid := FALSE;\n\t\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\t\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\t\t\n\t\t//============================================================\n\t// PASTE STEP BLOCK - INSERT MODE\n\t// HMI_A_EditCmdReq = 29\n\t//\n\t// Ví dụ:\n\t// clipboard = 5 step\n\t// Paste tại Step 20\n\t//\n\t// Step 20 cũ → 25\n\t// Step 21 cũ → 26\n\t// ...\n\t//\n\t// Clipboard → Step 20..24\n\t//============================================================\n\t29:\n\t\n\t\tIF GVL.AB_StepBlockClipboardValid\n\t\t   AND (GVL.AB_StepCopyCount > 0)\n\t\t   AND (GVL.HMI_B_SelectedStepNo >= 1)\n\t\tTHEN\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Kiểm tra không vượt kích thước Step_Cr_A\n\t\t\t//\n\t\t\t// Ví dụ Step_Cr_A[1..500]\n\t\t\t//----------------------------------------------------\n\t\t\tIF (GVL.B_LengthStep + GVL.AB_StepCopyCount) <= 500 THEN\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Dịch các step cũ xuống dưới.\n\t\t\t\t//\n\t\t\t\t// PHẢI chạy từ dưới lên để không ghi đè dữ liệu.\n\t\t\t\t//------------------------------------------------\n\t\t\t\tFOR i := GVL.B_LengthStep TO GVL.HMI_B_SelectedStepNo BY -1 DO\n\t\n\t\t\t\t\tGVL_1.Step_Cr_B[i + GVL.AB_StepCopyCount] := GVL_1.Step_Cr_B[i];\n\t\n\t\t\t\tEND_FOR;\n\t\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Paste clipboard\n\t\t\t\t//------------------------------------------------\n\t\t\t\tFOR i := 1 TO GVL.AB_StepCopyCount DO\n\t\n\t\t\t\t\tGVL_1.Step_Cr_B[GVL.HMI_B_SelectedStepNo + i - 1] := GVL.AB_StepBlockClipboard[i];\n\t\n\t\t\t\tEND_FOR;\n\t\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Cập nhật tổng số step\n\t\t\t\t//------------------------------------------------\n\t\t\t\tGVL.B_LengthStep := GVL.B_LengthStep + GVL.AB_StepCopyCount;\n\t\n\t\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Reset select row\n\t\t\t\t//------------------------------------------------\n\t\t\t\tGVL.HMI_B_RowSelectedCmd := 0;\n\t\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\t\n\t\tGVL.HMI_B_EditCmdReq := 0;\n\t\t\t\nEND_CASE;\n\n// Delete Command Data From Step Table\nDelete_one_Step_B(IN := GVL.HMI_B_EditCmdReq_Arr[8], PT := T#10MS);\nIF Delete_one_Step_B.Q THEN\n\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo;\n\tFOR i := (GVL.HMI_B_EditStepNo) TO (GVL.B_LengthStep -1) BY 1 DO\n\t\tGVL_1.Step_Cr_B[i] := GVL_1.Step_Cr_B[i+1];\n\tEND_FOR\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].GroupCmd := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].Cmd := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P1 := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P2 := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P3 := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P4 := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].P5 := 0;\n\tGVL_1.Step_Cr_B[GVL.B_LengthStep].Note := '';\n\tGVL.HMI_B_EditCmdReq_Arr[8] := FALSE;\n\tGVL.B_LengthStep := GVL.B_LengthStep - 1;\nEND_IF\n\n// Delete ALL Command Data From Step Table\nDelete_all_Step_B(IN := GVL.HMI_B_EditCmdReq_Arr[9], PT := T#2S);\nIF Delete_all_Step_B.Q THEN\n\t//GVL.HMI_B_SelectedStepNo := GVL.HMI_B_EditStepNo;\n\tFOR i := 0 TO (GVL.B_LengthStep) BY 1 DO\n\t\tGVL_1.Step_Cr_B[i].GroupCmd := 0;\n\t\tGVL_1.Step_Cr_B[i].Cmd := 0;\n\t\tGVL_1.Step_Cr_B[i].P1 := 0;\n\t\tGVL_1.Step_Cr_B[i].P2 := 0;\n\t\tGVL_1.Step_Cr_B[i].P3 := 0;\n\t\tGVL_1.Step_Cr_B[i].P4 := 0;\n\t\tGVL_1.Step_Cr_B[i].P5 := 0;\n\t\tGVL_1.Step_Cr_B[i].Note := '';\n\tEND_FOR\n\t\n\tGVL.HMI_B_EditCmdReq_Arr[8] := FALSE;\n\tGVL.B_LengthStep := GVL.B_LengthStep - 1;\nEND_IF\n\n\n// Enable bit chon nhom lenh\nFOR i := 0 TO 10 DO\n\tIF (GVL.HMI_B_EditGroupCmd >= 0) AND (i = GVL.HMI_B_EditGroupCmd) THEN \n    \tGVL.HMI_B_EditSelgroupCmd[i] := TRUE;\n\tELSE\n\t\tGVL.HMI_B_EditSelgroupCmd[i] := FALSE;\n\tEND_IF\nEND_FOR;","LineInfoPersistence":"(string)0275d39f-7e1d-4875-a82d-83405afd6cb7_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)461"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}