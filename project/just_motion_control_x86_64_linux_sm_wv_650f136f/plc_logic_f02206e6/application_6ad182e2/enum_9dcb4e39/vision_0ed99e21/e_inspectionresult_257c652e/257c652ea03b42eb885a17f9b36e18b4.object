{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)257c652e-a03b-42eb-885a-17f9b36e18b4","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_InspectionResult","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0ed99e21-df83-4e0b-b4be-748f7400c92e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_InspectionResult :\n(\n    INS_RESULT_NONE := 0,            // Chưa có kết quả.\n\n    INS_RESULT_PASS := 10,            // Sản phẩm đạt.\n    INS_RESULT_FAIL := 20,            // Sản phẩm không đạt.\n    INS_RESULT_RETRY := 30,           // Cần chụp lại.\n    INS_RESULT_NOT_FOUND := 40,       // Không tìm thấy sản phẩm.\n    INS_RESULT_INVALID := 50,         // Dữ liệu kiểm tra không hợp lệ.\n\n    INS_RESULT_ERROR := 900           // Lỗi kiểm tra.\n);\nEND_TYPE","LineInfoPersistence":"(string)257c652e-a03b-42eb-885a-17f9b36e18b4_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)15"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}