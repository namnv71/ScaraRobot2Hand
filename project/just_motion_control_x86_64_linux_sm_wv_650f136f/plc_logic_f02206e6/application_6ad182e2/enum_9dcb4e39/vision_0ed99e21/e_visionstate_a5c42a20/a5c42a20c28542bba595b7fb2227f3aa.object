{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)a5c42a20-c285-42bb-a595-b7fb2227f3aa","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_VisionState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0ed99e21-df83-4e0b-b4be-748f7400c92e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_VisionState :\n(\n    VIS_IDLE := 0,                 // Kênh vision đang rảnh.\n\n    VIS_PREPARE := 10,             // Chuẩn bị JobID, TriggerID và vùng dữ liệu.\n    VIS_SEND_JOB := 20,            // Gửi JobID sang phần mềm vision.\n    VIS_SEND_TRIGGER := 30,        // Phát lệnh trigger camera.\n    VIS_WAIT_BUSY := 40,           // Chờ vision xác nhận đang xử lý.\n    VIS_WAIT_RESULT := 50,         // Chờ vision báo kết quả sẵn sàng.\n    VIS_READ_HEADER := 60,         // Đọc header kết quả.\n    VIS_READ_DATA := 70,           // Đọc payload kết quả.\n    VIS_READ_BLOCK := 80,          // Đọc từng block khi dữ liệu có nhiều điểm.\n    VIS_VALIDATE := 90,            // Kiểm tra TriggerID, số điểm và checksum.\n    VIS_ACK_RESULT := 100,          // Xác nhận PLC đã nhận kết quả.\n    VIS_DONE := 110,               // Yêu cầu vision hoàn thành.\n    VIS_ABORTING := 120,           // Đang hủy yêu cầu vision.\n    VIS_RESETTING := 130,          // Đang reset trạng thái giao tiếp.\n\n    VIS_ERROR := 900               // Giao tiếp hoặc dữ liệu vision bị lỗi.\n);\nEND_TYPE","LineInfoPersistence":"(string)a5c42a20-c285-42bb-a595-b7fb2227f3aa_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)23"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}