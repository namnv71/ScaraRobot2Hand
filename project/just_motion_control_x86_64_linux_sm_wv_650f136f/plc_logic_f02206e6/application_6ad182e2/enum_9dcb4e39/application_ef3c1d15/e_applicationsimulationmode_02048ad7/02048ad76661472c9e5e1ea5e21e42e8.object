{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)02048ad7-6661-472c-9e5e-1ea5e21e42e8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_ApplicationSimulationMode","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)ef3c1d15-cab6-46e8-8dd8-fef61bd8c3f0"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_ApplicationSimulationMode :\n(\n\tSIM_OFF := 0,          // Robot, encoder, vision và IO thật.\n    SIM_LOGIC_ONLY := 10,  // Không chạy robot; motion tự Accepted/Done.\n    SIM_ROBOT_REAL := 20   // Robot thật; encoder, object và vacuum giả.\n\n);\nEND_TYPE\n","LineInfoPersistence":"(string)02048ad7-6661-472c-9e5e-1ea5e21e42e8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)11"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}