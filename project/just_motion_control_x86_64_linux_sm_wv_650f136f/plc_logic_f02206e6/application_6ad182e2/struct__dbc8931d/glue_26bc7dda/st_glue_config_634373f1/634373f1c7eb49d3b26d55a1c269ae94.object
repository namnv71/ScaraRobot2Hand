{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)634373f1-c7eb-49d3-b26d-55a1c269ae94","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_GLUE_CONFIG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)26bc7dda-6da3-4fd3-ae01-7be9237ba4b8"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_GLUE_CONFIG :\nSTRUCT\n    Enable                  : BOOL;     // Cho phép chức năng bôi keo.\n    RunMode                 : E_GlueRunMode; // Chế độ chạy.\n\n    DefaultSpeed            : REAL;     // Tốc độ mặc định, mm/s.\n    DefaultFlow             : REAL;     // Lưu lượng mặc định.\n\n    MinPointDistance        : REAL;     // Khoảng cách điểm nhỏ nhất, mm.\n    MaxPointDistance        : REAL;     // Khoảng cách điểm lớn nhất, mm.\n\n    SmoothingEnable         : BOOL;     // Cho phép làm mượt path.\n    SmoothingFactor         : REAL;     // Hệ số làm mượt 0...1.\n\n    ApproachHeight          : REAL;     // Độ cao tiếp cận, mm.\n    RetractHeight           : REAL;     // Độ cao rút lên, mm.\n\n    PreFlowTime             : TIME;     // Thời gian mở keo trước.\n    PostFlowTime            : TIME;     // Thời gian giữ keo cuối path.\n\n    GlueOutput              : UINT;     // Output điều khiển van keo.\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)634373f1-c7eb-49d3-b26d-55a1c269ae94_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)23"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}