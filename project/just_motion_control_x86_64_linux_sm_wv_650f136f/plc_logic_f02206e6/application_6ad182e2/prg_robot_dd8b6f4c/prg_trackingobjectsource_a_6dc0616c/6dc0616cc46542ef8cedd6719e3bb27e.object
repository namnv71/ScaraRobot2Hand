{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6dc0616c-c465-42ef-8ced-d6719e3bb27e","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_TrackingObjectSource_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_TrackingObjectSource_A\n//-----------------------------------------------------------------------------\n// Quản lý nhiều Sensor Source cho Tracking Queue Robot A.\n// Mỗi Sensor Source có một FB riêng để giữ debounce, edge và spacing riêng.\n//=============================================================================\n\n//=============================================================================\n// 1. SENSOR OBJECT SOURCES\n//=============================================================================\nFOR uiSensorSource := 1 TO GVL.C_MAX_SENSOR_SOURCES DO\n\n    fbSensorSourceA[uiSensorSource](\n        Enable := GVL.g_aSensorSourceConfigA[uiSensorSource].Enable,\n        Reset := GVL.g_xResetTrackingObjectSourceA,\n        Config := GVL.g_aSensorSourceConfigA[uiSensorSource],\n        ConveyorPositionMM := REAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM),\n        Queue := GVL.g_stTrackingQueue_A\n    );\n\nEND_FOR;\n\n\n//=============================================================================\n// 2. VISION TRACKING BACKGROUND TRIGGER\n//-----------------------------------------------------------------------------\n// TRACK_PICK đang Execute sẽ mở Tracking Session.\n// Chỉ Source có VisionSourceID đúng với Recipe đang chạy mới được trigger.\n//=============================================================================\nFOR uiVisionSource := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    uiCamera := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].CameraID;\n    uiTrackingRecipe := GVL.g_stMultiTrackCommandA.RecipeID;\n\n    // Mặc định Source không được trigger.\n    xTrackingVisionEnable := FALSE;\n\n    // Chỉ bật nếu Recipe hợp lệ, command TRACK_PICK đang active và Recipe dùng Vision Source này.\n    IF GVL.g_stMultiTrackCommandA.Execute\n    AND uiTrackingRecipe > 0\n    AND uiTrackingRecipe <= GVL.C_MAX_TRACK_RECIPES\n    AND GVL.g_aMultiTrackRecipeA[uiTrackingRecipe].Enable\n    AND GVL.g_aMultiTrackRecipeA[uiTrackingRecipe].ObjectSourceType = E_ObjectSourceType.VISION\n    AND GVL.g_aMultiTrackRecipeA[uiTrackingRecipe].VisionSourceID = GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].VisionSourceID THEN\n        xTrackingVisionEnable := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].Enable;\n    //END_IF;\n\t// Commissioning: chỉ mở Source 1 mà chưa cần TRACK_PICK.\n\tELSIF GVL.g_xVisionTrackingAutoTriggerTestA AND uiVisionSource = 1 THEN\n\t\txTrackingVisionEnable := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].Enable;\n\tEND_IF;\n\n    // CameraID phải hợp lệ trước khi đọc g_aVisionStatus[].\n    IF xTrackingVisionEnable AND uiCamera > 0 AND uiCamera <= GVL.C_MAX_VISION_CHANNELS THEN\n\n        // Vision xác nhận command khi CurrentTriggerID bằng TriggerID đang chờ.\n        xVisionCommandAccepted := fbVisionTriggerA[uiVisionSource].WaitingAccepted\n            AND GVL.g_aVisionStatus[uiCamera].CurrentTriggerID = fbVisionTriggerA[uiVisionSource].TriggerID;\n\n        fbVisionTriggerA[uiVisionSource](\n            Enable := TRUE,\n            Reset := GVL.g_xResetTrackingObjectSourceA,\n            Config := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource],\n            ConveyorPositionMM := REAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM),\n\n            // TODO:\n            // Thay 0.0 bằng field Velocity thực tế của ST_CONVEYOR_STATUS sau khi anh chốt tên field.\n            // Trong thời gian test có thể đặt TriggerOnlyWhenMoving = FALSE.\n            ConveyorVelocityMMs := GVL.g_aConveyorRuntime[1].Status.VelocityMMs,\n\n            VisionReady := GVL.g_aVisionStatus[uiCamera].Ready,\n            VisionBusy := GVL.g_aVisionStatus[uiCamera].Busy,\n            CommandAccepted := xVisionCommandAccepted,\n\t\t\tResultProcessedTriggerID := fbVisionSourceA[uiVisionSource].LastProcessedTriggerID\n        );\n\n        //---------------------------------------------------------------------\n        // MAP TRACKING TRIGGER -> VISION COMMAND\n        //---------------------------------------------------------------------\n        // Execute được giữ TRUE tới khi CurrentTriggerID xác nhận đã nhận command,\n        // nên Communication task 15 ms không bỏ lỡ request từ task 4 ms.\n        IF fbVisionTriggerA[uiVisionSource].TriggerExecute THEN\n            GVL.g_aVisionCommand[uiCamera].CameraID := uiCamera;\n            GVL.g_aVisionCommand[uiCamera].JobID := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].JobID;\n            GVL.g_aVisionCommand[uiCamera].Application := E_VisionApplication.VIS_APP_CONVEYOR_PICK;\n            GVL.g_aVisionCommand[uiCamera].TriggerID := fbVisionTriggerA[uiVisionSource].TriggerID;\n            GVL.g_aVisionCommand[uiCamera].ProductID := 0;\n            GVL.g_aVisionCommand[uiCamera].CaptureConveyorPos := LREAL_TO_REAL(fbVisionTriggerA[uiVisionSource].CaptureConveyorPositionMM);\n            GVL.g_aVisionCommand[uiCamera].Execute := TRUE;\n\n        // Chỉ hạ Execute của command Tracking do chính Source này phát.\n        ELSIF GVL.g_aVisionCommand[uiCamera].Application = E_VisionApplication.VIS_APP_CONVEYOR_PICK\n        AND GVL.g_aVisionCommand[uiCamera].JobID = GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].JobID THEN\n            GVL.g_aVisionCommand[uiCamera].Execute := FALSE;\n        END_IF;\n\n    ELSE\n        // Khi Source không active, reset FB để lần TRACK_PICK sau có thể trigger frame đầu ngay.\n        fbVisionTriggerA[uiVisionSource](\n            Enable := FALSE,\n            Reset := GVL.g_xResetTrackingObjectSourceA,\n            Config := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource],\n            ConveyorPositionMM := REAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM),\n            ConveyorVelocityMMs := GVL.g_aConveyorRuntime[1].Status.VelocityMMs,\n            VisionReady := FALSE,\n            VisionBusy := FALSE,\n            CommandAccepted := FALSE\n        );\n    END_IF;\n\nEND_FOR;\n\n\n//=============================================================================\n// 3. VISION RESULT ADAPTER\n//-----------------------------------------------------------------------------\n// Chuyển Result chung của Vision Framework thành Multi Result cho Tracking.\n//=============================================================================\nFOR uiVisionSource := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    uiCamera := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].CameraID;\n\n    IF uiCamera > 0 AND uiCamera <= GVL.C_MAX_VISION_CHANNELS THEN\n        fbVisionResultAdapterA[uiVisionSource](\n            Enable := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].Enable,\n            Reset := GVL.g_xResetTrackingObjectSourceA,\n            CameraID := uiCamera,\n            JobID := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].JobID,\n            VisionResult := GVL.g_aVisionResult[uiCamera]\n        );\n\n        // Lưu Multi Result chuẩn để Vision Object Source xử lý ở bước tiếp theo.\n        GVL.g_aVisionTrackingMultiResultA[uiVisionSource] := fbVisionResultAdapterA[uiVisionSource].TrackingResult;\n    END_IF;\n\nEND_FOR;\n\n\n//=============================================================================\n// 4. VISION OBJECT SOURCES\n//-----------------------------------------------------------------------------\n// Scale/Offset -> Duplicate Check -> Push Object mới vào Tracking Queue.\n//=============================================================================\nFOR uiVisionSource := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    fbVisionSourceA[uiVisionSource](\n        Enable := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource].Enable,\n        Reset := GVL.g_xResetTrackingObjectSourceA,\n        Config := GVL.g_aVisionTrackingSourceConfigA[uiVisionSource],\n        Result := GVL.g_aVisionTrackingMultiResultA[uiVisionSource],\n        ConveyorPositionMM := REAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM),\n        Queue := GVL.g_stTrackingQueue_A\n    );\n\nEND_FOR;","LineInfoPersistence":"(string)6dc0616c-c465-42ef-8ced-d6719e3bb27e_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_TrackingObjectSource_A\nVAR\n    fbSensorSourceA : ARRAY[1..GVL.C_MAX_SENSOR_SOURCES] OF FB_SensorObjectSource;\n    uiSensorSource : UINT;\n\tfbVisionSourceA : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF FB_VisionObjectSource;\n\tuiVisionSource : UINT;\n\tfbVisionResultAdapterA : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF FB_VisionTrackingResultAdapter;\nEND_VAR\n\nVAR\n    // Mỗi Vision Source có một Trigger FB độc lập để giữ TriggerID và pitch riêng.\n    fbVisionTriggerA : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF FB_VisionTrackingTrigger;\n\n    // Camera đang xử lý trong loop.\n    uiCamera : UINT;\n\n    // Recipe TRACK_PICK hiện tại.\n    uiTrackingRecipe : UINT;\n\n    // TRUE khi Recipe/Command hiện tại cho phép Source này trigger nền.\n    xTrackingVisionEnable : BOOL;\n\n    // TRUE khi Vision Framework đã nhận đúng TriggerID đang chờ.\n    xVisionCommandAccepted : BOOL;\nEND_VAR","LineInfoPersistence":"(string)6dc0616c-c465-42ef-8ced-d6719e3bb27e_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)179","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}