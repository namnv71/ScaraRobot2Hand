{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)df254945-d231-4776-a0a3-cf80b69cd763","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionWaitResult","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)455bb68e-496e-4125-829d-ed46387b0a41"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_VisionWaitResult\n// Chức năng:\n// - Chờ Result đã được FB_VisionModbusDriver decode.\n// - Chỉ nhận Result đúng TriggerID + JobID + Application.\n// - Copy dữ liệu X/Y/Z/A/Score ra Output.\n// - KHÔNG điều khiển AckResult tại đây.\n//   AckResult thuộc quyền quản lý của FB_VisionModbusDriver.\n//=============================================================================\n\n\n//=============================================================================\n// 1. RESULT TIMEOUT\n// Dùng thời gian timeout đã cấu hình riêng cho từng Camera.\n//=============================================================================\nIF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n    tResultTimeout(IN := xResultTimeout, PT := TO_TIME(GVL.g_aVisionConfig[CameraID].ResultTimeout *100));\nELSE\n    tResultTimeout(IN := FALSE);\nEND_IF;\n\n\n//=============================================================================\n// 2. DISABLE\n// Khi FB bị Disable: đưa toàn bộ trạng thái nội bộ và Output về mặc định.\n// Không can thiệp vào AckResult vì handshake Modbus thuộc Driver.\n//=============================================================================\nIF NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n\n    Busy := FALSE;\n    Done := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    ResultValid := FALSE;\n    ResultOK := FALSE;\n\n    ResultX := 0.0;\n    ResultY := 0.0;\n    ResultZ := 0.0;\n    ResultA := 0.0;\n    ResultScore := 0.0;\n    ResultFeatureID := 0;\n\n    ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n    ResultCode := 0;\n    VisionErrorCode := 0;\n    ReceivedTriggerID := 0;\n\n    xResultTimeout := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// 3. STATE MACHINE\n//=============================================================================\nCASE State OF\n\n    //-------------------------------------------------------------------------\n    // STATE 0 - IDLE\n    // Chờ cạnh lên của Start.\n    // Kiểm tra CameraID và ExpectedTriggerID trước khi bắt đầu chờ Result.\n    //-------------------------------------------------------------------------\n    0:\n        Busy := FALSE;\n        Done := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        ResultValid := FALSE;\n        ResultOK := FALSE;\n\n        xResultTimeout := FALSE;\n\n        IF Start AND NOT StartOld THEN\n\n            // CameraID ngoài phạm vi cấu hình.\n            IF CameraID < 1 OR CameraID > GVL.C_MAX_VISION_CHANNELS THEN\n                Error := TRUE;\n                ErrorID := 1;\n                State := 900;\n\n            // TriggerID = 0 không được coi là một Trigger hợp lệ.\n            ELSIF ExpectedTriggerID = 0 THEN\n                Error := TRUE;\n                ErrorID := 2;\n                State := 900;\n\n            ELSE\n                // Bắt đầu chờ Result tương ứng với Trigger đã gửi.\n                Busy := TRUE;\n                xResultTimeout := TRUE;\n                State := 10;\n            END_IF;\n\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 10 - WAIT MATCHING RESULT\n    // Chờ Driver decode được một Result hoàn chỉnh.\n    //\n    // Điều kiện nhận Result:\n    // 1. Header.Valid = TRUE.\n    // 2. TriggerID đúng Trigger đang chờ.\n    // 3. JobID đúng Job đang chạy.\n    // 4. Application đúng loại ứng dụng đang chạy.\n    //\n    // Result cũ có TriggerID khác sẽ bị bỏ qua và tiếp tục chờ.\n    //-------------------------------------------------------------------------\n    10:\n        // Vision/Modbus báo lỗi.\n        IF GVL.g_aVisionModbusStatus[CameraID].Error THEN\n            Error := TRUE;\n            ErrorID := 10;\n            xResultTimeout := FALSE;\n            State := 900;\n\n        // Quá thời gian chờ Vision trả Result.\n        ELSIF tResultTimeout.Q THEN\n            Error := TRUE;\n            ErrorID := 11;\n            xResultTimeout := FALSE;\n            State := 900;\n\n        // Driver đã decode được một Result hoàn chỉnh.\n        ELSIF GVL.g_aVisionResult[CameraID].Header.Valid THEN\n\n            // Chỉ xử lý Result thuộc đúng Trigger hiện tại.\n            IF GVL.g_aVisionResult[CameraID].Header.TriggerID = ExpectedTriggerID THEN\n\n                // Trigger đúng nhưng JobID không đúng.\n                IF GVL.g_aVisionResult[CameraID].Header.JobID <> ExpectedJobID THEN\n                    Error := TRUE;\n                    ErrorID := 12;\n                    xResultTimeout := FALSE;\n                    State := 900;\n\n                // Trigger + Job đúng nhưng Application không đúng.\n                ELSIF GVL.g_aVisionResult[CameraID].Header.Application <> ExpectedApplication THEN\n                    Error := TRUE;\n                    ErrorID := 13;\n                    xResultTimeout := FALSE;\n                    State := 900;\n\n                ELSE\n                    // Result hoàn toàn đúng Request đang chờ.\n                    State := 20;\n                END_IF;\n\n            END_IF;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 20 - COPY RESULT\n    // Result đã được xác nhận đúng TriggerID + JobID + Application.\n    // Copy dữ liệu từ vùng Result chung sang Output riêng của FB.\n    //-------------------------------------------------------------------------\n    20:\n        xResultTimeout := FALSE;\n\n        // Lưu TriggerID thực tế đã nhận để theo dõi/debug.\n        ReceivedTriggerID := GVL.g_aVisionResult[CameraID].Header.TriggerID;\n\n        // Copy Header Result.\n        ResultStatus := GVL.g_aVisionResult[CameraID].Header.ResultStatus;\n        ResultCode := GVL.g_aVisionResult[CameraID].Header.ResultCode;\n        VisionErrorCode := GVL.g_aVisionResult[CameraID].Header.ErrorCode;\n\n        // Copy trạng thái Position Result.\n        ResultValid := GVL.g_aVisionResult[CameraID].PosResult.Valid;\n\n        // Copy tọa độ/Offset Vision đã decode.\n        ResultX := GVL.g_aVisionResult[CameraID].PosResult.Pos.X;\n        ResultY := GVL.g_aVisionResult[CameraID].PosResult.Pos.Y;\n        ResultZ := GVL.g_aVisionResult[CameraID].PosResult.Pos.Z;\n        ResultA := GVL.g_aVisionResult[CameraID].PosResult.Pos.A;\n\n        // Copy thông tin nhận dạng.\n        ResultScore := GVL.g_aVisionResult[CameraID].PosResult.Score;\n        ResultFeatureID := GVL.g_aVisionResult[CameraID].PosResult.FeatureID;\n\n        // Result chỉ được coi là OK khi:\n        // - Position hợp lệ.\n        // - Vision trả trạng thái VIS_RESULT_OK.\n        ResultOK := ResultValid AND (ResultStatus = E_VisionResultStatus.VIS_RESULT_OK);\n\n        Busy := FALSE;\n        Done := TRUE;\n\n        State := 30;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 30 - DONE\n    // Giữ Done = TRUE cho đến khi chương trình gọi FB nhả Start.\n    //-------------------------------------------------------------------------\n    30:\n        Busy := FALSE;\n        Done := TRUE;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 900 - ERROR\n    // Giữ trạng thái Error cho đến khi Start được nhả.\n    // ErrorID cho biết nguyên nhân lỗi cụ thể.\n    //-------------------------------------------------------------------------\n    900:\n        Busy := FALSE;\n        Done := FALSE;\n        xResultTimeout := FALSE;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\nEND_CASE;\n\n\n//=============================================================================\n// 4. SAVE OLD SIGNAL\n// Lưu Start cuối scan để phát hiện cạnh lên ở scan tiếp theo.\n//=============================================================================\nStartOld := Start;","LineInfoPersistence":"(string)df254945-d231-4776-a0a3-cf80b69cd763_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionWaitResult\nVAR_INPUT\n    Enable : BOOL;                              // Cho phép FB hoạt động.\n    Start : BOOL;                               // Cạnh lên bắt đầu chờ Result từ Vision.\n\n    CameraID : UINT;                            // ID Camera cần lấy Result: 1..C_MAX_VISION_CHANNELS.\n    ExpectedTriggerID : UDINT;                  // TriggerID PLC đang chờ. Phải trùng TriggerID Vision trả về.\n    ExpectedJobID : UINT;                       // JobID mong đợi. Dùng để tránh nhận nhầm kết quả của Job khác.\n    ExpectedApplication : E_VisionApplication; // Loại ứng dụng mong đợi: ALIGN, PICK_POSITION...\nEND_VAR\n\nVAR_OUTPUT\n    Busy : BOOL;                                // TRUE khi FB đang chờ/xử lý Result.\n    Done : BOOL;                                // TRUE khi đã nhận và copy xong Result đúng yêu cầu.\n    Error : BOOL;                               // TRUE khi có lỗi trong quá trình chờ Result.\n    ErrorID : INT;                              // Mã lỗi nội bộ của FB.\n\n    ResultValid : BOOL;                         // TRUE khi PosResult phía Vision báo tọa độ hợp lệ.\n    ResultOK : BOOL;                            // TRUE khi ResultValid và ResultStatus = VIS_RESULT_OK.\n\n    ResultX : REAL;                             // Tọa độ/Offset X Vision trả về.\n    ResultY : REAL;                             // Tọa độ/Offset Y Vision trả về.\n    ResultZ : REAL;                             // Tọa độ/Offset Z Vision trả về.\n    ResultA : REAL;                             // Góc A Vision trả về.\n    ResultScore : REAL;                         // Điểm nhận dạng của Vision.\n    ResultFeatureID : UINT;                     // ID Feature/Pattern Vision nhận dạng được.\n\n    ResultStatus : E_VisionResultStatus;        // Trạng thái kết quả: OK, NG, NOT_FOUND, LOW_SCORE...\n    ResultCode : UINT;                          // Mã kết quả do Vision trả về.\n    VisionErrorCode : UINT;                     // Mã lỗi do Vision trả về.\n\n    ReceivedTriggerID : UDINT;                  // TriggerID thực tế của Result đã được FB nhận.\nEND_VAR\n\nVAR\n    State : INT;                                // State machine nội bộ của FB.\n    StartOld : BOOL;                            // Lưu Start scan trước để bắt cạnh lên.\n\n    tResultTimeout : TON;                       // Timer giới hạn thời gian chờ Vision trả Result.\n    xResultTimeout : BOOL;                      // Enable cho timer chờ Result.\nEND_VAR","LineInfoPersistence":"(string)df254945-d231-4776-a0a3-cf80b69cd763_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)274","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}