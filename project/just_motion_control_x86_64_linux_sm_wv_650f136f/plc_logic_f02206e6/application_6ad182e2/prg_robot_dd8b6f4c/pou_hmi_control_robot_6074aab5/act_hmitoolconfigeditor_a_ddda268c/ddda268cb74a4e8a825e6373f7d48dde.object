{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ddda268c-b74a-4e8a-825e-6373f7d48dde","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_HMIToolConfigEditor_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PROGRAM: PRG_HMIToolConfigEditor_A\n//-----------------------------------------------------------------------------\n// Quản lý trang HMI cấu hình nhiều Tool cho Robot A.\n//\n// NGUYÊN TẮC:\n// 1. HMI chỉnh EditData, không chỉnh trực tiếp g_aToolConfigA.\n// 2. Load sao chép ToolConfig vào EditData.\n// 3. Save kiểm tra dữ liệu rồi mới ghi về ToolConfig.\n// 4. Cancel khôi phục dữ liệu từ OriginalData.\n// 5. Save luôn ghi theo LoadedIndex để tránh ghi nhầm Tool.\n//=============================================================================\n\n\n//=============================================================================\n// 01. BẮT CẠNH LỆNH HMI\n//=============================================================================\nGVL.g_rtHMIToolLoadA(CLK := GVL.g_stHMIToolEditorA.LoadCommand);\n\nGVL.g_rtHMIToolSaveA(CLK := GVL.g_stHMIToolEditorA.SaveCommand);\n\nGVL.g_rtHMIToolCancelA(CLK := GVL.g_stHMIToolEditorA.CancelCommand);\n\n\n//=============================================================================\n// 02. OUTPUT DẠNG XUNG\n//-----------------------------------------------------------------------------\n// LoadDone và SaveDone chỉ TRUE trong một vòng quét.\n//=============================================================================\nGVL.g_stHMIToolEditorA.LoadDone := FALSE;\nGVL.g_stHMIToolEditorA.SaveDone := FALSE;\nGVL.g_stHMIToolEditorA.Busy := FALSE;\n\n\n//=============================================================================\n// 03. KHỞI TẠO INDEX MẶC ĐỊNH\n//=============================================================================\nIF GVL.g_stHMIToolEditorA.SelectedIndex = 0 THEN\n    GVL.g_stHMIToolEditorA.SelectedIndex := 1;\nEND_IF;\n\n\n//=============================================================================\n// 04. TỰ ĐỘNG LOAD KHI ĐỔI TOOL\n//-----------------------------------------------------------------------------\n// Chỉ tự động Load khi dữ liệu hiện tại chưa bị chỉnh sửa.\n// Nếu DataChanged = TRUE thì giữ dữ liệu hiện tại để tránh mất dữ liệu.\n//=============================================================================\nIF GVL.g_stHMIToolEditorA.SelectedIndex <> GVL.g_uiHMIToolSelectedIndexOldA THEN\n\n    IF GVL.g_stHMIToolEditorA.DataChanged THEN\n\n        // Không cho đổi Tool khi dữ liệu hiện tại chưa được Save hoặc Cancel.\n        GVL.g_stHMIToolEditorA.SelectedIndex := GVL.g_uiHMIToolSelectedIndexOldA;\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1101;\n\n    ELSIF GVL.g_stHMIToolEditorA.SelectedIndex >= 1 AND GVL.g_stHMIToolEditorA.SelectedIndex <= GVL.C_MAX_TOOLS THEN\n\n        // Sao chép cấu hình Tool được chọn vào vùng chỉnh sửa.\n        GVL.g_stHMIToolEditorA.EditData := GVL.g_aToolConfigA[GVL.g_stHMIToolEditorA.SelectedIndex];\n\n        // Lưu bản gốc để phục vụ Cancel.\n        GVL.g_stHMIToolEditorA.OriginalData := GVL.g_aToolConfigA[GVL.g_stHMIToolEditorA.SelectedIndex];\n\n        GVL.g_stHMIToolEditorA.LoadedIndex := GVL.g_stHMIToolEditorA.SelectedIndex;\n\n        GVL.g_uiHMIToolSelectedIndexOldA := GVL.g_stHMIToolEditorA.SelectedIndex;\n\n        GVL.g_stHMIToolEditorA.DataChanged := FALSE;\n        GVL.g_stHMIToolEditorA.Error := FALSE;\n        GVL.g_stHMIToolEditorA.ErrorID := 0;\n        GVL.g_stHMIToolEditorA.LoadDone := TRUE;\n\n    ELSE\n\n        // Index Tool ngoài phạm vi.\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1102;\n\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// 05. LOAD THỦ CÔNG\n//=============================================================================\nIF GVL.g_rtHMIToolLoadA.Q THEN\n\n    GVL.g_stHMIToolEditorA.Busy := TRUE;\n    GVL.g_stHMIToolEditorA.Error := FALSE;\n    GVL.g_stHMIToolEditorA.ErrorID := 0;\n\n    IF GVL.g_stHMIToolEditorA.SelectedIndex >= 1\n    AND GVL.g_stHMIToolEditorA.SelectedIndex <= GVL.C_MAX_TOOLS THEN\n\n        GVL.g_stHMIToolEditorA.EditData := GVL.g_aToolConfigA[GVL.g_stHMIToolEditorA.SelectedIndex];\n\n        GVL.g_stHMIToolEditorA.OriginalData := GVL.g_aToolConfigA[GVL.g_stHMIToolEditorA.SelectedIndex];\n\n        GVL.g_stHMIToolEditorA.LoadedIndex := GVL.g_stHMIToolEditorA.SelectedIndex;\n\n        GVL.g_uiHMIToolSelectedIndexOldA := GVL.g_stHMIToolEditorA.SelectedIndex;\n\n        GVL.g_stHMIToolEditorA.DataChanged := FALSE;\n        GVL.g_stHMIToolEditorA.LoadDone := TRUE;\n\n    ELSE\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1102;\n\n    END_IF;\n\t\n\tGVL.g_stHMIToolEditorA.LoadCommand := FALSE;\n\nEND_IF;\n\n\n// //=============================================================================\n// // 06. CANCEL THAY ĐỔI\n// //-----------------------------------------------------------------------------\n// // Khôi phục EditData về bản dữ liệu đã Load gần nhất.\n// //=============================================================================\n// IF GVL.g_rtHMIToolCancelA.Q THEN\n// \n//     GVL.g_stHMIToolEditorA.Busy := TRUE;\n//     GVL.g_stHMIToolEditorA.Error := FALSE;\n//     GVL.g_stHMIToolEditorA.ErrorID := 0;\n// \n//     IF GVL.g_stHMIToolEditorA.LoadedIndex >= 1\n//     AND GVL.g_stHMIToolEditorA.LoadedIndex <= GVL.C_MAX_TOOLS THEN\n// \n//         GVL.g_stHMIToolEditorA.EditData := GVL.g_stHMIToolEditorA.OriginalData;\n// \n//         GVL.g_stHMIToolEditorA.DataChanged := FALSE;\n//         GVL.g_stHMIToolEditorA.LoadDone := TRUE;\n// \n//     ELSE\n// \n//         GVL.g_stHMIToolEditorA.Error := TRUE;\n//         GVL.g_stHMIToolEditorA.ErrorID := 1103;\n// \n//     END_IF;\n// \n// END_IF;\n\n\n//=============================================================================\n// 07. SAVE CẤU HÌNH TOOL\n//=============================================================================\nIF GVL.g_rtHMIToolSaveA.Q THEN\n\n    GVL.g_stHMIToolEditorA.Busy := TRUE;\n    GVL.g_stHMIToolEditorA.Error := FALSE;\n    GVL.g_stHMIToolEditorA.ErrorID := 0;\n    GVL.g_xHMIToolDuplicateIDA := FALSE;\n\n    //-------------------------------------------------------------------------\n    // Kiểm tra ToolID có trùng với Tool khác hay không.\n    //-------------------------------------------------------------------------\n    FOR GVL.g_uiHMIToolCheckIndexA := 1 TO GVL.C_MAX_TOOLS DO\n\n        IF GVL.g_uiHMIToolCheckIndexA <> GVL.g_stHMIToolEditorA.LoadedIndex\n\t\tAND GVL.g_aToolConfigA[GVL.g_uiHMIToolCheckIndexA].Enable\n        AND GVL.g_aToolConfigA[GVL.g_uiHMIToolCheckIndexA].ToolID = GVL.g_stHMIToolEditorA.EditData.ToolID THEN\n\n            GVL.g_xHMIToolDuplicateIDA := TRUE;\n\n        END_IF;\n\n    END_FOR;\n\n    //-------------------------------------------------------------------------\n    // Kiểm tra dữ liệu trước khi Save.\n    //-------------------------------------------------------------------------\n    IF GVL.g_stHMIToolEditorA.LoadedIndex < 1\n    OR GVL.g_stHMIToolEditorA.LoadedIndex > GVL.C_MAX_TOOLS THEN\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1110;\n\n    ELSIF GVL.g_stMultiTrackStatusA.Busy THEN\n\n        // Không cho thay cấu hình khi Multi-tool đang chạy.\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1111;\n\n    ELSIF GVL.g_aToolStatusA[GVL.g_stHMIToolEditorA.LoadedIndex].Busy THEN\n\n        // Không cho thay cấu hình khi Tool đang thực hiện lệnh.\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1112;\n\n    ELSIF GVL.g_stHMIToolEditorA.EditData.ToolID = 0 THEN\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1113;\n\n    ELSIF GVL.g_xHMIToolDuplicateIDA THEN\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1114;\n\n    ELSIF GVL.g_stHMIToolEditorA.EditData.ApproachHeight < 0.0 THEN\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1115;\n\n    ELSIF GVL.g_stHMIToolEditorA.EditData.UseUpDown AND GVL.g_stHMIToolEditorA.EditData.UpDownStroke <= 0.0 THEN\n\n        GVL.g_stHMIToolEditorA.Error := TRUE;\n        GVL.g_stHMIToolEditorA.ErrorID := 1116;\n\tELSIF GVL.g_stHMIToolEditorA.EditData.UseUpDown AND GVL.g_stHMIToolEditorA.EditData.IO.UseSingleUpDownDO\n\tAND (GVL.g_stHMIToolEditorA.EditData.IO.UpDownDOChannel = 0 OR GVL.g_stHMIToolEditorA.EditData.IO.UpDownDOChannel > GVL.C_MAX_DO) THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1120;\n\t\n\tELSIF GVL.g_stHMIToolEditorA.EditData.UseUpDown AND NOT GVL.g_stHMIToolEditorA.EditData.IO.UseSingleUpDownDO\n\tAND (GVL.g_stHMIToolEditorA.EditData.IO.DownDOChannel = 0 OR GVL.g_stHMIToolEditorA.EditData.IO.DownDOChannel > GVL.C_MAX_DO) THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1121;\n\t\n\tELSIF GVL.g_stHMIToolEditorA.EditData.UseUpDown AND NOT GVL.g_stHMIToolEditorA.EditData.IO.UseSingleUpDownDO\n\tAND (GVL.g_stHMIToolEditorA.EditData.IO.UpDOChannel = 0 OR GVL.g_stHMIToolEditorA.EditData.IO.UpDOChannel > GVL.C_MAX_DO) THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1122;\n\tELSIF GVL.g_stHMIToolEditorA.EditData.IO.UseSingleGripReleaseDO\n\tAND (\n\t\t//GVL.g_stHMIToolEditorA.EditData.IO.GripReleaseDOChannel = 0 OR \n\t\tGVL.g_stHMIToolEditorA.EditData.IO.GripReleaseDOChannel > GVL.C_MAX_DO\n\t) THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1123;\n\t\n\tELSIF NOT GVL.g_stHMIToolEditorA.EditData.IO.UseSingleGripReleaseDO\n\tAND GVL.g_stHMIToolEditorA.EditData.IO.GripDOChannel > GVL.C_MAX_DO THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1124;\n\t\n\tELSIF NOT GVL.g_stHMIToolEditorA.EditData.IO.UseSingleGripReleaseDO\n\tAND GVL.g_stHMIToolEditorA.EditData.IO.ReleaseDOChannel > GVL.C_MAX_DO THEN\n\t\tGVL.g_stHMIToolEditorA.Error := TRUE;\n\t\tGVL.g_stHMIToolEditorA.ErrorID := 1125;\n    ELSE\n\n        // Ghi dữ liệu từ vùng trung gian về đúng Tool đã Load.\n        GVL.g_aToolConfigA[GVL.g_stHMIToolEditorA.LoadedIndex] := GVL.g_stHMIToolEditorA.EditData;\n\n        // Cập nhật bản gốc sau khi Save thành công.\n        GVL.g_stHMIToolEditorA.OriginalData := GVL.g_stHMIToolEditorA.EditData;\n\n        GVL.g_stHMIToolEditorA.DataChanged := FALSE;\n        GVL.g_stHMIToolEditorA.SaveDone := TRUE;\n\t\tGVL.g_stHMITool_Config_Save_All := TRUE;\n\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// 08. CẬP NHẬT TRẠNG THÁI TOOL ĐƯỢC CHỌN\n//-----------------------------------------------------------------------------\n// HMI đọc một biến cố định thay vì dùng địa chỉ mảng động.\n//=============================================================================\nIF GVL.g_stHMIToolEditorA.LoadedIndex >= 1\nAND GVL.g_stHMIToolEditorA.LoadedIndex <= GVL.C_MAX_TOOLS THEN\n\n    GVL.g_stHMIToolStatusA :=\n        GVL.g_aToolStatusA[\n            GVL.g_stHMIToolEditorA.LoadedIndex\n        ];\n\nEND_IF;","LineInfoPersistence":"(string)ddda268c-b74a-4e8a-825e-6373f7d48dde_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)277"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}