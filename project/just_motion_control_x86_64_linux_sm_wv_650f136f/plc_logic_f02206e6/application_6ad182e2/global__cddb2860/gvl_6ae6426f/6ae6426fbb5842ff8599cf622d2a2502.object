{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6ae6426f-bb58-42ff-8599-cf622d2a2502","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)GVL","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)cddb2860-ad53-4400-b259-8f15120b03ac"}]}}}}]},"TypeGuid":"(Guid)ffbfa93a-b94d-45fc-a329-229860183b1d","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"ffbfa93a","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\nVAR_GLOBAL\n\t//DEFIND INPUT ROBOT\n\tMB_ : ARRAY[0..1000] OF BOOL; // \n\tAlarm_ : ARRAY[0..500] OF BOOL;\n\tDW_ : ARRAY[0..100] OF WORD;\n\tY : ARRAY[0..100] OF BOOL; // \n\tX : ARRAY[0..100] OF BOOL; // \n\tMODBUS : ARRAY[0..1999] OF WORD; // AT %QW30 :\n\tLog_HMI : ARRAY[0..20] OF STRING(255); \n\tLog_RobotA, Log_RobotB : ARRAY[0..20]  OF STRING(255); \nEND_VAR\n\nVAR_GLOBAL // CONTROL ROBOT\n\tRB_A, RB_B : RB_IN;\n\tRB_A_Man, RB_B_Man : RB_IN_Man;\n\tRB_A_, RB_B_ : RB_OUT;\n\tRBA_VEL_POS, RBB_VEL_POS : RB_Speed_Point;\n\t\n\tHMI_MAIN : MainMC;\n\tCam_T1, Cam_T2 : ModbusCam;\n\tCOOR_A_CONVERT : ARRAY[0..9] OF Pos_Coordsystem;\n\tCOOR_B_CONVERT : ARRAY[0..9] OF Pos_Coordsystem;\n\tPro4_ : Project4;\n\t//Pos_bonus : ARRAY[0..100] OF ST_POS;\nEND_VAR\n// namnv3103\nVAR_GLOBAL\n\tFac_Vel_Set_A, Fac_Vel_Slow : REAL;\n\tFac_Vel_Set_B, Fac_Acc_Set_B, Fac_Jerk_Set_B, Fac_Torque_Set_B: REAL;\n\tFac_Acc_Set_A, Fac_Jerk_Set_A, Fac_Torque_Set_A: REAL;\n\tTorque_Max : Torque_Axis;\n\tReset_Torque_Max : BOOL;\n\tAlarm_Robot : Alarm_Robot;\n\tAlarm_P4 : Alarm_P_4;\n\tConfirmNG_VS, ConfirmNG_TS : BOOL := FALSE;\n\tReset_Alarm_History : BOOL;\n\tProject_No_Cur, Model_No_Cur, RB_Direction_Cur: INT;\n\tProjectAndModel : Project_And_Model; \n\tProject : ARRAY[0..10] OF Data_Project;\n\tProject_Cur : ARRAY[0..10] OF BOOL;\n\tProject_Cur_Rev : ARRAY[0..10] OF BOOL;\n\tSave_Model, Call_Model : BOOL;\n\tRB_Signal_In : RB_Signal_Input;\n\tData_Calib_RB : ARRAY[0..10] OF Calib_Cam_Input_Model;\n\tCalib_Cam_RB : ARRAY[0..10] OF Calib_Cam;\n\tMan_Calib_RB, Auto_VS_RB : ARRAY[0..10] OF VS_Control;\n\tNB_Register_Modbus_VS : INT := 150;\n\tSave_Data_Cam, Load_Data_Cam : ARRAY[0..10] OF BOOL;\n\tRTrig_Save_Data_Cam, RTrig_Load_Data_Cam : ARRAY[0..10] OF R_TRIG;\n\t\n\t\nEND_VAR\nVAR_GLOBAL\n\tRB_B_Calib_Point : Data_Point_Calib;\nEND_VAR\nVAR_GLOBAL RETAIN\n\tTimeMachine : TimeRun;\nEND_VAR\n\nVAR_GLOBAL\n\tHMI_A_ViewStartStep : INT := 1;\n    HMI_A_ViewStepNo    : ARRAY[0..10] OF INT;\n\tHMI_A_ViewGroupCmd  : ARRAY[0..10] OF INT;\n    HMI_A_ViewCmd       : ARRAY[0..10] OF INT;\n\n    HMI_A_ViewP1        : ARRAY[0..10] OF INT;\n    HMI_A_ViewP2        : ARRAY[0..10] OF INT;\n    HMI_A_ViewP3        : ARRAY[0..10] OF DINT;\n    HMI_A_ViewP4        : ARRAY[0..10] OF INT;\n    HMI_A_ViewP5        : ARRAY[0..10] OF INT;\n    HMI_A_ViewP6        : ARRAY[0..10] OF INT;\n    HMI_A_ViewNote      : ARRAY[0..10] OF STRING[20];\n\n    HMI_A_RowState      : ARRAY[0..10] OF INT;\n\tHMI_A_RowSelect     : ARRAY[0..10] OF BOOL;\n\tHMI_A_RowSelectedCmd : INT;\n\tHMI_A_LengthRowCmd : INT;\n\tA_LengthStep : INT;\nEND_VAR\n\nVAR_GLOBAL\n    HMI_A_SelectedViewRow : INT;\n    HMI_A_SelectedStepNo  : INT;\n\n    HMI_A_ViewCmd_Scroll_Up      : BOOL;\n\tHMI_A_ViewCmd_Scroll_Down    : BOOL;\n\tHMI_A_ViewCmd_Page_Up      : BOOL;\n\tHMI_A_ViewCmd_Page_Down    : BOOL;\n\tHMI_A_ViewCmd_Go_Bot      : BOOL;\n\tHMI_A_ViewCmd_Go_Top    : BOOL;\n\tHMI_A_ViewCmd_Scroll_Up_Old      : BOOL;\n\tHMI_A_ViewCmd_Scroll_Down_Old    : BOOL;\n\tHMI_A_ViewCmd_Page_Up_Old      : BOOL;\n\tHMI_A_ViewCmd_Page_Down_Old    : BOOL;\n\tHMI_A_ViewCmd_Go_Bot_Old      : BOOL;\n\tHMI_A_ViewCmd_Go_Top_Old    : BOOL;\nEND_VAR\n\nVAR_GLOBAL\n    HMI_A_EditStepNo   : INT;\n    HMI_A_EditGroupCmd : INT; // nhom lenh su dung\n\tHMI_A_EditCmd      : E_RobotCmd;\n\n    HMI_A_EditP1       : INT;\n    HMI_A_EditP2       : INT;\n    HMI_A_EditP3       : DINT;\n    HMI_A_EditP4       : INT;\n    HMI_A_EditP5       : INT;\n    HMI_A_EditP6       : INT;\n\n\n    HMI_A_EditNote   : STRING[20];\n    HMI_A_EditCmdReq : INT; //20 =  Edit, 21 = Add, 22 = Insert, 23 = Delete Step, 24 = Save Step, 25 = Copy Step, 26 = Paste Step\n\tHMI_A_EditCmdReq_Arr : ARRAY [0..20] OF BOOL; \n\tHMI_A_EditSelgroupCmd : ARRAY [0..10] OF BOOL; // dung de enable cac phan command theo tung group\n\tHMI_A_Edit_Trigger_Windown_Cmd: ARRAY [0..10] OF BOOL; // dung de hien thi cac man hinh cai dat theo tham so cua chuong trinh theo tung group cmd\n\tHMI_A_Edit_Show_Help : BOOL; // Hien thi man hinh gia thich cac tham so\nEND_VAR\n\nVAR_GLOBAL\n\n    //========================================================\n    // CLIPBOARD 1 STEP\n    //========================================================\n    A_StepClipboardValid : BOOL := FALSE;\n    A_StepClipboard      : ST_RobotStep;   // đổi ST_Step theo đúng TYPE của Step_Cr_A[]\n\n\n    //========================================================\n    // CLIPBOARD NHIỀU STEP\n    //========================================================\n\tHMI_A_CopyStartStep : INT;\n\tHMI_A_CopyEndStep   : INT;\n\n    A_StepCopyStart : INT := 0;\n    A_StepCopyEnd   : INT := 0;\n\n    \n\n    \n\nEND_VAR\n\n\nVAR_GLOBAL\n\tRobot_Programs : ARRAY [0..20] OF ST_RobotProgram;\n\t// Ví dụ cho phép copy tối đa 1000 step/lần\n    AB_StepBlockClipboard : ARRAY[0..1000] OF ST_RobotStep;\n\t// Số lượng step đã copy\n    AB_StepCopyCount : INT := 0;\n\tAB_StepBlockClipboardValid : BOOL := FALSE;\nEND_VAR\n// Khai bao bien lien quan cac diem hoat dong Robot (Point table)\nVAR_GLOBAL\n\tHMI_A_PointNo        : ARRAY[0..10] OF INT;\n\tHMI_A_ViewStartPoint : INT := 1;\n    HMI_A_View_Pos_X     : ARRAY[0..10] OF REAL;\n    HMI_A_View_Pos_Y     : ARRAY[0..10] OF REAL;\n    HMI_A_View_Pos_Z     : ARRAY[0..10] OF REAL;\n    HMI_A_View_Pos_R     : ARRAY[0..10] OF REAL;\n    HMI_A_View_Pos_Name  : ARRAY[0..10] OF STRING[20];\n\tHMI_A_PointViewCmd   : INT;\n\tHMI_A_PointNoSelected : INT;\n\tHMI_A_ChangeSelectedPoint : BOOL;\nEND_VAR\n\n//============================================================\n// POINT CLIPBOARD\n// Dùng để lưu tạm dữ liệu khi Copy/Paste Point\n//============================================================\nVAR_GLOBAL\n\n    // TRUE = Clipboard đang chứa dữ liệu hợp lệ\n    A_PointClipboardValid : BOOL := FALSE;\n\n    // Số Point nguồn đã Copy - chủ yếu dùng để hiển thị/debug\n    A_PointClipboardSourceNo : INT := 0;\n\n    // Dữ liệu Point đã Copy\n    A_PointClipboardName : STRING[20] := '';\n\n    A_PointClipboardX : REAL := 0.0;\n    A_PointClipboardY : REAL := 0.0;\n    A_PointClipboardZ : REAL := 0.0;\n    A_PointClipboardR : REAL := 0.0;\n\nEND_VAR\n\nVAR_GLOBAL\n\tHMI_A_Edit_PointNo   : INT;\n    HMI_A_Edit_Pos_X     : REAL;\n    HMI_A_Edit_Pos_Y     : REAL;\n    HMI_A_Edit_Pos_Z     : REAL;\n    HMI_A_Edit_Pos_R     : REAL;\n    HMI_A_Edit_Pos_Name  : STRING[20];\n\tHMI_A_EditPointReq   : INT; \n\tHMI_A_EditPointReq_Arr : ARRAY[0..10] OF BOOL;\n\tHMI_A_RowSelectedPoint : INT;\n\tHMI_A_RowSelectedPoint_Array : ARRAY[0..10] OF BOOL;\nEND_VAR\n\n// Khia bao bien cho bang dieu kien dung robot A\n// Biến HMI xem danh sách 10 condition/trang\nVAR_GLOBAL\n    HMI_A_CondViewStart : INT := 1;\n\n    HMI_A_CondViewNo     : ARRAY[0..10] OF INT;\n    HMI_A_CondViewName   : ARRAY[0..10] OF STRING[20];\n    HMI_A_CondViewEnable : ARRAY[0..10] OF BOOL;\n    HMI_A_CondViewResult : ARRAY[0..10] OF BOOL;\n\n    HMI_A_CondRowSelect  : ARRAY[0..10] OF BOOL;\n    HMI_A_CondSelectedNo : INT;\n\tHMI_A_CondSelectedCmd : INT;\n\n    HMI_A_CondCmd_Up       : BOOL;\n    HMI_A_CondCmd_Down     : BOOL;\n    HMI_A_CondCmd_PageUp   : BOOL;\n    HMI_A_CondCmd_PageDown : BOOL;\n    HMI_A_CondCmd_GoTop    : BOOL;\n    HMI_A_CondCmd_GoBot    : BOOL;\nEND_VAR\n\n// Biến HMI Edit 1 condition, nhưng thấy 10 dòng điều kiện\nVAR_GLOBAL\n    HMI_A_CondEditNo     : INT;\n    HMI_A_CondEditName   : STRING[20];\n    HMI_A_CondEditEnable : BOOL;\n\n    HMI_A_CondEditRowEnable : ARRAY[0..10] OF BOOL;\n    HMI_A_CondEditSource    : ARRAY[0..10] OF INT;\n    HMI_A_CondEditIndex     : ARRAY[0..10] OF INT;\n    HMI_A_CondEditOperator  : ARRAY[0..10] OF INT;\n    HMI_A_CondEditSetValue  : ARRAY[0..10] OF DINT;\n    HMI_A_CondEditLinkNext  : ARRAY[0..10] OF INT;\n    HMI_A_CondEditNote      : ARRAY[0..10] OF STRING[30];\n\tHMI_A_CondMonitorEnable : BOOL; // Nút Monitor ON/OFF\n\n    HMI_A_CondMonActualValue : ARRAY[0..10] OF DINT;\n    HMI_A_CondMonRowResult   : ARRAY[0..10] OF BOOL;\n    HMI_A_CondMonFinalResult : BOOL;\n\n    HMI_A_CondCmdReq : INT;\n    // 1=Load, 2=Save, 3=Clear, 4=Copy, 5=Paste, 6=DeleteRow, 7=InsertRow\n\n    HMI_A_CondEditSelectedRow : INT;\n    HMI_A_CondCopied : ST_Condition;\nEND_VAR\n\n////////////////////\nVAR_GLOBAL\n    A_CopyStepBuffer : ST_RobotStep;\n    A_CopyStepValid  : BOOL;\n\n    A_MaxStep        : INT := 1000;\n    A_MaxViewStart   : INT := 991;\nEND_VAR\n\nVAR_GLOBAL\n    A_RunEnable    : BOOL;\n    A_RunPause     : BOOL;\n    A_RunStop      : BOOL;\n\n    A_RunStep      : INT := 1;\n    A_RunBusy      : BOOL;\n    A_RunDone      : BOOL;\n    A_RunAlarm     : BOOL;\n    A_RunAlarmCode : INT;\n\n    A_RunState     : INT := 0;\n    A_StepActive   : BOOL;\n\t\nEND_VAR\n// Khai bao phan tham so co the chay Blend va MovC\nVAR_GLOBAL\n    A_CurrentMotionParam : ST_MotionParam := (\n        Speed := 500.0,\n        Acc := 2000.0,\n        Dec := 2000.0,\n        Jerk := 10000.0,\n        VelFac := 1.0,\n        AccFac := 1.0,\n        DecFac := 1.0,\n        JerkFac := 1.0\n    );\n\n    A_MotionQueue : ARRAY[0..20] OF ST_MotionQueueItem;\n    A_MotionHead  : INT := 1; // Vi tri lay du lieu o trong  Queue\n    A_MotionTail  : INT := 1; // Vi tri ghi du lieu o trong Queue\n    A_MotionCount : INT := 0; // So luong Motion co trong hang doi\n\tA_PipelineUsedCount : INT := 0; // So luong Motion da dua vao pipeline\n    A_MotionQueueStart : BOOL;\n    A_MotionQueueBusy  : BOOL;\n    A_MotionQueueDone  : BOOL;\n    A_MotionQueueError : BOOL;\n    A_MotionQueueState : INT;\n\n    A_MotionScanStep   : INT;\n    A_MotionBlockEndStep : INT;\n\n    A_MotionItemActive : ST_MotionQueueItem;\n    A_MotionItemValid  : BOOL;\n\n    A_MotionAccepted   : BOOL;\n    A_MotionAllDone    : BOOL;\n\n    A_MotionAlarmCode  : INT;\nEND_VAR\n\n// PRG_A_MotionQueueBuilder\n// VAR_GLOBAL\n//     A_MotionManagerStart : BOOL;\n//     A_MotionManagerDone  : BOOL;\n//     A_MotionManagerBusy  : BOOL;\n//     A_MotionManagerError : BOOL;\n// END_VAR\n// PRG_A_MotionManager\nVAR_GLOBAL\n    // Số slot motion dùng để blend\n    A_MoveSlotBusy      : ARRAY[0..3] OF BOOL;\n    A_MoveSlotCmd       : ARRAY[0..3] OF E_RobotCmd;\n    A_MoveSlotItem      : ARRAY[0..3] OF ST_MotionQueueItem;\n\n    A_MoveSlotStart     : ARRAY[0..3] OF BOOL;\n    A_MoveSlotAccepted  : ARRAY[0..3] OF BOOL;\n    A_MoveSlotDone      : ARRAY[0..3] OF BOOL;\n    A_MoveSlotError     : ARRAY[0..3] OF BOOL;\n    A_MoveSlotErrorID   : ARRAY[0..3] OF INT;\n\tA_MoveSlotReleasePending : ARRAY[0..3] OF BOOL;\n    A_QueueSendFinished : BOOL;\n    A_ActiveMotionCount : INT; // so luong motion dang active\n\n    A_MotionManagerState : INT;\n\t\n\tA_MotionAbortReq  : BOOL;\n    A_MotionAbortDone : BOOL;\n\t\n\tA_MotionDoneQueue : ARRAY[0..20] OF INT;\n\n//     A_MotionDoneHead  : INT := 1;\n//     A_MotionDoneTail  : INT := 1;\n//     A_MotionDoneCount : INT := 0;\n// \tA_MoveSlotReset : ARRAY[0..3] OF BOOL;\n\t\nEND_VAR\n\nVAR_GLOBAL CONSTANT\n\tC_BM_Aborting         : INT := 0;\n    C_BM_BlendingHigh     : INT := 5;\n    C_BM_BlendingLow      : INT := 2;\n    C_BM_BlendingNext     : INT := 4;\n    C_BM_BlendingPrevious : INT := 3;\n    C_BM_Buffered         : INT := 1;\n\n    C_TM_CornerDistance   : INT := 2;\n    C_TM_None             : INT := 0;\n    C_TM_StartVelocity    : INT := 1;\nEND_VAR\n\nVAR_GLOBAL\n\tMotionTolXYZ : REAL := 0.03; // Do chinh xac so sanh cho truc XYZ\n\tMotionTolR : REAL := 0.04;  // Do chinh xac so sanh cho truc R\nEND_VAR\n\n// PRG_A_MotionQueueBuilder\nVAR_GLOBAL\n    A_MotionQueueSize : INT := 20;\n\n    A_MotionStreamEnable : BOOL := TRUE;\n    A_MotionStreamBusy   : BOOL;\n    A_MotionStreamPause  : BOOL;\n\n    A_WaitMotionClear    : BOOL;\n\n    A_MotionQueueAlmostFull : BOOL;\n    A_MotionQueueCanPush    : BOOL;\n\n    A_MotionManagerBusy  : BOOL;\n    A_MotionManagerDone  : BOOL;\n    A_MotionManagerError : BOOL;\n\n    //A_MotionAlarmCode : INT;\nEND_VAR\n\nVAR_GLOBAL\n    A_PipelineDepth        : INT := 3;\n    A_PipelineActive       : BOOL;\n    A_PipelineNextPushStep : INT;\n\n    A_PushMotionReq        : BOOL;\n    A_PushMotionDone       : BOOL;\n    A_PushMotionError      : BOOL;\n    A_PushMotionItem       : ST_MotionQueueItem;\n\n    A_MotionDonePulse      : BOOL;\n    A_MotionDoneStep       : INT;\n\n    A_MotionErrorPulse     : BOOL;\n    A_MotionErrorStep      : INT;\n    A_MotionErrorCode      : INT;\n\tA_RunErrorStep         : INT;\n\tA_MotionErrorSlot\t   : INT;\nEND_VAR\n\nVAR_GLOBAL\n    A_RunMode : INT := 0;\n    // 0 = Auto\n    // 1 = Step\n\n    A_StepRunReq  : BOOL; // Nút bấm chạy 1 step từ HMI\n    A_StepRunEdge : BOOL;\n    A_LastStepRunReq : BOOL;\n\n    A_StepHold : BOOL;    // TRUE = đang dừng chờ bấm step tiếp\nEND_VAR\n\nVAR_GLOBAL\n    // Timer user\n    A_TimerStart : ARRAY[0..20] OF BOOL;\n    A_TimerDone  : ARRAY[0..20] OF BOOL;\n    A_TimerPT    : ARRAY[0..20] OF TIME;\n\n    // Call stack\n    A_CallStack      : ARRAY[0..20] OF INT;\n    A_CallStackIndex : INT;\n\n    // Vision\n    A_VisionTriggerReq  : BOOL;\n    A_VisionDone        : BOOL;\n    A_VisionOK          : BOOL;\n    A_VisionError       : BOOL;\n\n    // Tracking\n    A_TrackEnable       : BOOL;\n    A_TrackPickReq      : BOOL;\n    A_TrackPlaceReq     : BOOL;\n    A_TrackPickDone     : BOOL;\n    A_TrackPlaceDone    : BOOL;\n\n    // Register/Variable\n    A_Reg : ARRAY[0..200] OF DINT;\n    A_Var : ARRAY[0..200] OF DINT;\nEND_VAR\n\nVAR_GLOBAL CONSTANT\n    // Số lượng camera tối đa mà hệ thống hỗ trợ.\n    C_MAX_VISION_CHANNELS : UINT := 4;\n\n    // Số lượng job vision tối đa lưu trong cấu hình.\n    C_MAX_VISION_JOBS : UINT := 32;\n\n    // Số lượng sản phẩm tối đa cùng tồn tại trong hàng đợi tracking.\n    C_MAX_TRACK_OBJECTS : UINT := 32;\n\n    // Số điểm thô tối đa vision có thể trả cho một đường chạy.\n    C_MAX_RAW_PATH_POINTS : UINT := 500;\n\n    // Số điểm tối đa sau khi lọc và xử lý đường chạy.\n    C_MAX_PROCESS_PATH_POINTS : UINT := 500;\n\n    // Số điểm tối đa truyền trong một block Modbus.\n    C_MAX_PATH_BLOCK_POINTS : UINT := 20;\n\n    // Số hạng mục kiểm tra tối đa trong một kết quả inspection.\n    C_MAX_INSPECTION_ITEMS : UINT := 32;\n\n    // Số conveyor tối đa được khai báo trong hệ thống.\n    C_MAX_CONVEYORS : UINT := 2;\n\n    // Giá trị PI kiểu REAL dùng cho các phép đổi góc.\n    C_PI : REAL := 3.141592654;\n\t\n\t// Hệ số chuyển đổi từ độ sang radian.\n    C_DEG_TO_RAD : REAL := 0.01745329252;\n\n    // Hệ số chuyển đổi từ radian sang độ.\n    C_RAD_TO_DEG : REAL := 57.29577951;\n\n    // Giá trị rất nhỏ dùng để tránh phép chia cho 0.\n    C_REAL_EPSILON : REAL := 0.000001;\n\t\n\tC_EPSILON : REAL := 0.000001;\n\n    // Giá trị mặc định dùng để đánh dấu index không hợp lệ.\n    C_INVALID_INDEX : UINT := 0;\n\t\n\t// So sensor source lon nhat\n\tC_MAX_SENSOR_SOURCES :UINT := 4;\n\t// So recipe lon nhat\n\tC_MAX_TRACK_RECIPES :UINT := 4;\n\t// Số Vision Source tối đa.\n\tC_MAX_VISION_SOURCES : UINT := 4;\n\t\n\t// Số Object tối đa Vision được phép trả trong một lần chụp.\n\t\t\n\tC_MAX_VISION_TRACK_OBJECTS_PER_FRAME : UINT := 20;\n\tC_VISION_TRACK_OBJECT_REG_COUNT : UINT := 9;\n\tC_VISION_TRACK_OBJECTS_PER_BLOCK : UINT := 10;\n\tC_MAX_VISION_ALIGN_ITERATIONS : UINT := 4;\n\tC_MAX_VISION_ALIGN_RECIPES : UINT := 16;\n\tC_MAX_TRAYS : UINT := 16;\n\t\t\n\tC_VISION_CAMERA_REGISTER_SIZE : UINT := 300;\n\tC_VISION_R2V_REGISTER_COUNT : UINT := 100;\n\tC_VISION_V2R_REGISTER_COUNT : UINT := 200;\n\tC_VISION_STATUS_OFFSET : UINT := 100;\n\tC_VISION_HEADER_OFFSET : UINT := 101;\n\tC_VISION_SIMPLE_DATA_OFFSET : UINT := 116;\n\tC_VISION_MULTI_DATA_OFFSET : UINT := 132;\n\t\n\n\t\nEND_VAR\nVAR_GLOBAL\n    // Cấu hình các camera.\n    g_aVisionConfig :\n        ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_CONFIG;\n\n    // Cấu hình các job vision.\n    g_aVisionJobConfig :\n        ARRAY[0..C_MAX_VISION_JOBS] OF ST_VISION_JOB_CONFIG;\n\n    // Lệnh gửi tới từng camera.\n    g_aVisionCommand :\n        ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_COMMAND;\n\n    // Trạng thái từng camera.\n    g_aVisionStatus :\n        ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_CHANNEL_STATUS;\n\n    // Kết quả của từng camera.\n    g_aVisionResult :\n        ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_RESULT;\n\t\t\n\t// Monitor Bit Vision\n\tg_aVision_ControlWord : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_ControlWord_VS;\n\tg_aVision_StatusWord : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_StatusWord_VS;\n\t\n    // Dữ liệu ứng dụng.\n    g_stAlignRuntime         : ST_ALIGN_RUNTIME;\n    g_stInspectionRuntime    : ST_INSPECTION_RUNTIME;\n    g_stGlueRuntime          : ST_GLUE_RUNTIME;\n\n    // Dữ liệu conveyor.\n    g_aConveyorRuntime :\n        ARRAY[0..C_MAX_CONVEYORS] OF ST_CONVEYOR_RUNTIME;\n\n    // Hàng đợi sản phẩm tracking.\n    g_stTrackingQueue_A        : ST_TRACKING_QUEUE;\n\n    // Cấu hình và runtime tracking.\n    g_stTrackingConfig_A       : ST_TRACKING_CONFIG;\n    g_stTrackingRuntime_A      : ST_TRACKING_RUNTIME;\n\n    // Giai đoạn kiểm thử đang được chọn.\n    g_eSystemTestStage       : E_SystemTestStage;\n\t// Khai bao bien goc cho he toa do Conveyor\n\t//g_stConveyorOrigin \t\t : ST_POS; \nEND_VAR\n// Application Variable\nVAR_GLOBAL\n    // Command/response chung giữa Interpreter và Application Manager.\n    g_stApplicationCommandA : ST_APPLICATION_COMMAND;\n    g_stApplicationResponseA : ST_APPLICATION_RESPONSE;\n\n    // Cấu hình mô phỏng Conveyor Tracking.\n    g_stTrackingSimulation : ST_TRACKING_SIMULATION_CONFIG;\n\n    // Quyền sở hữu Motion Queue.\n    g_xApplicationMotionOwnerA : BOOL;\n\n    // Adapter tracking → Motion Queue.\n    g_xTrackingMotionAccepted : BOOL;\n    g_xTrackingMotionBusy : BOOL;\n    g_xTrackingMotionDone : BOOL;\n    g_xTrackingMotionError : BOOL;\n    g_udiTrackingMotionErrorID : UDINT;\n    g_xTrackingMotionAbortDone : BOOL;\n\n    // IO logic; sau này map sang IO thật theo Tracking Config.\n    g_xTrackingVacuumOutput : BOOL;\n    g_xTrackingBlowOutput : BOOL;\n    g_xTrackingVacuumOK : BOOL;\n\n    // Recipe tracking. Giai đoạn đầu dùng 1 recipe.\n    // Sau khi HMI hoàn thiện có thể đổi thành ARRAY recipe.\n    g_xTrackingConfigInitialized : BOOL;\n\t\n\t\n\t// Command từ Interpreter tới Tracking Engine.\n    A_TrackStartCmd : BOOL;\n    A_TrackAbortCmd : BOOL;\n    A_TrackResetCmd : BOOL;\n\n    // Response từ Tracking Engine về Interpreter/HMI.\n    A_TrackEngineAccepted : BOOL;\n    A_TrackEngineBusy : BOOL;\n    A_TrackEngineDone : BOOL;\n    A_TrackEngineError : BOOL;\n    A_TrackEngineErrorID : UDINT;\n    A_TrackEngineState : INT;\n\nEND_VAR\n\nVAR_GLOBAL CONSTANT\n    // Số lượng Tool tối đa trên một Robot.\n    C_MAX_TOOLS : UINT := 8;\n\n    // Số lượng Digital Input logic tối đa.\n    C_MAX_DI : UINT := 128;\n\n    // Số lượng Digital Output logic tối đa.\n    C_MAX_DO : UINT := 128;\n\nEND_VAR\n\n//=============================================================================\n// GVL: LOGICAL IO - ROBOT A\n//-----------------------------------------------------------------------------\n// IO vật lý nên được Map vào các mảng này tại một chương trình riêng.\n//=============================================================================\nVAR_GLOBAL\n\n    // Command và Status của lệnh TRACK_ON.\n\tg_stMultiTrackCommandA : ST_MultiToolTrackingCommand;\n\tg_stMultiTrackStatusA : ST_MultiToolTrackingStatus;\n\t\n\t// Cấu hình và Runtime Tool Robot A.\n\tg_aToolConfigA : ARRAY[0..C_MAX_TOOLS] OF ST_ToolConfig;\n\tg_aToolStatusA : ARRAY[0..C_MAX_TOOLS] OF ST_ToolStatus;\n\t\n\t// Recipe và Queue Robot A.\n\tg_aMultiTrackRecipeA : ARRAY[0..C_MAX_TRACK_RECIPES] OF ST_MultiToolTrackingRecipe;\n\tg_stTrackingObjectQueueA : ST_TrackingObjectQueue;\n\t\n\t// Cấu hình các nguồn Sensor.\n    g_aSensorSourceConfigA : ARRAY[0..C_MAX_SENSOR_SOURCES] OF ST_SensorObjectSourceConfig;\n\n  \t// Cấu hình Vision Tracking cho từng Camera/Channel.\n\tg_aVisionTrackingSourceConfigA : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VisionTrackingSourceConfig;\n\t\n\t// Multi-object result dành riêng cho Conveyor Tracking.\n\tg_aVisionTrackingMultiResultA : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VisionTrackingMultiResult;\n\t\n\tg_aVisionAlignRecipeA : ARRAY[0..C_MAX_VISION_ALIGN_RECIPES] OF ST_VisionAlignRecipe;\n\tg_aVisionAlignRuntimeA : ARRAY[1..C_MAX_TOOLS] OF ST_VisionAlignToolRuntime;\n\tg_aTrayConfigA : ARRAY[0..C_MAX_TRAYS] OF ST_TrayConfig;\n\tg_aTrayRuntimeA : ARRAY[0..C_MAX_TRAYS] OF ST_TrayRuntime;\n\n\t\n\t// Giao tiếp giữa MultiTool Controller và Tracking Core hiện tại.\n\tg_xMultiTrackCoreExecuteA : BOOL;\n\tg_xMultiTrackCoreResetA : BOOL;\n\tg_xMultiTrackCoreAbortA : BOOL;\n\tg_xMultiTrackPickerSafeA : BOOL;\n\t\n\tg_uiMultiTrackObjectIndexA : UINT;\n\tg_uiMultiTrackToolIDA : UINT;\n\tg_stMultiTrackPickOffsetA : ST_POS;\n\tg_rMultiTrackApproachHeightA : REAL;\n\t\n\t// Phản hồi từ Tracking Core về MultiTool Controller.\n\tg_xTrackingCoreAcceptedA : BOOL;\n\tg_xTrackingCoreBusyA : BOOL;\n\tg_xTrackingCoreSyncOKA : BOOL;\n\tg_xTrackingCorePCSInUseA : BOOL;\n\tg_xTrackingCoreReleasedA : BOOL;\n\tg_xTrackingCoreErrorA : BOOL;\n\tg_udiTrackingCoreErrorIDA : UDINT;\n\t\n\t// Command Tool được Controller phát ra.\n\tg_stToolCommandA : ST_ToolCommand;\n\t\n\t// Chọn Tool/TCP Robot A.\n\tg_xSelectToolExecuteA : BOOL;\n\tg_uiSelectToolIDA : UINT;\n\tg_stSelectToolTCPA : ST_POS;\n\tg_xSelectToolDoneA : BOOL;\n\tg_xSelectToolErrorA : BOOL;\n\tg_udiSelectToolErrorIDA : UDINT;\n\t\n\t// IO logic Tool Robot A.\n\t// Nếu project đã có mảng IO chung thì dùng mảng cũ và không khai báo lại.\n\tg_axDIA : ARRAY[0..C_MAX_DI] OF BOOL;\n\tg_axDORequestToolA : ARRAY[0..C_MAX_DO] OF BOOL;\n\t\n\t// Bit test commissioning. Không dùng trong Interpreter chính thức.\n\tg_xMultiTrackStartTestA : BOOL;\n\tg_xMultiTrackResetTestA : BOOL;\n\tg_xMultiTrackAbortTestA : BOOL;\n\tg_xCreateTestTrackingObjectA : BOOL;\n\t\n\t// TRUE khi cấu hình Multi-tool Robot A đã được khởi tạo.\n\tg_xMultiToolConfigInitializedA : BOOL := FALSE;\n\t\n\t// Bit cho phép khởi tạo lại giá trị mặc định khi commissioning.\n\tg_xInitializeMultiToolConfigA : BOOL := FALSE;\n\t\n\tg_xClearTrackingQueueA : BOOL;\n\tg_xResetTrackingObjectSourceA : BOOL;\n\t\n\t//=============================================================================\n\t// TRACKING APPLICATION RESULT - ROBOT A\n\t//=============================================================================\n\tg_xTrackOKA : BOOL;              // TRUE khi lệnh Tracking gần nhất Pick đủ số lượng.\n\tg_xTrackErrorA : BOOL;           // TRUE khi lệnh Tracking kết thúc lỗi.\n\tg_udiTrackErrorIDA : UDINT;      // ErrorID của lệnh Tracking gần nhất.\n\tg_udiTrackDoneCommandIDA : UDINT;// CommandID đã hoàn thành.\n\t//=============================================================================\n\t// TOOL COMMAND TỪ INTERPRETER - ROBOT A\n\t//=============================================================================\n\tg_stInterpreterToolCommandA : ST_ToolCommand;\n\t\n\tg_HMI_PulsePerCycle_Cr: REAL;\n\tg_HMI_PulsePerCycle_Set : INT;\n\t\n\t// Cho phép test Background Vision Trigger mà chưa cần chạy TRACK_PICK.\n\t// Production bình thường phải để FALSE.\n\tg_xVisionTrackingAutoTriggerTestA : BOOL := FALSE;\n\nEND_VAR\n\n//=============================================================================\n// GVL_HMI_TOOL_CONFIG\n//-----------------------------------------------------------------------------\n// Biến trung gian phục vụ màn hình cấu hình Tool dùng chung cho Robot A và B.\n//=============================================================================\nVAR_GLOBAL\n\n    //=========================================================================\n    // ROBOT A\n    //=========================================================================\n\n    // Dữ liệu chỉnh sửa Tool Robot A.\n    g_stHMIToolEditorA : ST_HMIToolConfigEditor;\n\n    // Trạng thái Tool đang được chọn của Robot A.\n    // HMI chỉ đọc biến này, không ghi trực tiếp vào mảng ToolStatus.\n    g_stHMIToolStatusA : ST_ToolStatus;\n\n    // Các bộ bắt cạnh lệnh HMI Robot A.\n    g_rtHMIToolLoadA : R_TRIG;\n    g_rtHMIToolSaveA : R_TRIG;\n    g_rtHMIToolCancelA : R_TRIG;\n\n    // Index Tool được chọn ở vòng quét trước.\n    g_uiHMIToolSelectedIndexOldA : UINT;\n\n    // Biến chạy vòng FOR kiểm tra ToolID trùng.\n    g_uiHMIToolCheckIndexA : UINT;\n\n    // TRUE khi phát hiện ToolID bị trùng.\n    g_xHMIToolDuplicateIDA : BOOL;\n\n\n    //=========================================================================\n    // ROBOT B\n    //=========================================================================\n\n    // Dữ liệu chỉnh sửa Tool Robot B.\n    g_stHMIToolEditorB : ST_HMIToolConfigEditor;\n\n    // Trạng thái Tool đang được chọn của Robot B.\n    g_stHMIToolStatusB : ST_ToolStatus;\n\n    // Các bộ bắt cạnh lệnh HMI Robot B.\n    g_rtHMIToolLoadB : R_TRIG;\n    g_rtHMIToolSaveB : R_TRIG;\n    g_rtHMIToolCancelB : R_TRIG;\n\n    // Index Tool được chọn ở vòng quét trước.\n    g_uiHMIToolSelectedIndexOldB : UINT;\n\n    // Biến chạy vòng FOR kiểm tra ToolID trùng.\n    g_uiHMIToolCheckIndexB : UINT;\n\n    // TRUE khi phát hiện ToolID bị trùng.\n    g_xHMIToolDuplicateIDB : BOOL;\n\nEND_VAR\n\n//=============================================================================\n// GVL_HMI_TOOL_CONFIG\n//-----------------------------------------------------------------------------\n// Biến trung gian phục vụ màn hình cấu hình Tool dùng chung cho Robot A và B.\n//=============================================================================\n\nVAR_GLOBAL\n\tg_stHMIConveyor_Config_Save: BOOL;\n\tg_stHMITracking_Config_Save: BOOL;\n\tg_stHMIConveyor_Config_Read: BOOL;\n\tg_stHMITracking_Config_Read: BOOL;\n\tg_stHMITool_Config_Read_All: BOOL;\n\tg_stHMITool_Config_Save_All: BOOL;\nEND_VAR\n\n//=============================================================================\n// GVL_HMI_SENSOR SOURCE_CONFIG\n//-----------------------------------------------------------------------------\n// Biến trung gian phục vụ màn hình cấu hình sensor source dùng chung cho Robot A.\n//====\nVAR_GLOBAL\n\t// Sensor Source đang chọn trên HMI.\n\tg_uiHMISensorSourceIndexA : UINT := 1;\n\t\n\t// Dữ liệu trung gian HMI.\n\tg_stHMISensorSourceA : ST_SensorObjectSourceConfig;\n\t\n\t// Lệnh HMI.\n\tg_xHMILoadSensorSourceA : BOOL;\n\tg_xHMISaveSensorSourceA : BOOL;\n\tg_xHMILoadSensorSourceA_All: BOOL;\n\tg_xHMISaveSensorSourceA_All : BOOL;\nEND_VAR\n\n//=============================================================================\n// GVL_HMI_RECIPE_CONFIG\n//-----------------------------------------------------------------------------\n// Biến trung gian phục vụ màn hình cấu hình recipe dùng chung cho Robot A.\n//====\nVAR_GLOBAL\n\t// Recipe đang chọn trên HMI.\n\tg_uiHMITrackingRecipeIndexA : UINT := 1;\n\t// Dữ liệu trung gian HMI.\n\tg_stHMITrackingRecipeA : ST_MultiToolTrackingRecipe;\n\t// Lệnh HMI.\n\tg_xHMILoadTrackingRecipeA : BOOL;\n\tg_xHMISaveTrackingRecipeA : BOOL;\n\tg_xHMILoadTrackingRecipeA_All : BOOL;\n\tg_xHMISaveTrackingRecipeA_All : BOOL;\nEND_VAR\n\n//=============================================================================\n// GVL_HMI_VISION_SOURCE\n//-----------------------------------------------------------------------------\n// Biến trung gian phục vụ màn hình cấu hình vision source dùng chung cho Robot A.\n//====\nVAR_GLOBAL\n\tg_uiHMIVisionSourceIndexA : UINT := 1;\n\n\tg_stHMIVisionSourceA : ST_VisionTrackingSourceConfig;\n\t\n\tg_xHMILoadVisionSourceA : BOOL;\n\tg_xHMISaveVisionSourceA : BOOL;\n\tg_xHMISaveAllVisionSourceA : BOOL;\n\tg_xHMILoadAllVisionSourceA : BOOL := FALSE;\n\t\n\t//=============================================================================\n\t// ROBOT A - LAST VISION ALIGN RESULT\n\t//=============================================================================\n\tA_VisionHeaderOK : BOOL;                    // Header của Result cuối hợp lệ.\n\tA_VisionTriggerID : UDINT;                  // TriggerID cuối cùng.\n\t\n\tA_VisionX : REAL;                           // X Vision trả về.\n\tA_VisionY : REAL;                           // Y Vision trả về.\n\tA_VisionZ : REAL;                           // Z Vision trả về.\n\tA_VisionA : REAL;                           // Góc Vision trả về.\n\tA_VisionScore : REAL;                       // Score Vision.\n\tA_VisionFeatureID : UINT;                   // FeatureID Vision.\n\nEND_VAR\n\n// VISION MODBUS\n\nVAR_GLOBAL\n\tg_aVisionModbusControl : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_MODBUS_CONTROL;\n\tg_aVisionModbusStatus : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VISION_MODBUS_STATUS;\nEND_VAR\n\nVAR_GLOBAL\n\t//=============================================================================\n\t// 1. THÊM VÀO GVL\n\t//=============================================================================\n\t\n\t// Mỗi lần cần Apply lại Tool/TCP thì tăng RequestID.\n\tg_udiRobotAToolApplyRequestA : UDINT := 0;\n\t\n\t// RequestID đã Apply thành công.\n\tg_udiRobotAToolAppliedRequestA : UDINT := 0;\n\t\n\t// Trạng thái Apply Tool.\n\tg_xRobotAToolApplyBusy : BOOL := FALSE;\n\tg_xRobotAToolApplyDone : BOOL := FALSE;\n\tg_xRobotAToolApplyError : BOOL := FALSE;\n\tg_udiRobotAToolApplyErrorID : UDINT := 0;\n\nEND_VAR\n\n// ------------------------------\n// ROBOT B\n// ------------------------------\n// ROBOT B - add these variables into GVL\n// Generated from Robot A variables actually used by current Interpreter/MotionManager\n\nVAR_GLOBAL\n\tB_ActiveMotionCount : INT;\n\tB_CallStack : ARRAY[0..20] OF INT;\n\tB_CallStackIndex : INT;\n\tB_CurrentMotionParam : ST_MotionParam := (Speed := 500.0, Acc := 2000.0, Dec := 2000.0, Jerk := 10000.0, VelFac := 1.0, AccFac := 1.0, DecFac := 1.0, JerkFac := 1.0);\n\tB_LastStepRunReq : BOOL;\n\tB_LengthStep : INT;\n\tB_MotionAbortDone : BOOL;\n\tB_MotionAbortReq : BOOL;\n\tB_MotionCount : INT := 0;\n\tB_MotionDonePulse : BOOL;\n\tB_MotionDoneStep : INT;\n\tB_MotionErrorCode : INT;\n\tB_MotionErrorPulse : BOOL;\n\tB_MotionErrorSlot : INT;\n\tB_MotionErrorStep : INT;\n\tB_MotionQueue : ARRAY[0..20] OF ST_MotionQueueItem;\n\tB_MotionHead : INT := 1;\n\tB_MotionManagerBusy : BOOL;\n\tB_MotionManagerDone : BOOL;\n\tB_MotionManagerError : BOOL;\n\tB_MotionManagerState : INT;\n\tB_MotionTail : INT := 1;\n\tB_MoveSlotAccepted : ARRAY[0..3] OF BOOL;\n\tB_MoveSlotBusy : ARRAY[0..3] OF BOOL;\n\tB_MoveSlotCmd : ARRAY[0..3] OF E_RobotCmd;\n\tB_MoveSlotDone : ARRAY[0..3] OF BOOL;\n\tB_MoveSlotError : ARRAY[0..3] OF BOOL;\n\tB_MoveSlotErrorID : ARRAY[0..3] OF INT;\n\tB_MoveSlotItem : ARRAY[0..3] OF ST_MotionQueueItem;\n\tB_MoveSlotReleasePending : ARRAY[0..3] OF BOOL;\n\tB_MoveSlotStart : ARRAY[0..3] OF BOOL;\n\tB_PipelineActive : BOOL;\n\tB_PipelineDepth : INT := 3;\n\tB_PipelineNextPushStep : INT;\n\tB_PipelineUsedCount : INT := 0;\n\tB_PushMotionDone : BOOL;\n\tB_PushMotionError : BOOL;\n\tB_PushMotionItem : ST_MotionQueueItem;\n\tB_PushMotionReq : BOOL;\n\tB_Reg : ARRAY[0..200] OF DINT;\n\tB_RunAlarm : BOOL;\n\tB_RunAlarmCode : INT;\n\tB_RunBusy : BOOL;\n\tB_RunDone : BOOL;\n\tB_RunEnable : BOOL;\n\tB_RunErrorStep : INT;\n\tB_RunMode : INT := 0;\n\tB_RunPause : BOOL;\n\tB_RunState : INT := 0;\n\tB_RunStep : INT := 1;\n\tB_RunStop : BOOL;\n\tB_StepActive : BOOL;\n\tB_StepHold : BOOL;\n\tB_StepRunEdge : BOOL;\n\tB_StepRunReq : BOOL;\n\tB_TimerDone : ARRAY[0..20] OF BOOL;\n\tB_TimerPT : ARRAY[0..20] OF TIME;\n\tB_TimerStart : ARRAY[0..20] OF BOOL;\n\tB_TrackEnable : BOOL;\n\tB_TrackEngineBusy : BOOL;\n\tB_TrackEngineDone : BOOL;\n\tB_TrackEngineError : BOOL;\n\tB_TrackEngineErrorID : UDINT;\n\tB_TrackPlaceDone : BOOL;\n\tB_TrackPlaceReq : BOOL;\n\tB_TrackStartCmd : BOOL;\n\tB_Var : ARRAY[0..200] OF DINT;\n\tB_VisionDone : BOOL;\n\tB_VisionError : BOOL;\n\tB_VisionOK : BOOL;\n\tB_VisionTriggerReq : BOOL;\nEND_VAR\n\n// ============================================================\n// ADD TO GVL - HMI ROBOT B\n// Các biến này mirror trực tiếp biến HMI Robot A.\n// AB_StepBlockClipboard / AB_StepCopyCount vẫn dùng chung để có thể copy block step.\n// ============================================================\nVAR_GLOBAL\n    B_PointClipboardName : STRING(20);\n    B_PointClipboardR : REAL;\n    B_PointClipboardSourceNo : INT;\n    B_PointClipboardValid : BOOL;\n    B_PointClipboardX : REAL;\n    B_PointClipboardY : REAL;\n    B_PointClipboardZ : REAL;\n    B_StepClipboard : ST_RobotStep;\n    B_StepClipboardValid : BOOL;\n    B_StepCopyEnd : INT;\n    B_StepCopyStart : INT;\n    HMI_B_ChangeSelectedPoint : BOOL;\n    HMI_B_CondCmdReq : INT;\n    HMI_B_CondCmd_Down : BOOL;\n    HMI_B_CondCmd_GoBot : BOOL;\n    HMI_B_CondCmd_GoTop : BOOL;\n    HMI_B_CondCmd_PageDown : BOOL;\n    HMI_B_CondCmd_PageUp : BOOL;\n    HMI_B_CondCmd_Up : BOOL;\n    HMI_B_CondCopied : ST_Condition;\n    HMI_B_CondEditEnable : BOOL;\n    HMI_B_CondEditIndex : ARRAY[0..10] OF INT;\n    HMI_B_CondEditLinkNext : ARRAY[0..10] OF INT;\n    HMI_B_CondEditName : STRING(20);\n    HMI_B_CondEditNo : INT;\n    HMI_B_CondEditNote : ARRAY[0..10] OF STRING(30);\n    HMI_B_CondEditOperator : ARRAY[0..10] OF INT;\n    HMI_B_CondEditRowEnable : ARRAY[0..10] OF BOOL;\n    HMI_B_CondEditSetValue : ARRAY[0..10] OF DINT;\n    HMI_B_CondEditSource : ARRAY[0..10] OF INT;\n    HMI_B_CondMonActualValue : ARRAY[0..10] OF DINT;\n    HMI_B_CondMonFinalResult : BOOL;\n    HMI_B_CondMonRowResult : ARRAY[0..10] OF BOOL;\n    HMI_B_CondMonitorEnable : BOOL;\n    HMI_B_CondRowSelect : ARRAY[0..10] OF BOOL;\n    HMI_B_CondSelectedCmd : INT;\n    HMI_B_CondSelectedNo : INT;\n    HMI_B_CondViewEnable : ARRAY[0..10] OF BOOL;\n    HMI_B_CondViewName : ARRAY[0..10] OF STRING(20);\n    HMI_B_CondViewNo : ARRAY[0..10] OF INT;\n    HMI_B_CondViewResult : ARRAY[0..10] OF BOOL;\n    HMI_B_CondViewStart : INT;\n    HMI_B_CopyEndStep : INT;\n    HMI_B_CopyStartStep : INT;\n    HMI_B_EditCmd : E_RobotCmd;\n    HMI_B_EditCmdReq : INT;\n    HMI_B_EditCmdReq_Arr : ARRAY[0..20] OF BOOL;\n    HMI_B_EditGroupCmd : INT;\n    HMI_B_EditNote : STRING(20);\n    HMI_B_EditP1 : INT;\n    HMI_B_EditP2 : INT;\n    HMI_B_EditP3 : DINT;\n    HMI_B_EditP4 : INT;\n    HMI_B_EditP5 : INT;\n    HMI_B_EditPointReq : INT;\n    HMI_B_EditPointReq_Arr : ARRAY[0..10] OF BOOL;\n    HMI_B_EditSelgroupCmd : ARRAY[0..10] OF BOOL;\n    HMI_B_EditStepNo : INT;\n    HMI_B_Edit_PointNo : INT;\n    HMI_B_Edit_Pos_Name : STRING(20);\n    HMI_B_Edit_Pos_R : REAL;\n    HMI_B_Edit_Pos_X : REAL;\n    HMI_B_Edit_Pos_Y : REAL;\n    HMI_B_Edit_Pos_Z : REAL;\n    HMI_B_Edit_Trigger_Windown_Cmd : ARRAY[0..10] OF BOOL;\n    HMI_B_PointNo : ARRAY[0..10] OF INT;\n    HMI_B_PointNoSelected : INT;\n    HMI_B_PointViewCmd : INT;\n    HMI_B_RowSelect : ARRAY[0..10] OF BOOL;\n    HMI_B_RowSelectedCmd : INT;\n    HMI_B_RowSelectedPoint : INT;\n    HMI_B_RowSelectedPoint_Array : ARRAY[0..10] OF BOOL;\n    HMI_B_SelectedStepNo : INT;\n    HMI_B_ViewCmd : ARRAY[0..10] OF INT;\n    HMI_B_ViewCmd_Go_Bot : BOOL;\n    HMI_B_ViewCmd_Go_Bot_Old : BOOL;\n    HMI_B_ViewCmd_Go_Top : BOOL;\n    HMI_B_ViewCmd_Go_Top_Old : BOOL;\n    HMI_B_ViewCmd_Page_Down : BOOL;\n    HMI_B_ViewCmd_Page_Down_Old : BOOL;\n    HMI_B_ViewCmd_Page_Up : BOOL;\n    HMI_B_ViewCmd_Page_Up_Old : BOOL;\n    HMI_B_ViewCmd_Scroll_Down : BOOL;\n    HMI_B_ViewCmd_Scroll_Down_Old : BOOL;\n    HMI_B_ViewCmd_Scroll_Up : BOOL;\n    HMI_B_ViewCmd_Scroll_Up_Old : BOOL;\n    HMI_B_ViewGroupCmd : ARRAY[0..10] OF INT;\n    HMI_B_ViewNote : ARRAY[0..10] OF STRING(20);\n    HMI_B_ViewP1 : ARRAY[0..10] OF INT;\n    HMI_B_ViewP2 : ARRAY[0..10] OF INT;\n    HMI_B_ViewP3 : ARRAY[0..10] OF DINT;\n    HMI_B_ViewP4 : ARRAY[0..10] OF INT;\n    HMI_B_ViewP5 : ARRAY[0..10] OF INT;\n    HMI_B_ViewP6 : ARRAY[0..10] OF INT;\n    HMI_B_ViewStartPoint : INT;\n    HMI_B_ViewStartStep : INT := 1;\n    HMI_B_ViewStepNo : ARRAY[0..10] OF INT;\n    HMI_B_View_Pos_Name : ARRAY[0..10] OF STRING(20);\n    HMI_B_View_Pos_R : ARRAY[0..10] OF REAL;\n    HMI_B_View_Pos_X : ARRAY[0..10] OF REAL;\n    HMI_B_View_Pos_Y : ARRAY[0..10] OF REAL;\n    HMI_B_View_Pos_Z : ARRAY[0..10] OF REAL;\nEND_VAR\n\n//=============================================================================\n// GVL: LOGICAL IO - ROBOT B\n//-----------------------------------------------------------------------------\n// IO vật lý nên được Map vào các mảng này tại một chương trình riêng.\n//=============================================================================\nVAR_GLOBAL\n\n    // Command và Status của lệnh TRACK_ON.\n\tg_stMultiTrackCommandB : ST_MultiToolTrackingCommand;\n\tg_stMultiTrackStatusB : ST_MultiToolTrackingStatus;\n\t\n\t// Cấu hình và Runtime Tool Robot A.\n\tg_aToolConfigB : ARRAY[0..C_MAX_TOOLS] OF ST_ToolConfig;\n\tg_aToolStatusB : ARRAY[0..C_MAX_TOOLS] OF ST_ToolStatus;\n\t\n\t// Recipe và Queue Robot A.\n\tg_aMultiTrackRecipeB : ARRAY[0..C_MAX_TRACK_RECIPES] OF ST_MultiToolTrackingRecipe;\n\tg_stTrackingObjectQueueB : ST_TrackingObjectQueue;\n\t\n\t// Cấu hình các nguồn Sensor.\n    g_aSensorSourceConfigB : ARRAY[0..C_MAX_SENSOR_SOURCES] OF ST_SensorObjectSourceConfig;\n\n  \t// Cấu hình Vision Tracking cho từng Camera/Channel.\n\tg_aVisionTrackingSourceConfigB : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VisionTrackingSourceConfig;\n\t\n\t// Multi-object result dành riêng cho Conveyor Tracking.\n\tg_aVisionTrackingMultiResultB : ARRAY[0..C_MAX_VISION_CHANNELS] OF ST_VisionTrackingMultiResult;\n\t\n\tg_aVisionAlignRecipeB : ARRAY[0..C_MAX_VISION_ALIGN_RECIPES] OF ST_VisionAlignRecipe;\n\tg_aVisionAlignRuntimeB : ARRAY[1..C_MAX_TOOLS] OF ST_VisionAlignToolRuntime;\n\tg_aTrayConfigB : ARRAY[0..C_MAX_TRAYS] OF ST_TrayConfig;\n\tg_aTrayRuntimeB : ARRAY[0..C_MAX_TRAYS] OF ST_TrayRuntime;\n\n\t\n\t// Giao tiếp giữa MultiTool Controller và Tracking Core hiện tại.\n\tg_xMultiTrackCoreExecuteB : BOOL;\n\tg_xMultiTrackCoreResetB : BOOL;\n\tg_xMultiTrackCoreAbortB : BOOL;\n\tg_xMultiTrackPickerSafeB : BOOL;\n\t\n\tg_uiMultiTrackObjectIndexB : UINT;\n\tg_uiMultiTrackToolIDB : UINT;\n\tg_stMultiTrackPickOffsetB : ST_POS;\n\tg_rMultiTrackApproachHeightB : REAL;\n\t\n\t// Phản hồi từ Tracking Core về MultiTool Controller.\n\tg_xTrackingCoreAcceptedB : BOOL;\n\tg_xTrackingCoreBusyB : BOOL;\n\tg_xTrackingCoreSyncOKB : BOOL;\n\tg_xTrackingCorePCSInUseB : BOOL;\n\tg_xTrackingCoreReleasedB : BOOL;\n\tg_xTrackingCoreErrorB : BOOL;\n\tg_udiTrackingCoreErrorIDB : UDINT;\n\t\n\t// Command Tool được Controller phát ra.\n\tg_stToolCommandB : ST_ToolCommand;\n\t\n\t// Chọn Tool/TCP Robot B.\n\tg_xSelectToolExecuteB : BOOL;\n\tg_uiSelectToolIDB : UINT;\n\tg_stSelectToolTCPB : ST_POS;\n\tg_xSelectToolDoneB : BOOL;\n\tg_xSelectToolErrorB : BOOL;\n\tg_udiSelectToolErrorIDB : UDINT;\n\t\n\t// IO logic Tool Robot B.\n\t// Nếu project đã có mảng IO chung thì dùng mảng cũ và không khai báo lại.\n\tg_axDIB : ARRAY[0..C_MAX_DI] OF BOOL;\n\tg_axDORequestToolB : ARRAY[0..C_MAX_DO] OF BOOL;\n\t\n\t// Bit test commissioning. Không dùng trong Interpreter chính thức.\n\tg_xMultiTrackStartTestB : BOOL;\n\tg_xMultiTrackResetTestB : BOOL;\n\tg_xMultiTrackAbortTestB : BOOL;\n\tg_xCreateTestTrackingObjectB : BOOL;\n\t\n\t// TRUE khi cấu hình Multi-tool Robot B đã được khởi tạo.\n\tg_xMultiToolConfigInitializedB : BOOL := FALSE;\n\t\n\t// Bit cho phép khởi tạo lại giá trị mặc định khi commissioning.\n\tg_xInitializeMultiToolConfigB : BOOL := FALSE;\n\t\n\tg_xClearTrackingQueueB : BOOL;\n\tg_xResetTrackingObjectSourceB : BOOL;\n\t\n\t//=============================================================================\n\t// TRACKING APPLICATION RESULT - ROBOT B\n\t//=============================================================================\n\tg_xTrackOKB : BOOL;              // TRUE khi lệnh Tracking gần nhất Pick đủ số lượng.\n\tg_xTrackErrorB : BOOL;           // TRUE khi lệnh Tracking kết thúc lỗi.\n\tg_udiTrackErrorIDB : UDINT;      // ErrorID của lệnh Tracking gần nhất.\n\tg_udiTrackDoneCommandIDB : UDINT;// CommandID đã hoàn thành.\n\t//=============================================================================\n\t// TOOL COMMAND TỪ INTERPRETER - ROBOT B\n\t//=============================================================================\n\tg_stInterpreterToolCommandB : ST_ToolCommand;\n\t\n\tg_HMI_PulsePerCycle_Cr_B: REAL;\n\tg_HMI_PulsePerCycle_Set_B : INT;\n\t\n\t// Cho phép test Background Vision Trigger mà chưa cần chạy TRACK_PICK.\n\t// Production bình thường phải để FALSE.\n\tg_xVisionTrackingAutoTriggerTestB : BOOL := FALSE;\n\nEND_VAR\n\nVAR_GLOBAL\n\t//=========================================================================\n\n    // VISION REQUEST FROM ROBOT INTERPRETERS\n\n    //=========================================================================\n\n    g_stVisionAlignRequestA : ST_VISION_ALIGN_REQUEST; // Request Vision Align từ Robot A.\n\n    g_stVisionAlignRequestB : ST_VISION_ALIGN_REQUEST; // Request Vision Align từ Robot B.\n\t\nEND_VAR\n\nVAR_GLOBAL\n\t//=============================================================================\n\t// V5 - CHỈ BỔ SUNG CHO ROBOT B. ROBOT A GIỮ NGUYÊN.\n\t// Robot A tiếp tục dùng toàn bộ biến generic hiện tại:\n\t// g_xTrackingMotionAccepted, g_xTrackingMotionBusy, g_xTrackingMotionDone,\n\t// g_xTrackingMotionError, g_udiTrackingMotionErrorID, g_xTrackingMotionAbortDone,\n\t// g_xTrackingVacuumOutput, g_xTrackingBlowOutput.\n\t//=============================================================================\n\t\n\t// Tracking state riêng Robot B.\n\tg_stTrackingConfig_B : ST_TRACKING_CONFIG; // Cấu hình Tracking Robot B.\n\tg_stTrackingQueue_B : ST_TRACKING_QUEUE; // Queue Object Robot B.\n\tg_stTrackingRuntime_B : ST_TRACKING_RUNTIME; // Runtime Tracking Robot B.\n\t\n\t// Motion handshake riêng Robot B.\n\tg_xTrackingMotionAcceptedB : BOOL; // Motion Adapter B đã nhận request.\n\tg_xTrackingMotionBusyB : BOOL; // Motion Tracking B đang chạy.\n\tg_xTrackingMotionDoneB : BOOL; // Motion Tracking B hoàn thành.\n\tg_xTrackingMotionErrorB : BOOL; // Motion Tracking B lỗi.\n\tg_udiTrackingMotionErrorIDB : UDINT; // ErrorID Motion Tracking B.\n\tg_xTrackingMotionAbortDoneB : BOOL; // Motion B đã Abort xong.\n\t\n\t// Debug/output riêng Robot B.\n\tg_xTrackingVacuumOutputB : BOOL; // VacuumCommand của Tracking Manager B.\n\tg_xTrackingBlowOutputB : BOOL; // BlowCommand của Tracking Manager B.\n\t\n\t// Apply Tool/TCP riêng Robot B.\n\tg_udiRobotBToolApplyRequestB : UDINT; // RequestID đổi Tool/TCP B.\n\tg_udiRobotBToolAppliedRequestB : UDINT; // RequestID B đã Apply thành công.\n\tg_xRobotBToolApplyBusy : BOOL; // B đang Apply Tool/TCP.\n\tg_xRobotBToolApplyDone : BOOL; // Xung Done Apply Tool/TCP B.\n\tg_xRobotBToolApplyError : BOOL; // Lỗi Apply Tool/TCP B.\n\tg_udiRobotBToolApplyErrorID : UDINT; // ErrorID Apply Tool/TCP B.\n\n\nEND_VAR\n\nVAR_GLOBAL\n\t//=============================================================================\n\t// HMI TRACKING CONFIG - ROBOT B\n\t// Chỉ thêm các biến B còn thiếu. Tool Editor B đã tồn tại trong project (4).\n\t//=============================================================================\n\t\n\t// Sensor Source B.\n\tg_uiHMISensorSourceIndexB : UINT := 1;\n\tg_stHMISensorSourceB : ST_SensorObjectSourceConfig;\n\tg_xHMILoadSensorSourceB : BOOL;\n\tg_xHMISaveSensorSourceB : BOOL;\n\tg_xHMILoadSensorSourceB_All : BOOL;\n\tg_xHMISaveSensorSourceB_All : BOOL;\n\t\n\t// Tracking Recipe B.\n\tg_uiHMITrackingRecipeIndexB : UINT := 1;\n\tg_stHMITrackingRecipeB : ST_MultiToolTrackingRecipe;\n\tg_xHMILoadTrackingRecipeB : BOOL;\n\tg_xHMISaveTrackingRecipeB : BOOL;\n\tg_xHMILoadTrackingRecipeB_All : BOOL;\n\tg_xHMISaveTrackingRecipeB_All : BOOL;\n\t\n\t// Vision Tracking Source B.\n\tg_uiHMIVisionSourceIndexB : UINT := 1;\n\tg_stHMIVisionSourceB : ST_VisionTrackingSourceConfig;\n\tg_xHMILoadVisionSourceB : BOOL;\n\tg_xHMISaveVisionSourceB : BOOL;\n\tg_xHMISaveAllVisionSourceB : BOOL;\n\tg_xHMILoadAllVisionSourceB : BOOL := FALSE;\n\t\n\t// Tracking Config B persistence.\n\tg_xHMITrackingConfigSaveB : BOOL;\n\tg_xHMITrackingConfigReadB : BOOL;\n\t\n\t// Tool Config B persistence.\n\t// Không dùng g_stHMITool_Config_Save_All của A vì flag hiện tại đang Save g_aToolConfigA.\n\tg_xHMIToolConfigSaveAllB : BOOL;\n\tg_xHMIToolConfigReadAllB : BOOL;\n\t\n\t//=============================================================================\n\t// ROBOT B - LAST VISION ALIGN RESULT\n\t//=============================================================================\n\tB_VisionHeaderOK : BOOL;                    // Header của Result cuối hợp lệ.\n\tB_VisionTriggerID : UDINT;                  // TriggerID cuối cùng.\n\t\n\tB_VisionX : REAL;                           // X Vision trả về.\n\tB_VisionY : REAL;                           // Y Vision trả về.\n\tB_VisionZ : REAL;                           // Z Vision trả về.\n\tB_VisionA : REAL;                           // Góc Vision trả về.\n\tB_VisionScore : REAL;                       // Score Vision.\n\t\nEND_VAR","LineInfoPersistence":"(string)6ae6426f-bb58-42ff-8599-cf622d2a2502_Decl_LineIds"}}}},"NetVarProperties":null,"ParameterList":"(bool)False","AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","ffbfa93a":"{ffbfa93a-b94d-45fc-a329-229860183b1d}","string":"System.String"}}},"FormatVersion":"1.0"}