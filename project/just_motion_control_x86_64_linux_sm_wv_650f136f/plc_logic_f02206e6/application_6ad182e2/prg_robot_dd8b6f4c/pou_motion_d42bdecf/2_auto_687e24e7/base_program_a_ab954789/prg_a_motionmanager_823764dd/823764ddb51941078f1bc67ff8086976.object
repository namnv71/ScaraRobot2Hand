{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)823764dd-b519-4107-8f1b-c67ff8086976","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)PRG_A_MotionManager","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)ab954789-01a8-4bd7-845f-ff1c02d5e799"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//====================================================\n// PRG_A_MotionManager\n// Controlled Pipeline Motion Manager\n// - Chạy nền liên tục.\n// - Có queue và slot rảnh thì Pop motion vào slot.\n// - Slot Accepted thì hạ Start để FB Motion chạy tiếp.\n// - Slot Done thì báo về Interpreter bằng A_MotionDonePulse.\n// - Slot Error thì báo lỗi đúng SourceStep.\n//====================================================\n\n\n//====================================================\n// ABORT REQUEST\n// Ưu tiên cao nhất trong MotionManager\n// Dùng khi Stop / Alarm / Reset\n//====================================================\nIF GVL.A_MotionAbortReq OR GVL.X[7] THEN\n\n    PopReq := FALSE;\n\n    GVL.A_MotionHead := 1;\n    GVL.A_MotionTail := 1;\n    GVL.A_MotionCount := 0;\n\tGVL.A_PipelineUsedCount := 0;\n    FOR i := 1 TO 3 DO\n        GVL.A_MoveSlotStart[i] := FALSE;\n        GVL.A_MoveSlotBusy[i] := FALSE;\n\n        GVL.A_MoveSlotAccepted[i] := FALSE;\n        GVL.A_MoveSlotDone[i] := FALSE;\n        GVL.A_MoveSlotError[i] := FALSE;\n        GVL.A_MoveSlotErrorID[i] := 0;\n\t\tGVL.A_MoveSlotReleasePending[i] := FALSE;\n        GVL.A_MoveSlotCmd[i] := E_RobotCmd.CMD_NOP;\n\t\t\n    END_FOR;\n\n    GVL.A_ActiveMotionCount := 0;\n\n    GVL.A_MotionManagerBusy := FALSE;\n    GVL.A_MotionManagerDone := FALSE;\n    GVL.A_MotionManagerError := FALSE;\n    GVL.A_MotionManagerState := 0;\n\n    GVL.A_MotionDonePulse := FALSE;\n    GVL.A_MotionErrorPulse := FALSE;\n\n    GVL.A_MotionAbortReq := FALSE;\n    GVL.A_MotionAbortDone := TRUE;\n\nELSE\n\n\t// Luôn gọi FB MoveP/L/C mỗi scan\n\t\n\tCASE GVL.A_MotionManagerState OF\n\t\n\t\t0: // IDLE / READY\n\t\n\t\t\tGVL.A_MotionManagerDone := FALSE;\n\t\n\t\t\t// Nếu có motion trong queue và còn slot rảnh thì lấy ra chạy\n\t\t\tIF (GVL.A_MotionCount > 0) AND (F_GetFreeMoveSlot() > 0) THEN\n\t\t\t\tGVL.A_MotionManagerBusy := TRUE;\n\t\t\t\tPopReq := TRUE;\n\t\n\t\t\t\tGVL.A_MotionManagerState := 10;\n\t\n\t\t\tELSE\n\t\t\t\t// Không còn queue và không còn slot active\n\t\t\t\tIF GVL.A_ActiveMotionCount <= 0 THEN\n\t\t\t\t\tGVL.A_MotionManagerBusy := FALSE;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\n\t\n\t\t10: // WAIT POP DONE\n\t\n\t\t\tIF fbPop.Done THEN\n\t\t\t\tPopReq := FALSE;\n\t\n\t\t\t\titem_PRG_A_MotionManager := fbPop.Item;\n\t\t\t\tfreeSlot := F_GetFreeMoveSlot();\n\t\n\t\t\t\tIF freeSlot > 0 THEN\n\t\n\t\t\t\t\t// Gán item vào slot rảnh\n\t\t\t\t\tGVL.A_MoveSlotItem[freeSlot] := item_PRG_A_MotionManager;\n\t\t\t\t\tGVL.A_MoveSlotCmd[freeSlot]  := item_PRG_A_MotionManager.Cmd;\n\t\n\t\t\t\t\t// Reset trạng thái slot trước khi Start\n\t\t\t\t\tGVL.A_MoveSlotBusy[freeSlot]     := TRUE;\n\t\t\t\t\tGVL.A_MoveSlotStart[freeSlot]    := TRUE;\n\t\t\t\t\tGVL.A_MoveSlotAccepted[freeSlot] := FALSE;\n\t\t\t\t\tGVL.A_MoveSlotDone[freeSlot]     := FALSE;\n\t\t\t\t\tGVL.A_MoveSlotError[freeSlot]    := FALSE;\n\t\t\t\t\t\n\t\t\t\t\tGVL.A_MoveSlotErrorID[freeSlot] := 0;\n\n\t\t\t\t\tGVL.A_MoveSlotReleasePending[freeSlot] := FALSE;\n\t\t\t\t\t\n\t\t\t\t\t// Ghi nhớ chính xác slot vừa cấp\n   \t\t\t\t\tWaitAcceptSlot := freeSlot;\n\t\n\t\t\t\t\t// Tăng số motion đang active\n\t\t\t\t\t//GVL.A_ActiveMotionCount := GVL.A_ActiveMotionCount + 1;\n\t\n\t\t\t\t\tGVL.A_MotionManagerState := 20;\n\t\n\t\t\t\tELSE\n\t\t\t\t\t// Trường hợp hiếm: vừa Pop xong nhưng slot không còn rảnh\n\t\t\t\t\tGVL.A_MotionManagerState := 30;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\n\t\t\tIF fbPop.Empty THEN\n\t\t\t\tPopReq := FALSE;\n\t\t\t\tGVL.A_MotionManagerState := 30;\n\t\t\tEND_IF;\n\t\n\t\n\t\t20: // WAIT COMMAND ACCEPTED\n\t\t\t\n\t\t//--------------------------------------------------------\n\t\t\t// Chỉ chờ đúng slot vừa được State 10 cấp lệnh\n\t\t\t//--------------------------------------------------------\n\t\t\tIF (WaitAcceptSlot >= 1)\n\t\t\t   AND (WaitAcceptSlot <= 3)\n\t\t\tTHEN\n\t\t\n\t\t\t\t//----------------------------------------------------\n\t\t\t\t// Slot vẫn phải thuộc quyền sở hữu của Manager\n\t\t\t\t//----------------------------------------------------\n\t\t\t\tIF GVL.A_MoveSlotBusy[WaitAcceptSlot] THEN\n\t\t\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\t// Lệnh đã được FB Move nhận\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\tIF GVL.A_MoveSlotAccepted[WaitAcceptSlot] THEN\n\t\t\n\t\t\t\t\t\tGVL.A_MoveSlotStart[WaitAcceptSlot] := FALSE;\n\t\t\n\t\t\t\t\t\t// Đã hoàn thành handshake Accepted\n\t\t\t\t\t\tWaitAcceptSlot := 0;\n\t\t\n\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t// PipelineLength = 1:\n\t\t\t\t\t\t// Không Pop thêm khi còn motion đang chạy.\n\t\t\t\t\t\t// Sang State 30 chờ motion hoàn thành.\n\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\tGVL.A_MotionManagerState := 30;\n\t\t\n\t\t\n\t\t\t\t\tELSIF GVL.A_MoveSlotError[WaitAcceptSlot] THEN\n\t\t\n\t\t\t\t\t\tGVL.A_MotionManagerError := TRUE;\n\t\t\n\t\t\t\t\t\tGVL.A_MotionErrorPulse := TRUE;\n\t\t\t\t\t\tGVL.A_MotionErrorStep :=\n\t\t\t\t\t\t\tGVL.A_MoveSlotItem[WaitAcceptSlot].SourceStep;\n\t\t\n\t\t\t\t\t\tGVL.A_MotionErrorCode :=\n\t\t\t\t\t\t\tGVL.A_MoveSlotErrorID[WaitAcceptSlot];\n\t\t\n\t\t\t\t\t\tWaitAcceptSlot := 0;\n\t\t\n\t\t\t\t\t\tGVL.A_MotionManagerState := 900;\n\t\t\n\t\t\t\t\tEND_IF;\n\t\t\n\t\t\t\tEND_IF;\n\t\t\n\t\t\tELSE\n\t\t\n\t\t\t\t//----------------------------------------------------\n\t\t\t\t// Không có slot nào đang chờ Accepted.\n\t\t\t\t// Đây là trạng thái bất thường, quay về quản lý queue.\n\t\t\t\t//----------------------------------------------------\n\t\t\t\tGVL.A_MotionManagerState := 30;\n\t\t\n\t\t\tEND_IF;\n\t\n\t\t30: // WAIT / CONTINUE PIPELINE\n\t\n\t\t\t// Nếu sau đó Interpreter push thêm queue và có slot rảnh thì tiếp tục chạy\n\t\t\tIF (GVL.A_MotionCount > 0) AND (F_GetFreeMoveSlot() > 0) THEN\n\t\t\t\tGVL.A_MotionManagerBusy := TRUE;\n\t\t\t\tPopReq := TRUE;\n\t\t\t\tGVL.A_MotionManagerState := 10;\n\t\n\t\t\t// Nếu không còn queue và không còn motion active thì MotionManager rảnh\n\t\t\tELSIF (GVL.A_MotionCount <= 0) AND (GVL.A_ActiveMotionCount <= 0) THEN\n\t\t\t\tGVL.A_MotionManagerBusy := FALSE;\n\t\t\t\tGVL.A_MotionManagerDone := TRUE;\n\t\t\t\tGVL.A_MotionManagerState := 0;\n\t\t\tEND_IF;\n\t\n\t\n\t\t900: // ERROR\n\t\n\t\t\tPopReq := FALSE;\n\t\n\t\t\t// Dừng cấp thêm motion mới\n\t\t\tFOR i := 1 TO 3 DO\n\t\t\t\tGVL.A_MoveSlotStart[i] := FALSE;\n\t\t\tEND_FOR;\n\t\n\t\t\tGVL.A_MotionManagerBusy := FALSE;\n\t\t\tGVL.A_MotionManagerError := TRUE;\n\t\n\t\t\tGVL.A_MotionManagerState := 0;\n\t\n\tEND_CASE;\nEND_IF;\n//====================================================\n// Gọi FB Pop mỗi scan\n//====================================================\nfbPop(\n    Execute := PopReq\n);\n\n\n\n//============================================================\n// CALL MOTION SLOT FB\n// Tất cả FB phải được gọi liên tục mỗi scan.\n//\n// Khi slot không sử dụng hoặc không đúng loại lệnh:\n// Start của FB tương ứng phải bằng FALSE.\n// Nhờ vậy LastStart và State bên trong FB được cập nhật đúng.\n//============================================================\n\nFOR i := 1 TO 3 DO\n\n    //--------------------------------------------------------\n    // Chuẩn bị tọa độ\n    //--------------------------------------------------------\n    IF GVL.A_MoveSlotBusy[i] THEN\n\n        CASE GVL.A_MoveSlotCmd[i] OF\n\n            E_RobotCmd.CMD_MovP,\n            E_RobotCmd.CMD_MovL:\n\n//                 SlotPos[i] :=\n//                     F_GetPointSMC_A(\n//                         GVL.A_MoveSlotItem[i].PointNo\n//                     );\n\t\t\t\tIF GVL.A_MoveSlotItem[i].UseDirectPosition THEN\n\t\t\t\t\tSlotPos[i].c.X := GVL.A_MoveSlotItem[i].DirectPosition.X;\n\t\t\t\t\tSlotPos[i].c.Y := GVL.A_MoveSlotItem[i].DirectPosition.Y;\n\t\t\t\t\tSlotPos[i].c.Z := GVL.A_MoveSlotItem[i].DirectPosition.Z;\n\t\t\t\t\tSlotPos[i].c.A := GVL.A_MoveSlotItem[i].DirectPosition.A;\n\t\t\t\tELSE\n\t\t\t\t\tSlotPos[i] := F_GetPointSMC_A(GVL.A_MoveSlotItem[i].PointNo);\n\t\t\t\tEND_IF;\n\n\n\n            E_RobotCmd.CMD_MovC:\n\n                SlotMidPos[i] :=\n                    F_GetPointSMC_A(\n                        GVL.A_MoveSlotItem[i].MidPointNo\n                    );\n\n                SlotEndPos[i] :=\n                    F_GetPointSMC_A(\n                        GVL.A_MoveSlotItem[i].EndPointNo\n                    );\n\n        END_CASE;\n\n    END_IF;\n\n\n    //--------------------------------------------------------\n    // MoveP\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveP[i](\n        Start :=\n            GVL.A_MoveSlotBusy[i]\n            AND\n            (GVL.A_MoveSlotCmd[i] = E_RobotCmd.CMD_MovP)\n            AND\n            GVL.A_MoveSlotStart[i],\n\t\tRelease := GVL.A_MoveSlotReleasePending[i],\n        AxisGroup := SCARA_A,\n        Item := GVL.A_MoveSlotItem[i],\n        PositionIn := SlotPos[i],\n        //CoordSystem := GVL.RB_A.COORD\n\t\tCoordSystem := SEL(\n\t\t\tGVL.A_MoveSlotItem[i].UseDirectPosition,\n\t\t\t//GVL.RB_A.COORD,\n\t\t\tSMC_COORD_SYSTEM.MCS,\n\t\t\tGVL.A_MoveSlotItem[i].DirectCoordSystem)\n\n    );\n\n\n    //--------------------------------------------------------\n    // MoveL\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveL[i](\n        Start :=\n            GVL.A_MoveSlotBusy[i]\n            AND\n            (GVL.A_MoveSlotCmd[i] = E_RobotCmd.CMD_MovL)\n            AND\n            GVL.A_MoveSlotStart[i],\n\n        AxisGroup := SCARA_A,\n        Item := GVL.A_MoveSlotItem[i],\n        PositionIn := SlotPos[i],\n        //CoordSystem := GVL.RB_A.COORD\n\t\tCoordSystem := SEL(\n\t\t\tGVL.A_MoveSlotItem[i].UseDirectPosition,\n\t\t\t//GVL.RB_A.COORD,\n\t\t\tSMC_COORD_SYSTEM.MCS,\n\t\t\tGVL.A_MoveSlotItem[i].DirectCoordSystem)\n\n    );\n\n\n    //--------------------------------------------------------\n    // MoveC\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveC[i](\n        Start :=\n            GVL.A_MoveSlotBusy[i]\n            AND\n            (GVL.A_MoveSlotCmd[i] = E_RobotCmd.CMD_MovC)\n            AND\n            GVL.A_MoveSlotStart[i],\n\n        AxisGroup := SCARA_A,\n        Item := GVL.A_MoveSlotItem[i],\n        MidPosition := SlotMidPos[i],\n        EndPosition := SlotEndPos[i],\n        //CoordSystem := GVL.RB_A.COORD\n\t\tCoordSystem := SMC_COORD_SYSTEM.MCS\n    );\n\n\n\t\n\n\n\n    //--------------------------------------------------------\n    // Chọn trạng thái trả về theo loại lệnh của slot\n    //--------------------------------------------------------\n    IF GVL.A_MoveSlotBusy[i] THEN\n\n        CASE GVL.A_MoveSlotCmd[i] OF\n\n            //================================================\n            // MOVP\n            //================================================\n            E_RobotCmd.CMD_MovP:\n\n                GVL.A_MoveSlotAccepted[i] :=\n                    fbMoveP[i].Accepted;\n\n                GVL.A_MoveSlotDone[i] :=\n                    fbMoveP[i].Done;\n\n                GVL.A_MoveSlotError[i] :=\n                    fbMoveP[i].Error;\n\n                GVL.A_MoveSlotErrorID[i] :=\n                    fbMoveP[i].ErrorID_Custom;\n\n\n            //================================================\n            // MOVL\n            //================================================\n            E_RobotCmd.CMD_MovL:\n\n                GVL.A_MoveSlotAccepted[i] :=\n                    fbMoveL[i].Accepted;\n\n                GVL.A_MoveSlotDone[i] :=\n                    fbMoveL[i].Done;\n\n                GVL.A_MoveSlotError[i] :=\n                    fbMoveL[i].Error;\n\n                GVL.A_MoveSlotErrorID[i] :=\n                    fbMoveL[i].ErrorID_Custom;\n\n\n            //================================================\n            // MOVC\n            //================================================\n            E_RobotCmd.CMD_MovC:\n\n                GVL.A_MoveSlotAccepted[i] :=\n                    fbMoveC[i].Accepted;\n\n                GVL.A_MoveSlotDone[i] :=\n                    fbMoveC[i].Done;\n\n                GVL.A_MoveSlotError[i] :=\n                    fbMoveC[i].Error;\n\n                GVL.A_MoveSlotErrorID[i] :=\n                    fbMoveC[i].ErrorID_Custom;\n\n        END_CASE;\n\n    END_IF;\n\nEND_FOR;\n\n\n//------------------------------------------------------------\n// GLOBAL MOTION ERROR MONITOR\n//\n// Kiểm tra tất cả Move Slot mỗi scan.\n// Giữ nguyên cơ chế MotionErrorPulse cũ để báo Interpreter.\n//------------------------------------------------------------\nIF NOT GVL.A_MotionErrorPulse THEN\n\n    FOR i := 1 TO 3 DO\n\n        IF GVL.A_MoveSlotBusy[i] AND GVL.A_MoveSlotError[i]\n        THEN\n\n            //--------------------------------------------\n            // MotionManager có lỗi\n            //--------------------------------------------\n            GVL.A_MotionManagerError := TRUE;\n\n            //--------------------------------------------\n            // Xung báo Interpreter\n            //--------------------------------------------\n            GVL.A_MotionErrorPulse := TRUE;\n\n            //--------------------------------------------\n            // Step gây lỗi\n            //--------------------------------------------\n            GVL.A_MotionErrorStep := GVL.A_MoveSlotItem[i].SourceStep;\n\n            //--------------------------------------------\n            // Error Code của FB\n            //--------------------------------------------\n            GVL.A_MotionErrorCode := GVL.A_MoveSlotErrorID[i];\n\n            //--------------------------------------------\n            // Có thể lưu thêm Slot để debug\n            //--------------------------------------------\n            GVL.A_MotionErrorSlot := i;\n\n            //--------------------------------------------\n            // Manager chuyển ERROR\n            //--------------------------------------------\n            GVL.A_MotionManagerState := 900;\n\n            EXIT;\n\n        END_IF;\n\n    END_FOR;\n\nEND_IF;\n\n// RELEASE SLOT WHEN DONE\nFOR i := 1 TO 3 DO\n\n    IF GVL.A_MoveSlotBusy[i]\n       AND GVL.A_MoveSlotDone[i]\n    THEN\n\n        // Báo Interpreter\n        GVL.A_MotionDoneStep :=\n            GVL.A_MoveSlotItem[i].SourceStep;\n\n        GVL.A_MotionDonePulse := TRUE;\n\n        // Release slot\n        GVL.A_MoveSlotStart[i] := FALSE;\n        GVL.A_MoveSlotBusy[i] := FALSE;\n        GVL.A_MoveSlotAccepted[i] := FALSE;\n        GVL.A_MoveSlotDone[i] := FALSE;\n        GVL.A_MoveSlotError[i] := FALSE;\n        GVL.A_MoveSlotErrorID[i] := 0;\n\n        GVL.A_MoveSlotCmd[i] :=\n            E_RobotCmd.CMD_NOP;\n\t\tGVL.A_MoveSlotReleasePending[i] := TRUE; // Set release = TRUE\n\t\t\n\t\t//------------------------------------------------\n\t\t// Motion đã thực sự rời pipeline\n\t\t//------------------------------------------------\n\t\tIF GVL.A_PipelineUsedCount > 0 THEN\n\t\t\tGVL.A_PipelineUsedCount :=\n\t\t\t\tGVL.A_PipelineUsedCount - 1;\n\t\tEND_IF;\n\t\n    END_IF;\nEND_FOR;\n\n//============================================================\n// RECALCULATE ACTIVE MOTION COUNT\n//\n// A_ActiveMotionCount luôn phản ánh đúng số slot Busy,\n// không phụ thuộc việc cộng/trừ có bị bỏ sót hay không.\n//============================================================\nActiveCountCalc := 0;\n\nFOR i := 1 TO 3 DO\n\n    IF GVL.A_MoveSlotBusy[i] THEN\n        ActiveCountCalc := ActiveCountCalc + 1;\n    END_IF;\n\nEND_FOR;\n\nGVL.A_ActiveMotionCount := ActiveCountCalc;\n\n\n\n\n//====================================================\n// FINALIZE MOTION MANAGER\n// Chỉ kết thúc khi Manager đã vào trạng thái WAIT\n// Không được reset State 10/20 khi vừa Pop lệnh.\n//====================================================\nIF (GVL.A_MotionManagerState = 30)\n   AND (GVL.A_MotionCount <= 0)\n   AND (GVL.A_ActiveMotionCount <= 0)\nTHEN\n\n    GVL.A_MotionManagerBusy := FALSE;\n    GVL.A_MotionManagerDone := TRUE;\n    GVL.A_MotionManagerState := 0;\n\nEND_IF;","LineInfoPersistence":"(string)823764dd-b519-4107-8f1b-c67ff8086976_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)540"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}