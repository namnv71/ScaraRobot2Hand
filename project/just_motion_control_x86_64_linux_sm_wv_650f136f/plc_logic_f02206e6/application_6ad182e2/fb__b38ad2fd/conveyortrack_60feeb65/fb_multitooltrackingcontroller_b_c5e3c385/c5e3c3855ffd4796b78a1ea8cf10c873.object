{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c5e3c385-5ffd-4796-b78a-1ea8cf10c873","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_MultiToolTrackingController_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFB_MultiToolTrackingController_A\n\nMỤC ĐÍCH\n    Điều phối một lệnh TRACK_ON cho Robot B.\n\nCHU TRÌNH\n    IDLE\n    -> LOAD_RECIPE\n    -> SELECT_ASSIGNMENT\n    -> SELECT_TOOL\n    -> START_TRACKING\n    -> WAIT_SYNC\n    -> TOOL_DOWN\n    -> TOOL_GRIP\n    -> TOOL_UP\n    -> RELEASE_TRACKING\n    -> STORE_RESULT\n    -> lặp đến khi đủ TargetPickCount\n    -> COMPLETE\n\nTRÁCH NHIỆM\n    - Không gọi Motion trực tiếp.\n    - Không gọi MC_TrackConveyorBelt trực tiếp.\n    - Không ghi IO trực tiếp.\n    - Chỉ điều phối Tracking Core, Tool Manager và Select Tool.\n===============================================================================\n*)\n//=============================================================================\n// DEFAULT PULSE OUTPUTS\n//=============================================================================\nStatus.Accepted := FALSE;\nStatus.Done := FALSE;\nCoreStart := FALSE;\nCoreRelease := FALSE;\nCoreAbort := FALSE;\nCoreReset := FALSE;\nToolCommand.Execute := FALSE;\nSelectToolExecute := FALSE;\n\n//=============================================================================\n// RESET\n//=============================================================================\nIF Command.Reset THEN\n    Status.State := E_MultiTrackState.IDLE;\n    Status.Busy := FALSE;\n    Status.Error := FALSE;\n    Status.ErrorID := 0;\n    Status.PickedCount := 0;\n    Status.SelectedToolID := 0;\n    Status.SelectedObjectID := 0;\n    CoreReset := TRUE;\n    xCommandIssued := FALSE;\n\txReleaseArmed := FALSE;\n\tudiLastAcceptedCommandID := 0;\n    RETURN;\nEND_IF;\n\n//=============================================================================\n// ABORT\n//=============================================================================\nIF Command.Abort THEN \n\tStatus.State := E_MultiTrackState.ABORTING; \n\txReleaseArmed := FALSE;\nEND_IF;\n\n// //=============================================================================\n// // START COMMAND\n// //=============================================================================\n// rtExecute(CLK := Command.Execute);\n// \n// IF rtExecute.Q AND Status.State = E_MultiTrackState.IDLE THEN\n//     Status.Accepted := TRUE;\n//     Status.Busy := TRUE;\n//     Status.Error := FALSE;\n//     Status.ErrorID := 0;\n//     Status.ResponseCommandID := Command.CommandID;\n//     Status.PickedCount := 0;\n//     Status.OccupiedToolMask := 0;\n//     Status.State := E_MultiTrackState.LOAD_RECIPE;\n// END_IF;\n\n//=============================================================================\n// START NEW COMMAND\n//-----------------------------------------------------------------------------\n// Không phụ thuộc riêng cạnh Execute.\n// CommandID là khóa transaction chính.\n//=============================================================================\nIF Command.Execute\nAND Command.CommandID <> 0\nAND Command.CommandID <> udiLastAcceptedCommandID\nAND Status.State = E_MultiTrackState.IDLE THEN\n\n    udiLastAcceptedCommandID := Command.CommandID;\n\n    Status.Accepted := TRUE;\n    Status.Busy := TRUE;\n    Status.Error := FALSE;\n    Status.ErrorID := 0;\n\n    Status.ResponseCommandID := Command.CommandID;\n    Status.PickedCount := 0;\n    Status.OccupiedToolMask := 0;\n\n    Status.State := E_MultiTrackState.LOAD_RECIPE;\n\nEND_IF;\n\n\n//=============================================================================\n// STATE MACHINE\n//=============================================================================\nCASE Status.State OF\n\n    E_MultiTrackState.IDLE:\n        Status.Busy := FALSE;\n\n    //-------------------------------------------------------------------------\n    // Đọc Recipe và áp dụng tham số Override từ Interpreter.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.LOAD_RECIPE:\n        IF Command.RecipeID = 0 OR Command.RecipeID > 32 OR NOT Recipes[Command.RecipeID].Enable THEN\n            Status.Error := TRUE;\n            Status.ErrorID := 9401;\n            Status.State := E_MultiTrackState.ERROR;\n        ELSE\n            stRecipe := Recipes[Command.RecipeID];\n            Status.ActiveRecipeID := stRecipe.RecipeID;\n            IF Command.TargetPickCountOverride > 0 THEN uiTargetCount := Command.TargetPickCountOverride; ELSE uiTargetCount := stRecipe.TargetPickCount; END_IF;\n            IF Command.ToolMaskOverride <> 0 THEN dwToolMask := Command.ToolMaskOverride; ELSE dwToolMask := stRecipe.ToolEnableMask; END_IF;\n            Status.TargetPickCount := uiTargetCount;\n            Status.State := E_MultiTrackState.VALIDATE_TOOLS;\n        END_IF;\n\n    //-------------------------------------------------------------------------\n    // Kiểm tra nhanh cấu hình trước khi chạy.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.VALIDATE_TOOLS:\n        IF uiTargetCount = 0 OR dwToolMask = 0 THEN\n            Status.Error := TRUE;\n            Status.ErrorID := 9402;\n            Status.State := E_MultiTrackState.ERROR;\n        ELSE\n            Status.State := E_MultiTrackState.SELECT_ASSIGNMENT;\n        END_IF;\n\n    //-------------------------------------------------------------------------\n    // Tìm một Tool rảnh và một Object phù hợp.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.SELECT_ASSIGNMENT:\n\n\t\tfbScheduler(\n\t\t\tExecute := TRUE,\n\t\t\tRecipe := stRecipe,\n\t\t\tToolMask := dwToolMask,\n\t\t\tQueue := Queue,\n\t\t\tToolConfig := ToolConfig,\n\t\t\tToolStatus := ToolStatus\n\t\t);\n\t\n\t\tIF fbScheduler.Done AND fbScheduler.Valid THEN\n\t\t\tuiToolIndex := fbScheduler.ToolIndex;\n\t\t\tuiObjectIndex := fbScheduler.ObjectIndex;\n\t\n\t\t\t// Controller chỉ ghi Tool được phân công.\n\t\t\t// Tracking Manager là khối duy nhất được Reserve Object.\n\t\t\tQueue.Objects[uiObjectIndex].ReservedToolID := ToolConfig[uiToolIndex].ToolID;\n\t\n\t\t\tStatus.SelectedToolID := ToolConfig[uiToolIndex].ToolID;\n\t\t\tStatus.SelectedObjectID := Queue.Objects[uiObjectIndex].ObjectID;\n\t\n\t\t\txCommandIssued := FALSE;\n\t\t\tStatus.State := E_MultiTrackState.SELECT_ROBOT_TOOL;\n\t\tEND_IF;\n\n\t\t\n\t//-------------------------------------------------------------------------\n\t// Chọn TCP/Tool cho Robot B.\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.SELECT_ROBOT_TOOL:\n\t\n\t\tSelectToolID := ToolConfig[uiToolIndex].ToolID;\n\t\tSelectToolTCP := ToolConfig[uiToolIndex].ToolTCP;\n\t\tSelectToolExecute := TRUE;\n\t\n\t\tIF SelectToolDone THEN\n\t\t\tSelectToolExecute := FALSE;\n\t\t\txCommandIssued := FALSE;\n\t\t\tStatus.State := E_MultiTrackState.START_TRACKING;\n\t\n\t\tELSIF SelectToolError THEN\n\t\t\tSelectToolExecute := FALSE;\n\t\t\tStatus.Error := TRUE;\n\t\t\tStatus.ErrorID := SelectToolErrorID;\n\t\t\tStatus.State := E_MultiTrackState.ERROR;\n\t\tEND_IF;\n\t\n\t\n    //-------------------------------------------------------------------------\n    // Phát request tới Tracking Core.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.START_TRACKING:\n        CoreObjectIndex := uiObjectIndex;\n        CoreToolID := ToolConfig[uiToolIndex].ToolID;\n        CorePickOffset := ToolConfig[uiToolIndex].PickOffset;\n        CoreApproachHeight := ToolConfig[uiToolIndex].ApproachHeight;\n\t\tCorePickSurfaceHeightMM := stRecipe.PickSurfaceHeightMM;\n        CoreUseUpDown := ToolConfig[uiToolIndex].UseUpDown;\n        CoreUpDownStroke := ToolConfig[uiToolIndex].UpDownStroke;\n        CoreStart := TRUE;\n\n        IF CoreAccepted OR CoreBusy THEN\n            Queue.Objects[uiObjectIndex].State := E_TrackingObjectState.OBJ_TRACKING;\n            Status.State := E_MultiTrackState.WAIT_SYNC;\n\n        ELSIF CoreError THEN\n            Status.Error := TRUE;\n            Status.ErrorID := CoreErrorID;\n            Status.State := E_MultiTrackState.ERROR;\n        END_IF;\n\n    //-------------------------------------------------------------------------\n    // Chờ Robot tới Approach trong PCS và PCS vẫn InUse.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.WAIT_SYNC:\n        Status.TrackingSyncOK := CoreSyncOK;\n        Status.PCSInUse := CorePCSInUse;\n\n        IF CoreSyncOK AND CorePCSInUse THEN\n            xCommandIssued := FALSE;\n\n            IF ToolConfig[uiToolIndex].UseUpDown THEN\n                Status.State := E_MultiTrackState.TOOL_DOWN;\n            ELSE\n                Status.State := E_MultiTrackState.TOOL_GRIP;\n            END_IF;\n\n        ELSIF CoreError THEN\n            Status.Error := TRUE;\n            Status.ErrorID := CoreErrorID;\n            Status.State := E_MultiTrackState.ERROR;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n\t// COMMAND TOOL DOWN\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.TOOL_DOWN:\n\t\n\t\tudiToolCommandID := udiToolCommandID + 1;\n\t\n\t\tToolCommand.CommandID := udiToolCommandID;\n\t\tToolCommand.ToolID := ToolConfig[uiToolIndex].ToolID;\n\t\tToolCommand.CommandType := E_ToolCommandType.DOWN;\n\t\tToolCommand.ObjectID := Queue.Objects[uiObjectIndex].ObjectID;\n\t\tToolCommand.Execute := TRUE;\n\t\n\t\tStatus.State := E_MultiTrackState.WAIT_TOOL_DOWN;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// WAIT TOOL DOWN\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.WAIT_TOOL_DOWN:\n\t\n\t\tIF ToolStatus[uiToolIndex].Done\n\t\tAND ToolStatus[uiToolIndex].ResponseCommandID = udiToolCommandID THEN\n\t\n\t\t\tStatus.State := E_MultiTrackState.TOOL_GRIP;\n\t\n\t\tELSIF ToolStatus[uiToolIndex].Error THEN\n\t\n\t\t\tStatus.Error := TRUE;\n\t\t\tStatus.ErrorID := ToolStatus[uiToolIndex].ErrorID;\n\t\t\tStatus.State := E_MultiTrackState.ERROR;\n\t\n\t\tEND_IF;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// COMMAND TOOL GRIP\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.TOOL_GRIP:\n\t\n\t\tudiToolCommandID := udiToolCommandID + 1;\n\t\n\t\tToolCommand.CommandID := udiToolCommandID;\n\t\tToolCommand.ToolID := ToolConfig[uiToolIndex].ToolID;\n\t\tToolCommand.CommandType := E_ToolCommandType.GRIP;\n\t\tToolCommand.ObjectID := Queue.Objects[uiObjectIndex].ObjectID;\n\t\tToolCommand.Execute := TRUE;\n\t\n\t\tStatus.State := E_MultiTrackState.WAIT_TOOL_GRIP;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// WAIT TOOL GRIP\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.WAIT_TOOL_GRIP:\n\t\n\t\t IF ToolStatus[uiToolIndex].Done\n        AND ToolStatus[uiToolIndex].ResponseCommandID = udiToolCommandID THEN\n\n            IF ToolConfig[uiToolIndex].UseUpDown THEN\n                Status.State := E_MultiTrackState.TOOL_UP;\n            ELSE\n                Status.State := E_MultiTrackState.RELEASE_TRACKING;\n            END_IF;\n\n        ELSIF ToolStatus[uiToolIndex].Error THEN\n            Status.Error := TRUE;\n            Status.ErrorID := ToolStatus[uiToolIndex].ErrorID;\n            Status.State := E_MultiTrackState.ERROR;\n        END_IF;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// COMMAND TOOL UP\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.TOOL_UP:\n\t\n\t\tudiToolCommandID := udiToolCommandID + 1;\n\t\n\t\tToolCommand.CommandID := udiToolCommandID;\n\t\tToolCommand.ToolID := ToolConfig[uiToolIndex].ToolID;\n\t\tToolCommand.CommandType := E_ToolCommandType.UP;\n\t\tToolCommand.ObjectID := Queue.Objects[uiObjectIndex].ObjectID;\n\t\tToolCommand.Execute := TRUE;\n\t\n\t\tStatus.State := E_MultiTrackState.WAIT_TOOL_UP;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// WAIT TOOL UP\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.WAIT_TOOL_UP:\n\t\n\t\tIF ToolStatus[uiToolIndex].Done\n\t\t\tAND ToolStatus[uiToolIndex].ResponseCommandID = udiToolCommandID THEN\n\t\t\n\t\t\t\t// Chuẩn bị một chu trình Release mới.\n\t\t\t\txReleaseArmed := FALSE;\n\t\t\n\t\t\t\tStatus.State := E_MultiTrackState.RELEASE_TRACKING;\n\t\t\n\t\t\tELSIF ToolStatus[uiToolIndex].Error THEN\n\t\t\n\t\t\t\tStatus.Error := TRUE;\n\t\t\t\tStatus.ErrorID := ToolStatus[uiToolIndex].ErrorID;\n\t\t\t\tStatus.State := E_MultiTrackState.ERROR;\n\t\t\n\t\t\tEND_IF;\n\n    //-------------------------------------------------------------------------\n\t// Báo PickerSafe để Tracking Core chạy Exit/Release PCS.\n\t//-------------------------------------------------------------------------\n\tE_MultiTrackState.RELEASE_TRACKING:\n\t\n\t\t// Phải giữ TRUE liên tục để Core Interface nhận được yêu cầu.\n\t\tCoreRelease := TRUE;\n\t\n\t\t// Vòng quét đầu tiên chỉ phát yêu cầu Release.\n\t\t// Không kiểm tra CoreReleased trong cùng vòng quét này.\n\t\tIF NOT xReleaseArmed THEN\n\t\n\t\t\txReleaseArmed := TRUE;\n\t\n\t\tELSE\n\t\n\t\t\t// Chỉ chấp nhận Released sau khi CoreRelease\n\t\t\t// đã được giữ ít nhất một vòng quét.\n\t\t\tIF CoreReleased THEN\n\t\n\t\t\t\txReleaseArmed := FALSE;\n\t\t\t\tStatus.State := E_MultiTrackState.STORE_RESULT;\n\t\n\t\t\tELSIF CoreError THEN\n\t\n\t\t\t\txReleaseArmed := FALSE;\n\t\t\t\tStatus.Error := TRUE;\n\t\t\t\tStatus.ErrorID := CoreErrorID;\n\t\t\t\tStatus.State := E_MultiTrackState.ERROR;\n\t\t\t\txReleaseArmed := FALSE;\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\n    //-------------------------------------------------------------------------\n    // Lưu kết quả Pick của Tool hiện tại.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.STORE_RESULT:\n        Queue.Objects[uiObjectIndex].Reserved := FALSE;\n        Queue.Objects[uiObjectIndex].State := E_TrackingObjectState.OBJ_PICKED;\n        Status.PickedCount := Status.PickedCount + 1;\n        Status.OccupiedToolMask := Status.OccupiedToolMask OR SHL(DWORD#1, uiToolIndex - 1);\n        Status.State := E_MultiTrackState.CHECK_COUNT;\n\n    //-------------------------------------------------------------------------\n    // Đủ số lượng thì Done; chưa đủ thì chọn Tool/Object tiếp theo.\n    //-------------------------------------------------------------------------\n    E_MultiTrackState.CHECK_COUNT:\n        IF Status.PickedCount >= uiTargetCount THEN\n            Status.State := E_MultiTrackState.COMPLETE;\n        ELSE\n            Status.SelectedToolID := 0;\n            Status.SelectedObjectID := 0;\n            Status.TrackingSyncOK := FALSE;\n            Status.PCSInUse := FALSE;\n            Status.State := E_MultiTrackState.SELECT_ASSIGNMENT;\n        END_IF;\n\n    E_MultiTrackState.COMPLETE:\n        Status.Busy := FALSE;\n        Status.Done := TRUE;\n        IF NOT Command.Execute THEN Status.State := E_MultiTrackState.IDLE; END_IF;\n\n    E_MultiTrackState.ABORTING:\n        CoreAbort := TRUE;\n        Status.Busy := FALSE;\n        Status.Error := TRUE;\n        Status.ErrorID := 9499;\n        Status.State := E_MultiTrackState.ERROR;\n\n    E_MultiTrackState.ERROR:\n        Status.Busy := FALSE;\n        Status.Error := TRUE;\n        IF NOT Command.Execute THEN Status.State := E_MultiTrackState.IDLE; END_IF;\n\nEND_CASE;","LineInfoPersistence":"(string)c5e3c385-5ffd-4796-b78a-1ea8cf10c873_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_MultiToolTrackingController_B\nVAR_INPUT\n    Command : ST_MultiToolTrackingCommand; // Biến nội bộ Command.\n    CoreAccepted : BOOL; // Biến nội bộ CoreAccepted.\n    CoreBusy : BOOL; // Biến nội bộ CoreBusy.\n    CoreSyncOK : BOOL; // Biến nội bộ CoreSyncOK.\n    CorePCSInUse : BOOL; // Biến nội bộ CorePCSInUse.\n    CoreReleased : BOOL; // Biến nội bộ CoreReleased.\n    CoreError : BOOL; // Biến nội bộ CoreError.\n    CoreErrorID : UDINT; // Biến nội bộ CoreErrorID.\n    SelectToolDone : BOOL; // Biến nội bộ SelectToolDone.\n    SelectToolError : BOOL; // Biến nội bộ SelectToolError.\n    SelectToolErrorID : UDINT; // Biến nội bộ SelectToolErrorID.\nEND_VAR\n\nVAR_IN_OUT\n    Queue : ST_TRACKING_QUEUE; // Biến nội bộ Queue.\n    ToolConfig : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolConfig; // Biến nội bộ ToolConfig.\n    ToolStatus : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolStatus; // Biến nội bộ ToolStatus.\n    Recipes : ARRAY[0..GVL.C_MAX_TRACK_RECIPES] OF ST_MultiToolTrackingRecipe; // Biến nội bộ Recipes.\n    Status : ST_MultiToolTrackingStatus; // Biến nội bộ Status.\nEND_VAR\n\nVAR_OUTPUT\n    CoreStart : BOOL; // Biến nội bộ CoreStart.\n    CoreRelease : BOOL; // Biến nội bộ CoreRelease.\n    CoreAbort : BOOL; // Biến nội bộ CoreAbort.\n    CoreReset : BOOL; // Biến nội bộ CoreReset.\n    CoreObjectIndex : UINT; // Biến nội bộ CoreObjectIndex.\n    CoreToolID : UINT; // Biến nội bộ CoreToolID.\n    CorePickOffset : ST_POS; // Biến nội bộ CorePickOffset.\n    CoreApproachHeight : REAL; // Biến nội bộ CoreApproachHeight.\n    ToolCommand : ST_ToolCommand; // Biến nội bộ ToolCommand.\n    SelectToolExecute : BOOL; // Biến nội bộ SelectToolExecute.\n    SelectToolID : UINT; // Biến nội bộ SelectToolID.\n    SelectToolTCP : ST_POS; // Biến nội bộ SelectToolTCP.\n    CoreUseUpDown : BOOL; // Biến nội bộ CoreUseUpDown.\n    CoreUpDownStroke : REAL; // Biến nội bộ CoreUpDownStroke.\n    CorePickSurfaceHeightMM : REAL; // Biến nội bộ CorePickSurfaceHeightMM.\nEND_VAR\n\nVAR\n    rtExecute : R_TRIG; // Biến nội bộ rtExecute.\n    fbScheduler : FB_ToolObjectScheduler; // Biến nội bộ fbScheduler.\n    stRecipe : ST_MultiToolTrackingRecipe; // Biến nội bộ stRecipe.\n    uiToolIndex : UINT; // Biến nội bộ uiToolIndex.\n    uiObjectIndex : UINT; // Biến nội bộ uiObjectIndex.\n    uiTargetCount : UINT; // Biến nội bộ uiTargetCount.\n    dwToolMask : DWORD; // Biến nội bộ dwToolMask.\n    udiToolCommandID : UDINT; // Biến nội bộ udiToolCommandID.\n    xCommandIssued : BOOL; // Biến nội bộ xCommandIssued.\n    xReleaseArmed : BOOL; // TRUE sau khi Controller đã giữ CoreRelease ít nhất một vòng quét. Ngăn CoreReleased cũ làm bỏ qua tín hiệu PickerSafe.\n    udiLastAcceptedCommandID : UDINT := 0; // Biến nội bộ udiLastAcceptedCommandID.\nEND_VAR\n","LineInfoPersistence":"(string)c5e3c385-5ffd-4796-b78a-1ea8cf10c873_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)485","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}