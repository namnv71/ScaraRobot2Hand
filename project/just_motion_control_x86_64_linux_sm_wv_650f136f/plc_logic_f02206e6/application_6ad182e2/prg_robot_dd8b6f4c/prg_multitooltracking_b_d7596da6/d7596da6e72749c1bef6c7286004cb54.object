{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d7596da6-e727-49c1-bef6-c7286004cb54","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_MultiToolTracking_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF GVL.X[8] THEN\n\tGVL.g_xResetTrackingObjectSourceA := TRUE;\n\tGVL.g_xMultiTrackResetTestB := TRUE;\n\tGVL.g_xClearTrackingQueueA := TRUE;\nELSE\n\tGVL.g_xResetTrackingObjectSourceA := FALSE;\n\tGVL.g_xMultiTrackResetTestB := FALSE;\n\tGVL.g_xClearTrackingQueueA := FALSE;\n\t\nEND_IF;\n\n//GVL.g_axDIA[1] := GVL.X[20];\n\n\n//=============================================================================\n// MULTI-TOOL TRACKING TEST COMMAND\n//-----------------------------------------------------------------------------\n// Chỉ tạo dữ liệu Command một lần tại cạnh lên của Start Test.\n// Sau này khi Interpreter hoạt động, phần này chỉ dùng cho Commissioning/Test.\n//=============================================================================\n\nrtMultiTrackStartTestB(CLK := GVL.g_xMultiTrackStartTestB);\nIF rtMultiTrackStartTestB.Q THEN\n    GVL.g_stMultiTrackCommandB.CommandID := GVL.g_stMultiTrackCommandB.CommandID + 1;\n\n    IF GVL.g_stMultiTrackCommandB.CommandID = 0 THEN\n        GVL.g_stMultiTrackCommandB.CommandID := 1;\n    END_IF;\n\n//     GVL.g_stMultiTrackCommandB.RecipeID := 1;\n//     GVL.g_stMultiTrackCommandB.TargetPickCountOverride := 1;\n//     GVL.g_stMultiTrackCommandB.ToolMaskOverride := DWORD#1;\n// \n//     GVL.g_aMultiTrackRecipeB[1].Enable := TRUE;\n//     GVL.g_aMultiTrackRecipeB[1].RecipeID := 1;\n//     GVL.g_aMultiTrackRecipeB[1].ProductClassID := 0;\n//     GVL.g_aMultiTrackRecipeB[1].TargetPickCount := 1;\n//     GVL.g_aMultiTrackRecipeB[1].ToolEnableMask := DWORD#1;\n\n\tGVL.g_stMultiTrackCommandB.RecipeID := 1;\n    GVL.g_stMultiTrackCommandB.TargetPickCountOverride := 1;\n    GVL.g_stMultiTrackCommandB.ToolMaskOverride := DWORD#1;\n\n    GVL.g_aMultiTrackRecipeB[1].Enable := TRUE;\n    GVL.g_aMultiTrackRecipeB[1].RecipeID := 1;\n    GVL.g_aMultiTrackRecipeB[1].ProductClassID := 0;\n    GVL.g_aMultiTrackRecipeB[1].TargetPickCount := 1;\n    GVL.g_aMultiTrackRecipeB[1].ToolEnableMask := DWORD#1;\n\n    xMultiTrackTestExecuteB := TRUE;\nEND_IF;\n\n// Khi Controller hoàn thành hoặc lỗi thì hạ Execute test.\nIF GVL.g_stMultiTrackStatusB.Done OR GVL.g_stMultiTrackStatusB.Error OR GVL.g_xMultiTrackResetTestB OR GVL.g_xMultiTrackAbortTestB THEN\n    xMultiTrackTestExecuteB := FALSE;\nEND_IF;\n\nstCommandB := GVL.g_stMultiTrackCommandB;\n\nstCommandB.Execute := GVL.g_stMultiTrackCommandB.Execute OR xMultiTrackTestExecuteB;\n\nstCommandB.Reset := GVL.g_stMultiTrackCommandB.Reset OR GVL.g_xMultiTrackResetTestB;\n\nstCommandB.Abort :=\n    GVL.g_stMultiTrackCommandB.Abort\n    OR GVL.g_xMultiTrackAbortTestB;\n\n\n//=============================================================================\n// 02. GỐC CONVEYOR VÀ OBJECT TEST\n//-----------------------------------------------------------------------------\n// Sau này thay stConveyorOriginB bằng cấu hình Conveyor thực tế trên HMI.\n//=============================================================================\n// stConveyorOriginB.X := 350.0;\n// stConveyorOriginB.Y := -200.0;\n// stConveyorOriginB.Z := 150.0;\n// stConveyorOriginB.A := 90.0;\n// stConveyorOriginB.B := 0.0;\n// stConveyorOriginB.C := 0.0;\n\nstConveyorOriginB.X := GVL.g_aConveyorRuntime[2].Config.Origin.X;\nstConveyorOriginB.Y := GVL.g_aConveyorRuntime[2].Config.Origin.Y;\nstConveyorOriginB.Z := GVL.g_aConveyorRuntime[2].Config.Origin.Z;\nstConveyorOriginB.A := GVL.g_aConveyorRuntime[2].Config.Origin.A;\nstConveyorOriginB.B := 0.0;\nstConveyorOriginB.C := 0.0;\n\nstFixedObjectPositionB := GVL.g_stTrackingSimulation.FixedObjectPosition;\n\n// Power Axis 6\nfbPower(\n    Axis := AXIS_5,\n    Enable := TRUE,\n    bRegulatorOn := TRUE,\n    bDriveStart := TRUE\n);\ni_count := 100;\ncount_cal_max := 3;\nIF GVL.Y[11] <> FALSE  THEN\n\tIF count_scan = 0 THEN\n\t\tpulse_old := AXIS_5.diActPosition;\n\tEND_IF\n\tcount_scan := count_scan + 1;\n\t\n\tIF count_scan >= i_count THEN\n\t\trPulsePerScan := TO_REAL((AXIS_5.diActPosition - pulse_old))/(i_count);\n\t\tGVL.g_HMI_PulsePerCycle_Cr := rPulsePerScan;\n\t\tcount_scan := 0;\n\t\tcount_cal := count_cal + 1;\n\tEND_IF\nEND_IF;\nudiv := udiv + 1;\n\n\nIF count_cal >= count_cal_max THEN\n\t// Phần nguyên.\n\tdiBasePulse := REAL_TO_DINT(TRUNC(rPulsePerScan));\n\t\n\t// Tích lũy phần lẻ.\n\trFractionAcc := rFractionAcc + (rPulsePerScan - DINT_TO_REAL(diBasePulse));\n\t\n\t// Mặc định chỉ tăng phần nguyên.\n\tdiPulseThisScan := diBasePulse;\n\t\n\t// Khi phần lẻ tích đủ 1 xung thì bù thêm 1.\n\tIF rFractionAcc <= -200.0 THEN\n\t\tdiPulseThisScan := diPulseThisScan - 1;\n\t\trFractionAcc := rFractionAcc + 1.0;\n\tEND_IF;\n\t\n\t// Position đưa sang encoder trung gian.\n\tIF GVL.Y[11] <> FALSE THEN\n\t\tdiSmoothCount := diSmoothCount + diPulseThisScan;\n\tEND_IF\nEND_IF\n\n\n//=============================================================================\n// 03. ENCODER ẢO\n//-----------------------------------------------------------------------------\n// Phần này được chuyển từ PRG_ConveyorTracking cũ sang PRG mới.\n//=============================================================================\nIF GVL.g_stTrackingSimulation.VirtualEncoderReset THEN\n    diVirtualEncoderB := 0;\nELSIF GVL.g_stTrackingSimulation.VirtualEncoderEnable THEN\n    diVirtualEncoderB := diVirtualEncoderB + GVL.g_stTrackingSimulation.VirtualEncoderStepPerCycle;\nEND_IF;\n\nIF GVL.g_stTrackingSimulation.Mode <> E_ApplicationSimulationMode.SIM_OFF AND GVL.g_stTrackingSimulation.VirtualEncoderEnable THEN \n\tSMC_FreeEncoder_B.diEncoderPosition := diVirtualEncoderB; \nELSE\n\t//SMC_FreeEncoder_B.diEncoderPosition := TO_DINT(AXIS_6_B.fActPosition);\n\t//SMC_FreeEncoder_B.diEncoderPosition :=AXIS_6_B.diActPosition;\n// \tIF udiv < 400 THEN\n// \t\tSMC_FreeEncoder_B.diEncoderPosition := SMC_FreeEncoder_B.diEncoderPosition - 10;\n// \tEND_IF\n// \tIF udiv >= 400 THEN\n// \t\tSMC_FreeEncoder_B.diEncoderPosition := SMC_FreeEncoder_B.diEncoderPosition - 11;\n// \tEND_IF\n// \tIF udiv = 3 THEN\n// \t\tSMC_FreeEncoder_B.diEncoderPosition := SMC_FreeEncoder_B.diEncoderPosition - 5;\n// \tEND_IF\n// \tIF udiv = 4 THEN\n// \t\tSMC_FreeEncoder_B.diEncoderPosition := SMC_FreeEncoder_B.diEncoderPosition - 5;\n// \tEND_IF\n\tIF GVL.Y[11] <> FALSE THEN\n\t\tSMC_FreeEncoder_B.diEncoderPosition := SMC_FreeEncoder_B.diEncoderPosition - GVL.g_HMI_PulsePerCycle_Set_B;\n\tEND_IF;\nEND_IF;\n\nIF udiv = 800 THEN udiv := 0; END_IF;\n//=============================================================================\n// 04. CONVEYOR RUNTIME STATUS\n//-----------------------------------------------------------------------------\n// Logical Axis SM_Drive_Logical_B đã được scale:\n//     fActPosition = mm\n//     fActVelocity = mm/s\n//\n// Mục đích:\n//     - Cập nhật Status cho HMI.\n//     - Làm nguồn dữ liệu chung cho Queue/Sensor/Vision.\n//     - Tracking Manager đọc cùng một nguồn trạng thái Conveyor.\n//=============================================================================\n\n//-----------------------------------------------------------------------------\n// 1. RAW POSITION / VELOCITY\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[2].Status.RawPosition :=\n    LREAL_TO_REAL(SM_Drive_Logical_B.fActPosition);\n\nGVL.g_aConveyorRuntime[2].Status.RawVelocity :=\n    LREAL_TO_REAL(SM_Drive_Logical_B.fActVelocity);\n\n\n//-----------------------------------------------------------------------------\n// 2. POSITION THEO CHIỀU QUY ƯỚC CỦA APPLICATION\n//-----------------------------------------------------------------------------\n// DirectionSign:\n//      +1 = giữ nguyên chiều Axis.\n//      -1 = đảo chiều quy ước.\nIF GVL.g_aConveyorRuntime[2].Config.DirectionSign >= 0 THEN\n    GVL.g_aConveyorRuntime[2].Status.PositionMM :=\n        LREAL_TO_REAL(SM_Drive_Logical_B.fActPosition);\nELSE\n    GVL.g_aConveyorRuntime[2].Status.PositionMM :=\n        -LREAL_TO_REAL(SM_Drive_Logical_B.fActPosition);\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 3. VELOCITY THEO CHIỀU QUY ƯỚC\n//-----------------------------------------------------------------------------\nIF GVL.g_aConveyorRuntime[2].Config.DirectionSign >= 0 THEN\n    GVL.g_aConveyorRuntime[2].Status.VelocityMMs :=\n        LREAL_TO_REAL(SM_Drive_Logical_B.fActVelocity);\nELSE\n    GVL.g_aConveyorRuntime[2].Status.VelocityMMs :=\n        -LREAL_TO_REAL(SM_Drive_Logical_B.fActVelocity);\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 4. GIỚI HẠN FILTER FACTOR 0.0 ... 1.0\n//-----------------------------------------------------------------------------\nIF GVL.g_aConveyorRuntime[2].Config.VelocityFilterFactor < 0.0 THEN\n    GVL.g_aConveyorRuntime[2].Config.VelocityFilterFactor := 0.0;\nELSIF GVL.g_aConveyorRuntime[2].Config.VelocityFilterFactor > 1.0 THEN\n    GVL.g_aConveyorRuntime[2].Config.VelocityFilterFactor := 1.0;\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 5. LOW-PASS FILTER VELOCITY\n//-----------------------------------------------------------------------------\n// FilterFactor = 1.0 : gần như lấy trực tiếp Velocity.\n// FilterFactor nhỏ   : lọc mượt hơn nhưng phản ứng chậm hơn.\nGVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs :=\n    GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs\n    + GVL.g_aConveyorRuntime[2].Config.VelocityFilterFactor\n    * (\n        GVL.g_aConveyorRuntime[2].Status.VelocityMMs\n        - GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs\n    );\n\n\n//-----------------------------------------------------------------------------\n// 6. ACCELERATION\n//-----------------------------------------------------------------------------\n// PRG_MultiToolTracking_A hiện chạy trong task 4 ms.\n// a = Delta V / 0.004 s.\nIF xConveyorRuntimeFirstScanB THEN\n\n    GVL.g_aConveyorRuntime[2].Status.AccelerationMMs2 := 0.0;\n\n    rConveyorVelocityPrevB :=\n        GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs;\n\n    xConveyorRuntimeFirstScanB := FALSE;\n\nELSE\n\n    GVL.g_aConveyorRuntime[2].Status.AccelerationMMs2 :=\n        (\n            GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs\n            - rConveyorVelocityPrevB\n        ) / 0.004;\n\n    rConveyorVelocityPrevB :=\n        GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 7. RUNNING / STANDSTILL / DIRECTION\n//-----------------------------------------------------------------------------\nIF ABS(GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs)\n    > GVL.g_aConveyorRuntime[2].Config.RunningThresholdMMs THEN\n\n    GVL.g_aConveyorRuntime[2].Status.Running := TRUE;\n    GVL.g_aConveyorRuntime[2].Status.Standstill := FALSE;\n\n    IF GVL.g_aConveyorRuntime[2].Status.FilteredVelocityMMs > 0.0 THEN\n        GVL.g_aConveyorRuntime[2].Status.Direction := 1;\n    ELSE\n        GVL.g_aConveyorRuntime[2].Status.Direction := -1;\n    END_IF;\n\nELSE\n\n    GVL.g_aConveyorRuntime[2].Status.Running := FALSE;\n    GVL.g_aConveyorRuntime[2].Status.Standstill := TRUE;\n    GVL.g_aConveyorRuntime[2].Status.Direction := 0;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 8. VALID\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[2].Status.Valid :=\n    GVL.g_aConveyorRuntime[2].Config.Enable;\n\n\n//-----------------------------------------------------------------------------\n// 9. ERROR LIMIT CHECK\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[2].Status.Error := FALSE;\nGVL.g_aConveyorRuntime[2].Status.ErrorID := 0;\n\nIF GVL.g_aConveyorRuntime[2].Config.MaxVelocityMMs > 0.0\nAND ABS(GVL.g_aConveyorRuntime[2].Status.VelocityMMs)\n    > GVL.g_aConveyorRuntime[2].Config.MaxVelocityMMs THEN\n\n    GVL.g_aConveyorRuntime[2].Status.Error := TRUE;\n    GVL.g_aConveyorRuntime[2].Status.ErrorID := 9001;\n\nELSIF GVL.g_aConveyorRuntime[2].Config.MaxAccelerationMMs2 > 0.0\nAND ABS(GVL.g_aConveyorRuntime[2].Status.AccelerationMMs2)\n    > GVL.g_aConveyorRuntime[2].Config.MaxAccelerationMMs2 THEN\n\n    GVL.g_aConveyorRuntime[2].Status.Error := TRUE;\n    GVL.g_aConveyorRuntime[2].Status.ErrorID := 9002;\n\nEND_IF;\n\n\nrtCreateTestObjectB(CLK := GVL.g_xCreateTestTrackingObjectB);\n\nIF rtCreateTestObjectB.Q THEN\n    GVL.g_stTrackingQueue_B.NextObjectID := GVL.g_stTrackingQueue_B.NextObjectID + 1;\n    IF GVL.g_stTrackingQueue_B.NextObjectID = 0 THEN GVL.g_stTrackingQueue_B.NextObjectID := 1; END_IF;\n\n    GVL.g_stTrackingQueue_B.Objects[1].Valid := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[1].ObjectID := GVL.g_stTrackingQueue_B.NextObjectID;\n    GVL.g_stTrackingQueue_B.Objects[1].ProductClassID := 1;\n    GVL.g_stTrackingQueue_B.Objects[1].Reserved := FALSE;\n    GVL.g_stTrackingQueue_B.Objects[1].ReservedToolID := 0;\n    GVL.g_stTrackingQueue_B.Objects[1].CanPick := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[1].OrientationValid := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[1].VisionScore := 100.0;\n    GVL.g_stTrackingQueue_B.Objects[1].State := E_TrackingObjectState.OBJ_READY;\n\n    GVL.g_stTrackingQueue_B.Objects[1].VisionPos.X := 000.0;\n    GVL.g_stTrackingQueue_B.Objects[1].VisionPos.Y := 0.0;\n    GVL.g_stTrackingQueue_B.Objects[1].VisionPos.Z := 50.0;\n    GVL.g_stTrackingQueue_B.Objects[1].VisionPos.A := 0.0;\n\t\n\t//-------------------------------------------------------------------------\n\t// OBJECT 1 - POSE CHUẨN TRONG HỆ CONVEYOR\n\t//-------------------------------------------------------------------------\n\tGVL.g_stTrackingQueue_B.Objects[1].PoseInConveyor.X := 000.0;\n\tGVL.g_stTrackingQueue_B.Objects[1].PoseInConveyor.Y := 0.0;\n\tGVL.g_stTrackingQueue_B.Objects[1].PoseInConveyor.Z := 50.0;\n\tGVL.g_stTrackingQueue_B.Objects[1].PoseInConveyor.A := 0.0;\n\n\t\n\t// Chốt vị trí Conveyor đúng thời điểm Object được tạo.\n\tGVL.g_stTrackingQueue_B.Objects[1].CaptureConveyorPositionMM :=\n\t\tREAL_TO_LREAL(GVL.g_aConveyorRuntime[2].Status.PositionMM);\n\t\n\t//---------------------------------------------------------------------\n    // OBJECT 2\n    //---------------------------------------------------------------------\n    GVL.g_stTrackingQueue_B.NextObjectID :=\n        GVL.g_stTrackingQueue_B.NextObjectID + 1;\n\n    IF GVL.g_stTrackingQueue_B.NextObjectID = 0 THEN\n        GVL.g_stTrackingQueue_B.NextObjectID := 1;\n    END_IF;\n\n    GVL.g_stTrackingQueue_B.Objects[2].Valid := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[2].ObjectID :=\n        GVL.g_stTrackingQueue_B.NextObjectID;\n    GVL.g_stTrackingQueue_B.Objects[2].ProductClassID := 1;\n    GVL.g_stTrackingQueue_B.Objects[2].Reserved := FALSE;\n    GVL.g_stTrackingQueue_B.Objects[2].ReservedToolID := 0;\n    GVL.g_stTrackingQueue_B.Objects[2].CanPick := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[2].OrientationValid := TRUE;\n    GVL.g_stTrackingQueue_B.Objects[2].VisionScore := 100.0;\n    GVL.g_stTrackingQueue_B.Objects[2].State := E_TrackingObjectState.OBJ_READY;\n\n    // Đặt cách Object 1 một khoảng để dễ quan sát.\n    GVL.g_stTrackingQueue_B.Objects[2].VisionPos.X := 260.0;\n    GVL.g_stTrackingQueue_B.Objects[2].VisionPos.Y := 0.0;\n    GVL.g_stTrackingQueue_B.Objects[2].VisionPos.Z := 50.0;\n    GVL.g_stTrackingQueue_B.Objects[2].VisionPos.A := 0.0;\n\t\n\t//-------------------------------------------------------------------------\n\t// OBJECT 2 - POSE CHUẨN TRONG HỆ CONVEYOR\n\t//-------------------------------------------------------------------------\n\tGVL.g_stTrackingQueue_B.Objects[2].PoseInConveyor.X := 260.0;\n\tGVL.g_stTrackingQueue_B.Objects[2].PoseInConveyor.Y := 0.0;\n\tGVL.g_stTrackingQueue_B.Objects[2].PoseInConveyor.Z := 50.0;\n\tGVL.g_stTrackingQueue_B.Objects[2].PoseInConveyor.A := 0.0;\n\n\t\n\tGVL.g_stTrackingQueue_B.Objects[2].CaptureConveyorPositionMM :=\n\t\tREAL_TO_LREAL(GVL.g_aConveyorRuntime[2].Status.PositionMM);\n\n    GVL.g_stTrackingQueue_B.ValidCount := 2;\n    GVL.g_stTrackingQueue_B.ActiveIndex := GVL.C_INVALID_INDEX;\n\t\n\n//     GVL.g_stTrackingQueue_B.ValidCount := 1;\n    GVL.g_stTrackingQueue_B.ActiveIndex := GVL.C_INVALID_INDEX;\nEND_IF;\n\n\n//=============================================================================\n// KHỞI TẠO CẤU HÌNH MẶC ĐỊNH CHO MULTI-TOOL ROBOT B\n//-----------------------------------------------------------------------------\n// Chỉ chạy một lần khi cấu hình chưa được khởi tạo hoặc khi người dùng yêu cầu\n// khởi tạo lại. Không ghi đè cấu hình HMI trong mỗi vòng quét PLC.\n//=============================================================================\nIF (NOT GVL.g_xMultiToolConfigInitializedB OR GVL.g_xInitializeMultiToolConfigB) AND (1=2) THEN\n\n    //-------------------------------------------------------------------------\n    // TOOL 1\n    //-------------------------------------------------------------------------\n\tGVL.g_aToolConfigB[1].Enable := TRUE;\n\tGVL.g_aToolConfigB[1].AllowTracking := TRUE;\n\tGVL.g_aToolConfigB[1].ToolID := 1;\n\tGVL.g_aToolConfigB[1].AllowedProductClassID := 0;\n\t\n\n    //-------------------------------------------------------------------------\n    // RECIPE 1 DÙNG CHO COMMISSIONING\n    //-------------------------------------------------------------------------\n    GVL.g_aMultiTrackRecipeB[1].Enable := TRUE;\n    GVL.g_aMultiTrackRecipeB[1].RecipeID := 1;\n    GVL.g_aMultiTrackRecipeB[1].ProductClassID := 0;\n    GVL.g_aMultiTrackRecipeB[1].TargetPickCount := 1;\n    GVL.g_aMultiTrackRecipeB[1].ToolEnableMask := DWORD#1;\n\t\n\tGVL.g_aToolConfigB[1].PickOffset.X := 0.0;\n\tGVL.g_aToolConfigB[1].PickOffset.Y := 0.0;\n\tGVL.g_aToolConfigB[1].PickOffset.Z := 50.0;\n\tGVL.g_aToolConfigB[1].PickOffset.A := 0.0;\n\t\n\tGVL.g_aToolConfigB[1].ApproachHeight := 20.0;\n\tGVL.g_aToolConfigB[1].UseUpDown := FALSE;\n\tGVL.g_aToolConfigB[1].UpDownStroke := 20.0;\n\t\n\tGVL.g_stTrackingConfig_B.RetractHeight := 20.0;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// TOOL 2\n\t//-------------------------------------------------------------------------\n\tGVL.g_aToolConfigB[2].Enable := TRUE;\n\tGVL.g_aToolConfigB[2].AllowTracking := TRUE;\n\tGVL.g_aToolConfigB[2].ToolID := 2;\n\tGVL.g_aToolConfigB[2].AllowedProductClassID := 0;\n\t\n\tGVL.g_aToolConfigB[2].PickOffset.X := 0.0;\n\tGVL.g_aToolConfigB[2].PickOffset.Y := 0.0;\n\tGVL.g_aToolConfigB[2].PickOffset.Z := 50.0;\n\tGVL.g_aToolConfigB[2].PickOffset.A := 0.0;\n\t\n\tGVL.g_aToolConfigB[2].ApproachHeight := 20.0;\n\t\n\t// Có thể đặt khác Tool 1 để quan sát.\n\tGVL.g_aToolConfigB[2].UseUpDown := FALSE;\n\tGVL.g_aToolConfigB[2].UpDownStroke := 20.0;\n\t\n\tGVL.g_aToolConfigB[2].Priority := 2;\n\n\n\t//=============================================================================\n\t// DYNAMIC APPROACH\n\t//-----------------------------------------------------------------------------\n\t// Thông số thử nghiệm ban đầu. Có thể chỉnh lại trên HMI sau.\n\t//=============================================================================\n\tGVL.g_stTrackingConfig_B.Motion.Approach.Speed := 100.0;\n\tGVL.g_stTrackingConfig_B.Motion.Approach.Acceleration := 500.0;\n\tGVL.g_stTrackingConfig_B.Motion.Approach.Deceleration := 500.0;\n\tGVL.g_stTrackingConfig_B.Motion.Approach.Jerk := 1000.0;\n\tGVL.g_stTrackingConfig_B.Motion.Approach.BlendRadius := 0.0;\n\t\n\tGVL.g_stTrackingSimulation.VirtualEncoderStepPerCycle := -5;\n\n    //-------------------------------------------------------------------------\n    // ĐÁNH DẤU ĐÃ KHỞI TẠO\n    //-------------------------------------------------------------------------\n    GVL.g_xMultiToolConfigInitializedB := TRUE;\n    GVL.g_xInitializeMultiToolConfigB := FALSE;\n\nEND_IF;\n\n//=============================================================================\n// PHỤC HỒI DỮ LIỆU COMMISSIONING KHI RESET MULTI-TOOL\n//-----------------------------------------------------------------------------\n// Chỉ dùng khi test Object cố định.\n// Khi chạy Vision/Sensor thật, Object lỗi phải được loại bỏ hoặc nạp Object mới.\n//=============================================================================\nIF GVL.g_xMultiTrackResetTestB THEN\n\n\n\t//---------------------------------------------------------------------\n    // RESET TOOL 1\n    //---------------------------------------------------------------------\n    GVL.g_aToolStatusB[1].Busy := FALSE;\n    GVL.g_aToolStatusB[1].Occupied := FALSE;\n    GVL.g_aToolStatusB[1].Error := FALSE;\n    GVL.g_aToolStatusB[1].ErrorID := 0;\n    GVL.g_aToolStatusB[1].HeldObjectID := 0;\n    GVL.g_aToolStatusB[1].GripOK := FALSE;\n\n    //---------------------------------------------------------------------\n    // RESET TOOL 2\n    //---------------------------------------------------------------------\n    GVL.g_aToolStatusB[2].Busy := FALSE;\n    GVL.g_aToolStatusB[2].Occupied := FALSE;\n    GVL.g_aToolStatusB[2].Error := FALSE;\n    GVL.g_aToolStatusB[2].ErrorID := 0;\n    GVL.g_aToolStatusB[2].HeldObjectID := 0;\n    GVL.g_aToolStatusB[2].GripOK := FALSE;\n\t\n\t// Comment lai vi dang test object thuc\n\n//     //---------------------------------------------------------------------\n//     // RESET OBJECT 1\n//     //---------------------------------------------------------------------\n//     GVL.g_stTrackingQueue_B.Objects[1].Valid := TRUE;\n//     GVL.g_stTrackingQueue_B.Objects[1].CanPick := TRUE;\n//     GVL.g_stTrackingQueue_B.Objects[1].Reserved := FALSE;\n//     GVL.g_stTrackingQueue_B.Objects[1].ReservedToolID := 0;\n//     GVL.g_stTrackingQueue_B.Objects[1].State :=\n//         E_TrackingObjectState.OBJ_READY;\n// \n//     //---------------------------------------------------------------------\n//     // RESET OBJECT 2\n//     //---------------------------------------------------------------------\n//     GVL.g_stTrackingQueue_B.Objects[2].Valid := TRUE;\n//     GVL.g_stTrackingQueue_B.Objects[2].CanPick := TRUE;\n//     GVL.g_stTrackingQueue_B.Objects[2].Reserved := FALSE;\n//     GVL.g_stTrackingQueue_B.Objects[2].ReservedToolID := 0;\n//     GVL.g_stTrackingQueue_B.Objects[2].State :=\n//         E_TrackingObjectState.OBJ_READY;\n// \n//     GVL.g_stTrackingQueue_B.ValidCount := 2;\n//     GVL.g_stTrackingQueue_B.ActiveIndex := GVL.C_INVALID_INDEX;\n\nEND_IF;\n\nIF stCommandB.Reset THEN\n    udiDebugCoreStartCountB := 0;\n    udiDebugExecuteToCoreCountB := 0;\n    udiDebugCoreRequestCountB := 0;\n\n    xDebugCoreStartLatchedB := FALSE;\n    xDebugExecuteToCoreLatchedB := FALSE;\n    xDebugCoreRequestLatchedB := FALSE;\n\tGVL.g_xMultiTrackStartTestB := FALSE;\nEND_IF;\n\n//=============================================================================\n// 04. MULTI-TOOL CONTROLLER\n//-----------------------------------------------------------------------------\n// Controller đọc phản hồi của Core, SelectTool và ToolManager từ vòng quét trước.\n//=============================================================================\nfbControllerB(\n    Command := stCommandB,\n    CoreAccepted := fbCoreInterfaceB.Accepted,\n    CoreBusy := fbCoreInterfaceB.Busy,\n    CoreSyncOK := fbCoreInterfaceB.SyncOK,\n    CorePCSInUse := fbCoreInterfaceB.PCSInUse,\n    CoreReleased := fbCoreInterfaceB.Released,\n    CoreError := fbCoreInterfaceB.Error,\n    CoreErrorID := fbCoreInterfaceB.ErrorID,\n    SelectToolDone := fbSelectToolB.Done,\n    SelectToolError := fbSelectToolB.Error,\n    SelectToolErrorID := fbSelectToolB.ErrorID,\n    Queue := GVL.g_stTrackingQueue_B,\n    ToolConfig := GVL.g_aToolConfigB,\n    ToolStatus := GVL.g_aToolStatusB,\n    Recipes := GVL.g_aMultiTrackRecipeB,\n    Status := GVL.g_stMultiTrackStatusB\n);\n\n\n//=============================================================================\n// MULTI-TOOL TRACKING RESULT LATCH\n//=============================================================================\n\n// Command mới được Controller nhận -> xóa kết quả command trước.\nIF GVL.g_stMultiTrackStatusB.Accepted THEN\n    GVL.g_xTrackOKB := FALSE;\n    GVL.g_xTrackErrorB := FALSE;\n    GVL.g_udiTrackErrorIDB := 0;\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// TRACKING PICK HOÀN THÀNH ĐỦ SỐ LƯỢNG.\n//-----------------------------------------------------------------------------\nIF GVL.g_stMultiTrackStatusB.Done\nAND NOT GVL.g_stMultiTrackStatusB.Error\nAND GVL.g_stMultiTrackStatusB.PickedCount >= GVL.g_stMultiTrackStatusB.TargetPickCount THEN\n\n    GVL.g_xTrackOKB := TRUE;\n    GVL.g_xTrackErrorB := FALSE;\n    GVL.g_udiTrackErrorIDB := 0;\n\n    // Chốt CommandID của đúng lệnh vừa hoàn thành.\n    GVL.g_udiTrackDoneCommandIDB :=\n        GVL.g_stMultiTrackStatusB.ResponseCommandID;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// TRACKING ERROR.\n//-----------------------------------------------------------------------------\nIF GVL.g_stMultiTrackStatusB.Error THEN\n\n    GVL.g_xTrackOKB := FALSE;\n    GVL.g_xTrackErrorB := TRUE;\n    GVL.g_udiTrackErrorIDB :=\n        GVL.g_stMultiTrackStatusB.ErrorID;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// RESET.\n//-----------------------------------------------------------------------------\nIF stCommandB.Reset THEN\n\n    GVL.g_xTrackOKB := FALSE;\n    GVL.g_xTrackErrorB := FALSE;\n    GVL.g_udiTrackErrorIDB := 0;\n    GVL.g_udiTrackDoneCommandIDB := 0;\n\nEND_IF;\n\n\n\n//=============================================================================\n// 05. TRACKING CORE INTERFACE\n//-----------------------------------------------------------------------------\n// Interface giữ Execute cho Tracking Core và chỉ hạ sau khi PCS đã release.\n//=============================================================================\nfbCoreInterfaceB(\n    Enable := TRUE,\n    Reset := fbControllerB.CoreReset,\n    Abort := fbControllerB.CoreAbort,\n    StartTracking := fbControllerB.CoreStart,\n    ReleaseTracking := fbControllerB.CoreRelease,\n    ObjectIndex := fbControllerB.CoreObjectIndex,\n    ToolID := fbControllerB.CoreToolID,\n    PickOffset := fbControllerB.CorePickOffset,\n    ApproachHeight := fbControllerB.CoreApproachHeight,\n\tPickSurfaceHeightMM := fbControllerB.CorePickSurfaceHeightMM,\n    CoreAccepted := GVL.g_stTrackingRuntime_B.Response.Accepted,\n\tCoreBusy := GVL.g_stTrackingRuntime_B.Response.Busy,\n\tCoreSyncOK := fbTrackingManagerB.SyncOK,\n\tCorePCSInUse := GVL.g_stTrackingRuntime_B.PCSInfo.InUse,\n\tCoreReleased := fbTrackingManagerB.Released,\n\tCoreError := GVL.g_stTrackingRuntime_B.Response.Error,\n\tCoreErrorID := GVL.g_stTrackingRuntime_B.Response.ErrorID,\n\tUseUpDown := fbControllerB.CoreUseUpDown,\n\tUpDownStroke := fbControllerB.CoreUpDownStroke,\n);\n\n\n//=============================================================================\n// 06. CHỌN TOOL/TCP ROBOT B\n//-----------------------------------------------------------------------------\n// FB_SelectRobotTool phải gọi SMC_GroupSetTool thực tế, không dùng placeholder.\n//=============================================================================\nfbSelectToolB(\n    Execute := fbControllerB.SelectToolExecute,\n    Reset := stCommandB.Reset,\n    ToolID := fbControllerB.SelectToolID\n);\n\n\n// xTrackingRequestValid :=\n//     fbCoreInterfaceB.ExecuteToCore\n//     AND fbCoreInterfaceB.ActiveObjectIndex >= 1\n//     AND fbCoreInterfaceB.ActiveObjectIndex <= GVL.C_MAX_TRACK_OBJECTS\n//     AND GVL.g_stTrackingQueue_B.Objects[fbCoreInterfaceB.ActiveObjectIndex].Valid;\n\t\nxCoreRequestValid := fbCoreInterfaceB.ExecuteToCore\nAND fbCoreInterfaceB.ActiveObjectIndex >= 1\nAND fbCoreInterfaceB.ActiveObjectIndex <= GVL.C_MAX_TRACK_OBJECTS\nAND GVL.g_stTrackingQueue_B.Objects[fbCoreInterfaceB.ActiveObjectIndex].Valid;\n\nrtDebugCoreStartB(CLK := fbControllerB.CoreStart);\nrtDebugExecuteToCoreB(CLK := fbCoreInterfaceB.ExecuteToCore);\nrtDebugCoreRequestValidB(CLK := xCoreRequestValid);\n\nIF rtDebugCoreStartB.Q THEN\n    udiDebugCoreStartCountB := udiDebugCoreStartCountB + 1;\n    xDebugCoreStartLatchedB := TRUE;\nEND_IF;\n\nIF rtDebugExecuteToCoreB.Q THEN\n    udiDebugExecuteToCoreCountB := udiDebugExecuteToCoreCountB + 1;\n    xDebugExecuteToCoreLatchedB := TRUE;\nEND_IF;\n\nIF rtDebugCoreRequestValidB.Q THEN\n    udiDebugCoreRequestCountB := udiDebugCoreRequestCountB + 1;\n    xDebugCoreRequestLatchedB := TRUE;\nEND_IF;\n\n\n//=============================================================================\n// 07. TRACKING CORE\n//-----------------------------------------------------------------------------\n// Multi-tool mode luôn dùng UseExternalSelection = TRUE.\n// Controller đã chọn ObjectIndex và PickOffset theo Tool.\n//=============================================================================\nfbTrackingManagerB(\n    Execute := xCoreRequestValid,\n    Reset := fbCoreInterfaceB.ResetToCore OR stCommandB.Reset,\n    Config := GVL.g_stTrackingConfig_B,\n    ConveyorConfig := GVL.g_aConveyorRuntime[2].Config,\n    ConveyorStatus := GVL.g_aConveyorRuntime[2].Status,\n    ConveyorOrigin := stConveyorOriginB,\n    VacuumOK := FALSE,\n    MotionAccepted := GVL.g_xTrackingMotionAcceptedB,\n    MotionBusy := GVL.g_xTrackingMotionBusyB,\n    MotionDone := GVL.g_xTrackingMotionDoneB,\n    MotionError := GVL.g_xTrackingMotionErrorB,\n    MotionErrorID := GVL.g_udiTrackingMotionErrorIDB,\n    MotionAbortDone := GVL.g_xTrackingMotionAbortDoneB,\n    TestFixedObjectMode := FALSE,\n    FixedObjectPosition := stFixedObjectPositionB,\n    UseExternalSelection := TRUE,\n    ExternalObjectIndex := fbCoreInterfaceB.ActiveObjectIndex,\n    ExternalPickOffset := fbCoreInterfaceB.ActivePickOffset,\n    ExternalApproachHeight := fbCoreInterfaceB.ActiveApproachHeight,\n    PickerSafe := fbCoreInterfaceB.PickerSafeToCore,\n    Queue := GVL.g_stTrackingQueue_B,\n    Runtime := GVL.g_stTrackingRuntime_B,\n\tExternalUseUpDown := fbCoreInterfaceB.ActiveUseUpDown,\n\tExternalUpDownStroke := fbCoreInterfaceB.ActiveUpDownStroke,\n\tExternalPickSurfaceHeightMM := fbCoreInterfaceB.ActivePickSurfaceHeightMM,\n);\n\n\n//=============================================================================\n// 08. MAP PHẢN HỒI TRACKING CORE\n//-----------------------------------------------------------------------------\n// Các biến này được FB_TrackingCoreInterface_A đọc ở vòng quét tiếp theo.\n//=============================================================================\nGVL.g_xTrackingCoreAcceptedB := GVL.g_stTrackingRuntime_B.Response.Accepted;\nGVL.g_xTrackingCoreBusyB := GVL.g_stTrackingRuntime_B.Response.Busy;\nGVL.g_xTrackingCoreSyncOKB := fbTrackingManagerB.SyncOK;\nGVL.g_xTrackingCorePCSInUseB := GVL.g_stTrackingRuntime_B.PCSInfo.InUse;\nGVL.g_xTrackingCoreReleasedB := fbTrackingManagerB.Released;\nGVL.g_xTrackingCoreErrorB := GVL.g_stTrackingRuntime_B.Response.Error;\nGVL.g_udiTrackingCoreErrorIDB := GVL.g_stTrackingRuntime_B.Response.ErrorID;\n\n\n//=============================================================================\n// 09. MOTION QUEUE ADAPTER\n//-----------------------------------------------------------------------------\n// Chỉ instance này được đưa motion Tracking vào Motion Queue Robot B.\n//=============================================================================\nfbMotionAdapterB(\n    Enable := TRUE,\n    Reset := fbCoreInterfaceB.ResetToCore OR stCommandB.Reset,\n    Request := fbTrackingManagerB.MotionRequest,\n    Abort := fbTrackingManagerB.MotionAbort,\n    Target := fbTrackingManagerB.MotionTarget,\n    Speed := fbTrackingManagerB.MotionSpeed,\n    Acceleration := fbTrackingManagerB.MotionAcceleration,\n    Deceleration := fbTrackingManagerB.MotionDeceleration,\n    Jerk := fbTrackingManagerB.MotionJerk,\n    BlendRadius := fbTrackingManagerB.MotionBlendRadius,\n    CoordSystem := fbTrackingManagerB.MotionCoordSystem,\n    Command := fbTrackingManagerB.MotionCommand,\n    LogicSimulation := GVL.g_stTrackingSimulation.Mode = E_ApplicationSimulationMode.SIM_LOGIC_ONLY,\n    LogicMotionDuration := GVL.g_stTrackingSimulation.LogicMotionDuration,\n    Accepted => GVL.g_xTrackingMotionAcceptedB,\n    Busy => GVL.g_xTrackingMotionBusyB,\n    Done => GVL.g_xTrackingMotionDoneB,\n    Error => GVL.g_xTrackingMotionErrorB,\n    ErrorID => GVL.g_udiTrackingMotionErrorIDB,\n    AbortDone => GVL.g_xTrackingMotionAbortDoneB\n);\n\n\n//=============================================================================\n// 10. PHÂN PHỐI COMMAND TỚI TỪNG TOOL MANAGER\n//-----------------------------------------------------------------------------\n// Chỉ Tool có ToolID trùng Command mới nhận Execute.\n// Các Tool còn lại vẫn được gọi mỗi vòng quét để duy trì Runtime và Output.\n//=============================================================================\nFOR uiTool := 1 TO GVL.C_MAX_TOOLS DO\n\t\n\t// Tất cả OUTPUT mặc định Active HIGH.\n\tGVL.g_aToolConfigB[uiTool].IO.DownDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.UpDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.GripDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.ReleaseDOActiveLevel := TRUE;\n\t\n\t// Tất cả INPUT feedback mặc định Active HIGH.\n\tGVL.g_aToolConfigB[uiTool].IO.DownOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.UpOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.GripOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigB[uiTool].IO.PartPresentDIActiveLevel := TRUE;\n\t\n    astToolCommandB[uiTool].Execute := FALSE;\n    astToolCommandB[uiTool].Reset := stCommandB.Reset;\n    astToolCommandB[uiTool].Abort := stCommandB.Abort;\n    astToolCommandB[uiTool].CommandID := 0;\n    astToolCommandB[uiTool].ToolID := GVL.g_aToolConfigB[uiTool].ToolID;\n    astToolCommandB[uiTool].CommandType := E_ToolCommandType.NONE;\n    astToolCommandB[uiTool].ObjectID := 0;\n\n    //IF fbControllerB.ToolCommand.ToolID = GVL.g_aToolConfigB[uiTool].ToolID THEN astToolCommandB[uiTool] := fbControllerB.ToolCommand; END_IF;\n\t\n//-------------------------------------------------------------------------\n\t// ƯU TIÊN 1: Command từ MultiTool Tracking Controller.\n\t//-------------------------------------------------------------------------\n\tIF fbControllerB.ToolCommand.Execute\n\tAND fbControllerB.ToolCommand.ToolID = GVL.g_aToolConfigB[uiTool].ToolID THEN\n\t\n\t\tastToolCommandB[uiTool] := fbControllerB.ToolCommand;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// ƯU TIÊN 2: Command Tool độc lập từ Interpreter.\n\t// Chỉ chạy khi Controller không phát Tool Command.\n\t//-------------------------------------------------------------------------\n\tELSIF GVL.g_stInterpreterToolCommandB.Execute\n\tAND GVL.g_stInterpreterToolCommandB.ToolID = GVL.g_aToolConfigB[uiTool].ToolID THEN\n\t\n\t\tastToolCommandB[uiTool] :=\n\t\t\tGVL.g_stInterpreterToolCommandB;\n\t\n\tEND_IF;\n\n    fbToolManagerB[uiTool](\n        Enable := GVL.g_aToolConfigB[uiTool].Enable,\n        Command := astToolCommandB[uiTool],\n        Config := GVL.g_aToolConfigB[uiTool],\n        Status := GVL.g_aToolStatusB[uiTool]\n    );\nEND_FOR;\n\n\n//=============================================================================\n// 11. BIẾN GIÁM SÁT HMI / DEBUG\n//=============================================================================\nGVL.g_xMultiTrackCoreExecuteB := fbCoreInterfaceB.ExecuteToCore;\nGVL.g_xMultiTrackCoreResetB := fbCoreInterfaceB.ResetToCore;\nGVL.g_xMultiTrackCoreAbortB := fbCoreInterfaceB.AbortToCore;\nGVL.g_xMultiTrackPickerSafeB := fbCoreInterfaceB.PickerSafeToCore;\nGVL.g_uiMultiTrackObjectIndexB := fbCoreInterfaceB.ActiveObjectIndex;\nGVL.g_uiMultiTrackToolIDB := fbCoreInterfaceB.ActiveToolID;\nGVL.g_stMultiTrackPickOffsetB := fbCoreInterfaceB.ActivePickOffset;\nGVL.g_rMultiTrackApproachHeightB := fbCoreInterfaceB.ActiveApproachHeight;\nGVL.g_xSelectToolExecuteB := fbControllerB.SelectToolExecute;\nGVL.g_uiSelectToolIDB := fbControllerB.SelectToolID;\nGVL.g_stSelectToolTCPB := fbControllerB.SelectToolTCP;\nGVL.g_xSelectToolDoneB := fbSelectToolB.Done;\nGVL.g_xSelectToolErrorB := fbSelectToolB.Error;\nGVL.g_udiSelectToolErrorIDB := fbSelectToolB.ErrorID;\n\n\n//=============================================================================\n// 12. OUTPUT CŨ CỦA TRACKING CORE\n//-----------------------------------------------------------------------------\n// Multi-tool mode không dùng VacuumCommand/BlowCommand; giữ map để debug.\n//=============================================================================\nGVL.g_xTrackingVacuumOutputB := fbTrackingManagerB.VacuumCommand;\nGVL.g_xTrackingBlowOutputB := fbTrackingManagerB.BlowCommand;","LineInfoPersistence":"(string)d7596da6-e727-49c1-bef6-c7286004cb54_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_MultiToolTracking_B\nVAR\n    fbControllerB : FB_MultiToolTrackingController_B;\n    fbCoreInterfaceB : FB_TrackingCoreInterface_B;\n    fbTrackingManagerB : FB_CONVEYOR_TRACKING_MANAGER_B;\n    fbMotionAdapterB : FB_TrackingMotionQueueAdapter_B;\n    fbSelectToolB : FB_SelectRobotTool_B;\n    fbToolManagerB : ARRAY[0..GVL.C_MAX_TOOLS] OF FB_ToolManager_B;\n    astToolCommandB : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolCommand;\n    stCommandB : ST_MultiToolTrackingCommand;\n    stConveyorOriginB : MC_COORD_REF;\n    stFixedObjectPositionB : MC_COORD_REF;\n    diVirtualEncoderB : DINT;\n    uiTool : UINT;\n    xTrackingRequestValid : BOOL;\n    rtCreateTestObjectB : R_TRIG;\n    xCoreRequestValid : BOOL;\n    rtMultiTrackStartTestB : R_TRIG;\n    xMultiTrackTestExecuteB : BOOL := FALSE;\n    rtDebugCoreStartB : R_TRIG;\n    rtDebugExecuteToCoreB : R_TRIG;\n    rtDebugCoreRequestValidB : R_TRIG;\n    udiDebugCoreStartCountB : UDINT;\n    udiDebugExecuteToCoreCountB : UDINT;\n    udiDebugCoreRequestCountB : UDINT;\n    xDebugCoreStartLatchedB : BOOL;\n    xDebugExecuteToCoreLatchedB : BOOL;\n    xDebugCoreRequestLatchedB : BOOL;\n    rConveyorVelocityPrevB : REAL;\n    xConveyorRuntimeFirstScanB : BOOL := TRUE;\n    fbPower : MC_Power;\n    count_scan : INT;\n    i_count : INT;\n    udiv : INT;\n    count_cal_max : INT;\n    count_cal : INT;\n    pulse_old : DINT;\n    pulse_track : DINT;\n    delta : REAL;\n    rPulsePerScan : REAL;\n    rFractionAcc : REAL;\n    diBasePulse : DINT;\n    diPulseThisScan : DINT;\n    diSmoothCount : DINT;\nEND_VAR\n\n","LineInfoPersistence":"(string)d7596da6-e727-49c1-bef6-c7286004cb54_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)921","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}