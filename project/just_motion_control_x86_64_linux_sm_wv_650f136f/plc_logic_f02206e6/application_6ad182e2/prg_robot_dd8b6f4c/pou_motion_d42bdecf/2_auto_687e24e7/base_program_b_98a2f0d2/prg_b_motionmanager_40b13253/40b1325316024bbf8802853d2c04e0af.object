{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)40b13253-1602-4bbf-8802-853d2c04e0af","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)PRG_B_MotionManager","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)98a2f0d2-d70d-4472-84e6-40f68f5ab94d"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ACTION/POU: PRG_B_MotionManager\n// Create B-specific local FB instances/variables. Do NOT reuse Robot A motion FB instances.\n// Required local names can be copied from PRG_A_MotionManager declaration and renamed with _B.\n\n\n                  \n                    \n                      //====================================================\n// PRG_B_MotionManager\n// Controlled Pipeline Motion Manager\n// - Chạy nền liên tục.\n// - Có queue và slot rảnh thì Pop motion vào slot.\n// - Slot Accepted thì hạ Start để FB Motion chạy tiếp.\n// - Slot Done thì báo về Interpreter bằng A_MotionDonePulse.\n// - Slot Error thì báo lỗi đúng SourceStep.\n//====================================================\n\n\n//====================================================\n// ABORT REQUEST\n// Ưu tiên cao nhất trong MotionManager\n// Dùng khi Stop / Alarm / Reset\n//====================================================\nIF GVL.B_MotionAbortReq OR GVL.X[7] THEN\n\n    PopReq_B := FALSE;\n\n    GVL.B_MotionHead := 1;\n    GVL.B_MotionTail := 1;\n    GVL.B_MotionCount := 0;\n\tGVL.B_PipelineUsedCount := 0;\n    FOR i := 1 TO 3 DO\n        GVL.B_MoveSlotStart[i] := FALSE;\n        GVL.B_MoveSlotBusy[i] := FALSE;\n\n        GVL.B_MoveSlotAccepted[i] := FALSE;\n        GVL.B_MoveSlotDone[i] := FALSE;\n        GVL.B_MoveSlotError[i] := FALSE;\n        GVL.B_MoveSlotErrorID[i] := 0;\n\t\tGVL.B_MoveSlotReleasePending[i] := FALSE;\n        GVL.B_MoveSlotCmd[i] := E_RobotCmd.CMD_NOP;\n\t\t\n    END_FOR;\n\n    GVL.B_ActiveMotionCount := 0;\n\n    GVL.B_MotionManagerBusy := FALSE;\n    GVL.B_MotionManagerDone := FALSE;\n    GVL.B_MotionManagerError := FALSE;\n    GVL.B_MotionManagerState := 0;\n\n    GVL.B_MotionDonePulse := FALSE;\n    GVL.B_MotionErrorPulse := FALSE;\n\n    GVL.B_MotionAbortReq := FALSE;\n    GVL.B_MotionAbortDone := TRUE;\n\nELSE\n\n\t// Luôn gọi FB MoveP/L/C mỗi scan\n\t\n\tCASE GVL.B_MotionManagerState OF\n\t\n\t\t0: // IDLE / READY\n\t\n\t\t\tGVL.B_MotionManagerDone := FALSE;\n\t\n\t\t\t// Nếu có motion trong queue và còn slot rảnh thì lấy ra chạy\n\t\t\tIF (GVL.B_MotionCount > 0) AND (F_GetFreeMoveSlot_B() > 0) THEN\n\t\t\t\tGVL.B_MotionManagerBusy := TRUE;\n\t\t\t\tPopReq_B := TRUE;\n\t\n\t\t\t\tGVL.B_MotionManagerState := 10;\n\t\n\t\t\tELSE\n\t\t\t\t// Không còn queue và không còn slot active\n\t\t\t\tIF GVL.B_ActiveMotionCount <= 0 THEN\n\t\t\t\t\tGVL.B_MotionManagerBusy := FALSE;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\n\t\n\t\t10: // WAIT POP DONE\n\t\n\t\t\tIF fbPop_B.Done THEN\n\t\t\t\tPopReq_B := FALSE;\n\t\n\t\t\t\titem_PRG_B_MotionManager := fbPop_B.Item;\n\t\t\t\tfreeSlot_B := F_GetFreeMoveSlot_B();\n\t\n\t\t\t\tIF freeSlot_B > 0 THEN\n\t\n\t\t\t\t\t// Gán item vào slot rảnh\n\t\t\t\t\tGVL.B_MoveSlotItem[freeSlot_B] := item_PRG_B_MotionManager;\n\t\t\t\t\tGVL.B_MoveSlotCmd[freeSlot_B]  := item_PRG_B_MotionManager.Cmd;\n\t\n\t\t\t\t\t// Reset trạng thái slot trước khi Start\n\t\t\t\t\tGVL.B_MoveSlotBusy[freeSlot_B]     := TRUE;\n\t\t\t\t\tGVL.B_MoveSlotStart[freeSlot_B]    := TRUE;\n\t\t\t\t\tGVL.B_MoveSlotAccepted[freeSlot_B] := FALSE;\n\t\t\t\t\tGVL.B_MoveSlotDone[freeSlot_B]     := FALSE;\n\t\t\t\t\tGVL.B_MoveSlotError[freeSlot_B]    := FALSE;\n\t\t\t\t\t\n\t\t\t\t\tGVL.B_MoveSlotErrorID[freeSlot_B] := 0;\n\n\t\t\t\t\tGVL.B_MoveSlotReleasePending[freeSlot_B] := FALSE;\n\t\t\t\t\t\n\t\t\t\t\t// Ghi nhớ chính xác slot vừa cấp\n   \t\t\t\t\tWaitAcceptSlot_B := freeSlot_B;\n\t\n\t\t\t\t\t// Tăng số motion đang active\n\t\t\t\t\t//GVL.B_ActiveMotionCount := GVL.B_ActiveMotionCount + 1;\n\t\n\t\t\t\t\tGVL.B_MotionManagerState := 20;\n\t\n\t\t\t\tELSE\n\t\t\t\t\t// Trường hợp hiếm: vừa Pop xong nhưng slot không còn rảnh\n\t\t\t\t\tGVL.B_MotionManagerState := 30;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\t\n\t\t\tIF fbPop_B.Empty THEN\n\t\t\t\tPopReq_B := FALSE;\n\t\t\t\tGVL.B_MotionManagerState := 30;\n\t\t\tEND_IF;\n\t\n\t\n\t\t20: // WAIT COMMAND ACCEPTED\n\t\t\t\n\t\t//--------------------------------------------------------\n\t\t\t// Chỉ chờ đúng slot vừa được State 10 cấp lệnh\n\t\t\t//--------------------------------------------------------\n\t\t\tIF (WaitAcceptSlot_B >= 1)\n\t\t\t   AND (WaitAcceptSlot_B <= 3)\n\t\t\tTHEN\n\t\t\n\t\t\t\t//----------------------------------------------------\n\t\t\t\t// Slot vẫn phải thuộc quyền sở hữu của Manager\n\t\t\t\t//----------------------------------------------------\n\t\t\t\tIF GVL.B_MoveSlotBusy[WaitAcceptSlot_B] THEN\n\t\t\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\t// Lệnh đã được FB Move nhận\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\tIF GVL.B_MoveSlotAccepted[WaitAcceptSlot_B] THEN\n\t\t\n\t\t\t\t\t\tGVL.B_MoveSlotStart[WaitAcceptSlot_B] := FALSE;\n\t\t\n\t\t\t\t\t\t// Đã hoàn thành handshake Accepted\n\t\t\t\t\t\tWaitAcceptSlot_B := 0;\n\t\t\n\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t// PipelineLength = 1:\n\t\t\t\t\t\t// Không Pop thêm khi còn motion đang chạy.\n\t\t\t\t\t\t// Sang State 30 chờ motion hoàn thành.\n\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\tGVL.B_MotionManagerState := 30;\n\t\t\n\t\t\n\t\t\t\t\tELSIF GVL.B_MoveSlotError[WaitAcceptSlot_B] THEN\n\t\t\n\t\t\t\t\t\tGVL.B_MotionManagerError := TRUE;\n\t\t\n\t\t\t\t\t\tGVL.B_MotionErrorPulse := TRUE;\n\t\t\t\t\t\tGVL.B_MotionErrorStep :=\n\t\t\t\t\t\t\tGVL.B_MoveSlotItem[WaitAcceptSlot_B].SourceStep;\n\t\t\n\t\t\t\t\t\tGVL.B_MotionErrorCode :=\n\t\t\t\t\t\t\tGVL.B_MoveSlotErrorID[WaitAcceptSlot_B];\n\t\t\n\t\t\t\t\t\tWaitAcceptSlot_B := 0;\n\t\t\n\t\t\t\t\t\tGVL.B_MotionManagerState := 900;\n\t\t\n\t\t\t\t\tEND_IF;\n\t\t\n\t\t\t\tEND_IF;\n\t\t\n\t\t\tELSE\n\t\t\n\t\t\t\t//----------------------------------------------------\n\t\t\t\t// Không có slot nào đang chờ Accepted.\n\t\t\t\t// Đây là trạng thái bất thường, quay về quản lý queue.\n\t\t\t\t//----------------------------------------------------\n\t\t\t\tGVL.B_MotionManagerState := 30;\n\t\t\n\t\t\tEND_IF;\n\t\n\t\t30: // WAIT / CONTINUE PIPELINE\n\t\n\t\t\t// Nếu sau đó Interpreter push thêm queue và có slot rảnh thì tiếp tục chạy\n\t\t\tIF (GVL.B_MotionCount > 0) AND (F_GetFreeMoveSlot_B() > 0) THEN\n\t\t\t\tGVL.B_MotionManagerBusy := TRUE;\n\t\t\t\tPopReq_B := TRUE;\n\t\t\t\tGVL.B_MotionManagerState := 10;\n\t\n\t\t\t// Nếu không còn queue và không còn motion active thì MotionManager rảnh\n\t\t\tELSIF (GVL.B_MotionCount <= 0) AND (GVL.B_ActiveMotionCount <= 0) THEN\n\t\t\t\tGVL.B_MotionManagerBusy := FALSE;\n\t\t\t\tGVL.B_MotionManagerDone := TRUE;\n\t\t\t\tGVL.B_MotionManagerState := 0;\n\t\t\tEND_IF;\n\t\n\t\n\t\t900: // ERROR\n\t\n\t\t\tPopReq_B := FALSE;\n\t\n\t\t\t// Dừng cấp thêm motion mới\n\t\t\tFOR i := 1 TO 3 DO\n\t\t\t\tGVL.B_MoveSlotStart[i] := FALSE;\n\t\t\tEND_FOR;\n\t\n\t\t\tGVL.B_MotionManagerBusy := FALSE;\n\t\t\tGVL.B_MotionManagerError := TRUE;\n\t\n\t\t\tGVL.B_MotionManagerState := 0;\n\t\n\tEND_CASE;\nEND_IF;\n//====================================================\n// Gọi FB Pop mỗi scan\n//====================================================\nfbPop_B(\n    Execute := PopReq_B\n);\n\n\n\n//============================================================\n// CALL MOTION SLOT FB\n// Tất cả FB phải được gọi liên tục mỗi scan.\n//\n// Khi slot không sử dụng hoặc không đúng loại lệnh:\n// Start của FB tương ứng phải bằng FALSE.\n// Nhờ vậy LastStart và State bên trong FB được cập nhật đúng.\n//============================================================\n\nFOR i := 1 TO 3 DO\n\n    //--------------------------------------------------------\n    // Chuẩn bị tọa độ\n    //--------------------------------------------------------\n    IF GVL.B_MoveSlotBusy[i] THEN\n\n        CASE GVL.B_MoveSlotCmd[i] OF\n\n            E_RobotCmd.CMD_MovP,\n            E_RobotCmd.CMD_MovL:\n\n//                 SlotPos_B[i] :=\n//                     F_GetPointSMC_B(\n//                         GVL.B_MoveSlotItem[i].PointNo\n//                     );\n\t\t\t\tIF GVL.B_MoveSlotItem[i].UseDirectPosition THEN\n\t\t\t\t\tSlotPos_B[i].c.X := GVL.B_MoveSlotItem[i].DirectPosition.X;\n\t\t\t\t\tSlotPos_B[i].c.Y := GVL.B_MoveSlotItem[i].DirectPosition.Y;\n\t\t\t\t\tSlotPos_B[i].c.Z := GVL.B_MoveSlotItem[i].DirectPosition.Z;\n\t\t\t\t\tSlotPos_B[i].c.A := GVL.B_MoveSlotItem[i].DirectPosition.A;\n\t\t\t\tELSE\n\t\t\t\t\tSlotPos_B[i] := F_GetPointSMC_B(GVL.B_MoveSlotItem[i].PointNo);\n\t\t\t\tEND_IF;\n\n\n\n            E_RobotCmd.CMD_MovC:\n\n                SlotMidPos_B[i] :=\n                    F_GetPointSMC_B(\n                        GVL.B_MoveSlotItem[i].MidPointNo\n                    );\n\n                SlotEndPos_B[i] :=\n                    F_GetPointSMC_B(\n                        GVL.B_MoveSlotItem[i].EndPointNo\n                    );\n\n        END_CASE;\n\n    END_IF;\n\n\n    //--------------------------------------------------------\n    // MoveP\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveP_B[i](\n        Start :=\n            GVL.B_MoveSlotBusy[i]\n            AND\n            (GVL.B_MoveSlotCmd[i] = E_RobotCmd.CMD_MovP)\n            AND\n            GVL.B_MoveSlotStart[i],\n\t\tRelease := GVL.B_MoveSlotReleasePending[i],\n        AxisGroup := SCARA_B,\n        Item := GVL.B_MoveSlotItem[i],\n        PositionIn := SlotPos_B[i],\n        //CoordSystem := GVL.RB_B.COORD\n\t\tCoordSystem := SEL(\n\t\t\tGVL.B_MoveSlotItem[i].UseDirectPosition,\n\t\t\t//GVL.RB_B.COORD,\n\t\t\tSMC_COORD_SYSTEM.MCS,\n\t\t\tGVL.B_MoveSlotItem[i].DirectCoordSystem)\n\n    );\n\n\n    //--------------------------------------------------------\n    // MoveL\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveL_B[i](\n        Start :=\n            GVL.B_MoveSlotBusy[i]\n            AND\n            (GVL.B_MoveSlotCmd[i] = E_RobotCmd.CMD_MovL)\n            AND\n            GVL.B_MoveSlotStart[i],\n\n        AxisGroup := SCARA_B,\n        Item := GVL.B_MoveSlotItem[i],\n        PositionIn := SlotPos_B[i],\n        //CoordSystem := GVL.RB_B.COORD\n\t\tCoordSystem := SEL(\n\t\t\tGVL.B_MoveSlotItem[i].UseDirectPosition,\n\t\t\t//GVL.RB_B.COORD,\n\t\t\tSMC_COORD_SYSTEM.MCS,\n\t\t\tGVL.B_MoveSlotItem[i].DirectCoordSystem)\n\n    );\n\n\n    //--------------------------------------------------------\n    // MoveC\n    // Luôn gọi mỗi scan\n    //--------------------------------------------------------\n    fbMoveC_B[i](\n        Start :=\n            GVL.B_MoveSlotBusy[i]\n            AND\n            (GVL.B_MoveSlotCmd[i] = E_RobotCmd.CMD_MovC)\n            AND\n            GVL.B_MoveSlotStart[i],\n\n        AxisGroup := SCARA_B,\n        Item := GVL.B_MoveSlotItem[i],\n        MidPosition := SlotMidPos_B[i],\n        EndPosition := SlotEndPos_B[i],\n        //CoordSystem := GVL.RB_B.COORD\n\t\tCoordSystem := SMC_COORD_SYSTEM.MCS\n    );\n\n\n\t\n\n\n\n    //--------------------------------------------------------\n    // Chọn trạng thái trả về theo loại lệnh của slot\n    //--------------------------------------------------------\n    IF GVL.B_MoveSlotBusy[i] THEN\n\n        CASE GVL.B_MoveSlotCmd[i] OF\n\n            //================================================\n            // MOVP\n            //================================================\n            E_RobotCmd.CMD_MovP:\n\n                GVL.B_MoveSlotAccepted[i] :=\n                    fbMoveP_B[i].Accepted;\n\n                GVL.B_MoveSlotDone[i] :=\n                    fbMoveP_B[i].Done;\n\n                GVL.B_MoveSlotError[i] :=\n                    fbMoveP_B[i].Error;\n\n                GVL.B_MoveSlotErrorID[i] :=\n                    fbMoveP_B[i].ErrorID_Custom;\n\n\n            //================================================\n            // MOVL\n            //================================================\n            E_RobotCmd.CMD_MovL:\n\n                GVL.B_MoveSlotAccepted[i] :=\n                    fbMoveL_B[i].Accepted;\n\n                GVL.B_MoveSlotDone[i] :=\n                    fbMoveL_B[i].Done;\n\n                GVL.B_MoveSlotError[i] :=\n                    fbMoveL_B[i].Error;\n\n                GVL.B_MoveSlotErrorID[i] :=\n                    fbMoveL_B[i].ErrorID_Custom;\n\n\n            //================================================\n            // MOVC\n            //================================================\n            E_RobotCmd.CMD_MovC:\n\n                GVL.B_MoveSlotAccepted[i] :=\n                    fbMoveC_B[i].Accepted;\n\n                GVL.B_MoveSlotDone[i] :=\n                    fbMoveC_B[i].Done;\n\n                GVL.B_MoveSlotError[i] :=\n                    fbMoveC_B[i].Error;\n\n                GVL.B_MoveSlotErrorID[i] :=\n                    fbMoveC_B[i].ErrorID_Custom;\n\n        END_CASE;\n\n    END_IF;\n\nEND_FOR;\n\n\n//------------------------------------------------------------\n// GLOBAL MOTION ERROR MONITOR\n//\n// Kiểm tra tất cả Move Slot mỗi scan.\n// Giữ nguyên cơ chế MotionErrorPulse cũ để báo Interpreter.\n//------------------------------------------------------------\nIF NOT GVL.B_MotionErrorPulse THEN\n\n    FOR i := 1 TO 3 DO\n\n        IF GVL.B_MoveSlotBusy[i] AND GVL.B_MoveSlotError[i]\n        THEN\n\n            //--------------------------------------------\n            // MotionManager có lỗi\n            //--------------------------------------------\n            GVL.B_MotionManagerError := TRUE;\n\n            //--------------------------------------------\n            // Xung báo Interpreter\n            //--------------------------------------------\n            GVL.B_MotionErrorPulse := TRUE;\n\n            //--------------------------------------------\n            // Step gây lỗi\n            //--------------------------------------------\n            GVL.B_MotionErrorStep := GVL.B_MoveSlotItem[i].SourceStep;\n\n            //--------------------------------------------\n            // Error Code của FB\n            //--------------------------------------------\n            GVL.B_MotionErrorCode := GVL.B_MoveSlotErrorID[i];\n\n            //--------------------------------------------\n            // Có thể lưu thêm Slot để debug\n            //--------------------------------------------\n            GVL.B_MotionErrorSlot := i;\n\n            //--------------------------------------------\n            // Manager chuyển ERROR\n            //--------------------------------------------\n            GVL.B_MotionManagerState := 900;\n\n            EXIT;\n\n        END_IF;\n\n    END_FOR;\n\nEND_IF;\n\n// RELEASE SLOT WHEN DONE\nFOR i := 1 TO 3 DO\n\n    IF GVL.B_MoveSlotBusy[i]\n       AND GVL.B_MoveSlotDone[i]\n    THEN\n\n        // Báo Interpreter\n        GVL.B_MotionDoneStep :=\n            GVL.B_MoveSlotItem[i].SourceStep;\n\n        GVL.B_MotionDonePulse := TRUE;\n\n        // Release slot\n        GVL.B_MoveSlotStart[i] := FALSE;\n        GVL.B_MoveSlotBusy[i] := FALSE;\n        GVL.B_MoveSlotAccepted[i] := FALSE;\n        GVL.B_MoveSlotDone[i] := FALSE;\n        GVL.B_MoveSlotError[i] := FALSE;\n        GVL.B_MoveSlotErrorID[i] := 0;\n\n        GVL.B_MoveSlotCmd[i] :=\n            E_RobotCmd.CMD_NOP;\n\t\tGVL.B_MoveSlotReleasePending[i] := TRUE; // Set release = TRUE\n\t\t\n\t\t//------------------------------------------------\n\t\t// Motion đã thực sự rời pipeline\n\t\t//------------------------------------------------\n\t\tIF GVL.B_PipelineUsedCount > 0 THEN\n\t\t\tGVL.B_PipelineUsedCount :=\n\t\t\t\tGVL.B_PipelineUsedCount - 1;\n\t\tEND_IF;\n\t\n    END_IF;\nEND_FOR;\n\n//============================================================\n// RECALCULATE ACTIVE MOTION COUNT\n//\n// A_ActiveMotionCount luôn phản ánh đúng số slot Busy,\n// không phụ thuộc việc cộng/trừ có bị bỏ sót hay không.\n//============================================================\nActiveCountCalc := 0;\n\nFOR i := 1 TO 3 DO\n\n    IF GVL.B_MoveSlotBusy[i] THEN\n        ActiveCountCalc := ActiveCountCalc + 1;\n    END_IF;\n\nEND_FOR;\n\nGVL.B_ActiveMotionCount := ActiveCountCalc;\n\n\n\n\n//====================================================\n// FINALIZE MOTION MANAGER\n// Chỉ kết thúc khi Manager đã vào trạng thái WAIT\n// Không được reset State 10/20 khi vừa Pop lệnh.\n//====================================================\nIF (GVL.B_MotionManagerState = 30)\n   AND (GVL.B_MotionCount <= 0)\n   AND (GVL.B_ActiveMotionCount <= 0)\nTHEN\n\n    GVL.B_MotionManagerBusy := FALSE;\n    GVL.B_MotionManagerDone := TRUE;\n    GVL.B_MotionManagerState := 0;\n\nEND_IF;","LineInfoPersistence":"(string)40b13253-1602-4bbf-8802-853d2c04e0af_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)547"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}