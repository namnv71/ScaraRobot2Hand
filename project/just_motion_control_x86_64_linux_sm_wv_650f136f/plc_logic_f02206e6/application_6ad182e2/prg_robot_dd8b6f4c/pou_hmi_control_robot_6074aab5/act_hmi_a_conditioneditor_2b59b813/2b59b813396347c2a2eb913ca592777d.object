{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)2b59b813-3963-47c2-a2eb-913ca592777d","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_HMI_A_ConditionEditor","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//====================================================\n// PRG_HMI_A_ConditionEditor\n// Hiển thị danh sách condition + xử lý Load/Save/Edit\n//====================================================\n\n// Scroll danh sách condition\nIF GVL.HMI_A_CondCmd_Up THEN\n    GVL.HMI_A_CondCmd_Up := FALSE;\n    IF GVL.HMI_A_CondViewStart > 1 THEN\n        GVL.HMI_A_CondViewStart := GVL.HMI_A_CondViewStart - 1;\n    END_IF;\nEND_IF;\n\nIF GVL.HMI_A_CondCmd_Down THEN\n    GVL.HMI_A_CondCmd_Down := FALSE;\n    IF GVL.HMI_A_CondViewStart < 91 THEN\n        GVL.HMI_A_CondViewStart := GVL.HMI_A_CondViewStart + 1;\n    END_IF;\nEND_IF;\n\nIF GVL.HMI_A_CondCmd_PageUp THEN\n    GVL.HMI_A_CondCmd_PageUp := FALSE;\n    GVL.HMI_A_CondViewStart := GVL.HMI_A_CondViewStart - 10;\n    IF GVL.HMI_A_CondViewStart < 1 THEN\n        GVL.HMI_A_CondViewStart := 1;\n    END_IF;\nEND_IF;\n\nIF GVL.HMI_A_CondCmd_PageDown THEN\n    GVL.HMI_A_CondCmd_PageDown := FALSE;\n    GVL.HMI_A_CondViewStart := GVL.HMI_A_CondViewStart + 10;\n    IF GVL.HMI_A_CondViewStart > 91 THEN\n        GVL.HMI_A_CondViewStart := 91;\n    END_IF;\nEND_IF;\n\nIF GVL.HMI_A_CondCmd_GoTop THEN\n    GVL.HMI_A_CondCmd_GoTop := FALSE;\n    GVL.HMI_A_CondViewStart := 1;\nEND_IF;\n\nIF GVL.HMI_A_CondCmd_GoBot THEN\n    GVL.HMI_A_CondCmd_GoBot := FALSE;\n    GVL.HMI_A_CondViewStart := 91;\nEND_IF;\n\n\n//====================================================\n// Row Select\n//====================================================\n\nFOR i := 1 TO 10 DO\n    IF (GVL.HMI_A_CondSelectedCmd = i) THEN\n\t\tGVL.HMI_A_CondRowSelect[i] := TRUE;\n\t\tGVL.HMI_A_CondSelectedNo := i + GVL.HMI_A_CondViewStart - 1;\n\t\t//GVL.HMI_A_EditStepNo   := GVL.HMI_A_SelectedStepNo;\n\tELSE\n\t\tGVL.HMI_A_CondRowSelect[i] := FALSE;\n    END_IF;\nEND_FOR;\n\n// FOR i := 1 TO 10 DO\n//     IF GVL.HMI_A_CondRowSelect[i] THEN\n//         GVL.HMI_A_CondRowSelect[i] := FALSE;\n//         condNo := GVL.HMI_A_CondViewNo[i];\n// \n//         IF (condNo >= 1) AND (condNo <= 100) THEN\n//             GVL.HMI_A_CondSelectedNo := condNo;\n//             GVL.HMI_A_CondCmdReq := 1; // Load\n//         END_IF;\n//     END_IF;\n// END_FOR;\n\n\n//====================================================\n// Update View 10 dòng condition\n//====================================================\nFOR i := 1 TO 10 DO\n    condNo := GVL.HMI_A_CondViewStart + i - 1;\n\n    IF (condNo >= 1) AND (condNo <= 100) THEN\n        GVL.HMI_A_CondViewNo[i]     := condNo;\n        GVL.HMI_A_CondViewName[i]   := GVL_1.Condition_Cr_A[condNo].Name;\n        GVL.HMI_A_CondViewEnable[i] := GVL_1.Condition_Cr_A[condNo].Enable;\n        GVL.HMI_A_CondViewResult[i] := GVL_1.Condition_Cr_A[condNo].Result;\n    ELSE\n        GVL.HMI_A_CondViewNo[i]     := 0;\n        GVL.HMI_A_CondViewName[i]   := '';\n        GVL.HMI_A_CondViewEnable[i] := FALSE;\n        GVL.HMI_A_CondViewResult[i] := FALSE;\n    END_IF;\nEND_FOR;\n\n\n//====================================================\n// Command Load / Save / Clear / Copy / Paste\n//====================================================\nCASE GVL.HMI_A_CondCmdReq OF\n\n    1: // Load condition vào vùng Edit\n        condNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (condNo >= 1) AND (condNo <= 100) THEN\n            GVL.HMI_A_CondEditNo := condNo;\n            GVL.HMI_A_CondEditName := GVL_1.Condition_Cr_A[condNo].Name;\n            GVL.HMI_A_CondEditEnable := GVL_1.Condition_Cr_A[condNo].Enable;\n\n            FOR i := 1 TO 10 DO\n                GVL.HMI_A_CondEditRowEnable[i] := GVL_1.Condition_Cr_A[condNo].Row[i].Enable;\n                GVL.HMI_A_CondEditSource[i]    := GVL_1.Condition_Cr_A[condNo].Row[i].Source;\n                GVL.HMI_A_CondEditIndex[i]     := GVL_1.Condition_Cr_A[condNo].Row[i].Index;\n                GVL.HMI_A_CondEditOperator[i]  := GVL_1.Condition_Cr_A[condNo].Row[i].Operator;\n                GVL.HMI_A_CondEditSetValue[i]  := GVL_1.Condition_Cr_A[condNo].Row[i].SetValue;\n                GVL.HMI_A_CondEditLinkNext[i]  := GVL_1.Condition_Cr_A[condNo].Row[i].LinkNext;\n                //GVL.HMI_A_CondEditNote[i]      := GVL_1.Condition_Cr_A[condNo].Row[i].Note;\n            END_FOR;\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\n\n    2: // Save vùng Edit về bảng thật\n        condNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (condNo >= 1) AND (condNo <= 100) THEN\n            GVL_1.Condition_Cr_A[condNo].Name := GVL.HMI_A_CondEditName;\n            GVL_1.Condition_Cr_A[condNo].Enable := GVL.HMI_A_CondEditEnable;\n\n            FOR i := 1 TO 10 DO\n                GVL_1.Condition_Cr_A[condNo].Row[i].Enable   := GVL.HMI_A_CondEditRowEnable[i];\n                GVL_1.Condition_Cr_A[condNo].Row[i].Source   := GVL.HMI_A_CondEditSource[i];\n                GVL_1.Condition_Cr_A[condNo].Row[i].Index    := GVL.HMI_A_CondEditIndex[i];\n                GVL_1.Condition_Cr_A[condNo].Row[i].Operator := GVL.HMI_A_CondEditOperator[i];\n                GVL_1.Condition_Cr_A[condNo].Row[i].SetValue := GVL.HMI_A_CondEditSetValue[i];\n                GVL_1.Condition_Cr_A[condNo].Row[i].LinkNext := GVL.HMI_A_CondEditLinkNext[i];\n                //GVL_1.Condition_Cr_A[condNo].Row[i].Note     := GVL.HMI_A_CondEditNote[i];\n            END_FOR;\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\n\n    3: // Clear condition\n        condNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (condNo >= 1) AND (condNo <= 100) THEN\n            GVL_1.Condition_Cr_A[condNo].Enable := FALSE;\n            GVL_1.Condition_Cr_A[condNo].Name := '';\n\n            FOR i := 1 TO 10 DO\n                GVL_1.Condition_Cr_A[condNo].Row[i].Enable := FALSE;\n                GVL_1.Condition_Cr_A[condNo].Row[i].Source := 0;\n                GVL_1.Condition_Cr_A[condNo].Row[i].Index := 0;\n                GVL_1.Condition_Cr_A[condNo].Row[i].Operator := 0;\n                GVL_1.Condition_Cr_A[condNo].Row[i].SetValue := 0;\n                GVL_1.Condition_Cr_A[condNo].Row[i].LinkNext := 0;\n                //GVL_1.Condition_Cr_A[condNo].Row[i].Note := '';\n            END_FOR;\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\n\n    4: // Copy\n        condNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (condNo >= 1) AND (condNo <= 100) THEN\n            GVL.HMI_A_CondCopied := GVL_1.Condition_Cr_A[condNo];\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\n\n    5: // Paste\n        condNo := GVL.HMI_A_CondEditNo;\n\n        IF (condNo >= 1) AND (condNo <= 100) THEN\n            GVL_1.Condition_Cr_A[condNo] := GVL.HMI_A_CondCopied;\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 1; // Load lại lên Edit\n\n\n    6: // Delete Row\n        rowNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (rowNo >= 1) AND (rowNo <= 10) THEN\n            FOR i := rowNo TO 9 DO\n                GVL.HMI_A_CondEditRowEnable[i] := GVL.HMI_A_CondEditRowEnable[i + 1];\n                GVL.HMI_A_CondEditSource[i]    := GVL.HMI_A_CondEditSource[i + 1];\n                GVL.HMI_A_CondEditIndex[i]     := GVL.HMI_A_CondEditIndex[i + 1];\n                GVL.HMI_A_CondEditOperator[i]  := GVL.HMI_A_CondEditOperator[i + 1];\n                GVL.HMI_A_CondEditSetValue[i]  := GVL.HMI_A_CondEditSetValue[i + 1];\n                GVL.HMI_A_CondEditLinkNext[i]  := GVL.HMI_A_CondEditLinkNext[i + 1];\n                GVL.HMI_A_CondEditNote[i]      := GVL.HMI_A_CondEditNote[i + 1];\n            END_FOR;\n\n            GVL.HMI_A_CondEditRowEnable[10] := FALSE;\n            GVL.HMI_A_CondEditSource[10] := 0;\n            GVL.HMI_A_CondEditIndex[10] := 0;\n            GVL.HMI_A_CondEditOperator[10] := 0;\n            GVL.HMI_A_CondEditSetValue[10] := 0;\n            GVL.HMI_A_CondEditLinkNext[10] := 0;\n            GVL.HMI_A_CondEditNote[10] := '';\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\n\n    7: // Insert Row\n        rowNo := GVL.HMI_A_CondSelectedNo;\n\n        IF (rowNo >= 1) AND (rowNo <= 10) THEN\n            FOR i := 10 TO rowNo + 1 BY -1 DO\n                GVL.HMI_A_CondEditRowEnable[i] := GVL.HMI_A_CondEditRowEnable[i - 1];\n                GVL.HMI_A_CondEditSource[i]    := GVL.HMI_A_CondEditSource[i - 1];\n                GVL.HMI_A_CondEditIndex[i]     := GVL.HMI_A_CondEditIndex[i - 1];\n                GVL.HMI_A_CondEditOperator[i]  := GVL.HMI_A_CondEditOperator[i - 1];\n                GVL.HMI_A_CondEditSetValue[i]  := GVL.HMI_A_CondEditSetValue[i - 1];\n                GVL.HMI_A_CondEditLinkNext[i]  := GVL.HMI_A_CondEditLinkNext[i - 1];\n                GVL.HMI_A_CondEditNote[i]      := GVL.HMI_A_CondEditNote[i - 1];\n            END_FOR;\n\n            GVL.HMI_A_CondEditRowEnable[rowNo] := FALSE;\n            GVL.HMI_A_CondEditSource[rowNo] := 0;\n            GVL.HMI_A_CondEditIndex[rowNo] := 0;\n            GVL.HMI_A_CondEditOperator[rowNo] := 0;\n            GVL.HMI_A_CondEditSetValue[rowNo] := 0;\n            GVL.HMI_A_CondEditLinkNext[rowNo] := 0;\n            GVL.HMI_A_CondEditNote[rowNo] := '';\n        END_IF;\n\n        GVL.HMI_A_CondCmdReq := 0;\n\nEND_CASE;\n\n\n// PRG_A_ConditionScan -- PRG quét realtime kết quả Condition\nFOR i := 1 TO 100 DO\n    GVL_1.Condition_Cr_A[i].Result := F_EvalCondition_A(i);\nEND_FOR;\n\n//====================================================\n// CONDITION EDIT MONITOR\n// Khi bật Monitor, hiển thị ActualValue / RowResult / FinalResult\n// theo vùng đang edit, kể cả chưa Save\n//====================================================\n\nIF GVL.HMI_A_CondMonitorEnable THEN\n\n    firstRow := TRUE;\n    finalResult := FALSE;\n\n    FOR i := 1 TO 10 DO\n\n        IF GVL.HMI_A_CondEditRowEnable[i] THEN\n\n            rowResult := F_EvalCondRowFromEdit_A(i);\n\n            GVL.HMI_A_CondMonRowResult[i] := rowResult;\n\n            IF firstRow THEN\n                finalResult := rowResult;\n                firstRow := FALSE;\n            ELSE\n                CASE GVL.HMI_A_CondEditLinkNext[i - 1] OF\n                    1: finalResult := finalResult AND rowResult;\n                    2: finalResult := finalResult OR rowResult;\n                ELSE\n                    finalResult := finalResult AND rowResult;\n                END_CASE;\n            END_IF;\n\n        ELSE\n            GVL.HMI_A_CondMonActualValue[i] := 0;\n            GVL.HMI_A_CondMonRowResult[i] := FALSE;\n        END_IF;\n\n    END_FOR;\n\n    GVL.HMI_A_CondMonFinalResult := finalResult;\n\nELSE\n    GVL.HMI_A_CondMonFinalResult := FALSE;\n\n    FOR i := 1 TO 10 DO\n        GVL.HMI_A_CondMonActualValue[i] := 0;\n        GVL.HMI_A_CondMonRowResult[i] := FALSE;\n    END_FOR;\nEND_IF;","LineInfoPersistence":"(string)2b59b813-3963-47c2-a2eb-913ca592777d_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)290"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}