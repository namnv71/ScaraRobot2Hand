{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f1c9b309-fad4-4b30-81b9-b738d9416482","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)A1_Pick_T1_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Project_4_Delay_A1( PT := TO_TIME(GVL.Pro4_.ST_A.TDelay_pick_T1));\nIF Pick_A4_T1_Run THEN\n\tCASE PRO_A4_[1] OF\n\t\t0: // RESET\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\t\t\n\t\t\t\tProject_4_Delay_A.IN := FALSE;\t\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 5;\n\t\t5: // BF R PICK T1\n\t\t\tM_R_Mov(DATA:= 0, ID := 1, R_ := TRUE, X_ := FALSE, Y_ := FALSE, Z_ := FALSE);\n\t\t\t//M_CHOOSE_POS(DATA := 1, ID := 1, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 5;\t\t \n\t\t\tEND_IF;\t\t\t\n\t\t10: // BF Z PICK T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 1, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // BF XY PICK T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 1, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\tEND_IF;\n\t\t30: // CHECK ALLOW PICK MC1\n\t\t\tIF (GVL.Pro4_.Process.DATA_MC_TS = 3 OR GVL.Pro4_.Process.DATA_MC_TS = 4) AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q THEN\n\t\t\t//IF TRUE THEN\n\t\t\t\tchange_fac_vel_max_A := TRUE; //namnv0204\n\t\t\t\tchange_fac_vel_max_A_test := TRUE;\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\n\t\t\tEND_IF;\t\n\t\t40: // XY PICK T1\n\t\t\tchange_fac_vel_max_A := TRUE; //namnv0204\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 2, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n// \t\t\tIF NOT A4_Run_P THEN\n\t\t\tIF NOT A4_Run_P AND (GVL.Fac_Vel_Set_A = GVL.Pro4_.Auto.Fac_Vel_Max_A) THEN  //namnv0204\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\tEND_IF;\t\n\t\t50: // Z PICK T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 2, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2 PICK 1\n\t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Dry) THEN\n\t\t\t\tGVL.RB_A_.Tool_1 := TRUE;\n\t\t\tEND_IF;\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\tEND_IF;\n\t\t\n\t\t60: // ON VACUUM\n\t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Dry) THEN\n\t\t\t\tGVL.RB_A_.Tool_1 := TRUE;\n\t\t\tEND_IF;\n\t\t\tProject_4_Delay_A1.IN := TRUE;\n\t\t\tIF Project_4_Delay_A1.Q AND A_Allow_NextStep AND (GVL.RB_Signal_In.SS_RBA_Tool_1.Q OR GVL.Pro4_.ST_MC.Mode_Skip_ss_T1_A) THEN\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10; \t\n\t\t\tEND_IF;\n\t\t70: // BF Z PICK T1\n\t\t\tProject_4_Delay_A1.IN := FALSE;\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 1, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\tEND_IF;\n\t\t80: // BF XY PICK T1 Namnv\n// \t\t\tM_CHOOSE_POS(DATA := 1, ID := 1, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 1, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[1] := PRO_A4_[1] + 10;\t\t \n\t\t\t\tchange_fac_vel_max_A := FALSE; //namnv0204\n\t\t\t\tchange_fac_vel_max_A_test := FALSE;\n\t\t\tEND_IF\n\t\t\n\t\t90: // Done\n\t\t\t//  DATA_B_T1 := 3; // NG TS\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_TS = 3 THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 1;\n\t\t\tELSIF GVL.Pro4_.Process.DATA_MC_TS = 4 THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 3;\n\t\t\tEND_IF;\n\t\t\tProject_4_Delay_A.IN := FALSE;\n\t\t\tPick_A4_T1_Finish := TRUE;\n\t\t\tchange_fac_vel_max_A := FALSE; //namnv0204\n\t\t\tchange_fac_vel_max_A_test := FALSE;\n\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_A4_[1] := 0;\nEND_IF","LineInfoPersistence":"(string)f1c9b309-fad4-4b30-81b9-b738d9416482_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)168"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}