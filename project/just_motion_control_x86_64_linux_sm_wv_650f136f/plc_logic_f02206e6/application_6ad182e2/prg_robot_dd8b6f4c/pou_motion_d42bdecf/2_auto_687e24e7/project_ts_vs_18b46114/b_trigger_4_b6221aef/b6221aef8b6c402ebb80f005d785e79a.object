{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)b6221aef-8b6c-402e-bb80-f005d785e79a","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B_Trigger_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Trigger_Auto_Done(CLK:= GVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done);\nProject_4_Delay_B4(PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Vision_Align)*100);\nIF Trigger_B4_Run THEN\n\tCASE PRO_B4_[4] OF\n\t\t0: // RESET\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\t\n\t\t\t\t//Project_4_Delay_B4.in := FALSE;\t\t\n\t\t\t\tcount_Vs_Align := 0;  // namnv \n\t\t\t\tIF NOT GVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done THEN\n\t\t\t\t\tPRO_B4_[4] := PRO_B4_[4] + 10;\n\t\t\t\tEND_IF;\n\t\t10: // XY Vision\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 5, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 5 Vision Trigger\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[4] := PRO_B4_[4] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // Vision Z\n\t\t\t\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 5, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 5 vision\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[4] := PRO_B4_[4] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t30: // Trigger Vision\n\t\t\t// Ontrigger\n\t\t\tCASE D_Vision_Align_Ts OF\n\t\t\t\t0:\n\t\t\t\t\tIF GVL.Pro4_.ST_MC.Mode_Skip_VS_Align THEN\n\t\t\t\t\t\tD_Vision_Align_Ts := 30;\n\t\t\t\t\tELSE\n\t\t\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Vs_Align_On_Off := 1;\n\t\t\t\t\t\t\tProject_4_Delay_B4.IN := TRUE;\n\t\t\t\t\t\tIF GVL.Pro4_.Auto.Trigger_Vs_Align_On_Off = 1 AND Project_4_Delay_B4.q THEN\n\t\t\t\t\t\t\tD_Vision_Align_Ts := D_Vision_Align_Ts +10;\n\t\t\t\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\t\t\tEND_IF\n\n\t\t\t\t10:\n\t\t\t\t\tProject_4_Delay_B4.IN := FALSE;\n\t\t\t\t\tD_Vision_Align_Ts := D_Vision_Align_Ts +10;\n// \t\t\t\t\tIF GVL.Pro4_.Auto.Trigger_Vs_Align_On_Off = 0 THEN\n// \t\t\t\t\t\tcount_Vs_Align := count_Vs_Align +1;\n// \t\t\t\t\t\tD_Vision_Align_Ts := D_Vision_Align_Ts +10;\n// \t\t\t\t\tEND_IF\n\t\t\t\t20:\n\t\t\t\t\tIF GVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done THEN\n\t\t\t\t\t\tD_Vision_Align_Ts := D_Vision_Align_Ts +10;\n\t\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Vs_Align_On_Off := 0;\n\t\t\t\t\tELSIF NOT GVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done AND count_Vs_Align <= 5 THEN\n\t\t\t\t\t\tD_Vision_Align_Ts := 0;\n\t\t\t\t\t\tcount_Vs_Align := count_Vs_Align +1;\n\t\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Vs_Align_On_Off := 0;\n\t\t\t\t\tEND_IF\n\t\t\t\t30:\n\t\t\t\t\t// ok\t\n\t\t\tEND_CASE;\n\t\t\tIF count_Vs_Align > 5 AND (GVL.X[8] OR gvl.Pro4_.Process.Re_Trigger_VS_Align) THEN\n\t\t\t\tcount_Vs_Align := 0;\n\t\t\tEND_IF\n\t\t\tIF count_Vs_Align > 5 AND D_Vision_Align_Ts = 20 AND NOT GVL.Pro4_.Auto.Alarm_VS_Align  THEN\n\t\t\t\tGVL.Pro4_.Auto.Alarm_VS_Align := TRUE;\n\t\t\t\tGVL.Pro4_.Auto.Trigger_Vs_Align_On_Off := 0;\n\t\t\tELSIF GVL.Pro4_.Auto.Alarm_VS_Align AND GVL.Pro4_.Auto.comfirm_Reduct_Pro_NG_Vs_Align THEN\n\t\t\t\tcount_Vs_Align:=0;\n\t\t\t\tPRO_B4_[4] := 50; \t\n\t\t\tEND_IF\n\t\t\t\n\n\t\t\tIF D_Vision_Align_Ts = 30 AND A_Allow_NextStep  THEN\n\t\t\t\tcount_Vs_Align:=0;\n\t\t\t\tPRO_B4_[4] := PRO_B4_[4] + 10; \t\n\t\t\tEND_IF;\n\t\t\t\n\t\t40: // Z WAIT\n\t\t\t\n\t\t\tD_Vision_Align_Ts := 0;\n\t\t\tProject_4_Delay_B4.IN := FALSE;\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 0, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos wait\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[4] := PRO_B4_[4] + 10;\t\t \n\t\t\tEND_IF;\t\t\n\t\t50:\n\t\t\tIF GVL.Pro4_.Auto.comfirm_Reduct_Pro_NG_Vs_Align THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 0; // trigger Vision NG, bo hang ra\n\t\t\tELSE \n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 3; // trigger Vision OK\n\t\t\tEND_IF\n\t\t\tGVL.Pro4_.Auto.Alarm_VS_Align := FALSE;\n\t\t\tTrigger_B4_Finish := TRUE;\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_B4_[4] := 0;\nEND_IF\n\n\n// // ALLOW_PICK_CNV_4 := GVL.X[27];\n// IF Trigger_Cmd THEN\n// \tTrigger_Busy := TRUE;\n// \tGVL_2.Process3.Trigger := TRUE;\n// \t\n// \tIF GVL.MODBUS[100].5 THEN \n// \t\tGVL_2.Process3.Shape_T1 := 1;\n// \tELSIF GVL.MODBUS[100].6 THEN\n// \t\tGVL_2.Process3.Shape_T1 := 2;\n// \tELSIF GVL.MODBUS[100].7 THEN\n// \t\tGVL_2.Process3.Shape_T1 := 3;\t\n// \tELSIF GVL.MODBUS[100].8 THEN\n// \t\tGVL_2.Process3.Shape_T1 := 4;\n// \tELSE\n// \t\tGVL_2.Process3.Shape_T1 := 0;\n// \tEND_IF;\n// \t\n// \tIF GVL.MODBUS[100].12 THEN \n// \t\tGVL_2.Process3.Shape_T2 := 1;\n// \tELSIF GVL.MODBUS[100].13 THEN\n// \t\tGVL_2.Process3.Shape_T2 := 2;\n// \tELSIF GVL.MODBUS[100].14 THEN\n// \t\tGVL_2.Process3.Shape_T2 := 3;\t\n// \tELSIF GVL.MODBUS[100].15 THEN\n// \t\tGVL_2.Process3.Shape_T2 := 4;\n// \tELSE\n// \t\tGVL_2.Process3.Shape_T2 := 0;\n// \tEND_IF;\n// // \tGVL_2.pro3_B_get.Pos_Target_T1.X :=  GVL.Cam_T1.POS_X_RESULT + GVL_2.pro3_B_get.Pos_vision_T1_Offset.X;\n// // \tGVL_2.pro3_B_get.Pos_Target_T1.Y :=  GVL.Cam_T1.POS_Y_RESULT + GVL_2.pro3_B_get.Pos_vision_T1_Offset.Y;\n// // \tGVL_2.pro3_B_get.Pos_Target_T1.Z :=  GVL_2.pro3_B_get.Pos_vision_T1.Z + GVL_2.pro3_B_get.Pos_vision_T1_Offset.Z;\t\t\t\t\t \n// // \tGVL_2.pro3_B_get.Pos_Target_T1.A :=  GVL_2.pro3_B_get.Pos_vision_T1.A + GVL_2.pro3_B_get.Pos_vision_T1_Offset.A;\t\n// // \t\n// // \tGVL_2.pro3_B_get.Pos_Target_T2.X :=  GVL.Cam_T2.POS_X_RESULT + GVL_2.pro3_B_get.Pos_vision_T2_Offset.X;\n// // \tGVL_2.pro3_B_get.Pos_Target_T2.Y :=  GVL.Cam_T2.POS_Y_RESULT + GVL_2.pro3_B_get.Pos_vision_T2_Offset.Y;\n// // \tGVL_2.pro3_B_get.Pos_Target_T2.Z :=  GVL_2.pro3_B_get.Pos_vision_T2.Z + GVL_2.pro3_B_get.Pos_vision_T2_Offset.Z;\t\t\t\t \n// // \tGVL_2.pro3_B_get.Pos_Target_T2.A :=  GVL_2.pro3_B_get.Pos_vision_T2.A + GVL_2.pro3_B_get.Pos_vision_T2_Offset.A;\n// ELSE\n// \tGVL_2.Process3.Trigger := FALSE;\n// \tTrigger_Done := FALSE;\n// END_IF;\n\n// \tGVL_2.pro3_B_get.Pos_Target_T1.X :=  GVL.Cam_T1.POS_X_RESULT + GVL_2.pro3_B_get.Pos_vision_T1_Offset.X;\n// \tGVL_2.pro3_B_get.Pos_Target_T1.Y :=  GVL.Cam_T1.POS_Y_RESULT + GVL_2.pro3_B_get.Pos_vision_T1_Offset.Y;\n// \tGVL_2.pro3_B_get.Pos_Target_T1.Z :=  GVL_2.pro3_B_get.Pos_vision_T1.Z + GVL_2.pro3_B_get.Pos_vision_T1_Offset.Z;\t\t\t\t\t \n// \tGVL_2.pro3_B_get.Pos_Target_T1.A :=  GVL_2.pro3_B_get.Pos_vision_T1.A + GVL_2.pro3_B_get.Pos_vision_T1_Offset.A;\t\n// \t\n// \tGVL_2.pro3_B_get.Pos_Target_T2.X :=  GVL.Cam_T2.POS_X_RESULT + GVL_2.pro3_B_get.Pos_vision_T2_Offset.X;\n// \tGVL_2.pro3_B_get.Pos_Target_T2.Y :=  GVL.Cam_T2.POS_Y_RESULT + GVL_2.pro3_B_get.Pos_vision_T2_Offset.Y;\n// \tGVL_2.pro3_B_get.Pos_Target_T2.Z :=  GVL_2.pro3_B_get.Pos_vision_T2.Z + GVL_2.pro3_B_get.Pos_vision_T2_Offset.Z;\t\t\t\t \n// \tGVL_2.pro3_B_get.Pos_Target_T2.A :=  GVL_2.pro3_B_get.Pos_vision_T2.A + GVL_2.pro3_B_get.Pos_vision_T2_Offset.A;","LineInfoPersistence":"(string)b6221aef-8b6c-402e-bb80-f005d785e79a_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)183"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}