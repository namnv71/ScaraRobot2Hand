    BlockCount : UINT;                              // Tổng số Block.\n    BlockIndex : UINT;                              // Block hiện tại/Block cuối đã decode.\n    BlockDataCount : UINT;                          // Số record thực trong Block.\n    Checksum : UDINT;                               // Optional.\n    CaptureConveyorPos : REAL;                      // Encoder lúc chụp.\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)65eebfb0-4f39-4d68-a4e8-1fc2209a1d76_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)20"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}