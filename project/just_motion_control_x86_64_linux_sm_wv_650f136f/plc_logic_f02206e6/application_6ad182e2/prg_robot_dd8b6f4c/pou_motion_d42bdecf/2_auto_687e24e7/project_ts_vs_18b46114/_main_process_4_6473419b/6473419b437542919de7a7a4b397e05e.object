{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6473419b-4375-4291-9de7-a7a4b397e05e","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)_Main_Process_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Check Pos cmp\n\nB_Allow_NextStep := NOT GVL_2.Process3.Auto_Man_B OR nextstepRtrigB.Q;\nnextstepRtrigB(CLK := ( GVL_2.Process3.Auto_Man_B AND GVL_2.Process3.NextStep_B));\nA_Allow_NextStep := NOT GVL_2.Process3.Auto_Man_A OR nextstepRtrigA.Q;\nnextstepRtrigA(CLK := ( GVL_2.Process3.Auto_Man_A AND GVL_2.Process3.NextStep_A));\n// Clear Data\nIF NOT GVL.Pro4_.Process.Clear_Data THEN\n\t// ko làm gì\nELSE\n\tGVL.Pro4_.Process.DATA_MC_TS := 0;\n\tGVL.Pro4_.Process.DATA_MC_VS := 0;\n\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 0;\n\tGVL.Pro4_.Process.DATA_TOOL_A2_OUT := 0;\n\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 0;\n\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := 0;\t\nEND_IF\n\n\n\n// PROCESS \nIF Ena4 THEN\n// cv-ng\nCNV_NG();\t\n// Process MC1\nPro_MC1_4_();\n// Process MC2\nPro_MC2_4_();\t\n// trigger\nB_Trigger_4();\n////// process robot A\nA0_Wait_4();\nA1_Pick_T1_4();\nA2_Place_T1_OK_4();\nA3_Place_T1_NG_4();\nA4_Pick_T2_4();\nA5_Place_T2_OK_4();\nA6_Place_T2_NG_4();\nA7_Barcode_T1_4();\nA8_Place_T2_NG_TS_4();\n\tCASE Pro_A4 OF\n\t0: // INIT\n\t\t\t\n\t\t\tGVL.RB_A.COORD := 1;\n\t\t\tRBA_BufferMode := 0; \n\t \t\tWait_A4_Finish\t\t\t:= FALSE;\n\t\t\tPick_A4_T1_Finish \t\t:= FALSE;\n\t\t\tPick_A4_T2_Finish\t\t:= FALSE;\n\t\t\tBarcode_A4_Finish\t\t:= FALSE;\n\t\t\tPlace_OK_A4_T1_Finish \t:= FALSE;\n\t\t\tPlace_Ok_A4_T2_Finish \t:= FALSE;\n\t\t\tPlace_NG_A4_T1_Finish \t:= FALSE;\n\t\t\tPlace_NG_A4_T2_Finish \t:= FALSE;\n\t\t\tPlace_NG_TS_A4_T2_Finish\t:= FALSE;\n\t\t\t\n\t \t\tWait_A4_Run\t\t\t\t:= FALSE;\n\t\t\tPick_A4_T1_Run\t\t\t:= FALSE;\n\t\t\tPick_A4_T2_Run\t\t\t:= FALSE;\n\t\t\tBarcode_A4_Run\t\t\t:= FALSE;\n\t\t\tPlace_OK_A4_T1_Run\t \t:= FALSE;\n\t\t\tPlace_Ok_A4_T2_Run\t \t:= FALSE;\n\t\t\tPlace_NG_A4_T1_Run\t \t:= FALSE;\n\t\t\tPlace_NG_A4_T2_Run\t\t:= FALSE;\t\t\t\n\t\t\tPlace_NG_TS_A4_T2_Run\t:= FALSE;\t\n\t\t\tPro_A4_BF := 0; // namnv\n\t\t\tPro_A4 := Pro_A4 + 10; \n\t\t\t\n\t10: // CALL WAIT\t\n\t\tLOG_A.Write('Robot A to Wait');\t\n\t\tIF NOT Wait_A4_Run THEN\n\t\t\tRBA_BufferMode := 0;\n\t\t\tWait_A4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Wait_A4_Finish AND A_Allow_NextStep THEN\n\t\t\tWait_A4_Run := FALSE;\n\t\t\tPro_A4_BF := 10; // namnv\n\t\t\tPro_A4 := Pro_A4 + 10;\n\t\tEND_IF;\t\t\n\t20: // CHECK PICK OR PLACE T1\n\t\t\t\n\t\t \tWait_A4_Finish\t\t\t:= FALSE;\n\t\t\tPick_A4_T1_Finish \t\t:= FALSE;\n\t\t\tPick_A4_T2_Finish\t\t:= FALSE;\n\t\t\tBarcode_A4_Finish\t\t:= FALSE;\n\t\t\tPlace_OK_A4_T1_Finish \t:= FALSE;\n\t\t\tPlace_Ok_A4_T2_Finish \t:= FALSE;\n\t\t\tPlace_NG_A4_T1_Finish \t:= FALSE;\n\t\t\tPlace_NG_A4_T2_Finish \t:= FALSE;\n\t\t\tPlace_NG_TS_A4_T2_Finish \t:= FALSE;\n\t\t\t\n\t\t\tCASE GVL.Pro4_.Process.DATA_TOOL_A1_IN OF\n\t\t\t\t0: // none\n\t\t\t\t\tPro_A4 := 30; // Pick T1\n\t\t\t\t1: // Barcode\n\t\t\t\t\tPro_A4 := 40; // Barcode T1\n\t\t\t\t2: // Ok\n\t\t\t\t\tCASE GVL.Pro4_.Process.DATA_MC_VS OF\n\t\t\t\t\t\t2: \n\t\t\t\t\t\t\tPro_A4 := 50; // Place T1 OK => MC2\n\t\t\t\t\t\t3: \n\t\t\t\t\t\t\tPro_A4 := 25; // CHECK PICK OR PLACE T2\n\t\t\t\t\t\t4: \n\t\t\t\t\t\t\tPro_A4 := 25;\n\t\t\t\t\t\t5: \n\t\t\t\t\t\t\tPro_A4 := 25;\n\t\t\t\t\tEND_CASE;\n\t\t\t\t\t\n\t\t\t\t3: // NG\n\t\t\t\t\t// Pro_A4 := 60;\t\n\t\t\t\t\t// namnv NG cung van dat vao may Vision\n\t\t\t\t\tCASE GVL.Pro4_.Process.DATA_MC_VS OF\n\t\t\t\t\t\t2: \n\t\t\t\t\t\t\tPro_A4 := 50; // Place T1 NG => MC2\n\t\t\t\t\t\t3: \n\t\t\t\t\t\t\tPro_A4 := 25; // CHECK PICK OR PLACE T2\n\t\t\t\t\t\t4: \n\t\t\t\t\t\t\tPro_A4 := 25;\n\t\t\t\t\t\t\t//namnv\n\t\t\t\t\t\t5: \n\t\t\t\t\t\t\tPro_A4 := 25;\t\n\t\t\t\t\t\t\t\n\t\t\t\t\tEND_CASE;\n\t\t\t\t\t\n\t\t\tEND_CASE\n\t\t\t// Pro_A4_BF := 20; // namnv\n\t25: // CHECK PICK OR PLACE T2\n\t\t\tCASE GVL.Pro4_.Process.DATA_TOOL_A2_OUT OF\n\t\t\t\t0: // none\n\t\t\t\t\tPro_A4 := 70; // pick T2\n\t\t\t\t1: // have\n\t\t\t\t\t//Pro_B3 := 80; // Place OK CNV\n\t\t\t\t2: // OK\n\t\t\t\t\tPro_A4 := 80; // Place OK CNV\n\t\t\t\t3: // NG - VS\n\t\t\t\t\tPro_A4 := 90; // Place NG-VS CNV\n\t\t\t\t// namnv\n\t\t\t\t4: // NG - TS\n\t\t\t\t\tPro_A4 := 100; // Place NG-TS CNV\n\t\t\tEND_CASE\t\n\t\t\t// Pro_A4_BF := 25; // namnv\t\n\t30: // Pick T1\n\t\t //DATA_MC1 := 3;\n\t\t LOG_A.Write('Robot A Pick T1');\n// \t\tIF NOT Pick_A4_T1_Run  AND (GVL.Pro4_.Process.DATA_MC_TS = 3 OR GVL.Pro4_.Process.DATA_MC_TS = 4) THEN\n\t\t//IF NOT Pick_B3_T1_Run THEN\t\n\t\t// namnv0204\n\t\tIF NOT Pick_A4_T1_Run  AND (GVL.Pro4_.Process.DATA_MC_TS = 3 OR GVL.Pro4_.Process.DATA_MC_TS = 4 OR GVL.Pro4_.Process.DATA_MC_TS = 1) THEN\n\t\t\tRBA_BufferMode := 0;\n\t\t\tPick_A4_T1_Run := TRUE;\n\t\tELSIF NOT Pick_A4_T1_Run AND GVL.Pro4_.Process.DATA_MC_TS <> 3 AND GVL.Pro4_.Process.DATA_MC_TS <> 4 AND GVL.Pro4_.Process.DATA_MC_TS <> 1 THEN\n\t\t\tPro_A4 := 25;\n\t\t\tPro_A4_BF := 30; // namnv\n\t\tEND_IF\n\t\tIF Pick_A4_T1_Finish AND A_Allow_NextStep THEN\n\t\t\tPick_A4_T1_Run := FALSE;\n\t\t\t// Pro_A4 := 40;\n\t\t\t// namnv - khong cho di ra barcode luon\n\t\t\tPro_A4 := 20;\n\t\t\tPro_A4_BF := 30; // namnv\n\t\tEND_IF;\n\t\t\n\t40: // Barcode T1\n\t\tLOG_A.Write('Robot A barcode T1');\n\t\tIF NOT Barcode_A4_Run THEN\n\t\t\tRBA_BufferMode := 0;\n\t\t\tBarcode_A4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Barcode_A4_Finish AND A_Allow_NextStep THEN\n\t\t\tBarcode_A4_Run := FALSE;\n\t\t\t// Pro_A4 := 10;\n\t\t\tPro_A4 := 20;  // Khong cho chay ve wait nua  Namnv\n\t\t\tPro_A4_BF := 40; // namnv\n\t\tEND_IF;\t\t\n\t\t\n\t50: // Place T1 OK/NG => MC2\n\t\t//DATA_MC2 := 2;\n\t\tLOG_A.Write('Robot A Place T1 OK');\n\t\tRBA_BufferMode := 1;\n\t\tIF NOT Place_OK_A4_T1_Run AND GVL.Pro4_.Process.DATA_MC_VS = 2 THEN\n\t\n\t\t\tPlace_OK_A4_T1_Run := TRUE;\n\t\tEND_IF\n\t\tIF Place_OK_A4_T1_Finish AND A_Allow_NextStep THEN\n\t\t\tPlace_OK_A4_T1_Run := FALSE;\n\t\t\tPro_A4 := 25;\n\t\t\tPro_A4_BF := 50; // namnv\n\t\tEND_IF;\t\n\t\t\n\t60: // Place T1 NG => CNV TS NG\n// \t\tIF NOT Place_NG_A4_T1_Run  THEN\n// \t\t\tRBA_BufferMode := 1;\n// \t\t\tPlace_NG_A4_T1_Run := TRUE;\n// \t\tEND_IF\n// \t\tIF Place_NG_A4_T1_Finish AND A_Allow_NextStep THEN\n// \t\t\tPlace_NG_A4_T1_Run := FALSE;\n// \t\t\tPro_A4 := 10;\n// \t\t\tPro_A4_BF := 60; // namnv\n// \t\tEND_IF;\t\t\t\n\t\t\n\t\t\t\t\n\t\t\n\t70: // PICK T2\n\t\t//DATA_MC2 := 3;\n\t\t//IF NOT Pick_A4_T2_Run  AND ( GVL.Pro4_.Process.DATA_MC_VS = 3 OR GVL.Pro4_.Process.DATA_MC_VS = 4 ) THEN\n\t\tLOG_A.Write('Robot A Pick T2');\n\t\tIF NOT Pick_A4_T2_Run  AND ( GVL.Pro4_.Process.DATA_MC_VS = 3 OR GVL.Pro4_.Process.DATA_MC_VS = 4 OR GVL.Pro4_.Process.DATA_MC_VS = 5 ) THEN\n\t\t\tRBA_BufferMode := 1;\n\t\t\tPick_A4_T2_Run := TRUE;\n\t\tELSIF NOT Pick_A4_T2_Run AND( GVL.Pro4_.Process.DATA_MC_VS = 1 OR GVL.Pro4_.Process.DATA_MC_VS = 2) AND ( GVL.Pro4_.Process.DATA_MC_TS = 1 OR GVL.Pro4_.Process.DATA_MC_TS = 3 OR GVL.Pro4_.Process.DATA_MC_TS = 4 ) THEN\n\t\t\tPro_A4 := 10;\n\t\t\tPro_A4_BF := 70; // namnv\n\t\tEND_IF\n\t\tIF Pick_A4_T2_Finish AND A_Allow_NextStep THEN\n\t\t\tPick_A4_T2_Run := FALSE;\n\t\t\tPro_A4 := 20;\n\t\t\tPro_A4_BF := 70; // namnv\n\t\tEND_IF;\t\n\t\t\n\t 80: // PLACE T2 OK => CNV OK\n\t\t LOG_A.Write('Robot A Place T2 OK');\n\t\tIF NOT Place_Ok_A4_T2_Run   THEN\n\t\t\tPlace_Ok_A4_T2_Run := TRUE;\n\t\tEND_IF\n\t\tIF Place_Ok_A4_T2_Finish AND A_Allow_NextStep THEN\n\t\t\tPlace_Ok_A4_T2_Run := FALSE;\n\t\t\tPro_A4 := 10;\n\t\t\tPro_A4_BF := 80; // namnv\n\t\t\t//GVL.Pro4_.Auto.Nb_Pro_OK := GVL.Pro4_.Auto.Nb_Pro_OK + 1; \n\t\t\t// namnv1104\n\t\t\tNb_NG_TS_Cur := 0;\n\t\t\tNb_NG_VS_Cur := 0;\n\t\tEND_IF;\t\t \n\t\t\n\t 90: // PLACE T2 NG => CNV NG VS\n\t\t LOG_A.Write('Robot A Place T2 NG');\n\t\tIF NOT Place_NG_A4_T2_Run  THEN\n\t\t\tPlace_NG_A4_T2_Run := TRUE;\n\t\tEND_IF\n\t\tIF Place_NG_A4_T2_Finish AND A_Allow_NextStep THEN\n\t\t\tPlace_NG_A4_T2_Run := FALSE;\n// \t\t\tPro_A4 := 10;\n// \t\t\tPro_A4_BF := 90; // namnv\n\t\t\t//GVL.Pro4_.Auto.Nb_Pro_NG := GVL.Pro4_.Auto.Nb_Pro_NG + 1;\n\t\t\t// namnv1104\n\t\t\tIF Nb_NG_VS_Cur < GVL.Pro4_.Auto.Nb_NG_VS_Limit THEN\n\t\t\t\tNb_NG_VS_Cur := Nb_NG_VS_Cur + 1;\n\t\t\tEND_IF\n\t\t\t\t\n\t\t\tIF (Nb_NG_VS_Cur >= GVL.Pro4_.Auto.Nb_NG_VS_Limit) THEN\n\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_VS := TRUE;\n\t\t\tELSE\n\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_VS := FALSE;\n\t\t\tEND_IF\n\t\t\tIF (Nb_NG_VS_Cur < GVL.Pro4_.Auto.Nb_NG_VS_Limit) OR GVL.ConfirmNG_VS THEN\n\t\t\t\tPro_A4 := 10;\n\t\t\t\tPro_A4_BF := 90; // namnv\n\t\t\t\tIF GVL.ConfirmNG_VS THEN\n\t\t\t\t\tNb_NG_VS_Cur := 0;\n\t\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_VS := FALSE;\n\t\t\t\tEND_IF\n\t\t\t\tGVL.ConfirmNG_VS := FALSE;\n\t\t\tEND_IF\n\t\tEND_IF;\t\t\n\t\n\t// namnv - them chu trinh tha hang NG Test song tu may VS\t\n\t 100:\n\t \tLOG_A.Write('Robot A Place T1 TS NG');\n\t\tIF NOT Place_NG_TS_A4_T2_Run  THEN\n\t\t\tPlace_NG_TS_A4_T2_Run := TRUE;\n\t\tEND_IF\n\t\tIF Place_NG_TS_A4_T2_Finish AND A_Allow_NextStep THEN\n\t\t\tPlace_NG_TS_A4_T2_Run := FALSE;\n// \t\t\tPro_A4 := 10;\n// \t\t\tPro_A4_BF := 100; // namnv\n\t\t\t\n\t\t\t// GVL.Pro4_.Auto.Nb_Pro_NG := GVL.Pro4_.Auto.Nb_Pro_NG + 1;\n\t\t\t// namnv1104\n\t\t\tIF Nb_NG_TS_Cur < GVL.Pro4_.Auto.Nb_NG_TS_Limit THEN\n\t\t\t\tNb_NG_TS_Cur := Nb_NG_TS_Cur + 1;\n\t\t\tEND_IF\n\t\t\tIF (Nb_NG_TS_Cur >= GVL.Pro4_.Auto.Nb_NG_TS_Limit) THEN\n\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_TS := TRUE;\n\t\t\tELSE\n\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_TS := FALSE;\n\t\t\tEND_IF\n\t\t\tIF (Nb_NG_TS_Cur < GVL.Pro4_.Auto.Nb_NG_TS_Limit) OR GVL.ConfirmNG_TS THEN\n\t\t\t\tPro_A4 := 10;\n\t\t\t\tPro_A4_BF := 100; // namnv\n\t\t\t\tIF GVL.ConfirmNG_TS THEN\n\t\t\t\t\tNb_NG_TS_Cur := 0;\n\t\t\t\t\tGVL.Alarm_P4.Alarm_Limit_NG_TS := FALSE;\n\t\t\t\tEND_IF\n\t\t\t\tGVL.ConfirmNG_VS := FALSE;\n\t\t\t\t\n\t\t\tEND_IF\n\t\tEND_IF;\n \t\n\t\t\n\tEND_CASE\n///////////////////////////////////////////////////////////////////////////////// RB A\t\nB0_wait_4();\nB1_Pick_T1_4();\nB2_PLace_T1_4();\nB3_Barcode_4();\nIF PRO_B4_[1] = 30 OR PRO_B4_[2] = 60 OR PRO_B4_[3] = 30 THEN  Project_4_Delay_B(IN:= TRUE, PT := T#1S); END_IF;\n\n  CASE Pro_B4 OF\n\t0: // INIT\n\t\t\t\n\t\t\tGVL.RB_B.COORD := 1;\n\t\t\t// GVL.Pro4_.ST_MC.Mode_Dry := FALSE;\n\t \t\tWait_B4_Finish\t\t:= FALSE;\n\t\t\tPick_B4_Finish \t\t:= FALSE;\n\t\t\tBarcode_B4_Finish \t:= FALSE;\n\t\t\tPlace_B4_Finish\t\t:= FALSE;\n\t\t\tTrigger_B4_Finish\t:= FALSE;\n\t\t\tWait_B4_Run\t\t\t:= FALSE;\n\t\t\tPick_B4_Run\t\t\t:= FALSE;\n\t\t\tBarcode_B4_Run \t\t:= FALSE;\n\t\t\tPlace_B4_Run\t\t:= FALSE;\n\t\t\tTrigger_B4_Run\t\t:= FALSE;\n\t\t\tGVL.Pro4_.Auto.comfirm_Reduct_Pro := FALSE;\n\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode := FALSE;\n\t\t\tPro_B4 := Pro_B4 + 10; \n\t\t\n\t10: // CALL WAIT\t\n\t\tLOG_B.Write('Robot B to Wait');\t\t\n\t\tIF NOT Wait_B4_Run THEN\n\t\t\tWait_B4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Wait_B4_Finish AND B_Allow_NextStep THEN\n\t\t\tWait_B4_Run := FALSE;\n\t\t\tPro_B4 := Pro_B4 + 10;\n\t\tEND_IF;\t\t\n\t20: // CHECK PICK OR PLACE\n\t\t\tWait_B4_Finish\t\t:= FALSE;\n\t\t\tPick_B4_Finish \t\t:= FALSE;\n\t\t\tBarcode_B4_Finish \t:= FALSE;\n\t\t\tPlace_B4_Finish\t\t:= FALSE;\n\t\tCASE GVL.Pro4_.Process.DATA_TOOL_B1_IN OF\n\t\t\t0: // none\n\t\t\t\tPro_B4 := 30;\n\t\t\t1: // Have - Trigger Vision\n\t\t\t\tIF NOT GVL.Pro4_.ST_MC.Mode_Skip_VS_Align THEN\n\t\t\t\t\tPro_B4  := 35;\n\t\t\t\tELSE\n\t\t\t\t\tPro_B4 := 40;\n\t\t\t\tEND_IF;\n\t\t\t2: // Barcode Done To Place\n\t\t\t\tPro_B4  := 50;\n\t\t\t3: // Trigger Done - To Barcode\n\t\t\t\tPro_B4 := 40;\n\t\tEND_CASE\n\t30: // Pick \n\t\tLOG_B.Write('Robot B Pick T1');\n// \t\tIF GVL.Pro4_.Signal_In.T_Cv_In_1.q = TRUE OR GVL.Pro4_.ST_MC.Mode_Dry THEN\n// \t\t\tGVL.Pro4_.Auto.Lighting_On_Off := TRUE;\n// \t\t\ton_Cam(IN := TRUE, PT := T#500MS, Q =>, ET =>);\n// \t\t\tIF on_Cam.Q THEN\n// \t\t\t\tGVL_2.Process3.Trigger := TRUE;\n// \t\t\t\tALLOW_PICK_CNV := TRUE;\n// \t\t\tEND_IF\n// \t\tELSE\n// \t\t\tGVL_2.Process3.Trigger := FALSE;\n// \t\t\tALLOW_PICK_CNV := FALSE;\n// \t\t\tGVL.Pro4_.Auto.Lighting_On_Off := FALSE;\n// \t\tEND_IF;\n\t\tIF GVL.Pro4_.Signal_In.T_Cv_In_1.q = TRUE OR GVL.Pro4_.ST_MC.Mode_Dry THEN\n\t\t\tALLOW_PICK_CNV := TRUE;\n\t\tELSE\n\t\t\tALLOW_PICK_CNV := FALSE;\n\t\tEND_IF;\n\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Skip_VS_Align) THEN\n\t\t\tGVL.Pro4_.Auto.Lighting_On_Off := TRUE;\n\t\tEND_IF;\n\t\tIF NOT Pick_B4_Run  AND ALLOW_PICK_CNV THEN\n\t\t\ton_Cam.IN := FALSE;\n\t\t\tPick_B4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Pick_B4_Finish AND B_Allow_NextStep THEN\n\t\t\tPick_B4_Run := FALSE;\n\t\t\tPro_B4 := 20;\n\t\t\t\n\t\tEND_IF;\n\t35: // Trigger vision\n\t\tLOG_B.Write('Robot B Trigger Vision T1');\n\t\tIF NOT Trigger_B4_Run THEN\n\t\t\tTrigger_B4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Trigger_B4_Finish AND B_Allow_NextStep THEN\n\t\t\tTrigger_B4_Run := FALSE;\n\n\t\t\tPro_B4 := 20; /// ok Trigger >> Doc Barcode\n\t\t\tGVL.Pro4_.Auto.Lighting_On_Off := FALSE;\n\t\tEND_IF;\t\n\t40: // Barcode\n\t\tLOG_B.Write('Robot B Barcode T1');\n\t\tIF NOT Barcode_B4_Run THEN\n\t\t\tBarcode_B4_Run := TRUE;\n\t\tEND_IF\n\t\tIF Barcode_B4_Finish AND B_Allow_NextStep THEN\n\t\t\tBarcode_B4_Run := FALSE;\n\t\t\tGVL.Pro4_.Auto.comfirm_Reduct_Pro := FALSE;\n\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode := FALSE;\n\t\t\tPro_B4 := 20; /// ok barcode >> place Ts\n\t\tEND_IF;\t\t\n\t50: // Place\n\t\tLOG_B.Write('Robot B PLace T1');\n\t\t//DATA_MC1 := 2;\n\t\t// IF NOT Place_B4_Run AND GVL.Pro4_.Process.DATA_MC_TS = 2 THEN\n\t\tIF NOT Place_B4_Run AND (GVL.Pro4_.Process.DATA_MC_TS = 2 OR GVL.Pro4_.Process.DATA_MC_TS = 1) THEN\n\t\t\tPlace_B4_Run := TRUE;\t\n\t\tEND_IF\n\t\tIF Place_B4_Finish AND B_Allow_NextStep THEN\n\t\t\tPlace_B4_Run := FALSE;\n\t\t\tPro_B4 := 0;\n\t\tEND_IF;\t\t\n   END_CASE\n\nELSIF NOT Ena4 THEN\n\n\t\n\tGVL.Pro4_.Auto.centering_ts_On_Off  := FALSE;\n\tGVL.Pro4_.Auto.Lighting_On_Off := FALSE;\n\tD_Barcode_Ts := 0;\n\tD_Barcode_vs := 0;\n\tPro_B4 \t\t:= 0;\n\tPro_A4\t\t:= 0;\n\tPro_MC1_4\t:= 0;\n\tPro_MC2_4\t:= 0;\n\tB4_Run_L \t:= FALSE;\t\n\tB4_Run_P \t:= FALSE;\n\tA4_Run_L\t:= FALSE;\n\tA4_Run_P \t:= FALSE;\n\tPRO_B4_ [0] := 0;\n\tPRO_B4_ [1] := 0;\n\tPRO_B4_ [2] := 0;\n\tPRO_B4_ [3] := 0;\n\tPRO_B4_ [4] := 0;\n\tPRO_B4_ [5] := 0;\n\tPRO_B4_ [6] := 0;\n\tPRO_B4_ [7] := 0;\n\tPRO_B4_ [8] := 0;\n\tPRO_B4_ [9] := 0;\n\t\n\tPRO_A4_ [0] := 0;\n\tPRO_A4_ [1] := 0;\n\tPRO_A4_ [2] := 0;\n\tPRO_A4_ [3] := 0;\n\tPRO_A4_ [4] := 0;\n\tPRO_A4_ [5] := 0;\n\tPRO_A4_ [6] := 0;\n\tPRO_A4_ [7] := 0;\n\tPRO_A4_ [8] := 0;\n\tPRO_A4_ [9] := 0;\n\t\nEND_IF\t \n{endregion}","LineInfoPersistence":"(string)6473419b-4375-4291-9de7-a7a4b397e05e_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)458"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}