{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)POU_MOTION","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1.FB Main\"}\nGVL.Fac_Vel_Slow := 0.03;\n// GVL.Fac_Vel_Max_A := 0.4;\n// GVL.Fac_Acc_Max_A := 0.4;\n// GVL.Fac_Jerk_Max_A := 0.4;\t \n// GVL.Fac_Vel_Max_B := 0.4;\n// GVL.Fac_Acc_Max_B := 0.4;\n// GVL.Fac_Jerk_Max_B := 0.4;\n// \t \n// GVL.Fac_Vel_Max_A := GVL_1.DATA_RB_A.Fac_Vel;\n// GVL.Fac_Acc_Max_A := GVL_1.DATA_RB_A.Fac_Acc;\n// GVL.Fac_Jerk_Max_A := GVL_1.DATA_RB_A.Fac_Jerk;\t \n// GVL.Fac_Vel_Max_B := GVL_1.DATA_RB_B.Fac_Vel;\n// GVL.Fac_Acc_Max_B := GVL_1.DATA_RB_B.Fac_Acc;\n// GVL.Fac_Jerk_Max_B := GVL_1.DATA_RB_B.Fac_Jerk;\n\n\t \nIF GVL.RB_A.Auto THEN\t \n\tIF NOT change_fac_vel_A AND NOT change_fac_vel_max_A_test THEN\t \n\t\tGVL.Fac_Vel_Set_A := GVL_1.DATA_RB_A.Fac_Vel;\n\t\tGVL.Fac_Acc_Set_A := GVL_1.DATA_RB_A.Fac_Acc;\n\t\tGVL.Fac_Jerk_Set_A := GVL_1.DATA_RB_A.Fac_Jerk;\n\t\tGVL.Fac_Torque_Set_A := GVL_1.DATA_RB_A.Fac_Torque;\n\tELSE\n\t\tIF change_fac_vel_A THEN\n\t\t\tGVL.Fac_Vel_Set_A := GVL.Fac_Vel_Slow;\n\t\t\tGVL.Fac_Acc_Set_A := GVL_1.DATA_RB_A.Fac_Acc;\n\t\t\tGVL.Fac_Jerk_Set_A := GVL_1.DATA_RB_A.Fac_Jerk;\n\t\t\tGVL.Fac_Torque_Set_A := GVL_1.DATA_RB_A.Fac_Torque;\n\t\tEND_IF;\n\t\tIF change_fac_vel_max_A_test THEN\n\t\t\tGVL.Fac_Vel_Set_A := GVL.Pro4_.Auto.Fac_Vel_Max_A;\t \n\t\t\tGVL.Fac_Acc_Set_A := GVL.Pro4_.Auto.Fac_Acc_Max_A;\n\t\t\tGVL.Fac_Jerk_Set_A := GVL.Pro4_.Auto.Fac_Jerk_Max_A;\n\t\tEND_IF;\n\tEND_IF;\nELSE\n\tGVL.Fac_Vel_Set_A := GVL_1.DATA_RB_A.Fac_Vel_Man;\n\tGVL.Fac_Acc_Set_A := GVL_1.DATA_RB_A.Fac_Acc_Man;\n\tGVL.Fac_Jerk_Set_A := GVL_1.DATA_RB_A.Fac_Jerk_Man;\n\tGVL.Fac_Torque_Set_A := GVL_1.DATA_RB_A.Fac_Torque; \nEND_IF\n\nIF GVL.RB_B.Auto THEN\t\t \n\tIF NOT change_fac_vel_B AND NOT change_fac_vel_max_B THEN\t \n\t\tGVL.Fac_Vel_Set_B := GVL_1.DATA_RB_B.Fac_Vel;\n\t\tGVL.Fac_Acc_Set_B := GVL_1.DATA_RB_B.Fac_Acc;\n\t\tGVL.Fac_Jerk_Set_B := GVL_1.DATA_RB_B.Fac_Jerk;\n\t\tGVL.Fac_Torque_Set_B := GVL_1.DATA_RB_B.Fac_Torque;\n\tELSE\n\t\tIF change_fac_vel_B THEN\n\t\t\tGVL.Fac_Vel_Set_B := GVL.Fac_Vel_Slow;\n\t\t\tGVL.Fac_Acc_Set_B := GVL_1.DATA_RB_B.Fac_Acc;\n\t\t\tGVL.Fac_Jerk_Set_B := GVL_1.DATA_RB_B.Fac_Jerk;\t\n\t\t\tGVL.Fac_Torque_Set_B := GVL_1.DATA_RB_B.Fac_Torque; \n\t\tEND_IF;\n\t\tIF change_fac_vel_max_B THEN\n\t\t\tGVL.Fac_Vel_Set_B := GVL.Pro4_.Auto.Fac_Vel_Max_B;\t \n\t\t\tGVL.Fac_Acc_Set_B := GVL.Pro4_.Auto.Fac_Acc_Max_B;\n\t\t\tGVL.Fac_Jerk_Set_B := GVL.Pro4_.Auto.Fac_Jerk_Max_B;\n\t\tEND_IF\n\tEND_IF\nELSE\n\tGVL.Fac_Vel_Set_B := GVL_1.DATA_RB_B.Fac_Vel_Man;\n\tGVL.Fac_Acc_Set_B := GVL_1.DATA_RB_B.Fac_Acc_Man;\n\tGVL.Fac_Jerk_Set_B := GVL_1.DATA_RB_B.Fac_Jerk_Man;\n\tGVL.Fac_Torque_Set_B := GVL_1.DATA_RB_B.Fac_Torque_Man;\t \nEND_IF\n\t \n// IF NOT change_fac_vel_max_B THEN\n// \tGVL.Fac_Vel_Set_B := GVL_1.DATA_RB_B.Fac_Vel;\n// \tGVL.Fac_Acc_Set_B := GVL_1.DATA_RB_B.Fac_Acc;\n// \tGVL.Fac_Jerk_Set_B := GVL_1.DATA_RB_B.Fac_Jerk;\n// ELSE\n// \tGVL.Fac_Vel_Set_B := GVL.Pro4_.Auto.Fac_Vel_Max_B;\t \n// \tGVL.Fac_Acc_Set_B := GVL.Pro4_.Auto.Fac_Acc_Max_B;\n// \tGVL.Fac_Jerk_Set_B := GVL.Pro4_.Auto.Fac_Jerk_Max_B;\n// END_IF\n\t \n//namnv0104\nIF GVL.Pro4_.Signal_In.T_Cv_NG_out_full.Q THEN\n\tGVL.Pro4_.Auto.NG_CV_Full_Pro := TRUE;\nELSE\n\tGVL.Pro4_.Auto.NG_CV_Full_Pro := FALSE;\nEND_IF;\nM_reset();\nMOVC(); MOVL(); \t \t  \nMOVP(); \n\nACT_Excute_Run(); // Bit Controll\nACT_GO_Pos_Manual(); // set điểm & call\nACT_GO_Pos_Auto(); // Auto\n\nIF GVL.MB_[6] THEN\n\tGVL.RB_A_.Tool_1 := FALSE;\n\tGVL.RB_B_.Tool_1 := FALSE;\nEND_IF;\t \n{endregion}\n{region \"2. PRAMETER\"}\n/// Tham so\n// RBA_BufferMode := 0; \n// RBA_BufferMode := MC_BUFFER_MODE.Aborting; \nRBA_OrientationMode := SM3_Robotics.SMC_ORIENTATION_MODE.Axis; // 0 : axis- 1: cicle\nRBA_TransitionMode := SM3_Robotics.MC_TRANSITION_MODE.TMNone;\n\t \n\t \n//RBB_BufferMode := 0;\n//RBB_BufferMode := SM3_Robotics.MC_BUFFER_MODE.Aborting; \nRBB_OrientationMode := SM3_Robotics.SMC_ORIENTATION_MODE.Axis;\nRBB_TransitionMode := SM3_Robotics.MC_TRANSITION_MODE.TMNone;\n\t \n{endregion}\n{region \"3. POS_MAN OR AUTO\"}\n/// Manual or Auto 1\nIF GVL.RB_A.Manual AND NOT GVL.RB_A.Auto THEN\n\tPos_Run_A := Pos_run_manual_A;\nELSIF NOT GVL.RB_A.Manual AND GVL.RB_A.Auto THEN\n\tPos_Run_A := Pos_run_auto_A;\nELSE\n\tPos_Run_A := Pos_0;\nEND_IF;\n/// Manual or Auto 2\nIF GVL.RB_B.Manual AND NOT GVL.RB_B.Auto THEN\n\tPos_Run_B := Pos_run_manual_B;\nELSIF NOT GVL.RB_b.Manual AND GVL.RB_b.Auto THEN\n\tPos_Run_B := Pos_run_auto_B;\nELSE\n\tPos_Run_B := Pos_0;\nEND_IF;\n{endregion}\n// Log_Machine\t \nFOR i_log := 1 TO 20 DO\n    // GVL.Log_HMI[i_log] := LOG_.Buffer[i_log];\n\tGVL.Log_RobotA[i_log] := LOG_A.Buffer[i_log];\n\tGVL.Log_RobotB[i_log] := LOG_B.Buffer[i_log];\nEND_FOR\ni_log_HMI := 1;\nFOR i_log_BF := LOG_.Index TO 1 BY -1 DO\n\tGVL.Log_HMI[i_log_HMI] := LOG_.Buffer[i_log_BF];\n\ti_log_HMI := i_log_HMI + 1;\nEND_FOR\n\n// Thuc hien ham trigger VS Cam ID 0\nTrigger_VS_FB[0](Enable := GVL.Auto_VS_RB[0].Enable_FB_Trigger_VS,\n\t\t\t\t Start := GVL.Auto_VS_RB[0].Start_FB_Trigger_VS,\n\t\t\t\t count_Vs_Align_max := GVL.Data_Calib_RB[0].Nb_Trigger_VS_Max,\n\t\t\t\t T_Delay_Trigger_time := GVL.Data_Calib_RB[0].Delay_Trigger_Time,\n// \t\t\t\t Trigger_RB := GVL.Auto_VS_RB[0].Trigger_VS, // Bien trigger robot A gui Vision\n// \t\t\t\t Triger_RB_Done := GVL.Auto_VS_RB[0].Trigger_Done, //Bien trigger done Vision gui robot A\n\t\t\t\t Trigger_Again := GVL.Auto_VS_RB[0].Trigger_Again,\n\t\t\t\t Pass_Triger_VS_NG := GVL.Auto_VS_RB[0].Pass_Trigger_VS_NG,\n\t\t\t\t Mode_ByPass_VS := GVL.Data_Calib_RB[0].Bypass_VS,\n\t);","LineInfoPersistence":"(string)d42bdecf-5947-4894-8152-45755ded5bed_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM POU_MOTION\nVAR\n\t// chạy điểm\n\tMOVP_A :MC_MoveDirectAbsolute;\n\tMOVP_B :MC_MoveDirectAbsolute;\n\t// chạy đường thẳng\n\tMOVL_A: MC_MoveLinearAbsolute;\n\tMOVL_B: MC_MoveLinearAbsolute;\n\t// chạy đường tròn\n\tMOVC_A: MC_MoveCircularAbsolute;\n\tMOVC_B: MC_MoveCircularAbsolute;\n\t\n\t// Biến chạy\n\tRBA_BufferMode, TestA_BF_Mode: SM3_Robotics.MC_BUFFER_MODE;\n\tRBA_TransitionMode, TestA_Trans_Mode: SM3_Robotics.MC_TRANSITION_MODE;\n\tRBA_TransitionParameter, TestA_Tran_Para: ARRAY [0..(SMC_RCNST.MAX_TRANS_PARAMS - 1)] OF LREAL := [500, 0.0];\n\tRBA_OrientationMode, TestA_Orient_Mode: SM3_Robotics.SMC_ORIENTATION_MODE;\n\tRBB_BufferMode: SM3_Robotics.MC_BUFFER_MODE;\n\tRBB_TransitionMode: SM3_Robotics.MC_TRANSITION_MODE;\n\tRBB_TransitionParameter: ARRAY [0..(SMC_RCNST.MAX_TRANS_PARAMS - 1)] OF LREAL := [500, 0.0] ;\n\tRBB_OrientationMode: SM3_Robotics.SMC_ORIENTATION_MODE;\t\n\t\n\t//RBA_MovementType: SM3_Robotics.SMC_PTP_MOVEMENT_TYPE;\n\t//RBb_MovementType: SM3_Robotics.SMC_PTP_MOVEMENT_TYPE;\n\t\n\tPos_run_manual_A, Pos_run_auto_A , Pos_run_manual_B, Pos_run_auto_B ,\n\tPos_Run_A, Pos_Run_A_Pre, Pos_Run_B, Pos_Run_B_Pre : SM3_Robotics.SMC_POS_REF;\n\tPos_0 : SM3_Robotics.SMC_POS_REF := (c := (X:= 0,Y:= 0, Z:= 0, A:= 0, B:= 0, C:= 0));\t\n\tMOVL_A_2: MC_MoveLinearAbsolute;\n\tMOVL_A_3: MC_MoveLinearAbsolute;\n\tMOVL_B_2: MC_MoveLinearAbsolute;\n\tMOVL_B_3: MC_MoveLinearAbsolute;\nEND_VAR\n\nVAR // Act_go_Manual\n\tExcute_Run_goHome_A , AP_Man_Z_Wait_Go, AP_Man_R_Wait_Go, AP_Man_XY_Wait_Go,\n\tExcute_Run_goHome_B, Excute_Run_goZ_Wait_B, Excute_Run_goR_Wait_B,Excute_Run_goXY_Wait_B : BOOL;\n\tAP_Man_Pos_Go , Excute_Run_goPos_A_UpZ, excute_run_L_Upz_A , AP_Man_UP_Z_Go, AP_Man_Pos_Go_L,\n \tExcute_Run_goPos_B, Excute_Run_goPos_B_UpZ, excute_run_L_Upz_B , excute_run_P_Upz_B, Excute_Run_goPos_B_L : BOOL;\n\tExcute_Run_goPos_A_UpZ_XY_BF_R, Excute_Run_goPos_A_UpZ_R_BF_XY, Excute_Run_goPos_B_UpZ_XY_BF_R, Excute_Run_goPos_B_UpZ_R_BF_XY : BOOL;\n\texcute_run_cam_B, excute_run_cam_A, excute_run_P_cam_B, excute_run_P_cam_A, run_calib_P_Cam_A, run_calib_P_Cam_B : BOOL;\n\tmode_Run_GoPosA_manual, mode_Run_GoPosB_manual: INT := 0;\n\tPro_B_cam : INT;\n\tRunning_B_Cam : BOOL;\n\t\n\t\n\tOther_PosA, Other_PosB: BOOL;\n\tPRO_A : ARRAY[0..50] OF INT;\n\tRuningPosA : ARRAY[0..50] OF BOOL;\n\tPRO_B : ARRAY[0..50] OF INT;\n\tRuningPosB : ARRAY[0..50] OF BOOL;\n\t\n\tT_MC1_4, T_MC2_4, Project_4_Delay_B, Project_4_Delay_A, on_Cam : TON;\t\n\tProject_4_Delay_B1, Project_4_Delay_B2, Project_4_Delay_B3, Project_4_Delay_B4, ton_centering,  \n\tProject_4_Delay_A1, Project_4_Delay_A2, Project_4_Delay_A3, Project_4_Delay_A4, Project_4_Delay_A5, Project_4_Delay_A6, Project_4_Delay_A7, Project_4_Delay_A8  : TON;\n\tTon_OK_MC1_4, Ton_OK_MC2_4, Ton_Limit_Test_TS, Ton_Limit_Test_VS : TON;\n\tTon_tacktime, T_Delay_RB_A_Tool_1, T_Delay_RB_A_Tool_2, T_Delay_RB_B_Tool_1, T_Delay_RB_B_Tool_2 : TON;\n\ton_centering : WORD;\n\tchange_fac_vel_A, change_fac_vel_B : BOOL := FALSE;\n\tchange_fac_vel_max_A, change_fac_vel_max_A_test : BOOL := FALSE;\n\tchange_fac_vel_max_B : BOOL := FALSE;\nEND_VAR\n\nVAR // Act_go_Auto\n\tLOG_, LOG_A, LOG_B : FB_Write_Log(); // log file\n\ti_log, i_log_BF, i_log_HMI : INT;\n\t{region \"1.Project 1\"}\n\t\tPallets_get_A,Pallets_put_A,\t\t\t \n\t\tPallets_get_B, Pallets_put_B : FB_PALLETS;\n\t\t\t \n\t\tstatus_MC :INT;\t \n\t\t\t \n\t\tProcess_1_A,Process_1_B,\n\t\tProcess_2_A,Process_2_B: INT;\n\t\tProcess_2_A_to_B , Process_2_B_to_A : \t BOOL;\n\t\t\t \n\t\tProcess_2_A_1, Process_2_A_2, Process_2_A_3, Process_2_A_4 , \n\t\tProcess_2_B_1, Process_2_B_2, Process_2_B_3, Process_2_B_4 : BOOL;\n\n\t \n\t\tBlink_Stop, Blink_Start : Blink_Bit; // nháy \n\t\t\t \n\t\tSR_MC : SR;\n\t\tRUN_PROJECT : BOOL;\n\t\tINIT_RUN_PROJECT : BOOL;\n\t\tAP_Auto_Pos_Go , EXCUTE_RUN_P_AUTO_B , EXCUTE_RUN_L_AUTO_A , EXCUTE_RUN_L_AUTO_B : BOOL;\n\t\t\t \n\t\tProject_2_Delay, Project_2_Delay2 : TON;\t  \n\t\t\n\t\tpr2_mode_A_Pick_to_B_Pick, pr2_mode_A_Pick_to_B_Place : BOOL;\t\t\t \n\t\tMove_RB_A, Move_RB_B : FB_Run_Point;\n\t\tMove_Point_Para_A, Move_Point_Para_B : Move_Point;\n\t{endregion}\n\t\t \n\t{region \"3.Project 3\"}\t\n \n\tProcess_3_A,Process_3_B: INT;\n\tTest_Pick, Test_Place : INT;\t \n\trun_P_cam_B_test_pick, run_P_cam_B_test_place\t: BOOL;\t  \n\t\t \n\tProject_3_Delay_A, Project_3_Delay_B  : TON ;\n\t\t \n\tA3_Run_P, A3_Run_L, B3_Run_P, B3_Run_L : BOOL;\t\n\t\n\n\tA_Comp, B_Comp ,Ena3, B_Allow_NextStep, A_Allow_NextStep, A_Comp_Man, B_Comp_Man, A_FB_Comp, B_FB_Comp, A_Ready, B_Ready : BOOL;\n\tPro_A3, Pro_B3 : WORD; \n\t\t  \n\tnextstepRtrigB, nextstepRtrigA : R_TRIG;\n\t// Trigger_Cmd, Trigger_Busy, Trigger_Done : BOOL;\n\tT1_A, T2_A : WORD;\n\t\n\t\n\tDATA_A_T1 , DATA_B_T1, DATA_B_T2 : WORD := 0; // 0 : NONE, 1:barcode // 2 OK \t // 3 NG \n\tDATA_MC1, Data_MC2 : WORD; // 0 NONE, 1 BUSY, 2 ALLOW PLACE, 3 ALLOW PICK \n\tALLOW_PICK_CNV, ALLOW_PLACE_CNV_OK, ALLOW_PLACE_CNV_NG_TS, ALLOW_PLACE_CNV_NG_VS  : BOOL := true;\n\tPro_MC1, Pro_MC2 : WORD := 0;\n\tPRO_A3_,PRO_B3_  : ARRA