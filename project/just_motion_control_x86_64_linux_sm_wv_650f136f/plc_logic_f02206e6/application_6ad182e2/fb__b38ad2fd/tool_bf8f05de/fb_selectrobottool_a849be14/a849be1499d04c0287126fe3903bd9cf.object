{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)a849be14-99d0-4c02-8712-6fe3903bd9cf","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_SelectRobotTool","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)bf8f05de-2ef0-4a76-8958-b734ab9b43c2"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_SelectRobotTool\n//-----------------------------------------------------------------------------\n// ToolID = Number_Tool.\n// Không gọi SMC_GroupSetTool tại đây.\n// POU_COORDINATE_ là nơi duy nhất Apply TCP vào SCARA_A.\n//=============================================================================\n\nDone := FALSE;\n\n\n//=============================================================================\n// RESET\n//=============================================================================\nIF Reset THEN\n    Busy := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n    udiMyRequestID := 0;\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// DETECT EXECUTE\n//=============================================================================\nrtExecute(CLK := Execute);\n\n\n//=============================================================================\n// TẠO YÊU CẦU CHỌN / APPLY TOOL\n//=============================================================================\nIF rtExecute.Q AND NOT Busy THEN\n\n    Busy := TRUE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    //---------------------------------------------------------------------\n    // ToolID chính là Number_Tool.\n    //\n    // ToolID = 0 : No Tool Offset.\n    // ToolID = 1 : Tool 1.\n    // ToolID = 2 : Tool 2...\n    //---------------------------------------------------------------------\n    GVL.RB_A.Number_Tool := ToolID;\n\n    //---------------------------------------------------------------------\n    // Luôn tạo Request mới.\n    // Nhờ vậy cùng ToolID nhưng TCP đã thay đổi vẫn được Apply lại.\n    //---------------------------------------------------------------------\n    GVL.g_udiRobotAToolApplyRequestA := GVL.g_udiRobotAToolApplyRequestA + 1;\n    IF GVL.g_udiRobotAToolApplyRequestA = 0 THEN GVL.g_udiRobotAToolApplyRequestA := 1; END_IF;\n\n    // Chốt Request của transaction này.\n    udiMyRequestID := GVL.g_udiRobotAToolApplyRequestA;\n\nEND_IF;\n\n\n//=============================================================================\n// CHỜ KẾT QUẢ TỪ POU_COORDINATE_\n//=============================================================================\nIF Busy THEN\n\n    //---------------------------------------------------------------------\n    // APPLY ERROR\n    //---------------------------------------------------------------------\n    IF GVL.g_xRobotAToolApplyError THEN\n        Busy := FALSE;\n        Error := TRUE;\n        ErrorID := GVL.g_udiRobotAToolApplyErrorID;\n\n    //---------------------------------------------------------------------\n    // APPLY DONE\n    //---------------------------------------------------------------------\n    ELSIF udiMyRequestID <> 0\n    AND GVL.g_udiRobotAToolAppliedRequestA = udiMyRequestID THEN\n        Busy := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n        Done := TRUE;\n    END_IF;\n\nEND_IF;\n\n\n\n\n\n// (*\n// ===============================================================================\n// FUNCTION BLOCK\n//     FB_SelectRobotTool\n// \n// DESCRIPTION\n//     Wrapper chọn Tool/TCP cho Robot.\n// \n// TODO INTEGRATIONđ\n//     Thay phần Logic-Only Placeholder bằng SMC_GroupSetTool đang có\n//     trong project hiện tại.\n// \n// EXPECTED FLOW\n//     Execute rising edge\n//         -> Call SMC_GroupSetTool\n//         -> Wait Done/Error\n//         -> Return Done/Error\n// ===============================================================================\n// *)\n// \n// //=============================================================================\n// // DEFAULT PULSE OUTPUT\n// //=============================================================================\n// Done := FALSE;\n// \n// \n// //=============================================================================\n// // RESET\n// //=============================================================================\n// IF Reset THEN\n// \n//     Busy := FALSE;\n// \n//     Error := FALSE;\n//     ErrorID := 0;\n// \n//     RETURN;\n// \n// END_IF;\n// \n// \n// //=============================================================================\n// // DETECT EXECUTE\n// //=============================================================================\n// rtExecute(CLK := Execute);\n// \n// \n// //=============================================================================\n// // START TOOL SELECTION\n// //=============================================================================\n// IF rtExecute.Q AND NOT Busy THEN\n// \n//     Busy := TRUE;\n// \n//     Error := FALSE;\n//     ErrorID := 0;\n// \n// \n//     //=========================================================================\n//     // TODO: CALL SMC_GROUPSETTOOL HERE\n//     //-------------------------------------------------------------------------\n//     // Ví dụ logic:\n//     //\n// \tfbGroupSetTool(\n// \t\tExecute   := TRUE,\n// \t\tAxisGroup := SCARA_A,\n// \t\tToolOffset := F_ConvertToolTCP(ToolTCP)\n// \t);\n// \t\n// \tIF fbGroupSetTool.Done THEN\n// \t\tBusy := FALSE;\n// \t\tDone := TRUE;\n// \tEND_IF;\n// \t\n// \tIF fbGroupSetTool.Error THEN\n// \t\tBusy := FALSE;\n// \t\tError := TRUE;\n// \t\tErrorID := fbGroupSetTool.ErrorID;\n// \tEND_IF;\n//     //=========================================================================\n// \n// \n// //     //-------------------------------------------------------------------------\n// //     // LOGIC-ONLY PLACEHOLDER\n// //     //-------------------------------------------------------------------------\n// //     // Xóa hai dòng dưới sau khi nối SMC_GroupSetTool thực tế.\n// //     Busy := FALSE;\n// //     Done := TRUE;\n// \n// END_IF;\n//","LineInfoPersistence":"(string)a849be14-99d0-4c02-8712-6fe3903bd9cf_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_SelectRobotTool\nVAR_INPUT\n\n    // Xung Execute.\n    Execute : BOOL;\n\n    // Reset FB.\n    Reset : BOOL;\n\n    // ToolID cần chọn.\n    ToolID : UINT;\n\n    \n\nEND_VAR\n\nVAR_OUTPUT\n\n    // Tool đã được chọn.\n    Done : BOOL;\n\n    // FB đang xử lý.\n    Busy : BOOL;\n\n    // FB lỗi.\n    Error : BOOL;\n\n    // Mã lỗi.\n    ErrorID : UDINT;\n\nEND_VAR\n\nVAR\n\n    // Bắt cạnh Execute.\n    rtExecute : R_TRIG;\n\n    // TODO:\n    // Khai báo instance SMC_GroupSetTool đúng theo version thư viện.\n    fbGroupSetTool : SMC_GroupSetTool;\n\txExecuteTool : BOOL;\n\t// RequestID thuộc transaction hiện tại.\n\tudiMyRequestID : UDINT := 0;\n\nEND_VAR\n\n","LineInfoPersistence":"(string)a849be14-99d0-4c02-8712-6fe3903bd9cf_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)228","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}