{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)5b62007a-d559-4644-b733-59f154c5cae3","ParentGuid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","Name":"(string)ACT_SelectProjectRun","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)rSave_Model(CLK := GVL.Save_Model);\nrCall_Model(CLK := GVL.Call_Model);\nrReadModel_BF(CLK := Read_Model_BF);\n\n\n\nIF rReadModel_BF.Q THEN\n\tfiledata.Load(    \n\tpData := ADR(GVL.ProjectAndModel),\n    uiSize := SIZEOF(GVL.ProjectAndModel),\n    sFileName := 'ProjectAndModel_CR.bin');\n\tGVL.Project_No_Cur := GVL.ProjectAndModel.Project_No_Current;\n\tGVL.Model_No_Cur := GVL.ProjectAndModel.Model_No_Current;\t\n\t\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name,INT_TO_STRING(GVL.Project_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'_Model_');\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,INT_TO_STRING(GVL.Model_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'.bin');\n\t\n\tfiledata.Load(    \n\tpData := ADR(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    uiSize := SIZEOF(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    sFileName := S_Robot_Name_Full);\n\t\n\t\n\tGVL_1.DATA_RB_A := GVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_A;\n\tGVL_1.DATA_RB_B := GVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_B;\n\tGVL_1.Point_Name_A := GVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_A;\n\tGVL_1.Point_Name_B := GVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_B;\n\tGVL_1.Step_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].Step_A;\n\tGVL_1.Step_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].Step_B;\n\tGVL_1.Condition_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].Condition_A;\n\tGVL_1.Condition_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].Condition_B;\n\tGVL_1.StepCount_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].StepCount_A;\n\tGVL_1.StepCount_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].StepCount_B;\n\tGVL_1.CondCount_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].CondCount_A;\n\tGVL_1.CondCount_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].CondCount_B;\n\tGVL_1.Name_Program_Cr := GVL.Robot_Programs[GVL.Project_No_Cur].Name;\n\t\n\tGVL.A_LengthStep := GVL_1.StepCount_Cr_A;\n\tGVL.B_LengthStep := GVL_1.StepCount_Cr_B;\n\t\n\tRead_Model_BF := FALSE;\nEND_IF\n\n// Tao bien Boolean xac nhan project dang chay\nFOR i_1 := 0 TO 10 DO\n\tIF GVL.ProjectAndModel.Project_No_Current = i_1 THEN \n\t\tIF GVL.ProjectAndModel.Direction_Robot_Current = 0 THEN\n\t\t\tGVL.Project_Cur[i_1] := TRUE;\n\t\tEND_IF;\n\t\tIF GVL.ProjectAndModel.Direction_Robot_Current = 1 THEN\n\t\t\tGVL.Project_Cur_Rev[i_1] := TRUE;\n\t\tEND_IF;\n\tELSE\n\t\tIF GVL.ProjectAndModel.Direction_Robot_Current = 0 THEN\n\t\t\tGVL.Project_Cur[i_1] := FALSE;\n\t\tEND_IF;\n\t\tIF GVL.ProjectAndModel.Direction_Robot_Current = 1 THEN\n\t\t\tGVL.Project_Cur_Rev[i_1] := FALSE;\n\t\tEND_IF;\n\tEND_IF\nEND_FOR\n\n// Goi model\nIF rCall_Model.Q THEN\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name,INT_TO_STRING(GVL.Project_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'_Model_');\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,INT_TO_STRING(GVL.Model_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'.bin');\n\t\n\tfiledata.Load(    \n\tpData := ADR(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    uiSize := SIZEOF(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    sFileName := S_Robot_Name_Full);\n\t\n\tGVL_1.DATA_RB_A := GVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_A;\n\tGVL_1.DATA_RB_B := GVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_B;\n\tGVL_1.Point_Name_A := GVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_A;\n\tGVL_1.Point_Name_B := GVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_B;\n\tGVL_1.Step_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].Step_A;\n\tGVL_1.Step_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].Step_B;\n\tGVL_1.Condition_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].Condition_A;\n\tGVL_1.Condition_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].Condition_B;\n\tGVL_1.StepCount_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].StepCount_A;\n\tGVL_1.StepCount_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].StepCount_B;\n\tGVL_1.CondCount_Cr_A := GVL.Robot_Programs[GVL.Project_No_Cur].CondCount_A;\n\tGVL_1.CondCount_Cr_B := GVL.Robot_Programs[GVL.Project_No_Cur].CondCount_B;\n\tGVL_1.Name_Program_Cr := GVL.Robot_Programs[GVL.Project_No_Cur].Name;\n\tGVL.A_LengthStep := GVL_1.StepCount_Cr_A;\n\tGVL.B_LengthStep := GVL_1.StepCount_Cr_B;\n\t//GVL.Call_Model := FALSE;\nEND_IF\n\n// Luu Model\nIF rSave_Model.Q THEN\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name,INT_TO_STRING(GVL.Project_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'_Model_');\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,INT_TO_STRING(GVL.Model_No_Cur));\n\tS_Robot_Name_Full := CONCAT(S_Robot_Name_Full,'.bin');\n\t\n\tGVL.ProjectAndModel.Project_No_Current := GVL.Project_No_Cur;\n\tGVL.ProjectAndModel.Model_No_Current := GVL.Model_No_Cur;\n\t\n\tGVL_1.StepCount_Cr_A := GVL.A_LengthStep;\n\tGVL_1.StepCount_Cr_B := GVL.B_LengthStep;\n\t\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_A := GVL_1.DATA_RB_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Model[GVL.Model_No_Cur].DATA_RB_B := GVL_1.DATA_RB_B;\n\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_A := GVL_1.Point_Name_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Point_Name_B := GVL_1.Point_Name_B;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Step_A := GVL_1.Step_Cr_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Step_B := GVL_1.Step_Cr_B;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Condition_A := GVL_1.Condition_Cr_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Condition_B := GVL_1.Condition_Cr_B;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].StepCount_A := GVL_1.StepCount_Cr_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].StepCount_B := GVL_1.StepCount_Cr_B;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].CondCount_A := GVL_1.CondCount_Cr_A;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].CondCount_B := GVL_1.CondCount_Cr_B;\n\tGVL.Robot_Programs[GVL.Project_No_Cur].Name := GVL_1.Name_Program_Cr;\n\n\tfiledata.Save(    \n\tpData := ADR(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    uiSize := SIZEOF(GVL.Robot_Programs[GVL.Project_No_Cur]),\n    sFileName := S_Robot_Name_Full);\n\t\n\tfiledata.Save(    \n\tpData := ADR(GVL.ProjectAndModel),\n    uiSize := SIZEOF(GVL.ProjectAndModel),\n    sFileName := 'ProjectAndModel_CR.bin');\n\nEND_IF","LineInfoPersistence":"(string)5b62007a-d559-4644-b733-59f154c5cae3_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)133"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}