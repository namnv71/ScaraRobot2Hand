{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)3e0711a2-a9a0-4d9b-a6bc-0b9e0af01612","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)Robot_Calib_Vision","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)42d80ded-8752-4d8a-bf5f-3274bbc10f1e"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//Run_Calib_VS_RB_A - CAM 1\nIF GVL.Data_Calib_RB[1].Use THEN\n\tGVL.Auto_VS_RB[1].RTrig_Trigger_VS_Done(CLK := GVL.Auto_VS_RB[1].Trigger_Done);\n\tGVL.Auto_VS_RB[1].RTrig_Trigger_Calib_VS_Done(CLK := GVL.Auto_VS_RB[1].Calib_VS_Done);\n\tRun_Calib_VS_RB[1](Enable := GVL.g_aVisionConfig[1].Enable,\n\t\t\t\t\t  Start := GVL.Calib_Cam_RB[1].Start,\n\t\t\t\t\t  Reset := GVL.Calib_Cam_RB[1].Reset,\n\t\t\t\t\t  CameraID := GVL.g_aVisionConfig[1].CameraID,\n\t\t\t\t\t  Hand_No := GVL.g_aVisionConfig[1].Robot,\n\t\t\t\t\t  PointNo1 := (GVL.Data_Calib_RB[1].PointNo1),\n\t\t\t\t\t  Nb_Point_X := GVL.Data_Calib_RB[1].Nb_Point_X,\n\t\t\t\t\t  Nb_Point_Y := GVL.Data_Calib_RB[1].Nb_Point_Y,\n\t\t\t\t\t  Delta_X := GVL.Data_Calib_RB[1].Delta_X,\n\t\t\t\t\t  Delta_Y := GVL.Data_Calib_RB[1].Delta_Y,\n\t\t\t\t\t  Delta_A := GVL.Data_Calib_RB[1].Delta_A,\n\t\t\t\t\t  A_Error := Move_Point_Para_A.A_Error,\n\t\t\t\t\t  B_Error := Move_Point_Para_B.B_Error,\n\t\t\t\t\t  T_Delay_Trigger_time := GVL.Data_Calib_RB[1].Delay_Trigger_Time,\n\t\t\t\t\t  Run_Mode := GVL.Data_Calib_RB[1].Run_By_Array_Point,\n\t\t\t\t\t  Run_No_Trigger := GVL.Data_Calib_RB[1].Run_No_Trigger,\n\t\t\t\t\t  CurrentPoint_Run_A := Pos_run_manual_A,  // Toa do diem chay calib RB A\n\t\t\t\t\t  CurrentPoint_Run_B := Pos_run_manual_B,  // Toa do diem chay calib RB B\n\t\t\t\t\t  ARunP := run_calib_P_Cam_A, // Bien cho robot A chay PTP\n\t\t\t\t\t  BRunP := run_calib_P_Cam_B, // Bien cho robot B chay PTP\n\t\t\t\t\t  A_Comp    := A_Comp_Man, // Bien bao robot A da chay den diem muc tieu\n\t\t\t\t\t  B_Comp    := B_Comp_Man, // Bien bao robot B da chay den diem muc tieu\n\t\t\t\t\t  Trigger_RB := GVL.Auto_VS_RB[1].Trigger_VS, // Bien trigger robot A gui Vision\n\t\t\t\t\t  Triger_RB_Done := GVL.Auto_VS_RB[1].Trigger_Done, //Bien trigger done Vision gui robot A\n\t\t\t\t\t  Run_Calib_Pos_Done := GVL.Auto_VS_RB[1].Run_Pos_Calib_Done, // Bien bao da chay xong cac diem calib\n\t\t\t\t\t  Calib_Done := GVL.Auto_VS_RB[1].Calib_VS_Done,\n\t\t\t\t\t  );\n\tIF GVL.Man_Calib_RB[1].Run_Calib_VS THEN\n\t\tGVL.Calib_Cam_RB[1].Enable := TRUE;\n\t\tGVL.Calib_Cam_RB[1].Start := TRUE;\n\tELSE\n\t\tGVL.Calib_Cam_RB[1].Enable := FALSE;\n\t\tGVL.Calib_Cam_RB[1].Start := FALSE;\n\tEND_IF;\n\t\n\tIF Run_Calib_VS_RB[1].DoneAll THEN\n\t\tGVL.Man_Calib_RB[1].Run_Calib_VS := FALSE;\n\tEND_IF\n\t//IF GVL.Man_Calib_RB[0].Calib_VS_Done THEN \n\tIF GVL.Auto_VS_RB[1].RTrig_Trigger_Calib_VS_Done.Q THEN\n\t\tGVL.Calib_Cam_RB[1].Enable := FALSE;\n\t\tGVL.Calib_Cam_RB[1].Start := FALSE;\n\tEND_IF\nEND_IF;","LineInfoPersistence":"(string)3e0711a2-a9a0-4d9b-a6bc-0b9e0af01612_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)48"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}