{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d73173e3-928a-4f28-8705-97fe372caeaa","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_PathSegmentType","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9e1f02d8-5bba-4bcc-a63a-6b70bdcae5c5"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_PathSegmentType :\n(\n    PATH_NONE := 0,               // Chưa xác định kiểu đoạn.\n\n    PATH_POINT := 10,             // Một điểm độc lập.\n    PATH_LINE := 20,              // Đoạn thẳng tới điểm tiếp theo.\n    PATH_ARC_MID_END := 30,       // Cung tròn xác định bởi điểm giữa và điểm cuối.\n    PATH_ARC_CW := 40,            // Cung tròn theo chiều kim đồng hồ.\n    PATH_ARC_CCW := 50,           // Cung tròn ngược chiều kim đồng hồ.\n    PATH_SPLINE := 60,            // Đường spline qua nhiều điểm.\n    PATH_BEZIER := 70,            // Đường Bézier.\n    PATH_BREAK := 80              // Ngắt quỹ đạo, không nối với đoạn kế tiếp.\n);\nEND_TYPE","LineInfoPersistence":"(string)d73173e3-928a-4f28-8705-97fe372caeaa_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)16"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}