{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)8b66f04b-a1c1-465e-8334-c026dfa237f3","ParentGuid":"(Guid)816b64cc-0f9f-4934-8874-fc9591129174","Name":"(string)ACT_LOGIC_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1. Logic Jog\"}\n// JOG ROBOT B\nIF GVL.RB_B.Jog_continue THEN\nJog_FW_B[0]:= GVL.RB_B.JOG_X_FW ;\nJog_FW_B[1]:= GVL.RB_B.JOG_Y_FW ;\nJog_FW_B[2]:= GVL.RB_B.JOG_Z_FW ;\n\n\nJog_BW_B[0]:= GVL.RB_B.JOG_X_BW ;\nJog_BW_B[1]:= GVL.RB_B.JOG_Y_BW ;\nJog_BW_B[2]:= GVL.RB_B.JOG_Z_BW ;\n\n\t \n\tIF  gvl.RB_B.ABC_as_ACS OR GVL.RB_B.COORD = 0 THEN\n\t\tJog_FW_B[3]:= GVL.RB_B.JOG_R_FW ;\t \n\t\tJog_BW_B[3]:= GVL.RB_B.JOG_R_BW ;\t\n\tELSIF NOT gvl.RB_b.ABC_as_ACS AND GVL.RB_b.COORD <> 0 THEN\n\t\tJog_FW_b[5]:= GVL.RB_b.JOG_R_FW ;\t \n\t\tJog_BW_b[5]:= GVL.RB_b.JOG_R_BW ;  \n\tEND_IF;\t\t \t\t\t   \nEND_IF;\n\nFOCUS_JOG_B := Jog_FW_B[0] OR Jog_FW_B[1] OR Jog_FW_B[2] OR Jog_FW_B[3] OR Jog_FW_B[4] OR Jog_FW_B[5]\n\t\t\tOR Jog_BW_B[0] OR Jog_BW_B[1] OR Jog_BW_B[2] OR Jog_BW_B[3] OR Jog_BW_B[4] OR Jog_BW_B[5];\n\n// CONDITION\nIF GVL.RB_b.Manual AND GVL.RB_b_.Ready AND (GVL.RB_b_.SAFETY_CHECK OR gvl.RB_B.Control_w_mode = 1) AND FOCUS_JOG_B THEN\n\tSMC_GroupJog2_2.Enable := TRUE; \n\tELSE\n\tSMC_GroupJog2_2.Enable := FALSE;\t\nEND_IF\n\nSMC_GroupJog2_2.ABC_as_ACS := gvl.RB_B.ABC_as_ACS; // true giữ nguyên tool, false : tool quay theo\n{endregion}\n{region \"2. Control Parameter\"}\t \n/// CONTROL SPEED\nIF GVL.RB_B.Auto THEN\n\tGVL.RB_B.ACC := GVL_1.DATA_RB_B.MOTION_ACC;\n\tGVL.RB_B.DEC := GVL_1.DATA_RB_B.MOTION_DEC;\n\tGVL.RB_B.JERK := GVL_1.DATA_RB_B.MOTION_JERK;\nELSE\n\tGVL.RB_B.ACC := GVL_1.DATA_RB_B.MOTION_ACC_MAN;\n\tGVL.RB_B.DEC := GVL_1.DATA_RB_B.MOTION_DEC_MAN;\n\tGVL.RB_B.JERK := GVL_1.DATA_RB_B.MOTION_JERK_MAN; \nEND_IF\t \nIF GVL.RB_b.Control_w_speed = 2 THEN\n\tIF GVL.RB_B.Auto THEN\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_HIGH;\n\tELSE\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_HIGH_MAN;\t \n\tEND_IF\nELSIF GVL.RB_b.Control_w_speed = 1 THEN\n\tIF GVL.RB_B.Auto THEN\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_MID;\n\tELSE\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_MID_MAN;\t \n\tEND_IF\nELSE\n\tIF GVL.RB_B.Auto THEN\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_LOW;\t\n\tELSE\n\t\tGVL.RB_B.SPEED := GVL_1.DATA_RB_B.SPEED_LOW_MAN;\t \n\tEND_IF\nEND_IF\n{endregion}\n{region \"3. Coordinate System\"}\nCASE GVL.RB_B.COORD OF\n\t0:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.ACS;\n\t1:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.MCS;\t \n\t2:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.WCS;\t\n\t3:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.PCS_1;\t\t\t \n\t4:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.PCS_2;\n\t5:\n\t\tCoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.MCS;\t\n\t\t//CoordSystem_B := SM3_Robotics.SMC_COORD_SYSTEM.TCS;\t\t\t\t  \nEND_CASE\n\n{endregion}","LineInfoPersistence":"(string)8b66f04b-a1c1-465e-8334-c026dfa237f3_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)83"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}