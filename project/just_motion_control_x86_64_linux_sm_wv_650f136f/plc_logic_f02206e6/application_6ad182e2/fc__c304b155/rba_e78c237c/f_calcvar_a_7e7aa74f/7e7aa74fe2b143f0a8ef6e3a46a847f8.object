{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7e7aa74f-e2b1-43f0-a8ef-6e3a46a847f8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_CalcVar_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)e78c237c-5698-4814-b7d2-7c8b55d80bb7"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF (DestVar < 1) OR (DestVar > 200) THEN\n    F_CalcVar_A := 0;\n    RETURN;\nEND_IF;\n\nCASE SourceMode OF\n    0: // VarDest với số cố định P3\n        A := GVL.A_Var[DestVar];\n        B := P3;\n\n    1: // VarDest với Var[P3]\n        A := GVL.A_Var[DestVar];\n\n        IF (P3 >= 1) AND (P3 <= 200) THEN\n            B := GVL.A_Var[P3];\n        ELSE\n            B := 0;\n        END_IF;\n\n    2: // Var[P3] với Var[P4], trả về VarDest\n        IF (P3 >= 1) AND (P3 <= 200) THEN\n            A := GVL.A_Var[P3];\n        ELSE\n            A := 0;\n        END_IF;\n\n        IF (P4 >= 1) AND (P4 <= 200) THEN\n            B := GVL.A_Var[P4];\n        ELSE\n            B := 0;\n        END_IF;\nELSE\n    A := GVL.A_Var[DestVar];\n    B := 0;\nEND_CASE;\n\nCASE Cmd OF\n    E_RobotCmd.CMD_VAR_SET:\n        F_CalcVar_A := B;\n\n    E_RobotCmd.CMD_VAR_ADD:\n        F_CalcVar_A := A + B;\n\n    E_RobotCmd.CMD_VAR_SUB:\n        F_CalcVar_A := A - B;\n\n    E_RobotCmd.CMD_VAR_MUL:\n        F_CalcVar_A := A * B;\n\n    E_RobotCmd.CMD_VAR_DIV:\n        IF B <> 0 THEN\n            F_CalcVar_A := A / B;\n        ELSE\n            F_CalcVar_A := GVL.A_Var[DestVar];\n        END_IF;\n\n    E_RobotCmd.CMD_VAR_MOD:\n        IF B <> 0 THEN\n            F_CalcVar_A := A MOD B;\n        ELSE\n            F_CalcVar_A := GVL.A_Var[DestVar];\n        END_IF;\n\nELSE\n    F_CalcVar_A := GVL.A_Var[DestVar];\nEND_CASE;","LineInfoPersistence":"(string)7e7aa74f-e2b1-43f0-a8ef-6e3a46a847f8_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_CalcVar_A : DINT\nVAR_INPUT\n    Cmd        : E_RobotCmd;\n    DestVar    : DINT;\n    SourceMode : DINT;\n    P3         : DINT;\n    P4         : DINT;\nEND_VAR\n\nVAR\n    A : DINT;\n    B : DINT;\nEND_VAR","LineInfoPersistence":"(string)7e7aa74f-e2b1-43f0-a8ef-6e3a46a847f8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)79","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}