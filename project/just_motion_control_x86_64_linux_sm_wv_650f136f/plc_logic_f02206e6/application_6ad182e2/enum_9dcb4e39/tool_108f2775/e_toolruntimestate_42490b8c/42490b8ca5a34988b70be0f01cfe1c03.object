{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)42490b8c-a5a3-4988-b70b-e0f01cfe1c03","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_ToolRuntimeState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)108f2775-569b-4785-8438-385044a841c4"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// ENUM: TOOL RUNTIME STATE\n//=============================================================================\n{attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_ToolRuntimeState :\n(\n    // Tool đang rảnh.\n    IDLE := 0,\n\n    // Tool đang hạ xuống.\n    DOWNING := 10,\n\n    // Tool đã xuống vị trí dưới.\n    DOWN := 20,\n\n    // Tool đang hút hoặc đóng kẹp.\n    GRIPPING := 30,\n\n    // Tool đang giữ sản phẩm.\n    OCCUPIED := 40,\n\n    // Tool đang nâng lên.\n    UPPING := 50,\n\n    // Tool đã ở vị trí trên.\n    UP := 60,\n\n    // Tool đang nhả sản phẩm.\n    RELEASING := 70,\n\n    // Tool báo lỗi.\n    ERROR := 900\n);\nEND_TYPE\n","LineInfoPersistence":"(string)42490b8c-a5a3-4988-b70b-e0f01cfe1c03_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)36"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}