{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f2a924f9-e0c3-44a8-a888-ce70b08f2226","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)ACT_GO_Pos_Auto","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)687e24e7-1787-42c8-91ad-3fd24c19d143"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Blink_Start(Enable\t:= TRUE);\nBlink_Stop(Enable\t:= TRUE);\n\n// M_LoadData(); // pro3\n// control lamp\nGVL.HMI_MAIN.yLamp_Yellow := T_Wait_Input_YL.Q AND GVL.HMI_MAIN.yStart;\nHeavyAlarm := FALSE;\n//HeavyAlarm :=  GVL.Alarm_Robot.A_Tool_1 OR GVL.Alarm_Robot.A_Tool_2 OR GVL.Alarm_Robot.B_Tool_1 OR GVL.Alarm_Robot.B_Tool_2;\nLightAlarm := GVL.Alarm_P4.Alarm_Limit_NG_TS OR GVL.Alarm_P4.Alarm_Limit_NG_VS OR Alarm_Full_NG_CONV.Q OR Alarm_Barcode_TS.Q OR Alarm_Barcode_VS.Q OR GVL.Alarm_P4.Alarm_Limit_Test_TS OR GVL.Alarm_P4.Alarm_Limit_Test_VS;\nGVL.HMI_MAIN.yBuzz := HeavyAlarm OR LightAlarm;\n\n\t// AND GVL.RB_B.Auto\nSR_MC(\tSET1 := GVL.HMI_MAIN.Start AND (GVL.RB_A.Auto OR GVL.RB_B.Auto) ,\n\t\tRESET := GVL.HMI_MAIN.Stop OR NOT GVL.X[9] OR GVL.RB_A.Manual OR GVL.RB_B.Manual OR HeavyAlarm,\n\t\tQ1 => RUN_PROJECT);\t\n\t  \ngVL.HMI_MAIN.yStop := NOT RUN_PROJECT ;\nGVL.HMI_MAIN.yStart := RUN_PROJECT ;\ndelta_position_cor := 0.02;\n//GVL.HMI_MAIN.yStart := RUN_PROJECT OR ( NOT Blink_Start.Out AND (GVL.RB_A.Auto OR GVL.RB_B.Auto)) ;\nIF (MOVP_A.Done OR MOVL_A.Done) \nAND (ABS(GVL.RB_A_.CUR_X - Pos_run_auto_A.c.X) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_Y - Pos_run_auto_A.c.Y) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_Z - Pos_run_auto_A.c.Z) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_R - Pos_run_auto_A.c.A) < delta_position_cor)\nTHEN  A_Comp\t:= TRUE;  ELSE A_Comp\t:= FALSE; END_IF;\n\nIF (MOVP_A.Done OR MOVL_A.Done) THEN  A_FB_Comp := TRUE; ELSE A_FB_Comp\t:= FALSE; END_IF;\n\nIF (NOT MOVP_A.Done AND NOT MOVL_A.Done AND NOT MOVP_A.Execute AND NOT MOVL_A.Execute)\nAND (ABS(Pos_Run_A.c.X - Pos_run_auto_A.c.X) < delta_position_cor) \nAND (ABS(Pos_Run_A.c.Y - Pos_run_auto_A.c.Y) < delta_position_cor) \nAND (ABS(Pos_Run_A.c.Z - Pos_run_auto_A.c.Z) < delta_position_cor) \nAND (ABS(Pos_Run_A.c.A - Pos_run_auto_A.c.A) < delta_position_cor)\nTHEN  A_Ready\t:= TRUE;  ELSE A_Ready\t:= FALSE; END_IF;\n\nIF (MOVP_B.Done OR MOVL_B.Done)  \nAND (ABS(GVL.RB_B_.CUR_X - Pos_run_auto_B.c.X) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_Y - Pos_run_auto_B.c.Y) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_Z - Pos_run_auto_B.c.Z) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_R - Pos_run_auto_B.c.A) < delta_position_cor)\nTHEN  B_Comp\t:= TRUE;  ELSE B_Comp\t:= FALSE; END_IF;\n\nIF (MOVP_B.Done OR MOVL_B.Done) THEN  B_FB_Comp\t:= TRUE; ELSE B_FB_Comp\t:= FALSE; END_IF;\n\nIF (NOT MOVP_B.Done AND NOT MOVL_B.Done AND NOT MOVP_B.Execute AND NOT MOVL_B.Execute)\nAND (ABS(Pos_Run_B.c.X - Pos_run_auto_B.c.X) < delta_position_cor) \nAND (ABS(Pos_Run_B.c.Y - Pos_run_auto_B.c.Y) < delta_position_cor) \nAND (ABS(Pos_Run_B.c.Z - Pos_run_auto_B.c.Z) < delta_position_cor) \nAND (ABS(Pos_Run_B.c.A - Pos_run_auto_B.c.A) < delta_position_cor)\nTHEN  B_Ready\t:= TRUE;  ELSE B_Ready\t:= FALSE; END_IF;\n// Cai dat cac tham so khi chay Auto\nIF GVL.ProjectAndModel.Direction_Robot_Current = 0 THEN\n\tMove_Point_Para_A.Hand_Type := 0;\n\tMove_Point_Para_B.Hand_Type := 1;\nELSE\n\tMove_Point_Para_A.Hand_Type := 1;\n\tMove_Point_Para_B.Hand_Type := 0;\nEND_IF\n\n// Cai dat tham so bao Error \nIF MOVP_A.Error OR MOVL_A.Error THEN\n\tMove_Point_Para_A.A_Error := TRUE;\n\tMove_Point_Para_B.A_Error := TRUE;\nELSE\n\tMove_Point_Para_A.A_Error := FALSE;\n\tMove_Point_Para_B.A_Error := FALSE;\nEND_IF\n\nIF MOVP_B.Error OR MOVL_B.Error THEN\n\tMove_Point_Para_A.B_Error := TRUE;\n\tMove_Point_Para_B.B_Error := TRUE;\nELSE\n\tMove_Point_Para_A.B_Error := FALSE;\n\tMove_Point_Para_B.B_Error := FALSE;\nEND_IF\n\n\n\nIF NOT RUN_PROJECT THEN\n\tINIT_RUN_PROJECT := FALSE;\n\tchange_fac_vel_A := FALSE;\n\tchange_fac_vel_max_A_test := FALSE;\n\tchange_fac_vel_B := FALSE;\n\tchange_fac_vel_max_B := FALSE;\n\t//reset trang thai dieu khien RB-A, RB-B\n\tMove_Point_Para_A.Enable := FALSE;\n\tMove_Point_Para_B.Enable := FALSE;\nEND_IF\n\nMove_RB_A(Enable := Move_Point_Para_A.Enable,\n\t\t\t  Hand_Type := Move_Point_Para_A.Hand_Type, \n\t\t\t  Move_Type := Move_Point_Para_A.Move_Type,\n\t\t\t  A_Error := Move_Point_Para_A.A_Error,\n\t\t\t  B_Error := Move_Point_Para_A.B_Error,\n\t\t\t  A_Ready := A_Ready,\n\t\t\t  B_Ready := B_Ready,\n\t\t\t  A_Comp := A_Comp,\n\t\t\t  B_Comp := B_Comp,\n\t\t\t  ARunP := A4_Run_P,\n\t\t\t  ARunL := A4_Run_L,\n\t\t\t  BRunP := B4_Run_P,\n\t\t\t  BRunL := B4_Run_L\n\t);\nMove_RB_B(Enable := Move_Point_Para_B.Enable,\n\t\t  Hand_Type := Move_Point_Para_B.Hand_Type, \n\t\t  Move_Type := Move_Point_Para_B.Move_Type,\n\t\t  A_Error := Move_Point_Para_B.A_Error,\n\t\t  B_Error := Move_Point_Para_B.B_Error,\n\t\t  A_Ready := A_Ready,\n\t\t  B_Ready := B_Ready,\n\t\t  A_Comp := A_Comp,\n\t\t  B_Comp := B_Comp,\n\t\t  ARunP := A4_Run_P,\n\t\t  ARunL := A4_Run_L,\n\t\t  BRunP := B4_Run_P,\n\t\t  BRunL := B4_Run_L\n\t);\n\n\n\t\nIF RUN_PROJECT THEN\n\tLOG_.Write('Machine Auto Run');\n\t// namnv1405\t  \n\tCASE GVL.ProjectAndModel.Project_No_Current OF\n\t\t0:\n\t\t\tLOG_.Write('Run Test No Vission');\n\t\t\tEna_Test := TRUE;\n\t\t\t_Main_Process_Test();\n\t\t\t//_Main_Process_Test_VS();\n\t\t1:\n\t\t\tLOG_.Write('Run Test With Vission');\n\t\t\t//M_Project_1(ena:= TRUE);  // Array Pick & Place\n\t\t\tEna_Test := TRUE;\n\t\t\t//_Main_Process_Test();\n\t\t\t_Main_Process_Test_VS();\n\t\t2:\n\t\t\tLOG_.Write('Run Project 2');\n\t\t\t//M_Project_2(Ena := TRUE);\t// Pick & Place RB A - RB B\t\n\t\t3:\n\t\t\tLOG_.Write('Run Project 3');\n\t\t\tEna3:= TRUE;\n\t\t\t//_Main_Process();\t // Project align vision Robot B\n\t\t4: \n\t\t\t\n\t\t\tIF NOT INIT_RUN_PROJECT THEN\n\n\t\t\t\tLOG_.Write('Run Project 4');\n\t\t\t\tINIT_RUN_PROJECT := TRUE;\n\t\t\tEND_IF\n\n\t\t\tEna4:= TRUE;\n\t\t\t_Main_Process_4();\t // Project align vision Robot B\n\t\t\t\n\tEND_CASE\t\nELSE\n\tA_Comp  := FALSE;\n\tB_Comp\t:= FALSE;\n\tEna3\t:= FALSE;\n\tEna4 \t:= FALSE;\n\tEna_Test := FALSE;\n\tA_Test_Motion_Run := FALSE;\n\tB_Test_Motion_Run := FALSE;\n\tJust_Start_Test := FALSE;\n\t//_Main_Process();\n\t//_Main_Process_4();\t\n\tGVL.Auto_VS_RB[0].Enable_FB_Trigger_VS := FALSE;\n\tGVL.Auto_VS_RB[0].Start_FB_Trigger_VS := FALSE;\nEND_IF;\n\n\n/// \nGVL_2.Process3.Pro_A := Pro_A3;\nGVL_2.Process3.Pro_B := Pro_B3;\n\nMain_Base_Program_RB_A();\nPRG_A_MotionManager();\n\n\nMain_Base_Program_RB_B();\nPRG_B_MotionManager();","LineInfoPersistence":"(string)f2a924f9-e0c3-44a8-a888-ce70b08f2226_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)181"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}