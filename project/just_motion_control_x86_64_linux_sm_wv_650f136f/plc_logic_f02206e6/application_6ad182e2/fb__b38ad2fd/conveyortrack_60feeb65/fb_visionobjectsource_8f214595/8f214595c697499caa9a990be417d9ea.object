{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)8f214595-c697-499c-aa9a-990be417d9ea","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionObjectSource","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DEFAULT PULSE OUTPUT\n//=============================================================================\nResultAcceptedPulse := FALSE;\nNewObjectPulse := FALSE;\nAddedObjectCount := 0;\nDuplicateCount := 0;\nRejectedCount := 0;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF Reset OR NOT Enable THEN\n    Active := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n    udiLastProcessedTriggerID := 0;\n    uiDetection := 0;\n    uiObjectCount := 0;\n\t\n\t// Xóa debug khi reset Source.\n    LastProcessedTriggerID := 0;\n    LastProcessCode := 0;\n    LastCreatedObjectID := 0;\n    LastCreatedSlot := 0;\n    LastCurrentPos.X := 0.0;\n    LastCurrentPos.Y := 0.0;\n    LastCurrentPos.Z := 0.0;\n    LastCurrentPos.A := 0.0;\n\t\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// ACTIVE\n//=============================================================================\nActive := TRUE;\n\n\n//=============================================================================\n// VALIDATE CONFIG\n//=============================================================================\nIF Config.VisionSourceID = 0 THEN\n    Error := TRUE;\n    ErrorID := 9201;\n    RETURN;\nEND_IF;\n\nIF Config.CameraID = 0\nOR Config.CameraID > GVL.C_MAX_VISION_CHANNELS THEN\n    Error := TRUE;\n    ErrorID := 9202;\n    RETURN;\nEND_IF;\n\nIF Config.MaxObjectCount = 0\nOR Config.MaxObjectCount > GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME THEN\n    Error := TRUE;\n    ErrorID := 9203;\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// CHỈ XỬ LÝ RESULT MỚI\n//=============================================================================\nIF Result.Valid\nAND Result.TriggerID <> 0\nAND Result.TriggerID <> udiLastProcessedTriggerID THEN\n\n    //---------------------------------------------------------------------\n    // KIỂM TRA RESULT CÓ ĐÚNG SOURCE KHÔNG\n    //---------------------------------------------------------------------\n//     IF Result.CameraID <> Config.CameraID\n//     OR Result.JobID <> Config.JobID THEN\n//         RETURN;\n//     END_IF;\n\t\n\tIF Result.CameraID <> Config.CameraID THEN\n\t\tLastProcessCode := 21;    // Camera mismatch\n\t\tRETURN;\n\tEND_IF;\n\t\n\tIF Result.JobID <> Config.JobID THEN\n\t\tLastProcessCode := 22;    // Job mismatch\n\t\tRETURN;\n\tEND_IF;\n\n\n    //---------------------------------------------------------------------\n    // ĐÁNH DẤU RESULT ĐÃ NHẬN\n    //---------------------------------------------------------------------\n    udiLastProcessedTriggerID := Result.TriggerID;\n    ResultAcceptedPulse := TRUE;\n\t\n\t// Result đã qua kiểm tra Camera/Job và được Source nhận.\n\tLastProcessedTriggerID := Result.TriggerID;\n\tLastProcessCode := 10;\n\n    //---------------------------------------------------------------------\n    // GIỚI HẠN SỐ OBJECT\n    //---------------------------------------------------------------------\n    uiObjectCount := Result.ObjectCount;\n\n    IF uiObjectCount > Config.MaxObjectCount THEN\n        uiObjectCount := Config.MaxObjectCount;\n    END_IF;\n\n    IF uiObjectCount > GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME THEN\n        uiObjectCount := GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME;\n    END_IF;\n\n\n    //=========================================================================\n    // DUYỆT TỪNG DETECTION\n    //=========================================================================\n    FOR uiDetection := 1 TO uiObjectCount DO\n\n        //---------------------------------------------------------------------\n        // DETECTION KHÔNG HỢP LỆ\n        //---------------------------------------------------------------------\n        IF NOT Result.Objects[uiDetection].Valid THEN\n            RejectedCount := RejectedCount + 1;\n\t\t\tLastProcessCode := 20;\n\n        //---------------------------------------------------------------------\n        // SCORE KHÔNG ĐẠT\n        //---------------------------------------------------------------------\n        ELSIF Result.Objects[uiDetection].Score < Config.MinimumScore THEN\n            RejectedCount := RejectedCount + 1;\n\t\t\tLastProcessCode := 30;\n\n        ELSE\n\n            //-----------------------------------------------------------------\n            // PRODUCT CLASS\n            //-----------------------------------------------------------------\n            uiProductClassID :=\n                Result.Objects[uiDetection].ProductClassID;\n\n            IF uiProductClassID = 0 THEN\n                uiProductClassID := Config.ProductClassID;\n            END_IF;\n\n\n            //-----------------------------------------------------------------\n            // RAW -> mm\n            //-----------------------------------------------------------------\n            stPoseMM :=\n                F_VisionTrackingRawToMM(\n                    RawPos := Result.Objects[uiDetection].RawPos,\n                    Config := Config\n                );\n\n\n            //-----------------------------------------------------------------\n            // POSE TẠI THỜI ĐIỂM CAPTURE\n            //\n            // QUAN TRỌNG:\n            // stPoseMM ở đây phải đã nằm trong CONVEYOR CS.\n            //-----------------------------------------------------------------\n            stPoseAtCapture := stPoseMM;\n\n            stPoseAtCapture.X :=\n                stPoseAtCapture.X + Config.VisionOffset.X;\n\n            stPoseAtCapture.Y :=\n                stPoseAtCapture.Y + Config.VisionOffset.Y;\n\n            stPoseAtCapture.Z :=\n                stPoseAtCapture.Z + Config.VisionOffset.Z;\n\n            stPoseAtCapture.A :=\n                stPoseAtCapture.A + Config.VisionOffset.A;\n\n\n            //-----------------------------------------------------------------\n            // ĐƯA DETECTION MỚI TỚI VỊ TRÍ CURRENT\n            // Để so cùng timestamp với Queue.Objects[].CurrentPos.\n            //-----------------------------------------------------------------\n            lrDeltaToCurrent :=\n                ConveyorPositionMM\n                - Result.CaptureConveyorPositionMM;\n\n            stCurrentPos := stPoseAtCapture;\n\n            // Conveyor của anh đang quy ước chạy theo +X Conveyor CS.\n            stCurrentPos.X :=\n                stPoseAtCapture.X\n                + LREAL_TO_REAL(lrDeltaToCurrent);\n\t\t\t\n\t\t\t// Lưu vị trí dùng để kiểm tra Duplicate và tạo Queue.\n\t\t\tLastCurrentPos := stCurrentPos;\n\t\t\tLastProcessCode := 35;\n\n            //-----------------------------------------------------------------\n            // DUPLICATE CHECK\n            //-----------------------------------------------------------------\n            xDuplicate :=\n                F_IsVisionTrackingDuplicate(\n                    NewCurrentPos := stCurrentPos,\n                    ProductClassID := uiProductClassID,\n                    Config := Config,\n                    Queue := Queue\n                );\n\n            IF xDuplicate THEN\n                DuplicateCount := DuplicateCount + 1;\n\t\t\t\tLastProcessCode := 40;\n\n            ELSE\n\n                //-------------------------------------------------------------\n                // FIND EMPTY QUEUE SLOT\n                //-------------------------------------------------------------\n                uiSlot := 0;\n\n                FOR uiSlot := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n                    IF NOT Queue.Objects[uiSlot].Valid THEN\n                        EXIT;\n                    END_IF;\n                END_FOR;\n\n\n                //-------------------------------------------------------------\n                // QUEUE FULL\n                //-------------------------------------------------------------\n                IF uiSlot > GVL.C_MAX_TRACK_OBJECTS THEN\n                    Error := TRUE;\n                    ErrorID := 9204;\n\t\t\t\t\tLastProcessCode := 45;\n                    RETURN;\n                END_IF;\n\t\t\t\t\n\t\t\t\tLastCreatedSlot := uiSlot;\n\t\t\t\tLastProcessCode := 50;\n\n                //-------------------------------------------------------------\n                // SINH OBJECT ID\n                //-------------------------------------------------------------\n                Queue.NextObjectID :=\n                    Queue.NextObjectID + 1;\n\n                IF Queue.NextObjectID = 0 THEN\n                    Queue.NextObjectID := 1;\n                END_IF;\n\n\n                //-------------------------------------------------------------\n                // BASIC OBJECT DATA\n                //-------------------------------------------------------------\n                Queue.Objects[uiSlot].Valid := TRUE;\n\n                Queue.Objects[uiSlot].ObjectID :=\n                    Queue.NextObjectID;\n\n                Queue.Objects[uiSlot].ProductClassID :=\n                    uiProductClassID;\n\n\n                //-------------------------------------------------------------\n                // SOURCE DATA\n                //-------------------------------------------------------------\n                Queue.Objects[uiSlot].SourceType :=\n                    E_ObjectSourceType.VISION;\n\n                Queue.Objects[uiSlot].SourceID :=\n                    Config.VisionSourceID;\n\n\n                //-------------------------------------------------------------\n                // CAPTURE DATA\n                //-------------------------------------------------------------\n                Queue.Objects[uiSlot].PoseInConveyor :=\n                    stPoseAtCapture;\n\n                Queue.Objects[uiSlot].CaptureConveyorPositionMM :=\n                    Result.CaptureConveyorPositionMM;\n\n                Queue.Objects[uiSlot].CurrentConveyorPositionMM :=\n                    ConveyorPositionMM;\n\n                Queue.Objects[uiSlot].ConveyorOffset :=\n                    LREAL_TO_REAL(lrDeltaToCurrent);\n\n                Queue.Objects[uiSlot].CurrentPos :=\n                    stCurrentPos;\n\n                Queue.Objects[uiSlot].ConveyorCoordinate :=\n                    stCurrentPos.X;\n\n\n                //-------------------------------------------------------------\n                // VISION DATA\n                //-------------------------------------------------------------\n                Queue.Objects[uiSlot].VisionPos :=\n                    stPoseMM;\n\n                Queue.Objects[uiSlot].VisionScore :=\n                    Result.Objects[uiDetection].Score;\n\n                Queue.Objects[uiSlot].OrientationValid := TRUE;\n\n                Queue.Objects[uiSlot].TriggerID :=\n                    Result.TriggerID;\n\n                Queue.Objects[uiSlot].ProductID :=\n                    Result.Objects[uiDetection].FeatureID;\n\n                Queue.Objects[uiSlot].CameraID :=\n                    Result.CameraID;\n\n                Queue.Objects[uiSlot].JobID :=\n                    Result.JobID;\n\n\n                //-------------------------------------------------------------\n                // OWNERSHIP / STATE\n                //-------------------------------------------------------------\n                Queue.Objects[uiSlot].Reserved := FALSE;\n                Queue.Objects[uiSlot].ReservedToolID := 0;\n                Queue.Objects[uiSlot].CanPick := FALSE;\n                Queue.Objects[uiSlot].AbortRequired := FALSE;\n                Queue.Objects[uiSlot].MissCode := 0;\n                Queue.Objects[uiSlot].ErrorID := 0;\n\n                Queue.Objects[uiSlot].State :=\n                    E_TrackingObjectState.OBJ_DETECTED;\n\n\n                //-------------------------------------------------------------\n                // QUEUE COUNT\n                //-------------------------------------------------------------\n                Queue.ValidCount :=\n                    MIN(\n                        Queue.ValidCount + 1,\n                        GVL.C_MAX_TRACK_OBJECTS\n                    );\n\n\t\t\t\t// Debug latched: nếu thấy 100 nghĩa là Object chắc chắn đã được ghi vào Queue.\n\t\t\t\tLastCreatedObjectID := Queue.Objects[uiSlot].ObjectID;\n\t\t\t\tLastCreatedSlot := uiSlot;\n\t\t\t\tLastCurrentPos := Queue.Objects[uiSlot].CurrentPos;\n\t\t\t\tLastProcessCode := 100;\n\t\t\t\t\n\t\t\t\tAddedObjectCount := AddedObjectCount + 1;\n\t\t\t\tNewObjectPulse := TRUE;\n\n            END_IF;\n\n        END_IF;\n\n    END_FOR;\n\nEND_IF;","LineInfoPersistence":"(string)8f214595-c697-499c-aa9a-990be417d9ea_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionObjectSource\n\nVAR_INPUT\n    Enable : BOOL;\n    Reset : BOOL;\n\n    Config : ST_VisionTrackingSourceConfig;\n\n    // Kết quả đã hoàn chỉnh từ Vision Adapter.\n    Result : ST_VisionTrackingMultiResult;\n\n    // Position Conveyor hiện tại.\n    ConveyorPositionMM : LREAL;\nEND_VAR\n\nVAR_IN_OUT\n    Queue : ST_TRACKING_QUEUE;\nEND_VAR\n\nVAR_OUTPUT\n    Active : BOOL;\n\n    // Xung khi Result mới bắt đầu được xử lý.\n    ResultAcceptedPulse : BOOL;\n\n    // Xung nếu ít nhất 1 Object mới được tạo.\n    NewObjectPulse : BOOL;\n\n    AddedObjectCount : UINT;\n    DuplicateCount : UINT;\n    RejectedCount : UINT;\n\n    Error : BOOL;\n    ErrorID : UDINT;\n\t\n\t//=============================================================================\n\t// DEBUG - GIỮ TRẠNG THÁI SAU SCAN\n\t//=============================================================================\n\tLastProcessedTriggerID : UDINT;          // Trigger cuối cùng đã thực sự xử lý.\n\tLastProcessCode : UINT;                  // Mã bước xử lý cuối cùng.\n\tLastCreatedObjectID : UDINT;             // ObjectID cuối cùng đã tạo.\n\tLastCreatedSlot : UINT;                  // Slot Queue cuối cùng đã sử dụng.\n\tLastCurrentPos : ST_POS;                 // CurrentPos tại lúc tạo Object.\n\nEND_VAR\n\nVAR\n    udiLastProcessedTriggerID : UDINT;\n\n    uiDetection : UINT;\n    uiObjectCount : UINT;\n    uiSlot : UINT;\n\n    uiProductClassID : UINT;\n\n    stPoseMM : ST_POS;\n    stPoseAtCapture : ST_POS;\n    stCurrentPos : ST_POS;\n\n    lrDeltaToCurrent : LREAL;\n\n    xDuplicate : BOOL;\nEND_VAR","LineInfoPersistence":"(string)8f214595-c697-499c-aa9a-990be417d9ea_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)420","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}