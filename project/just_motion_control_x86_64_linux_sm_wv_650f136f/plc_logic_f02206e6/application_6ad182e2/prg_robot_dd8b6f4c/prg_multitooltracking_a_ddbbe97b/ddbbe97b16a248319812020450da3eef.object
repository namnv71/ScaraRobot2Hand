{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ddbbe97b-16a2-4831-9812-020450da3eef","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_MultiToolTracking_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF GVL.X[8] THEN\n\tGVL.g_xResetTrackingObjectSourceA := TRUE;\n\tGVL.g_xMultiTrackResetTestA := TRUE;\n\tGVL.g_xClearTrackingQueueA := TRUE;\nELSE\n\tGVL.g_xResetTrackingObjectSourceA := FALSE;\n\tGVL.g_xMultiTrackResetTestA := FALSE;\n\tGVL.g_xClearTrackingQueueA := FALSE;\n\t\nEND_IF;\n\n//GVL.g_axDIA[1] := GVL.X[20];\n\n\n//=============================================================================\n// MULTI-TOOL TRACKING TEST COMMAND\n//-----------------------------------------------------------------------------\n// Chỉ tạo dữ liệu Command một lần tại cạnh lên của Start Test.\n// Sau này khi Interpreter hoạt động, phần này chỉ dùng cho Commissioning/Test.\n//=============================================================================\n\nrtMultiTrackStartTestA(CLK := GVL.g_xMultiTrackStartTestA);\nIF rtMultiTrackStartTestA.Q THEN\n    GVL.g_stMultiTrackCommandA.CommandID := GVL.g_stMultiTrackCommandA.CommandID + 1;\n\n    IF GVL.g_stMultiTrackCommandA.CommandID = 0 THEN\n        GVL.g_stMultiTrackCommandA.CommandID := 1;\n    END_IF;\n\n//     GVL.g_stMultiTrackCommandA.RecipeID := 1;\n//     GVL.g_stMultiTrackCommandA.TargetPickCountOverride := 1;\n//     GVL.g_stMultiTrackCommandA.ToolMaskOverride := DWORD#1;\n// \n//     GVL.g_aMultiTrackRecipeA[1].Enable := TRUE;\n//     GVL.g_aMultiTrackRecipeA[1].RecipeID := 1;\n//     GVL.g_aMultiTrackRecipeA[1].ProductClassID := 0;\n//     GVL.g_aMultiTrackRecipeA[1].TargetPickCount := 1;\n//     GVL.g_aMultiTrackRecipeA[1].ToolEnableMask := DWORD#1;\n\n\tGVL.g_stMultiTrackCommandA.RecipeID := 1;\n    GVL.g_stMultiTrackCommandA.TargetPickCountOverride := 1;\n    GVL.g_stMultiTrackCommandA.ToolMaskOverride := DWORD#1;\n\n    GVL.g_aMultiTrackRecipeA[1].Enable := TRUE;\n    GVL.g_aMultiTrackRecipeA[1].RecipeID := 1;\n    GVL.g_aMultiTrackRecipeA[1].ProductClassID := 0;\n    GVL.g_aMultiTrackRecipeA[1].TargetPickCount := 1;\n    GVL.g_aMultiTrackRecipeA[1].ToolEnableMask := DWORD#1;\n\n    xMultiTrackTestExecuteA := TRUE;\nEND_IF;\n\n// Khi Controller hoàn thành hoặc lỗi thì hạ Execute test.\nIF GVL.g_stMultiTrackStatusA.Done OR GVL.g_stMultiTrackStatusA.Error OR GVL.g_xMultiTrackResetTestA OR GVL.g_xMultiTrackAbortTestA THEN\n    xMultiTrackTestExecuteA := FALSE;\nEND_IF;\n\nstCommandA := GVL.g_stMultiTrackCommandA;\n\nstCommandA.Execute := GVL.g_stMultiTrackCommandA.Execute OR xMultiTrackTestExecuteA;\n\nstCommandA.Reset := GVL.g_stMultiTrackCommandA.Reset OR GVL.g_xMultiTrackResetTestA;\n\nstCommandA.Abort :=\n    GVL.g_stMultiTrackCommandA.Abort\n    OR GVL.g_xMultiTrackAbortTestA;\n\n\n//=============================================================================\n// 02. GỐC CONVEYOR VÀ OBJECT TEST\n//-----------------------------------------------------------------------------\n// Sau này thay stConveyorOriginA bằng cấu hình Conveyor thực tế trên HMI.\n//=============================================================================\n// stConveyorOriginA.X := 350.0;\n// stConveyorOriginA.Y := -200.0;\n// stConveyorOriginA.Z := 150.0;\n// stConveyorOriginA.A := 90.0;\n// stConveyorOriginA.B := 0.0;\n// stConveyorOriginA.C := 0.0;\n\nstConveyorOriginA.X := GVL.g_aConveyorRuntime[1].Config.Origin.X;\nstConveyorOriginA.Y := GVL.g_aConveyorRuntime[1].Config.Origin.Y;\nstConveyorOriginA.Z := GVL.g_aConveyorRuntime[1].Config.Origin.Z;\nstConveyorOriginA.A := GVL.g_aConveyorRuntime[1].Config.Origin.A;\nstConveyorOriginA.B := 0.0;\nstConveyorOriginA.C := 0.0;\n\nstFixedObjectPositionA := GVL.g_stTrackingSimulation.FixedObjectPosition;\n\n// Power Axis 6\nfbPower(\n    Axis := AXIS_6,\n    Enable := TRUE,\n    bRegulatorOn := TRUE,\n    bDriveStart := TRUE\n);\ni_count := 100;\ncount_cal_max := 3;\nIF GVL.Y[10] <> FALSE  THEN\n\tIF count_scan = 0 THEN\n\t\tpulse_old := AXIS_6.diActPosition;\n\tEND_IF\n\tcount_scan := count_scan + 1;\n\t\n\tIF count_scan >= i_count THEN\n\t\trPulsePerScan := TO_REAL((AXIS_6.diActPosition - pulse_old))/(i_count);\n\t\tGVL.g_HMI_PulsePerCycle_Cr := rPulsePerScan;\n\t\tcount_scan := 0;\n\t\tcount_cal := count_cal + 1;\n\tEND_IF\nEND_IF;\nudiv := udiv + 1;\n\n\nIF count_cal >= count_cal_max THEN\n\t// Phần nguyên.\n\tdiBasePulse := REAL_TO_DINT(TRUNC(rPulsePerScan));\n\t\n\t// Tích lũy phần lẻ.\n\trFractionAcc := rFractionAcc + (rPulsePerScan - DINT_TO_REAL(diBasePulse));\n\t\n\t// Mặc định chỉ tăng phần nguyên.\n\tdiPulseThisScan := diBasePulse;\n\t\n\t// Khi phần lẻ tích đủ 1 xung thì bù thêm 1.\n\tIF rFractionAcc <= -200.0 THEN\n\t\tdiPulseThisScan := diPulseThisScan - 1;\n\t\trFractionAcc := rFractionAcc + 1.0;\n\tEND_IF;\n\t\n\t// Position đưa sang encoder trung gian.\n\tIF GVL.Y[10] <> FALSE THEN\n\t\tdiSmoothCount := diSmoothCount + diPulseThisScan;\n\tEND_IF\nEND_IF\n\n\n//=============================================================================\n// 03. ENCODER ẢO\n//-----------------------------------------------------------------------------\n// Phần này được chuyển từ PRG_ConveyorTracking cũ sang PRG mới.\n//=============================================================================\nIF GVL.g_stTrackingSimulation.VirtualEncoderReset THEN\n    diVirtualEncoderA := 0;\nELSIF GVL.g_stTrackingSimulation.VirtualEncoderEnable THEN\n    diVirtualEncoderA := diVirtualEncoderA + GVL.g_stTrackingSimulation.VirtualEncoderStepPerCycle;\nEND_IF;\n\nIF GVL.g_stTrackingSimulation.Mode <> E_ApplicationSimulationMode.SIM_OFF AND GVL.g_stTrackingSimulation.VirtualEncoderEnable THEN \n\tSMC_FreeEncoder.diEncoderPosition := diVirtualEncoderA; \nELSE\n\t//SMC_FreeEncoder.diEncoderPosition := TO_DINT(AXIS_6.fActPosition);\n\t//SMC_FreeEncoder.diEncoderPosition :=AXIS_6.diActPosition;\n// \tIF udiv < 400 THEN\n// \t\tSMC_FreeEncoder.diEncoderPosition := SMC_FreeEncoder.diEncoderPosition - 10;\n// \tEND_IF\n// \tIF udiv >= 400 THEN\n// \t\tSMC_FreeEncoder.diEncoderPosition := SMC_FreeEncoder.diEncoderPosition - 11;\n// \tEND_IF\n// \tIF udiv = 3 THEN\n// \t\tSMC_FreeEncoder.diEncoderPosition := SMC_FreeEncoder.diEncoderPosition - 5;\n// \tEND_IF\n// \tIF udiv = 4 THEN\n// \t\tSMC_FreeEncoder.diEncoderPosition := SMC_FreeEncoder.diEncoderPosition - 5;\n// \tEND_IF\n\tIF GVL.Y[10] <> FALSE THEN\n\t\tSMC_FreeEncoder.diEncoderPosition := SMC_FreeEncoder.diEncoderPosition - GVL.g_HMI_PulsePerCycle_Set;\n\tEND_IF;\nEND_IF;\n\nIF udiv = 800 THEN udiv := 0; END_IF;\n//=============================================================================\n// 04. CONVEYOR RUNTIME STATUS\n//-----------------------------------------------------------------------------\n// Logical Axis SM_Drive_Logical đã được scale:\n//     fActPosition = mm\n//     fActVelocity = mm/s\n//\n// Mục đích:\n//     - Cập nhật Status cho HMI.\n//     - Làm nguồn dữ liệu chung cho Queue/Sensor/Vision.\n//     - Tracking Manager đọc cùng một nguồn trạng thái Conveyor.\n//=============================================================================\n\n//-----------------------------------------------------------------------------\n// 1. RAW POSITION / VELOCITY\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[1].Status.RawPosition :=\n    LREAL_TO_REAL(SM_Drive_Logical.fActPosition);\n\nGVL.g_aConveyorRuntime[1].Status.RawVelocity :=\n    LREAL_TO_REAL(SM_Drive_Logical.fActVelocity);\n\n\n//-----------------------------------------------------------------------------\n// 2. POSITION THEO CHIỀU QUY ƯỚC CỦA APPLICATION\n//-----------------------------------------------------------------------------\n// DirectionSign:\n//      +1 = giữ nguyên chiều Axis.\n//      -1 = đảo chiều quy ước.\nIF GVL.g_aConveyorRuntime[1].Config.DirectionSign >= 0 THEN\n    GVL.g_aConveyorRuntime[1].Status.PositionMM :=\n        LREAL_TO_REAL(SM_Drive_Logical.fActPosition);\nELSE\n    GVL.g_aConveyorRuntime[1].Status.PositionMM :=\n        -LREAL_TO_REAL(SM_Drive_Logical.fActPosition);\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 3. VELOCITY THEO CHIỀU QUY ƯỚC\n//-----------------------------------------------------------------------------\nIF GVL.g_aConveyorRuntime[1].Config.DirectionSign >= 0 THEN\n    GVL.g_aConveyorRuntime[1].Status.VelocityMMs :=\n        LREAL_TO_REAL(SM_Drive_Logical.fActVelocity);\nELSE\n    GVL.g_aConveyorRuntime[1].Status.VelocityMMs :=\n        -LREAL_TO_REAL(SM_Drive_Logical.fActVelocity);\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 4. GIỚI HẠN FILTER FACTOR 0.0 ... 1.0\n//-----------------------------------------------------------------------------\nIF GVL.g_aConveyorRuntime[1].Config.VelocityFilterFactor < 0.0 THEN\n    GVL.g_aConveyorRuntime[1].Config.VelocityFilterFactor := 0.0;\nELSIF GVL.g_aConveyorRuntime[1].Config.VelocityFilterFactor > 1.0 THEN\n    GVL.g_aConveyorRuntime[1].Config.VelocityFilterFactor := 1.0;\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 5. LOW-PASS FILTER VELOCITY\n//-----------------------------------------------------------------------------\n// FilterFactor = 1.0 : gần như lấy trực tiếp Velocity.\n// FilterFactor nhỏ   : lọc mượt hơn nhưng phản ứng chậm hơn.\nGVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs :=\n    GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs\n    + GVL.g_aConveyorRuntime[1].Config.VelocityFilterFactor\n    * (\n        GVL.g_aConveyorRuntime[1].Status.VelocityMMs\n        - GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs\n    );\n\n\n//-----------------------------------------------------------------------------\n// 6. ACCELERATION\n//-----------------------------------------------------------------------------\n// PRG_MultiToolTracking_A hiện chạy trong task 4 ms.\n// a = Delta V / 0.004 s.\nIF xConveyorRuntimeFirstScanA THEN\n\n    GVL.g_aConveyorRuntime[1].Status.AccelerationMMs2 := 0.0;\n\n    rConveyorVelocityPrevA :=\n        GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs;\n\n    xConveyorRuntimeFirstScanA := FALSE;\n\nELSE\n\n    GVL.g_aConveyorRuntime[1].Status.AccelerationMMs2 :=\n        (\n            GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs\n            - rConveyorVelocityPrevA\n        ) / 0.004;\n\n    rConveyorVelocityPrevA :=\n        GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 7. RUNNING / STANDSTILL / DIRECTION\n//-----------------------------------------------------------------------------\nIF ABS(GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs)\n    > GVL.g_aConveyorRuntime[1].Config.RunningThresholdMMs THEN\n\n    GVL.g_aConveyorRuntime[1].Status.Running := TRUE;\n    GVL.g_aConveyorRuntime[1].Status.Standstill := FALSE;\n\n    IF GVL.g_aConveyorRuntime[1].Status.FilteredVelocityMMs > 0.0 THEN\n        GVL.g_aConveyorRuntime[1].Status.Direction := 1;\n    ELSE\n        GVL.g_aConveyorRuntime[1].Status.Direction := -1;\n    END_IF;\n\nELSE\n\n    GVL.g_aConveyorRuntime[1].Status.Running := FALSE;\n    GVL.g_aConveyorRuntime[1].Status.Standstill := TRUE;\n    GVL.g_aConveyorRuntime[1].Status.Direction := 0;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// 8. VALID\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[1].Status.Valid :=\n    GVL.g_aConveyorRuntime[1].Config.Enable;\n\n\n//-----------------------------------------------------------------------------\n// 9. ERROR LIMIT CHECK\n//-----------------------------------------------------------------------------\nGVL.g_aConveyorRuntime[1].Status.Error := FALSE;\nGVL.g_aConveyorRuntime[1].Status.ErrorID := 0;\n\nIF GVL.g_aConveyorRuntime[1].Config.MaxVelocityMMs > 0.0\nAND ABS(GVL.g_aConveyorRuntime[1].Status.VelocityMMs)\n    > GVL.g_aConveyorRuntime[1].Config.MaxVelocityMMs THEN\n\n    GVL.g_aConveyorRuntime[1].Status.Error := TRUE;\n    GVL.g_aConveyorRuntime[1].Status.ErrorID := 9001;\n\nELSIF GVL.g_aConveyorRuntime[1].Config.MaxAccelerationMMs2 > 0.0\nAND ABS(GVL.g_aConveyorRuntime[1].Status.AccelerationMMs2)\n    > GVL.g_aConveyorRuntime[1].Config.MaxAccelerationMMs2 THEN\n\n    GVL.g_aConveyorRuntime[1].Status.Error := TRUE;\n    GVL.g_aConveyorRuntime[1].Status.ErrorID := 9002;\n\nEND_IF;\n\n\nrtCreateTestObjectA(CLK := GVL.g_xCreateTestTrackingObjectA);\n\nIF rtCreateTestObjectA.Q THEN\n    GVL.g_stTrackingQueue_A.NextObjectID := GVL.g_stTrackingQueue_A.NextObjectID + 1;\n    IF GVL.g_stTrackingQueue_A.NextObjectID = 0 THEN GVL.g_stTrackingQueue_A.NextObjectID := 1; END_IF;\n\n    GVL.g_stTrackingQueue_A.Objects[1].Valid := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[1].ObjectID := GVL.g_stTrackingQueue_A.NextObjectID;\n    GVL.g_stTrackingQueue_A.Objects[1].ProductClassID := 1;\n    GVL.g_stTrackingQueue_A.Objects[1].Reserved := FALSE;\n    GVL.g_stTrackingQueue_A.Objects[1].ReservedToolID := 0;\n    GVL.g_stTrackingQueue_A.Objects[1].CanPick := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[1].OrientationValid := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[1].VisionScore := 100.0;\n    GVL.g_stTrackingQueue_A.Objects[1].State := E_TrackingObjectState.OBJ_READY;\n\n    GVL.g_stTrackingQueue_A.Objects[1].VisionPos.X := 000.0;\n    GVL.g_stTrackingQueue_A.Objects[1].VisionPos.Y := 0.0;\n    GVL.g_stTrackingQueue_A.Objects[1].VisionPos.Z := 50.0;\n    GVL.g_stTrackingQueue_A.Objects[1].VisionPos.A := 0.0;\n\t\n\t//-------------------------------------------------------------------------\n\t// OBJECT 1 - POSE CHUẨN TRONG HỆ CONVEYOR\n\t//-------------------------------------------------------------------------\n\tGVL.g_stTrackingQueue_A.Objects[1].PoseInConveyor.X := 000.0;\n\tGVL.g_stTrackingQueue_A.Objects[1].PoseInConveyor.Y := 0.0;\n\tGVL.g_stTrackingQueue_A.Objects[1].PoseInConveyor.Z := 50.0;\n\tGVL.g_stTrackingQueue_A.Objects[1].PoseInConveyor.A := 0.0;\n\n\t\n\t// Chốt vị trí Conveyor đúng thời điểm Object được tạo.\n\tGVL.g_stTrackingQueue_A.Objects[1].CaptureConveyorPositionMM :=\n\t\tREAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM);\n\t\n\t//---------------------------------------------------------------------\n    // OBJECT 2\n    //---------------------------------------------------------------------\n    GVL.g_stTrackingQueue_A.NextObjectID :=\n        GVL.g_stTrackingQueue_A.NextObjectID + 1;\n\n    IF GVL.g_stTrackingQueue_A.NextObjectID = 0 THEN\n        GVL.g_stTrackingQueue_A.NextObjectID := 1;\n    END_IF;\n\n    GVL.g_stTrackingQueue_A.Objects[2].Valid := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[2].ObjectID :=\n        GVL.g_stTrackingQueue_A.NextObjectID;\n    GVL.g_stTrackingQueue_A.Objects[2].ProductClassID := 1;\n    GVL.g_stTrackingQueue_A.Objects[2].Reserved := FALSE;\n    GVL.g_stTrackingQueue_A.Objects[2].ReservedToolID := 0;\n    GVL.g_stTrackingQueue_A.Objects[2].CanPick := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[2].OrientationValid := TRUE;\n    GVL.g_stTrackingQueue_A.Objects[2].VisionScore := 100.0;\n    GVL.g_stTrackingQueue_A.Objects[2].State := E_TrackingObjectState.OBJ_READY;\n\n    // Đặt cách Object 1 một khoảng để dễ quan sát.\n    GVL.g_stTrackingQueue_A.Objects[2].VisionPos.X := 260.0;\n    GVL.g_stTrackingQueue_A.Objects[2].VisionPos.Y := 0.0;\n    GVL.g_stTrackingQueue_A.Objects[2].VisionPos.Z := 50.0;\n    GVL.g_stTrackingQueue_A.Objects[2].VisionPos.A := 0.0;\n\t\n\t//-------------------------------------------------------------------------\n\t// OBJECT 2 - POSE CHUẨN TRONG HỆ CONVEYOR\n\t//-------------------------------------------------------------------------\n\tGVL.g_stTrackingQueue_A.Objects[2].PoseInConveyor.X := 260.0;\n\tGVL.g_stTrackingQueue_A.Objects[2].PoseInConveyor.Y := 0.0;\n\tGVL.g_stTrackingQueue_A.Objects[2].PoseInConveyor.Z := 50.0;\n\tGVL.g_stTrackingQueue_A.Objects[2].PoseInConveyor.A := 0.0;\n\n\t\n\tGVL.g_stTrackingQueue_A.Objects[2].CaptureConveyorPositionMM :=\n\t\tREAL_TO_LREAL(GVL.g_aConveyorRuntime[1].Status.PositionMM);\n\n    GVL.g_stTrackingQueue_A.ValidCount := 2;\n    GVL.g_stTrackingQueue_A.ActiveIndex := GVL.C_INVALID_INDEX;\n\t\n\n//     GVL.g_stTrackingQueue_A.ValidCount := 1;\n    GVL.g_stTrackingQueue_A.ActiveIndex := GVL.C_INVALID_INDEX;\nEND_IF;\n\n\n//=============================================================================\n// KHỞI TẠO CẤU HÌNH MẶC ĐỊNH CHO MULTI-TOOL ROBOT A\n//-----------------------------------------------------------------------------\n// Chỉ chạy một lần khi cấu hình chưa được khởi tạo hoặc khi người dùng yêu cầu\n// khởi tạo lại. Không ghi đè cấu hình HMI trong mỗi vòng quét PLC.\n//=============================================================================\nIF (NOT GVL.g_xMultiToolConfigInitializedA OR GVL.g_xInitializeMultiToolConfigA) AND (1=2) THEN\n\n    //-------------------------------------------------------------------------\n    // TOOL 1\n    //-------------------------------------------------------------------------\n\tGVL.g_aToolConfigA[1].Enable := TRUE;\n\tGVL.g_aToolConfigA[1].AllowTracking := TRUE;\n\tGVL.g_aToolConfigA[1].ToolID := 1;\n\tGVL.g_aToolConfigA[1].AllowedProductClassID := 0;\n\t\n\n    //-------------------------------------------------------------------------\n    // RECIPE 1 DÙNG CHO COMMISSIONING\n    //-------------------------------------------------------------------------\n    GVL.g_aMultiTrackRecipeA[1].Enable := TRUE;\n    GVL.g_aMultiTrackRecipeA[1].RecipeID := 1;\n    GVL.g_aMultiTrackRecipeA[1].ProductClassID := 0;\n    GVL.g_aMultiTrackRecipeA[1].TargetPickCount := 1;\n    GVL.g_aMultiTrackRecipeA[1].ToolEnableMask := DWORD#1;\n\t\n\tGVL.g_aToolConfigA[1].PickOffset.X := 0.0;\n\tGVL.g_aToolConfigA[1].PickOffset.Y := 0.0;\n\tGVL.g_aToolConfigA[1].PickOffset.Z := 50.0;\n\tGVL.g_aToolConfigA[1].PickOffset.A := 0.0;\n\t\n\tGVL.g_aToolConfigA[1].ApproachHeight := 20.0;\n\tGVL.g_aToolConfigA[1].UseUpDown := FALSE;\n\tGVL.g_aToolConfigA[1].UpDownStroke := 20.0;\n\t\n\tGVL.g_stTrackingConfig_A.RetractHeight := 20.0;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// TOOL 2\n\t//-------------------------------------------------------------------------\n\tGVL.g_aToolConfigA[2].Enable := TRUE;\n\tGVL.g_aToolConfigA[2].AllowTracking := TRUE;\n\tGVL.g_aToolConfigA[2].ToolID := 2;\n\tGVL.g_aToolConfigA[2].AllowedProductClassID := 0;\n\t\n\tGVL.g_aToolConfigA[2].PickOffset.X := 0.0;\n\tGVL.g_aToolConfigA[2].PickOffset.Y := 0.0;\n\tGVL.g_aToolConfigA[2].PickOffset.Z := 50.0;\n\tGVL.g_aToolConfigA[2].PickOffset.A := 0.0;\n\t\n\tGVL.g_aToolConfigA[2].ApproachHeight := 20.0;\n\t\n\t// Có thể đặt khác Tool 1 để quan sát.\n\tGVL.g_aToolConfigA[2].UseUpDown := FALSE;\n\tGVL.g_aToolConfigA[2].UpDownStroke := 20.0;\n\t\n\tGVL.g_aToolConfigA[2].Priority := 2;\n\n\n\t//=============================================================================\n\t// DYNAMIC APPROACH\n\t//-----------------------------------------------------------------------------\n\t// Thông số thử nghiệm ban đầu. Có thể chỉnh lại trên HMI sau.\n\t//=============================================================================\n\tGVL.g_stTrackingConfig_A.Motion.Approach.Speed := 100.0;\n\tGVL.g_stTrackingConfig_A.Motion.Approach.Acceleration := 500.0;\n\tGVL.g_stTrackingConfig_A.Motion.Approach.Deceleration := 500.0;\n\tGVL.g_stTrackingConfig_A.Motion.Approach.Jerk := 1000.0;\n\tGVL.g_stTrackingConfig_A.Motion.Approach.BlendRadius := 0.0;\n\t\n\tGVL.g_stTrackingSimulation.VirtualEncoderStepPerCycle := -5;\n\n    //-------------------------------------------------------------------------\n    // ĐÁNH DẤU ĐÃ KHỞI TẠO\n    //-------------------------------------------------------------------------\n    GVL.g_xMultiToolConfigInitializedA := TRUE;\n    GVL.g_xInitializeMultiToolConfigA := FALSE;\n\nEND_IF;\n\n//=============================================================================\n// PHỤC HỒI DỮ LIỆU COMMISSIONING KHI RESET MULTI-TOOL\n//-----------------------------------------------------------------------------\n// Chỉ dùng khi test Object cố định.\n// Khi chạy Vision/Sensor thật, Object lỗi phải được loại bỏ hoặc nạp Object mới.\n//=============================================================================\nIF GVL.g_xMultiTrackResetTestA THEN\n\n\n\t//---------------------------------------------------------------------\n    // RESET TOOL 1\n    //---------------------------------------------------------------------\n    GVL.g_aToolStatusA[1].Busy := FALSE;\n    GVL.g_aToolStatusA[1].Occupied := FALSE;\n    GVL.g_aToolStatusA[1].Error := FALSE;\n    GVL.g_aToolStatusA[1].ErrorID := 0;\n    GVL.g_aToolStatusA[1].HeldObjectID := 0;\n    GVL.g_aToolStatusA[1].GripOK := FALSE;\n\n    //---------------------------------------------------------------------\n    // RESET TOOL 2\n    //---------------------------------------------------------------------\n    GVL.g_aToolStatusA[2].Busy := FALSE;\n    GVL.g_aToolStatusA[2].Occupied := FALSE;\n    GVL.g_aToolStatusA[2].Error := FALSE;\n    GVL.g_aToolStatusA[2].ErrorID := 0;\n    GVL.g_aToolStatusA[2].HeldObjectID := 0;\n    GVL.g_aToolStatusA[2].GripOK := FALSE;\n\t\n\t// Comment lai vi dang test object thuc\n\n//     //---------------------------------------------------------------------\n//     // RESET OBJECT 1\n//     //---------------------------------------------------------------------\n//     GVL.g_stTrackingQueue_A.Objects[1].Valid := TRUE;\n//     GVL.g_stTrackingQueue_A.Objects[1].CanPick := TRUE;\n//     GVL.g_stTrackingQueue_A.Objects[1].Reserved := FALSE;\n//     GVL.g_stTrackingQueue_A.Objects[1].ReservedToolID := 0;\n//     GVL.g_stTrackingQueue_A.Objects[1].State :=\n//         E_TrackingObjectState.OBJ_READY;\n// \n//     //---------------------------------------------------------------------\n//     // RESET OBJECT 2\n//     //---------------------------------------------------------------------\n//     GVL.g_stTrackingQueue_A.Objects[2].Valid := TRUE;\n//     GVL.g_stTrackingQueue_A.Objects[2].CanPick := TRUE;\n//     GVL.g_stTrackingQueue_A.Objects[2].Reserved := FALSE;\n//     GVL.g_stTrackingQueue_A.Objects[2].ReservedToolID := 0;\n//     GVL.g_stTrackingQueue_A.Objects[2].State :=\n//         E_TrackingObjectState.OBJ_READY;\n// \n//     GVL.g_stTrackingQueue_A.ValidCount := 2;\n//     GVL.g_stTrackingQueue_A.ActiveIndex := GVL.C_INVALID_INDEX;\n\nEND_IF;\n\nIF stCommandA.Reset THEN\n    udiDebugCoreStartCountA := 0;\n    udiDebugExecuteToCoreCountA := 0;\n    udiDebugCoreRequestCountA := 0;\n\n    xDebugCoreStartLatchedA := FALSE;\n    xDebugExecuteToCoreLatchedA := FALSE;\n    xDebugCoreRequestLatchedA := FALSE;\n\tGVL.g_xMultiTrackStartTestA := FALSE;\nEND_IF;\n\n//=============================================================================\n// 04. MULTI-TOOL CONTROLLER\n//-----------------------------------------------------------------------------\n// Controller đọc phản hồi của Core, SelectTool và ToolManager từ vòng quét trước.\n//=============================================================================\nfbControllerA(\n    Command := stCommandA,\n    CoreAccepted := fbCoreInterfaceA.Accepted,\n    CoreBusy := fbCoreInterfaceA.Busy,\n    CoreSyncOK := fbCoreInterfaceA.SyncOK,\n    CorePCSInUse := fbCoreInterfaceA.PCSInUse,\n    CoreReleased := fbCoreInterfaceA.Released,\n    CoreError := fbCoreInterfaceA.Error,\n    CoreErrorID := fbCoreInterfaceA.ErrorID,\n    SelectToolDone := fbSelectToolA.Done,\n    SelectToolError := fbSelectToolA.Error,\n    SelectToolErrorID := fbSelectToolA.ErrorID,\n    Queue := GVL.g_stTrackingQueue_A,\n    ToolConfig := GVL.g_aToolConfigA,\n    ToolStatus := GVL.g_aToolStatusA,\n    Recipes := GVL.g_aMultiTrackRecipeA,\n    Status := GVL.g_stMultiTrackStatusA\n);\n\n\n//=============================================================================\n// MULTI-TOOL TRACKING RESULT LATCH\n//=============================================================================\n\n// Command mới được Controller nhận -> xóa kết quả command trước.\nIF GVL.g_stMultiTrackStatusA.Accepted THEN\n    GVL.g_xTrackOKA := FALSE;\n    GVL.g_xTrackErrorA := FALSE;\n    GVL.g_udiTrackErrorIDA := 0;\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// TRACKING PICK HOÀN THÀNH ĐỦ SỐ LƯỢNG.\n//-----------------------------------------------------------------------------\nIF GVL.g_stMultiTrackStatusA.Done\nAND NOT GVL.g_stMultiTrackStatusA.Error\nAND GVL.g_stMultiTrackStatusA.PickedCount >= GVL.g_stMultiTrackStatusA.TargetPickCount THEN\n\n    GVL.g_xTrackOKA := TRUE;\n    GVL.g_xTrackErrorA := FALSE;\n    GVL.g_udiTrackErrorIDA := 0;\n\n    // Chốt CommandID của đúng lệnh vừa hoàn thành.\n    GVL.g_udiTrackDoneCommandIDA :=\n        GVL.g_stMultiTrackStatusA.ResponseCommandID;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// TRACKING ERROR.\n//-----------------------------------------------------------------------------\nIF GVL.g_stMultiTrackStatusA.Error THEN\n\n    GVL.g_xTrackOKA := FALSE;\n    GVL.g_xTrackErrorA := TRUE;\n    GVL.g_udiTrackErrorIDA :=\n        GVL.g_stMultiTrackStatusA.ErrorID;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// RESET.\n//-----------------------------------------------------------------------------\nIF stCommandA.Reset THEN\n\n    GVL.g_xTrackOKA := FALSE;\n    GVL.g_xTrackErrorA := FALSE;\n    GVL.g_udiTrackErrorIDA := 0;\n    GVL.g_udiTrackDoneCommandIDA := 0;\n\nEND_IF;\n\n\n\n//=============================================================================\n// 05. TRACKING CORE INTERFACE\n//-----------------------------------------------------------------------------\n// Interface giữ Execute cho Tracking Core và chỉ hạ sau khi PCS đã release.\n//=============================================================================\nfbCoreInterfaceA(\n    Enable := TRUE,\n    Reset := fbControllerA.CoreReset,\n    Abort := fbControllerA.CoreAbort,\n    StartTracking := fbControllerA.CoreStart,\n    ReleaseTracking := fbControllerA.CoreRelease,\n    ObjectIndex := fbControllerA.CoreObjectIndex,\n    ToolID := fbControllerA.CoreToolID,\n    PickOffset := fbControllerA.CorePickOffset,\n    ApproachHeight := fbControllerA.CoreApproachHeight,\n\tPickSurfaceHeightMM := fbControllerA.CorePickSurfaceHeightMM,\n    CoreAccepted := GVL.g_stTrackingRuntime_A.Response.Accepted,\n\tCoreBusy := GVL.g_stTrackingRuntime_A.Response.Busy,\n\tCoreSyncOK := fbTrackingManagerA.SyncOK,\n\tCorePCSInUse := GVL.g_stTrackingRuntime_A.PCSInfo.InUse,\n\tCoreReleased := fbTrackingManagerA.Released,\n\tCoreError := GVL.g_stTrackingRuntime_A.Response.Error,\n\tCoreErrorID := GVL.g_stTrackingRuntime_A.Response.ErrorID,\n\tUseUpDown := fbControllerA.CoreUseUpDown,\n\tUpDownStroke := fbControllerA.CoreUpDownStroke,\n);\n\n\n//=============================================================================\n// 06. CHỌN TOOL/TCP ROBOT A\n//-----------------------------------------------------------------------------\n// FB_SelectRobotTool phải gọi SMC_GroupSetTool thực tế, không dùng placeholder.\n//=============================================================================\nfbSelectToolA(\n    Execute := fbControllerA.SelectToolExecute,\n    Reset := stCommandA.Reset,\n    ToolID := fbControllerA.SelectToolID\n);\n\n\n// xTrackingRequestValid :=\n//     fbCoreInterfaceA.ExecuteToCore\n//     AND fbCoreInterfaceA.ActiveObjectIndex >= 1\n//     AND fbCoreInterfaceA.ActiveObjectIndex <= GVL.C_MAX_TRACK_OBJECTS\n//     AND GVL.g_stTrackingQueue_A.Objects[fbCoreInterfaceA.ActiveObjectIndex].Valid;\n\t\nxCoreRequestValid := fbCoreInterfaceA.ExecuteToCore\nAND fbCoreInterfaceA.ActiveObjectIndex >= 1\nAND fbCoreInterfaceA.ActiveObjectIndex <= GVL.C_MAX_TRACK_OBJECTS\nAND GVL.g_stTrackingQueue_A.Objects[fbCoreInterfaceA.ActiveObjectIndex].Valid;\n\nrtDebugCoreStartA(CLK := fbControllerA.CoreStart);\nrtDebugExecuteToCoreA(CLK := fbCoreInterfaceA.ExecuteToCore);\nrtDebugCoreRequestValidA(CLK := xCoreRequestValid);\n\nIF rtDebugCoreStartA.Q THEN\n    udiDebugCoreStartCountA := udiDebugCoreStartCountA + 1;\n    xDebugCoreStartLatchedA := TRUE;\nEND_IF;\n\nIF rtDebugExecuteToCoreA.Q THEN\n    udiDebugExecuteToCoreCountA := udiDebugExecuteToCoreCountA + 1;\n    xDebugExecuteToCoreLatchedA := TRUE;\nEND_IF;\n\nIF rtDebugCoreRequestValidA.Q THEN\n    udiDebugCoreRequestCountA := udiDebugCoreRequestCountA + 1;\n    xDebugCoreRequestLatchedA := TRUE;\nEND_IF;\n\n\n//=============================================================================\n// 07. TRACKING CORE\n//-----------------------------------------------------------------------------\n// Multi-tool mode luôn dùng UseExternalSelection = TRUE.\n// Controller đã chọn ObjectIndex và PickOffset theo Tool.\n//=============================================================================\nfbTrackingManagerA(\n    Execute := xCoreRequestValid,\n    Reset := fbCoreInterfaceA.ResetToCore OR stCommandA.Reset,\n    Config := GVL.g_stTrackingConfig_A,\n    ConveyorConfig := GVL.g_aConveyorRuntime[1].Config,\n    ConveyorStatus := GVL.g_aConveyorRuntime[1].Status,\n    ConveyorOrigin := stConveyorOriginA,\n    VacuumOK := FALSE,\n    MotionAccepted := GVL.g_xTrackingMotionAccepted,\n    MotionBusy := GVL.g_xTrackingMotionBusy,\n    MotionDone := GVL.g_xTrackingMotionDone,\n    MotionError := GVL.g_xTrackingMotionError,\n    MotionErrorID := GVL.g_udiTrackingMotionErrorID,\n    MotionAbortDone := GVL.g_xTrackingMotionAbortDone,\n    TestFixedObjectMode := FALSE,\n    FixedObjectPosition := stFixedObjectPositionA,\n    UseExternalSelection := TRUE,\n    ExternalObjectIndex := fbCoreInterfaceA.ActiveObjectIndex,\n    ExternalPickOffset := fbCoreInterfaceA.ActivePickOffset,\n    ExternalApproachHeight := fbCoreInterfaceA.ActiveApproachHeight,\n    PickerSafe := fbCoreInterfaceA.PickerSafeToCore,\n    Queue := GVL.g_stTrackingQueue_A,\n    Runtime := GVL.g_stTrackingRuntime_A,\n\tExternalUseUpDown := fbCoreInterfaceA.ActiveUseUpDown,\n\tExternalUpDownStroke := fbCoreInterfaceA.ActiveUpDownStroke,\n\tExternalPickSurfaceHeightMM := fbCoreInterfaceA.ActivePickSurfaceHeightMM,\n);\n\n\n//=============================================================================\n// 08. MAP PHẢN HỒI TRACKING CORE\n//-----------------------------------------------------------------------------\n// Các biến này được FB_TrackingCoreInterface_A đọc ở vòng quét tiếp theo.\n//=============================================================================\nGVL.g_xTrackingCoreAcceptedA := GVL.g_stTrackingRuntime_A.Response.Accepted;\nGVL.g_xTrackingCoreBusyA := GVL.g_stTrackingRuntime_A.Response.Busy;\nGVL.g_xTrackingCoreSyncOKA := fbTrackingManagerA.SyncOK;\nGVL.g_xTrackingCorePCSInUseA := GVL.g_stTrackingRuntime_A.PCSInfo.InUse;\nGVL.g_xTrackingCoreReleasedA := fbTrackingManagerA.Released;\nGVL.g_xTrackingCoreErrorA := GVL.g_stTrackingRuntime_A.Response.Error;\nGVL.g_udiTrackingCoreErrorIDA := GVL.g_stTrackingRuntime_A.Response.ErrorID;\n\n\n//=============================================================================\n// 09. MOTION QUEUE ADAPTER\n//-----------------------------------------------------------------------------\n// Chỉ instance này được đưa motion Tracking vào Motion Queue Robot A.\n//=============================================================================\nfbMotionAdapterA(\n    Enable := TRUE,\n    Reset := fbCoreInterfaceA.ResetToCore OR stCommandA.Reset,\n    Request := fbTrackingManagerA.MotionRequest,\n    Abort := fbTrackingManagerA.MotionAbort,\n    Target := fbTrackingManagerA.MotionTarget,\n    Speed := fbTrackingManagerA.MotionSpeed,\n    Acceleration := fbTrackingManagerA.MotionAcceleration,\n    Deceleration := fbTrackingManagerA.MotionDeceleration,\n    Jerk := fbTrackingManagerA.MotionJerk,\n    BlendRadius := fbTrackingManagerA.MotionBlendRadius,\n    CoordSystem := fbTrackingManagerA.MotionCoordSystem,\n    Command := fbTrackingManagerA.MotionCommand,\n    LogicSimulation := GVL.g_stTrackingSimulation.Mode = E_ApplicationSimulationMode.SIM_LOGIC_ONLY,\n    LogicMotionDuration := GVL.g_stTrackingSimulation.LogicMotionDuration,\n    Accepted => GVL.g_xTrackingMotionAccepted,\n    Busy => GVL.g_xTrackingMotionBusy,\n    Done => GVL.g_xTrackingMotionDone,\n    Error => GVL.g_xTrackingMotionError,\n    ErrorID => GVL.g_udiTrackingMotionErrorID,\n    AbortDone => GVL.g_xTrackingMotionAbortDone\n);\n\n\n//=============================================================================\n// 10. PHÂN PHỐI COMMAND TỚI TỪNG TOOL MANAGER\n//-----------------------------------------------------------------------------\n// Chỉ Tool có ToolID trùng Command mới nhận Execute.\n// Các Tool còn lại vẫn được gọi mỗi vòng quét để duy trì Runtime và Output.\n//=============================================================================\nFOR uiTool := 1 TO GVL.C_MAX_TOOLS DO\n\t\n\t// Tất cả OUTPUT mặc định Active HIGH.\n\tGVL.g_aToolConfigA[uiTool].IO.DownDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.UpDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.GripDOActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.ReleaseDOActiveLevel := TRUE;\n\t\n\t// Tất cả INPUT feedback mặc định Active HIGH.\n\tGVL.g_aToolConfigA[uiTool].IO.DownOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.UpOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.GripOKDIActiveLevel := TRUE;\n\tGVL.g_aToolConfigA[uiTool].IO.PartPresentDIActiveLevel := TRUE;\n\t\n    astToolCommandA[uiTool].Execute := FALSE;\n    astToolCommandA[uiTool].Reset := stCommandA.Reset;\n    astToolCommandA[uiTool].Abort := stCommandA.Abort;\n    astToolCommandA[uiTool].CommandID := 0;\n    astToolCommandA[uiTool].ToolID := GVL.g_aToolConfigA[uiTool].ToolID;\n    astToolCommandA[uiTool].CommandType := E_ToolCommandType.NONE;\n    astToolCommandA[uiTool].ObjectID := 0;\n\n    //IF fbControllerA.ToolCommand.ToolID = GVL.g_aToolConfigA[uiTool].ToolID THEN astToolCommandA[uiTool] := fbControllerA.ToolCommand; END_IF;\n\t\n//-------------------------------------------------------------------------\n\t// ƯU TIÊN 1: Command từ MultiTool Tracking Controller.\n\t//-------------------------------------------------------------------------\n\tIF fbControllerA.ToolCommand.Execute\n\tAND fbControllerA.ToolCommand.ToolID = GVL.g_aToolConfigA[uiTool].ToolID THEN\n\t\n\t\tastToolCommandA[uiTool] := fbControllerA.ToolCommand;\n\t\n\t\n\t//-------------------------------------------------------------------------\n\t// ƯU TIÊN 2: Command Tool độc lập từ Interpreter.\n\t// Chỉ chạy khi Controller không phát Tool Command.\n\t//-------------------------------------------------------------------------\n\tELSIF GVL.g_stInterpreterToolCommandA.Execute\n\tAND GVL.g_stInterpreterToolCommandA.ToolID = GVL.g_aToolConfigA[uiTool].ToolID THEN\n\t\n\t\tastToolCommandA[uiTool] :=\n\t\t\tGVL.g_stInterpreterToolCommandA;\n\t\n\tEND_IF;\n\n    fbToolManagerA[uiTool](\n        Enable := GVL.g_aToolConfigA[uiTool].Enable,\n        Command := astToolCommandA[uiTool],\n        Config := GVL.g_aToolConfigA[uiTool],\n        Status := GVL.g_aToolStatusA[uiTool]\n    );\nEND_FOR;\n\n\n//=============================================================================\n// 11. BIẾN GIÁM SÁT HMI / DEBUG\n//=============================================================================\nGVL.g_xMultiTrackCoreExecuteA := fbCoreInterfaceA.ExecuteToCore;\nGVL.g_xMultiTrackCoreResetA := fbCoreInterfaceA.ResetToCore;\nGVL.g_xMultiTrackCoreAbortA := fbCoreInterfaceA.AbortToCore;\nGVL.g_xMultiTrackPickerSafeA := fbCoreInterfaceA.PickerSafeToCore;\nGVL.g_uiMultiTrackObjectIndexA := fbCoreInterfaceA.ActiveObjectIndex;\nGVL.g_uiMultiTrackToolIDA := fbCoreInterfaceA.ActiveToolID;\nGVL.g_stMultiTrackPickOffsetA := fbCoreInterfaceA.ActivePickOffset;\nGVL.g_rMultiTrackApproachHeightA := fbCoreInterfaceA.ActiveApproachHeight;\nGVL.g_xSelectToolExecuteA := fbControllerA.SelectToolExecute;\nGVL.g_uiSelectToolIDA := fbControllerA.SelectToolID;\nGVL.g_stSelectToolTCPA := fbControllerA.SelectToolTCP;\nGVL.g_xSelectToolDoneA := fbSelectToolA.Done;\nGVL.g_xSelectToolErrorA := fbSelectToolA.Error;\nGVL.g_udiSelectToolErrorIDA := fbSelectToolA.ErrorID;\n\n\n//=============================================================================\n// 12. OUTPUT CŨ CỦA TRACKING CORE\n//-----------------------------------------------------------------------------\n// Multi-tool mode không dùng VacuumCommand/BlowCommand; giữ map để debug.\n//=============================================================================\nGVL.g_xTrackingVacuumOutput := fbTrackingManagerA.VacuumCommand;\nGVL.g_xTrackingBlowOutput := fbTrackingManagerA.BlowCommand;","LineInfoPersistence":"(string)ddbbe97b-16a2-4831-9812-020450da3eef_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_MultiToolTracking_A\nVAR\n    // Bộ điều phối Multi-tool.\n    fbControllerA : FB_MultiToolTrackingController_A;\n\n    // Chuẩn hóa handshake giữa Controller và Tracking Core.\n    fbCoreInterfaceA : FB_TrackingCoreInterface_A;\n\n    // Tracking Core tạo PCS, chạy Approach và thoát PCS.\n    fbTrackingManagerA : FB_CONVEYOR_TRACKING_MANAGER;\n\n    // Adapter đưg_stTrackingConfig_Aing Core vào Motion Queue Robot A.\n    fbMotionAdapterA : FB_TrackingMotionQueueAdapter;\n\n    // Chọn TCP/Tool hiện hành của AxisGroup Robot A.\n    fbSelectToolA : FB_SelectRobotTool;\n\n    // Một Tool Manager độc lập cho mỗi Tool.\n    fbToolManagerA : ARRAY[0..GVL.C_MAX_TOOLS] OF FB_ToolManager;\n\n    // Command riêng gửi tới từng Tool Manager.\n    astToolCommandA : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolCommand;\n\n    // Command cục bộ, tránh ghi ngược vào Command của Interpreter.\n    stCommandA : ST_MultiToolTrackingCommand;\n\n    // Gốc Conveyor dùng cho test hiện tại.\n    stConveyorOriginA : MC_COORD_REF;\n\n    // Vị trí Object cố định chỉ dùng khi test riêng Tracking Core.\n    stFixedObjectPositionA : MC_COORD_REF;\n\n    // Encoder ảo dùng khi Simulation khác SIM_OFF.\n    diVirtualEncoderA : DINT;\n\n    // Index vòng lặp Tool.\n    uiTool : UINT;\n\txTrackingRequestValid : BOOL;\n\t\n\trtCreateTestObjectA : R_TRIG;\n\txCoreRequestValid : BOOL;\n\trtMultiTrackStartTestA : R_TRIG;\n\txMultiTrackTestExecuteA : BOOL := FALSE;\n\t\n\trtDebugCoreStartA : R_TRIG;\n\trtDebugExecuteToCoreA : R_TRIG;\n\trtDebugCoreRequestValidA : R_TRIG;\n\t\n\tudiDebugCoreStartCountA : UDINT;\n\tudiDebugExecuteToCoreCountA : UDINT;\n\tudiDebugCoreRequestCountA : UDINT;\n\t\n\txDebugCoreStartLatchedA : BOOL;\n\txDebugExecuteToCoreLatchedA : BOOL;\n\txDebugCoreRequestLatchedA : BOOL;\n\t\n\t//=============================================================================\n\t// CONVEYOR RUNTIME\n\t//=============================================================================\n\trConveyorVelocityPrevA : REAL;          // Vận tốc filtered của scan trước.\n\txConveyorRuntimeFirstScanA : BOOL := TRUE; // Chống spike Acceleration khi khởi động.\n\n\tfbPower : MC_Power;\n\t\n\t// Khai bao phan tinh delta pulse moi vong quet\n\tcount_scan, i_count, udiv, count_cal_max, count_cal : INT;\n\tpulse_old, pulse_track  : DINT;\n\tdelta : REAL;\nEND_VAR\n\nVAR\n    rPulsePerScan : REAL;\n    rFractionAcc : REAL;\n\n    diBasePulse : DINT;\n    diPulseThisScan : DINT;\n    diSmoothCount : DINT;\nEND_VAR","LineInfoPersistence":"(string)ddbbe97b-16a2-4831-9812-020450da3eef_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)952","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}