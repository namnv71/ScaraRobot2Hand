{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)5bda07ef-d301-473e-a3d2-6a69cda2b5e2","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_TrackingObjectState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0710103f-fbdc-4582-87a9-dd50a9877f7d"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// ENUM: TRACKING OBJECT STATE\n//-----------------------------------------------------------------------------\n// Trạng thái vòng đời của một Object trong Queue.\n//=============================================================================\n{attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_TrackingObjectState :\n(\n    \n\tOBJ_EMPTY := 0,                   // Slot chưa chứa sản phẩm.\n\n    OBJ_CAPTURED := 10,               // Camera đã được trigger và encoder đã được chốt.\n    OBJ_WAIT_VISION := 20,            // Đang chờ vision trả kết quả.\n    OBJ_DETECTED := 30,               // Vision đã tìm thấy sản phẩm.\n    OBJ_INSPECTION_PASS := 40,         // Sản phẩm đã kiểm tra và đạt.\n    OBJ_INSPECTION_FAIL := 50,         // Sản phẩm đã kiểm tra và không đạt.\n    OBJ_WAIT_PICK_ZONE := 60,          // Sản phẩm chưa vào vùng gắp.\n    OBJ_READY := 70,                   // Sản phẩm đã vào vùng gắp.\n    OBJ_RESERVED := 80,                // Robot đã giữ quyền xử lý sản phẩm.\n    OBJ_PCS_READY := 90,               // Dynamic PCS của sản phẩm đã được tạo.\n    OBJ_TRACKING := 100,               // Robot đang bám theo sản phẩm.\n    OBJ_PICKING := 110,                // Robot đang thực hiện thao tác gắp.\n    OBJ_PICKED := 120,                 // Sản phẩm đã được gắp thành công.\n    OBJ_REJECTED := 130,               // Sản phẩm bị loại.\n    OBJ_EXPIRED := 140,                // Sản phẩm đã đi quá vùng robot.\n\tOBJ_MISSED  := 145,\t\t\t\t   // Đã được robot chọn nhưng không còn đủ thời gian/vùng an toàn để gắp.\n    OBJ_ABORTED := 150,                // Xử lý sản phẩm bị hủy.\n\n    OBJ_ERROR := 900                   // Object gặp lỗi xử lý.\n);\nEND_TYPE\n","LineInfoPersistence":"(string)5bda07ef-d301-473e-a3d2-6a69cda2b5e2_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)33"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}