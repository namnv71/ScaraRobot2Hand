{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ef13459a-9d9f-4785-8fc1-42995780a9c2","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_MultiToolTrackingCommand","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: MULTI-TOOL TRACKING COMMAND\n//=============================================================================\nTYPE ST_MultiToolTrackingCommand :\nSTRUCT\n\n    // Giữ TRUE trong suốt thời gian chạy lệnh.\n    Execute : BOOL;\n\n    // Reset application.\n    Reset : BOOL;\n\n    // Abort application.\n    Abort : BOOL;\n\n    // ID command.\n    CommandID : UDINT;\n\n    // Recipe cần chạy.\n    RecipeID : UINT;\n\n    // 0 = dùng TargetPickCount trong Recipe.\n    TargetPickCountOverride : UINT;\n\n    // 0 = dùng ToolEnableMask trong Recipe.\n    ToolMaskOverride : DWORD;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)ef13459a-9d9f-4785-8fc1-42995780a9c2_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)30"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a3