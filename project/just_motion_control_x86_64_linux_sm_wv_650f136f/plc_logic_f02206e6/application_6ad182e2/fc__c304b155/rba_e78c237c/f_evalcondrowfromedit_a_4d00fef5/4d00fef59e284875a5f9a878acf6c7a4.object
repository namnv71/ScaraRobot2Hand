{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4d00fef5-9e28-4875-a5f9-a878acf6c7a4","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_EvalCondRowFromEdit_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)e78c237c-5698-4814-b7d2-7c8b55d80bb7"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF (RowNo < 1) OR (RowNo > 10) THEN\n    F_EvalCondRowFromEdit_A := FALSE;\n    RETURN;\nEND_IF;\n\nIF NOT GVL.HMI_A_CondEditRowEnable[RowNo] THEN\n    F_EvalCondRowFromEdit_A := TRUE;\n    RETURN;\nEND_IF;\n\n// Đọc giá trị thực tế hiện tại\nactualValue := F_GetCondValue_A(\n    Source := GVL.HMI_A_CondEditSource[RowNo],\n    Index  := GVL.HMI_A_CondEditIndex[RowNo]\n);\n\n// Lưu actual value để HMI hiển thị\nGVL.HMI_A_CondMonActualValue[RowNo] := actualValue;\n\n// So sánh theo operator\nCASE GVL.HMI_A_CondEditOperator[RowNo] OF\n    1: F_EvalCondRowFromEdit_A := actualValue = GVL.HMI_A_CondEditSetValue[RowNo];\n    2: F_EvalCondRowFromEdit_A := actualValue <> GVL.HMI_A_CondEditSetValue[RowNo];\n    3: F_EvalCondRowFromEdit_A := actualValue >  GVL.HMI_A_CondEditSetValue[RowNo];\n    4: F_EvalCondRowFromEdit_A := actualValue >= GVL.HMI_A_CondEditSetValue[RowNo];\n    5: F_EvalCondRowFromEdit_A := actualValue <  GVL.HMI_A_CondEditSetValue[RowNo];\n    6: F_EvalCondRowFromEdit_A := actualValue <= GVL.HMI_A_CondEditSetValue[RowNo];\nELSE\n    F_EvalCondRowFromEdit_A := FALSE;\nEND_CASE;","LineInfoPersistence":"(string)4d00fef5-9e28-4875-a5f9-a878acf6c7a4_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_EvalCondRowFromEdit_A : BOOL\nVAR_INPUT\n\tRowNo : INT;\nEND_VAR\nVAR\n\tactualValue : DINT;\nEND_VAR\n","LineInfoPersistence":"(string)4d00fef5-9e28-4875-a5f9-a878acf6c7a4_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)38","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}