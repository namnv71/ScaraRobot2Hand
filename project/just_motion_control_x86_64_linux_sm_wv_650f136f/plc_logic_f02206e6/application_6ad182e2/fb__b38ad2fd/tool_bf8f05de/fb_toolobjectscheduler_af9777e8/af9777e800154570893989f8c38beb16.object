{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)af9777e8-0015-4570-8939-89f8c38beb16","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_ToolObjectScheduler","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)bf8f05de-2ef0-4a76-8958-b734ab9b43c2"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFUNCTION BLOCK\n    FB_ToolObjectScheduler\n\nDESCRIPTION\n    Chọn một Tool đang rảnh và một Object hợp lệ.\n\nSELECTION RULE\n    1. Tool nằm trong ToolMask.\n    2. Tool Enable và AllowTracking.\n    3. Tool không Busy, không Occupied, không Error.\n    4. Object Valid, CanPick, chưa Reserved.\n    5. Object ở trạng thái OBJ_READY.\n    6. ProductClass phù hợp Recipe và Tool.\n===============================================================================\n*)\n\n//=============================================================================\n// DEFAULT OUTPUT\n//=============================================================================\nDone := FALSE;\nValid := FALSE;\nToolIndex := 0;\nObjectIndex := 0;\n\n//=============================================================================\n// DISABLED\n//=============================================================================\nIF NOT Execute THEN RETURN; END_IF;\n\n//=============================================================================\n// SEARCH TOOL AND OBJECT\n//=============================================================================\nFOR uiTool := 1 TO GVL.C_MAX_TOOLS DO\n\n    // Kiểm tra Tool có nằm trong ToolMask hay không.\n    xToolEnabledByMask := (ToolMask AND SHL(DWORD#1, uiTool - 1)) <> 0;\n\t\n\n    // Chỉ kiểm tra Object khi Tool sẵn sàng.\n    IF xToolEnabledByMask\n    AND ToolConfig[uiTool].Enable\n    AND ToolConfig[uiTool].AllowTracking\n    AND NOT ToolStatus[uiTool].Occupied\n    AND NOT ToolStatus[uiTool].Busy\n    AND NOT ToolStatus[uiTool].Error THEN\n\n        FOR uiObject := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n\n            // Kiểm tra Product Class phù hợp Recipe và Tool.\n            xProductClassValid := (Recipe.ProductClassID = 0 OR Recipe.ProductClassID = Queue.Objects[uiObject].ProductClassID)\n            AND (ToolConfig[uiTool].AllowedProductClassID = 0 OR ToolConfig[uiTool].AllowedProductClassID = Queue.Objects[uiObject].ProductClassID);\n\t\t\t\n\t\t\t// Kiểm tra Source phù hợp Recipe.\n\t\t\txSourceValid := FALSE;\n\t\t\t\n\t\t\tCASE Recipe.ObjectSourceType OF\n\t\t\t\n\t\t\t\tE_ObjectSourceType.SENSOR:\n\t\t\t\t\txSourceValid :=\n\t\t\t\t\t\tQueue.Objects[uiObject].SourceType = E_ObjectSourceType.SENSOR\n\t\t\t\t\t\tAND Queue.Objects[uiObject].SourceID = Recipe.SensorSourceID;\n\t\t\n\t\t\t\tE_ObjectSourceType.VISION:\n\n\t\t\t\t\txSourceValid :=\n\t\t\t\t\t\tQueue.Objects[uiObject].SourceType =\n\t\t\t\t\t\t\tE_ObjectSourceType.VISION\n\t\t\t\t\n\t\t\t\t\t\tAND (\n\t\t\t\t\t\t\t(Recipe.VisionSourceID = 0)\n\t\t\t\t\t\t\tOR\n\t\t\t\t\t\t\t(Queue.Objects[uiObject].SourceID =\n\t\t\t\t\t\t\t\tRecipe.VisionSourceID)\n\t\t\t\t\t\t)\n\t\t\t\t\n\t\t\t\t\t\tAND Queue.Objects[uiObject].JobID =\n\t\t\t\t\t\t\tRecipe.VisionJobID;\n\t\t\t\t\t\t\t\n// \t\t\t\tE_ObjectSourceType.VISION:\n// \t\t\t\t\txSourceValid :=\n// \t\t\t\t\t\tQueue.Objects[uiObject].SourceType = E_ObjectSourceType.VISION\n// \t\t\t\t\t\tAND Queue.Objects[uiObject].JobID = Recipe.VisionJobID;\n\t\t\t\n\t\t\t\tE_ObjectSourceType.NONE:\n\t\t\t\t\t// Giữ tương thích với bài test cũ.\n\t\t\t\t\txSourceValid := TRUE;\n\t\t\t\n\t\t\tEND_CASE;\n\n\t\n            // Object phải hợp lệ, sẵn sàng gắp và chưa bị module khác giữ.\n            IF Queue.Objects[uiObject].Valid\n\t\t\tAND Queue.Objects[uiObject].CanPick\n\t\t\tAND Queue.Objects[uiObject].State = E_TrackingObjectState.OBJ_READY\n\t\t\tAND NOT Queue.Objects[uiObject].Reserved\n\t\t\tAND xProductClassValid\n\t\t\tAND xSourceValid THEN\n\n                ToolIndex := uiTool;\n                ObjectIndex := uiObject;\n                Valid := TRUE;\n                Done := TRUE;\n                RETURN;\n            END_IF;\n\n        END_FOR;\n\n    END_IF;\n\nEND_FOR;\n\n// Không tìm thấy cặp Tool/Object phù hợp.\nDone := TRUE;","LineInfoPersistence":"(string)af9777e8-0015-4570-8939-89f8c38beb16_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_ToolObjectScheduler\nVAR_INPUT\n\n    // Bật thực hiện tìm Assignment.\n    Execute : BOOL;\n\n    // Recipe hiện tại.\n    Recipe : ST_MultiToolTrackingRecipe;\n\n    // Bitmask Tool được phép dùng.\n    ToolMask : DWORD;\n\nEND_VAR\n\nVAR_IN_OUT\n\n    // Object Queue.\n    Queue : ST_TRACKING_QUEUE;\n\n    // Cấu hình Tool.\n    ToolConfig : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolConfig;\n\n    // Runtime Tool.\n    ToolStatus : ARRAY[0..GVL.C_MAX_TOOLS] OF ST_ToolStatus;\n\nEND_VAR\n\nVAR_OUTPUT\n\n    // Tìm kiếm hoàn thành.\n    Done : BOOL;\n\n    // TRUE nếu tìm được cặp Tool - Object.\n    Valid : BOOL;\n\n    // Index Tool trong mảng.\n    ToolIndex : UINT;\n\n    // Index Object trong Queue.\n    ObjectIndex : UINT;\n\nEND_VAR\n\nVAR\n\n    // Biến vòng lặp Tool.\n    uiTool : UINT;\n\n    // Biến vòng lặp Object.\n    uiObject : UINT;\n\n    // TRUE nếu Tool nằm trong Mask.\n    xToolEnabledByMask : BOOL;\n\n    // TRUE nếu ProductClass phù hợp.\n    xProductClassValid : BOOL;\n\txSourceValid : BOOL;\nEND_VAR\n","LineInfoPersistence":"(string)af9777e8-0015-4570-8939-89f8c38beb16_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)174","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}