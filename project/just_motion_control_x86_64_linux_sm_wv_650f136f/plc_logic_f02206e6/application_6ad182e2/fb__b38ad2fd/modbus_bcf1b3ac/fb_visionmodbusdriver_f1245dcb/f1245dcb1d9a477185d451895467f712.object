{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f1245dcb-1d9a-4771-85d4-51895467f712","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionModbusDriver","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)bcf1b3ac-ace3-4648-a9f0-0ce956efcdda"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// //=============================================================================\n// // RESET / DISABLE\n// //=============================================================================\n// IF Reset OR NOT Enable THEN\n//     Active := FALSE;\n//     Error := FALSE;\n//     ErrorID := 0;\n// \n//     //---------------------------------------------------------------------\n//     // XÓA BỘ NHỚ TRANSACTION CŨ.\n//     //---------------------------------------------------------------------\n//     udiLastResultTriggerID := 0;\n//     udiLastBlockTriggerID := 0;\n//     uiLastDecodedBlock := 0;\n// \n//     //---------------------------------------------------------------------\n//     // XÓA RESULT CŨ.\n//     //---------------------------------------------------------------------\n//     VisionResult.Header.Valid := FALSE;\n//     VisionResult.Header.TriggerID := 0;\n// \n//     VisionResult.TrackObjectResult.Valid := FALSE;\n//     VisionResult.TrackObjectResult.ObjectCount := 0;\n// \n//     //---------------------------------------------------------------------\n//     // XÓA HANDSHAKE CŨ.\n//     //---------------------------------------------------------------------\n//     ModbusControl.AckBlock := FALSE;\n//     ModbusControl.AckResult := FALSE;\n//     ModbusControl.AckBlockIndex := 0;\n//     ModbusControl.RequestBlockIndex := 0;\n//     RETURN;\n// END_IF;\n\n//=============================================================================\n// MEMORY BASE\n//=============================================================================\nuiBase := Config.BaseAddress;\nuiR2V := uiBase + Config.CommandOffset;\nuiV2R := uiBase + Config.StatusOffset;\nuiData := uiBase + Config.DataOffset;\nuiMulti := uiBase + 132;\n\n//=============================================================================\n// VALIDATE ADDRESS\n//=============================================================================\nIF uiR2V + 99 > 1199 OR uiV2R + 199 > 1199 THEN\n    Error := TRUE;\n    ErrorID := 9251;\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// RESET\n//-----------------------------------------------------------------------------\n// Quan trọng:\n// Phải gửi Reset sang Vision TRƯỚC khi RETURN.\n//=============================================================================\nIF Reset THEN\n\n    //---------------------------------------------------------------------\n    // 1. GỬI RESET SANG VISION\n    //---------------------------------------------------------------------\n    wControl := WORD#0;\n    wControl.0 := TRUE;          // Heartbeat.\n    wControl.6 := TRUE;          // RESET.\n    Registers[uiR2V + 0] := wControl;\n\n    //---------------------------------------------------------------------\n    // 2. RESET INTERNAL TRANSACTION\n    //---------------------------------------------------------------------\n    Active := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    udiLastResultTriggerID := 0;\n    udiLastBlockTriggerID := 0;\n    uiLastDecodedBlock := 0;\n\n    xLastHeartbeat := FALSE;\n    xHeartbeatToggle := FALSE;\n\n    //---------------------------------------------------------------------\n    // 3. RESET RESULT\n    //---------------------------------------------------------------------\n    VisionResult.Header.Valid := FALSE;\n    VisionResult.Header.TriggerID := 0;\n    VisionResult.Header.JobID := 0;\n    VisionResult.Header.ResultCode := 0;\n    VisionResult.Header.ErrorCode := 0;\n    VisionResult.Header.DataCount := 0;\n    VisionResult.Header.BlockCount := 0;\n    VisionResult.Header.BlockIndex := 0;\n    VisionResult.Header.BlockDataCount := 0;\n    VisionResult.Header.CaptureConveyorPos := 0.0;\n\n    VisionResult.TrackObjectResult.Valid := FALSE;\n    VisionResult.TrackObjectResult.ObjectCount := 0;\n\n    FOR uiRecord := 1 TO GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME DO\n        VisionResult.TrackObjectResult.Objects[uiRecord].Valid := FALSE;\n        VisionResult.TrackObjectResult.Objects[uiRecord].Pos.X := 0.0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].Pos.Y := 0.0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].Pos.Z := 0.0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].Pos.A := 0.0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].Score := 0.0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].ProductClassID := 0;\n        VisionResult.TrackObjectResult.Objects[uiRecord].FeatureID := 0;\n    END_FOR;\n\n    //---------------------------------------------------------------------\n    // 4. RESET HANDSHAKE\n    //---------------------------------------------------------------------\n    ModbusControl.AckBlock := FALSE;\n    ModbusControl.AckResult := FALSE;\n    ModbusControl.AckBlockIndex := 0;\n    ModbusControl.RequestBlockIndex := 0;\n\n    //---------------------------------------------------------------------\n    // 5. RESET MODBUS STATUS\n    //---------------------------------------------------------------------\n    ModbusStatus.HeartBeat := FALSE;\n    ModbusStatus.TriggerDone := FALSE;\n    ModbusStatus.CalibDone := FALSE;\n    ModbusStatus.ResultReady := FALSE;\n    ModbusStatus.Busy := FALSE;\n    ModbusStatus.Run1Slot := FALSE;\n    ModbusStatus.BlockReady := FALSE;\n    ModbusStatus.Error := FALSE;\n    ModbusStatus.CalibBusy := FALSE;\n    ModbusStatus.CalibError := FALSE;\n    ModbusStatus.BlockIndex := 0;\n    ModbusStatus.BlockDataCount := 0;\n\n    //---------------------------------------------------------------------\n    // 6. RESET CHANNEL STATUS\n    //---------------------------------------------------------------------\n    ChannelStatus.Enable := FALSE;\n    ChannelStatus.Online := FALSE;\n    ChannelStatus.Ready := FALSE;\n    ChannelStatus.Busy := FALSE;\n    ChannelStatus.ResultReady := FALSE;\n    ChannelStatus.Error := FALSE;\n    ChannelStatus.CurrentJobID := 0;\n    ChannelStatus.CurrentTriggerID := 0;\n    ChannelStatus.ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n\n    tHeartbeatTimeout(IN := FALSE);\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// DISABLE\n//=============================================================================\nIF NOT Enable THEN\n\n    Registers[uiR2V + 0] := WORD#0;\n\n    Active := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    ChannelStatus.Enable := FALSE;\n    ChannelStatus.Online := FALSE;\n    ChannelStatus.Ready := FALSE;\n    ChannelStatus.Busy := FALSE;\n    ChannelStatus.ResultReady := FALSE;\n    ChannelStatus.Error := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// NORMAL RUN\n//=============================================================================\nActive := TRUE;\nChannelStatus.Enable := TRUE;\n\n// Active := TRUE;\n// ChannelStatus.Enable := TRUE;\n\n// //=============================================================================\n// // MEMORY BASE / SCALE\n// //=============================================================================\n// uiBase := Config.BaseAddress;\n// uiR2V := uiBase + Config.CommandOffset;\n// uiV2R := uiBase + Config.StatusOffset;\n// uiData := uiBase + Config.DataOffset;\n// uiMulti := uiBase + 132;                            // MultiData cố định theo mapping V1.1.\n// \n// IF uiR2V + 99 > 1199 OR uiV2R + 199 > 1199 THEN\n//     Error := TRUE;\n//     ErrorID := 9251;                                // Base/Offset vượt vùng MODBUS.\n//     RETURN;\n// END_IF;\n\nError := FALSE;\nErrorID := 0;\nrPositionScale := Config.PositionScale;\nrAngleScale := Config.AngleScale;\nrScoreScale := Config.ScoreScale;\nIF ABS(rPositionScale) <= GVL.C_EPSILON THEN rPositionScale := 1.0; END_IF;\nIF ABS(rAngleScale) <= GVL.C_EPSILON THEN rAngleScale := 1.0; END_IF;\nIF ABS(rScoreScale) <= GVL.C_EPSILON THEN rScoreScale := 1.0; END_IF;\n\n//=============================================================================\n// 1. ROBOT -> VISION: CONTROL WORD + COMMAND\n//=============================================================================\n// Heartbeat dùng biến nội bộ toggle; KHÔNG đảo trực tiếp register mỗi scan Communication.\nxHeartbeatToggle := NOT xHeartbeatToggle;\n\nwControl := WORD#0;\nwControl.0 := xHeartbeatToggle;\nwControl.1 := Command.Execute;\nwControl.2 := ModbusControl.RunCalib;\nwControl.3 := ModbusControl.CalibPosReady;\nwControl.4 := ModbusControl.AckResult;\nwControl.5 := ModbusControl.AckBlock;\nwControl.6 := Command.Reset;\nwControl.7 := Command.Abort;\nRegisters[uiR2V + 0] := wControl;\nRegisters[uiR2V + 1] := UINT_TO_WORD(Command.JobID);\n\nCASE Command.Application OF\n    E_VisionApplication.VIS_APP_ALIGN: Registers[uiR2V + 2] := WORD#10;\n    E_VisionApplication.VIS_APP_INSPECTION: Registers[uiR2V + 2] := WORD#20;\n    E_VisionApplication.VIS_APP_SINGLE_POINT: Registers[uiR2V + 2] := WORD#30;\n    E_VisionApplication.VIS_APP_POINT_LIST: Registers[uiR2V + 2] := WORD#40;\n    E_VisionApplication.VIS_APP_GLUE_PATH: Registers[uiR2V + 2] := WORD#50;\n    E_VisionApplication.VIS_APP_PICK_POSITION: Registers[uiR2V + 2] := WORD#60;\n    E_VisionApplication.VIS_APP_CONVEYOR_PICK: Registers[uiR2V + 2] := WORD#70;\n    E_VisionApplication.VIS_APP_CONVEYOR_INSPECTION: Registers[uiR2V + 2] := WORD#80;\n    E_VisionApplication.VIS_APP_CONVEYOR_GLUE: Registers[uiR2V + 2] := WORD#90;\n    E_VisionApplication.VIS_APP_CALIBRATION: Registers[uiR2V + 2] := WORD#100;\n    ELSE Registers[uiR2V + 2] := WORD#0;\nEND_CASE;\n\nRegisters[uiR2V + 3] := F_VisionUDINTLowWord(Command.TriggerID);\nRegisters[uiR2V + 4] := F_VisionUDINTHighWord(Command.TriggerID);\nRegisters[uiR2V + 5] := UINT_TO_WORD(ModbusControl.CalibPointCount);\nRegisters[uiR2V + 6] := UINT_TO_WORD(ModbusControl.RequestBlockIndex);\nRegisters[uiR2V + 7] := UINT_TO_WORD(ModbusControl.AckBlockIndex);\nRegisters[uiR2V + 8] := UINT_TO_WORD(ModbusControl.CommandCode);\nRegisters[uiR2V + 9] := WORD#0;\n\n// 12 Calibration Point; mỗi Point = X/Y/A, mỗi thành phần = LOW/HIGH WORD.\nFOR uiPoint := 1 TO 12 DO\n    diRaw := F_VisionRealToRawDINT(ModbusControl.CalibrationPoints[uiPoint].X, rPositionScale);\n    Registers[uiR2V + 10 + (uiPoint - 1) * 6] := F_VisionDINTLowWord(diRaw);\n    Registers[uiR2V + 11 + (uiPoint - 1) * 6] := F_VisionDINTHighWord(diRaw);\n\n    diRaw := F_VisionRealToRawDINT(ModbusControl.CalibrationPoints[uiPoint].Y, rPositionScale);\n    Registers[uiR2V + 12 + (uiPoint - 1) * 6] := F_VisionDINTLowWord(diRaw);\n    Registers[uiR2V + 13 + (uiPoint - 1) * 6] := F_VisionDINTHighWord(diRaw);\n\n    diRaw := F_VisionRealToRawDINT(ModbusControl.CalibrationPoints[uiPoint].A, rAngleScale);\n    Registers[uiR2V + 14 + (uiPoint - 1) * 6] := F_VisionDINTLowWord(diRaw);\n    Registers[uiR2V + 15 + (uiPoint - 1) * 6] := F_VisionDINTHighWord(diRaw);\nEND_FOR;\n\n// Capture reference của command runtime.\ndiRaw := F_VisionRealToRawDINT(Command.CaptureConveyorPos, rPositionScale);\nRegisters[uiR2V + 82] := F_VisionDINTLowWord(diRaw);\nRegisters[uiR2V + 83] := F_VisionDINTHighWord(diRaw);\n\ndiRaw := F_VisionRealToRawDINT(Command.CaptureRobotPos.X, rPositionScale);\nRegisters[uiR2V + 84] := F_VisionDINTLowWord(diRaw);\nRegisters[uiR2V + 85] := F_VisionDINTHighWord(diRaw);\n\ndiRaw := F_VisionRealToRawDINT(Command.CaptureRobotPos.Y, rPositionScale);\nRegisters[uiR2V + 86] := F_VisionDINTLowWord(diRaw);\nRegisters[uiR2V + 87] := F_VisionDINTHighWord(diRaw);\n\ndiRaw := F_VisionRealToRawDINT(Command.CaptureRobotPos.A, rAngleScale);\nRegisters[uiR2V + 88] := F_VisionDINTLowWord(diRaw);\nRegisters[uiR2V + 89] := F_VisionDINTHighWord(diRaw);\n\n//=============================================================================\n// 2. VISION -> ROBOT: STATUS WORD\n//=============================================================================\nwStatus := Registers[uiV2R + 0];\nModbusStatus.HeartBeat := wStatus.0;\nModbusStatus.TriggerDone := wStatus.1;\nModbusStatus.CalibDone := wStatus.2;\nModbusStatus.ResultReady := wStatus.3;\nModbusStatus.Busy := wStatus.4;\nModbusStatus.Run1Slot := wStatus.5;\nModbusStatus.BlockReady := wStatus.6;\nModbusStatus.Error := wStatus.7;\nModbusStatus.CalibBusy := wStatus.8;\nModbusStatus.CalibError := wStatus.9;\n\nChannelStatus.Ready := NOT ModbusStatus.Busy AND NOT ModbusStatus.Error;\nChannelStatus.Busy := ModbusStatus.Busy;\nChannelStatus.ResultReady := ModbusStatus.ResultReady;\nChannelStatus.Error := ModbusStatus.Error;\n\n// Heartbeat timeout 2 s: mỗi lần bit đổi thì reset timer.\nIF ModbusStatus.HeartBeat <> xLastHeartbeat THEN\n    xLastHeartbeat := ModbusStatus.HeartBeat;\n    ChannelStatus.Online := TRUE;\n    tHeartbeatTimeout(IN := FALSE);\nELSE\n    tHeartbeatTimeout(IN := TRUE, PT := T#2S);\n    IF tHeartbeatTimeout.Q THEN ChannelStatus.Online := FALSE; END_IF;\nEND_IF;\n\n//=============================================================================\n// 3. RESULT HEADER\n//=============================================================================\nChannelStatus.CurrentJobID := WORD_TO_UINT(Registers[uiV2R + 1]);\nudiTriggerID := F_VisionWordsToUDINT_LH(Registers[uiV2R + 4], Registers[uiV2R + 5]);\nChannelStatus.CurrentTriggerID := udiTriggerID;\n\nVisionResult.Header.CameraID := Config.CameraID;\nVisionResult.Header.JobID := WORD_TO_UINT(Registers[uiV2R + 1]);\nVisionResult.Header.TriggerID := udiTriggerID;\nVisionResult.Header.ResultCode := WORD_TO_UINT(Registers[uiV2R + 7]);\nVisionResult.Header.ErrorCode := WORD_TO_UINT(Registers[uiV2R + 7]);\nVisionResult.Header.DataCount := WORD_TO_UINT(Registers[uiV2R + 8]);\nVisionResult.Header.BlockCount := WORD_TO_UINT(Registers[uiV2R + 9]);\nVisionResult.Header.BlockIndex := WORD_TO_UINT(Registers[uiV2R + 10]);\nVisionResult.Header.BlockDataCount := WORD_TO_UINT(Registers[uiV2R + 11]);\nVisionResult.Header.Checksum := F_VisionWordsToUDINT_LH(Registers[uiV2R + 12], Registers[uiV2R + 13]);\n\ndiRaw := F_VisionWordsToDINT_LH(Registers[uiV2R + 14], Registers[uiV2R + 15]);\nVisionResult.Header.CaptureConveyorPos := DINT_TO_REAL(diRaw) * rPositionScale;\nModbusStatus.BlockIndex := VisionResult.Header.BlockIndex;\nModbusStatus.BlockDataCount := VisionResult.Header.BlockDataCount;\n\nCASE WORD_TO_UINT(Registers[uiV2R + 2]) OF\n    10: VisionResult.Header.Application := E_VisionApplication.VIS_APP_ALIGN;\n    20: VisionResult.Header.Application := E_VisionApplication.VIS_APP_INSPECTION;\n    30: VisionResult.Header.Application := E_VisionApplication.VIS_APP_SINGLE_POINT;\n    40: VisionResult.Header.Application := E_VisionApplication.VIS_APP_POINT_LIST;\n    50: VisionResult.Header.Application := E_VisionApplication.VIS_APP_GLUE_PATH;\n    60: VisionResult.Header.Application := E_VisionApplication.VIS_APP_PICK_POSITION;\n    70: VisionResult.Header.Application := E_VisionApplication.VIS_APP_CONVEYOR_PICK;\n    80: VisionResult.Header.Application := E_VisionApplication.VIS_APP_CONVEYOR_INSPECTION;\n    90: VisionResult.Header.Application := E_VisionApplication.VIS_APP_CONVEYOR_GLUE;\n    100: VisionResult.Header.Application := E_VisionApplication.VIS_APP_CALIBRATION;\n    ELSE VisionResult.Header.Application := E_VisionApplication.VIS_APP_NONE;\nEND_CASE;\n\nCASE WORD_TO_UINT(Registers[uiV2R + 3]) OF\n    10: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_BOOL;\n    20: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_VALUE;\n    30: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_POS;\n    40: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_ALIGN;\n    50: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_INSPECTION;\n    60: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_POINT_LIST;\n    70: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_GLUE_PATH;\n    80: VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_TRACK_OBJECT;\n    ELSE VisionResult.Header.DataType := E_VisionDataType.VIS_DATA_NONE;\nEND_CASE;\n\nCASE WORD_TO_UINT(Registers[uiV2R + 6]) OF\n    10: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_PENDING;\n    20: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_OK;\n    30: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_NG;\n    40: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_NOT_FOUND;\n    50: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_LOW_SCORE;\n    60: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_OUT_OF_RANGE;\n    70: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_INCOMPLETE;\n    80: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_INVALID;\n    900: VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_ERROR;\n    ELSE VisionResult.Header.ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\nEND_CASE;\nChannelStatus.ResultStatus := VisionResult.Header.ResultStatus;\n\n// Vision đã hạ ResultReady: kết thúc handshake Result trước.\nIF NOT ModbusStatus.ResultReady THEN\n    ModbusControl.AckResult := FALSE;\n    ModbusControl.AckBlock := FALSE;\n    ModbusControl.AckBlockIndex := 0;\n    ModbusControl.RequestBlockIndex := 0;\nEND_IF;\n\n//=============================================================================\n// 4. SIMPLE RESULT - POS / ALIGN\n//=============================================================================\nIF ModbusStatus.ResultReady AND udiTriggerID <> 0 AND udiTriggerID <> udiLastResultTriggerID\nAND (VisionResult.Header.DataType = E_VisionDataType.VIS_DATA_POS OR VisionResult.Header.DataType = E_VisionDataType.VIS_DATA_ALIGN) THEN\n\n    diRaw := F_VisionWordsToDINT_LH(Registers[uiData + 0], Registers[uiData + 1]);\n    VisionResult.PosResult.Pos.X := DINT_TO_REAL(diRaw) * rPositionScale;\n    diRaw := F_VisionWordsToDINT_LH(Registers[uiData + 2], Registers[uiData + 3]);\n    VisionResult.PosResult.Pos.Y := DINT_TO_REAL(diRaw) * rPositionScale;\n    diRaw := F_VisionWordsToDINT_LH(Registers[uiData + 4], Registers[uiData + 5]);\n    VisionResult.PosResult.Pos.A := DINT_TO_REAL(diRaw) * rAngleScale;\n\n    VisionResult.PosResult.Pos.Z := 0.0;\n    VisionResult.PosResult.Score := UINT_TO_REAL(WORD_TO_UINT(Registers[uiData + 6])) * rScoreScale;\n    VisionResult.PosResult.Valid := Registers[uiData + 7].0;\n    VisionResult.PosResult.FeatureID := WORD_TO_UINT(Registers[uiData + 8]);\n\n    IF VisionResult.Header.DataType = E_VisionDataType.VIS_DATA_ALIGN THEN\n        VisionResult.AlignResult.Valid := VisionResult.PosResult.Valid;\n        VisionResult.AlignResult.RawOffset := VisionResult.PosResult.Pos;\n        VisionResult.AlignResult.RobotOffset := VisionResult.PosResult.Pos;\n        VisionResult.AlignResult.Score := VisionResult.PosResult.Score;\n        VisionResult.AlignResult.FeatureID := VisionResult.PosResult.FeatureID;\n    END_IF;\n\n    VisionResult.Header.Valid := TRUE;\n    udiLastResultTriggerID := udiTriggerID;\n    ModbusControl.AckResult := TRUE;\nEND_IF;\n\n//=============================================================================\n// 5. TRACKING MULTI-BLOCK\n//=============================================================================\nIF ModbusStatus.ResultReady AND ModbusStatus.BlockReady\nAND VisionResult.Header.DataType = E_VisionDataType.VIS_DATA_TRACK_OBJECT THEN\n\n    uiBlockIndex := VisionResult.Header.BlockIndex;\n    uiBlockDataCount := VisionResult.Header.BlockDataCount;\n\n    IF uiBlockIndex = 0 OR uiBlockIndex > VisionResult.Header.BlockCount THEN\n        Error := TRUE;\n        ErrorID := 9252;\n    ELSIF uiBlockDataCount > 10 THEN\n        Error := TRUE;\n        ErrorID := 9253;\n    ELSIF udiTriggerID <> udiLastBlockTriggerID OR uiBlockIndex <> uiLastDecodedBlock THEN\n\n        // Block đầu của Trigger mới: xóa Result cũ trước khi ghép frame mới.\n        IF uiBlockIndex = 1 THEN\n            VisionResult.Header.Valid := FALSE;\n            VisionResult.TrackObjectResult.Valid := FALSE;\n            VisionResult.TrackObjectResult.ObjectCount := 0;\n            FOR uiRecord := 1 TO GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME DO\n                VisionResult.TrackObjectResult.Objects[uiRecord].Valid := FALSE;\n            END_FOR;\n        END_IF;\n\n        FOR uiRecord := 1 TO uiBlockDataCount DO\n            uiGlobalObject := (uiBlockIndex - 1) * 10 + uiRecord;\n\n            IF uiGlobalObject <= GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME THEN\n                wObjectInfo := Registers[uiMulti + (uiRecord - 1) * 9 + 6];\n\n                diRaw := F_VisionWordsToDINT_LH(Registers[uiMulti + (uiRecord - 1) * 9 + 0], Registers[uiMulti + (uiRecord - 1) * 9 + 1]);\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Pos.X := DINT_TO_REAL(diRaw) * rPositionScale;\n\n                diRaw := F_VisionWordsToDINT_LH(Registers[uiMulti + (uiRecord - 1) * 9 + 2], Registers[uiMulti + (uiRecord - 1) * 9 + 3]);\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Pos.Y := DINT_TO_REAL(diRaw) * rPositionScale;\n\n                diRaw := F_VisionWordsToDINT_LH(Registers[uiMulti + (uiRecord - 1) * 9 + 4], Registers[uiMulti + (uiRecord - 1) * 9 + 5]);\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Pos.A := DINT_TO_REAL(diRaw) * rAngleScale;\n\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Pos.Z := 0.0;\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Valid := wObjectInfo.0;\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].Score := UINT_TO_REAL(WORD_TO_UINT(Registers[uiMulti + (uiRecord - 1) * 9 + 7])) * rScoreScale;\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].ProductClassID := WORD_TO_UINT(Registers[uiMulti + (uiRecord - 1) * 9 + 8]);\n                VisionResult.TrackObjectResult.Objects[uiGlobalObject].FeatureID := 0; // V1.1 không truyền FeatureID.\n            END_IF;\n        END_FOR;\n\n        udiLastBlockTriggerID := udiTriggerID;\n        uiLastDecodedBlock := uiBlockIndex;\n        ModbusControl.AckBlock := TRUE;\n        ModbusControl.AckBlockIndex := uiBlockIndex;\n\n        IF uiBlockIndex < VisionResult.Header.BlockCount THEN\n            ModbusControl.RequestBlockIndex := uiBlockIndex + 1;\n        ELSE\n            VisionResult.TrackObjectResult.ObjectCount := VisionResult.Header.DataCount;\n            IF VisionResult.TrackObjectResult.ObjectCount > GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME THEN\n                VisionResult.TrackObjectResult.ObjectCount := GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME;\n            END_IF;\n\n            VisionResult.TrackObjectResult.Valid := TRUE;\n            VisionResult.Header.Valid := TRUE;\n            udiLastResultTriggerID := udiTriggerID;\n            ModbusControl.RequestBlockIndex := 0;\n            ModbusControl.AckResult := TRUE;\n        END_IF;\n    END_IF;\nELSE\n    // Khi PC hạ/chuyển BlockReady thì PLC hạ AckBlock để handshake Block kế tiếp.\n    ModbusControl.AckBlock := FALSE;\nEND_IF;","LineInfoPersistence":"(string)f1245dcb-1d9a-4771-85d4-51895467f712_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionModbusDriver\nVAR_INPUT\n    Enable : BOOL;\n    Reset : BOOL;\n    Config : ST_VISION_CONFIG;\n    Command : ST_VISION_COMMAND;\nEND_VAR\n\nVAR_IN_OUT\n    ModbusControl : ST_VISION_MODBUS_CONTROL;\n    ChannelStatus : ST_VISION_CHANNEL_STATUS;\n    ModbusStatus : ST_VISION_MODBUS_STATUS;\n    VisionResult : ST_VISION_RESULT;\n    Registers : ARRAY[0..1999] OF WORD;\nEND_VAR\n\nVAR_OUTPUT\n    Active : BOOL;\n    Error : BOOL;\n    ErrorID : UDINT;\nEND_VAR\n\nVAR\n    uiBase : UINT;\n    uiR2V : UINT;\n    uiV2R : UINT;\n    uiData : UINT;\n    uiMulti : UINT;\n    wControl : WORD;\n    wStatus : WORD;\n    wObjectInfo : WORD;\n    diRaw : DINT;\n    udiTriggerID : UDINT;\n    uiPoint : UINT;\n    uiRecord : UINT;\n    uiGlobalObject : UINT;\n    uiBlockIndex : UINT;\n    uiBlockDataCount : UINT;\n    rPositionScale : REAL;\n    rAngleScale : REAL;\n    rScoreScale : REAL;\n    udiLastResultTriggerID : UDINT;\n    udiLastBlockTriggerID : UDINT;\n    uiLastDecodedBlock : UINT;\n    xLastHeartbeat : BOOL;\n    xHeartbeatToggle : BOOL;\n    tHeartbeatTimeout : TON;\nEND_VAR\n","LineInfoPersistence":"(string)f1245dcb-1d9a-4771-85d4-51895467f712_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)536","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}