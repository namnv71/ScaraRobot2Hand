{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)0de11e8f-2680-43b8-b0da-c9b30831d2a6","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_PathProcessState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9e1f02d8-5bba-4bcc-a63a-6b70bdcae5c5"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_PathProcessState :\n(\n    PATH_PROC_IDLE := 0,              // Bộ xử lý path đang rảnh.\n\n    PATH_PROC_LOAD := 10,              // Nạp dữ liệu điểm thô.\n    PATH_PROC_VALIDATE := 20,          // Kiểm tra số điểm và phạm vi tọa độ.\n    PATH_PROC_REMOVE_DUPLICATE := 30,  // Loại bỏ điểm trùng.\n    PATH_PROC_FILTER := 40,            // Lọc nhiễu vị trí.\n    PATH_PROC_RESAMPLE := 50,          // Chia lại khoảng cách giữa các điểm.\n    PATH_PROC_SEGMENT := 60,           // Phân loại line, arc hoặc spline.\n    PATH_PROC_PLAN_SPEED := 70,        // Tính tốc độ theo từng đoạn.\n    PATH_PROC_COMPLETE := 80,          // Path đã xử lý xong.\n\n    PATH_PROC_ERROR := 900             // Dữ liệu path hoặc xử lý bị lỗi.\n);\nEND_TYPE","LineInfoPersistence":"(string)0de11e8f-2680-43b8-b0da-c9b30831d2a6_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)18"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}