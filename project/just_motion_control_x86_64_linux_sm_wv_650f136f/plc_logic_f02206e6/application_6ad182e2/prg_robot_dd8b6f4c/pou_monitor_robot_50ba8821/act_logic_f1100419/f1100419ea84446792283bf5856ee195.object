{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f1100419-ea84-4467-9228-3bf5856ee195","ParentGuid":"(Guid)50ba8821-12b7-44cd-9415-f982bd6a7ece","Name":"(string)ACT_LOGIC","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1. READ_POS_CURRENT\"}\n// Currern position robot\nMC_GroupReadActualPosition_1.Enable := TRUE;\nIF GVL.RB_A.COORD <> SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_A_.CUR_X   := TO_REAL(RB1_POS.c.X);\n\tGVL.RB_A_.CUR_Y   := TO_REAL(RB1_POS.c.Y);\n\tGVL.RB_A_.CUR_Z   := TO_REAL(RB1_POS.c.Z);\n\tGVL.RB_A_.CUR_R   := TO_REAL(RB1_POS.c.A);\nELSIF GVL.RB_A.COORD = SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_A_.CUR_X   := TO_REAL(RB1_POS.a.a0);\n\tGVL.RB_A_.CUR_Y   := TO_REAL(RB1_POS.a.a1);\n\tGVL.RB_A_.CUR_Z   := TO_REAL(RB1_POS.a.a2);\n\tGVL.RB_A_.CUR_R   := TO_REAL(RB1_POS.a.a3);\nEND_IF\n\n/// \nMC_GroupReadActualPosition_2.Enable := TRUE;\nIF GVL.RB_B.COORD <>  SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_B_.CUR_X   := TO_REAL(RB2_POS.c.X);\n\tGVL.RB_B_.CUR_Y   := TO_REAL(RB2_POS.c.Y);\n\tGVL.RB_B_.CUR_Z   := TO_REAL(RB2_POS.c.Z);\n\tGVL.RB_B_.CUR_R   := TO_REAL(RB2_POS.c.A);\nELSIF GVL.RB_B.COORD =  SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_B_.CUR_X   := TO_REAL(RB2_POS.a.a0);\n\tGVL.RB_B_.CUR_Y   := TO_REAL(RB2_POS.a.a1);\n\tGVL.RB_B_.CUR_Z   := TO_REAL(RB2_POS.a.a2);\n\tGVL.RB_B_.CUR_R   := TO_REAL(RB2_POS.a.a3);\n\nEND_IF\n{endregion}\t \n{region \"2. READ_VELOCITY_CURRENT\"}\t \n// Currern speed robot\nIF GVL.RB_A.COORD <> SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_A_.CUR_SP_X   := TO_REAL(RB1_SPEED.c.X);\n\tGVL.RB_A_.CUR_SP_Y   := TO_REAL(RB1_SPEED.c.Y);\n\tGVL.RB_A_.CUR_SP_Z  := TO_REAL(RB1_SPEED.c.Z);\n\tGVL.RB_A_.CUR_SP_R   := TO_REAL(RB1_SPEED.c.c);\nELSIF GVL.RB_A.COORD = SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_A_.CUR_SP_X   := TO_REAL(RB1_SPEED.a.a0);\n\tGVL.RB_A_.CUR_SP_Y   := TO_REAL(RB1_SPEED.a.a1);\n\tGVL.RB_A_.CUR_SP_Z  := TO_REAL(RB1_SPEED.a.a2);\n\tGVL.RB_A_.CUR_SP_R   := TO_REAL(RB1_SPEED.a.a3);\t\nEND_IF\nIF GVL.RB_B.COORD <> SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_B_.CUR_SP_X    := TO_REAL(RB2_SPEED.c.X);\n\tGVL.RB_B_.CUR_SP_Y   := TO_REAL(RB2_SPEED.c.Y);\n\tGVL.RB_B_.CUR_SP_Z    := TO_REAL(RB2_SPEED.c.Z);\n\tGVL.RB_B_.CUR_SP_R   := TO_REAL(RB2_SPEED.c.c);\nELSIF GVL.RB_B.COORD = SMC_COORD_SYSTEM.ACS THEN\n\tGVL.RB_B_.CUR_SP_X    := TO_REAL(RB2_SPEED.a.a0);\n\tGVL.RB_B_.CUR_SP_Y   := TO_REAL(RB2_SPEED.a.a1);\n\tGVL.RB_B_.CUR_SP_Z    := TO_REAL(RB2_SPEED.a.a2);\n\tGVL.RB_B_.CUR_SP_R   := TO_REAL(RB2_SPEED.a.a3);\t\nEND_IF\n{endregion}\n{region \"3. READ_POS/VELOCITY_CURRENT_AXIS Z\"}\t \n// READ POSITION & SPEED axis R\n// MC_ReadActualPosition_R.Enable := TRUE;\n// GVL.M_R_.CUR_POS := TO_REAL(R_POS);\n// GVL.M_R_.CUR_SP := TO_REAL(R_SPEED);\n{endregion}\n{region \"4. CONDITION RUNGNING RB\"}\nGVL.RB_A_.Runing := POU_JOG_ROBOT.SMC_GroupJog2_1.Busy OR POU_MOTION.MOVC_A.Busy OR POU_MOTION.MOVP_A.Busy OR POU_MOTION.MOVL_A.Busy ;\nGVL.RB_B_.Runing := POU_JOG_ROBOT.SMC_GroupJog2_2.Busy OR POU_MOTION.MOVC_B.Busy OR POU_MOTION.MOVP_B.Busy OR POU_MOTION.MOVL_B.Busy ;\t \n{endregion}","LineInfoPersistence":"(string)f1100419-ea84-4467-9228-3bf5856ee195_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)65"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}