{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6b63341f-3e2d-4af5-9a17-92200071d33c","ParentGuid":"(Guid)375271f5-d5cb-47c6-987f-89a997b63457","Name":"(string)Qty_Production","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// In_Qty := GVL.Pro4_.Signal_In.T_Cv_In_1.q;\nIn_Qty := (POU_MOTION.Pro_A4 = 80);\nIn_Qty_NG_VS := (POU_MOTION.Pro_A4 = 90);\nIn_Qty_NG_TS := (POU_MOTION.Pro_A4 = 100);\n// Reset 08:00\nShift_Reset_Day := (hour = 8) AND (minute = 0);\n\n// Reset 20:00\nShift_Reset_Night := (hour = 20) AND (minute = 0);\n\n// ===== RESET day shift =====\nIF  ( (Shift_Reset_Day = TRUE) AND (Shift_Reset_Day_Old = FALSE) ) OR Clear_all THEN\n    FOR i := 0 TO 11 DO\n        GVL.Pro4_.Monitor.D_Day_Pro_OK[i] := 0;\n\t\tGVL.Pro4_.Monitor.D_Day_Pro_NG_VS[i] := 0;\n\t\tGVL.Pro4_.Monitor.D_Day_Pro_NG_TS[i] := 0;\n    END_FOR\nEND_IF\nShift_Reset_Day_Old := Shift_Reset_Day;\n\n\n// ===== RESET night shift =====\nIF ((Shift_Reset_Night = TRUE) AND (Shift_Reset_Night_Old = FALSE)) OR Clear_all THEN\n    FOR i := 0 TO 11 DO\n        GVL.Pro4_.Monitor.D_Night_Pro_OK[i] := 0;\n\t\tGVL.Pro4_.Monitor.D_Night_Pro_NG_VS[i] := 0;\n\t\tGVL.Pro4_.Monitor.D_Night_Pro_NG_TS[i] := 0;\n    END_FOR\nEND_IF\nShift_Reset_Night_Old := Shift_Reset_Night;\t\t\n\n/// counter OK\nIF (In_Qty = TRUE) AND (In_Qty_old = FALSE) THEN\n\n    // 8h -> 19h \n    IF (hour >= 8) AND (hour < 20) THEN\n        GVL.Pro4_.Monitor.D_Day_Pro_OK[hour - 8] := GVL.Pro4_.Monitor.D_Day_Pro_OK[hour - 8] + 1;\n    END_IF\n\n    // 20h -> 7h \n    IF (hour >= 20) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_OK[hour - 20] := GVL.Pro4_.Monitor.D_Night_Pro_OK[hour - 20] + 1;\n    ELSIF (hour < 8) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_OK[hour + 4] := GVL.Pro4_.Monitor.D_Night_Pro_OK[hour + 4] + 1;\n    END_IF\n\nEND_IF\nIn_Qty_old := In_Qty;\n\n/// counter NG_VS\nIF (In_Qty_NG_VS = TRUE) AND (In_Qty_old_NG_VS = FALSE) THEN\n\n    // 8h -> 19h \n    IF (hour >= 8) AND (hour < 20) THEN\n        GVL.Pro4_.Monitor.D_Day_Pro_NG_VS[hour - 8] := GVL.Pro4_.Monitor.D_Day_Pro_NG_VS[hour - 8] + 1;\n    END_IF\n\n    // 20h -> 7h \n    IF (hour >= 20) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_NG_VS[hour - 20] := GVL.Pro4_.Monitor.D_Night_Pro_NG_VS[hour - 20] + 1;\n    ELSIF (hour < 8) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_NG_VS[hour + 4] := GVL.Pro4_.Monitor.D_Night_Pro_NG_VS[hour + 4] + 1;\n    END_IF\n\nEND_IF\nIn_Qty_old_NG_VS := In_Qty_NG_VS;\n\n/// counter NG_TS\nIF (In_Qty_NG_TS = TRUE) AND (In_Qty_old_NG_TS = FALSE) THEN\n\n    // 8h -> 19h \n    IF (hour >= 8) AND (hour < 20) THEN\n        GVL.Pro4_.Monitor.D_Day_Pro_NG_TS[hour - 8] := GVL.Pro4_.Monitor.D_Day_Pro_NG_TS[hour - 8] + 1;\n    END_IF\n\n    // 20h -> 7h \n    IF (hour >= 20) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_NG_TS[hour - 20] := GVL.Pro4_.Monitor.D_Night_Pro_NG_TS[hour - 20] + 1;\n    ELSIF (hour < 8) THEN\n        GVL.Pro4_.Monitor.D_Night_Pro_NG_TS[hour + 4] := GVL.Pro4_.Monitor.D_Night_Pro_NG_TS[hour + 4] + 1;\n    END_IF\n\nEND_IF\nIn_Qty_old_NG_TS := In_Qty_NG_TS;\n\n/// Total Production\n// GVL.Pro4_.Monitor.Total_Day := 0;\n// GVL.Pro4_.Monitor.Total_Night := 0;\nGVL.Pro4_.Monitor.Total_Day_OK := 0;\nGVL.Pro4_.Monitor.Total_Night_OK := 0;\nGVL.Pro4_.Monitor.Total_Day_NG_VS := 0;\nGVL.Pro4_.Monitor.Total_Night_NG_VS := 0;\nGVL.Pro4_.Monitor.Total_Day_NG_TS := 0;\nGVL.Pro4_.Monitor.Total_Night_NG_TS := 0;\n\nFOR i_qty := 0 TO 11 BY 1 DO\n\tGVL.Pro4_.Monitor.Total_Day_OK := GVL.Pro4_.Monitor.Total_Day_OK + GVL.Pro4_.Monitor.D_Day_Pro_OK[i_qty];\n\tGVL.Pro4_.Monitor.Total_Night_OK := GVL.Pro4_.Monitor.Total_Night_OK +GVL.Pro4_.Monitor.D_Night_Pro_OK[i_qty];\n\tGVL.Pro4_.Monitor.Total_Day_NG_VS := GVL.Pro4_.Monitor.Total_Day_NG_VS + GVL.Pro4_.Monitor.D_Day_Pro_NG_VS[i_qty];\n\tGVL.Pro4_.Monitor.Total_Night_NG_VS := GVL.Pro4_.Monitor.Total_Night_NG_VS + GVL.Pro4_.Monitor.D_Night_Pro_NG_VS[i_qty];\n\tGVL.Pro4_.Monitor.Total_Day_NG_TS := GVL.Pro4_.Monitor.Total_Day_NG_TS + GVL.Pro4_.Monitor.D_Day_Pro_NG_TS[i_qty];\n\tGVL.Pro4_.Monitor.Total_Night_NG_TS := GVL.Pro4_.Monitor.Total_Night_NG_TS +GVL.Pro4_.Monitor.D_Night_Pro_NG_TS[i_qty];\nEND_FOR\nGVL.Pro4_.Monitor.Total_Day_NG := GVL.Pro4_.Monitor.Total_Day_NG_VS + GVL.Pro4_.Monitor.Total_Day_NG_TS;\nGVL.Pro4_.Monitor.Total_Night_NG := GVL.Pro4_.Monitor.Total_Night_NG_VS + GVL.Pro4_.Monitor.Total_Night_NG_TS;\nGVL.Pro4_.Monitor.Total_Day := GVL.Pro4_.Monitor.Total_Day_OK + GVL.Pro4_.Monitor.Total_Day_NG;\nGVL.Pro4_.Monitor.Total_Night := GVL.Pro4_.Monitor.Total_Night_OK + GVL.Pro4_.Monitor.Total_Night_NG;\nGVL.Pro4_.Monitor.All_Shift_OK := GVL.Pro4_.Monitor.Total_Day_OK + GVL.Pro4_.Monitor.Total_Night_OK;\nGVL.Pro4_.Monitor.All_Shift_NG := GVL.Pro4_.Monitor.Total_Day_NG + GVL.Pro4_.Monitor.Total_Night_NG;\nGVL.Pro4_.Monitor.All_Shift := GVL.Pro4_.Monitor.Total_Day + GVL.Pro4_.Monitor.Total_Night;","LineInfoPersistence":"(string)6b63341f-3e2d-4af5-9a17-92200071d33c_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)110"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}