{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)a460ce93-1776-4d94-9d55-0e9c8f3080e9","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_GlueRunMode","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9e1f02d8-5bba-4bcc-a63a-6b70bdcae5c5"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_GlueRunMode :\n(\n    GLUE_MODE_NONE := 0,              // Chưa chọn chế độ.\n\n    GLUE_MODE_STATIC := 10,            // Sản phẩm đứng yên.\n    GLUE_MODE_WORK_OFFSET := 20,       // Đường keo áp dụng work offset.\n    GLUE_MODE_CONVEYOR_PCS1 := 30,     // Bôi keo trong PCS_1.\n    GLUE_MODE_CONVEYOR_PCS2 := 40,     // Bôi keo trong PCS_2.\n    GLUE_MODE_DRY_RUN := 50            // Robot chạy path nhưng không bật keo.\n);\nEND_TYPE","LineInfoPersistence":"(string)a460ce93-1776-4d94-9d55-0e9c8f3080e9_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)13"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}