{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)83d2761b-3eb1-4a53-a43d-ca23cc6a8945","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)A2_Place_T1_OK_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Project_4_Delay_A2(PT := TO_TIME(GVL.Pro4_.ST_A.TDelay_Place_T1)*100);\nIF Place_OK_A4_T1_Run THEN\n\tCASE PRO_A4_[2] OF\n\t\t0: // RESET\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\t\t\n\t\t\t\tProject_4_Delay_A2.IN := FALSE;\t\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\n\t\t10: // BF Z Plcae T1  Namnv\n// \t\t\tM_CHOOSE_POS(DATA := 0, ID := 4, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 3 BF Place OK 1\n// \t\t\tIF NOT A4_Run_P THEN\n// \t\t\t\tA_Comp\t := FALSE;\n// \t\t\t\tA4_Run_P := TRUE;\n// \t\t\tEND_IF\t\n// \t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n// \t\t\t\tA4_Run_L\t:= FALSE;\n// \t\t\t\tA4_Run_P \t:= FALSE;\t \n// \t\t\tEND_IF;\t\t\t\n// \t\n// \t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n// \t\t\t\tA4_Run_L\t := FALSE;\n// \t\t\t\tA4_Run_P\t := FALSE;\n// \t\t\t\tA_Comp\t\t := FALSE;\n// \t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\t\t \n// \t\t\tEND_IF;\n\t\t\t\n\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\t\n\t\n\t\t20: // BF XY Place T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 4, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 3\n\t\t\t//IF NOT A4_Run_P THEN\n\t\t\tRBA_BufferMode := 5;\n\t\t\tIF (NOT A4_Run_P) AND (NOT A4_Run_L) THEN //namnv\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\t\t// namnv0304\n// \t\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 OR GVL.Pro4_.Process.DATA_TOOL_A1_IN = 3) AND (GVL.Pro4_.Process.DATA_TOOL_A2_OUT = 2 OR GVL.Pro4_.Process.DATA_TOOL_A2_OUT = 3) AND (Pro_A4_BF = 70) THEN\n// \t\t\t\t\tA4_Run_L \t:= TRUE;\n// \t\t\t\tELSE\n// \t\t\t\t\tA4_Run_P \t:= TRUE;\n// \t\t\t\tEND_IF\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\t//IF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\tIF A_Comp AND (A4_Run_L OR A4_Run_P) AND A_Allow_NextStep THEN //namnv\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\t\t \n\t\t\tEND_IF;\n\t\t30: // CHECK ALLOW PICK MC2\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_VS = 2 THEN\n\t\t\t//IF TRUE THEN\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\t\n\t\t\tEND_IF;\t\n\t\t35:// quay tool trước\n\t\t\tM_R_Mov(DATA:= 0, ID := 5, R_ := TRUE, X_ := FALSE, Y_ := FALSE, Z_ := FALSE);\n\t\t\tRBA_BufferMode := 5;\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\t\t \n\t\t\n\t\t\tEND_IF;\t\n\t\t\n\t\t40: // XY Place T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 5, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n\t\t\tRBA_BufferMode := 0;\n\t\t\t//IF NOT A4_Run_P THEN\n\t\t\tIF (NOT A4_Run_P) AND (NOT A4_Run_L) THEN //namnv\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\t\t// namnv\n// \t\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 OR GVL.Pro4_.Process.DATA_TOOL_A1_IN = 3) AND (GVL.Pro4_.Process.DATA_TOOL_A2_OUT = 2 OR GVL.Pro4_.Process.DATA_TOOL_A2_OUT = 3) AND (Pro_A4_BF = 70) THEN\n// \t\t\t\t\tA4_Run_L \t:= TRUE;\n// \t\t\t\tELSE\n// \t\t\t\t\tA4_Run_P \t:= TRUE;\n// \t\t\t\tEND_IF\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\t//IF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\tIF A_Comp AND (A4_Run_L OR A4_Run_P) AND A_Allow_NextStep THEN //namnv\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\t\t \n\t\t\tEND_IF;\t\n\t\t50: // Z Place T1 - Before 15mm\n\t\t\tM_CHOOSE_POS_Z_BF(DATA := 0, ID := 5, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2 PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\t\t \n\t\t\tEND_IF;\n\t\t55: // Z Place T1\n\t\t\tchange_fac_vel_A := TRUE;\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 5, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2 PICK 1\n\t\t\tIF NOT A4_Run_P AND (GVL.Fac_Vel_Set_A = GVL.Fac_Vel_Slow) THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\n\t\t\t\tchange_fac_vel_A := FALSE;\t\t \n\t\t\tEND_IF;\n\t\t\t\n\t\t60: // ON VACUUM\n\t\t\tGVL.RB_A_.Tool_1 := FALSE;\n\t\t\tProject_4_Delay_A2.IN:= TRUE;\n\t\t\tIF Project_4_Delay_A2.Q AND A_Allow_NextStep  THEN\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10; \t\n\t\t\tEND_IF;\n\t\t70: // BF Z Place OK T1\n\t\t\t\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 4, XYR_CONST := TRUE, Z_CONST:= FALSE); \n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A2_OUT = 2) THEN\n\t\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := GVL.Pro4_.Process.DATA_TOOL_A1_IN;\n\t\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 0;\n\t\t\t\t\tPRO_A4_[2] := 90;\n\t\t\t\tELSE\n\t\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 10;\t\n\t\t\t\tEND_IF\n\t\t\t\t\n\t\t\t\t \n\t\t\tEND_IF;\n\t\t80: // BF XY PPlace OK T1\n\t\t\t//M_CHOOSE_POS(DATA := 0, ID := 4, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 4\n\t\t\tRBA_BufferMode := 5;\n\t\t\tM_R_Mov(DATA:= 0, ID := 4, R_ := FALSE, X_ := TRUE, Y_ := TRUE, Z_ := FALSE);\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\t\t \n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := GVL.Pro4_.Process.DATA_TOOL_A1_IN;\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 0;\n\t\t\tEND_IF\n\t\t\t// namnv\n\t\t\t\n\t\t85:// quay tool sau\n\t\t\tM_R_Mov(DATA:= 0, ID := 4, R_ := TRUE, X_ := FALSE, Y_ := FALSE, Z_ := FALSE);\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[2] := PRO_A4_[2] + 5;\t\t \n\t\t\n\t\t\tEND_IF;\t\t\t\n\t\t\n\t\t90: // Done\n\t\t\tRBA_BufferMode := 0;\n\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 0;\n\t\t\tProject_4_Delay_A2.IN := FALSE;\t\n\t\t\tPlace_OK_A4_T1_Finish := TRUE;\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_A4_[2] := 0;\nEND_IF","LineInfoPersistence":"(string)83d2761b-3eb1-4a53-a43d-ca23cc6a8945_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)222"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}