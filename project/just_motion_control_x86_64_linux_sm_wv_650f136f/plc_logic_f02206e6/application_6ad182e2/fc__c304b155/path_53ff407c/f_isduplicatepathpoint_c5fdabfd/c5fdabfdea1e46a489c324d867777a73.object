{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c5fdabfd-ea1e-46a4-89c3-24d867777a73","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_IsDuplicatePathPoint","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)53ff407c-8074-409a-8b9d-37ffed04487e"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)rDistance :=\n    F_PathPointDistance(\n        Point1 := Point1,\n        Point2 := Point2\n    );\n\nrAngleDiff :=\n    ABS(\n        F_NormalizeAngleDeg(\n            AngleDeg := Point2.Pos.A - Point1.Pos.A\n        )\n    );\n\n// Hai điểm được coi là trùng khi cả khoảng cách và góc đều rất nhỏ.\nF_IsDuplicatePathPoint :=\n    rDistance <= MinDistance\n    AND rAngleDiff <= MaxAngleDifference;","LineInfoPersistence":"(string)c5fdabfd-ea1e-46a4-89c3-24d867777a73_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_IsDuplicatePathPoint : BOOL\nVAR_INPUT\n    Point1           : ST_PATH_POINT;   // Điểm thứ nhất.\n    Point2           : ST_PATH_POINT;   // Điểm thứ hai.\n    MinDistance      : REAL;            // Khoảng cách nhỏ nhất, mm.\n    MaxAngleDifference : REAL;          // Chênh lệch góc nhỏ nhất, độ.\nEND_VAR\n\nVAR\n    rDistance  : REAL;    // Khoảng cách hai điểm.\n    rAngleDiff : REAL;    // Chênh lệch góc tuyệt đối.\nEND_VAR\n","LineInfoPersistence":"(string)c5fdabfd-ea1e-46a4-89c3-24d867777a73_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)30","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}