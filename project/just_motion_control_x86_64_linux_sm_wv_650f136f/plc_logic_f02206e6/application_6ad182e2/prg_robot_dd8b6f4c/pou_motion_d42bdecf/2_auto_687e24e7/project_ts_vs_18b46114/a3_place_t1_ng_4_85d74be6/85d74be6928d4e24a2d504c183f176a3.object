{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)85d74be6-928d-4e24-a2d5-04c183f176a3","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)A3_Place_T1_NG_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Project_4_Delay_A(PT := TO_TIME(GVL.Pro4_.ST_A.TDelay_Place_T1)*100);\nIF Place_NG_A4_T1_Run THEN\n\tCASE PRO_A4_[3] OF\n\t\t0: // RESET\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\t\t\n\t\t\t\tProject_4_Delay_A.IN := FALSE;\t\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\n\t\t10: // BF Z Plcae NG T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 6, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 3 BF Place OK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // BF XY Place T1\n\t\t\tM_R_Mov(DATA:= 0, ID := 6, R_ := FALSE, X_ := TRUE, Y_ := TRUE, Z_ := FALSE);\n\t\t\t//M_CHOOSE_POS(DATA := 0, ID := 6, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 3\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 5;\t\t \n\t\t\tEND_IF;\n\t\t25: // BF XY Place T1\n\t\t\tM_R_Mov(DATA:= 0, ID := 6, R_ := TRUE, X_ := FALSE, Y_ := FALSE, Z_ := FALSE);\n\t\t\t//M_CHOOSE_POS(DATA := 0, ID := 6, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 3\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 5;\t\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t30: // CHECK ALLOW PLACE CNV NG TS\n\t\t\tIF ALLOW_PLACE_CNV_NG_TS THEN\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\n\t\t\tEND_IF;\t\n\t\t40: // XY Place NG T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 7, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\t \n\t\t\tEND_IF;\t\n\t\t50: // Z Place T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 7, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2 PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\t \n\t\t\tEND_IF;\n\t\t\n\t\t60: // OFF VACUUM\n\t\t\tGVL.RB_A_.Tool_1 := FALSE;\n\t\t\tProject_4_Delay_A.IN:= TRUE;\n\t\t\tIF Project_4_Delay_A.Q AND A_Allow_NextStep  THEN\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10; \t\n\t\t\tEND_IF;\n\t\t70: // BF Z Place NG T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 6, XYR_CONST := TRUE, Z_CONST:= FALSE); \n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\t \n\t\t\tEND_IF;\n\t\t80: // BF XY PPlace NG T1\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 6, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 4\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    := FALSE;\t\n\t\t\t\tPRO_A4_[3] := PRO_A4_[3] + 10;\t\t \n\t\t\tEND_IF\n\t\t\n\t\t90: // Done\n\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 0;\n\t\t\tProject_4_Delay_A.IN := FALSE;\t\n\t\t\tPlace_NG_A4_T1_Finish    := TRUE;\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_A4_[3] := 0;\nEND_IF","LineInfoPersistence":"(string)85d74be6-928d-4e24-a2d5-04c183f176a3_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)146"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}