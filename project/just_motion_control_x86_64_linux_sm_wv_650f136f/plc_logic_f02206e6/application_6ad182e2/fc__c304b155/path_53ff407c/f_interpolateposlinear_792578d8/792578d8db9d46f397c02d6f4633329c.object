{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)792578d8-db9d-46f3-97c0-2d6f4633329c","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_InterpolatePosLinear","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)53ff407c-8074-409a-8b9d-37ffed04487e"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)rFactor := LIMIT(0.0, Factor, 1.0);\n\nF_InterpolatePosLinear.X :=\n    StartPos.X + (EndPos.X - StartPos.X) * rFactor;\n\nF_InterpolatePosLinear.Y :=\n    StartPos.Y + (EndPos.Y - StartPos.Y) * rFactor;\n\nF_InterpolatePosLinear.Z :=\n    StartPos.Z + (EndPos.Z - StartPos.Z) * rFactor;\n\n// Nội suy góc theo hướng ngắn nhất qua biên ±180 độ.\nrAngleDiff :=\n    F_NormalizeAngleDeg(\n        AngleDeg := EndPos.A - StartPos.A\n    );\n\nF_InterpolatePosLinear.A :=\n    F_NormalizeAngleDeg(\n        AngleDeg := StartPos.A + rAngleDiff * rFactor\n    );","LineInfoPersistence":"(string)792578d8-db9d-46f3-97c0-2d6f4633329c_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_InterpolatePosLinear : ST_POS\nVAR_INPUT\n    StartPos : ST_POS;    // Điểm bắt đầu.\n    EndPos   : ST_POS;    // Điểm kết thúc.\n    Factor   : REAL;      // Hệ số nội suy 0...1.\nEND_VAR\n\nVAR\n    rFactor    : REAL;    // Hệ số sau giới hạn.\n    rAngleDiff : REAL;    // Chênh lệch góc ngắn nhất.\nEND_VAR","LineInfoPersistence":"(string)792578d8-db9d-46f3-97c0-2d6f4633329c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)32","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}