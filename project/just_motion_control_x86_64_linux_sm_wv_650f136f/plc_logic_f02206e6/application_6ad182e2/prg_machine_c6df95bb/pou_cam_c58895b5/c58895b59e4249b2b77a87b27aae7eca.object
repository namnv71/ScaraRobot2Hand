ng cac vi tri calib\n// \t\tGVL.MODBUS[GVL.NB_Register_Modbus_VS *i_Vs].2 := GVL.Man_Calib_RB[i_Vs].Run_Pos_Calib_Done OR GVL.Auto_VS_RB[i_Vs].Run_Pos_Calib_Done;\n// \t\t// Tin hieu bao Trigger Done tu VS System\n// \t\tGVL.Man_Calib_RB[i_Vs].Trigger_Done := GVL.MODBUS[GVL.NB_Register_Modbus_VS *i_Vs + 100].1;\n// \t\tGVL.Auto_VS_RB[i_Vs].Trigger_Done := GVL.MODBUS[GVL.NB_Register_Modbus_VS *i_Vs + 100].1;\n// \t\t// Tin hieu bao Calib Done tu VS System\n// \t\tGVL.Man_Calib_RB[i_Vs].Calib_VS_Done := GVL.MODBUS[GVL.NB_Register_Modbus_VS *i_Vs + 100].2;\n// \t\tGVL.Auto_VS_RB[i_Vs].Calib_VS_Done := GVL.MODBUS[GVL.NB_Register_Modbus_VS *i_Vs + 100].2;\t\t\n// \tEND_IF\n// END_FOR\n// // GVL.MODBUS[0].1 := TRIGGER_TOP;\n// IF (GVL.MODBUS[0].1) THEN\n// \tTrigger_Busy := TRUE;\n// ELSE\n// \tTrigger_Busy := FALSE;\n// END_IF;\n// //TRIGGER_DONE := GVL.MODBUS[100].1; // doc tin hieu bao trigger done\n// // R_Trig_TriggerDone(CLK := GVL.MODBUS[100].1 );\n// // IF Trigger_Busy AND R_Trig_TriggerDone.Q AND NOT GVL.X[8]  THEN\n// // \tTRIGGER_DONE := TRUE;\n// // END_IF\n// \n// //TRIGGER_DONE := GVL.MODBUS[100].1;\n// \n// GVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done := TRIGGER_DONE;\n// GVL.Pro4_.Man.Result_Trigger_Vs_Align_Done := TRIGGER_DONE;\n// //  Bit control - Calib\n// //GVL.MODBUS[0].2 := GVL.Pro4_.Man.Run_Calib_Pos_Done;\n// GVL.Pro4_.Man.Result_Calib_Done := GVL.MODBUS[100].2;\n// \n// \n// \n// // Funtion run\n// ACT_TRIGGER_TOP();\n// ACT_CHECKCONNECT();\n// //ACT_Total();\n// \n// \n// // \tRB_A_READ_CAM(\tR_RB_X\t:= TO_REAL(GVL.RB_A_.CUR_X),\n// // \t\t\t\t\tR_RB_Y\t:= TO_REAL(GVL.RB_A_.CUR_Y),\n// // \t\t\t\t\tR_RB_r\t:= TO_REAL(GVL.RB_A_.CUR_R),\n// // \t\t\t\t\tLOW_RB_X\t=> GVL.MODBUS[2],\n// // \t\t\t\t\tHIGH_RB_X\t=> GVL.MODBUS[3],\n// // \t\t\t\t\tLOW_RB_Y\t=> GVL.MODBUS[4],\n// // \t\t\t\t\tHIGH_RB_Y\t=> GVL.MODBUS[5],\n// // \t\t\t\t\tLOW_RB_R\t=> GVL.MODBUS[6],\n// // \t\t\t\t\tHIGH_RB_R\t=> GVL.MODBUS[7]);\t\t\t\t\t\t\t\t\n// // \tRB_B_READ_CAM(\tR_RB_X\t:= TO_REAL(GVL.RB_B_.CUR_X),\n// // \t\t\t\t\tR_RB_Y\t:= TO_REAL(GVL.RB_B_.CUR_Y),\n// // \t\t\t\t\tR_RB_r\t:= TO_REAL(GVL.RB_B_.CUR_R),\n// // \t\t\t\t\tLOW_RB_X\t=> GVL.MODBUS[8],\n// // \t\t\t\t\tHIGH_RB_X\t=> GVL.MODBUS[9],\n// // \t\t\t\t\tLOW_RB_Y\t=> GVL.MODBUS[10],\n// // \t\t\t\t\tHIGH_RB_Y\t=> GVL.MODBUS[11],\n// // \t\t\t\t\tLOW_RB_R\t=> GVL.MODBUS[12],\n// // \t\t\t\t\tHIGH_RB_R\t=> GVL.MODBUS[13]);\t\n// \t\t\t\t\t\t\t\t\n// RB_T1_WRITE(W_LOW_CAM_X := GVL.MODBUS[102],\n// \t\t\tW_HIGH_CAM_X := GVL.MODBUS[103],\n// \t\t\tW_LOW_CAM_Y := GVL.MODBUS[104],\n// \t\t\tW_HIGH_CAM_Y := GVL.MODBUS[105],\n// \t\t\tW_LOW_CAM_R := GVL.MODBUS[106],\n// \t\t\tW_HIGH_CAM_R := GVL.MODBUS[107],\n// \t\t\tCAM_X\t=> GVL.Cam_T1.POS_X_OFFSET,\n// \t\t\tCAM_Y\t=> GVL.Cam_T1.POS_Y_OFFSET,\n// \t\t\tCAM_R\t=> GVL.Cam_T1.POS_R_OFFSET);\n// \n// IF (TRIGGER_DONE) THEN\n// \tGVL.Pro4_.Auto.Result_Trigger_Vs_Align_Done := TRUE;\n// \tGVL.Pro4_.Man.Result_Trigger_Vs_Align_Done := TRUE;\n// END_IF;\t\t\n// // \tRB_T1_READ_CAM_OFFSET(\tW_LOW_CAM_X := GVL.MODBUS[114],\n// // \t\t\t\t\t\t\tW_HIGH_CAM_X := GVL.MODBUS[115],\n// // \t\t\t\t\t\t\tW_LOW_CAM_Y := GVL.MODBUS[116],\n// // \t\t\t\t\t\t\tW_HIGH_CAM_Y := GVL.MODBUS[117],\n// // \t\t\t\t\t\t\tW_LOW_CAM_R := GVL.MODBUS[118],\n// // \t\t\t\t\t\t\tW_HIGH_CAM_R := GVL.MODBUS[119],\n// // \t\t\t\t\t\t\tCAM_X\t=> GVL.Cam_T1.POS_X_OFFSET,\n// // \t\t\t\t\t\t\tCAM_Y\t=> GVL.Cam_T1.POS_Y_OFFSET,\n// // \t\t\t\t\t\t\tCAM_R\t=> GVL.Cam_T1.POS_R_OFFSET);\t\n// \t\t\t\n// // \tRB_T2_WRITE(\tW_LOW_CAM_X := GVL.MODBUS[108],\n// // \t\t\t\tW_HIGH_CAM_X := GVL.MODBUS[109],\n// // \t\t\t\tW_LOW_CAM_Y := GVL.MODBUS[110],\n// // \t\t\t\tW_HIGH_CAM_Y := GVL.MODBUS[111],\n// // \t\t\t\tW_LOW_CAM_R := GVL.MODBUS[112],\n// // \t\t\t\tW_HIGH_CAM_R := GVL.MODBUS[113],\n// // \t\t\t\tCAM_X\t=> GVL.Cam_T2.Pos_X,\n// // \t\t\t\tCAM_Y\t=> GVL.Cam_T2.Pos_Y,\n// // \t\t\t\tCAM_R\t=> GVL.Cam_T2.Pos_R);\n// \t\t\t\t\n// // \tRB_T2_READ_CAM_OFFSET(\tW_LOW_CAM