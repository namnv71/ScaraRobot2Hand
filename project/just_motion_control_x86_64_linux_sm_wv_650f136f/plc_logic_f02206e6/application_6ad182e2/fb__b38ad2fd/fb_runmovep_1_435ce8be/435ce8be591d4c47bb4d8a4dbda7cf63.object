{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)435ce8be-591d-4c47-bb4d-8a4dbda7cf63","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_RunMoveP_1","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//====================================================\n// FB_RunMoveP\n// Dùng cho MC_MoveDirectAbsolute\n// MoveP KHÔNG có Velocity / Acc / Dec / Jerk\n// Chỉ dùng VelFactor / AccFactor / JerkFactor / TorqueFactor\n//====================================================\n\n// Bắt cạnh lên Start\nStartEdge := Start AND NOT LastStart;\nLastStart := Start;\n\n// Output dạng pulse\nAccepted := FALSE;\nDone := FALSE;\nTimeout := FALSE;\nAborted := FALSE;\n\n// Execute chỉ ON trong state MOVE_SEND\nExecutePulse := StartEdge;\n\n\n// MoveP chỉ lấy Factor\nVelFacLocal    := GVL_1.DATA_RB_A.Fac_Vel;\nAccFacLocal    := GVL_1.DATA_RB_A.Fac_Acc;\nJerkFacLocal   := GVL_1.DATA_RB_A.Fac_Jerk;\nTorqueFacLocal := GVL_1.DATA_RB_A.Fac_Torque;\n\n// Giá trị an toàn\nIF VelFacLocal <= 0.0 THEN VelFacLocal := 0.1; END_IF;\nIF AccFacLocal <= 0.0 THEN AccFacLocal := 0.1; END_IF;\nIF JerkFacLocal <= 0.0 THEN JerkFacLocal := 0.1; END_IF;\nIF TorqueFacLocal <= 0.0 THEN TorqueFacLocal := 0.1; END_IF;\n\n// Mapping Blend\n\n\n\t// Không blend\n\tBufferMode := GVL.C_BM_Aborting;\n\tTransMode  := C_TM_None;\n\tTransParam[0] := 0.0;\n\tTransParam[1] := 0.0;\n\n\n\n\nPosBuf := PositionIn;\n//Gọi FB gốc\nfbMoveP(\n    AxisGroup := AxisGroup,\n    Execute := Start,\n\n    Position := PosBuf,\n    CoordSystem := CoordSystem,\n\n    BufferMode := BufferMode,\n    TransitionMode := TransMode,\n    TransitionParameter := TransParam,\n\n    VelFactor := VelFacLocal,\n    AccFactor := AccFacLocal,\n    JerkFactor := JerkFacLocal,\n    TorqueFactor := TorqueFacLocal\n);\n\nBusy := fbMoveP.Busy;\nActive := fbMoveP.Active;","LineInfoPersistence":"(string)435ce8be-591d-4c47-bb4d-8a4dbda7cf63_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_RunMoveP_1\nVAR_INPUT\n    Start       : BOOL;\n    \n    Item        : ST_MotionQueueItem;\n    PositionIn  : SMC_POS_REF;\n    CoordSystem : SMC_COORD_SYSTEM;\n\n    AcceptTimeoutTime : TIME := T#2S;\n    MoveTimeoutTime   : TIME := T#10S;\n    PosCheckDelayTime : TIME := T#100MS;\nEND_VAR\n\nVAR_OUTPUT\n    Accepted       : BOOL;\n    Done           : BOOL;\n    Busy           : BOOL;\n    Active         : BOOL;\n    Error          : BOOL;\n    Timeout        : BOOL;\n    Aborted        : BOOL;\n    ErrorID        : SMC_ERROR;\n    ErrorID_Custom : INT;\n    State          : E_MoveState;\nEND_VAR\nVAR_IN_OUT\n\tAxisGroup   : AXIS_GROUP_REF_SM3;\nEND_VAR\nVAR\n    fbMoveP : MC_MoveDirectAbsolute;\n\n    tAcceptTimeout : TON;\n    tMoveTimeout   : TON;\n    tPosCheckDelay : TON;\n\n    StartEdge    : BOOL;\n    LastStart    : BOOL;\n    ExecutePulse : BOOL;\n\n    PosBuf : SMC_POS_REF;\n\n    BufferMode : SM3_Robotics.MC_BUFFER_MODE;\n    TransMode  : SM3_Robotics.MC_TRANSITION_MODE;\n    TransParam : ARRAY[0..(SMC_RCNST.MAX_TRANS_PARAMS - 1)] OF LREAL := [0.0, 0.0];\n\n    VelFacLocal    : LREAL;\n    AccFacLocal    : LREAL;\n    JerkFacLocal   : LREAL;\n    TorqueFacLocal : LREAL;\nEND_VAR\n\nVAR CONSTANT\n    C_BM_Buffered     : SM3_Robotics.MC_BUFFER_MODE := 1;\n    C_BM_BlendingNext : SM3_Robotics.MC_BUFFER_MODE := 4;\n\n    C_TM_CornerDistance : SM3_Robotics.MC_TRANSITION_MODE := 2;\n    C_TM_None           : SM3_Robotics.MC_TRANSITION_MODE := 0;\n    C_TM_StartVelocity  : SM3_Robotics.MC_TRANSITION_MODE := 1;\nEND_VAR","LineInfoPersistence":"(string)435ce8be-591d-4c47-bb4d-8a4dbda7cf63_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)125","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}