{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9263aadc-88e2-4bc7-8dd0-fe613add6b1f","ParentGuid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","Name":"(string)ACT_SAVE_FILE","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Duyet de kiem tra tin hieu luu va doc du lieu CAM\nFOR i_cam := 0 TO 10 BY 1 DO\n\tGVL.RTrig_Save_Data_Cam[i_cam](CLK := GVL.Save_Data_Cam[i_cam]);\n\tGVL.RTrig_Load_Data_Cam[i_cam](CLK := GVL.Load_Data_Cam[i_cam]);\n\t// Luu du lieu CAM\n\tIF GVL.RTrig_Save_Data_Cam[i_cam].Q THEN\n\t\tfiledata.Save(    \n\t\t\tpData := ADR(GVL.Data_Calib_RB),\n\t\t\tuiSize := SIZEOF(GVL.Data_Calib_RB),\n\t\t\tsFileName := CONCAT('Data_Cam_',INT_TO_STRING(i_cam)));\n\tEND_IF\n\t// Doc lai du lieu CAM\n\tIF GVL.RTrig_Load_Data_Cam[i_cam].Q THEN\n\t\tfiledata.Load(    \n\t\t\tpData := ADR(GVL.Data_Calib_RB),\n\t\t\tuiSize := SIZEOF(GVL.Data_Calib_RB),\n\t\t\tsFileName := CONCAT('Data_Cam_',INT_TO_STRING(i_cam)));\n\t\tGVL.Load_Data_Cam[i_cam] := FALSE;\n\tEND_IF\nEND_FOR\n\n// Save All Tool Config to File\nr_Save_ToolConfig(CLK := GVL.g_stHMITool_Config_Save_All);\nIF r_Save_ToolConfig.Q THEN\n\t\n\tfiledata.Save(    \n\tpData := ADR(GVL.g_aToolConfigA),\n    uiSize := SIZEOF(GVL.g_aToolConfigA),\n    sFileName := 'Tool_Config_A.bin');\t\n\tGVL.g_stHMITool_Config_Save_All := FALSE;\nEND_IF\n\n// Read Tool Config From File\nr_Read_ToolConfig(CLK := GVL.g_stHMITool_Config_Read_All);\nIF r_Read_ToolConfig.Q OR Read_Config_First THEN\n\t\n\tfiledata.Load(    \n\tpData := ADR(GVL.g_aToolConfigA),\n    uiSize := SIZEOF(GVL.g_aToolConfigA),\n    sFileName := 'Tool_Config_A.bin');\t\n\tGVL.g_stHMITool_Config_Read_All := FALSE;\n\tGVL.g_stHMIToolEditorA.LoadCommand := TRUE; // cho doc du lieu tool hien tai\nEND_IF\n\n\n// Save Conveyor Config\nr_Save_ConveyorConfig(CLK:= GVL.g_stHMIConveyor_Config_Save);\nIF r_Save_ConveyorConfig.Q THEN\n\tfiledata.Save(    \n\tpData := ADR(GVL.g_aConveyorRuntime),\n    uiSize := SIZEOF(GVL.g_aConveyorRuntime),\n    sFileName := 'Conveyor_Config.bin');\n\t\nEND_IF\n\n// Read Conveyor Config\nr_Read_ConveyorConfig(CLK:= GVL.g_stHMIConveyor_Config_Read);\nIF r_Read_ConveyorConfig.Q OR Read_Config_First THEN\n\tfiledata.Load(    \n\tpData := ADR(GVL.g_aConveyorRuntime),\n    uiSize := SIZEOF(GVL.g_aConveyorRuntime),\n    sFileName := 'Conveyor_Config.bin');\n\tGVL.g_stHMIConveyor_Config_Read := FALSE;\nEND_IF\n\n// Save Tracking Config\nr_Save_TrackingConfig(CLK:= GVL.g_stHMITracking_Config_Save);\nIF r_Save_TrackingConfig.Q THEN\n\tfiledata.Save(    \n\tpData := ADR(GVL.g_stTrackingConfig_A),\n    uiSize := SIZEOF(GVL.g_stTrackingConfig_A),\n    sFileName := 'TrackingConfig_A.bin');\nEND_IF\n\n// Read Tracking Config\nr_Read_TrackingConfig(CLK:= GVL.g_stHMITracking_Config_Read);\nIF r_Read_TrackingConfig.Q OR Read_Config_First THEN\n\tfiledata.Load(    \n\tpData := ADR(GVL.g_stTrackingConfig_A),\n    uiSize := SIZEOF(GVL.g_stTrackingConfig_A),\n    sFileName := 'TrackingConfig_A.bin');\n\tGVL.g_stHMITracking_Config_Read := FALSE;\nEND_IF\n\n// Save All Senssor Source Config to File\n//r_Save_ToolConfig(CLK := GVL.g_stHMITool_Config_Save_All);\nIF GVL.g_xHMISaveSensorSourceA_All THEN\n\t\n\tfiledata.Save(    \n\tpData := ADR(GVL.g_aSensorSourceConfigA),\n    uiSize := SIZEOF(GVL.g_aSensorSourceConfigA),\n    sFileName := 'SensorSource_Config_A.bin');\t\n\tGVL.g_xHMISaveSensorSourceA_All := FALSE;\t\nEND_IF\n\n// Read Tool Config From File\nIF GVL.g_xHMILoadSensorSourceA_All OR Read_Config_First THEN\n\t\n\tfiledata.Load(    \n\tpData := ADR(GVL.g_aSensorSourceConfigA),\n    uiSize := SIZEOF(GVL.g_aSensorSourceConfigA),\n    sFileName := 'SensorSource_Config_A.bin');\t\n\tGVL.g_xHMILoadSensorSourceA_All := FALSE;\n\tGVL.g_xHMILoadSensorSourceA := TRUE; // cho doc du lieu senssor source hien tai\nEND_IF\n\n// Save All Recipe Config to File\nIF GVL.g_xHMISaveTrackingRecipeA_All THEN\n\t\n\tfiledata.Save(    \n\tpData := ADR(GVL.g_aMultiTrackRecipeA),\n    uiSize := SIZEOF(GVL.g_aMultiTrackRecipeA),\n    sFileName := 'MultiTrackRecipe_Config_A.bin');\t\n\tGVL.g_xHMISaveTrackingRecipeA_All := FALSE;\t\nEND_IF\n\n// Read Tool Config From File\nIF GVL.g_xHMILoadTrackingRecipeA_All OR Read_Config_First THEN\n\t\n\tfiledata.Load(    \n\tpData := ADR(GVL.g_aMultiTrackRecipeA),\n    uiSize := SIZEOF(GVL.g_aMultiTrackRecipeA),\n    sFileName := 'MultiTrackRecipe_Config_A.bin');\t\n\tGVL.g_xHMILoadTrackingRecipeA_All := FALSE;\n\tGVL.g_xHMILoadTrackingRecipeA := TRUE; // cho doc du lieu senssor source hien tai\nEND_IF\n\n\n\n\n//=============================================================================\n// SAVE ALL VISION TRACKING SOURCE CONFIG\n//=============================================================================\nIF GVL.g_xHMISaveAllVisionSourceA THEN\n\n    filedata.Save(\n        pData := ADR(GVL.g_aVisionTrackingSourceConfigA),\n        uiSize := SIZEOF(GVL.g_aVisionTrackingSourceConfigA),\n        sFileName := 'VisionTrackingSource_Config_A.bin'\n    );\n\n    GVL.g_xHMISaveAllVisionSourceA := FALSE;\n\nEND_IF;\n\n\n//=============================================================================\n// LOAD ALL VISION TRACKING SOURCE CONFIG\n//=============================================================================\nIF GVL.g_xHMILoadAllVisionSourceA OR Read_Config_First THEN\n\n    filedata.Load(\n        pData := ADR(GVL.g_aVisionTrackingSourceConfigA),\n        uiSize := SIZEOF(GVL.g_aVisionTrackingSourceConfigA),\n        sFileName := 'VisionTrackingSource_Config_A.bin'\n    );\n\n    GVL.g_xHMILoadAllVisionSourceA := FALSE;\n\n    // Sau khi đọc file, refresh Source đang hiển thị trên HMI.\n    GVL.g_xHMILoadVisionSourceA := TRUE;\n\nEND_IF;\n\n\n//=============================================================================\n// ROBOT B - SAVE / LOAD TRACKING HMI CONFIG\n// Parent: POU_Main -> ACT_SAVE_FILE\n// Chèn block này TRƯỚC dòng: Read_Config_First := FALSE;\n//=============================================================================\n\n// Tool Config B.\nIF GVL.g_xHMIToolConfigSaveAllB THEN\n    filedata.Save(pData := ADR(GVL.g_aToolConfigB), uiSize := SIZEOF(GVL.g_aToolConfigB), sFileName := 'Tool_Config_B.bin');\n    GVL.g_xHMIToolConfigSaveAllB := FALSE;\nEND_IF;\n\nIF GVL.g_xHMIToolConfigReadAllB OR Read_Config_First THEN\n    filedata.Load(pData := ADR(GVL.g_aToolConfigB), uiSize := SIZEOF(GVL.g_aToolConfigB), sFileName := 'Tool_Config_B.bin');\n    GVL.g_xHMIToolConfigReadAllB := FALSE;\n    GVL.g_stHMIToolEditorB.LoadCommand := TRUE;\nEND_IF;\n\n// Tracking Config B.\nIF GVL.g_xHMITrackingConfigSaveB THEN\n    filedata.Save(pData := ADR(GVL.g_stTrackingConfig_B), uiSize := SIZEOF(GVL.g_stTrackingConfig_B), sFileName := 'TrackingConfig_B.bin');\n    GVL.g_xHMITrackingConfigSaveB := FALSE;\nEND_IF;\n\nIF GVL.g_xHMITrackingConfigReadB OR Read_Config_First THEN\n    filedata.Load(pData := ADR(GVL.g_stTrackingConfig_B), uiSize := SIZEOF(GVL.g_stTrackingConfig_B), sFileName := 'TrackingConfig_B.bin');\n    GVL.g_xHMITrackingConfigReadB := FALSE;\nEND_IF;\n\n// Sensor Source B.\nIF GVL.g_xHMISaveSensorSourceB_All THEN\n    filedata.Save(pData := ADR(GVL.g_aSensorSourceConfigB), uiSize := SIZEOF(GVL.g_aSensorSourceConfigB), sFileName := 'SensorSource_Config_B.bin');\n    GVL.g_xHMISaveSensorSourceB_All := FALSE;\nEND_IF;\n\nIF GVL.g_xHMILoadSensorSourceB_All OR Read_Config_First THEN\n    filedata.Load(pData := ADR(GVL.g_aSensorSourceConfigB), uiSize := SIZEOF(GVL.g_aSensorSourceConfigB), sFileName := 'SensorSource_Config_B.bin');\n    GVL.g_xHMILoadSensorSourceB_All := FALSE;\n    GVL.g_xHMILoadSensorSourceB := TRUE;\nEND_IF;\n\n// Tracking Recipe B.\nIF GVL.g_xHMISaveTrackingRecipeB_All THEN\n    filedata.Save(pData := ADR(GVL.g_aMultiTrackRecipeB), uiSize := SIZEOF(GVL.g_aMultiTrackRecipeB), sFileName := 'MultiTrackRecipe_Config_B.bin');\n    GVL.g_xHMISaveTrackingRecipeB_All := FALSE;\nEND_IF;\n\nIF GVL.g_xHMILoadTrackingRecipeB_All OR Read_Config_First THEN\n    filedata.Load(pData := ADR(GVL.g_aMultiTrackRecipeB), uiSize := SIZEOF(GVL.g_aMultiTrackRecipeB), sFileName := 'MultiTrackRecipe_Config_B.bin');\n    GVL.g_xHMILoadTrackingRecipeB_All := FALSE;\n    GVL.g_xHMILoadTrackingRecipeB := TRUE;\nEND_IF;\n\n// Vision Tracking Source B.\nIF GVL.g_xHMISaveAllVisionSourceB THEN\n    filedata.Save(pData := ADR(GVL.g_aVisionTrackingSourceConfigB), uiSize := SIZEOF(GVL.g_aVisionTrackingSourceConfigB), sFileName := 'VisionTrackingSource_Config_B.bin');\n    GVL.g_xHMISaveAllVisionSourceB := FALSE;\nEND_IF;\n\nIF GVL.g_xHMILoadAllVisionSourceB OR Read_Config_First THEN\n    filedata.Load(pData := ADR(GVL.g_aVisionTrackingSourceConfigB), uiSize := SIZEOF(GVL.g_aVisionTrackingSourceConfigB), sFileName := 'VisionTrackingSource_Config_B.bin');\n    GVL.g_xHMILoadAllVisionSourceB := FALSE;\n    GVL.g_xHMILoadVisionSourceB := TRUE;\nEND_IF;\n\n// Tat bien doc du lieu khi khoi dong robot\nRead_Config_First := FALSE;","LineInfoPersistence":"(string)9263aadc-88e2-4bc7-8dd0-fe613add6b1f_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)232"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}