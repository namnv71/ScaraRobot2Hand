{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ec54ab0c-dfbe-484f-98e2-35e09733818c","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_TrackingMotionQueueAdapter_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Accepted := FALSE;\nDone := FALSE;\nAbortDone := FALSE;\n\n// Error không nên giữ từ request cũ khi Adapter đang không chờ motion.\nIF NOT xPushExecute AND NOT xWaitingMotionResult THEN\n    Error := FALSE;\n    ErrorID := 0;\nEND_IF;\n\n// IF Reset OR NOT Enable THEN\n//     xPushExecute := FALSE;\n//     xWaitingMotionResult := FALSE;\n//     xAcceptedLatched := FALSE;\n//     Busy := FALSE;\n//     Error := FALSE;\n//     ErrorID := 0;\n//     tonLogicMotion(IN := FALSE);\n//     fbPush(Execute := FALSE, Item := stItem);\n//     RETURN;\n// END_IF;\n\nIF Reset OR NOT Enable THEN\n\n    // Hạ yêu cầu push vào Motion Queue.\n    xPushExecute := FALSE;\n\n    // Không còn chờ kết quả motion trước.\n    xWaitingMotionResult := FALSE;\n\n    // Xóa cờ Accepted nội bộ.\n    xAcceptedLatched := FALSE;\n\n    // Xóa trạng thái output.\n    Accepted := FALSE;\n    Busy := FALSE;\n    Done := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n    AbortDone := FALSE;\n\n    // Xóa SourceStep của request cũ.\n    iActiveSourceStep := 0;\n\n    // Hạ yêu cầu Abort còn sót lại.\n    GVL.B_MotionAbortReq := FALSE;\n\n    // Reset timer mô phỏng.\n    tonLogicMotion(IN := FALSE);\n\n    // Reset FB Push Motion Queue.\n    fbPush(Execute := FALSE, Item := stItem);\n\n    RETURN;\nEND_IF;\n\nIF Abort THEN\n    IF LogicSimulation THEN\n        xWaitingMotionResult := FALSE;\n        Busy := FALSE;\n        AbortDone := TRUE;\n    ELSE\n        GVL.B_MotionAbortReq := TRUE;\n        IF GVL.B_MotionAbortDone THEN\n            GVL.B_MotionAbortReq := FALSE;\n            xWaitingMotionResult := FALSE;\n            Busy := FALSE;\n            AbortDone := TRUE;\n        END_IF;\n    END_IF;\n    RETURN;\nEND_IF;\n\nrtRequest(CLK := Request);\n\n//=============================================================================\n// LOGIC-ONLY SIMULATION\n//=============================================================================\nIF LogicSimulation THEN\n    IF rtRequest.Q AND NOT Busy THEN\n        Accepted := TRUE;\n        Busy := TRUE;\n        tonLogicMotion(IN := FALSE);\n    END_IF;\n\n    tonLogicMotion(IN := Busy, PT := LogicMotionDuration);\n\n    IF tonLogicMotion.Q THEN\n        tonLogicMotion(IN := FALSE);\n        Busy := FALSE;\n        Done := TRUE;\n    END_IF;\n\n    RETURN;\nEND_IF;\n\n//=============================================================================\n// ROBOT REAL: ĐÓNG GÓI VÀ PUSH VÀO MOTION QUEUE ROBOT B\n//=============================================================================\nIF rtRequest.Q AND NOT xPushExecute AND NOT xWaitingMotionResult THEN\n    diRequestSequence := diRequestSequence - 1;\n    IF diRequestSequence < -30000 THEN diRequestSequence := -1000; END_IF;\n    iActiveSourceStep := DINT_TO_INT(diRequestSequence);\n\n    stItem.Cmd := E_RobotCmd.CMD_MovL;\n    stItem.SourceStep := iActiveSourceStep;\n    stItem.PointNo := 0;\n    stItem.MidPointNo := 0;\n    stItem.EndPointNo := 0;\n    stItem.Speed := REAL_TO_LREAL(Speed);\n    stItem.BlendMode := GVL.C_TM_None;\n    stItem.BlendRadius := REAL_TO_LREAL(BlendRadius);\n    stItem.CircleMode := 0;\n    stItem.PathChoice := 0;\n    stItem.SkipPositionCheck := TRUE;\n\n    stItem.UseDirectPosition := TRUE;\n    stItem.DirectPosition := Target;\n    stItem.DirectCoordSystem := F_MapAppCoordSystem(Coord := CoordSystem);\n    stItem.Acceleration := REAL_TO_LREAL(Acceleration);\n    stItem.Deceleration := REAL_TO_LREAL(Deceleration);\n    stItem.Jerk := REAL_TO_LREAL(Jerk);\n    stItem.ApplicationCommandID := TO_UDINT(ABS(iActiveSourceStep));\n\n    xPushExecute := TRUE;\nEND_IF;\n\nfbPush(Execute := xPushExecute, Item := stItem);\n\nIF xPushExecute AND fbPush.Done THEN\n    xPushExecute := FALSE;\n    xWaitingMotionResult := TRUE;\n    xAcceptedLatched := TRUE;\n    Accepted := TRUE;\n    Busy := TRUE;\nEND_IF;\n\nIF xPushExecute AND fbPush.Error THEN\n    xPushExecute := FALSE;\n    Error := TRUE;\n    ErrorID := 7201; // Motion Queue full / Push failed.\nEND_IF;\n\n// Reset handshake của FB Push sau khi push xong.\nIF NOT xPushExecute THEN fbPush(Execute := FALSE, Item := stItem); END_IF;\n\n// Theo dõi đúng item bằng SourceStep âm riêng của Application.\nIF xWaitingMotionResult THEN\n    Busy := TRUE;\n\n//     IF GVL.B_MotionDonePulse AND GVL.B_MotionDoneStep = iActiveSourceStep THEN\n//         xWaitingMotionResult := FALSE;\n//         Busy := FALSE;\n//         Done := TRUE;\n//     END_IF;\n// \n//     IF GVL.B_MotionErrorPulse AND GVL.B_MotionErrorStep = iActiveSourceStep THEN\n//         xWaitingMotionResult := FALSE;\n//         Busy := FALSE;\n//         Error := TRUE;\n//         ErrorID := INT_TO_UDINT(GVL.B_MotionErrorCode);\n//     END_IF;\n\t\n\tIF GVL.B_MotionDonePulse AND GVL.B_MotionDoneStep = iActiveSourceStep THEN\n\t\txWaitingMotionResult := FALSE;\n\t\txAcceptedLatched := FALSE;\n\t\tBusy := FALSE;\n\t\tDone := TRUE;\n\tEND_IF;\n\t\n\t// Motion hiện tại báo lỗi đúng SourceStep.\n\tIF GVL.B_MotionErrorPulse AND GVL.B_MotionErrorStep = iActiveSourceStep THEN\n\t\txWaitingMotionResult := FALSE;\n\t\txAcceptedLatched := FALSE;\n\t\tBusy := FALSE;\n\t\tError := TRUE;\n\t\tErrorID := INT_TO_UDINT(GVL.B_MotionErrorCode);\n\tEND_IF;\nEND_IF;","LineInfoPersistence":"(string)ec54ab0c-dfbe-484f-98e2-35e09733818c_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_TrackingMotionQueueAdapter_B\nVAR_INPUT\n    Enable : BOOL; // Biến nội bộ Enable.\n    Reset : BOOL; // Biến nội bộ Reset.\n    Request : BOOL; // Biến nội bộ Request.\n    Abort : BOOL; // Biến nội bộ Abort.\n    Target : ST_POS; // Biến nội bộ Target.\n    Speed : REAL; // Biến nội bộ Speed.\n    Acceleration : REAL; // Biến nội bộ Acceleration.\n    Deceleration : REAL; // Biến nội bộ Deceleration.\n    Jerk : REAL; // Biến nội bộ Jerk.\n    BlendRadius : REAL; // Biến nội bộ BlendRadius.\n    CoordSystem : E_AppCoordSystem; // Biến nội bộ CoordSystem.\n    Command : UINT; // Biến nội bộ Command.\n    LogicSimulation : BOOL; // Logic-only simulation không push vào robot.\n    LogicMotionDuration : TIME := TIME#300ms; // Biến nội bộ LogicMotionDuration.\nEND_VAR\n\nVAR_OUTPUT\n    Accepted : BOOL; // Biến nội bộ Accepted.\n    Busy : BOOL; // Biến nội bộ Busy.\n    Done : BOOL; // Biến nội bộ Done.\n    Error : BOOL; // Biến nội bộ Error.\n    ErrorID : UDINT; // Biến nội bộ ErrorID.\n    AbortDone : BOOL; // Biến nội bộ AbortDone.\nEND_VAR\n\nVAR\n    fbPush : FB_MotionQueuePush_B; // Biến nội bộ fbPush.\n    rtRequest : R_TRIG; // Biến nội bộ rtRequest.\n    tonLogicMotion : TON; // Biến nội bộ tonLogicMotion.\n    stItem : ST_MotionQueueItem; // Biến nội bộ stItem.\n    xPushExecute : BOOL; // Biến nội bộ xPushExecute.\n    xWaitingMotionResult : BOOL; // Biến nội bộ xWaitingMotionResult.\n    xAcceptedLatched : BOOL; // Biến nội bộ xAcceptedLatched.\n    diRequestSequence : DINT := -1000; // Biến nội bộ diRequestSequence.\n    iActiveSourceStep : INT; // Biến nội bộ iActiveSourceStep.\nEND_VAR\n","LineInfoPersistence":"(string)ec54ab0c-dfbe-484f-98e2-35e09733818c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)218","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}