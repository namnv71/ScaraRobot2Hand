{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)daebaa43-c57a-4869-9882-f6f1ef6f2f16","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_ToolIOConfig","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: TOOL IO CONFIG\n//-----------------------------------------------------------------------------\n// Tất cả kênh IO đều dùng chỉ số logic.\n// Channel = 0 nghĩa là không sử dụng kênh đó.\n//=============================================================================\nTYPE ST_ToolIOConfig :\nSTRUCT\n\n    // TRUE = Up/Down dung chung mot DO.\n    // FALSE = Down va Up dung hai DO doc lap.\n    UseSingleUpDownDO : BOOL;\n\n    // DO dung chung khi UseSingleUpDownDO = TRUE.\n    // Channel = 0 nghia la khong su dung.\n    UpDownDOChannel : UINT;\n\n    // Hai DO doc lap khi UseSingleUpDownDO = FALSE.\n    DownDOChannel : UINT;\n    UpDOChannel : UINT;\n\t\n\t// TRUE = Up/Down dung chung mot DO.\n    // FALSE = Down va Up dung hai DO doc lap.\n    UseSingleGripReleaseDO  : BOOL;\n\n    // DO dung chung khi UseSingleGripReleaseDO = TRUE.\n    // Channel = 0 nghia la khong su dung.\n    GripReleaseDOChannel : UINT;\n\n\n    // Grip / Release.\n    GripDOChannel : UINT;\n    ReleaseDOChannel : UINT;\n\n    // Feedback DI.\n    DownOKDIChannel : UINT;\n    UpOKDIChannel : UINT;\n    GripOKDIChannel : UINT;\n    PartPresentDIChannel : UINT;\n\n    // Active level.\n    // Single DO mode:\n    //   DOWN = DownDOActiveLevel\n    //   UP   = NOT DownDOActiveLevel\n    DownDOActiveLevel : BOOL;\n\n    // Chi dung trong Dual DO mode.\n    UpDOActiveLevel : BOOL;\n\n    GripDOActiveLevel : BOOL;\n    ReleaseDOActiveLevel : BOOL;\n    DownOKDIActiveLevel : BOOL;\n    UpOKDIActiveLevel : BOOL;\n    GripOKDIActiveLevel : BOOL;\n    PartPresentDIActiveLevel : BOOL;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)daebaa43-c57a-4869-9882-f6f1ef6f2f16_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)59"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}