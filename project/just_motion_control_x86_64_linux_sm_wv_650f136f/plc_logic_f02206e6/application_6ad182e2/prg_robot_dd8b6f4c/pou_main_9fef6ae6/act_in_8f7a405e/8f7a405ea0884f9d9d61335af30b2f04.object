{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)8f7a405e-a088-4f9d-9d61-335af30b2f04","ParentGuid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","Name":"(string)ACT_IN","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Bao gom input cua chung cua robot va dat ten rieng cho tung project\n// Share robot\n// update in\nGVL.RB_Signal_In.HMI_START := GVL.X[6];\nGVL.RB_Signal_In.HMI_RESET := GVL.X[8];\nGVL.RB_Signal_In.HMI_EMG  := GVL.X[9];\nGVL.RB_Signal_In.HMI_STOP   := GVL.X[7];\n// Tool robot'\nGVL.RB_Signal_In.SS_RBA_Tool_1( IN:= GVL.X[10], PT := T#10MS, Q =>);\n\nGVL.RB_Signal_In.SS_RBA_Tool_2( IN:= GVL.X[11], PT := T#50MS, Q =>);\n\nGVL.RB_Signal_In.SS_RBB_Tool_1( IN:= GVL.X[12], PT := T#50MS, Q =>);\n\nGVL.RB_Signal_In.SS_RBB_Tool_2( IN:= GVL.X[13], PT := T#50MS, Q =>);\n\n\n// Project 3\nIF GVL.ProjectAndModel.Project_No_Current = 3 THEN\t\n\t// Test sóng\n\t\n\tGVL.Pro4_.Signal_In.T_Ts_Result_Scanner( IN:= GVL.X[31], PT := T#0MS);\n\tGVL.Pro4_.Signal_In.T_Ts_Pass( IN:= GVL.X[21], PT := T#10MS);\n\tGVL.Pro4_.Signal_In.T_Ts_Fail( IN:= GVL.X[22], PT := T#10MS);\n\tGVL.Pro4_.Signal_In.T_Door_ss( IN:= GVL.X[23], PT := T#100MS);\n\tGVL.Pro4_.Signal_In.T_Ts_Press_Up( IN:= GVL.X[24], PT := T#10MS);\n\tGVL.Pro4_.Signal_In.T_Ts_Check_Gap( IN:= GVL.X[25], PT := T#500MS);\n\t// CHECK TS \n\tT_RESET_TS(IN := GVL.Pro4_.Man.D_Ts = 2 OR GVL.Pro4_.Man.D_Ts = 3,  PT := T#5S, Q =>);\n\tT_OUT_RESET_TS( IN := (GVL.Y[20] AND NOT GVL.Pro4_.Signal_In.T_Ts_Fail.Q AND NOT  GVL.Pro4_.Signal_In.T_Ts_Pass.Q), PT := T#20S, Q =>);\n\tIF GVL.Y[20] AND GVL.Pro4_.Man.D_Ts = 0 AND NOT GVL.Pro4_.Signal_In.T_Ts_Fail.Q AND NOT GVL.Pro4_.Signal_In.T_Ts_Pass.Q  THEN\n\t\tGVL.Pro4_.Man.D_Ts := 1;\n\tEND_IF;\n\tIF GVL.Pro4_.Man.D_Ts = 1 AND GVL.Pro4_.Signal_In.T_Ts_Pass.Q THEN\n\t\tGVL.Pro4_.Man.D_Ts := 2;\n\tELSIF GVL.Pro4_.Man.D_Ts = 1 AND GVL.Pro4_.Signal_In.T_Ts_Fail.Q THEN\n\t\tGVL.Pro4_.Man.D_Ts := 3;\n\tEND_IF\n\tIF T_RESET_TS.Q OR T_OUT_RESET_TS.Q THEN\n\t\tGVL.Pro4_.Man.TS_On_Off := 0;\n\t\tGVL.Pro4_.Man.D_Ts := 0 ;\n\t\tT_OUT_RESET_TS.IN := FALSE;\n\t\tT_RESET_TS.IN := FALSE;\n\tEND_IF\n\t// check Víison\n\tGVL.Pro4_.Signal_In.T_Vs_detect( IN:= GVL.X[26], PT := T#100MS);\n\tGVL.Pro4_.Signal_In.T_Vs_Result_Scanner( IN:= GVL.X[30], PT := T#1MS);\n\tGVL.Pro4_.Signal_In.T_Vs_Pass( IN:= GVL.X[32] AND GVL.Pro4_.Signal_In.T_Vs_detect.Q, PT := T#1000MS);\n\tGVL.Pro4_.Signal_In.T_Vs_Fail( IN:= GVL.X[33] AND GVL.Pro4_.Signal_In.T_Vs_detect.Q, PT := T#1000MS);\n\t// CHECK VS \n\tT_RESET_VS(IN := GVL.Pro4_.Man.D_Vs = 2 OR GVL.Pro4_.Man.D_Vs = 3,  PT := T#5S, Q =>);\n\tT_OUT_RESET_VS( IN := GVL.Y[21] AND NOT GVL.Pro4_.Signal_In.T_Vs_Fail.Q AND NOT  GVL.Pro4_.Signal_In.T_Vs_Pass.Q, PT := T#20S, Q =>);\n\tIF GVL.Y[21] AND GVL.Pro4_.Man.D_Vs = 0 AND NOT GVL.Pro4_.Signal_In.T_Vs_Fail.Q AND NOT GVL.Pro4_.Signal_In.T_Vs_Pass.Q  THEN\n\t\tGVL.Pro4_.Man.D_Vs := 1;\n\tEND_IF;\n\tIF GVL.Pro4_.Man.D_Vs = 1 AND GVL.Pro4_.Signal_In.T_Ts_Pass.Q THEN\n\t\tGVL.Pro4_.Man.D_Vs := 2;\n\tELSIF GVL.Pro4_.Man.D_Vs = 1 AND GVL.Pro4_.Signal_In.T_Ts_Fail.Q THEN\n\t\tGVL.Pro4_.Man.D_Vs := 3;\n\tEND_IF\n\tIF T_RESET_VS.Q AND T_OUT_RESET_VS.Q THEN\n\t\tGVL.Pro4_.Man.Vs_On_Off := 0;\n\t\tGVL.Pro4_.Man.D_Vs := 0 ;\n\t\tT_OUT_RESET_VS.IN := FALSE;\n\t\tT_RESET_VS.IN := FALSE;\n\tEND_IF\n\t// Conveyor\n\tGVL.Pro4_.Signal_In.T_Cv_In_1( IN:= NOT GVL.X[27], PT := T#1500MS);\n\tGVL.Pro4_.Signal_In.T_Cv_In_2( IN:= not GVL.X[28], PT := T#500MS);\n\tGVL.Pro4_.Signal_In.T_Cv_OK_out( IN:= GVL.X[29], PT := T#500MS);\n\t\n\tGVL.Pro4_.Signal_In.T_Cv_NG_out_1( IN:= NOT GVL.X[40], PT := T#10MS);\n\tGVL.Pro4_.Signal_In.T_Cv_NG_out_2( IN:= NOT GVL.X[41], PT := T#10MS);\n\tGVL.Pro4_.Signal_In.T_Cv_NG_out_full( IN:= NOT GVL.X[42], PT := T#10MS);\n\nEND_IF;\n\n\n//\n\n\nRETURN;","LineInfoPersistence":"(string)8f7a405e-a088-4f9d-9d61-335af30b2f04_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)82"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}