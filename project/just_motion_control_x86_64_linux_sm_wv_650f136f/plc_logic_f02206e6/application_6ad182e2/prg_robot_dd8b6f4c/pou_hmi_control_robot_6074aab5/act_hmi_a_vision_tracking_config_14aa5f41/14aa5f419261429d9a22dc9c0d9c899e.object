{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)14aa5f41-9261-429d-9a22-dc9c0d9c899e","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_HMI_A_Vision_Tracking_Config","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// ACT_HMI_A_Vision_Tracking_Config\n//-----------------------------------------------------------------------------\n// HMI editor cho Vision Tracking Source Robot A.\n// Pattern giống Sensor Source:\n// Index -> Edit Struct -> Load / Save.\n//=============================================================================\n\n\n//=============================================================================\n// 01. KIỂM TRA INDEX\n//=============================================================================\nIF GVL.g_uiHMIVisionSourceIndexA = 0\nOR GVL.g_uiHMIVisionSourceIndexA > GVL.C_MAX_VISION_CHANNELS THEN\n    GVL.g_uiHMIVisionSourceIndexA := 1;\nEND_IF;\n\n\n//=============================================================================\n// 02. LOAD SOURCE -> HMI BUFFER\n//=============================================================================\nIF GVL.g_xHMILoadVisionSourceA THEN\n\n    GVL.g_stHMIVisionSourceA :=\n        GVL.g_aVisionTrackingSourceConfigA[\n            GVL.g_uiHMIVisionSourceIndexA\n        ];\n\n    GVL.g_xHMILoadVisionSourceA := FALSE;\n\nEND_IF;\n\n\n//=============================================================================\n// 03. SAVE HMI BUFFER -> SOURCE\n//=============================================================================\nIF GVL.g_xHMISaveVisionSourceA THEN\n\n    GVL.g_aVisionTrackingSourceConfigA[\n        GVL.g_uiHMIVisionSourceIndexA\n    ] := GVL.g_stHMIVisionSourceA;\n\n    GVL.g_xHMISaveVisionSourceA := FALSE;\n\n    // Yêu cầu lưu toàn bộ Vision Source xuống file.\n    GVL.g_xHMISaveAllVisionSourceA := TRUE;\n\nEND_IF;","LineInfoPersistence":"(string)14aa5f41-9261-429d-9a22-dc9c0d9c899e_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)48"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}