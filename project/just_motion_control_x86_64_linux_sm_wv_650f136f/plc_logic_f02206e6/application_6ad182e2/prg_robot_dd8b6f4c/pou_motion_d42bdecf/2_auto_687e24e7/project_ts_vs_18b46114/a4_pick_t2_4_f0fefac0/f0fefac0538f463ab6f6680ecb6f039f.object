{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f0fefac0-538f-463a-b6f6-680ecb6f039f","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)A4_Pick_T2_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Project_4_Delay_A4(PT := TO_TIME(GVL.Pro4_.ST_A.TDelay_pick_T2)*100);\nTon_tacktime(PT := T#1000000MS);\nIF Pick_A4_T2_Run THEN\n\tCASE PRO_A4_[4] OF\n\t\t0: // RESET\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\t\t\n\t\t\t\tProject_4_Delay_A4.IN := FALSE;\t\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 5;\n\t\t5: // BF R PICK T1\n\t\t\tM_R_Mov(DATA:= 0, ID := 8, R_ := TRUE, X_ := FALSE, Y_ := FALSE, Z_ := FALSE);\n\t\t\t//M_CHOOSE_POS(DATA := 1, ID := 1, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n// \t\t\tIF NOT A4_Run_P THEN\n// \t\t\t\tA_Comp\t := FALSE;\n// \t\t\t\tA4_Run_P := TRUE;\n// \t\t\tEND_IF\t\n// \t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n// \t\t\t\tA4_Run_L\t:= FALSE;\n// \t\t\t\tA4_Run_P \t:= FALSE;\t \n// \t\t\tEND_IF;\t\t\t\n// \t\n// \t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n// \t\t\t\tA4_Run_L\t := FALSE;\n// \t\t\t\tA4_Run_P\t := FALSE;\n// \t\t\t\tA_Comp\t\t := FALSE;\n// \t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 5;\t\t \n// \t\t\t\t\n// \t\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 OR GVL.Pro4_.Process.DATA_TOOL_A1_IN = 3 THEN  // namnv\n// \t\t\t\t\tPRO_A4_[4] := 30;\n// \t\t\t\tEND_IF\n// \t\t\tEND_IF;\t\t\t\n\t\t\tPRO_A4_[4] := PRO_A4_[4] + 5;\t\t \n\t\t\t\t\n\t\t10: // BF Z PICK T2\n// \t\t\tM_CHOOSE_POS(DATA := 0, ID := 8, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n// \t\t\tIF NOT A4_Run_P THEN\n// \t\t\t\tA_Comp\t := FALSE;\n// \t\t\t\tA4_Run_P := TRUE;\n// \t\t\tEND_IF\t\n// \t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n// \t\t\t\tA4_Run_L\t:= FALSE;\n// \t\t\t\tA4_Run_P \t:= FALSE;\t \n// \t\t\tEND_IF;\t\t\t\n// \t\n// \t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n// \t\t\t\tA4_Run_L\t := FALSE;\n// \t\t\t\tA4_Run_P\t := FALSE;\n// \t\t\t\tA_Comp\t\t := FALSE;\n// \t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\t \n// \t\t\tEND_IF;\n\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t//Namnv\n\t\t20: // BF XY PICK T2\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 8, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\t \n\t\t\tEND_IF;\n\t\t30: // CHECK ALLOW PICK MC2\n\t\t\t//IF GVL.Pro4_.Process.DATA_MC_VS = 3 OR GVL.Pro4_.Process.DATA_MC_VS = 4 THEN\n\t\t\t//namnv\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_VS = 3 OR GVL.Pro4_.Process.DATA_MC_VS = 4 OR GVL.Pro4_.Process.DATA_MC_VS = 5 THEN\t\n\t\t\t//IF TRUE THEN\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\n\t\t\tEND_IF;\t\n\t\t40: // XY PICK T2\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 9, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\t \n\t\t\tEND_IF;\t\n\t\t50: // Z PICK T2\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 9, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2 PICK 1\n\t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Dry) THEN\n\t\t\t\tGVL.RB_A_.Tool_2 := TRUE;\n\t\t\tEND_IF;\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\n\t\t\t\tGVL.Pro4_.Auto.T_tacktime_pre := GVL.Pro4_.Auto.T_tacktime_cr;\n\t\t\t\tGVL.Pro4_.Auto.T_tacktime_cr := TO_INT(Ton_tacktime.ET)/10;\n\t\t\t\tTon_tacktime.IN := FALSE; \n\t\t\t\t//namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_ := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out_ := TRUE;\n\t\t\tEND_IF;\n\t\t\n\t\t60: // ON VACUUM\n\t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Dry) THEN\n\t\t\t\tGVL.RB_A_.Tool_2 := TRUE;\n\t\t\tEND_IF;\n\t\t\tProject_4_Delay_A4.IN:= TRUE;\n\t\t\tIF Project_4_Delay_A4.Q AND A_Allow_NextStep AND (GVL.RB_Signal_In.SS_RBA_Tool_2.Q OR GVL.Pro4_.ST_MC.Mode_Skip_ss_T2_A) THEN\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10; \t\n\t\t\t\tTon_tacktime.IN := TRUE;\n\t\t\t\t//namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_ := TRUE;\n\t\t\t\tMonitor_Production.Pulse_Out_ := FALSE;\n\t\t\tEND_IF;\n\t\t70: // BF Z PICK T2\n\t\t\tProject_4_Delay_A4.IN:= FALSE;\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 8, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 1 BF PICK 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\n\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\t \n\t\t\t\t\n\t\t\t\t// namnv\n\t\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 OR GVL.Pro4_.Process.DATA_TOOL_A1_IN = 3) AND (GVL.Pro4_.Process.DATA_MC_VS = 3 OR GVL.Pro4_.Process.DATA_MC_VS = 4) THEN\n\t\t\t\t\tPRO_A4_[4] := 90;\n\t\t\t\tEND_IF\n\t\t\tEND_IF;\n\t\t80: // BF XY PICK T2\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 8, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 1\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp \t\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P    :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[4] := PRO_A4_[4] + 10;\t\t \n\t\t\tEND_IF\n\t\t\n\t\t90: // Done\n\t\t\t//GVL.Pro4_.Process.DATA_TOOL_A2_OUT := 2;\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_VS = 3 THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A2_OUT := 2;\n\t\t\tELSIF GVL.Pro4_.Process.DATA_MC_VS = 4 THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A2_OUT := 3;\n\t\t\tEND_IF;\t\t\t\n\t\t\t//namnv - Tool2 gap hang NG test song\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_VS = 5 THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A2_OUT := 4;\n\t\t\tEND_IF\n\t\t\tProject_4_Delay_A4.IN := FALSE;\n\t\t\tPick_A4_T2_Finish := TRUE;\n\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_A4_[4] := 0;\nEND_IF","LineInfoPersistence":"(string)f0fefac0-538f-463a-b6f6-680ecb6f039f_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)187"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}