{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)e5b2ac54-6efa-420a-92af-5ce6198b9a87","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_TrackingQueue_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_TrackingQueue_A\n//-----------------------------------------------------------------------------\n// Cập nhật Runtime của tất cả Object trong Tracking Queue Robot B.\n//\n// Nguồn vị trí Conveyor:\n//     GVL.g_aConveyorRuntime[2].Status.PositionMM\n//\n// Chương trình này KHÔNG tạo Object.\n// Sensor/Vision Source sẽ chịu trách nhiệm tạo Object ở bước sau.\n//=============================================================================\n\nrCurrentConveyorPos := GVL.g_aConveyorRuntime[2].Status.PositionMM;\nrVelocityAbs := ABS(GVL.g_aConveyorRuntime[2].Status.VelocityMMs);\n\n//=============================================================================\n// CLEAR TOÀN BỘ TRACKING QUEUE\n//-----------------------------------------------------------------------------\nIF GVL.g_xClearTrackingQueueB THEN\n\n    FOR uiObject := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n        GVL.g_stTrackingQueue_B.Objects[uiObject].Valid := FALSE;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ObjectID := 0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ProductClassID := 0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].Reserved := FALSE;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ReservedToolID := 0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].State := E_TrackingObjectState.OBJ_EMPTY;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].MissCode := 0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ErrorID := 0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec := 0.0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorOffset := 0.0;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate := 0.0;\n    END_FOR;\n\n    GVL.g_stTrackingQueue_B.ValidCount := 0;\n    GVL.g_stTrackingQueue_B.ActiveIndex := GVL.C_INVALID_INDEX;\n\n    // Nếu muốn ObjectID quay lại từ 1 sau mỗi lần clear.\n    GVL.g_stTrackingQueue_B.NextObjectID := 0;\n\n    // Tự hạ lệnh.\n    GVL.g_xClearTrackingQueueB := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// DUYỆT TOÀN BỘ QUEUE\n//=============================================================================\nFOR uiObject := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n\n    //----------------------------------------------------------------------\n    // Chỉ xử lý Slot đang có Object hợp lệ.\n    //----------------------------------------------------------------------\n    IF GVL.g_stTrackingQueue_B.Objects[uiObject].Valid THEN\n\n        //------------------------------------------------------------------\n        // 1. CẬP NHẬT VỊ TRÍ CONVEYOR HIỆN TẠI\n        //------------------------------------------------------------------\n        GVL.g_stTrackingQueue_B.Objects[uiObject].CurrentConveyorPositionMM :=\n            REAL_TO_LREAL(rCurrentConveyorPos);\n\n\n        //------------------------------------------------------------------\n        // 2. ĐỘ DỊCH CONVEYOR TỪ THỜI ĐIỂM CAPTURE\n        //------------------------------------------------------------------\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorOffset :=\n            LREAL_TO_REAL(\n                GVL.g_stTrackingQueue_B.Objects[uiObject].CurrentConveyorPositionMM\n                - GVL.g_stTrackingQueue_B.Objects[uiObject].CaptureConveyorPositionMM\n            );\n\n\n        //------------------------------------------------------------------\n        // 3. TỌA ĐỘ DỌC CONVEYOR HIỆN TẠI CỦA OBJECT\n        //------------------------------------------------------------------\n        // PoseInConveyor.X là tọa độ Object tại thời điểm Capture.\n        GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate :=\n            GVL.g_stTrackingQueue_B.Objects[uiObject].PoseInConveyor.X\n            + GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorOffset;\n\n\n        //------------------------------------------------------------------\n        // 4. CURRENT POS\n        //------------------------------------------------------------------\n        GVL.g_stTrackingQueue_B.Objects[uiObject].CurrentPos :=\n            GVL.g_stTrackingQueue_B.Objects[uiObject].PoseInConveyor;\n\n        GVL.g_stTrackingQueue_B.Objects[uiObject].CurrentPos.X :=\n            GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate;\n\n\n        //------------------------------------------------------------------\n        // 5. DEFAULT RUNTIME FLAGS\n        //------------------------------------------------------------------\n//         GVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n//         GVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n        GVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec := 0.0;\n\n\n//         //------------------------------------------------------------------\n// \t\t// DEFAULT RUNTIME FLAGS\n// \t\t//------------------------------------------------------------------\n// \t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n// \t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\n\t\t\n\t\t//----------------------------------------------------------------------\n\t\t// OBJECT ĐÃ PICK XONG\n\t\t// Không được tính lại READY/MISSED theo vị trí Conveyor.\n\t\t//----------------------------------------------------------------------\n\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].State\n\t\t\t= E_TrackingObjectState.OBJ_PICKED THEN\n\t\t\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\n\t\t\n\t\t//----------------------------------------------------------------------\n\t\t// OBJECT CHƯA ĐƯỢC ROBOT / TOOL SỞ HỮU\n\t\t//----------------------------------------------------------------------\n\t\tELSIF NOT GVL.g_stTrackingQueue_B.Objects[uiObject].Reserved THEN\n\t\t\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\n\t\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n\t\t\t\t< GVL.g_stTrackingConfig_B.Workspace.PickZoneStartMM THEN\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\t\tE_TrackingObjectState.OBJ_WAIT_PICK_ZONE;\n\t\t\n\t\t\tELSIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n\t\t\t\t<= GVL.g_stTrackingConfig_B.Workspace.PickZoneEndMM THEN\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := TRUE;\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\t\tE_TrackingObjectState.OBJ_READY;\n\t\t\n\t\t\tELSIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n\t\t\t\t< GVL.g_stTrackingConfig_B.Workspace.ExpirePositionMM THEN\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\t\tE_TrackingObjectState.OBJ_MISSED;\n\t\t\n\t\t\tELSE\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\t\tE_TrackingObjectState.OBJ_EXPIRED;\n\t\t\n\t\t\tEND_IF;\n\t\t\n\t\t\n\t\t//----------------------------------------------------------------------\n\t\t// OBJECT ĐANG ĐƯỢC TRACKING SỞ HỮU\n\t\t//----------------------------------------------------------------------\n\t\tELSE\n\t\t\n\t\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n\t\t\t\t>= GVL.g_stTrackingConfig_B.Workspace.AbortPositionMM THEN\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := TRUE;\n\t\t\n\t\t\tELSE\n\t\t\n\t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\n\t\t\tEND_IF;\n\t\t\n\t\tEND_IF;\n\t\t\n\t\t\n\t\t//=============================================================================\n\t\t// CLEANUP OBJECT PICKED\n\t\t//=============================================================================\n\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].Valid\n\t\tAND NOT GVL.g_stTrackingQueue_B.Objects[uiObject].Reserved\n\t\tAND GVL.g_stTrackingQueue_B.Objects[uiObject].State\n\t\t\t= E_TrackingObjectState.OBJ_PICKED THEN\n\t\t\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].Valid := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].ReservedToolID := 0;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec := 0.0;\n\t\t\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\tE_TrackingObjectState.OBJ_EMPTY;\n\t\t\n\t\t\tIF GVL.g_stTrackingQueue_B.ValidCount > 0 THEN\n\t\t\t\tGVL.g_stTrackingQueue_B.ValidCount :=\n\t\t\t\t\tGVL.g_stTrackingQueue_B.ValidCount - 1;\n\t\t\tEND_IF;\n\t\t\n\t\tEND_IF;\n\n\n\n// \t\t//------------------------------------------------------------------\n// \t\t// OBJECT CHƯA ĐƯỢC ROBOT / TOOL SỞ HỮU\n// \t\t//------------------------------------------------------------------\n// \t\tIF NOT GVL.g_stTrackingQueue_B.Objects[uiObject].Reserved THEN\n// \t\t\n// \t\t\t// Queue Manager được quyền tính lại hai trạng thái này.\n// \t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n// \t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n// \t\t\n// \t\t\t// Chưa tới vùng Pick.\n// \t\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n// \t\t\t\t< GVL.g_stTrackingConfig_B.Workspace.PickZoneStartMM THEN\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n// \t\t\t\t\tE_TrackingObjectState.OBJ_WAIT_PICK_ZONE;\n// \t\t\n// \t\t\t// Đang nằm trong vùng Pick.\n// \t\t\tELSIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n// \t\t\t\t<= GVL.g_stTrackingConfig_B.Workspace.PickZoneEndMM THEN\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := TRUE;\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n// \t\t\t\t\tE_TrackingObjectState.OBJ_READY;\n// \t\t\n// \t\t\t// Đã ra khỏi vùng Pick nhưng chưa Expire.\n// \t\t\tELSIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n// \t\t\t\t< GVL.g_stTrackingConfig_B.Workspace.ExpirePositionMM THEN\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n// \t\t\t\t\tE_TrackingObjectState.OBJ_MISSED;\n// \t\t\n// \t\t\t// Hết hiệu lực hoàn toàn.\n// \t\t\tELSE\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n// \t\t\t\t\tE_TrackingObjectState.OBJ_EXPIRED;\n// \t\t\n// \t\t\tEND_IF;\n// \t\t\t\t\n// \t\t\n// \t\t//------------------------------------------------------------------\n// \t\t// OBJECT ĐÃ ĐƯỢC ROBOT / TOOL SỞ HỮU\n// \t\t//------------------------------------------------------------------\n// \t\tELSE\n// \t\t\n// \t\t\t// QUAN TRỌNG:\n// \t\t\t// Không thay đổi CanPick tại đây.\n// \t\t\t// Object đã được chọn khi CanPick = TRUE.\n// \t\t\n// \t\t\t// Chỉ tiếp tục theo dõi điều kiện Abort.\n// \t\t\tIF GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate\n// \t\t\t\t>= GVL.g_stTrackingConfig_B.Workspace.AbortPositionMM THEN\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := TRUE;\n// \t\t\n// \t\t\tELSE\n// \t\t\n// \t\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n// \t\t\n// \t\t\tEND_IF;\n// \t\t\n// \t\tEND_IF;\n\n\n        //------------------------------------------------------------------\n        // 7. TÍNH THỜI GIAN CÒN LẠI TRƯỚC ABORT\n        //------------------------------------------------------------------\n        IF rVelocityAbs > 0.01 THEN\n\n            rDistanceToAbort :=\n                GVL.g_stTrackingConfig_B.Workspace.AbortPositionMM\n                - GVL.g_stTrackingQueue_B.Objects[uiObject].ConveyorCoordinate;\n\n            IF rDistanceToAbort > 0.0 THEN\n                GVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec :=\n                    rDistanceToAbort / rVelocityAbs;\n            ELSE\n                GVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec := 0.0;\n            END_IF;\n\n        END_IF;\n\t\t\n\t\t//=============================================================================\n\t\t// CLEANUP OBJECT ĐÃ EXPIRED\n\t\t//-----------------------------------------------------------------------------\n\t\t// Object đã ra khỏi toàn bộ vùng Tracking và không còn được Tool sở hữu.\n\t\t// Giải phóng Slot để Sensor có thể sử dụng lại.\n\t\t//=============================================================================\n\t\tIF NOT GVL.g_stTrackingQueue_B.Objects[uiObject].Reserved\n\t\tAND GVL.g_stTrackingQueue_B.Objects[uiObject].State = E_TrackingObjectState.OBJ_EXPIRED THEN\n\t\t\n\t\t\t// Giải phóng Object.\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].Valid := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].Reserved := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].ReservedToolID := 0;\n\t\t\n\t\t\t// Xóa trạng thái runtime.\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].CanPick := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].AbortRequired := FALSE;\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].TimeRemainingSec := 0.0;\n\t\t\n\t\t\t// Đưa Slot về Empty.\n\t\t\tGVL.g_stTrackingQueue_B.Objects[uiObject].State :=\n\t\t\t\tE_TrackingObjectState.OBJ_EMPTY;\n\t\t\n\t\t\t// Giảm số Object hợp lệ trong Queue.\n\t\t\tIF GVL.g_stTrackingQueue_B.ValidCount > 0 THEN\n\t\t\t\tGVL.g_stTrackingQueue_B.ValidCount :=\n\t\t\t\t\tGVL.g_stTrackingQueue_B.ValidCount - 1;\n\t\t\tEND_IF;\n\t\t\n\t\tEND_IF;\n\n    END_IF;\n\nEND_FOR;","LineInfoPersistence":"(string)e5b2ac54-6efa-420a-92af-5ce6198b9a87_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_TrackingQueue_B\nVAR\n    uiObject : UINT; // Biến nội bộ uiObject.\n    rCurrentConveyorPos : REAL; // Biến nội bộ rCurrentConveyorPos.\n    rVelocityAbs : REAL; // Biến nội bộ rVelocityAbs.\n    rDistanceToAbort : REAL; // Biến nội bộ rDistanceToAbort.\nEND_VAR","LineInfoPersistence":"(string)e5b2ac54-6efa-420a-92af-5ce6198b9a87_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)326","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}