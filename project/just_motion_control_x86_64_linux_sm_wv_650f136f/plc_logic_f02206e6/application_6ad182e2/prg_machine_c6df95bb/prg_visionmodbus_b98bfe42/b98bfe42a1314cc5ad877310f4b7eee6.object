{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)b98bfe42-a131-4cc5-ad87-7310f4b7eee6","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_VisionModbus","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c6df95bb-64ac-4d71-855a-28b905fd49bd"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_VisionModbus\n//----------------------------------------------------------------------------- \n// Thêm PRG này vào Task_Communication, sau POU_MODBUS.\n//=============================================================================\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\t//=============================================================================\n\t// MANUAL TRIGGER HMI\n\t//-----------------------------------------------------------------------------\n\t// ON  : Manual chiếm quyền và giữ Execute TRUE.\n\t// OFF : Nếu trước đó Manual đang chiếm quyền thì hạ Execute FALSE và trả quyền.\n\t// Auto không bị ảnh hưởng khi Manual chưa từng chiếm quyền.\n\t//=============================================================================\n\tIF GVL.Man_Calib_RB[uiCamera].Trigger_VS THEN\n\t\n\t\t// HMI đang ON -> Manual sở hữu Trigger.\n\t\txManualTriggerActive[uiCamera] := TRUE;\n\t\n\t\t// Giữ Trigger ON liên tục.\n\t\tGVL.g_aVisionCommand[uiCamera].Execute := TRUE;\n\t\n\tELSIF xManualTriggerActive[uiCamera] THEN\n\t\n\t\t// HMI vừa chuyển OFF -> hạ Trigger.\n\t\tGVL.g_aVisionCommand[uiCamera].Execute := FALSE;\n\t\n\t\t// Trả quyền điều khiển cho Auto.\n\t\txManualTriggerActive[uiCamera] := FALSE;\n\t\n\tEND_IF;\n\n    fbVisionModbus[uiCamera](\n        Enable := GVL.g_aVisionConfig[uiCamera].Enable,\n        Reset := GVL.g_aVisionCommand[uiCamera].Reset,\n        Config := GVL.g_aVisionConfig[uiCamera],\n        Command := GVL.g_aVisionCommand[uiCamera],\n        ModbusControl := GVL.g_aVisionModbusControl[uiCamera],\n        ChannelStatus := GVL.g_aVisionStatus[uiCamera],\n        ModbusStatus := GVL.g_aVisionModbusStatus[uiCamera],\n        VisionResult := GVL.g_aVisionResult[uiCamera],\n        Registers := GVL.MODBUS\n    );\nEND_FOR;","LineInfoPersistence":"(string)b98bfe42-a131-4cc5-ad87-7310f4b7eee6_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_VisionModbus\nVAR\n\tfbVisionModbus : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF FB_VisionModbusDriver;\n\tuiCamera : UINT;\n\txManualTriggerActive : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF BOOL; // Manual HMI đang sở hữu Trigger của Camera.\nEND_VAR\n","LineInfoPersistence":"(string)b98bfe42-a131-4cc5-ad87-7310f4b7eee6_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)50","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}