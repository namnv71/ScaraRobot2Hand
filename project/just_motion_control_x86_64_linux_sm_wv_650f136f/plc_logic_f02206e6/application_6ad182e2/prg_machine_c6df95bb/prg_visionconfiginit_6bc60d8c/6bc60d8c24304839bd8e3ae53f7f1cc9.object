{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6bc60d8c-2430-4839-bd8e-3ae53f7f1cc9","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_VisionConfigInit","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c6df95bb-64ac-4d71-855a-28b905fd49bd"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_VisionConfigInit\n//-----------------------------------------------------------------------------\n// Khởi tạo cấu hình Vision một lần sau khi PLC RUN.\n// Không ghi lặp mỗi scan để sau này HMI có thể sửa cấu hình.\n//=============================================================================\n\nIF NOT xInitialized THEN\n\n    //=========================================================================\n    // CAMERA 1\n    //=========================================================================\n    //GVL.g_aVisionConfig[1].Enable := TRUE;\n    GVL.g_aVisionConfig[1].CameraID := 1;\n    GVL.g_aVisionConfig[1].BaseAddress := 0;\n    GVL.g_aVisionConfig[1].CommandOffset := 0;\n    GVL.g_aVisionConfig[1].StatusOffset := 100;\n    GVL.g_aVisionConfig[1].HeaderOffset := 101;\n    GVL.g_aVisionConfig[1].DataOffset := 116;\n\n    // Scale tạm dùng cho test.\n    // Raw 10000 -> 10.000 mm.\n    //GVL.g_aVisionConfig[1].PositionScale := 0.001;\n    //GVL.g_aVisionConfig[1].AngleScale := 0.001;\n    GVL.g_aVisionConfig[1].ScoreScale := 1.0;\n\n//     GVL.g_aVisionConfig[1].TriggerTimeout := T#2S;\n//     GVL.g_aVisionConfig[1].ResultTimeout := T#3S;\n    GVL.g_aVisionConfig[1].BlockTimeout := T#1S;\n//     GVL.g_aVisionConfig[1].MaxPointCount := 12;\n    //GVL.g_aVisionConfig[1].MaxRetry := 2;\n\n\t\n\t//=============================================================================\n\t// VISION TRACKING SOURCE 1\n\t//-----------------------------------------------------------------------------\n\t// Nguồn Vision dùng để tạo Object cho Conveyor Tracking Robot A.\n\t// CameraID và JobID phải khớp Header của Result.\n\t//=============================================================================\n\t\n// \tGVL.g_aVisionTrackingSourceConfigA[1].Enable := TRUE;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionSourceID := 1;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionSourceName := 'Vision Tracking Cam 1';\n// \t\n// \tGVL.g_aVisionTrackingSourceConfigA[1].CameraID := 1;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].JobID := 1;\n// \t\n// \t// Nếu Vision không trả ProductClassID thì dùng Class mặc định này.\n// \tGVL.g_aVisionTrackingSourceConfigA[1].ProductClassID := 1;\n// \t\n// \t// Chỉ nhận Object đạt Score yêu cầu.\n// \tGVL.g_aVisionTrackingSourceConfigA[1].MinimumScore := 70.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].MaxObjectCount := 10;\n\t\n\t//=============================================================================\n\t// SCALE\n\t//-----------------------------------------------------------------------------\n\t// Result Modbus Driver hiện đã decode X/Y/A ra engineering unit,\n\t// vì vậy ResultInPixel phải FALSE trong bài test hiện tại.\n\t//=============================================================================\n// \tGVL.g_aVisionTrackingSourceConfigA[1].ResultInPixel := FALSE;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].MMPerPixelX := 1.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].MMPerPixelY := 1.0;\n// \t\n// \t//=============================================================================\n// \t// VISION FINE OFFSET\n// \t//=============================================================================\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionOffset.X := 0.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionOffset.Y := 0.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionOffset.Z := 0.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].VisionOffset.A := 0.0;\n\t\n// \t//=============================================================================\n// \t// DUPLICATE FILTER\n// \t//=============================================================================\n// \tGVL.g_aVisionTrackingSourceConfigA[1].DuplicateToleranceXMM := 10.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].DuplicateToleranceYMM := 10.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].DuplicateAngleDeg := 5.0;\n\t\n\t//=============================================================================\n\t// BACKGROUND TRIGGER\n\t//-----------------------------------------------------------------------------\n\t// Trong lúc test dữ liệu giả lập, chưa bật AutoTrigger để tránh sinh TriggerID mới.\n\t//=============================================================================\n// \tGVL.g_aVisionTrackingSourceConfigA[1].AutoTrigger := FALSE;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].TriggerPitchMM := 50.0;\n// \tGVL.g_aVisionTrackingSourceConfigA[1].TriggerOnlyWhenMoving := FALSE;\n\tGVL.g_aVisionTrackingSourceConfigA[1].MinimumTriggerVelocityMMs := 1.0;\n\n\n\n    //=========================================================================\n    // CAMERA 2\n    //=========================================================================\n    //GVL.g_aVisionConfig[2].Enable := FALSE;\n    GVL.g_aVisionConfig[2].CameraID := 2;\n    GVL.g_aVisionConfig[2].BaseAddress := 300;\n    GVL.g_aVisionConfig[2].CommandOffset := 0;\n    GVL.g_aVisionConfig[2].StatusOffset := 100;\n    GVL.g_aVisionConfig[2].HeaderOffset := 101;\n    GVL.g_aVisionConfig[2].DataOffset := 116;\n    //GVL.g_aVisionConfig[2].PositionScale := 0.001;\n    //GVL.g_aVisionConfig[2].AngleScale := 0.001;\n    GVL.g_aVisionConfig[2].ScoreScale := 1.0;\n\n\n    //=========================================================================\n    // CAMERA 3\n    //=========================================================================\n    //GVL.g_aVisionConfig[3].Enable := FALSE;\n    GVL.g_aVisionConfig[3].CameraID := 3;\n    GVL.g_aVisionConfig[3].BaseAddress := 600;\n    GVL.g_aVisionConfig[3].CommandOffset := 0;\n    GVL.g_aVisionConfig[3].StatusOffset := 100;\n    GVL.g_aVisionConfig[3].HeaderOffset := 101;\n    GVL.g_aVisionConfig[3].DataOffset := 116;\n    //GVL.g_aVisionConfig[3].PositionScale := 0.001;\n    //GVL.g_aVisionConfig[3].AngleScale := 0.001;\n    GVL.g_aVisionConfig[3].ScoreScale := 1.0;\n\n\n    //=========================================================================\n    // CAMERA 4\n    //=========================================================================\n    //GVL.g_aVisionConfig[4].Enable := FALSE;\n    GVL.g_aVisionConfig[4].CameraID := 4;\n    GVL.g_aVisionConfig[4].BaseAddress := 900;\n    GVL.g_aVisionConfig[4].CommandOffset := 0;\n    GVL.g_aVisionConfig[4].StatusOffset := 100;\n    GVL.g_aVisionConfig[4].HeaderOffset := 101;\n    GVL.g_aVisionConfig[4].DataOffset := 116;\n    //GVL.g_aVisionConfig[4].PositionScale := 0.001;\n    //GVL.g_aVisionConfig[4].AngleScale := 0.001;\n    GVL.g_aVisionConfig[4].ScoreScale := 1.0;\n\t\n\t//=========================================================================\n\t// CAMERA 1\n\t//=========================================================================\n\t//GVL.g_aVisionConfig[1].Robot := E_VisionRobot.VIS_ROBOT_A;\n\t\n\t//=========================================================================\n\t// CAMERA 2\n\t//=========================================================================\n\t//GVL.g_aVisionConfig[2].Robot := E_VisionRobot.VIS_ROBOT_A;\n\t\n\t//=========================================================================\n\t// CAMERA 3\n\t//=========================================================================\n\t//GVL.g_aVisionConfig[3].Robot := E_VisionRobot.VIS_ROBOT_A;\n\t\n\t//=========================================================================\n\t// CAMERA 4\n\t//=========================================================================\n\t//GVL.g_aVisionConfig[4].Robot := E_VisionRobot.VIS_ROBOT_NONE;\n\n\n    // Đánh dấu đã khởi tạo để không ghi lại mỗi scan.\n    xInitialized := TRUE;\n\nEND_IF;","LineInfoPersistence":"(string)6bc60d8c-2430-4839-bd8e-3ae53f7f1cc9_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_VisionConfigInit\nVAR\n    xInitialized : BOOL := FALSE;\nEND_VAR","LineInfoPersistence":"(string)6bc60d8c-2430-4839-bd8e-3ae53f7f1cc9_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)164","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}