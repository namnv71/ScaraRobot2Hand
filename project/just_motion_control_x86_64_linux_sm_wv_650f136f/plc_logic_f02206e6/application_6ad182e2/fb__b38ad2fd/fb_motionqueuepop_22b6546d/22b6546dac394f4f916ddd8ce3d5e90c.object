{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)22b6546d-ac39-4f4f-916d-dd8ce3d5e90c","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_MotionQueuePop","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ExecuteRise := Execute AND NOT ExecuteOld; // Tao xung suon len\n// ExecuteOld := Execute;\n// \n// Done := FALSE;\n// Empty := FALSE;\n// \n// IF ExecuteRise THEN // Chỉ xử lý khi có lệnh gọi pop\n//     IF GVL.A_MotionCount <= 0 THEN // Nếu số phần tử trong queue bằng 0 hoặc nhỏ hơn 0 thì queue rỗng\n//         Empty := TRUE;\n//     ELSE\n//         Item := GVL.A_MotionQueue[GVL.A_MotionHead];  // Nếu queue còn dữ liệu thì lấy phần tử tại vị trí A_MotionHead\n// \n//         GVL.A_MotionHead := GVL.A_MotionHead + 1; // Tang gia tri len 1 sau khi lay\n//         IF GVL.A_MotionHead > 20 THEN // Nếu Head vượt quá 20 thì quay lại 1\n//             GVL.A_MotionHead := 1;\n//         END_IF;\n// \n//         GVL.A_MotionCount := GVL.A_MotionCount - 1; // giam so luong phan di trong queue di 1\n//         Done := TRUE;\n//     END_IF;\n// END_IF;\n\n//====================================================\n// FB_MotionQueuePop\n// Handshake:\n// Execute = TRUE  -> xử lý đúng 1 lần\n// Done/Empty giữ TRUE cho tới khi Execute = FALSE\n//====================================================\n\nIF NOT Execute THEN\n\n    Done := FALSE;\n    Empty := FALSE;\n    Busy := FALSE;\n\nELSE\n\n    IF NOT Busy THEN\n\n        Busy := TRUE;\n\n        IF GVL.A_MotionCount <= 0 THEN\n\n            Empty := TRUE;\n            Done := FALSE;\n\n        ELSE\n\n            Item := GVL.A_MotionQueue[GVL.A_MotionHead];\n\n            GVL.A_MotionHead := GVL.A_MotionHead + 1; // Tang gia tri len 1 sau khi lay\n\n            IF GVL.A_MotionHead > 20 THEN // Nếu Head vượt quá 20 thì quay lại 1\n                GVL.A_MotionHead := 1;\n            END_IF;\n\n            GVL.A_MotionCount := GVL.A_MotionCount - 1; // giam so luong phan di trong queue di 1\n\n            Done := TRUE;\n            Empty := FALSE;\n\n        END_IF;\n\n    END_IF;\n\nEND_IF;","LineInfoPersistence":"(string)22b6546d-ac39-4f4f-916d-dd8ce3d5e90c_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_MotionQueuePop\nVAR_INPUT\n\tExecute : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tItem  : ST_MotionQueueItem;\n    Done  : BOOL;\n    Empty : BOOL;\n\tBusy  : BOOL;\nEND_VAR\nVAR\n\tExecuteOld  : BOOL;\n\tExecuteRise : BOOL;\nEND_VAR\n","LineInfoPersistence":"(string)22b6546d-ac39-4f4f-916d-dd8ce3d5e90c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)81","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}