{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)3562f851-59fa-45a9-abf4-97aff53a7bf6","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_Run_Point","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF NOT Enable THEN\n\tError := FALSE;\n\tDone := FALSE; \t\n\tBusy := FALSE;\n\tIF Hand_Type = 0 THEN\n\t\tARunP := FALSE;\n\t\tARunL := FALSE;\n\tEND_IF;\n\tIF Hand_Type = 1 THEN\n\t\tBRunP := FALSE;\n\t\tBRunL := FALSE;\n\tEND_IF;\n\tRETURN;\nEND_IF\n\nIF A_Error AND Hand_Type = 0  THEN\n    Error := FALSE;\n\tDone := FALSE; \t\n\tBusy := FALSE;\n\tARunP := FALSE;\n\tARunL := FALSE;\n\tRETURN;\nEND_IF;\n\nIF B_Error AND Hand_Type = 1  THEN\n    Error := FALSE;\n\tDone := FALSE; \t\n\tBusy := FALSE;\n\tBRunP := FALSE;\n\tBRunL := FALSE;\n\tRETURN;\nEND_IF;\n\nIF Enable THEN\n\tIF Hand_Type = 0 THEN  // Robot Trai - A\n\t\tIF Move_Type = 0 THEN // MovP\n\t\t\tIF NOT ARunP AND NOT A_Comp AND NOT Busy AND A_Ready AND NOT Done AND NOT Busy THEN\n\t\t\t\tA_Comp := FALSE;\n\t\t\t\tARunP := TRUE;\n\t\t\t\tBusy := TRUE;\n\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\tIF A_Comp AND ARunP THEN\n\t\t\t\tARunP\t := FALSE;\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tBusy := FALSE;\n\t\t\t\tDone\t := TRUE;\n\t\t\tEND_IF\n\t\tEND_IF\t\n\t\tIF Move_Type = 1 THEN // MovL\n\t\t\tIF NOT ARunL AND NOT A_Comp AND NOT Busy AND A_Ready AND NOT Done AND NOT Busy THEN\n\t\t\t\tA_Comp := FALSE;\n\t\t\t\tARunL := TRUE;\n\t\t\t\tBusy := TRUE;\n\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\tIF A_Comp AND ARunL THEN\n\t\t\t\tARunL\t := FALSE;\n\t\t\t\tA_Comp\t := FALSE;\n\t\t\t\tBusy := FALSE;\n\t\t\t\tDone\t := TRUE;\n\t\t\tEND_IF\n\t\tEND_IF\t\n\tEND_IF\n\t// RB B\n\tIF Hand_Type = 1 THEN  // Robot Phai - B\n\t\tIF Move_Type = 0 THEN // MovP\n\t\t\tIF NOT BRunP AND NOT B_Comp AND NOT Busy AND B_Ready AND NOT Done AND NOT Busy THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tBRunP := TRUE;\n\t\t\t\tBusy := TRUE;\n\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\tIF B_Comp AND BRunP THEN\n\t\t\t\tBRunP\t := FALSE;\n\t\t\t\tB_Comp\t := FALSE;\n\t\t\t\tBusy := FALSE;\n\t\t\t\tDone\t := TRUE;\n\t\t\tEND_IF\n\t\tEND_IF\t\n\t\tIF Move_Type = 1 THEN // MovL\n\t\t\tIF NOT BRunL AND NOT B_Comp AND NOT Busy AND B_Ready AND NOT Done AND NOT Busy THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tBRunL := TRUE;\n\t\t\t\tBusy := TRUE;\n\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\tIF B_Comp AND BRunL THEN\n\t\t\t\tBRunL\t := FALSE;\n\t\t\t\tB_Comp\t := FALSE;\n\t\t\t\tBusy := FALSE;\n\t\t\t\tDone\t := TRUE;\n\t\t\tEND_IF\n\t\tEND_IF\t\n\tEND_IF\nEND_IF","LineInfoPersistence":"(string)3562f851-59fa-45a9-abf4-97aff53a7bf6_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK PUBLIC FB_Run_Point\nVAR_INPUT\n\tEnable\t  : BOOL;\n\tHand_Type : INT; // 0: Trai-A; 1: Phai-B\n\tMove_Type : INT; // 0: MovP ; 1-MovL; 2-MovC\n\tA_Error   : BOOL;\n\tB_Error   : BOOL;\n\tA_Ready : BOOL;\n\tB_Ready : BOOL;\nEND_VAR\nVAR_IN_OUT\n\tARunP : BOOL;\n    ARunL : BOOL;\n\tBRunP : BOOL;\n    BRunL : BOOL;\n\tA_Comp    : BOOL;\n\tB_Comp    : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;  // Da chay xong target pos\n\tBusy : BOOL;  // Dang chay target pos\n\tError : BOOL; // Function Error\nEND_VAR\n\n","LineInfoPersistence":"(string)3562f851-59fa-45a9-abf4-97aff53a7bf6_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)117","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}