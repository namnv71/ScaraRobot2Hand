{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)ece74669-6458-4914-9704-f7d01da853cd","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_TRACKING_OBJECT","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: TRACKING OBJECT\n//-----------------------------------------------------------------------------\n// Dữ liệu chuẩn hóa của một sản phẩm trong Tracking Queue.\n//=============================================================================\nTYPE ST_TRACKING_OBJECT :\nSTRUCT\n\n    // TRUE khi Slot đang chứa Object hợp lệ.\n    Valid : BOOL;\n\n    // ID duy nhất của Object.\n    ObjectID : UDINT;\n\n    // Mã loại sản phẩm.\n    ProductClassID : UINT;\n\n    // Nguồn tạo Object.\n    SourceType : E_ObjectSourceType;\n\t// ID của nguồn tạo Object.\n\t// SENSOR -> SensorSourceID.\n\t// VISION -> có thể dùng VisionSourceID hoặc Camera/Job tùy kiến trúc.\n\tSourceID : UINT;\n\n    // Pose của Object trong hệ Conveyor tại thời điểm Capture.\n    PoseInConveyor : ST_POS;\n\n    // Vị trí Conveyor tại thời điểm Object được Capture.\n    CaptureConveyorPositionMM : LREAL;\n\n    // Vị trí Conveyor hiện tại dùng cho giám sát.\n    CurrentConveyorPositionMM : LREAL;\n\t\n\tCaptureConveyorPos      : REAL;     // Position conveyor lúc chụp.\n\t\n\tCaptureRobotPos         : ST_POS;   // Position robot lúc chụp.\n\n    VisionPos               : ST_POS;   // Position vision trả về.\n\n    // Điểm Score của Vision.\n    // Với Sensor có thể gán mặc định 100%.\n    VisionScore : REAL;\n\n    // TRUE nếu góc Object có giá trị tin cậy.\n    OrientationValid : BOOL;\n\t\n// \t// TRUE khi Object Vision đã có kết quả Pose hợp lệ.\n// \tVisionResultValid : BOOL;\n\n    // TRUE khi Object đã được một Tool giữ chỗ.\n    Reserved : BOOL;\n\n    // ToolID đang giữ Object.\n    ReservedToolID : UINT;\n\n    // Trạng thái Object.\n    State : E_TrackingObjectState;\n\t\n    TriggerID               : UDINT;    // TriggerID vision.\n    ProductID               : UDINT;    // ID sản phẩm.\n\n    CameraID                : UINT;     // Camera đã chụp.\n    JobID                   : UINT;     // Job đã sử dụng.\n\n    \n\n    ConveyorOffset          : REAL;     // Conveyor dịch từ lúc chụp.\n    ConveyorCoordinate      : REAL;     // Tọa độ dọc conveyor hiện tại.\n\n    CurrentPos              : ST_POS;   // Position hiện tại của object.\n\n    InspectionResult        : E_InspectionResult; // Kết quả kiểm tra.\n    PickAttempts            : UINT;     // Số lần thử gắp.\n\n    RejectCode              : UINT;     // Mã lý do reject.\n    ErrorID                 : UDINT;    // Mã lỗi object.\n\t\n\t// TRUE khi object còn đủ thời gian và nằm trong vùng có thể nhận gắp.\n    CanPick              : BOOL;\n\n    // Thời gian ước tính còn lại trước khi tới giới hạn bắt đầu gắp, giây.\n    TimeRemainingSec     : REAL;\n\n    // TRUE khi object active đã vượt AbortPositionMM.\n    AbortRequired        : BOOL;\n\n    // Dùng debug/thống kê lý do object bị bỏ.\n    MissCode             : UINT;\n\t// Mức ưu tiên của object.\n    // Giá trị lớn hơn được ưu tiên hơn.\n    Priority : UINT;\n\n    // Điểm chất lượng kết quả Vision, thường nằm trong khoảng 0.0 đến 1.0\n    // hoặc 0.0 đến 100.0 tùy phần mềm Vision.\n    //VisionScore : REAL;\n\n    // Thời gian robot ước tính cần để tiếp cận và gắp object, đơn vị giây.\n    // Giai đoạn đầu có thể gán bằng cùng một giá trị cho mọi object.\n    EstimatedPickTimeSec : REAL;\n\n    // Thời điểm object được thêm vào Queue.\n    // Dùng cho thuật toán FIFO.\n    CaptureTime : TIME;\n\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)ece74669-6458-4914-9704-f7d01da853cd_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)108"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}