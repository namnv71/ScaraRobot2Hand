{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)0762d257-379a-4bad-a7a6-4e2ed5a6b46f","ParentGuid":"(Guid)f4a6c26b-9c1c-4821-acae-2bd436302385","Name":"(string)ACT_LOGIC","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1. Select_Tool\"}\n/// ROBOT A\n\t \n//=============================================================================\n// ROBOT A - SELECT / APPLY TOOL TCP\n//-----------------------------------------------------------------------------\n// Quy ước:\n// Number_Tool = 0 : Không sử dụng Tool Offset.\n// Number_Tool = 1 : Tool 1.\n// Number_Tool = 2 : Tool 2.\n// ...\n//\n// Nguồn TCP duy nhất:\n// GVL.g_aToolConfigA[ToolID].ToolTCP\n//\n// Tool được Apply lại khi:\n// 1. Number_Tool thay đổi.\n// 2. Có ApplyRequest mới, kể cả Number_Tool không đổi.\n//\n// SMC_GroupSetTool_RBA đã được đặt sẵn trên FBD.\n// Chân Execute của SMC_GroupSetTool_RBA phải nối với xSetToolExecuteA.\n//=============================================================================\n\nGVL.g_xRobotAToolApplyDone := FALSE;\n\n\n//=============================================================================\n// 01. PHÁT HIỆN YÊU CẦU APPLY TOOL MỚI\n//=============================================================================\nIF ((pre_Select_Tool_A <> GVL.RB_A.Number_Tool)\nOR (GVL.g_udiRobotAToolApplyRequestA <> udiLastToolApplyRequestA))\nAND NOT xSetToolExecuteA THEN\n\n    //---------------------------------------------------------------------\n    // Xóa trạng thái transaction trước.\n    //---------------------------------------------------------------------\n    GVL.g_xRobotAToolApplyBusy := TRUE;\n    GVL.g_xRobotAToolApplyDone := FALSE;\n    GVL.g_xRobotAToolApplyError := FALSE;\n    GVL.g_udiRobotAToolApplyErrorID := 0;\n\n\n    //---------------------------------------------------------------------\n    // TOOL 0 - KHÔNG SỬ DỤNG TOOL OFFSET\n    //---------------------------------------------------------------------\n    IF GVL.RB_A.Number_Tool = 0 THEN\n\n        Point_offsetool_RBA := Pos_ORG;\n\n\n    //---------------------------------------------------------------------\n    // TOOL 1..C_MAX_TOOLS\n    //---------------------------------------------------------------------\n    ELSIF GVL.RB_A.Number_Tool >= 1\n    AND GVL.RB_A.Number_Tool <= GVL.C_MAX_TOOLS THEN\n\n        // Lấy trực tiếp TCP của Tool đang được chọn.\n        Point_offsetool_RBA.X := TO_LREAL(GVL.g_aToolConfigA[GVL.RB_A.Number_Tool].ToolTCP.X);\n        Point_offsetool_RBA.Y := TO_LREAL(GVL.g_aToolConfigA[GVL.RB_A.Number_Tool].ToolTCP.Y);\n        Point_offsetool_RBA.Z := TO_LREAL(GVL.g_aToolConfigA[GVL.RB_A.Number_Tool].ToolTCP.Z);\n        Point_offsetool_RBA.A := TO_LREAL(GVL.g_aToolConfigA[GVL.RB_A.Number_Tool].ToolTCP.A);\n        Point_offsetool_RBA.B := TO_LREAL(0);\n        Point_offsetool_RBA.C := TO_LREAL(0);\n\n\n    //---------------------------------------------------------------------\n    // TOOL NUMBER KHÔNG HỢP LỆ\n    //---------------------------------------------------------------------\n    ELSE\n\n        GVL.g_xRobotAToolApplyBusy := FALSE;\n        GVL.g_xRobotAToolApplyDone := FALSE;\n        GVL.g_xRobotAToolApplyError := TRUE;\n\n        // Lỗi nội bộ: Number_Tool ngoài phạm vi cho phép.\n        GVL.g_udiRobotAToolApplyErrorID := 10001;\n\n    END_IF;\n\n\n    //---------------------------------------------------------------------\n    // Chỉ phát Execute nếu Tool Number hợp lệ.\n    //---------------------------------------------------------------------\n    IF NOT GVL.g_xRobotAToolApplyError THEN\n\n        // Ghi nhớ Tool đang Apply.\n        pre_Select_Tool_A := GVL.RB_A.Number_Tool;\n\n        // Ghi nhớ Request đang xử lý.\n        udiLastToolApplyRequestA := GVL.g_udiRobotAToolApplyRequestA;\n\n        // Phát Execute cho SMC_GroupSetTool_RBA trên FBD.\n        xSetToolExecuteA := TRUE;\n\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// 02. SMC_GroupSetTool HOÀN THÀNH\n//-----------------------------------------------------------------------------\n// SMC_GroupSetTool_RBA được gọi trên FBD.\n// Ở đây chỉ đọc Done / Error của instance đó.\n//=============================================================================\nIF xSetToolExecuteA AND SMC_GroupSetTool_RBA.Done THEN\n\n    // Hạ Execute để tạo cạnh mới cho lần Apply tiếp theo.\n    xSetToolExecuteA := FALSE;\n\n    // Transaction hoàn thành.\n    GVL.g_xRobotAToolApplyBusy := FALSE;\n    GVL.g_xRobotAToolApplyDone := TRUE;\n    GVL.g_xRobotAToolApplyError := FALSE;\n    GVL.g_udiRobotAToolApplyErrorID := 0;\n\n    // Xác nhận đúng Request đã được Apply.\n    GVL.g_udiRobotAToolAppliedRequestA := udiLastToolApplyRequestA;\n\nEND_IF;\n\n\n//=============================================================================\n// 03. SMC_GroupSetTool ERROR\n//=============================================================================\nIF xSetToolExecuteA AND SMC_GroupSetTool_RBA.Error THEN\n\n    // Kết thúc transaction hiện tại.\n    xSetToolExecuteA := FALSE;\n\n    GVL.g_xRobotAToolApplyBusy := FALSE;\n    GVL.g_xRobotAToolApplyDone := FALSE;\n    GVL.g_xRobotAToolApplyError := TRUE;\n\n    // Chuyển ErrorID của SoftMotion ra hệ thống chung.\n    GVL.g_udiRobotAToolApplyErrorID := TO_UDINT(SMC_GroupSetTool_RBA.ErrorID);\n\nEND_IF;\n\t \n\t\t  \n\t\t\t   \n// IF pre_Select_Tool_A <> GVL.RB_A.Number_Tool THEN\n// \n// CASE GVL.RB_A.Number_Tool OF\n// \t0: \t\n// \t\tPoint_offsetool_RBA := Pos_ORG;\n// \n// \t1:  \n// \t\tPoint_offsetool_RBA.X := TO_LREAL(GVL_2.A_Tool[0].X);\n// \t\tPoint_offsetool_RBA.Y := TO_LREAL(GVL_2.A_Tool[0].Y);\n// \t\tPoint_offsetool_RBA.Z := TO_LREAL(GVL_2.A_Tool[0].Z);\n// \t\tPoint_offsetool_RBA.A := TO_LREAL(GVL_2.A_Tool[0].A);\n// \t\tPoint_offsetool_RBA.B := TO_LREAL(GVL_2.A_Tool[0].B);\n// \t\tPoint_offsetool_RBA.C := TO_LREAL(GVL_2.A_Tool[0].C);\n// \t\t\n// \t2:  \n// \t\tPoint_offsetool_RBA.X := TO_LREAL(GVL_2.A_Tool[1].X);\n// \t\tPoint_offsetool_RBA.Y := TO_LREAL(GVL_2.A_Tool[1].Y);\n// \t\tPoint_offsetool_RBA.Z := TO_LREAL(GVL_2.A_Tool[1].Z);\n// \t\tPoint_offsetool_RBA.A := TO_LREAL(GVL_2.A_Tool[1].A);\n// \t\tPoint_offsetool_RBA.B := TO_LREAL(GVL_2.A_Tool[1].B);\n// \t\tPoint_offsetool_RBA.C := TO_LREAL(GVL_2.A_Tool[1].C);\n// \t\n// \t3:  \n// \t\tPoint_offsetool_RBA.X := TO_LREAL(GVL_2.A_Tool[2].X);\n// \t\tPoint_offsetool_RBA.Y := TO_LREAL(GVL_2.A_Tool[2].Y);\n// \t\tPoint_offsetool_RBA.Z := TO_LREAL(GVL_2.A_Tool[2].Z);\n// \t\tPoint_offsetool_RBA.A := TO_LREAL(GVL_2.A_Tool[2].A);\n// \t\tPoint_offsetool_RBA.B := TO_LREAL(GVL_2.A_Tool[2].B);\n// \t\tPoint_offsetool_RBA.C := TO_LREAL(GVL_2.A_Tool[2].C);\n// \t4:  \n// \t\tPoint_offsetool_RBA.X := TO_LREAL(GVL_2.A_Tool[3].X);\n// \t\tPoint_offsetool_RBA.Y := TO_LREAL(GVL_2.A_Tool[3].Y);\n// \t\tPoint_offsetool_RBA.Z := TO_LREAL(GVL_2.A_Tool[3].Z);\n// \t\tPoint_offsetool_RBA.A := TO_LREAL(GVL_2.A_Tool[3].A);\n// \t\tPoint_offsetool_RBA.B := TO_LREAL(GVL_2.A_Tool[3].B);\n// \t\tPoint_offsetool_RBA.C := TO_LREAL(GVL_2.A_Tool[3].C);\n// \t5:  \n// \t\tPoint_offsetool_RBA.X := TO_LREAL(GVL_2.A_Tool[4].X);\n// \t\tPoint_offsetool_RBA.Y := TO_LREAL(GVL_2.A_Tool[4].Y);\n// \t\tPoint_offsetool_RBA.Z := TO_LREAL(GVL_2.A_Tool[4].Z);\n// \t\tPoint_offsetool_RBA.A := TO_LREAL(GVL_2.A_Tool[4].A);\n// \t\tPoint_offsetool_RBA.B := TO_LREAL(GVL_2.A_Tool[4].B);\n// \t\tPoint_offsetool_RBA.C := TO_LREAL(GVL_2.A_Tool[4].C);\t\t\t \n// END_CASE\t\n// \t SMC_GroupSetTool_RBA.Execute := TRUE;\n// ELSE\n// \tSMC_GroupSetTool_RBA.Execute := FALSE;\n// END_IF\n// pre_Select_Tool_A := GVL.RB_A.Number_Tool;\n\t \n\t\t  \n\t\t\t   \n\t\t\t\t\t\n// POU_COORDINATE_ - ROBOT B TOOL APPLY\n// Thêm local: udiLastToolApplyRequestB : UDINT; xSetToolExecuteB : BOOL;\n// Thay phần Robot B để dùng g_aToolConfigB và handshake B riêng.\n// Chân Execute của SMC_GroupSetTool_RBb phải nối xSetToolExecuteB.\n\nGVL.g_xRobotBToolApplyDone := FALSE;\n\nIF ((pre_Select_Tool_B <> GVL.RB_B.Number_Tool) OR (GVL.g_udiRobotBToolApplyRequestB <> udiLastToolApplyRequestB))\nAND NOT xSetToolExecuteB THEN\n    GVL.g_xRobotBToolApplyBusy := TRUE;\n    GVL.g_xRobotBToolApplyDone := FALSE;\n    GVL.g_xRobotBToolApplyError := FALSE;\n    GVL.g_udiRobotBToolApplyErrorID := 0;\n\n    IF GVL.RB_B.Number_Tool = 0 THEN\n        Point_offsetool_RBB := Pos_ORG;\n    ELSIF GVL.RB_B.Number_Tool >= 1 AND GVL.RB_B.Number_Tool <= GVL.C_MAX_TOOLS THEN\n        Point_offsetool_RBB.X := TO_LREAL(GVL.g_aToolConfigB[GVL.RB_B.Number_Tool].ToolTCP.X);\n        Point_offsetool_RBB.Y := TO_LREAL(GVL.g_aToolConfigB[GVL.RB_B.Number_Tool].ToolTCP.Y);\n        Point_offsetool_RBB.Z := TO_LREAL(GVL.g_aToolConfigB[GVL.RB_B.Number_Tool].ToolTCP.Z);\n        Point_offsetool_RBB.A := TO_LREAL(GVL.g_aToolConfigB[GVL.RB_B.Number_Tool].ToolTCP.A);\n        Point_offsetool_RBB.B := 0.0;\n        Point_offsetool_RBB.C := 0.0;\n        pre_Select_Tool_B := GVL.RB_B.Number_Tool;\n        udiLastToolApplyRequestB := GVL.g_udiRobotBToolApplyRequestB;\n        xSetToolExecuteB := TRUE;\n    ELSE\n        GVL.g_xRobotBToolApplyBusy := FALSE;\n        GVL.g_xRobotBToolApplyError := TRUE;\n        GVL.g_udiRobotBToolApplyErrorID := 10001;\n    END_IF;\nEND_IF;\n\nIF xSetToolExecuteB AND SMC_GroupSetTool_RBb.Done THEN\n    xSetToolExecuteB := FALSE;\n    GVL.g_xRobotBToolApplyBusy := FALSE;\n    GVL.g_xRobotBToolApplyDone := TRUE;\n    GVL.g_udiRobotBToolAppliedRequestB := udiLastToolApplyRequestB;\nEND_IF;\n\nIF xSetToolExecuteB AND SMC_GroupSetTool_RBb.Error THEN\n    xSetToolExecuteB := FALSE;\n    GVL.g_xRobotBToolApplyBusy := FALSE;\n    GVL.g_xRobotBToolApplyError := TRUE;\n    GVL.g_udiRobotBToolApplyErrorID := TO_UDINT(SMC_GroupSetTool_RBb.ErrorID);\nEND_IF;\n\t\t\t\t\t\t \n\t \n// /// ROBOT B\n// IF pre_Select_Tool_B <> GVL.RB_B.Number_Tool THEN\n// \t\n// CASE GVL.RB_b.Number_Tool OF\n// \t0: \t\n// \t\tPoint_offsetool_RBB := Pos_ORG;\n// \t1:  \n// \t\tPoint_offsetool_RBB.X := TO_LREAL(GVL_2.B_Tool[0].X);\n// \t\tPoint_offsetool_RBB.Y := TO_LREAL(GVL_2.B_Tool[0].Y);\n// \t\tPoint_offsetool_RBB.Z := TO_LREAL(GVL_2.B_Tool[0].Z);\n// \t\tPoint_offsetool_RBB.A := TO_LREAL(GVL_2.B_Tool[0].A);\n// \t\tPoint_offsetool_RBB.B := TO_LREAL(GVL_2.B_Tool[0].B);\n// \t\tPoint_offsetool_RBB.C := TO_LREAL(GVL_2.B_Tool[0].C);\t\t\n// \t2:  \n// \t\tPoint_offsetool_RBB.X := TO_LREAL(GVL_2.B_Tool[1].X);\n// \t\tPoint_offsetool_RBB.Y := TO_LREAL(GVL_2.B_Tool[1].Y);\n// \t\tPoint_offsetool_RBB.Z := TO_LREAL(GVL_2.B_Tool[1].Z);\n// \t\tPoint_offsetool_RBB.A := TO_LREAL(GVL_2.B_Tool[1].A);\n// \t\tPoint_offsetool_RBB.B := TO_LREAL(GVL_2.B_Tool[1].B);\n// \t\tPoint_offsetool_RBB.C := TO_LREAL(GVL_2.B_Tool[1].C);\n// \n// \t3:  \n// \t\tPoint_offsetool_RBB.X := TO_LREAL(GVL_2.B_Tool[2].X);\n// \t\tPoint_offsetool_RBB.Y := TO_LREAL(GVL_2.B_Tool[2].Y);\n// \t\tPoint_offsetool_RBB.Z := TO_LREAL(GVL_2.B_Tool[2].Z);\n// \t\tPoint_offsetool_RBB.A := TO_LREAL(GVL_2.B_Tool[2].A);\n// \t\tPoint_offsetool_RBB.B := TO_LREAL(GVL_2.B_Tool[2].B);\n// \t\tPoint_offsetool_RBB.C := TO_LREAL(GVL_2.B_Tool[2].C);\n// \t4:  \n// \t\tPoint_offsetool_RBB.X := TO_LREAL(GVL_2.B_Tool[3].X);\n// \t\tPoint_offsetool_RBB.Y := TO_LREAL(GVL_2.B_Tool[3].Y);\n// \t\tPoint_offsetool_RBB.Z := TO_LREAL(GVL_2.B_Tool[3].Z);\n// \t\tPoint_offsetool_RBB.A := TO_LREAL(GVL_2.B_Tool[3].A);\n// \t\tPoint_offsetool_RBB.B := TO_LREAL(GVL_2.B_Tool[3].B);\n// \t\tPoint_offsetool_RBB.C := TO_LREAL(GVL_2.B_Tool[3].C);\t\n// \t5:  \n// \t\tPoint_offsetool_RBB.X := TO_LREAL(GVL_2.B_Tool[4].X);\n// \t\tPoint_offsetool_RBB.Y := TO_LREAL(GVL_2.B_Tool[4].Y);\n// \t\tPoint_offsetool_RBB.Z := TO_LREAL(GVL_2.B_Tool[4].Z);\n// \t\tPoint_offsetool_RBB.A := TO_LREAL(GVL_2.B_Tool[4].A);\n// \t\tPoint_offsetool_RBB.B := TO_LREAL(GVL_2.B_Tool[4].B);\n// \t\tPoint_offsetool_RBB.C := TO_LREAL(GVL_2.B_Tool[4].C);\t\t \n// \n// END_CASE\n// \tSMC_GroupSetTool_RBb.Execute := TRUE;\n// ELSE\n// \tSMC_GroupSetTool_RBb.Execute := FALSE;\t\t\n// END_IF\n// pre_Select_Tool_B := GVL.RB_B.Number_Tool;\n\t\t\t\t\t\n{endregion}\n{region \"2. SET COORDINATE SYSTEM\"}\t \n\tCoor_trans_RBA.X := TO_LREAL(GVL_2.A_POS_COOR.X);\n\tCoor_trans_RBA.Y := TO_LREAL(GVL_2.A_POS_COOR.y);\t \n\tCoor_trans_RBA.Z := TO_LREAL(GVL_2.A_POS_COOR.z);\n\tCoor_trans_RBA.a := TO_LREAL(GVL_2.A_POS_COOR.A);\n\tCoor_trans_RBA.B := TO_LREAL(GVL_2.A_POS_COOR.b);\t\n\tCoor_trans_RBA.C := TO_LREAL(GVL_2.A_POS_COOR.C);  \n\t\t\t   \n\tCoor_trans_RBb.X := TO_LREAL(GVL_2.B_POS_COOR.X);\n\tCoor_trans_RBb.Y := TO_LREAL(GVL_2.B_POS_COOR.y);\t \n\tCoor_trans_RBb.Z := TO_LREAL(GVL_2.B_POS_COOR.z);\n\tCoor_trans_RBb.a := TO_LREAL(GVL_2.B_POS_COOR.A);\n\tCoor_trans_RBb.B := TO_LREAL(GVL_2.B_POS_COOR.b);\t\n\tCoor_trans_RBb.C := TO_LREAL(GVL_2.B_POS_COOR.C);  \t\t\t\t\t\n\n\t\t  \n{endregion}\n\t \n{region \"3. Convert Pos___TOOL\"}\n\n\t// TOOL_1\n\t\tTool_A_1.X := TO_LREAL(GVL_2.A_Tool[0].X);\n\t\tTool_A_1.Y := TO_LREAL(GVL_2.A_Tool[0].Y);\n\t\tTool_A_1.Z := TO_LREAL(GVL_2.A_Tool[0].Z);\n\t\tTool_A_1.A := TO_LREAL(GVL_2.A_Tool[0].A);\n\t\tTool_A_1.B := TO_LREAL(GVL_2.A_Tool[0].B);\n\t\tTool_A_1.C := TO_LREAL(GVL_2.A_Tool[0].C); \n\t// TOOL_2\n\t\tTool_A_2.X := TO_LREAL(GVL_2.A_Tool[1].X);\n\t\tTool_A_2.Y := TO_LREAL(GVL_2.A_Tool[1].Y);\n\t\tTool_A_2.Z := TO_LREAL(GVL_2.A_Tool[1].Z);\n\t\tTool_A_2.A := TO_LREAL(GVL_2.A_Tool[1].A);\n\t\tTool_A_2.B := TO_LREAL(GVL_2.A_Tool[1].B);\n\t\tTool_A_2.C := TO_LREAL(GVL_2.A_Tool[1].C); \t\n\n\n\t// TOOL_1\n\t\tTool_B_1.X := TO_LREAL(GVL_2.B_Tool[0].X);\n\t\tTool_B_1.Y := TO_LREAL(GVL_2.B_Tool[0].Y);\n\t\tTool_B_1.Z := TO_LREAL(GVL_2.B_Tool[0].Z);\n\t\tTool_B_1.A := TO_LREAL(GVL_2.B_Tool[0].A);\n\t\tTool_B_1.B := TO_LREAL(GVL_2.B_Tool[0].B);\n\t\tTool_B_1.C := TO_LREAL(GVL_2.B_Tool[0].C); \n\t// TOOL_2\n\t\tTool_B_2.X := TO_LREAL(GVL_2.B_Tool[1].X);\n\t\tTool_B_2.Y := TO_LREAL(GVL_2.B_Tool[1].Y);\n\t\tTool_B_2.Z := TO_LREAL(GVL_2.B_Tool[1].Z);\n\t\tTool_B_2.A := TO_LREAL(GVL_2.B_Tool[1].A);\n\t\tTool_B_2.B := TO_LREAL(GVL_2.B_Tool[1].B);\n\t\tTool_B_2.C := TO_LREAL(GVL_2.B_Tool[1].C); \n\t\t\n{endregion}","LineInfoPersistence":"(string)0762d257-379a-4bad-a7a6-4e2ed5a6b46f_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)345"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}