{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)2ed54f7b-537c-4efd-8da5-9b143347b982","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_SystemTestStage","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9dcb4e39-219e-4927-8677-e88ae77e3427"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_SystemTestStage :\n(\n    TEST_NONE := 0,                    // Không chạy kiểm thử module.\n\n    TEST_VISION_COMM := 10,             // Kiểm tra handshake vision.\n    TEST_VISION_ALIGN := 20,            // Kiểm tra kết quả align.\n    TEST_VISION_INSPECTION := 30,       // Kiểm tra PASS/FAIL.\n    TEST_GLUE_PATH_RECEIVE := 40,       // Kiểm tra nhận dữ liệu path.\n    TEST_GLUE_STATIC_DRY_RUN := 50,     // Chạy path tĩnh, không bật keo.\n    TEST_CONVEYOR_AXIS := 60,           // Kiểm tra AXIS_6 và encoder.\n    TEST_TRACK_SINGLE_DRY_RUN := 70,    // Tracking một object, không gắp thật.\n    TEST_TRACK_SINGLE_PICK := 80,       // Tracking và gắp một object.\n    TEST_TRACK_QUEUE := 90,             // Tracking nhiều object.\n    TEST_CONVEYOR_INSPECTION := 100,    // Inspection trên conveyor.\n    TEST_CONVEYOR_GLUE_DRY_RUN := 110,  // Bôi keo tracking nhưng chưa bật keo.\n    TEST_CONVEYOR_GLUE := 120            // Chạy đầy đủ bôi keo trên conveyor.\n);\nEND_TYPE","LineInfoPersistence":"(string)2ed54f7b-537c-4efd-8da5-9b143347b982_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)20"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}