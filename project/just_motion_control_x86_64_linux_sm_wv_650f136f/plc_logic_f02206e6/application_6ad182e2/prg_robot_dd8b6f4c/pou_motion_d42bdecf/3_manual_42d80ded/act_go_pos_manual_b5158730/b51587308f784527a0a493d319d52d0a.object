{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)b5158730-8f78-4527-a0a4-93d319d52d0a","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)ACT_GO_Pos_Manual","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)42d80ded-8752-4d8a-bf5f-3274bbc10f1e"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1. GO HOME\"}\nExcute_Run_goHome_A := GVL.RB_A.Manual AND GVL.RB_A.RB_goHome_Comfirm AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t(GVL.RB_A.M1_goHome OR GVL.RB_A.M2_goHome OR GVL.RB_A.M3_goHome OR GVL.RB_A.M4_goHome );\nExcute_Run_goHome_B := GVL.RB_B.Manual AND GVL.RB_B.RB_goHome_Comfirm AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t(GVL.RB_B.M1_goHome OR GVL.RB_B.M2_goHome OR GVL.RB_B.M3_goHome OR GVL.RB_B.M4_goHome );\n\nIF GVL.RB_A.Manual AND GVL.RB_A.RB_goHome_Comfirm THEN\n\tGVL.RB_A.COORD := 0;\n\tIF GVL.RB_A.M1_goHome THEN Pos_run_manual_A.a.a0 := 0; ELSE Pos_run_manual_A.a.a0 := GVL.RB_A_.CUR_X ; END_IF;\n\tIF GVL.RB_A.M2_goHome THEN Pos_run_manual_A.a.a1 := 0; ELSE Pos_run_manual_A.a.a1 := GVL.RB_A_.CUR_Y ; END_IF;\t\n\tIF GVL.RB_A.M3_goHome THEN Pos_run_manual_A.a.a2 := 0; ELSE Pos_run_manual_A.a.a2 := GVL.RB_A_.CUR_Z ; END_IF;\t\n\tIF GVL.RB_A.M4_goHome THEN Pos_run_manual_A.a.a3 := 0; ELSE Pos_run_manual_A.a.a3 := GVL.RB_A_.CUR_R ; END_IF;\t\nEND_IF\n\nIF GVL.RB_B.Manual AND GVL.RB_B.RB_goHome_Comfirm THEN\n\tGVL.RB_B.COORD := 0;\n\tIF GVL.RB_B.M1_goHome THEN Pos_run_manual_B.a.a0 := 0; ELSE Pos_run_manual_B.a.a0 := GVL.RB_B_.CUR_X ; END_IF;\t\n\tIF GVL.RB_B.M2_goHome THEN Pos_run_manual_B.a.a1 := 0; ELSE Pos_run_manual_B.a.a1 := GVL.RB_B_.CUR_Y ; END_IF;\t\n\tIF GVL.RB_B.M3_goHome THEN Pos_run_manual_B.a.a2 := 0; ELSE Pos_run_manual_B.a.a2 := GVL.RB_B_.CUR_Z ; END_IF;\t\n\tIF GVL.RB_B.M4_goHome THEN Pos_run_manual_B.a.a3 := 0; ELSE Pos_run_manual_B.a.a3 := GVL.RB_B_.CUR_R ; END_IF;\nEND_IF\n{endregion}\t\n\n// Cai dat bien bao den vi tri muc tieu manual\t \nIF (MOVP_A.Done OR MOVL_A.Done) \nAND (ABS(GVL.RB_A_.CUR_X - Pos_run_manual_A.c.X) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_Y - Pos_run_manual_A.c.Y) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_Z - Pos_run_manual_A.c.Z) < delta_position_cor) \nAND (ABS(GVL.RB_A_.CUR_R - Pos_run_manual_A.c.A) < delta_position_cor)\nTHEN  A_Comp_Man\t:= TRUE;  ELSE A_Comp_Man\t:= FALSE; END_IF;\nIF (MOVP_B.Done OR MOVL_B.Done)  \nAND (ABS(GVL.RB_B_.CUR_X - Pos_run_manual_B.c.X) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_Y - Pos_run_manual_B.c.Y) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_Z - Pos_run_manual_B.c.Z) < delta_position_cor) \nAND (ABS(GVL.RB_B_.CUR_R - Pos_run_manual_B.c.A) < delta_position_cor)\nTHEN  B_Comp_Man\t:= TRUE;  ELSE B_Comp_Man\t:= FALSE; END_IF;\n\n\n{region \"2. GO WAIT\"}\n// Jog & Teach\nAP_Man_Z_Wait_Go := GVL.RB_A.Manual AND GVL.RB_A.Jog_Point AND GVL.RB_A.Move_Z_Wait AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\tPos_run_manual_A.c.Z = GVL_1.DATA_RB_A.Z_POS[1];\n\t\t\t\t\t\tIF GVL.RB_A.Move_Z_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_A := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_A.c.Z := GVL_1.DATA_RB_A.Z_POS[1];\n\t\t\t\t\t\tEND_IF;\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\nAP_Man_R_Wait_Go := GVL.RB_A.Manual AND GVL.RB_A.Jog_Point AND GVL.RB_A.Move_R_Wait AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\tPos_run_manual_A.c.A = GVL_1.DATA_RB_A.R_POS[1];\n\t\t\t\t\t\tIF GVL.RB_A.Move_R_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_A := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_A.c.A := GVL_1.DATA_RB_A.R_POS[1];\n\t\t\t\t\t\tEND_IF;\t\nAP_Man_XY_Wait_Go := GVL.RB_A.Manual AND GVL.RB_A.Jog_Point AND GVL.RB_A.Move_XY_Wait AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\tPos_run_manual_A.c.X = GVL_1.DATA_RB_A.X_POS[1] AND Pos_run_manual_A.c.Y = GVL_1.DATA_RB_A.Y_POS[1] ;\n\t\t\t\t\t\tIF GVL.RB_A.Move_XY_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_A := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_A.c.X := GVL_1.DATA_RB_A.X_POS[1];\n\t\t\t\t\t\t\tPos_run_manual_A.c.Y := GVL_1.DATA_RB_A.Y_POS[1];\n\t\t\t\t\t\tEND_IF;\t\n/////////////////////////////////////////\nExcute_Run_goZ_Wait_B := GVL.RB_B.Manual AND GVL.RB_B.Jog_Point AND GVL.RB_B.Move_Z_Wait AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\tPos_run_manual_B.c.Z = GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\t\t\tIF GVL.RB_B.Move_Z_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_B := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_B.c.Z := GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\t\t\tEND_IF;\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\nExcute_Run_goR_Wait_B := GVL.RB_B.Manual AND GVL.RB_B.Jog_Point AND GVL.RB_B.Move_R_Wait AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\tPos_run_manual_B.c.A = GVL_1.DATA_RB_B.R_POS[1];\n\t\t\t\t\t\tIF GVL.RB_B.Move_R_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_B := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_B.c.A := GVL_1.DATA_RB_B.R_POS[1];\n\t\t\t\t\t\tEND_IF;\t\nExcute_Run_goXY_Wait_B := GVL.RB_B.Manual AND GVL.RB_B.Jog_Point AND GVL.RB_B.Move_XY_Wait AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\tPos_run_manual_B.c.X = GVL_1.DATA_RB_B.X_POS[1] AND Pos_run_manual_B.c.Y = GVL_1.DATA_RB_B.Y_POS[1] ;\n\t\t\t\t\t\tIF GVL.RB_B.Move_XY_Wait AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\n\t\t\t\t\t\t\tPos_run_manual_B := POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\t\t\t\tPos_run_manual_B.c.X := GVL_1.DATA_RB_B.X_POS[1];\n\t\t\t\t\t\t\tPos_run_manual_B.c.Y := GVL_1.DATA_RB_B.Y_POS[1];\n\t\t\t\t\t\tEND_IF;\t\n{endregion}\t\n{region \"3. GO SELECT POS\"}\n// ROBOT A\n\tAP_Man_Pos_Go := GVL.RB_A.Manual AND GVL.RB_A.Comfirm_Move AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[10] > 0 AND GVL.DW_[11] > 0 AND GVL.DW_[11] = 3;\n\tAP_Man_Pos_Go_L := GVL.RB_A.Manual AND GVL.RB_A.Comfirm_Move AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[10] > 0 AND GVL.DW_[11] > 0 AND GVL.DW_[11] = 1;\n\t\t\t\t\t\tIF GVL.RB_A.Comfirm_Move AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\tPos_run_manual_A.c.X:= GVL_1.DATA_RB_A.X_POS[GVL.DW_[10]];\n\t\t\t\t\t\t\tPos_run_manual_A.c.Y:= GVL_1.DATA_RB_A.Y_POS[GVL.DW_[10]];\n\t\t\t\t\t\t\tPos_run_manual_A.c.Z:= GVL_1.DATA_RB_A.Z_POS[GVL.DW_[10]];\n\t\t\t\t\t\t\tPos_run_manual_A.c.A:= GVL_1.DATA_RB_A.R_POS[GVL.DW_[10]];\n\t\t\t\t\t\t\tGVL.RB_A.Comfirm_Move := FALSE;\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\tEND_IF;\t\t\n\tOther_PosA := Pos_run_manual_A.c.X <> Pos_run_A_Pre.c.X OR Pos_run_manual_A.c.Y <> Pos_run_A_Pre.c.Y \n\t\t\t\t  OR Pos_run_manual_A.c.Z <> Pos_run_A_Pre.c.Z OR Pos_run_manual_A.c.A <> Pos_run_A_Pre.c.A;\t  \t\t\t\t\t\t\t\t\t\t\t \n\tExcute_Run_goPos_A_UpZ := GVL.RB_A.Manual AND GVL.RB_A.Comfirm_Up_Z AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[10] > 0 AND GVL.DW_[11] > 0;\n\tExcute_Run_goPos_A_UpZ_XY_BF_R := GVL.RB_A.Manual AND GVL.RB_A.Comfirm_Up_Z_XY_BF_R AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[10] > 0 AND GVL.DW_[11] > 0;\n\tExcute_Run_goPos_A_UpZ_R_BF_XY := GVL.RB_A.Manual AND GVL.RB_A.Comfirm_Up_Z_R_BF_XY AND GVL.RB_A_.Ready AND NOT GVL.RB_A_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[10] > 0 AND GVL.DW_[11] > 0;\n\t\t\t\t\t\tIF Excute_Run_goPos_A_UpZ AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\tRuningPosA[GVL.DW_[10]] := TRUE;\n\t\t\t\t\t\t\tmode_Run_GoPosA_manual := 1;\t// chi len Z\n\t\t\t\t\t\t\tPos_Run_A_Pre := Pos_0;\t\t\n\t\t\t\t\t\t\tGVL.RB_A.Comfirm_Up_Z := FALSE; \n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tIF Excute_Run_goPos_A_UpZ_XY_BF_R AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tRuningPosA[GVL.DW_[10]] := TRUE;\n\t\t\t\t\t\t\t\tmode_Run_GoPosA_manual := 2;\t\t// chay XY trc xoay R\n\t\t\t\t\t\t\t\tPos_Run_A_Pre := Pos_0;\t\t\n\t\t\t\t\t\t\t\tGVL.RB_A.Comfirm_Up_Z_XY_BF_R := FALSE;\n\t\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\t\tIF Excute_Run_goPos_A_UpZ_R_BF_XY AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 21 THEN\n\t\t\t\t\t\t\t\t\tGVL.RB_A.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tRuningPosA[GVL.DW_[10]] := TRUE;\n\t\t\t\t\t\t\t\t\tmode_Run_GoPosA_manual := 3;\t\t// xoay R trc XY\n\t\t\t\t\t\t\t\t\tPos_Run_A_Pre := Pos_0;\t\t\n\t\t\t\t\t\t\t\t\tGVL.RB_A.Comfirm_Up_Z_R_BF_XY := FALSE;\n\t\t\t\t\t\t\t\tEND_IF; \n\t\t\t\t\t\t\tEND_IF;\t \n\t\t\t\t\t\tEND_IF;\t\n\nIF NOT GVL.X[9] THEN\n\tRuningPosA[GVL.DW_[10]] := FALSE;\n\tRuningPosB[GVL.DW_[12]]\t:= FALSE;\t \nEND_IF;\n\t\t\t\t\t\t \nIF RuningPosA[GVL.DW_[10]] THEN\n\tCASE PRO_A[GVL.DW_[10]] OF\n\t\t\t0: \n\t\t\t\tPos_run_manual_A :=  POU_MONITOR_ROBOT.RB1_POS;\n\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 10;\n\t\t\t10:\n\t\t\t\tPos_run_manual_A.c.Z :=  GVL_1.DATA_RB_A.Z_POS[1];\n\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 10;\n\t\t\t20:\n\t\t\t\tIF Other_PosA THEN\n\t\t\t\t\tCASE GVL.DW_[11] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_A := TRUE; \n\t\t\t\t\t\t3:  AP_Man_UP_Z_Go := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_A_Pre := Pos_run_manual_A; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_A_.ERROR OR  NOT GVL.RB_A_.Ready THEN\n\t\t\t\t\tRuningPosA[GVL.DW_[10]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_A := FALSE; \n\t\t\t\t\tAP_Man_UP_Z_Go := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_A.Done OR MOVP_A.Done THEN\n\t\t\t\t\texcute_run_L_Upz_A := FALSE; \n\t\t\t\t\tAP_Man_UP_Z_Go := FALSE;\n\t\t\t\t\tIF mode_Run_GoPosA_manual = 1 THEN\n\t\t\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 10;\n\t\t\t\t\tELSE\n\t\t\t\t\t\tIF mode_Run_GoPosA_manual = 2 THEN\n\t\t\t\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 2;\n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tIF mode_Run_GoPosA_manual = 3 THEN\n\t\t\t\t\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 6;\t \n\t\t\t\t\t\t\tEND_IF;\n\t\t\t\t\t\tEND_IF;\n\t\t\t\t\tEND_IF;\n\t\t\t    END_IF;\n\t\t\t22:\n\t\t\t\tPos_run_manual_A.c.X :=  GVL_1.DATA_RB_A.X_POS[GVL.DW_[10]];\n\t\t\t\tPos_run_manual_A.c.Y :=  GVL_1.DATA_RB_A.Y_POS[GVL.DW_[10]];\t\n\t\t\t\tPos_run_manual_A.c.Z :=  GVL.RB_A_.CUR_Z;\t\t\t\t\t \n\t\t\t\tPos_run_manual_A.c.A :=  GVL.RB_A_.CUR_R;\t\t  \n\t\t\t\tPRO_A[GVL.DW_[10]] := PRO_A[GVL.DW_[10]] + 2; \n\t\t\t24:\n\t\t\t\tIF Other_PosA THEN\n\t\t\t\t\tCASE GVL.DW_[11] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_A := TRUE; \n\t\t\t\t\t\t3:  AP_Man_UP_Z_Go := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_A_Pre := Pos_run_manual_A; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_A_.ERROR OR  NOT GVL.RB_A_.Ready THEN\n\t\t\t\t\tRuningPosA[GVL.DW_[10]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_A := FALSE; \n\t\t\t\t\tAP_Man_UP_Z_Go := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_A.Done OR MOVP_A.Done THEN\n\t\t\t\t\texcute_run_L_Upz_A := FALSE; \n\t\t\t\t\tAP