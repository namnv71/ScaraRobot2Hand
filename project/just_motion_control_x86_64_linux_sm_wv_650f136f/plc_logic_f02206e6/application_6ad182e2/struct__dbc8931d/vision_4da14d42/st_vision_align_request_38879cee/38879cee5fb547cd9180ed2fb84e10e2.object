{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)38879cee-5fb5-47cd-9180-ed2fb84e10e2","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_VISION_ALIGN_REQUEST","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)4da14d42-d241-4712-a403-b48098f8db54"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_VISION_ALIGN_REQUEST :\n\nSTRUCT\n\n    //=========================================================================\n\n    // COMMAND - dữ liệu Robot gửi sang Vision Manager\n\n    //=========================================================================\n\n    Execute : BOOL;                  // TRUE = Robot yêu cầu bắt đầu/duy trì transaction Vision.\n\n    CameraID : UINT;                 // Camera/Vision Channel cần sử dụng.\n\n    JobID : UINT;                    // Job Vision cần chạy trên Camera.\n\n\n    //=========================================================================\n\n    // STATUS - Vision Manager trả về cho Robot\n\n    //=========================================================================\n\n    Busy : BOOL;                     // TRUE = Request đã được Manager nhận và đang xử lý.\n\n    Done : BOOL;                     // TRUE = Transaction kết thúc bình thường, đã có business result.\n\n    Error : BOOL;                    // TRUE = Lỗi communication/protocol/configuration/timeout.\n\n    ErrorID : INT;                   // Mã lỗi Manager hoặc lỗi chuyển tiếp từ FB_VisionAlign.\n\n\n    //=========================================================================\n\n    // BUSINESS RESULT - kết quả dùng cho logic chương trình Robot\n\n    //=========================================================================\n\n    ResultOK : BOOL;                 // TRUE = VIS_RESULT_OK; FALSE = NG/NOT_FOUND/LOW_SCORE/...\n\n    ResultValid : BOOL;              // Cờ Valid của dữ liệu Vision.\n\n    ResultStatus : E_VisionResultStatus; // Trạng thái business result từ Vision.\n\n\n    //=========================================================================\n\n    // RESULT DATA - dữ liệu Vision đã chốt của transaction\n\n    //=========================================================================\n\n    TriggerID : UDINT;               // TriggerID của transaction vừa hoàn thành.\n\n    X : REAL;                        // Kết quả X.\n\n    Y : REAL;                        // Kết quả Y.\n\n    Z : REAL;                        // Kết quả Z.\n\n    A : REAL;                        // Kết quả góc A.\n\n    Score : REAL;                    // Điểm Score.\n\n    FeatureID : UINT;                // Feature/Object ID do Vision trả về.\n\nEND_STRUCT\n\nEND_TYPE","LineInfoPersistence":"(string)38879cee-5fb5-47cd-9180-ed2fb84e10e2_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)68"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}