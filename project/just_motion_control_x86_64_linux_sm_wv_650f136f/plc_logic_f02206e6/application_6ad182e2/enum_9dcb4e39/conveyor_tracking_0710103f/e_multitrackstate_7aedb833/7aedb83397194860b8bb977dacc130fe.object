{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7aedb833-9719-4860-b8bb-977dacc130fe","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_MultiTrackState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0710103f-fbdc-4582-87a9-dd50a9877f7d"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// ENUM: MULTI-TOOL TRACKING STATE\n//-----------------------------------------------------------------------------\n// State machine của FB_MultiToolTrackingApplication.\n//=============================================================================\n{attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_MultiTrackState :\n(\n    // Chờ lệnh mới.\n    IDLE := 0,\n\n    // Đọc Tracking Recipe.\n    LOAD_RECIPE := 10,\n\n    // Kiểm tra Tool/Recipe.\n    VALIDATE_TOOLS := 20,\n\n    // Chờ Object có trong Queue.\n    WAIT_OBJECT := 40,\n\n    // Chọn cặp Tool - Object.\n    SELECT_ASSIGNMENT := 50,\n\n    // Chọn TCP của Tool cho Robot.\n    SELECT_ROBOT_TOOL := 60,\n\n    // Phát lệnh cho Tracking Core.\n    START_TRACKING := 70,\n\n    // Chờ Tracking Core báo đồng bộ.\n    WAIT_SYNC := 80,\n\n    // Phát lệnh hạ Tool.\n    TOOL_DOWN := 90,\n\n    // Chờ Tool hạ xong.\n    WAIT_TOOL_DOWN := 100,\n\n    // Phát lệnh hút/kẹp.\n    TOOL_GRIP := 110,\n\n    // Chờ Grip OK.\n    WAIT_TOOL_GRIP := 120,\n\n    // Phát lệnh nâng Tool.\n    TOOL_UP := 130,\n\n    // Chờ Tool lên an toàn.\n    WAIT_TOOL_UP := 140,\n\n    // Yêu cầu Tracking Core thoát PCS.\n    RELEASE_TRACKING := 150,\n\n    // Lưu kết quả gắp.\n    STORE_RESULT := 160,\n\n    // Kiểm tra đã đủ số lượng chưa.\n    CHECK_COUNT := 170,\n\n    // Chu trình hoàn thành.\n    COMPLETE := 800,\n\n    // Đang Abort.\n    ABORTING := 850,\n\n    // Chu trình lỗi.\n    ERROR := 900\n);\nEND_TYPE\n","LineInfoPersistence":"(string)7aedb833-9719-4860-b8bb-977dacc130fe_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)71"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}