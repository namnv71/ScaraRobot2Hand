{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6af91042-f0af-4235-bb71-19783d41cc19","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_CalcTraySlotTarget","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)aeebc3c9-5980-4950-a4fc-d0255f8fa11f"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Mặc định trả lại Master; dữ liệu không hợp lệ thì không tính offset.\nF_CalcTraySlotTarget := MasterPos;\nIF SlotIndex = 0 OR RowCount = 0 OR ColumnCount = 0 THEN RETURN; END_IF;\n\n// Tính Row/Column từ SlotIndex.\nIF FillByRow THEN\n    uiRow := ((SlotIndex - 1) / ColumnCount) + 1;\n    uiCol := ((SlotIndex - 1) MOD ColumnCount) + 1;\nELSE\n    uiCol := ((SlotIndex - 1) / RowCount) + 1;\n    uiRow := ((SlotIndex - 1) MOD RowCount) + 1;\nEND_IF;\n\n// Slot vượt kích thước Tray thì giữ nguyên Master để caller tự báo lỗi.\nIF uiRow > RowCount OR uiCol > ColumnCount THEN RETURN; END_IF;\n\n// Quy ước local Tray: +X theo Column, +Y theo Row.\nrLocalX := UINT_TO_REAL(uiCol - 1) * ColumnPitchMM;\nrLocalY := UINT_TO_REAL(uiRow - 1) * RowPitchMM;\n\n// Rotate local offset theo góc A của Tray Master.\nrAngleRad := MasterPos.A * GVL.C_DEG_TO_RAD;\nrCosA := COS(rAngleRad);\nrSinA := SIN(rAngleRad);\n\nF_CalcTraySlotTarget.X := MasterPos.X + rLocalX * rCosA - rLocalY * rSinA;\nF_CalcTraySlotTarget.Y := MasterPos.Y + rLocalX * rSinA + rLocalY * rCosA;\nF_CalcTraySlotTarget.Z := MasterPos.Z;\nF_CalcTraySlotTarget.A := MasterPos.A;","LineInfoPersistence":"(string)6af91042-f0af-4235-bb71-19783d41cc19_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_CalcTraySlotTarget : ST_POS\nVAR_INPUT\n    MasterPos : ST_POS;\n    RowCount : UINT;\n    ColumnCount : UINT;\n    RowPitchMM : REAL;\n    ColumnPitchMM : REAL;\n    FillByRow : BOOL;\n    SlotIndex : UINT;\nEND_VAR\n\nVAR\n    uiRow : UINT;\n    uiCol : UINT;\n    rLocalX : REAL;\n    rLocalY : REAL;\n    rAngleRad : REAL;\n    rCosA : REAL;\n    rSinA : REAL;\nEND_VAR\n","LineInfoPersistence":"(string)6af91042-f0af-4235-bb71-19783d41cc19_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)50","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}