{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c42048f7-fb1f-4154-bcdd-a6b835e9a341","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_TRACKING_CONFIG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_TRACKING_CONFIG :\nSTRUCT\n    // TRUE: cho phép ứng dụng Conveyor Tracking hoạt động.\n    Enable : BOOL;\n\n    // Cách chọn object trong Queue.\n    //SelectMode : E_TrackingSelectMode;\n\n    // Cấu hình toàn bộ I/O của ứng dụng.\n    IO : ST_TRACKING_IO_CONFIG;\n\n    // Cấu hình vùng làm việc trên conveyor.\n    Workspace : ST_TRACKING_WORKSPACE_CONFIG;\n\n    // Cấu hình động học cho từng pha chuyển động.\n    Motion : ST_TRACKING_MOTION_CONFIG;\n\n    // Offset TCP so với tâm object trong PCS.\n    PickOffset : ST_POS;\n\n    // Độ cao approach cộng thêm vào PickOffset.Z.\n    ApproachHeight : REAL;\n\n    // Độ cao retract cộng thêm vào PickOffset.Z.\n    RetractHeight : REAL;\n\n    // Điểm rời vùng conveyor trong hệ robot/base.\n    LeavePos : ST_POS;\n\n    // Điểm đặt sản phẩm trong hệ robot/base.\n    PlacePos : ST_POS;\n\n    // Thời gian chờ sau khi bật hút trước khi kiểm tra VacuumOK.\n    PickDelay : TIME;\n\n    // Thời gian tối đa chờ VacuumOK.\n    VacuumTimeout : TIME;\n\n    // Số lần thử hút tối đa.\n    MaxPickAttempts : UINT;\n\n    // Thời gian bật van thổi khi nhả sản phẩm.\n    BlowTime : TIME;\n\n    // TRUE: sử dụng tín hiệu mô phỏng thay cho I/O thật.\n    SimulationMode : BOOL;\n\n    // Tín hiệu VacuumOK mô phỏng.\n    SimulationVacuumOK : BOOL;\n\t// Thuật toán Scheduler dùng để chọn object.\n    SelectMode : E_TrackingSelectMode;\n\n    // ObjectID cụ thể khi SelectMode = TRACK_SELECT_SPECIFIC_ID.\n    SpecificObjectID : UDINT;\n\n    // Priority mặc định khi Vision/Application không gán.\n    DefaultObjectPriority : UINT;\n\n    // Thời gian gắp ước tính mặc định, đơn vị giây.\n    DefaultEstimatedPickTimeSec : REAL;\n\n    // Điểm Vision tối thiểu để object được phép tham gia Scheduler.\n    MinimumVisionScore : REAL;\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)c42048f7-fb1f-4154-bcdd-a6b835e9a341_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)65"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}