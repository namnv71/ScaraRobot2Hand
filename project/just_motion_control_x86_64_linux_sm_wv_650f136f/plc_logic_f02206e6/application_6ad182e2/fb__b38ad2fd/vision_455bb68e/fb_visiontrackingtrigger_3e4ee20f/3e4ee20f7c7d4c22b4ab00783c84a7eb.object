{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)3e4ee20f-7c7d-4c22-b4ab-00783c84a7eb","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionTrackingTrigger","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)455bb68e-496e-4125-829d-ed46387b0a41"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DEFAULT OUTPUT\n//=============================================================================\nTriggerExecute := WaitingAccepted;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF Reset OR NOT Enable THEN\n    Active := FALSE;\n    TriggerExecute := FALSE;\n    WaitingAccepted := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n    xRequestPending := FALSE;\n    xHasLastTrigger := FALSE;\n    lrLastTriggerPositionMM := ConveyorPositionMM;\n\tWaitingResult := FALSE;\n    RETURN;\nEND_IF;\n\nActive := TRUE;\n\n\n//=============================================================================\n// VALIDATE CONFIG\n//=============================================================================\nIF Config.TriggerPitchMM <= 0.0 THEN\n    Error := TRUE;\n    ErrorID := 9241;                        // TriggerPitchMM không hợp lệ.\n    RETURN;\nEND_IF;\n\nError := FALSE;\nErrorID := 0;\n\n\n//=============================================================================\n// TẠO YÊU CẦU TRIGGER THEO QUÃNG ĐƯỜNG CONVEYOR\n//-----------------------------------------------------------------------------\n// Không tạo request mới khi command trước vẫn chưa được Vision nhận.\n//=============================================================================\n//IF Config.AutoTrigger AND NOT xRequestPending AND NOT WaitingAccepted THEN\nIF Config.AutoTrigger AND NOT xRequestPending AND NOT WaitingAccepted AND NOT WaitingResult THEN\n    // Nếu không bắt buộc Conveyor chạy thì bỏ qua kiểm tra Velocity.\n    IF NOT Config.TriggerOnlyWhenMoving OR ABS(ConveyorVelocityMMs) >= Config.MinimumTriggerVelocityMMs THEN\n\n        // Lần đầu khi session vừa bật: cho phép trigger ngay khi Camera Ready.\n        IF NOT xHasLastTrigger THEN\n            xRequestPending := TRUE;\n\n        // Các lần tiếp theo: chỉ trigger khi Conveyor đã đi đủ TriggerPitchMM.\n        ELSIF ABS(ConveyorPositionMM - lrLastTriggerPositionMM) >= REAL_TO_LREAL(Config.TriggerPitchMM) THEN\n            xRequestPending := TRUE;\n        END_IF;\n\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// PHÁT COMMAND MỚI\n//-----------------------------------------------------------------------------\n// TriggerID và CaptureConveyorPositionMM được chốt cùng một thời điểm.\n//=============================================================================\nIF xRequestPending AND VisionReady AND NOT VisionBusy AND NOT WaitingAccepted AND NOT WaitingResult THEN\n\n    udiNextTriggerID := udiNextTriggerID + 1;\n    IF udiNextTriggerID = 0 THEN udiNextTriggerID := 1; END_IF;\n\n    TriggerID := udiNextTriggerID;\n    CaptureConveyorPositionMM := ConveyorPositionMM;\n\n    WaitingAccepted := TRUE;\n    TriggerExecute := TRUE;\nEND_IF;\n\n\n//=============================================================================\n// VISION ĐÃ NHẬN COMMAND\n//-----------------------------------------------------------------------------\n// Chỉ khi command được nhận mới cập nhật vị trí trigger gần nhất.\n// Nếu communication chậm, Execute tiếp tục được giữ TRUE qua nhiều scan.\n//=============================================================================\nIF WaitingAccepted AND CommandAccepted THEN\n    WaitingAccepted := FALSE;\n\tWaitingResult := TRUE;\n    TriggerExecute := FALSE;\n    xRequestPending := FALSE;\n    lrLastTriggerPositionMM := CaptureConveyorPositionMM;\n    xHasLastTrigger := TRUE;\nEND_IF;\n\n//=============================================================================\n// RESULT CỦA TRIGGER HIỆN TẠI ĐÃ ĐƯỢC OBJECT SOURCE XỬ LÝ\n//=============================================================================\nIF WaitingResult AND TriggerID <> 0 AND ResultProcessedTriggerID = TriggerID THEN\n\n    WaitingResult := FALSE;\n\nEND_IF;","LineInfoPersistence":"(string)3e4ee20f-7c7d-4c22-b4ab-00783c84a7eb_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionTrackingTrigger\nVAR_INPUT\n    Enable : BOOL;                          // TRUE khi Tracking session cần Source này.\n    Reset : BOOL;                           // Reset runtime trigger.\n    Config : ST_VisionTrackingSourceConfig; // Cấu hình Source.\n\n    ConveyorPositionMM : LREAL;             // Vị trí Conveyor hiện tại.\n    ConveyorVelocityMMs : REAL;             // Tốc độ Conveyor hiện tại.\n\n    VisionReady : BOOL;                     // Camera/Channel sẵn sàng nhận command.\n    VisionBusy : BOOL;                      // Camera đang xử lý command trước.\n\n    // TRUE khi tầng Vision framework đã nhận đúng TriggerID hiện tại.\n    // Trong project hiện tại có thể nối bằng:\n    // GVL.g_aVisionStatus[CameraID].CurrentTriggerID = TriggerID.\n    CommandAccepted : BOOL;\n\tResultProcessedTriggerID : UDINT;   // TriggerID cuối đã được VisionObjectSource xử lý.\nEND_VAR\n\nVAR_OUTPUT\n    TriggerExecute : BOOL;                  // Giữ TRUE tới khi CommandAccepted.\n    TriggerID : UDINT;                      // ID transaction đang phát.\n    CaptureConveyorPositionMM : LREAL;      // Encoder được chốt cùng TriggerID.\n    Active : BOOL;                          // FB đang được Enable.\n    WaitingAccepted : BOOL;                 // Đang chờ Vision nhận command.\n    Error : BOOL;\n    ErrorID : UDINT;\n\tWaitingResult : BOOL;               // Đang chờ Result của Trigger hiện tại.\nEND_VAR\n\nVAR\n    lrLastTriggerPositionMM : LREAL;         // Encoder của lần trigger đã được nhận gần nhất.\n    xHasLastTrigger : BOOL;                  // FALSE khi chưa có trigger nào trong session.\n    xRequestPending : BOOL;                  // Đã đủ điều kiện khoảng cách và đang chờ Camera Ready.\n    udiNextTriggerID : UDINT;                // Bộ đếm TriggerID nội bộ Source.\nEND_VAR\n\n\n","LineInfoPersistence":"(string)3e4ee20f-7c7d-4c22-b4ab-00783c84a7eb_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)142","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}