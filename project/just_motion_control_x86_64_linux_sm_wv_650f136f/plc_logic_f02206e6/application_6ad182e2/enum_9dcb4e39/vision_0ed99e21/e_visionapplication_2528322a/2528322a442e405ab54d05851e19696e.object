{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)2528322a-442e-405a-b54d-05851e19696e","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_VisionApplication","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0ed99e21-df83-4e0b-b4be-748f7400c92e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_VisionApplication :\n(\n    VIS_APP_NONE := 0,                    // Chưa chọn ứng dụng vision.\n\n    VIS_APP_ALIGN := 10,                  // Tìm độ lệch X/Y/Z/A để căn chỉnh sản phẩm.\n    VIS_APP_INSPECTION := 20,             // Kiểm tra ngoại quan và trả kết quả OK/NG.\n    VIS_APP_SINGLE_POINT := 30,           // Tìm và trả về một tọa độ duy nhất.\n    VIS_APP_POINT_LIST := 40,             // Trả về danh sách nhiều tọa độ.\n    VIS_APP_GLUE_PATH := 50,              // Trả về đường chạy phục vụ bôi keo.\n    VIS_APP_PICK_POSITION := 60,           // Tìm tọa độ gắp sản phẩm tĩnh.\n    VIS_APP_CONVEYOR_PICK := 70,           // Tìm sản phẩm đang chạy trên conveyor để gắp.\n    VIS_APP_CONVEYOR_INSPECTION := 80,     // Kiểm tra sản phẩm khi đang chạy trên conveyor.\n    VIS_APP_CONVEYOR_GLUE := 90,           // Trả đường keo của sản phẩm đang chạy.\n    VIS_APP_CALIBRATION := 100             // Job dùng để kiểm tra hoặc thực hiện calibration.\n);\nEND_TYPE\n","LineInfoPersistence":"(string)2528322a-442e-405a-b54d-05851e19696e_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)19"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}