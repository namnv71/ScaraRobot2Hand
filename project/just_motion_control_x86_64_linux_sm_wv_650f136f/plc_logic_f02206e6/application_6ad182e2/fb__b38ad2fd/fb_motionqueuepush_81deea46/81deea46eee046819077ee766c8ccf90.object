{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)81deea46-eee0-4681-9077-ee766c8ccf90","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_MotionQueuePush","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ExecuteRise := Execute AND NOT ExecuteOld; // Tao xung canh len \n// ExecuteOld := Execute;\n// \n// Done := FALSE;\n// Error := FALSE;\n// \n// IF ExecuteRise THEN\n//     IF GVL.A_MotionCount >= 20 THEN // Kiểm tra Queue đầy chưa\n//         Error := TRUE;\n//     ELSE\n//         GVL.A_MotionQueue[GVL.A_MotionTail] := Item; // Ghi du lieu vao Queue\n// \n//         GVL.A_MotionTail := GVL.A_MotionTail + 1; // Dich vi tri ghi du lieu\n//         IF GVL.A_MotionTail > 20 THEN  // Queue vong tron\n//             GVL.A_MotionTail := 1;\n//         END_IF;\n// \n//         GVL.A_MotionCount := GVL.A_MotionCount + 1; // Tang so luong Item trong Queue\n//         Done := TRUE;  //Push thanh cong\n//     END_IF;\n// END_IF;\n\n//====================================================\n// FB_MotionQueuePush\n// Execute = TRUE  -> Push đúng 1 lần\n// Done/Error giữ đến khi Execute = FALSE\n//====================================================\n\nIF NOT Execute THEN\n\n    Done := FALSE;\n    Error := FALSE;\n    Busy := FALSE;\n\nELSE\n\n    IF NOT Busy THEN\n\n        Busy := TRUE;\n\n        IF GVL.A_MotionCount >= 20 THEN\n\n            Error := TRUE;\n            Done := FALSE;\n\n        ELSE\n\n            GVL.A_MotionQueue[GVL.A_MotionTail] := Item;\n\n            GVL.A_MotionTail := GVL.A_MotionTail + 1;\n\n            IF GVL.A_MotionTail > 20 THEN\n                GVL.A_MotionTail := 1;\n            END_IF;\n\n            GVL.A_MotionCount := GVL.A_MotionCount + 1;\n\n            Done := TRUE;\n            Error := FALSE;\n\n        END_IF;\n\n    END_IF;\n\nEND_IF;","LineInfoPersistence":"(string)81deea46-eee0-4681-9077-ee766c8ccf90_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_MotionQueuePush\nVAR_INPUT\n\tItem : ST_MotionQueueItem;\n    Execute : BOOL;\nEND_VAR\nVAR_OUTPUT\n\tDone : BOOL;\n    Error : BOOL;\n\tBusy  : BOOL;\nEND_VAR\nVAR\n\tExecuteOld  : BOOL;\n\tExecuteRise : BOOL;\nEND_VAR\n","LineInfoPersistence":"(string)81deea46-eee0-4681-9077-ee766c8ccf90_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)80","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}