{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7e003c54-fc10-45cb-aee7-3cbcd92b7e7e","ParentGuid":"(Guid)c00f9ee8-970d-4983-83b8-3aaea5126e60","Name":"(string)ACT_LOGIC","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ROBOT 1\nIF GVL.RB_A.Power AND NOT SMC_GroupPower_1.Status AND NOT SMC_GroupPower_1.Busy THEN // POWER ROBOT 1\n\tCASE CASE_A_ON OF\n\t0:\n\t\tSMC_GroupPower_1.Enable := 0;\n\t\tSMC_GroupPower_1.bDriveStart := 0;\n\t\tSMC_GroupPower_1.bRegulatorOn := 0;\n\t\tCASE_A_ON := 5;\n\t\t\n\t5:\n\t\tSMC_GroupPower_1.Enable := 1;\n\t\tSMC_GroupPower_1.bDriveStart := 1;\n\t\tSMC_GroupPower_1.bRegulatorOn := 1;\n\n\t\n\tEND_CASE\nELSIF NOT GVL.RB_A.Power AND SMC_GroupPower_1.Status AND NOT SMC_GroupPower_1.Busy THEN\n\t\tCASE CASE_A_OFF OF\n\t0:\n\t\tSMC_GroupPower_1.Enable := 0;\n\t\tSMC_GroupPower_1.bDriveStart := 0;\n\t\tSMC_GroupPower_1.bRegulatorOn := 0;\n\t\tCASE_A_OFF := 5;\n\t\t\n\t5:\n\t\tSMC_GroupPower_1.Enable := 1;\n\t\tSMC_GroupPower_1.bDriveStart := 0;\n\t\tSMC_GroupPower_1.bRegulatorOn := 1;\n\tEND_CASE\nELSE\n\tCASE_A_ON := 0;\n\tCASE_A_OFF := 0;\n\tSMC_GroupPower_1.Enable := 0;\n\tSMC_GroupPower_1.bDriveStart := 0;\n\tSMC_GroupPower_1.bRegulatorOn := 0;;\nEND_IF\n\n\n\nIF GVL.RB_A.Enable AND RB_A_POWER_ON THEN // ENABLE ROBOT 1\n\tMC_GroupEnable_1.Execute := 1;\n\tMC_GroupDisable_1.Execute := 0;\n\tELSE\n\tMC_GroupEnable_1.Execute := 0;\n\tMC_GroupDisable_1.Execute := 1;\nEND_IF\n\nIF NOT GVL.RB_Signal_In.HMI_EMG THEN\n\tMC_GroupEnable_1.Execute := 0;\n\tMC_GroupDisable_1.Execute := 1;\n\tGVL.RB_A.Power := 0;\n\tGVL.RB_A.Enable := 0;\nEND_IF\nIF GVL.RB_A.BK1 THEN // A0 BRAKE\n\tSMC3_BrakeControl_A0.bExecute := 1;\n\tSMC3_BrakeControl_A0.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_A0.bExecute := 0;\n\tSMC3_BrakeControl_A0.eSetBrake := 0;\nEND_IF\nIF GVL.RB_A.BK2 THEN // A1 BRAKE\n\tSMC3_BrakeControl_A1.bExecute := 1;\n\tSMC3_BrakeControl_A1.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_A1.bExecute := 0;\n\tSMC3_BrakeControl_A1.eSetBrake := 0;\nEND_IF\nIF GVL.RB_A.BK3 THEN // A2 BRAKE\n\tSMC3_BrakeControl_A2.bExecute := 1;\n\tSMC3_BrakeControl_A2.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_A2.bExecute := 0;\n\tSMC3_BrakeControl_A2.eSetBrake := 0;\nEND_IF\nIF GVL.RB_A.BK4 THEN // A3 BRAKE\n\tSMC3_BrakeControl_A3.bExecute := 1;\n\tSMC3_BrakeControl_A3.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_A3.bExecute := 0;\n\tSMC3_BrakeControl_A3.eSetBrake := 0;\nEND_IF\n\n///////////////////////////////////////////////////////////////////////////////////////////////////////////\n\n// ROBOT 2\nIF GVL.RB_B.Power AND NOT SMC_GroupPower_2.Status AND NOT SMC_GroupPower_2.Busy THEN // POWER ROBOT 2\n\tCASE CASE_B_ON OF\n\t0:\n\t\tSMC_GroupPower_2.Enable := 0;\n\t\tSMC_GroupPower_2.bDriveStart := 0;\n\t\tSMC_GroupPower_2.bRegulatorOn := 0;\n\t\tCASE_B_ON := 5;\n\t\t\n\t5:\n\t\tSMC_GroupPower_2.Enable := 1;\n\t\tSMC_GroupPower_2.bDriveStart := 1;\n\t\tSMC_GroupPower_2.bRegulatorOn := 1;\n\tEND_CASE\nELSIF NOT GVL.RB_B.Power AND SMC_GroupPower_2.Status AND NOT SMC_GroupPower_2.Busy THEN\n\t\tCASE CASE_B_OFF OF\n\t0:\n\t\tSMC_GroupPower_2.Enable := 0;\n\t\tSMC_GroupPower_2.bDriveStart := 0;\n\t\tSMC_GroupPower_2.bRegulatorOn := 0;\n\t\tCASE_b_OFF := 5;\n\t\t\n\t5:\n\t\tSMC_GroupPower_2.Enable := 1;\n\t\tSMC_GroupPower_2.bDriveStart := 0;\n\t\tSMC_GroupPower_2.bRegulatorOn := 1;\n\tEND_CASE\nELSE\n\tCASE_b_ON := 0;\n\tCASE_b_OFF := 0;\n\tSMC_GroupPower_2.Enable := 0;\n\tSMC_GroupPower_2.bDriveStart := 0;\n\tSMC_GroupPower_2.bRegulatorOn := 0;;\nEND_IF\nIF RB_B_POWER_ON AND GVL.RB_B.Enable THEN // ENABLE ROBOT 2\n\tMC_GroupEnable_2.Execute := 1;\n\tMC_GroupDisable_2.Execute := 0;\n\tELSE\n\tMC_GroupEnable_2.Execute := 0;\n\tMC_GroupDisable_2.Execute := 1;\nEND_IF\n\nIF NOT GVL.RB_Signal_In.HMI_EMG THEN\n\tMC_GroupEnable_2.Execute := 0;\n\tMC_GroupDisable_2.Execute := 1;\n\tGVL.RB_B.Power := 0;\n\tGVL.RB_B.Enable := 0;\nEND_IF\n\nIF GVL.RB_B.BK1 THEN // B0 BRAKE\n\tSMC3_BrakeControl_B0.bExecute := 1;\n\tSMC3_BrakeControl_B0.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_B0.bExecute := 0;\n\tSMC3_BrakeControl_B0.eSetBrake := 0;\nEND_IF\nIF GVL.RB_B.BK2 THEN // B1 BRAKE\n\tSMC3_BrakeControl_B1.bExecute := 1;\n\tSMC3_BrakeControl_B1.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_B1.bExecute := 0;\n\tSMC3_BrakeControl_B1.eSetBrake := 0;\nEND_IF\nIF GVL.RB_B.BK3 THEN // B2 BRAKE\n\tSMC3_BrakeControl_B2.bExecute := 1;\n\tSMC3_BrakeControl_B2.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_B2.bExecute := 0;\n\tSMC3_BrakeControl_B2.eSetBrake := 0;\nEND_IF\nIF GVL.RB_B.BK4 THEN // B3 BRAKE\n\tSMC3_BrakeControl_B3.bExecute := 1;\n\tSMC3_BrakeControl_B3.eSetBrake := 1;\n\tELSE\n\tSMC3_BrakeControl_B3.bExecute := 0;\n\tSMC3_BrakeControl_B3.eSetBrake := 0;\nEND_IF\n\n///////////////////////////////////////////////////////////////////////////////////////////////////////////\n\n// R_MAIN\n// IF GVL.M_R.Power THEN // POWER R MAIN\n// \tMC_Power_R.Enable := 1;\n// \tMC_Power_R.bDriveStart := 1;\n// \tMC_Power_R.bRegulatorOn := 1;\n// \tELSE\n// \tMC_Power_R.Enable := 0;\n// \tMC_Power_R.bDriveStart := 0;\n// \tMC_Power_R.bRegulatorOn := 0;\t\n// END_IF\n// IF GVL.M_R.Power AND NOT MC_Power_R.Status AND NOT MC_Power_R.Busy THEN // POWER ROBOT 1\n// \tCASE CASE_R_ON OF\n// \t0:\n// \t\tMC_Power_R.Enable := 0;\n// \t\tMC_Power_R.bDriveStart := 0;\n// \t\tMC_Power_R.bRegulatorOn := 0;\n// \t\tCASE_R_ON := 5;\n// \t\t\n// \t5:\n// \t\tMC_Power_R.Enable := 1;\n// \t\tMC_Power_R.bDriveStart := 1;\n// \t\tMC_Power_R.bRegulatorOn := 1;\n// \n// \t\n// \tEND_CASE\n// ELSIF NOT GVL.M_R.Power AND MC_Power_R.Status AND NOT MC_Power_R.Busy THEN\n// \t\tCASE CASE_R_OFF OF\n// \t0:\n// \t\tMC_Power_R.Enable := 0;\n// \t\tMC_Power_R.bDriveStart := 0;\n// \t\tMC_Power_R.bRegulatorOn := 0;\n// \t\tCASE_R_OFF := 5;\n// \t\t\n// \t5:\n// \t\tMC_Power_R.Enable := 1;\n// \t\tMC_Power_R.bDriveStart := 0;\n// \t\tMC_Power_R.bRegulatorOn := 1;\n// \tEND_CASE\n// ELSE\n// \tCASE_R_ON := 0;\n// \tCASE_R_OFF := 0;\n// \tMC_Power_R.Enable := 0;\n// \tMC_Power_R.bDriveStart := 0;\n// \tMC_Power_R.bRegulatorOn := 0;;\n// END_IF","LineInfoPersistence":"(string)7e003c54-fc10-45cb-aee7-3cbcd92b7e7e_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)209"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}