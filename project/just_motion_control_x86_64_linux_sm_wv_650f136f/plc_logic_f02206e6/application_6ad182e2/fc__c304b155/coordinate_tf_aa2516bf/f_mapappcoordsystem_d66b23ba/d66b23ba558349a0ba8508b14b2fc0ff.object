{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d66b23ba-5583-49a0-ba85-08b14b2fc0ff","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_MapAppCoordSystem","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)aa2516bf-a5ab-467f-99fc-3840db715fed"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// F_MapAppCoordSystem\n//-----------------------------------------------------------------------------\n// Chuyển hệ tọa độ của Application sang hệ tọa độ SoftMotion.\n//=============================================================================\n\nCASE Coord OF\n\n    // Robot Base phải ánh xạ sang MCS.\n    E_AppCoordSystem.APP_COORD_ROBOT_BASE:\n        F_MapAppCoordSystem := SMC_COORD_SYSTEM.MCS;\n\n    // Conveyor Tracking số 1.\n    E_AppCoordSystem.APP_COORD_PCS1:\n        F_MapAppCoordSystem := SMC_COORD_SYSTEM.PCS_1;\n\n    // Nếu có PCS_2.\n    E_AppCoordSystem.APP_COORD_PCS2:\n        F_MapAppCoordSystem := SMC_COORD_SYSTEM.PCS_2;\n\n    ELSE\n        // Không nên mặc định về PCS_1.\n        // Khi không xác định, dùng Robot Base an toàn hơn.\n        F_MapAppCoordSystem := SMC_COORD_SYSTEM.MCS;\n\nEND_CASE;","LineInfoPersistence":"(string)d66b23ba-5583-49a0-ba85-08b14b2fc0ff_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_MapAppCoordSystem : SMC_COORD_SYSTEM\nVAR_INPUT\n    Coord : E_AppCoordSystem;\nEND_VAR\n\n","LineInfoPersistence":"(string)d66b23ba-5583-49a0-ba85-08b14b2fc0ff_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)32","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}