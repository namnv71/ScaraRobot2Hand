{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)698f130d-bc21-47c9-a998-5b9eee397a8b","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)Pro_MC1_4_","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)T_MC1_4( PT := T#3S, Q =>, ET =>);\nton_centering (PT := T#1S, Q =>, ET =>);\nTon_OK_MC1_4( PT := T#10S);\nTon_Limit_Test_TS(PT := T#50S);\nCASE Pro_MC1_4 OF\n\t\t0: // Check Data\n\t\t\tT_MC1_4.IN := FALSE;\n\t\t\tton_centering.IN := FALSE;\n\t\t\tTon_OK_MC1_4.IN := FALSE;\n\t\t\tTon_Limit_Test_TS.IN := FALSE;\n\t\t\t//GVL.Pro4_.Process.DATA_MC_TS := 0;\n\t\t\ton_centering := 0;\n\t\t\tPro_MC1_4 := 5;\n\t\t\t\n\t\t5:\n\t\t\tT_MC1_4.IN := FALSE;\n\t\t\tCASE GVL.Pro4_.Process.DATA_MC_TS OF\n\t\t\t\t0 : // None\n\t\t\t\t\tPro_MC1_4 := 10;\n\t\t\t\t1: // Busy - checking\n\t\t\t\t\tPro_MC1_4 := 20;\n\t\t\t\t2: // Allow Place\n\t\t\t\t\tPro_MC1_4 := 30;\n\t\t\t\t3: // Allow Pick OK\n\t\t\t\t\tPro_MC1_4 := 40;\n\t\t\t\t4: // Allow Pick NG\n\t\t\t\t\tPro_MC1_4 := 50;\n\t\t\tEND_CASE;\n\t\t10: // init - Stop - cylinder press UP\n\t\t\t//IF GVL.X[24] AND NOT GVL.X[25] THEN\n\t\t\tIF  GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q  THEN\n\t\t\t\tT_MC1_4.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 2 ; // allow place\n\t\t\t\tPro_MC1_4 := 5;\n\t\t\tEND_IF;\n\t\t20: // Checking\n\t\t\tCASE on_centering OF\n\t\t\t\t0 : \n\t\t\t\t\tGVL.Pro4_.Auto.centering_ts_On_Off  := TRUE;\n\t\t\t\t\ton_centering := on_centering + 10;\n\t\t\t\t10: \n\t\t\t\t\tton_centering.IN := TRUE;\n\t\t\t\t\tIF (ton_centering.Q ) THEN\n\t\t\t\t\t\ton_centering := on_centering + 10;\n\t\t\t\t\t\tTon_Limit_Test_TS.IN := TRUE;\n\t\t\t\t\tEND_IF\n\t\t\t\t20:\n\t\t\t\t\tGVL.Pro4_.Auto.centering_ts_On_Off  := FALSE;\n\t\t\tEND_CASE\n\t\t\tIF on_centering = 20 AND (GVL.Pro4_.ST_MC.Mode_Dry OR GVL.Pro4_.ST_MC.Mode_Auto_Pass_TS OR GVL.Pro4_.ST_MC.Mode_ByPass_TS) THEN\n\t\t\t\tTon_OK_MC1_4.IN := TRUE;\n\t\t\t\t\n\t\t\tEND_IF\n\t\t\t// namnv - Them dieu kien tat tin hieu start may test song\n\t\t\tIF  NOT GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q THEN\n\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE;\n\t\t\tEND_IF\n\t\t\t\n\t\t\t//IF  T_MC1.q AND DATA_A_T1 = 0 AND GVL.X[24] AND ( GVL.X[21] OR GVL.X[22]) THEN\n\t\t\tIF  on_centering = 20 AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q AND ( GVL.Pro4_.Signal_In.T_Ts_Pass.Q) AND (NOT GVL.Pro4_.ST_MC.Mode_Dry) AND (NOT GVL.Pro4_.ST_MC.Mode_ByPass_TS) THEN\n\t\t\t\t//GVL.Pro4_.Auto.centering_ts_On_Off  := TRUE;\n\t\t\t\tton_centering.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 3 ;\n\t\t\t\t//GVL.Pro4_.Process.DATA_MC_TS := 4 ; // namnv\n\t\t\t\ton_centering := 0;\n\t\t\t\tPro_MC1_4 := 5;\n\t\t\t\t//namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_1 := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out_1 := TRUE;\n\t\t\t\t\n\t\t\t\t\n\t\t\tELSIF  on_centering = 20 AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q  AND GVL.Pro4_.Signal_In.T_Ts_Fail.Q AND (NOT GVL.Pro4_.ST_MC.Mode_Dry) AND (NOT GVL.Pro4_.ST_MC.Mode_ByPass_TS) THEN\n\t\t\t\t//GVL.Pro4_.Auto.centering_ts_On_Off  := TRUE;\n\t\t\t\tton_centering.IN := FALSE;\n\t\t\t\t\n\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE;\n\t\t\t\tIF (GVL.Pro4_.ST_MC.Mode_Auto_Pass_TS) THEN\n\t\t\t\t\tIF (Ton_OK_MC1_4.Q) THEN\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 3;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 4;\n\t\t\t\tEND_IF\n\t\t\t\t\n\t\t\t\ton_centering := 0;\n\t\t\t\t\n\t\t\t\tPro_MC1_4 := 5;\t\n\t\t\t\t//namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_1 := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out_1 := TRUE;\n\t\t\tELSIF on_centering = 20 AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q AND (GVL.Pro4_.ST_MC.Mode_Dry OR GVL.Pro4_.ST_MC.Mode_ByPass_TS) AND Ton_OK_MC1_4.Q THEN\n\t\t\t\tton_centering.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE;\n\t\t\t\tIF (Ton_OK_MC1_4.Q AND (GVL.Pro4_.ST_MC.Mode_Auto_Pass_TS OR GVL.Pro4_.ST_MC.Mode_ByPass_TS)) THEN\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 3;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 4;\n\t\t\t\tEND_IF; // namnv1504\n\t\t\t\ton_centering := 0;\n\t\t\t\tPro_MC1_4 := 5;\t\n\t\t\tEND_IF\t\t\n\t\t\t\n\t\n\t\t30: // Place\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_B1_IN = 0 AND Place_B4_Finish THEN\n\t\t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Dry AND NOT GVL.Pro4_.ST_MC.Mode_ByPass_TS) THEN\n\t\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := TRUE;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.Pro4_.Auto.TS_On_Off := FALSE; //namnv1504\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.Pro4_.Auto.centering_ts_On_Off  := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 1 ;\n\t\t\t\tPro_MC1_4 := 5;\n\t\t\t\t//namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_1 := TRUE;\n\t\t\t\tMonitor_Production.Pulse_Out_1 := FALSE;\n\t\t\tEND_IF\n\t\t40:\t// Pick OK\n\t\t\t\tGVL.Pro4_.Auto.centering_ts_On_Off  := FALSE;\n\t\t\t//IF GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 AND Pick_A4_T1_Finish THEN\n\t\t\t// namnv\n\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN = 2 OR GVL.Pro4_.Process.DATA_TOOL_A1_IN = 1)  AND Pick_A4_T1_Finish THEN\n\t\t\t\tTon_OK_MC1_4.IN := FALSE;\n\t\t\t\tTon_Limit_Test_TS.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 0;\t\t\t\n\t\t\t\tPro_MC1_4  := 5;\n\t\t\tEND_IF\t\n\t\t50:\t// Pick NG\n\t\t\tGVL.Pro4_.Auto.centering_ts_On_Off  := FALSE;\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A1_IN = 3 AND Pick_A4_T1_Finish THEN\n\t\t\t\tTon_OK_MC1_4.IN := FALSE;\n\t\t\t\tTon_Limit_Test_TS.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_TS := 0;\n\t\t\t\tPro_MC1_4  := 5;\n\t\t\t\t\n\t\t\tEND_IF\t\t\n\tEND_CASE","LineInfoPersistence":"(string)698f130d-bc21-47c9-a998-5b9eee397a8b_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)139"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}