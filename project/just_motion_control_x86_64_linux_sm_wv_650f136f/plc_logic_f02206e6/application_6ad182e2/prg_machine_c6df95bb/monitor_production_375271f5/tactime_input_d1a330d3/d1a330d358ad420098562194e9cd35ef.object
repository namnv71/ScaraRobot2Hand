{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d1a330d3-58ad-4200-9856-2194e9cd35ef","ParentGuid":"(Guid)375271f5-d5cb-47c6-987f-89a997b63457","Name":"(string)Tactime_Input","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Pulse_In := POU_MOTION.Place_B4_Finish;\n// T1(IN := POU_MOTION.RUN_PROJECT, PT := T#1H);   // chạy free-run (1h cho khỏi overflow sớm)\n// \n// // lấy thời gian đã trôi qua\n//     Tact_ms := TO_DWORD(T1.ET)/100;\n// IF (Pulse_In = TRUE) AND (Pulse_Old = FALSE) THEN\n// \t\n// \n// \n//     // reset timer để đo lần tiếp theo\n//     T1(IN := FALSE);\n//     T1(IN := TRUE);\n// \n//     // ===== DỊCH MẢNG =====\n//     FOR i_tactime_input := 9 TO 1 BY -1 DO\n//         Tact_Array[i_tactime_input] := Tact_Array[i_tactime_input-1];\n//     END_FOR\n// \n//     // ===== GHI GIÁ TRỊ MỚI NHẤT =====\n//     Tact_Array[0] := TO_WORD(Tact_ms);\n// \n//     // đếm số mẫu\n//     IF Count < 10 THEN\n//         Count := Count + 1;\n//     END_IF\n// \n// END_IF\n// \n// Pulse_Old := Pulse_In;\n\n//namnv1104\n\n// Pulse_In := POU_MOTION.Place_B4_Finish;\n// Pulse_Out := POU_MOTION.Place_B4_Finish;\nT1(PT := T#1H);   // chạy free-run (1h cho khỏi overflow sớm)\nIF Pulse_In THEN\n\tT1.IN := TRUE;\nEND_IF\n// lấy thời gian đã trôi qua\nTact_ms := TO_DWORD(T1.ET)/100;\nIF (Pulse_Out = TRUE) AND (Pulse_In = FALSE) AND (Pulse_Old = FALSE) THEN\n\t\n\t\n\n    // reset timer để đo lần tiếp theo\n    T1(IN := FALSE);\n    //T1(IN := TRUE);\n\n    // ===== DỊCH MẢNG =====\n    FOR i_tactime_input := 9 TO 1 BY -1 DO\n        Tact_Array[i_tactime_input] := Tact_Array[i_tactime_input-1];\n    END_FOR\n\n    // ===== GHI GIÁ TRỊ MỚI NHẤT =====\n    Tact_Array[0] := TO_WORD(Tact_ms);\n\n    // đếm số mẫu\n    IF Count < 10 THEN\n        Count := Count + 1;\n    END_IF\nEND_IF\n\nPulse_Old := Pulse_Out;\n\n\n/// Avg tactime\nSum_Tact := 0;\n\nFOR i_tactime_input := 0 TO Count - 1 DO\n    Sum_Tact := Sum_Tact + Tact_Array[i_tactime_input];\nEND_FOR\n\nIF Count > 0 THEN\n    Avg_Tact := Sum_Tact / Count;\nEND_IF","LineInfoPersistence":"(string)d1a330d3-58ad-4200-9856-2194e9cd35ef_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)75"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}