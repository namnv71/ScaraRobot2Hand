{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)33a9ecd1-b710-41b4-897c-c5b4d1ccb65e","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_RunMoveL","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//============================================================\n// FB_RunMoveL\n//\n// Chạy TCP theo đường thẳng tới PositionIn.\n//\n// Cơ chế giống FB_RunMoveP:\n// - Giữ Execute đến CommandAccepted.\n// - Accepted được latch.\n// - Done được giữ để MotionManager đọc.\n// - SkipPositionCheck dùng cho điểm bị ảnh hưởng blending.\n//============================================================\n\n\n//------------------------------------------------------------\n// Phát hiện cạnh Start\n//------------------------------------------------------------\nStartEdge := Start AND NOT LastStart;\nLastStart := Start;\n\n\n//------------------------------------------------------------\n// Execute mặc định FALSE.\n// Chỉ bật ở MOVE_SEND / MOVE_WAIT_ACCEPT.\n//------------------------------------------------------------\nExecutePulse := FALSE;\n\n\n//============================================================\n// STATE MACHINE\n//============================================================\nCASE State OF\n\n\n    //========================================================\n    // IDLE\n    //========================================================\n    E_MoveState.MOVE_IDLE:\n\n        Accepted := FALSE;\n        Done     := FALSE;\n        Error    := FALSE;\n        Timeout  := FALSE;\n        Aborted  := FALSE;\n\n        //Release := FALSE;\n\n        ErrorID_Custom := 0;\n\n        //----------------------------------------------------\n        // Reset timer\n        //----------------------------------------------------\n        tAcceptTimeout(IN := FALSE);\n        tMoveTimeout(IN := FALSE);\n        tPosCheckDelay(IN := FALSE);\n\n\n        //----------------------------------------------------\n        // Chỉ nhận lệnh khi FB gốc đã rảnh\n        //----------------------------------------------------\n        IF Start\n           AND NOT fbMoveL.Busy\n           AND NOT fbMoveL.Active\n        THEN\n\n            //------------------------------------------------\n            // Chốt tọa độ\n            //------------------------------------------------\n            PosBuf := PositionIn;\n\n\n            //------------------------------------------------\n            // SPEED\n            //\n            // Item.Speed > 0:\n            //     speed riêng của step.\n            //\n            // Item.Speed <= 0:\n            //     dùng speed hiện tại.\n            //------------------------------------------------\n            IF Item.Speed > 0.0 THEN\n                Vel := Item.Speed;\n            ELSE\n\t\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n                \tVel := GVL.A_CurrentMotionParam.Speed;\n\t\t\t\tELSE\n\t\t\t\t\tVel := GVL.B_CurrentMotionParam.Speed;\n\t\t\t\tEND_IF\n            END_IF;\n\n\n            //------------------------------------------------\n            // Dynamics hiện tại\n            //------------------------------------------------\n\n\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n\t\t\t\tIF Item.Acceleration > 0.0 THEN Acc := Item.Acceleration; ELSE Acc := GVL_1.DATA_RB_A.MOTION_ACC; END_IF;\n\t\t\t\tIF Item.Deceleration > 0.0 THEN Dec := Item.Deceleration; ELSE Dec := GVL_1.DATA_RB_A.MOTION_DEC; END_IF;\n\t\t\t\tIF Item.Jerk > 0.0 THEN Jerk := Item.Jerk; ELSE Jerk := GVL_1.DATA_RB_A.MOTION_JERK; END_IF;\n\t\t\tELSE\n\t\t\t\tIF Item.Acceleration > 0.0 THEN Acc := Item.Acceleration; ELSE Acc := GVL_1.DATA_RB_B.MOTION_ACC; END_IF;\n\t\t\t\tIF Item.Deceleration > 0.0 THEN Dec := Item.Deceleration; ELSE Dec := GVL_1.DATA_RB_B.MOTION_DEC; END_IF;\n\t\t\t\tIF Item.Jerk > 0.0 THEN Jerk := Item.Jerk; ELSE Jerk := GVL_1.DATA_RB_B.MOTION_JERK; END_IF;\n\t\t\tEND_IF\n\t\t\t\n\n            //------------------------------------------------\n            // Giá trị dự phòng\n            //------------------------------------------------\n            IF Vel <= 0.0 THEN\n                Vel := 100.0;\n            END_IF;\n\n            IF Acc <= 0.0 THEN\n                Acc := 1000.0;\n            END_IF;\n\n            IF Dec <= 0.0 THEN\n                Dec := 1000.0;\n            END_IF;\n\n            IF Jerk <= 0.0 THEN\n                Jerk := 10000.0;\n            END_IF;\n\n\n            //------------------------------------------------\n            // Dynamic Factor\n            //------------------------------------------------\n            IF AxisGroup.m_id = SCARA_A.m_id THEN\n\t\t\t\tVelFacLocal    := GVL_1.DATA_RB_A.Fac_Vel;\n\t\t\t\tAccFacLocal    := GVL_1.DATA_RB_A.Fac_Acc;\n\t\t\t\tJerkFacLocal   := GVL_1.DATA_RB_A.Fac_Jerk;\n\t\t\t\tTorqueFacLocal := GVL_1.DATA_RB_A.Fac_Torque;\n\t\t\tELSE\n\t\t\t\tVelFacLocal    := GVL_1.DATA_RB_B.Fac_Vel;\n\t\t\t\tAccFacLocal    := GVL_1.DATA_RB_B.Fac_Acc;\n\t\t\t\tJerkFacLocal   := GVL_1.DATA_RB_B.Fac_Jerk;\n\t\t\t\tTorqueFacLocal := GVL_1.DATA_RB_B.Fac_Torque;\n\t\t\tEND_IF\n\n            IF VelFacLocal <= 0.0 THEN\n                VelFacLocal := 0.1;\n            END_IF;\n\n            IF AccFacLocal <= 0.0 THEN\n                AccFacLocal := 0.1;\n            END_IF;\n\n            IF JerkFacLocal <= 0.0 THEN\n                JerkFacLocal := 0.1;\n            END_IF;\n\n            IF TorqueFacLocal <= 0.0 THEN\n                TorqueFacLocal := 0.1;\n            END_IF;\n\n\n            //------------------------------------------------\n            // Mapping blending\n            //------------------------------------------------\n            IF (Item.BlendMode = 0)\n               OR (Item.BlendRadius <= 0.0)\n            THEN\n\n                BufferMode := C_BM_Buffered;\n                TransMode  := C_TM_None;\n\n                TransParam[0] := 0.0;\n                TransParam[1] := 0.0;\n\n            ELSE\n\n                //------------------------------------------------\n                // Dùng giống MoveP đang chạy ổn\n                //------------------------------------------------\n                BufferMode := GVL.C_BM_BlendingHigh;\n\n                CASE Item.BlendMode OF\n\n                    1:\n                        TransMode := C_TM_CornerDistance;\n\n                    2:\n                        TransMode := C_TM_StartVelocity;\n\n                ELSE\n                    TransMode := C_TM_CornerDistance;\n\n                END_CASE;\n\n                TransParam[0] := Item.BlendRadius;\n                TransParam[1] := 0.0;\n\n            END_IF;\n\n\n            //------------------------------------------------\n            // Orientation mode hiện tại của robot\n            //------------------------------------------------\n\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n\t\t\t\tOrientationMode := POU_MOTION.RBA_OrientationMode;\n\t\t\tELSE\n\t\t\t\tOrientationMode := POU_MOTION.RBB_OrientationMode;\n\t\t\tEND_IF\n            \n\n\n            //------------------------------------------------\n            // Reset outputs cho command mới\n            //------------------------------------------------\n            Accepted := FALSE;\n            Done     := FALSE;\n            Error    := FALSE;\n            Timeout  := FALSE;\n            Aborted  := FALSE;\n\n            ErrorID_Custom := 0;\n\n\n            State := E_MoveState.MOVE_SEND;\n\n        END_IF;\n\n\n    //========================================================\n    // SEND COMMAND\n    //========================================================\n    E_MoveState.MOVE_SEND:\n\n        ExecutePulse := TRUE;\n\n        tAcceptTimeout(\n            IN := TRUE,\n            PT := AcceptTimeoutTime\n        );\n\n        State := E_MoveState.MOVE_WAIT_ACCEPT;\n\n\n    //========================================================\n    // WAIT COMMAND ACCEPTED\n    //========================================================\n    E_MoveState.MOVE_WAIT_ACCEPT:\n\n        //----------------------------------------------------\n        // Giữ Execute cho tới khi AxisGroup nhận command\n        //----------------------------------------------------\n        ExecutePulse := TRUE;\n\n        tAcceptTimeout(\n            IN := TRUE,\n            PT := AcceptTimeoutTime\n        );\n\n\n        IF fbMoveL.CommandAccepted THEN\n\n            Accepted := TRUE;\n\n            ExecutePulse := FALSE;\n\n            tAcceptTimeout(IN := FALSE);\n\n            tMoveTimeout(\n                IN := TRUE,\n                PT := MoveTimeoutTime\n            );\n\n            State := E_MoveState.MOVE_WAIT_DONE;\n\n\n        ELSIF fbMoveL.CommandAborted THEN\n\n            ExecutePulse := FALSE;\n\n            Aborted := TRUE;\n            Error   := TRUE;\n\n            ErrorID_Custom := 5103;\n\n            tAcceptTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_ABORTED;\n\n\n        ELSIF fbMoveL.Error THEN\n\n            ExecutePulse := FALSE;\n\n            Error   := TRUE;\n            ErrorID := fbMoveL.ErrorID;\n\n            ErrorID_Custom := 5104;\n\n            tAcceptTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_ERROR;\n\n\n        ELSIF tAcceptTimeout.Q THEN\n\n            ExecutePulse := FALSE;\n\n            Timeout := TRUE;\n            Error   := TRUE;\n\n            ErrorID_Custom := 5105;\n\n            tAcceptTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_TIMEOUT;\n\n        END_IF;\n\n\n    //========================================================\n    // WAIT MOTION DONE\n    //========================================================\n    E_MoveState.MOVE_WAIT_DONE:\n\n        Accepted := TRUE;\n        ExecutePulse := FALSE;\n\n        tMoveTimeout(\n            IN := TRUE,\n            PT := MoveTimeoutTime\n        );\n\n\n        IF fbMoveL.Done THEN\n\n            tMoveTimeout(IN := FALSE);\n\n            //------------------------------------------------\n            // Điểm cần check chính xác\n            //------------------------------------------------\n            IF NOT Item.SkipPositionCheck THEN\n\n                tPosCheckDelay(\n                    IN := TRUE,\n                    PT := PosCheckDelayTime\n                );\n\n                State := E_MoveState.MOVE_CHECK_POS;\n\n            ELSE\n\n                //------------------------------------------------\n                // Điểm transition / blending:\n                // không bắt Actual Position == Target.\n                //------------------------------------------------\n                State := E_MoveState.MOVE_DONE;\n\n            END_IF;\n\n\n        ELSIF fbMoveL.CommandAborted THEN\n\n            Aborted := TRUE;\n            Error   := TRUE;\n\n            ErrorID_Custom := 5103;\n\n            tMoveTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_ABORTED;\n\n\n        ELSIF fbMoveL.Error THEN\n\n            Error   := TRUE;\n            ErrorID := fbMoveL.ErrorID;\n\n            ErrorID_Custom := 5104;\n\n            tMoveTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_ERROR;\n\n\n        ELSIF tMoveTimeout.Q THEN\n\n            Timeout := TRUE;\n            Error   := TRUE;\n\n            ErrorID_Custom := 5106;\n\n            tMoveTimeout(IN := FALSE);\n\n            State := E_MoveState.MOVE_TIMEOUT;\n\n        END_IF;\n\n\n    //========================================================\n    // CHECK FINAL POSITION\n    //========================================================\n    E_MoveState.MOVE_CHECK_POS:\n\n        Accepted := TRUE;\n\n        tPosCheckDelay(\n            IN := TRUE,\n            PT := PosCheckDelayTime\n        );\n\n        IF tPosCheckDelay.Q THEN\n\n            tPosCheckDelay(IN := FALSE);\n\n            //------------------------------------------------\n            // Lưu để debug\n            //------------------------------------------------\n// \t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n//             \tDonePosition := POU_MONITOR_ROBOT.RB1_POS;\n// \t\t\tELSE\n// \t\t\t\tDonePosition := POU_MONITOR_ROBOT.RB2_POS;\n// \t\t\tEND_IF;\n\t\t\tIF AxisGroup.m_id = SCARA_A.m_id THEN\n            \tDonePosition := POU_COORDINATE_.Pos_Out_A_MCS;\n\t\t\tELSE\n\t\t\t\tDonePosition := POU_COORDINATE_.Pos_Out_B_MCS;\n\t\t\tEND_IF;\n\n\n            //------------------------------------------------\n            // Kiểm tra vị trí cuối MovL\n            //------------------------------------------------\n            IF F_CheckPositionReached(\n                Target := PosBuf,\n                //Actual := POU_MONITOR_ROBOT.RB1_POS,\n\t\t\t\tActual := DonePosition,\n                TolXYZ := GVL.MotionTolXYZ,\n                TolR   := GVL.MotionTolR\n            )\n            THEN\n\n                State := E_MoveState.MOVE_DONE;\n\n            ELSE\n\n                Error := TRUE;\n\n                //------------------------------------------------\n                // 5101 = MoveL position not reached\n                //------------------------------------------------\n                ErrorID_Custom := 5101;\n\n                State := E_MoveState.MOVE_ERROR;\n\n            END_IF;\n\n        END_IF;\n\n\n    //========================================================\n    // DONE\n    //========================================================\n    E_MoveState.MOVE_DONE:\n\n        Accepted := TRUE;\n        Done     := TRUE;\n\n        ExecutePulse := FALSE;\n\n        //----------------------------------------------------\n        // Giống FB_RunMoveP đang dùng:\n        // giữ Done cho tới khi Manager đã hạ Start\n        // và FB gốc đã hoàn toàn rảnh.\n        //----------------------------------------------------\n        IF NOT Start\n           AND NOT fbMoveL.Busy\n           AND NOT fbMoveL.Active\n        THEN\n\n            State := E_MoveState.MOVE_IDLE;\n\n        END_IF;\n\n\n    //========================================================\n    // ERROR\n    //========================================================\n    E_MoveState.MOVE_ERROR:\n\n        Error := TRUE;\n        ExecutePulse := FALSE;\n\n        IF NOT Start THEN\n            State := E_MoveState.MOVE_IDLE;\n        END_IF;\n\n\n    //========================================================\n    // TIMEOUT\n    //========================================================\n    E_MoveState.MOVE_TIMEOUT:\n\n        Error   := TRUE;\n        Timeout := TRUE;\n\n        ExecutePulse := FALSE;\n\n        IF NOT Start THEN\n            State := E_MoveState.MOVE_IDLE;\n        END_IF;\n\n\n    //========================================================\n    // ABORTED\n    //========================================================\n    E_MoveState.MOVE_ABORTED:\n\n        Error   := TRUE;\n        Aborted := TRUE;\n\n        ExecutePulse := FALSE;\n\n        IF NOT Start THEN\n            State := E_MoveState.MOVE_IDLE;\n        END_IF;\n\nEND_CASE;\n\n\n//============================================================\n// GỌI FB GỐC MỖI SCAN\n//============================================================\nfbMoveL(\n    AxisGroup := AxisGroup,\n\n    Execute := ExecutePulse,\n\n    Position := PosBuf,\n\n    Velocity     := Vel,\n    Acceleration := Acc,\n    Deceleration := Dec,\n    Jerk         := Jerk,\n\n    CoordSystem := CoordSystem,\n\n    BufferMode          := BufferMode,\n    TransitionMode      := TransMode,\n    TransitionParameter := TransParam,\n\n    OrientationMode := OrientationMode,\n\n    VelFactor    := VelFacLocal,\n    AccFactor    := AccFacLocal,\n    JerkFactor   := JerkFacLocal,\n    TorqueFactor := TorqueFacLocal\n);\n\n\n//============================================================\n// PHẢN HỒI TRẠNG THÁI FB GỐC\n//============================================================\nBusy   := fbMoveL.Busy;\nActive := fbMoveL.Active;","LineInfoPersistence":"(string)33a9ecd1-b710-41b4-897c-c5b4d1ccb65e_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_RunMoveL\nVAR_INPUT\n    Start       : BOOL;\n    Item        : ST_MotionQueueItem;\n    PositionIn  : SMC_POS_REF;\n    CoordSystem : SMC_COORD_SYSTEM;\n\n    AcceptTimeoutTime : TIME := T#2S;\n    MoveTimeoutTime   : TIME := T#50S;\n    PosCheckDelayTime : TIME := T#13MS;\nEND_VAR\nVAR_IN_OUT\n\tAxisGroup   : AXIS_GROUP_REF_SM3;\nEND_VAR\nVAR_OUTPUT\n    Accepted       : BOOL;\n    Done           : BOOL;\n    Busy           : BOOL;\n    Active         : BOOL;\n    Error          : BOOL;\n    Timeout        : BOOL;\n    Aborted        : BOOL;\n    ErrorID        : SMC_ERROR;\n    ErrorID_Custom : INT;\n    State          : E_MoveState;\nEND_VAR\n\nVAR\n\t//--------------------------------------------------------\n    // SoftMotion FB gốc\n    //--------------------------------------------------------\n    fbMoveL : MC_MoveLinearAbsolute;\n\t//--------------------------------------------------------\n    // Timer\n    //--------------------------------------------------------\n    tAcceptTimeout : TON;\n    tMoveTimeout   : TON;\n    tPosCheckDelay : TON;\n\n\t//--------------------------------------------------------\n    // Execute control\n    //--------------------------------------------------------\n    StartEdge    : BOOL;\n    LastStart    : BOOL;\n    ExecutePulse : BOOL;\n\t\n\t//--------------------------------------------------------\n    // Target buffer\n    //--------------------------------------------------------\n    PosBuf : SMC_POS_REF;\n\tDonePosition : SM3_Robotics.SMC_POS_REF;\n\n    //--------------------------------------------------------\n    // Path dynamics\n    //--------------------------------------------------------\n    Vel  : LREAL;\n    Acc  : LREAL;\n    Dec  : LREAL;\n    Jerk : LREAL;\n\t\n\t //--------------------------------------------------------\n    // Blending\n    //--------------------------------------------------------\n    BufferMode : SM3_Robotics.MC_BUFFER_MODE;\n    TransMode  : SM3_Robotics.MC_TRANSITION_MODE;\n    TransParam : ARRAY[0..(SMC_RCNST.MAX_TRANS_PARAMS - 1)] OF LREAL := [0.0, 0.0];\n\t//--------------------------------------------------------\n    // Orientation\n    //--------------------------------------------------------\n    OrientationMode : SM3_Robotics.SMC_ORIENTATION_MODE;\n\t //--------------------------------------------------------\n    // Dynamic factors\n    //--------------------------------------------------------\n    VelFacLocal    : LREAL;\n    AccFacLocal    : LREAL;\n    JerkFacLocal   : LREAL;\n    TorqueFacLocal : LREAL;\nEND_VAR\n\nVAR CONSTANT\n\tC_BM_Buffered     : SM3_Robotics.MC_BUFFER_MODE := 1;\n    C_BM_BlendingNext : SM3_Robotics.MC_BUFFER_MODE := 4;\n\n    C_TM_CornerDistance : SM3_Robotics.MC_TRANSITION_MODE := 2;\n    C_TM_None           : SM3_Robotics.MC_TRANSITION_MODE := 0;\n    C_TM_StartVelocity  : SM3_Robotics.MC_TRANSITION_MODE := 1;\nEND_VAR","LineInfoPersistence":"(string)33a9ecd1-b710-41b4-897c-c5b4d1ccb65e_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)647","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}