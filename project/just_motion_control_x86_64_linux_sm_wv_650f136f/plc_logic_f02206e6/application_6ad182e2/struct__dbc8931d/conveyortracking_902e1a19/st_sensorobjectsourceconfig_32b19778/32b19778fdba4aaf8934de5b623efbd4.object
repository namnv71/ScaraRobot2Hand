{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)32b19778-fdba-4aaf-8934-de5b623efbd4","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_SensorObjectSourceConfig","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: SENSOR OBJECT SOURCE CONFIG\n//-----------------------------------------------------------------------------\n// Cấu hình nguồn Object không dùng Vision.\n//=============================================================================\nTYPE ST_SensorObjectSourceConfig :\nSTRUCT\n\n    // Cho phép sử dụng nguồn Sensor.\n    Enable : BOOL;\n\n    // ID của nguồn Sensor.\n    SensorSourceID : UINT;\n\t\n\t// Name của nguồn Sensor.\n    SensorSourceName : STRING[32];\n\n    // Số kênh DI phát hiện sản phẩm.\n    DetectInputChannel : UINT;\n\n    // Mức logic tác động của DI.\n    DetectActiveLevel : BOOL;\n\n    // Thời gian chống rung tín hiệu Sensor.\n    DebounceTime : TIME;\n\n    // Khoảng cách tối thiểu giữa hai Object.\n    MinimumObjectSpacingMM : REAL;\n\n    // Pose mặc định của Object tại đúng vị trí Sensor.\n    CapturePoseInConveyor : ST_POS;\n\n    // Product Class mặc định.\n    ProductClassID : UINT;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)32b19778-fdba-4aaf-8934-de5b623efbd4_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)38"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}