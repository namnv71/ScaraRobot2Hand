{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)e13c005b-42f6-4d12-84db-33ea7b689c86","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionGetResult","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)455bb68e-496e-4125-829d-ed46387b0a41"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_VisionGetResult\n//-----------------------------------------------------------------------------\n// Chức năng đơn giản:\n// 1. Trigger Vision.\n// 2. Chờ Vision trả Result.\n// 3. Khi Header hợp lệ và đúng TriggerID thì copy dữ liệu ra Output.\n// 4. Không kiểm tra Offset / Tolerance / Motion.\n//=============================================================================\n\n\n//=============================================================================\n// CALL TRIGGER\n//=============================================================================\nfbTriggerVS(\n    Enable := Enable,\n    Start := xStartTrigger,\n    CameraID := CameraID,\n    JobID := JobID,\n    Application := Application,\n    count_Vs_Align_max := GVL.g_aVisionConfig[CameraID].MaxRetry,\n    T_Delay_Trigger_time := TO_INT(GVL.g_aVisionConfig[CameraID].TriggerTimeout),\n    Trigger_Again := FALSE,\n    Pass_Triger_VS_NG := FALSE,\n    Mode_ByPass_VS := FALSE\n);\n\nTriggerID := fbTriggerVS.CurrentTriggerID;\n\n\n//=============================================================================\n// CALL WAIT RESULT\n//=============================================================================\nfbWaitResult(\n    Enable := Enable,\n    Start := xStartWaitResult,\n    CameraID := CameraID,\n    ExpectedTriggerID := TriggerID,\n    ExpectedJobID := JobID,\n    ExpectedApplication := Application\n);\n\n\n//=============================================================================\n// DISABLE / RESET\n//=============================================================================\nIF NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n\n    Busy := FALSE;\n    Done := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    xStartTrigger := FALSE;\n    xStartWaitResult := FALSE;\n\n    HeaderOK := FALSE;\n\n    ResultValid := FALSE;\n    ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n    ResultCode := 0;\n    VisionErrorCode := 0;\n\n    X := 0.0;\n    Y := 0.0;\n    Z := 0.0;\n    A := 0.0;\n    Score := 0.0;\n    FeatureID := 0;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// STATE MACHINE\n//=============================================================================\nCASE State OF\n\n    //=========================================================================\n    // 0 - IDLE\n    //=========================================================================\n    0:\n        Busy := FALSE;\n        Done := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        HeaderOK := FALSE;\n\n        IF Start AND NOT StartOld THEN\n            Busy := TRUE;\n            xStartTrigger := TRUE;\n            State := 10;\n        END_IF;\n\n\n    //=========================================================================\n    // 10 - WAIT TRIGGER DONE\n    //=========================================================================\n    10:\n        Busy := TRUE;\n\n        IF fbTriggerVS.Error THEN\n            xStartTrigger := FALSE;\n\n            Error := TRUE;\n            ErrorID := 100 + fbTriggerVS.ErrorID;\n            State := 900;\n\n        ELSIF fbTriggerVS.DoneAll THEN\n            xStartTrigger := FALSE;\n\n            xStartWaitResult := TRUE;\n            State := 20;\n        END_IF;\n\n\n    //=========================================================================\n    // 20 - WAIT RESULT\n    //=========================================================================\n    20:\n        Busy := TRUE;\n\n        IF fbWaitResult.Error THEN\n            xStartWaitResult := FALSE;\n\n            Error := TRUE;\n            ErrorID := 200 + fbWaitResult.ErrorID;\n            State := 900;\n\n        ELSIF fbWaitResult.Done THEN\n            xStartWaitResult := FALSE;\n\n            State := 30;\n        END_IF;\n\n\n    //=========================================================================\n    // 30 - COPY RESULT\n    //=========================================================================\n    30:\n        // Header đã được FB_WaitResult xác nhận đúng TriggerID / JobID / App.\n        HeaderOK := TRUE;\n\n        ResultValid := fbWaitResult.ResultValid;\n        ResultStatus := fbWaitResult.ResultStatus;\n        ResultCode := fbWaitResult.ResultCode;\n        VisionErrorCode := fbWaitResult.VisionErrorCode;\n\n        X := fbWaitResult.ResultX;\n        Y := fbWaitResult.ResultY;\n        Z := fbWaitResult.ResultZ;\n        A := fbWaitResult.ResultA;\n        Score := fbWaitResult.ResultScore;\n        FeatureID := fbWaitResult.ResultFeatureID;\n\n        Busy := FALSE;\n        Done := TRUE;\n\n        State := 100;\n\n\n    //=========================================================================\n    // 100 - DONE\n    //=========================================================================\n    100:\n        Busy := FALSE;\n        Done := TRUE;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\n\n    //=========================================================================\n    // 900 - ERROR\n    //=========================================================================\n    900:\n        Busy := FALSE;\n        Done := FALSE;\n\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        IF NOT Start THEN\n            Error := FALSE;\n            ErrorID := 0;\n            State := 0;\n        END_IF;\n\nEND_CASE;\n\nStartOld := Start;","LineInfoPersistence":"(string)e13c005b-42f6-4d12-84db-33ea7b689c86_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionGetResult\nVAR_INPUT\n    Enable : BOOL;                              // Cho phép FB hoạt động.\n    Start : BOOL;                               // Cạnh lên bắt đầu một lần đọc Vision.\n    CameraID : UINT;                            // Camera sử dụng.\n    JobID : UINT;                               // JobID Vision.\n    Application : E_VisionApplication;          // Application Vision.\nEND_VAR\n\nVAR_OUTPUT\n    Busy : BOOL;                                // Đang thực hiện.\n    Done : BOOL;                                // Đã nhận Result thành công.\n    Error : BOOL;                               // Có lỗi.\n    ErrorID : INT;                              // Mã lỗi.\n\n    State : INT;                                // State để monitor.\n\n    TriggerID : UDINT;                          // TriggerID của lần chụp.\n\n    HeaderOK : BOOL;                            // TRUE khi Header Result hợp lệ.\n\n    ResultValid : BOOL;                         // Bit Valid của dữ liệu Vision.\n    ResultStatus : E_VisionResultStatus;        // ResultStatus Vision.\n    ResultCode : UINT;                          // ResultCode Vision.\n    VisionErrorCode : UINT;                     // ErrorCode Vision.\n\n    X : REAL;                                   // X Vision trả về.\n    Y : REAL;                                   // Y Vision trả về.\n    Z : REAL;                                   // Z Vision trả về.\n    A : REAL;                                   // Theta / Angle Vision trả về.\n    Score : REAL;                               // Score Vision.\n    FeatureID : UINT;                           // FeatureID Vision.\nEND_VAR\n\nVAR\n    StartOld : BOOL;                            // Start scan trước.\n\n    xStartTrigger : BOOL;                       // Start nội bộ cho Trigger.\n    xStartWaitResult : BOOL;                    // Start nội bộ cho WaitResult.\n\n    fbTriggerVS : FB_TriggerVS;                 // FB Trigger đã test.\n    fbWaitResult : FB_VisionWaitResult;         // FB WaitResult đã test.\nEND_VAR","LineInfoPersistence":"(string)e13c005b-42f6-4d12-84db-33ea7b689c86_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)242","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}