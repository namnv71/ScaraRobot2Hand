{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)POU_HMI_CONTROL_ROBOT","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// DEFINT\nACT_View_Edit_Point_A();\nACT_View_Edit_Cmd();\nACT_HMI_A_ConditionEditor();\nACT_HMIToolConfigEditor_A();\nACT_HMI_SensorSource_Config();\nACT_HMI_Recipe_Config();\nACT_HMI_A_Vision_Tracking_Config();\n\n// ============================================================\nACT_View_Edit_Point_B();\nACT_View_Edit_Cmd_B();\nACT_HMI_B_ConditionEditor();\n\nACT_HMIToolConfigEditor_B();\nACT_HMI_SensorSource_Config_B();\nACT_HMI_Recipe_Config_B();\nACT_HMI_B_Vision_Tracking_Config();\n\n\nACT_select_rb();\nACT_MANORAUTO();\nACT_MENU();\nACT_ControlPanel();\nACT_JOG_LOGIC();\n// Read Window\nD_HMI_SCREEN := GVL.DW_[2]; // O NHO CHUA SO PAGE CỦA HMI\nGVL.DW_[4] := D_PLC_SCREEN; // THAY ĐỔI TRANG HMI TỪ PLC\nD_SELECT_RB := GVL.DW_[0]; // SELECT ROBOT TRONG H\n/// RESET DATA 1\nSR_HMI_CONTROL_PANEL_1(SET1 := D_HMI_SCREEN = 20,\n\tRESET := D_HMI_SCREEN <> 20,\n\tQ1 => GVL.MB_[20]);\nSR_JOG_AND_TEACH_1(SET1 := D_HMI_SCREEN = 21,\n\tRESET := D_HMI_SCREEN <> 21,\n\tQ1 => GVL.MB_[21]);\nSR_POINT_1(SET1 := D_HMI_SCREEN = 22 OR D_HMI_SCREEN = 120 OR D_HMI_SCREEN = 121 OR D_HMI_SCREEN = 122 OR D_HMI_SCREEN = 123,\n\tRESET := D_HMI_SCREEN <> 22 AND D_HMI_SCREEN <> 120 AND D_HMI_SCREEN <> 121 AND D_HMI_SCREEN <> 122 AND D_HMI_SCREEN <> 123,\n\tQ1 => GVL.MB_[22]);\nSR_TOOLS_1(SET1 := D_HMI_SCREEN = 23,\n\tRESET := D_HMI_SCREEN <> 23,\n\tQ1 => GVL.MB_[23]);\nSR_PALLETS_1(SET1 := D_HMI_SCREEN = 24,\n\tRESET := D_HMI_SCREEN <> 24,\n\tQ1 => GVL.MB_[24]);\nSR_XYZ_LIMIT_1(SET1 := D_HMI_SCREEN = 25 OR D_HMI_SCREEN = 110,\n\tRESET := D_HMI_SCREEN <> 25 AND D_HMI_SCREEN <> 110,\n\tQ1 => GVL.MB_[25]);\t\nSR_ROBOT_CONFIG_1(SET1 := D_HMI_SCREEN = 26,\n\tRESET := D_HMI_SCREEN <> 26,\n\tQ1 => GVL.MB_[26]);\t\t\t\n/// RESET DATA 2\nSR_HMI_CONTROL_PANEL_2(SET1 := D_HMI_SCREEN = 30,\n\tRESET := D_HMI_SCREEN <> 30,\n\tQ1 => GVL.MB_[30]);\nSR_JOG_AND_TEACH_2(SET1 := D_HMI_SCREEN = 31,\n\tRESET := D_HMI_SCREEN <> 31,\n\tQ1 => GVL.MB_[31]);\nSR_POINT_2(SET1 := D_HMI_SCREEN = 32 OR D_HMI_SCREEN = 130 OR D_HMI_SCREEN = 131 OR D_HMI_SCREEN = 132 OR D_HMI_SCREEN = 133,\n\tRESET := D_HMI_SCREEN <> 32 AND D_HMI_SCREEN <> 130 AND D_HMI_SCREEN <> 131 AND D_HMI_SCREEN <> 132 AND D_HMI_SCREEN <> 133,\n\tQ1 => GVL.MB_[32]);\nSR_TOOLS_2(SET1 := D_HMI_SCREEN = 33,\n\tRESET := D_HMI_SCREEN <> 33,\n\tQ1 => GVL.MB_[33]);\nSR_PALLETS_2(SET1 := D_HMI_SCREEN = 34,\n\tRESET := D_HMI_SCREEN <> 34,\n\tQ1 => GVL.MB_[34]);\nSR_XYZ_LIMIT_2(SET1 := D_HMI_SCREEN = 35 OR D_HMI_SCREEN = 111 ,\n\tRESET := D_HMI_SCREEN <> 35 AND D_HMI_SCREEN <> 111,\n\tQ1 => GVL.MB_[35]);\t\nSR_ROBOT_CONFIG_2(SET1 := D_HMI_SCREEN = 36,\n\tRESET := D_HMI_SCREEN <> 36,\n\tQ1 => GVL.MB_[36]);","LineInfoPersistence":"(string)6074aab5-ea8d-4ca8-926f-ed0b90c52886_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM POU_HMI_CONTROL_ROBOT\nVAR\n\tSR1,SR2,SR3,SR4,SR5,SR6,SR7,SR8,\n\tSR_HMI_CONTROL_PANEL_1, SR_JOG_AND_TEACH_1,SR_POINT_1,SR_TOOLS_1,SR_PALLETS_1,SR_XYZ_LIMIT_1, SR_ROBOT_CONFIG_1,\n\tSR_HMI_CONTROL_PANEL_2, SR_JOG_AND_TEACH_2,SR_POINT_2,SR_TOOLS_2,SR_PALLETS_2,SR_XYZ_LIMIT_2, SR_ROBOT_CONFIG_2 : SR;\n\tRS_JOG_CONTINUE_1, RS_JOG_INCHING_1, RS_JOG_POINT_1,\n\tRS_JOG_CONTINUE_2, RS_JOG_INCHING_2, RS_JOG_POINT_2 : SR;\n\tTRIG_JOG_CONTINUE_1, TRIG_JOG_INCHING_1, TRIG_JOG_POINT_1,\n\tTRIG_JOG_CONTINUE_2, TRIG_JOG_INCHING_2, TRIG_JOG_POINT_2 : R_TRIG;\n\t\n\tD_HMI_SCREEN , D_PLC_SCREEN : WORD;\n\tD_SELECT_RB, D_SELECT_TOOL_RB_A, D_SELECT_TOOL_RB_B : WORD;\n\n\tR_TRIG_0, R_TRIG_1, R_TRIG_2: R_TRIG;\n\n\tPrevSelectRB : WORD;\nEND_VAR\n\nVAR // act_manORauto\n\tTR_MAN, TR_AUTO , TR_MAN_AB, TR_AUTO_AB : R_TRIG;\n\t\nEND_VAR\nVAR\n\ti, idx, iPoint : INT;\nEND_VAR\n\n// HMI Edit Point\nVAR\n\tDelete_all_point, Delete_one_point : TON;\n\tDelete_all_Step, Delete_one_Step : TON;\nEND_VAR\n\n// HMI Condition\nVAR\n    condNo : INT;\n    rowNo : INT;\n\trowResult : BOOL;\n    finalResult : BOOL;\n    firstRow : BOOL;\nEND_VAR\n\n// ============================================================\n// ADD LOCAL VARIABLES TO POU_HMI_CONTROL_ROBOT\n// Không dùng chung TON A/B vì hai editor có thể được scan cùng lúc.\n// ============================================================\nVAR\n    Delete_all_point_B : TON;\n    Delete_one_point_B : TON;\n    Delete_all_Step_B : TON;\n    Delete_one_Step_B : TON;\nEND_VAR","LineInfoPersistence":"(string)6074aab5-ea8d-4ca8-926f-ed0b90c52886_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)124","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}