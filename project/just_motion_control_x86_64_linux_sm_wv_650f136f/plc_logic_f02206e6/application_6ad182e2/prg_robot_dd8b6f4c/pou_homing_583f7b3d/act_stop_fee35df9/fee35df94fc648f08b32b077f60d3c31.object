{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)fee35df9-4fc6-48f0-8b32-b077f60d3c31","ParentGuid":"(Guid)583f7b3d-4fc7-4681-b37e-b1d272f834de","Name":"(string)ACT_STOP","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF (MC_ReadError_A0.AxisError OR MC_ReadError_A1.AxisError OR MC_ReadError_A2.AxisError OR MC_ReadError_A3.AxisError) \nOR (MC_ReadError_A0.Error OR MC_ReadError_A1.Error OR MC_ReadError_A2.Error OR MC_ReadError_A3.Error)\nOR A0.bError OR A1.bError OR A2.bError OR A3.bError THEN\n\tBitStop_Error_Axis_RB_A := TRUE;\nELSE\n\tBitStop_Error_Axis_RB_A := FALSE;\nEND_IF\n\nIF (MC_ReadError_B0.AxisError OR MC_ReadError_B1.AxisError OR MC_ReadError_B2.AxisError OR MC_ReadError_B3.AxisError) \nOR (MC_ReadError_B0.Error OR MC_ReadError_B1.Error OR MC_ReadError_B2.Error OR MC_ReadError_B3.Error) \nOR B0.bError OR B1.bError OR B2.bError OR B3.bError THEN\n\tBitStop_Error_Axis_RB_B := TRUE;\nELSE\n\tBitStop_Error_Axis_RB_B := FALSE;\nEND_IF\n\nIF Bit_Stop = TRUE OR NOT GVL.X[9] OR BitStop_Tor_A OR BitStop_Error_Axis_RB_A \nOR GVL.RB_Signal_In.HMI_STOP OR NOT GVL.RB_Signal_In.HMI_EMG OR GVL.A_RunStop \nOR POU_MONITOR_ROBOT.MC_GroupReadStatus_RBA.Error OR GVL.RB_A_.ERROR\nOR SCARA_A.m_group_error > 0 THEN\n\tMC_Stop_A0.Execute:= TRUE;\n\tMC_Stop_A1.Execute:= TRUE;\n\tMC_Stop_A2.Execute:= TRUE;\n\tMC_Stop_A3.Execute:= TRUE;\n\tMC_GroupStop_RBA.Execute := TRUE;\nELSE\n\tMC_Stop_A0.Execute:= FALSE;\n\tMC_Stop_A1.Execute:= FALSE;\n\tMC_Stop_A2.Execute:= FALSE;\n\tMC_Stop_A3.Execute:= FALSE;\n\tMC_GroupStop_RBA.Execute := FALSE;\nEND_IF\n\nIF Bit_Stop = TRUE OR NOT GVL.X[9] OR BitStop_Tor_B OR BitStop_Error_Axis_RB_B \nOR GVL.RB_Signal_In.HMI_STOP OR NOT GVL.RB_Signal_In.HMI_EMG \nOR POU_MONITOR_ROBOT.MC_GroupReadStatus_RBB.Error OR GVL.RB_B_.ERROR\nOR SCARA_B.m_group_error > 0  THEN\n\tMC_Stop_B0.Execute:= TRUE;\n\tMC_Stop_B1.Execute:= TRUE;\n\tMC_Stop_B2.Execute:= TRUE;\n\tMC_Stop_B3.Execute:= TRUE;\n\tMC_GroupStop_RBB.Execute := TRUE;\nELSE\n\tMC_Stop_B0.Execute:= FALSE;\n\tMC_Stop_B1.Execute:= FALSE;\n\tMC_Stop_B2.Execute:= FALSE;\n\tMC_Stop_B3.Execute:= FALSE;\n\tMC_GroupStop_RBA.Execute := FALSE;\nEND_IF\n\n\n\n\n/// Condition SoftLimit\n\nIF GVL_1.DATA_RB_A.ENABLE_SOFT_LIMIT THEN\n\tDISABLE_POWER_A := 0;\n\tCASE ENABLE_POWER_A OF\n\t\t0:\n\t\t\tSMC_SetSoftwareLimits_A0.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A1.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A2.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A3.SWL_Activated := TRUE;\n\t\t\tENABLE_POWER_A := ENABLE_POWER_A + 5;\n\t\t5:\n\t\t\tSMC_SetSoftwareLimits_A0.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A1.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A2.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A3.bExecute := TRUE;\n\t\t\tENABLE_POWER_A := ENABLE_POWER_A + 5;\n\t\t10:\n\t\t\t// DONE\t\n\tEND_CASE\nELSE\n\tENABLE_POWER_A := 0;\n\tCASE DISABLE_POWER_A OF\n\t\t0:\n\t\t\tSMC_SetSoftwareLimits_A0.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A1.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A2.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A3.bExecute := FALSE;\n\t\t\tDISABLE_POWER_A := DISABLE_POWER_A + 5;\n\t\t5:\n\t\t\tSMC_SetSoftwareLimits_A0.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A1.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A2.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A3.SWL_Activated := FALSE;\n\t\t\tDISABLE_POWER_A := DISABLE_POWER_A + 5;\n\t\t10:\n\t\t\tSMC_SetSoftwareLimits_A0.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A1.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A2.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_A3.bExecute := TRUE;\n\t\t\tDISABLE_POWER_A := DISABLE_POWER_A + 5;\t\t\t\n\t\t15:\n\t\t\tSMC_SetSoftwareLimits_A0.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A1.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A2.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_A3.bExecute := FALSE;\t\t\t\t\n\tEND_CASE\nEND_IF;\n\n/// rbB\nIF GVL_1.DATA_RB_B.ENABLE_SOFT_LIMIT THEN\n\tDISABLE_POWER_B:= 0;\n\tCASE ENABLE_POWER_B OF\n\t\t0:\n\t\t\tSMC_SetSoftwareLimits_B0.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B1.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B2.SWL_Activated := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B3.SWL_Activated := TRUE;\n\t\t\tENABLE_POWER_B := ENABLE_POWER_B + 5;\n\t\t5:\n\t\t\tSMC_SetSoftwareLimits_B0.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B1.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B2.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B3.bExecute := TRUE;\n\t\t\tENABLE_POWER_B := ENABLE_POWER_B + 5;\n\t\t10:\n\t\t\t// DONE\t\n\tEND_CASE\nELSE\n\tENABLE_POWER_B := 0;\n\tCASE DISABLE_POWER_B OF\n\t\t0:\n\t\t\tSMC_SetSoftwareLimits_B0.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B1.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B2.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B3.bExecute := FALSE;\n\t\t\tDISABLE_POWER_B := DISABLE_POWER_B + 5;\n\t\t5:\n\t\t\tSMC_SetSoftwareLimits_B0.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B1.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B2.SWL_Activated := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B3.SWL_Activated := FALSE;\n\t\t\tDISABLE_POWER_B := DISABLE_POWER_B + 5;\n\t\t10:\n\t\t\tSMC_SetSoftwareLimits_B0.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B1.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B2.bExecute := TRUE;\n\t\t\tSMC_SetSoftwareLimits_B3.bExecute := TRUE;\n\t\t\tDISABLE_POWER_B := DISABLE_POWER_B + 5;\t\t\t\n\t\t15:\n\t\t\tSMC_SetSoftwareLimits_B0.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B1.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B2.bExecute := FALSE;\n\t\t\tSMC_SetSoftwareLimits_B3.bExecute := FALSE;\t\t\t\t\n\tEND_CASE\nEND_IF;","LineInfoPersistence":"(string)fee35df9-4fc6-48f0-8b32-b077f60d3c31_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)149"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}