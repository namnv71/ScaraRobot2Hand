{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)e198bd5d-aaf7-4758-8a4e-bf5b0c32e7cc","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_VisionAlignToolConfig","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)4da14d42-d241-4712-a403-b48098f8db54"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: ST_VisionAlignToolConfig\n//-----------------------------------------------------------------------------\n// Cấu hình iterative alignment cho từng Tool.\n// CaptureMasterPosID là điểm bắt đầu Align; các lần chụp tiếp theo KHÔNG cần\n// CapturePos cố định vì Robot sẽ di chuyển theo correction của lần trước.\n//=============================================================================\nTYPE ST_VisionAlignToolConfig :\nSTRUCT\n    Enable : BOOL;                          // Tool có tham gia Align Recipe hay không.\n    ToolID : UINT;                          // Tool đang giữ sản phẩm.\n    CaptureMasterPosID : UINT;              // PositionID điểm bắt đầu chụp/căn.\n\n    MaxAlignIterations : UINT;              // Số vòng Measure -> Correct tối đa.\n    ToleranceX : REAL;                      // Sai số X đạt yêu cầu, mm.\n    ToleranceY : REAL;                      // Sai số Y đạt yêu cầu, mm.\n    ToleranceA : REAL;                      // Sai số góc đạt yêu cầu, degree.\n\n    MaxCorrectionX : REAL;                  // Giới hạn correction X cho một vòng.\n    MaxCorrectionY : REAL;                  // Giới hạn correction Y cho một vòng.\n    MaxCorrectionA : REAL;                  // Giới hạn correction A cho một vòng.\nEND_STRUCT\nEND_TYPE\n\n","LineInfoPersistence":"(string)e198bd5d-aaf7-4758-8a4e-bf5b0c32e7cc_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)25"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}