{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)a3d015e7-df50-42b3-ac2b-86ae54a37ba9","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_NormalizeVector2D","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)87b8527a-29ac-43c5-aa42-24d324eff030"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Tính độ dài vector đầu vào.\nrLength := F_VectorLength2D(Vector := Vector);\n\n// Chỉ thực hiện phép chia khi độ dài đủ lớn.\nIF rLength > GVL.C_REAL_EPSILON THEN\n    F_NormalizeVector2D.X := Vector.X / rLength;\n    F_NormalizeVector2D.Y := Vector.Y / rLength;\nELSE\n    // Trả vector 0 nếu đầu vào không có hướng xác định.\n    F_NormalizeVector2D.X := 0.0;\n    F_NormalizeVector2D.Y := 0.0;\nEND_IF;","LineInfoPersistence":"(string)a3d015e7-df50-42b3-ac2b-86ae54a37ba9_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_NormalizeVector2D : ST_VECTOR_2D\nVAR_INPUT\n    Vector : ST_VECTOR_2D;    // Vector cần chuẩn hóa.\nEND_VAR\n\nVAR\n    rLength : REAL;           // Độ dài vector.\nEND_VAR","LineInfoPersistence":"(string)a3d015e7-df50-42b3-ac2b-86ae54a37ba9_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)20","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}