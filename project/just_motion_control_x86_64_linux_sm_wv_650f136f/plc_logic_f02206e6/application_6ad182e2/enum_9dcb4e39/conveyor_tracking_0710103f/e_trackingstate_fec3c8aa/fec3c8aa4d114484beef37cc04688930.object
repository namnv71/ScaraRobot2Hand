{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)fec3c8aa-4d11-4484-beef-37cc04688930","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_TrackingState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0710103f-fbdc-4582-87a9-dd50a9877f7d"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_TrackingState :\n(\n    // Manager đang chờ lệnh chạy.\n    TRK_IDLE := 0,\n\n    // Tìm object phù hợp trong Queue.\n    TRK_FIND_OBJECT := 10,\n\n    // Khóa quyền sở hữu object đã chọn.\n    TRK_RESERVE_OBJECT := 20,\n\n    // Chờ object nằm trong vùng gắp an toàn.\n    TRK_WAIT_PICK_ZONE := 30,\n\n    // Chuẩn bị dữ liệu PCS và các điểm Approach/Pick/Retract.\n    TRK_PREPARE_PCS := 40,\n\n    // Phát Execute cho MC_TrackConveyorBelt.\n    TRK_CREATE_PCS := 50,\n\n    // Chờ PCS động được tạo thành công.\n    TRK_WAIT_PCS := 60,\n\n    // Di chuyển tới điểm phía trên object trong PCS.\n    TRK_MOVE_APPROACH := 70,\n\t\n\t// Robot đã tới Approach trong PCS; chờ Tool DOWN/GRIP/UP.\n    TRK_SYNCHRONIZED := 75,\n\t\n    // Hạ xuống điểm gắp trong PCS.\n    TRK_MOVE_PICK := 80,\n\n    // Bật tool hút hoặc lệnh Grip.\n    TRK_GRIP_ON := 90,\n\n    // Chờ xác nhận tool đã giữ được vật.\n    TRK_WAIT_GRIP := 100,\n\n    // Nâng vật lên trong PCS sau khi gắp.\n    TRK_MOVE_RETRACT := 110,\n\n    // Di chuyển ra khỏi vùng tracking sang hệ robot/base.\n    TRK_LEAVE_PCS := 120,\n\n    // Chờ PCS không còn được Motion sử dụng rồi hạ Execute tracking.\n    TRK_RELEASE_PCS := 130,\n\t\n\t// LEAVE PCS Safe\n\tTRK_MOVE_SAFE_LEAVE := 135,\n\n    // Di chuyển tới điểm đặt sản phẩm trong hệ robot/base.\n    TRK_MOVE_PLACE := 140,\n\n    // Tắt hút hoặc phát lệnh Release tool.\n    TRK_RELEASE_PRODUCT := 150,\n\n    // Chờ hoàn tất thời gian thổi hoặc nhả.\n    TRK_WAIT_BLOW := 160,\n\n    // Hoàn thành xử lý một object.\n    TRK_COMPLETE := 170,\n\n    // Abort object active vì chạy quá vùng an toàn.\n    TRK_ABORT_ACTIVE := 180,\n\n    // Di chuyển robot về vị trí an toàn sau khi bỏ object.\n    TRK_MOVE_SAFE := 190,\n\n    // Giải phóng object MISSED rồi tìm object tiếp theo.\n    TRK_RELEASE_OBJECT := 200,\n\n    // Hủy toàn bộ chu trình do Execute bị hạ hoặc có lệnh Stop.\n    TRK_ABORTING := 210,\n\n    // Manager đang ở trạng thái lỗi.\n    TRK_ERROR := 900\n);\nEND_TYPE","LineInfoPersistence":"(string)fec3c8aa-4d11-4484-beef-37cc04688930_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)80"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}