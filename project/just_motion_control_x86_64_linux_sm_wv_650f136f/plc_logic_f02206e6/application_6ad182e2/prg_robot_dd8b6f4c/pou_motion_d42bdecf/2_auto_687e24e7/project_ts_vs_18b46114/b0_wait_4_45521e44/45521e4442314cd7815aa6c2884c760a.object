{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)45521e44-4231-4cd7-815a-a6c2884c760a","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B0_wait_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// về wait robot A (teaching Point 1)\nIF Wait_B4_Run THEN\n\tCASE PRO_B4_[0] OF\n\t\t0: // RESET\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\t\t\t\n\t\t\t\tPRO_B4_[0] := PRO_B4_[0] + 10;\n\t\t10: // Z WAIT\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 0, XYR_CONST := TRUE, Z_CONST:= FALSE);\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND ( B4_Run_P OR B4_Run_L) AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[0] := PRO_B4_[0] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // WAIT XY\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 0, XYR_CONST := FALSE, Z_CONST:= TRUE);\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[0] := PRO_B4_[0] + 10;\t\t\t \n\t\t\tEND_IF;\n\t\n\t\t30:\n\t\t\tWait_B4_Finish := TRUE;\n\t\t\n\tEND_CASE\nELSE\n\tPRO_B4_[0] := 0;\nEND_IF","LineInfoPersistence":"(string)45521e44-4231-4cd7-815a-a6c2884c760a_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)48"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}