{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)96d8bbc4-03a6-4aa6-8da1-85ccd0cd7fd6","ParentGuid":"(Guid)c00f9ee8-970d-4983-83b8-3aaea5126e60","Name":"(string)ACT_SET_DYNAMICLIMITS","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)WHILE GVL.HMI_MAIN.Enable_Dynamics_Limit DO\t\nFOR I := 0 TO 3 BY 1 DO\n\tVEL_A[I]\t:= GVL_1.DATA_RB_A.MAX_VEL;\n\tACC_A[I]\t:= GVL_1.DATA_RB_A.MAX_ACC;\n\tJERK_A[I]\t:= GVL_1.DATA_RB_A.MAX_JERK;\n\tTORQUE_A[I]\t:= GVL_1.DATA_RB_A.MAX_TOQUE;\n\t\n\tVEL_B[I]\t:= GVL_1.DATA_RB_B.MAX_VEL;\n\tACC_B[I]\t:= GVL_1.DATA_RB_B.MAX_ACC;\n\tJERK_B[I]\t:= GVL_1.DATA_RB_B.MAX_JERK;\n\tTORQUE_B[I]\t:= GVL_1.DATA_RB_B.MAX_TOQUE;\nEND_FOR;\nSMC_GroupSetAxisLimitFactors_A( AxisGroup \t\t:= SCARA_A, Execute := TRUE,\n\t\t\t\t\t\t\t\tVelFactors\t\t:= VEL_A,\n\t\t\t\t\t\t\t\tAccFactors\t\t:= ACC_A,\n\t\t\t\t\t\t\t\tJerkFactors\t\t:= JERK_A,\n\t\t\t\t\t\t\t\tTorqueFactors\t:= TORQUE_A,\n\t\t\t\t\t\t\t\tDone\t=>,\n\t\t\t\t\t\t\t\tBusy\t=>,\n\t\t\t\t\t\t\t\tError\t=>,\n\t\t\t\t\t\t\t\tErrorID\t=>);\nSMC_GroupSetAxisLimitFactors_B( AxisGroup \t\t:= SCARA_B, Execute := TRUE,\n\t\t\t\t\t\t\t\tVelFactors\t\t:= VEL_B,\n\t\t\t\t\t\t\t\tAccFactors\t\t:= ACC_B,\n\t\t\t\t\t\t\t\tJerkFactors\t\t:= JERK_B,\n\t\t\t\t\t\t\t\tTorqueFactors\t:= TORQUE_B,\n\t\t\t\t\t\t\t\tDone\t=>,\n\t\t\t\t\t\t\t\tBusy\t=>,\n\t\t\t\t\t\t\t\tError\t=>,\n\t\t\t\t\t\t\t\tErrorID\t=>);\nGVL.HMI_MAIN.Enable_Dynamics_Limit := FALSE;\t\nEND_WHILE;","LineInfoPersistence":"(string)96d8bbc4-03a6-4aa6-8da1-85ccd0cd7fd6_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)32"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}