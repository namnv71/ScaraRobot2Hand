{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)1ac2220c-750d-4a99-87dd-f92034ee3ef4","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_TestVisionTriggerResult","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_TestVisionTriggerResult\n// Test toàn bộ:\n// Trigger -> TriggerDone -> ResultReady -> kiểm tra Result -> Done\n//=============================================================================\n\n\n//=============================================================================\n// 1. CALL FB_TRIGGER\n// Camera 1, Job 1, Application ALIGN chỉ dùng làm cấu hình test ban đầu.\n//=============================================================================\nfbTriggerVS(\n    Enable := NOT xResetTest,\n    Start := xStartTrigger,\n    CameraID := 1,\n    JobID := 1,\n    Application := E_VisionApplication.VIS_APP_ALIGN,\n    count_Vs_Align_max := 3,\n    T_Delay_Trigger_time := 30,\n    Trigger_Again := FALSE,\n    Pass_Triger_VS_NG := FALSE,\n    Mode_ByPass_VS := FALSE\n);\n\n\n//=============================================================================\n// 2. CALL FB_WAIT_RESULT\n// ExpectedTriggerID lấy trực tiếp từ Trigger vừa thực hiện.\n//=============================================================================\nfbWaitResult(\n    Enable := TRUE,\n    Start := xStartWaitResult,\n    CameraID := 1,\n    ExpectedTriggerID := fbTriggerVS.CurrentTriggerID,\n    ExpectedJobID := 1,\n    ExpectedApplication := E_VisionApplication.VIS_APP_ALIGN\n);\n\n\n//=============================================================================\n// 3. RESET TEST\n//=============================================================================\nIF xResetTest THEN\n    iState := 0;\n\n    xStartTrigger := FALSE;\n    xStartWaitResult := FALSE;\n\n    xTestDone := FALSE;\n    xTestError := FALSE;\n    iTestErrorID := 0;\n\n    xStartTest := FALSE;\nEND_IF;\n\n\n//=============================================================================\n// 4. TEST STATE MACHINE\n//=============================================================================\nCASE iState OF\n\n    //-------------------------------------------------------------------------\n    // STATE 0 - IDLE\n    // Chờ lệnh bắt đầu test.\n    //-------------------------------------------------------------------------\n    0:\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        xTestDone := FALSE;\n        xTestError := FALSE;\n        iTestErrorID := 0;\n\n        IF xStartTest THEN\n            xStartTrigger := TRUE;\n            iState := 10;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 10 - WAIT TRIGGER DONE\n    // FB_TriggerVS gửi Trigger và chờ Vision xác nhận TriggerDone.\n    //-------------------------------------------------------------------------\n    10:\n        IF fbTriggerVS.Error THEN\n            xStartTrigger := FALSE;\n\n            xTestError := TRUE;\n            iTestErrorID := 100 + fbTriggerVS.ErrorID;\n\n            iState := 900;\n\n        ELSIF fbTriggerVS.DoneAll THEN\n            // Trigger đã hoàn thành.\n            // Giữ TriggerID hiện tại và chuyển sang chờ Result.\n            xStartTrigger := FALSE;\n            xStartWaitResult := TRUE;\n\n            iState := 20;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 20 - WAIT VISION RESULT\n    // Chờ Result đúng với TriggerID vừa gửi.\n    //-------------------------------------------------------------------------\n    20:\n        IF fbWaitResult.Error THEN\n            xStartWaitResult := FALSE;\n\n            xTestError := TRUE;\n            iTestErrorID := 200 + fbWaitResult.ErrorID;\n\n            iState := 900;\n\n        ELSIF fbWaitResult.Done THEN\n            xStartWaitResult := FALSE;\n\n            iState := 30;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 30 - TEST DONE\n    // X/Y/A/Score hiện có thể xem trực tiếp từ fbWaitResult.\n    //-------------------------------------------------------------------------\n    30:\n        xTestDone := TRUE;\n\n        // Nhả Start để chuẩn bị cho chu trình tiếp theo.\n        IF NOT xStartTest THEN\n            iState := 0;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 900 - ERROR\n    // Chờ nhả Start hoặc Reset.\n    //-------------------------------------------------------------------------\n    900:\n        xStartTrigger := FALSE;\n        xStartWaitResult := FALSE;\n\n        IF NOT xStartTest THEN\n            iState := 0;\n        END_IF;\n\nEND_CASE;","LineInfoPersistence":"(string)1ac2220c-750d-4a99-87dd-f92034ee3ef4_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_TestVisionTriggerResult\nVAR\n    //=========================================================\n    // Lệnh test từ Watch/HMI\n    //=========================================================\n    xStartTest : BOOL;                      // Cạnh lên bắt đầu một chu trình Vision.\n    xResetTest : BOOL;                      // Reset chu trình test.\n\n    //=========================================================\n    // State machine test\n    //=========================================================\n    iState : INT;                           // State hiện tại của chu trình test.\n\n    //=========================================================\n    // Điều khiển hai FB\n    //=========================================================\n    xStartTrigger : BOOL;                   // Start cho FB_TriggerVS.\n    xStartWaitResult : BOOL;                // Start cho FB_VisionWaitResult.\n\n    //=========================================================\n    // FB Vision\n    //=========================================================\n    fbTriggerVS : FB_TriggerVS;             // Gửi Trigger và chờ TriggerDone.\n    fbWaitResult : FB_VisionWaitResult;     // Chờ Result đúng TriggerID.\n\n    //=========================================================\n    // Kết quả test\n    //=========================================================\n    xTestDone : BOOL;                       // TRUE khi toàn bộ Trigger + Result hoàn thành.\n    xTestError : BOOL;                      // TRUE nếu một trong hai FB lỗi.\n    iTestErrorID : INT;                     // Mã lỗi tổng của test.\nEND_VAR","LineInfoPersistence":"(string)1ac2220c-750d-4a99-87dd-f92034ee3ef4_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)180","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}