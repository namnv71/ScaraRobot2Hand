{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)a6387f6f-e968-48dd-aac5-aa71cfe18f0a","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_GlueState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9e1f02d8-5bba-4bcc-a63a-6b70bdcae5c5"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_GlueState :\n(\n    GLUE_IDLE := 0,                  // Glue Manager đang rảnh.\n\n    GLUE_LOAD_PATH := 10,             // Nạp đường keo.\n    GLUE_VALIDATE_PATH := 20,         // Kiểm tra tính hợp lệ của đường keo.\n    GLUE_PROCESS_PATH := 30,          // Lọc và chuẩn hóa đường keo.\n    GLUE_PREPARE_QUEUE := 40,         // Chuyển path thành Motion Queue.\n    GLUE_MOVE_APPROACH := 50,         // Di chuyển tới vị trí approach.\n    GLUE_MOVE_START := 60,            // Di chuyển tới điểm đầu đường keo.\n    GLUE_PRE_FLOW := 70,              // Mở keo trước khi chạy.\n    GLUE_RUN_PATH := 80,              // Chạy đường keo.\n    GLUE_POST_FLOW := 90,             // Xử lý đóng keo tại cuối đường.\n    GLUE_MOVE_RETRACT := 100,         // Rút robot khỏi sản phẩm.\n    GLUE_COMPLETE := 110,             // Bôi keo hoàn thành.\n    GLUE_ABORTING := 120,             // Đang dừng quá trình bôi keo.\n\n    GLUE_ERROR := 900                 // Bôi keo gặp lỗi.\n);\nEND_TYPE","LineInfoPersistence":"(string)a6387f6f-e968-48dd-aac5-aa71cfe18f0a_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)22"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}