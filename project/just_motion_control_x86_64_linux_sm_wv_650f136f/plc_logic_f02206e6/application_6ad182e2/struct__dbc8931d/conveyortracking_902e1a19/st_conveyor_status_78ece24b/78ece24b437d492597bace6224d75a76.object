Lỗi conveyor axis.\n    ErrorID                 : UDINT;    // Mã lỗi.\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)78ece24b-437d-4925-97ba-ce6224d75a76_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)22"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}