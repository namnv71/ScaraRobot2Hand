{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)1f614abc-80f3-4a21-aaa3-f134a3cfa4c9","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_MultiToolTrackingStatus","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: MULTI-TOOL TRACKING STATUS\n//=============================================================================\nTYPE ST_MultiToolTrackingStatus :\nSTRUCT\n\n    // Xung báo đã nhận lệnh.\n    Accepted : BOOL;\n\n    // Application đang chạy.\n    Busy : BOOL;\n\n    // Application hoàn thành.\n    Done : BOOL;\n\n    // Application lỗi.\n    Error : BOOL;\n\n    // Mã lỗi.\n    ErrorID : UDINT;\n\n    // CommandID vừa xử lý.\n    ResponseCommandID : UDINT;\n\n    // State hiện tại.\n    State : E_MultiTrackState;\n\n    // Recipe đang chạy.\n    ActiveRecipeID : UINT;\n\n    // Tool đang được chọn.\n    SelectedToolID : UINT;\n\n    // Object đang được chọn.\n    SelectedObjectID : UDINT;\n\n    // Số sản phẩm đã gắp.\n    PickedCount : UINT;\n\n    // Số sản phẩm yêu cầu.\n    TargetPickCount : UINT;\n\n    // Bitmask Tool đang giữ sản phẩm.\n    OccupiedToolMask : DWORD;\n\n    // Tracking Core đã đồng bộ.\n    TrackingSyncOK : BOOL;\n\n    // PCS hiện đang InUse.\n    PCSInUse : BOOL;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)1f614abc-80f3-4a21-aaa3-f134a3cfa4c9_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)54"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}