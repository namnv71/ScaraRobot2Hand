{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9264c97a-8a15-47ef-9899-4ab54ffce088","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B2_PLace_T1_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Project_4_Delay_B2( PT := TO_TIME(GVL.Pro4_.ST_B.TDelay_Place_T1)*100);\nIF Place_B4_Run THEN\n\tCASE PRO_B4_[2] OF\n\t\t0: // RESET\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\t\n\t\t\t\tProject_4_Delay_B2.IN := FALSE;\t\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\n\t\t10: // Befor Place Z\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 2, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // Befor Place Xy\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 2, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n// \t\t\tIF (NOT GVL.Pro4_.ST_MC.Mode_Skip_VS_Align) THEN\n// \t\t\t\tM_CHOOSE_POS(DATA := 1, ID := 2, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n// \t\t\tELSE\n// \t\t\t\tM_CHOOSE_POS_VS(DATA := 1, ID := 2, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n// \t\t\tEND_IF;\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\t\t \n\t\t\tEND_IF;\n\t\t30:  // kiểm tra MC 1 cho phép đặt hàng\n\t\t\tIF GVL.Pro4_.Process.DATA_MC_TS = 2 AND GVL.Pro4_.Signal_In.T_Ts_Press_Up.Q THEN\n\t\t\t\tchange_fac_vel_max_B := TRUE; //namnv0204\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10; \t\n\t\t\tEND_IF\n\t\t40: // xy place\n\t\t\tIF (GVL.Pro4_.ST_MC.Mode_Skip_VS_Align) THEN\n\t\t\t\tM_CHOOSE_POS(DATA := 1, ID := 3, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 3\n\t\t\tELSE\n\t\t\t\tM_CHOOSE_POS_VS(DATA := 1, ID := 3, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 3\n\t\t\tEND_IF;\n// \t\t\tIF NOT B4_Run_P THEN\n\t\t\tIF NOT B4_Run_P AND (GVL.Fac_Vel_Set_B = GVL.Pro4_.Auto.Fac_Vel_Max_B) THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tIF NOT NextStep_Test_1 THEN\n\t\t\t\t\tB4_Run_P := TRUE;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 15;\t\t \n\t\t\tEND_IF;\n\t\t50: // z place BF 10mm\n\t\t\t//M_CHOOSE_POS(DATA := 1, ID := 3, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 3\n\t\t\tM_CHOOSE_POS_Z_BF(DATA := 1, ID := 3, XYR_CONST := TRUE, Z_CONST:= FALSE);\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 5;\t\t \n\t\t\tEND_IF;\t\t\t\n\t\t55: // z place T1\n\t\t\t//change_fac_vel_B := TRUE;\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 3, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 3\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 5;\t\t \n\t\t\t\tchange_fac_vel_B := FALSE;\n\t\t\tEND_IF;\t\t\n\t\t60: // OFF VACUUM\n\t\t\tGVL.RB_B_.Tool_1 := FALSE;\n\t\t\tProject_4_Delay_B2.IN:= TRUE ;\n\t\t\tIF Project_4_Delay_B2.Q AND B_Allow_NextStep  THEN\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10; \t\n\t\t\tEND_IF;\t\n\t\t70: // Z befor\n\t\t\t\n\t\t\tProject_4_Delay_B2.IN := FALSE;\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 2, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 2\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\t\t \n\t\t\tEND_IF;\t\n\t\t80: // xy befor place\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 2, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 2\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\t\t \n\t\t\t\tchange_fac_vel_max_B := FALSE; //namnv0204\n\t\t\tEND_IF;\t\t\n\t\t90: // Z wait\n\t\t\tchange_fac_vel_max_B := FALSE; //namnv0204\n\t\t\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 0;\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 0, XYR_CONST := TRUE, Z_CONST:= FALSE);\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND B_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[2] := PRO_B4_[2] + 10;\t\n\t\t\t\tMonitor_Production.Pulse_In := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out := TRUE;\t \n\t\t\tEND_IF;\t\t\n\t\t100: // finish\n\t\t\tPlace_B4_Finish := TRUE;\n\t\t\tMonitor_Production.Pulse_In := TRUE;\n\t\t\tMonitor_Production.Pulse_Out := FALSE;\n\t\n\tEND_CASE\nELSE\n\tPRO_B4_[2] := 0;\nEND_IF","LineInfoPersistence":"(string)9264c97a-8a15-47ef-9899-4ab54ffce088_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)175"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}