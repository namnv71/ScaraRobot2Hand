{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)cc1bed22-ec06-4e9c-a39d-54da4839cf0c","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_ToolConfig","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: TOOL CONFIG\n//=============================================================================\nTYPE ST_ToolConfig :\nSTRUCT\n\n    // Cho phép Tool.\n    Enable : BOOL;\n\n    // Cho phép Tool được sử dụng trong Tracking.\n    AllowTracking : BOOL;\n\n    // ID duy nhất của Tool.\n    ToolID : UINT;\n\n    // Tên hiển thị trên HMI.\n    ToolName : STRING[32];\n\n    // Loại Tool.\n    ToolType : E_ToolType;\n\n    // TCP thực tế đã hiệu chuẩn so với Flange.\n    ToolTCP : ST_POS;\n\n    // Offset gắp riêng của Tool so với Object Frame.\n    PickOffset : ST_POS;\n\n    // Độ cao Approach riêng của Tool.\n    ApproachHeight : REAL;\n\n    // TRUE nếu Tool có cơ cấu Up/Down độc lập.\n    UseUpDown : BOOL;\n\t// Hành trình cơ khí từ vị trí UP xuống vị trí DOWN, đơn vị mm.\n\tUpDownStroke : REAL;\n    // Cấu hình IO.\n    IO : ST_ToolIOConfig;\n\n    // Thời gian giả lập Down OK nếu không có DI.\n    DownTimeNoSensor : TIME;\n\n    // Thời gian giả lập Up OK nếu không có DI.\n    UpTimeNoSensor : TIME;\n\n    // Thời gian giả lập Grip OK nếu không có DI.\n    GripTimeNoSensor : TIME;\n\n    // Thời gian thực hiện Release nếu không có DI.\n    ReleaseTimeNoSensor : TIME;\n\n    // Timeout Down.\n    DownTimeout : TIME;\n\n    // Timeout Up.\n    UpTimeout : TIME;\n\n    // Timeout Grip.\n    GripTimeout : TIME;\n\n    // Timeout Release.\n    ReleaseTimeout : TIME;\n\n    // Delay xác nhận Grip OK ổn định.\n    GripConfirmDelay : TIME;\n\n    // Độ ưu tiên của Tool.\n    Priority : UINT;\n\n    // Product Class mà Tool được phép gắp.\n    // 0 = cho phép tất cả.\n    AllowedProductClassID : UINT;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)cc1bed22-ec06-4e9c-a39d-54da4839cf0c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)74"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}