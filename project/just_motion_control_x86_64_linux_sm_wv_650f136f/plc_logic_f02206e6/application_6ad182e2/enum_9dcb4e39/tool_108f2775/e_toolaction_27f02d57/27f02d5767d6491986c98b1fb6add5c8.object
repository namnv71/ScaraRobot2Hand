{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)27f02d57-67d6-4919-86c9-8b1fb6add5c8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_ToolAction","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)108f2775-569b-4785-8438-385044a841c4"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// ENUM: TOOL ACTION\n//-----------------------------------------------------------------------------\n// Lệnh mức cao gửi tới FB_ToolManager.\n//=============================================================================\n{attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_ToolAction :\n(\n    // Không có lệnh.\n    NONE := 0,\n\n    // Hạ cơ cấu Tool xuống.\n    DOWN := 10,\n\n    // Bật hút hoặc đóng kẹp.\n    GRIP := 20,\n\n    // Nâng cơ cấu Tool lên.\n    UP := 30,\n\n    // Nhả sản phẩm.\n    RELEASE := 40,\n\n    // Reset Tool.\n    RESET := 100\n);\nEND_TYPE\n","LineInfoPersistence":"(string)27f02d57-67d6-4919-86c9-8b1fb6add5c8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)29"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16