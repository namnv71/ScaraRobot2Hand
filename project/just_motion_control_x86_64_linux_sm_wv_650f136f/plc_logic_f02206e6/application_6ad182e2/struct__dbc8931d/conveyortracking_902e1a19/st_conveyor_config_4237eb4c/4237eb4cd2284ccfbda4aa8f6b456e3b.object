{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4237eb4c-d228-4ccf-bda4-aa8f6b456e3b","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_CONVEYOR_CONFIG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_CONVEYOR_CONFIG :\nSTRUCT\n    Enable                  : BOOL;     // Cho phép conveyor.\n    SimulationMode          : BOOL;     // Mô phỏng encoder.\n\n    ConveyorID              : UINT;     // ID conveyor.\n    DirectionSign           : SINT;     // 1: thuận; -1: đảo chiều.\n    ConveyorAngleDeg        : REAL;     // Góc conveyor so với X robot.\n\n//     PickZoneStartMM         : REAL;     // Đầu vùng gắp theo trục conveyor.\n//     PickZoneEndMM           : REAL;     // Cuối vùng gắp.\n//     ExpirePositionMM        : REAL;     // Vị trí object hết hiệu lực.\n\n    RunningThresholdMMs     : REAL;     // Ngưỡng xác định conveyor chạy.\n    MaxVelocityMMs          : REAL;     // Tốc độ lớn nhất, mm/s.\n    MaxAccelerationMMs2     : REAL;     // Gia tốc lớn nhất, mm/s².\n\n    VelocityFilterFactor    : REAL;     // Hệ số lọc vận tốc.\n    PCSNumber               : UINT;     // PCS 1 hoặc 2.\n\t// Mốc cuối cho phép bắt đầu thao tác gắp.\n    // Vượt mốc này mà chưa hút được vật thì phải abort.\n//     AbortPositionMM      : REAL;\n\tOrigin \t\t\t\t : ST_POS;\n\n    // Có thể đặt bằng hoặc xa hơn AbortPositionMM.\n    // Qua mốc này object không active sẽ bị EXPIRED.\n    // Project đã có ExpirePositionMM nên giữ nguyên.\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)4237eb4c-d228-4ccf-bda4-aa8f6b456e3b_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)29"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}