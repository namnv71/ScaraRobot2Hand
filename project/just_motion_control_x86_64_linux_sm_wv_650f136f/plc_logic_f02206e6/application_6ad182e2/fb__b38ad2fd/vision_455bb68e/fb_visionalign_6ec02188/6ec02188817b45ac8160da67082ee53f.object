{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6ec02188-817b-45ac-8160-da67082ee53f","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionAlign","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)455bb68e-496e-4125-829d-ed46387b0a41"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_VisionAlign - SIMPLE VERSION\n//-----------------------------------------------------------------------------\n// FB này không tự xử lý Modbus.\n// Không tự gọi FB_TriggerVS / FB_VisionWaitResult.\n// Toàn bộ Trigger + nhận Result giao cho FB_VisionGetResult.\n//=============================================================================\n\n\n//=============================================================================\n// CALL FB VISION GET RESULT\n//=============================================================================\nfbVisionGetResult(\n    Enable := Enable,\n    Start := xStartVision,\n    CameraID := CameraID,\n    JobID := JobID,\n    Application := E_VisionApplication.VIS_APP_ALIGN\n);\n\n\n//=============================================================================\n// RESET\n//=============================================================================\nIF NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n    xStartVision := FALSE;\n\n    Busy := FALSE;\n    Done := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    HeaderOK := FALSE;\n    TriggerID := 0;\n\n    VisionX := 0.0;\n    VisionY := 0.0;\n    VisionZ := 0.0;\n    VisionA := 0.0;\n    VisionScore := 0.0;\n    VisionFeatureID := 0;\n\n    ResultValid := FALSE;\n    ResultStatus := E_VisionResultStatus.VIS_RESULT_NONE;\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// STATE MACHINE\n//=============================================================================\nCASE State OF\n\n    //=========================================================================\n    // 0 - IDLE\n    //=========================================================================\n    0:\n        Busy := FALSE;\n        Done := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        xStartVision := FALSE;\n        HeaderOK := FALSE;\n\n        IF Start AND NOT StartOld THEN\n            Busy := TRUE;\n\n            xStartVision := TRUE;\n\n            State := 10;\n        END_IF;\n\n\n    //=========================================================================\n    // 10 - WAIT VISION RESULT\n    //=========================================================================\n    10:\n        Busy := TRUE;\n\n        IF fbVisionGetResult.Error THEN\n            xStartVision := FALSE;\n\n            Error := TRUE;\n            ErrorID := fbVisionGetResult.ErrorID;\n\n            State := 900;\n\n        ELSIF fbVisionGetResult.Done THEN\n            xStartVision := FALSE;\n\n            State := 20;\n        END_IF;\n\n\n    //=========================================================================\n    // 20 - COPY VISION RESULT\n    //=========================================================================\n    20:\n        HeaderOK := fbVisionGetResult.HeaderOK;\n        TriggerID := fbVisionGetResult.TriggerID;\n\n        VisionX := fbVisionGetResult.X;\n        VisionY := fbVisionGetResult.Y;\n        VisionZ := fbVisionGetResult.Z;\n        VisionA := fbVisionGetResult.A;\n        VisionScore := fbVisionGetResult.Score;\n        VisionFeatureID := fbVisionGetResult.FeatureID;\n\n        ResultValid := fbVisionGetResult.ResultValid;\n        ResultStatus := fbVisionGetResult.ResultStatus;\n\n        State := 30;\n\n\n    //=========================================================================\n    // 30 - ALIGN RESULT READY\n    //-------------------------------------------------------------------------\n    // Hiện tại chưa xử lý Transform / Correction.\n    // Chỉ xác nhận đã nhận được dữ liệu Vision.\n    //=========================================================================\n    30:\n        IF HeaderOK THEN\n            Busy := FALSE;\n            Done := TRUE;\n\n            State := 100;\n        ELSE\n            Error := TRUE;\n            ErrorID := 301;                  // Không có Header hợp lệ.\n\n            State := 900;\n        END_IF;\n\n\n    //=========================================================================\n    // 100 - DONE\n    //=========================================================================\n    100:\n        Busy := FALSE;\n        Done := TRUE;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\n\n    //=========================================================================\n    // 900 - ERROR\n    //=========================================================================\n    900:\n        Busy := FALSE;\n        Done := FALSE;\n\n        xStartVision := FALSE;\n\n        IF NOT Start THEN\n            Error := FALSE;\n            ErrorID := 0;\n\n            State := 0;\n        END_IF;\n\nEND_CASE;\n\n\n//=============================================================================\n// SAVE START\n//=============================================================================\nStartOld := Start;","LineInfoPersistence":"(string)6ec02188-817b-45ac-8160-da67082ee53f_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionAlign\nVAR_INPUT\n    Enable : BOOL;                              // Cho phép FB hoạt động.\n    Start : BOOL;                               // Bắt đầu một lần Align.\n    CameraID : UINT;                            // Camera sử dụng.\n    JobID : UINT;                               // Job Vision Align.\nEND_VAR\n\nVAR_OUTPUT\n    Busy : BOOL;                                // Đang chạy.\n    Done : BOOL;                                // Hoàn thành.\n    Error : BOOL;                               // Có lỗi.\n    ErrorID : INT;                              // Mã lỗi.\n    State : INT;                                // State monitor.\n\n    HeaderOK : BOOL;                            // Đã nhận Header hợp lệ.\n    TriggerID : UDINT;                          // TriggerID của Result.\n\n    VisionX : REAL;                             // X Vision trả về.\n    VisionY : REAL;                             // Y Vision trả về.\n    VisionZ : REAL;                             // Z Vision trả về.\n    VisionA : REAL;                             // Theta Vision trả về.\n    VisionScore : REAL;                         // Score Vision.\n    VisionFeatureID : UINT;                     // FeatureID Vision.\n\n    ResultValid : BOOL;                         // Valid từ Vision.\n    ResultStatus : E_VisionResultStatus;        // Status Vision.\nEND_VAR\n\nVAR\n    StartOld : BOOL;                            // Start scan trước.\n    xStartVision : BOOL;                        // Start FB VisionGetResult.\n\n    fbVisionGetResult : FB_VisionGetResult;     // FB Trigger + nhận Result.\nEND_VAR","LineInfoPersistence":"(string)6ec02188-817b-45ac-8160-da67082ee53f_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)208","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}