{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)52ad4e0c-2370-4a7a-bee1-88fe5ef55bc6","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_TrackingSelectMode","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)0710103f-fbdc-4582-87a9-dd50a9877f7d"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_TrackingSelectMode :\n(\n\t// Không tự động chọn object.\n    // Chỉ dùng khi Application chỉ định trực tiếp ObjectID.\n    TRACK_SELECT_NONE := 0,\n\n    // Chọn object có CaptureTime nhỏ nhất.\n    // Tương đương object được camera ghi nhận sớm nhất.\n    TRACK_SELECT_FIFO := 10,\n\n    // Chọn object nằm gần giới hạn thoát/AbortPosition nhất.\n    // Phù hợp khi ưu tiên cứu object sắp ra khỏi vùng gắp.\n    TRACK_SELECT_NEAREST_EXIT := 20,\n\n    // Chọn object có TimeRemainingSec nhỏ nhất.\n    // Đây là kiểu Earliest Deadline First.\n    TRACK_SELECT_MIN_TIME_REMAIN := 30,\n\n    // Chọn object có Priority lớn nhất.\n    // Nếu Priority bằng nhau thì dùng TimeRemainingSec nhỏ hơn.\n    TRACK_SELECT_HIGHEST_PRIORITY := 40,\n\n    // Chọn object có VisionScore lớn nhất.\n    // Nếu VisionScore bằng nhau thì dùng TimeRemainingSec nhỏ hơn.\n    TRACK_SELECT_HIGHEST_VISION_SCORE := 50,\n\n    // Chọn object có EstimatedPickTimeSec nhỏ nhất.\n    // Dùng khi vị trí object khác nhau làm thời gian robot tiếp cận khác nhau.\n    TRACK_SELECT_SHORTEST_PICK_TIME := 60,\n\n    // Chọn đúng ObjectID do Application yêu cầu.\n    TRACK_SELECT_SPECIFIC_ID := 70\n);\nEND_TYPE\n","LineInfoPersistence":"(string)52ad4e0c-2370-4a7a-bee1-88fe5ef55bc6_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)37"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}