{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)af4596f1-a0a5-4003-900d-5329869c2c34","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B3_Barcode_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//Project_4_Delay_B3(PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Barcode_Ts)*100);\nT_Wait_Trigger_Bar_TS( PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Barcode_Ts)*100);\nIF Barcode_B4_Run THEN\n\tCASE PRO_B4_[3] OF\n\t\t0: // RESET\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\t\n\t\t\t\t//Project_4_Delay_B3.in := FALSE;\t\t\n\t\t\t\tcount_Ts := 0;  // namnv \n\t\t\t\tPRO_B4_[3] := PRO_B4_[3] + 10;\n\t\t10: // XY barcode\n\t\t\tIF (GVL.Pro4_.ST_MC.Mode_Skip_VS_Align) THEN\n\t\t\t\tM_CHOOSE_POS(DATA := 1, ID := 4, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 4 barcode\n\t\t\tELSE\n\t\t\t\tM_CHOOSE_POS_VS(DATA := 1, ID := 4, XYR_CONST := FALSE, Z_CONST:= TRUE);\n\t\t\tEND_IF;\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tIF NOT NextStep_Test THEN\n\t\t\t\t\tB4_Run_P := TRUE;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[3] := PRO_B4_[3] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // Barcode Z\n\t\t\t\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 4, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 4 barcode\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P :=FALSE;\t\n\t\t\t\tPRO_B4_[3] := PRO_B4_[3] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t30: // Trigger Barcode\n\t\t\t// Ontrigger\n\t\t\tCASE D_Barcode_Ts OF\n\t\t\t\t0:\n\t\t\t\t\tIF GVL.Pro4_.ST_MC.Mode_Skip_Barcode_ts THEN\n\t\t\t\t\t\tD_Barcode_Ts := 30;\n\t\t\t\t\tELSE\n\t\t\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off := 1;\n\t\t\t\t\t\t\t//Project_4_Delay_B3.IN := TRUE;\n\t\t\t\t\t\t//IF GVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off = 1 AND Project_4_Delay_B3.q THEN\t\n\t\t\t\t\t\tIF GVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off = 1 THEN\n\t\t\t\t\t\t\tD_Barcode_Ts := D_Barcode_Ts +10;\n\t\t\t\t\t\tEND_IF\t\t\t\t\t\t\n\t\t\t\t\tEND_IF\n\n\t\t\t\t10:\n\t\t\t\t\t//Project_4_Delay_B3.IN := FALSE;\n\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off := 0;\n\t\t\t\t\tIF GVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off = 0 THEN\n\t\t\t\t\t\tcount_Ts := count_Ts +1;\n\t\t\t\t\t\tD_Barcode_Ts := D_Barcode_Ts +10;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_TS.IN := TRUE;\n\t\t\t\t\tEND_IF\n\t\t\t\t20:\n\t\t\t\t\tIF GVL.Pro4_.Signal_In.T_Ts_Result_Scanner.Q OR  GVL.X[31] THEN\n\t\t\t\t\t\tD_Barcode_Ts := D_Barcode_Ts +10;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_TS.IN := FALSE;\n\t\t\t\t\tELSIF NOT GVL.Pro4_.Signal_In.T_Ts_Result_Scanner.Q AND NOT GVL.X[31]  AND count_Ts <= 5 AND T_Wait_Trigger_Bar_TS.Q THEN\n\t\t\t\t\t\tD_Barcode_Ts := 0;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_TS.IN := FALSE;\n\t\t\t\t\tEND_IF\n\t\t\t\t30:\n\t\t\t\t\t// ok\t\n\t\t\tEND_CASE;\n\t\t\tIF count_Ts > 5 AND (GVL.X[8] OR gvl.Pro4_.Process.Re_Trigger_Barcode_Ts) THEN\n\t\t\t\tcount_Ts := 0;\n\t\t\tEND_IF\n\t\t\tIF count_Ts > 5 AND D_Barcode_Ts = 20 AND NOT GVL.Pro4_.Auto.Alarm_Not_barcode  THEN\n\t\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode := TRUE;\n\t\t\tELSIF GVL.Pro4_.Auto.Alarm_Not_barcode AND GVL.Pro4_.Auto.comfirm_Reduct_Pro THEN\n\t\t\t\tcount_Ts:=0;\n\t\t\t\tPRO_B4_[3] := 50; \t\n\t\t\tEND_IF\n\t\t\t\n\n\t\t\tIF D_Barcode_Ts = 30 AND A_Allow_NextStep  THEN\n\t\t\t\tcount_Ts:=0;\n\t\t\t\tPRO_B4_[3] := PRO_B4_[3] + 10; \t\n\t\t\tEND_IF;\n\t\t\t\n\t\t40: // Z WAIT\n\t\t\t\n\t\t\tD_Barcode_Ts := 0;\n\t\t\t//Project_4_Delay_B3.IN := FALSE;\n\t\t\tM_CHOOSE_POS(DATA := 1, ID := 0, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos wait\n\t\t\tIF NOT B4_Run_P THEN\n\t\t\t\tB_Comp := FALSE;\n\t\t\t\tB4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_B.Error OR MOVL_B.Error THEN\n\t\t\t\tB4_Run_L\t:= FALSE;\n\t\t\t\tB4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF B_Comp AND B4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tB4_Run_L\t := FALSE;\n\t\t\t\tB4_Run_P\t := FALSE;\n\t\t\t\tB_Comp\t\t := FALSE;\n\t\t\t\tPRO_B4_[3] := PRO_B4_[3] + 10;\t\t \n\t\t\tEND_IF;\t\t\n\t\t50:\n\t\t\tIF GVL.Pro4_.Auto.comfirm_Reduct_Pro THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 0; // trigger barcode OK\n\t\t\tELSE \n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_B1_IN := 2; // trigger barcode OK\n\t\t\tEND_IF\n\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode := FALSE;\n\t\t\tBarcode_B4_Finish := TRUE;\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_B4_[3] := 0;\nEND_IF","LineInfoPersistence":"(string)af4596f1-a0a5-4003-900d-5329869c2c34_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)134"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}