{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f3ec248e-fcac-4109-857a-41b2e7141ee8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_MultiToolTrackingRecipe","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: MULTI-TOOL TRACKING RECIPE\n//=============================================================================\nTYPE ST_MultiToolTrackingRecipe :\nSTRUCT\n\n    // Cho phép Recipe.\n    Enable : BOOL;\n\n    // ID Recipe.\n    RecipeID : UINT;\n\n    // Tên Recipe.\n    RecipeName : STRING[32];\n\n    // Nguồn Object.\n    ObjectSourceType : E_ObjectSourceType;\n\n\t// Nguồn Vision cần sử dụng.\n\t// 0 = không lọc Source nếu anh muốn giữ chế độ wildcard.\n\tVisionSourceID : UINT;\n\n    // Vision Job nếu dùng Vision.\n    VisionJobID : UINT;\n\n    // Sensor Source nếu dùng Sensor.\n    SensorSourceID : UINT;\n\n    // Bitmask các Tool được phép sử dụng.\n    ToolEnableMask : DWORD;\n\n    // Số sản phẩm cần gắp trong một lệnh TRACK_ON.\n    TargetPickCount : UINT;\n\n    // Cho phép Done khi chưa đủ số lượng nhưng đã có ít nhất một sản phẩm.\n    AllowPartialPick : BOOL;\n\n    // Product Class cần gắp.\n    // 0 = tất cả.\n    ProductClassID : UINT;\n\t\n\t// Cao độ mặt cần hút của sản phẩm tính từ Object reference/conveyor plane.\n    // Đơn vị: mm.\n    PickSurfaceHeightMM : REAL;\n\n    // Score Vision tối thiểu.\n    MinimumVisionScore : REAL;\n\n\n    // Timeout chờ Object.\n    ObjectWaitTimeout : TIME;\n\n    // Timeout toàn chu trình.\n    TotalTrackingTimeout : TIME;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)f3ec248e-fcac-4109-857a-41b2e7141ee8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)58"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}