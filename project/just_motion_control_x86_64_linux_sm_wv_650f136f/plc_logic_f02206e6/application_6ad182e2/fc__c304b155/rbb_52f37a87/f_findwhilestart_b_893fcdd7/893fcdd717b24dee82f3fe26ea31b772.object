{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)893fcdd7-17b2-4dee-82f3-fe26ea31b772","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_FindWhileStart_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)52f37a87-998e-43fa-bf3b-aad613d24cf5"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// IMPLEMENTATION\n//====================================================\n// Tìm WHILE tương ứng khi đang đứng tại END_WHILE\n// Quét ngược và hỗ trợ WHILE lồng nhau\n//====================================================\n\ndepth := 0;\n\nFOR i := EndWhileStep - 1 TO 1 BY -1 DO\n\n    cmd := GVL_1.Step_Cr_B[i].Cmd;\n\n    CASE cmd OF\n\n        E_RobotCmd.CMD_END_WHILE:\n            depth := depth + 1;\n\n\n        E_RobotCmd.CMD_WHILE,\n        E_RobotCmd.CMD_WHILE_IN,\n        E_RobotCmd.CMD_WHILE_REG:\n            IF depth = 0 THEN\n                F_FindWhileStart_B := i;\n                RETURN;\n            ELSE\n                depth := depth - 1;\n            END_IF;\n\n    END_CASE;\n\nEND_FOR;\n\nF_FindWhileStart_B := 1;\n\n\n\n\n// E_RobotCmd.CMD_ELSE:\n//     // Nếu đã chạy nhánh IF TRUE, gặp ELSE thì bỏ qua ELSE block\n//     GVL.A_RunStep := F_FindEndIf_B(GVL.A_RunStep);\n//     GVL.A_RunState := 0;\n// \n\n// E_RobotCmd.CMD_END_IF:\n//     // Kết thúc IF block\n//     GVL.A_RunStep := GVL.A_RunStep + 1;\n//     GVL.A_RunState := 0;\n// \n// \n// E_RobotCmd.CMD_WHILE:\n//     // P1 = Condition No\n//     IF F_EvalCondition_B(step_PRG_A_Interpreter.P1) THEN\n//         GVL.A_RunStep := GVL.A_RunStep + 1;\n//     ELSE\n//         GVL.A_RunStep := F_FindEndWhile_B(GVL.A_RunStep);\n//     END_IF;\n// \n//     GVL.A_RunState := 0;\n// \n// \n// E_RobotCmd.CMD_END_WHILE:\n//     // Quay lại đầu WHILE để kiểm tra điều kiện lại\n//     GVL.A_RunStep := F_FindWhileStart_B(GVL.A_RunStep);\n//     GVL.A_RunState := 0;","LineInfoPersistence":"(string)893fcdd7-17b2-4dee-82f3-fe26ea31b772_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_FindWhileStart_B : INT\nVAR_INPUT\n    EndWhileStep : INT;\nEND_VAR\nVAR\n    i : INT;\n    depth : INT;\n    cmd : E_RobotCmd;\nEND_VAR\n","LineInfoPersistence":"(string)893fcdd7-17b2-4dee-82f3-fe26ea31b772_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)74","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}