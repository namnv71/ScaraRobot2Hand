{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)52ce973f-1798-4c8b-9d93-cf4b9fdf2168","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_MotionQueueItem","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)7f315991-6d02-4b13-a2b8-2360b7f65711"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_MotionQueueItem :\nSTRUCT\n    Cmd        : E_RobotCmd; // Lệnh Motion: MovP, MovL, MovC\n    SourceStep : INT;        // Step gốc để debug lỗi\n\n    PointNo    : INT;        // Point dùng cho MovP / MovL\n    MidPointNo : INT;        // Point giữa cho MovC\n    EndPointNo : INT;        // Point cuối cho MovC\n\n    Speed : LREAL;           // Speed override, =0 thì dùng Set Speed hiện hành\n\n    BlendMode   : INT;       // 0=None, 1=TMCornerDistance, 2=TMStartVelocity\n    BlendRadius : LREAL;     // TransitionParameter[0]\n\n    CircleMode : INT;        // Dùng cho MovC\n    PathChoice : INT;        // Dùng cho MovC\n\tSkipPositionCheck : BOOL; // Xac dinh co check vi tri co dinh khong\n\t\n\t//==================== MEMBER MỚI ====================\n    // TRUE: bỏ PointNo và sử dụng DirectPosition.\n    UseDirectPosition : BOOL;\n\n    // Tọa độ động do Application tạo ra.\n    DirectPosition : ST_POS;\n\n    // Hệ tọa độ của DirectPosition.\n    DirectCoordSystem : SMC_COORD_SYSTEM;\n\n    // Dynamic riêng. Giá trị <= 0 dùng thông số chung hiện tại.\n    Acceleration : LREAL;\n    Deceleration : LREAL;\n    Jerk : LREAL;\n\n    // ID nguồn để Application đối chiếu Done/Error.\n    ApplicationCommandID : UDINT;\n\t\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)52ce973f-1798-4c8b-9d93-cf4b9fdf2168_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)38"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}