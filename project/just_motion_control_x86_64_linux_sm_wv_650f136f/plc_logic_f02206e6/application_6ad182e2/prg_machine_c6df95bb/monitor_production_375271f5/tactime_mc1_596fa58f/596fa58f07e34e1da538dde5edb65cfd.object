{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)596fa58f-07e3-4e1d-a538-dde5edb65cfd","ParentGuid":"(Guid)375271f5-d5cb-47c6-987f-89a997b63457","Name":"(string)Tactime_MC1","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Pulse_In_1 := (POU_MOTION.Pro_MC1_4 = 20) ;\n// \n// T2(IN := POU_MOTION.RUN_PROJECT, PT := T#1H);   // chạy free-run (1h cho khỏi overflow sớm)\n// \n// // lấy thời gian đã trôi qua\n//     Tact_ms_1 := TO_DWORD(T2.ET)/100;\n// IF (Pulse_In_1 = TRUE) AND (Pulse_Old_1 = FALSE) THEN\n// \t\n// \n// \n//     // reset timer để đo lần tiếp theo\n//     T2(IN := FALSE);\n//     T2(IN := TRUE);\n// \n//     // ===== DỊCH MẢNG =====\n//     FOR i_tactime_input_1 := 9 TO 1 BY -1 DO\n//         Tact_Array_1[i_tactime_input_1] := Tact_Array_1[i_tactime_input_1-1];\n//     END_FOR\n// \n//     // ===== GHI GIÁ TRỊ MỚI NHẤT =====\n//     Tact_Array_1[0] := TO_WORD(Tact_ms_1);\n// \n//     // đếm số mẫu\n//     IF Count_1 < 10 THEN\n//         Count_1 := Count_1 + 1;\n//     END_IF\n// \n// END_IF\n// \n// Pulse_Old_1 := Pulse_In_1;\n\n// Pulse_In_1 := (POU_MOTION.Pro_MC1_4 = 20) ;\n\nT2(PT := T#1H);   // chạy free-run (1h cho khỏi overflow sớm)\nIF Pulse_In_1 THEN\n\tT2.IN := TRUE;\nEND_IF\n// lấy thời gian đã trôi qua\n    Tact_ms_1 := TO_DWORD(T2.ET)/100;\nIF (Pulse_Out_1 = TRUE) AND (Pulse_Old_1 = FALSE) THEN\n\t\n\n\t\n    // reset timer để đo lần tiếp theo\n    T2(IN := FALSE);\n    //T2(IN := TRUE);\n\n    // ===== DỊCH MẢNG =====\n    FOR i_tactime_input_1 := 9 TO 1 BY -1 DO\n        Tact_Array_1[i_tactime_input_1] := Tact_Array_1[i_tactime_input_1-1];\n    END_FOR\n\n    // ===== GHI GIÁ TRỊ MỚI NHẤT =====\n    Tact_Array_1[0] := TO_WORD(Tact_ms_1);\n\n    // đếm số mẫu\n    IF Count_1 < 10 THEN\n        Count_1 := Count_1 + 1;\n    END_IF\n\nEND_IF\n\nPulse_Old_1 := Pulse_Out_1;\n\n\n/// Avg tactime\nSum_Tact_1 := 0;\n\nFOR i_tactime_input_1 := 0 TO Count_1 - 1 DO\n    Sum_Tact_1 := Sum_Tact_1 + Tact_Array_1[i_tactime_input_1];\nEND_FOR\n\nIF Count_1 > 0 THEN\n    Avg_Tact_1 := Sum_Tact_1 / Count_1;\nEND_IF","LineInfoPersistence":"(string)596fa58f-07e3-4e1d-a538-dde5edb65cfd_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)75"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}