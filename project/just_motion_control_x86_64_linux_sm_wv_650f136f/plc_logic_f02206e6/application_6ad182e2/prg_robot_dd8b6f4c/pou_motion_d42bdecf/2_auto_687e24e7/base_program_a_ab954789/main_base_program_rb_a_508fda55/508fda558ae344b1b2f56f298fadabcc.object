{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)508fda55-8ae3-44b1-b2f5-6f298fadabcc","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)Main_Base_Program_RB_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)ab954789-01a8-4bd7-845f-ff1c02d5e799"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//====================================================\n// PRG_A_Interpreter\n// Controlled Pipeline:\n// - Motion được nạp trước tối đa A_PipelineDepth lệnh.\n// - A_RunStep chỉ tăng khi step hiện tại Done thật.\n// - Gặp lệnh logic thì chờ Motion Queue + Slot sạch.\n//====================================================\n\n\n\n//====================================================\n// STOP COMMAND\n//====================================================\nIF GVL.A_RunStop OR GVL.X[7] THEN\n\n    // Dừng Interpreter\n    GVL.A_RunEnable := FALSE;\n    GVL.A_RunBusy := FALSE;\n    GVL.A_RunDone := FALSE;\n    GVL.A_RunPause := FALSE;\n    GVL.A_RunState := 0;\n    // GVL.A_RunStop := FALSE;\n\n    // Dừng pipeline\n    GVL.A_PipelineActive := FALSE;\n    GVL.A_PushMotionReq := FALSE;\n    GVL.A_PushMotionDone := FALSE;\n    GVL.A_PushMotionError := FALSE;\n\t// 1707\n\t//------------------------------------------------\n    // Reset bộ nhớ cạnh của FB Push\n    //------------------------------------------------\n    fbPushMotion(\n        Execute := FALSE,\n        Item := GVL.A_PushMotionItem\n    );\n\n    // Yêu cầu MotionManager abort toàn bộ motion pipeline\n    GVL.A_MotionAbortReq := TRUE;\n\t\n\t// Dừng command Tracking đang chạy.\n\tIF GVL.A_StepActive THEN\n\t\tGVL.g_stMultiTrackCommandA.Abort := TRUE;\n\t\tGVL.g_stMultiTrackCommandA.Execute := FALSE;\n\t\n\t\tGVL.A_StepActive := FALSE;\n\t\tudiTrackCommandIDA := 0;\n\tEND_IF;\n\t\n\t// Hủy Tool command từ Interpreter.\n\tGVL.g_stInterpreterToolCommandA.Execute := FALSE;\n\tGVL.g_stInterpreterToolCommandA.Abort := TRUE;\n\t\n\tudiToolReleaseCommandIDA := 0;\n\t// GVL.A_StepActive := FALSE;\n\t//GVL.g_axDORequestToolA[4] := FALSE;\n\t\n\t//xVisionAlignStartA := FALSE;\n\t// Hủy Vision Request khi Stop/Disable Robot A.\n\n    //=============================================================================\n\t// ABORT VISION REQUEST - ROBOT A\n\t//-----------------------------------------------------------------------------\n\t// Khi Robot Stop, Robot không phát Request mới và hạ Execute hiện tại.\n\t// Vision Manager sẽ thực hiện phần reset handshake phía Manager.\n\t//=============================================================================\n\tGVL.g_stVisionAlignRequestA.Execute := FALSE;\n\txVisionStepActiveA := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//====================================================\n// NOT ENABLE\n//====================================================\nIF NOT GVL.A_RunEnable THEN\n    GVL.A_RunBusy := FALSE;\n    GVL.A_RunState := 0;\n    GVL.A_PushMotionReq := FALSE;\n    GVL.A_PipelineActive := FALSE;\n\tGVL.A_RunAlarm := FALSE;\n\tGVL.A_RunStep := 1;\n\t\n\tGVL.g_stMultiTrackCommandA.Execute := FALSE;\n\tGVL.g_stMultiTrackCommandA.Abort := FALSE;\n\tGVL.g_stMultiTrackCommandA.Reset := FALSE;\n\t\n\tGVL.A_StepActive := FALSE;\n\tudiTrackCommandIDA := 0;\n\t\n\tGVL.g_stInterpreterToolCommandA.Execute := FALSE;\n\tGVL.g_stInterpreterToolCommandA.Abort := FALSE;\n\tGVL.g_stInterpreterToolCommandA.Reset := FALSE;\n\t\n\tudiToolReleaseCommandIDA := 0;\n\t\n\t// Reset command Vision của Interpreter.\n\t//xVisionAlignStartA := FALSE;\n// \tuiVisionCameraIDA := 1;\n// \tuiVisionJobIDA := 1;\n\n\t// Hủy Vision Request khi Stop/Disable Robot A.\n\n    GVL.g_stVisionAlignRequestA.Execute := FALSE;   // Hạ Request để Manager kết thúc handshake.\n\n    xVisionStepActiveA := FALSE;                    // Xóa ownership command Vision Robot A.\n\n    uiVisionCameraIDA := 1;                         // Reset CameraID mặc định nếu cần.\n\n    uiVisionJobIDA := 1;                            // Reset JobID mặc định nếu cần.\n\n    iVisionResultVarA := 0;                         // Reset index biến kết quả.\n\t\n\tGVL.A_VisionDone := FALSE;\n\tGVL.A_VisionOK := FALSE;\n\tGVL.A_VisionError := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//====================================================\n// PAUSE\n// Pause chỉ dừng Interpreter, không reset Motion đang chạy\n//====================================================\nIF GVL.A_RunPause THEN\n    GVL.A_RunBusy := TRUE;\n    RETURN;\nEND_IF;\n\n\n//====================================================\n// ALARM\n//====================================================\nIF GVL.A_RunAlarm THEN\n    GVL.A_RunBusy := FALSE;\n    GVL.A_PushMotionReq := FALSE;\n    GVL.A_PipelineActive := FALSE;\n\n    // Khi lỗi thì yêu cầu MotionManager ngừng cấp lệnh mới\n    GVL.A_MotionAbortReq := TRUE;\n\n    RETURN;\nEND_IF;\n\n\n//====================================================\n// RUNNING\n//====================================================\nGVL.A_RunBusy := TRUE;\n\n\n//====================================================\n// CHECK STEP RANGE\n//====================================================\nIF GVL.A_RunStep < 1 THEN\n    GVL.A_RunStep := 1;\nEND_IF;\n\nIF GVL.A_RunStep > GVL.A_LengthStep THEN\n    GVL.A_RunEnable := FALSE;\n    GVL.A_RunBusy := FALSE;\n    GVL.A_RunDone := TRUE;\n    GVL.A_RunState := 0;\n    GVL.A_PipelineActive := FALSE;\n    GVL.A_PushMotionReq := FALSE;\n\tGVL.A_RunStep := 1;\n    RETURN;\nEND_IF;\n\n\n//====================================================\n// STEP RUN EDGE\n// Bắt xung nút chạy từng bước từ HMI\n//====================================================\nGVL.A_StepRunEdge := GVL.A_StepRunReq AND NOT GVL.A_LastStepRunReq;\nGVL.A_LastStepRunReq := GVL.A_StepRunReq;\n\n\n//====================================================\n// STEP HOLD\n// Nếu đang ở chế độ Step và đang Hold\n// thì chỉ chạy tiếp khi có xung StepRun\n//====================================================\nIF GVL.A_RunMode = 1 THEN\n\n    IF GVL.A_StepHold THEN\n\n        IF GVL.A_StepRunEdge THEN\n            // Cho phép chạy 1 step tiếp theo\n            GVL.A_StepHold := FALSE;\n        ELSE\n            // Chưa bấm Step thì đứng yên\n            GVL.A_RunBusy := TRUE;\n            RETURN;\n        END_IF;\n\n    END_IF;\n\nEND_IF;\n\n\nCASE GVL.A_RunState OF\n\n    0: // READ STEP\n\n        step_PRG_A_Interpreter := GVL_1.Step_Cr_A[GVL.A_RunStep];\n\n        IF F_IsMotionCmd(step_PRG_A_Interpreter.Cmd) THEN\n\n            // Bắt đầu pipeline tại step hiện tại\n            GVL.A_PipelineActive := TRUE;\n\n            // Step tiếp theo cần push vào motion queue\n            GVL.A_PipelineNextPushStep := GVL.A_RunStep;\n\n            GVL.A_RunState := 100;\n\n        ELSE\n\n            // Lệnh logic chỉ được chạy khi toàn bộ motion đã sạch\n            IF (GVL.A_MotionCount <= 0) AND (GVL.A_ActiveMotionCount <= 0) THEN\n                GVL.A_RunState := 10;\n            ELSE\n                GVL.A_RunState := 130;\n            END_IF;\n\n        END_IF;\n\n\n    10: // EXECUTE LOGIC COMMAND\n\n        step_PRG_A_Interpreter := GVL_1.Step_Cr_A[GVL.A_RunStep];\n\n        CASE step_PRG_A_Interpreter.Cmd OF\n\n            E_RobotCmd.CMD_NOP:\n                GVL.A_RunStep := GVL.A_RunStep + 1;\n                GVL.A_RunState := 0;\n\n\n            E_RobotCmd.CMD_Set_Speed:\n                // P1 = Speed, P2 = Acc, P3 = Dec, P4 = Jerk\n                GVL.A_CurrentMotionParam.Speed := INT_TO_LREAL(step_PRG_A_Interpreter.P1);\n                GVL_1.DATA_RB_A.MOTION_ACC  := INT_TO_LREAL(step_PRG_A_Interpreter.P2);\n                GVL_1.DATA_RB_A.MOTION_DEC  := DINT_TO_LREAL(step_PRG_A_Interpreter.P3);\n                GVL_1.DATA_RB_A.MOTION_JERK := INT_TO_LREAL(step_PRG_A_Interpreter.P4);\n\n                GVL.A_RunStep := GVL.A_RunStep + 1;\n                GVL.A_RunState := 0;\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\n            E_RobotCmd.CMD_Set_Fac_Speed:\n                // P1 = VelFac %, P2 = AccFac %, P4 = JerkFac %\n                GVL_1.DATA_RB_A.Fac_Vel  := INT_TO_LREAL(step_PRG_A_Interpreter.P1) / 100.0;\n                GVL_1.DATA_RB_A.Fac_Acc  := INT_TO_LREAL(step_PRG_A_Interpreter.P2) / 100.0;\n                GVL_1.DATA_RB_A.Fac_Jerk := INT_TO_LREAL(step_PRG_A_Interpreter.P4) / 100.0;\n\n                IF GVL_1.DATA_RB_A.Fac_Vel <= 0.0 THEN GVL_1.DATA_RB_A.Fac_Vel := 0.1; END_IF;\n                IF GVL_1.DATA_RB_A.Fac_Acc <= 0.0 THEN GVL_1.DATA_RB_A.Fac_Acc := 0.1; END_IF;\n                IF GVL_1.DATA_RB_A.Fac_Jerk <= 0.0 THEN GVL_1.DATA_RB_A.Fac_Jerk := 0.1; END_IF;\n\n                GVL.A_RunStep := GVL.A_RunStep + 1;\n                GVL.A_RunState := 0;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\n\t\t\t// DIGITAL OUTPUT\n            E_RobotCmd.CMD_DO_ON:\n\t\t\t\t// P1 = Output No;\n\t\t\t\tGVL.Y[step_PRG_A_Interpreter.P1] := TRUE;\n\n                GVL.A_RunStep := GVL.A_RunStep + 1;\n                GVL.A_RunState := 0;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\n\n            E_RobotCmd.CMD_DO_OFF:\n                // P1 = Output No;\n\t\t\t\tGVL.Y[step_PRG_A_Interpreter.P1] := FALSE;\n\n                GVL.A_RunStep := GVL.A_RunStep + 1;\n                GVL.A_RunState := 0;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\n\t\t\tE_RobotCmd.CMD_DO_TOGGLE:\n\t\t\t\t// P1 = Output No;\n\t\t\t\tGVL.Y[step_PRG_A_Interpreter.P1] := NOT GVL.Y[step_PRG_A_Interpreter.P1];\n\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\n\t\t\t //================================================\n\t\t\t// WAIT\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_WAIT_IN:\n\t\t\t\t// P1=Input No, P2=Expected 0/1\n\t\t\t\tIF GVL.X[step_PRG_A_Interpreter.P1] = (step_PRG_A_Interpreter.P2 <> 0) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\tE_RobotCmd.CMD_WAIT:\n\t\t\t\t// P1=Condition No\n\t\t\t\tIF F_EvalCondition_A(step_PRG_A_Interpreter.P1) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n            \n            E_RobotCmd.CMD_Delay:\n                // P1 = thời gian delay ms\n                tRunDelay(IN := TRUE, PT := INT_TO_TIME(step_PRG_A_Interpreter.P1));\n\n                IF tRunDelay.Q THEN\n                    tRunDelay(IN := FALSE);\n                    GVL.A_RunStep := GVL.A_RunStep + 1;\n                    GVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n                END_IF;\n\n\t\t\t//================================================\n\t\t\t// TIMER\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_Timer_Start:\n\t\t\t\t// P1=Timer No, P2=Time ms\n\t\t\t\tGVL.A_TimerPT[step_PRG_A_Interpreter.P1] := DINT_TO_TIME(step_PRG_A_Interpreter.P2);\n\t\t\t\tGVL.A_TimerStart[step_PRG_A_Interpreter.P1] := TRUE;\n\t\t\t\tGVL.A_TimerDone[step_PRG_A_Interpreter.P1] := FALSE;\n\t\n\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_Timer_Wait:\n\t\t\t\t// P1=Timer No\n\t\t\t\tIF GVL.A_TimerDone[step_PRG_A_Interpreter.P1] THEN\n\t\t\t\t\tGVL.A_TimerStart[step_PRG_A_Interpreter.P1] := FALSE;\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\t//================================================\n\t\t\t// IF / ELSE\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_IF:\n\t\t\t\t// P1=Condition No\n\t\t\t\tIF F_EvalCondition_A(step_PRG_A_Interpreter.P1) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindElseOrEndIf_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_IF_IN:\n\t\t\t\t// P1=Input No, P2=Expected 0/1\n\t\t\t\tIF GVL.X[step_PRG_A_Interpreter.P1] = (step_PRG_A_Interpreter.P2 <> 0) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindElseOrEndIf_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_IF_VAR:\n\t\t\t\t// P1=Var No, P2=Operator, P3=SetValue\n\t\t\t\tIF F_CompareDINT_A(\n\t\t\t\t\tActual := GVL.A_Var[step_PRG_A_Interpreter.P1],\n\t\t\t\t\tOperator := step_PRG_A_Interpreter.P2,\n\t\t\t\t\tSetValue := step_PRG_A_Interpreter.P3)\n\t\t\t\tTHEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindElseOrEndIf_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_IF_REG:\n\t\t\t\t// P1=Reg No, P2=Operator, P3=SetValue\n\t\t\t\tIF F_CompareDINT_A(\n\t\t\t\t\tActual := GVL.A_Reg[step_PRG_A_Interpreter.P1],\n\t\t\t\t\tOperator := step_PRG_A_Interpreter.P2,\n\t\t\t\t\tSetValue := step_PRG_A_Interpreter.P3)\n\t\t\t\tTHEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindElseOrEndIf_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_ELSE:\n\t\t\t\tGVL.A_RunStep := F_FindEndIf_A(GVL.A_RunStep);\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\n\t\t\tE_RobotCmd.CMD_END_IF:\n\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t//================================================\n\t\t\t// JUMP / CALL / RETURN\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_JUMP:\n\t\t\t\t// P1=Target Step\n\t\t\t\tGVL.A_RunStep := step_PRG_A_Interpreter.P1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_CALL:\n\t\t\t\t// P1=Target Step\n\t\t\t\tIF GVL.A_CallStackIndex < 20 THEN\n\t\t\t\t\tGVL.A_CallStackIndex := GVL.A_CallStackIndex + 1;\n\t\t\t\t\tGVL.A_CallStack[GVL.A_CallStackIndex] := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunStep := step_PRG_A_Interpreter.P1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2101; // Call stack full\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_RETURN:\n\t\t\t\tIF GVL.A_CallStackIndex > 0 THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_CallStack[GVL.A_CallStackIndex];\n\t\t\t\t\tGVL.A_CallStackIndex := GVL.A_CallStackIndex - 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2102; // Return stack empty\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t//================================================\n\t\t\t// WHILE\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_WHILE:\n\t\t\t\t// P1=Condition No\n\t\t\t\tIF F_EvalCondition_A(step_PRG_A_Interpreter.P1) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindEndWhile_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_WHILE_IN:\n\t\t\t\t// P1=Input No, P2=Expected 0/1\n\t\t\t\tIF GVL.X[step_PRG_A_Interpreter.P1] = (step_PRG_A_Interpreter.P2 <> 0) THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindEndWhile_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_WHILE_REG:\n\t\t\t\t// P1=Reg No, P2=Operator, P3=SetValue\n\t\t\t\tIF F_CompareDINT_A(\n\t\t\t\t\tActual := GVL.A_Reg[step_PRG_A_Interpreter.P1],\n\t\t\t\t\tOperator := step_PRG_A_Interpreter.P2,\n\t\t\t\t\tSetValue := step_PRG_A_Interpreter.P3)\n\t\t\t\tTHEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindEndWhile_A(GVL.A_RunStep);\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_END_WHILE:\n// \t\t\t\tGVL.A_RunStep := F_FindWhileStart_A(GVL.A_RunStep);\n// \t\t\t\tGVL.A_RunState := 0;\n\n\t\t\t\t//--------------------------------------------------------\n\t\t\t\t// Lưu vị trí WHILE cần quay lại\n\t\t\t\t//--------------------------------------------------------\n\t\t\t\tWhileReturnStep :=\n\t\t\t\t\tF_FindWhileStart_A(GVL.A_RunStep);\n\n\t\t\t\t//--------------------------------------------------------\n\t\t\t\t// Không nhảy về WHILE ngay.\n\t\t\t\t// Trước tiên chờ pipeline của vòng hiện tại sạch.\n\t\t\t\t//--------------------------------------------------------\n\t\t\t\tGVL.A_RunState := 140;\n\t\t\t\t\n\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n// \t\t\t//================================================\n// \t\t\t// VISION\n// \t\t\t//================================================\n// \t\t\tE_RobotCmd.CMD_VISION_TRIGGER:\n// \t\t\t\tGVL.A_VisionTriggerReq := TRUE;\n// \t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n// \t\t\t\tGVL.A_RunState := 0;\n// \t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n// \t\t\t\tIF GVL.A_RunMode = 1 THEN\n// \t\t\t\t\tGVL.A_StepHold := TRUE;\n// \t\t\t\tEND_IF;\n\n\t\t\tE_RobotCmd.CMD_VISION_TRIGGER:\n\t\t\t\t//=========================================================================\n\t\t\t\t// VISION TRIGGER - ROBOT A\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// Command này thực hiện toàn bộ transaction:\n\t\t\t\t//\n\t\t\t\t// Robot A -> Vision Manager -> FB_VisionAlign -> Vision\n\t\t\t\t//\n\t\t\t\t// P1 = CameraID.\n\t\t\t\t// P2 = JobID.\n\t\t\t\t// P3 = A_Var index nhận business result.\n\t\t\t\t//\n\t\t\t\t// A_Var[P3] = 1 : Vision Result OK.\n\t\t\t\t// A_Var[P3] = 0 : Vision Result NG / NOT_FOUND / LOW_SCORE / ...\n\t\t\t\t//\n\t\t\t\t// Lỗi communication/config/protocol/timeout:\n\t\t\t\t// -> A_VisionError = TRUE.\n\t\t\t\t// -> Robot Alarm.\n\t\t\t\t// -> Không chuyển sang step tiếp theo.\n\t\t\t\t//=========================================================================\n\t\t\t\n\t\t\t\n\t\t\t\t//=========================================================================\n\t\t\t\t// 1. START COMMAND\n\t\t\t\t// Chỉ thực hiện một lần khi command Vision chưa active.\n\t\t\t\t//=========================================================================\n\t\t\t\tIF NOT xVisionStepActiveA THEN\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Latch tham số command.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tuiVisionCameraIDA := INT_TO_UINT(step_PRG_A_Interpreter.P1);\n\t\t\t\t\tuiVisionJobIDA := INT_TO_UINT(step_PRG_A_Interpreter.P2);\n\t\t\t\t\tiVisionResultVarA := DINT_TO_INT(step_PRG_A_Interpreter.P3);\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Kiểm tra CameraID trước khi gửi Request.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tIF (uiVisionCameraIDA < 1)\n\t\t\t\t\tOR (uiVisionCameraIDA > GVL.C_MAX_VISION_CHANNELS) THEN\n\t\t\t\n\t\t\t\t\t\tGVL.A_VisionDone := FALSE;\n\t\t\t\t\t\tGVL.A_VisionOK := FALSE;\n\t\t\t\t\t\tGVL.A_VisionError := TRUE;\n\t\t\t\n\t\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\t\tGVL.A_RunAlarmCode := 2201;\n\t\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// A_Var của project hiện tại có index 0..200.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tELSIF (iVisionResultVarA < 0)\n\t\t\t\t\tOR (iVisionResultVarA > 200) THEN\n\t\t\t\n\t\t\t\t\t\tGVL.A_VisionDone := FALSE;\n\t\t\t\t\t\tGVL.A_VisionOK := FALSE;\n\t\t\t\t\t\tGVL.A_VisionError := TRUE;\n\t\t\t\n\t\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\t\tGVL.A_RunAlarmCode := 2202;\n\t\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t\tELSE\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\t// Xóa business result cũ.\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\tGVL.A_Var[iVisionResultVarA] := 0;\n\t\t\t\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\t// Xóa status tương thích logic Robot cũ.\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\tGVL.A_VisionDone := FALSE;\n\t\t\t\t\t\tGVL.A_VisionOK := FALSE;\n\t\t\t\t\t\tGVL.A_VisionError := FALSE;\n\t\t\t\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\t// Gửi Request sang Vision Manager.\n\t\t\t\t\t\t//\n\t\t\t\t\t\t// CameraID và JobID phải được ghi TRƯỚC Execute.\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\tGVL.g_stVisionAlignRequestA.CameraID := uiVisionCameraIDA;\n\t\t\t\t\t\tGVL.g_stVisionAlignRequestA.JobID := uiVisionJobIDA;\n\t\t\t\t\t\tGVL.g_stVisionAlignRequestA.Execute := TRUE;\n\t\t\t\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\t// Đánh dấu command Vision của Robot A đang hoạt động.\n\t\t\t\t\t\t//-----------------------------------------------------------------\n\t\t\t\t\t\txVisionStepActiveA := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\t//=========================================================================\n\t\t\t\t// 2. WAIT TRANSACTION DONE\n\t\t\t\t//=========================================================================\n\t\t\t\tIF xVisionStepActiveA AND GVL.g_stVisionAlignRequestA.Done THEN\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Vision transaction hoàn thành bình thường.\n\t\t\t\t\t//\n\t\t\t\t\t// ResultOK quyết định business result:\n\t\t\t\t\t// TRUE  -> A_Var[P3] = 1.\n\t\t\t\t\t// FALSE -> A_Var[P3] = 0.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tIF GVL.g_stVisionAlignRequestA.ResultOK THEN\n\t\t\t\t\t\tGVL.A_Var[iVisionResultVarA] := 1;\n\t\t\t\t\t\tGVL.A_VisionOK := TRUE;\n\t\t\t\t\tELSE\n\t\t\t\t\t\tGVL.A_Var[iVisionResultVarA] := 0;\n\t\t\t\t\t\tGVL.A_VisionOK := FALSE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Transaction đã hoàn thành.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tGVL.A_VisionDone := TRUE;\n\t\t\t\t\tGVL.A_VisionError := FALSE;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Hạ Execute = ACK từ Robot về Manager.\n\t\t\t\t\t//\n\t\t\t\t\t// Manager thấy Execute FALSE sẽ:\n\t\t\t\t\t// - Reset Done.\n\t\t\t\t\t// - Giải phóng Camera.\n\t\t\t\t\t// - Đưa Camera về State 0.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tGVL.g_stVisionAlignRequestA.Execute := FALSE;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Kết thúc command local.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\txVisionStepActiveA := FALSE;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Chuyển sang command tiếp theo.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\t// Step Mode: giữ chương trình sau khi hoàn thành một command.\n\t\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\t//=========================================================================\n\t\t\t\t// 3. WAIT TRANSACTION ERROR\n\t\t\t\t//=========================================================================\n\t\t\t\tELSIF xVisionStepActiveA AND GVL.g_stVisionAlignRequestA.Error THEN\n\t\t\t\t\n\t\t\t\t\t// LƯU MÃ LỖI TRƯỚC KHI HẠ EXECUTE.\n\t\t\t\t\t// Manager sẽ reset ErrorID sau khi Execute = FALSE.\n\t\t\t\t\tiVisionErrorIDA := GVL.g_stVisionAlignRequestA.ErrorID;\n\t\t\t\t\n\t\t\t\t\t// Không sử dụng kết quả Vision khi transaction lỗi.\n\t\t\t\t\tGVL.A_Var[iVisionResultVarA] := 0;\n\t\t\t\t\tGVL.A_VisionDone := FALSE;\n\t\t\t\t\tGVL.A_VisionOK := FALSE;\n\t\t\t\t\tGVL.A_VisionError := TRUE;\n\t\t\t\t\n\t\t\t\t\t// Báo Alarm Robot.\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2201;\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\t\n\t\t\t\t\t// Kết thúc command Vision local.\n\t\t\t\t\txVisionStepActiveA := FALSE;\n\t\t\t\t\n\t\t\t\t\t// Hạ Execute CUỐI CÙNG.\n\t\t\t\t\t// Manager nhận ACK này và sau đó mới reset Request.\n\t\t\t\t\tGVL.g_stVisionAlignRequestA.Execute := FALSE;\n\t\t\t\t\n\t\t\t\tEND_IF;\n\t\t\t\t\t\t\t\n\t\n\t\t\tE_RobotCmd.CMD_VISION_SET_POINT:\n\n\t\t\t\t//=========================================================================\n\t\t\t\t// VISION SET POINT\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// P1 = Master Point No.\n\t\t\t\t// P2 = Destination Point No.\n\t\t\t\t// P3 = Vision Result Index.\n\t\t\t\t//\n\t\t\t\t// Destination = Master + Vision Result[P3]\n\t\t\t\t//\n\t\t\t\t// Ví dụ:\n\t\t\t\t// VISION_SET_POINT P10 P101 1\n\t\t\t\t// VISION_SET_POINT P10 P102 2\n\t\t\t\t//\n\t\t\t\t// P101 = P10 + Result[1]\n\t\t\t\t// P102 = P10 + Result[2]\n\t\t\t\t//\n\t\t\t\t// Chỉ yêu cầu Header của Vision Result hợp lệ.\n\t\t\t\t// Không kiểm tra ObjectCount.\n\t\t\t\t// Không kiểm tra Object.Valid.\n\t\t\t\t// Không kiểm tra Vision có trả đủ số lượng Object hay không.\n\t\t\t\t//=========================================================================\n\t\t\t\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// 1. KIỂM TRA MASTER / DESTINATION POINT\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 < 1) OR (step_PRG_A_Interpreter.P1 > 500)\n\t\t\t\tOR (step_PRG_A_Interpreter.P2 < 1) OR (step_PRG_A_Interpreter.P2 > 500)\n\t\t\t\tOR (step_PRG_A_Interpreter.P1 = step_PRG_A_Interpreter.P2) THEN\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2203;      // Master/Destination Point không hợp lệ.\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// 2. KIỂM TRA RESULT INDEX\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\tELSIF (step_PRG_A_Interpreter.P3 < 1)\n\t\t\t\tOR (step_PRG_A_Interpreter.P3 > GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME) THEN\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2205;      // Vision Result Index ngoài vùng Array.\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// 3. CHỈ KIỂM TRA HEADER\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\tELSIF NOT GVL.g_aVisionResult[uiVisionCameraIDA].Header.Valid THEN\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2204;      // Vision Header không hợp lệ.\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\n\t\t\t\t\t//=====================================================================\n\t\t\t\t\t// 4. DESTINATION = MASTER + VISION RESULT[P3]\n\t\t\t\t\t//=====================================================================\n\t\t\t\n\t\t\t\t\t// X\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[DINT_TO_INT(step_PRG_A_Interpreter.P2)] :=\n\t\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[DINT_TO_INT(step_PRG_A_Interpreter.P1)]\n\t\t\t\t\t\t+ GVL.g_aVisionResult[uiVisionCameraIDA].TrackObjectResult.Objects[DINT_TO_UINT(step_PRG_A_Interpreter.P3)].Pos.X;\n\t\t\t\n\t\t\t\t\t// Y\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[DINT_TO_INT(step_PRG_A_Interpreter.P2)] :=\n\t\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[DINT_TO_INT(step_PRG_A_Interpreter.P1)]\n\t\t\t\t\t\t+ GVL.g_aVisionResult[uiVisionCameraIDA].TrackObjectResult.Objects[DINT_TO_UINT(step_PRG_A_Interpreter.P3)].Pos.Y;\n\t\t\t\n\t\t\t\t\t// Z\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[DINT_TO_INT(step_PRG_A_Interpreter.P2)] :=\n\t\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[DINT_TO_INT(step_PRG_A_Interpreter.P1)]\n\t\t\t\t\t\t+ GVL.g_aVisionResult[uiVisionCameraIDA].TrackObjectResult.Objects[DINT_TO_UINT(step_PRG_A_Interpreter.P3)].Pos.Z;\n\t\t\t\n\t\t\t\t\t// R\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[DINT_TO_INT(step_PRG_A_Interpreter.P2)] :=\n\t\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[DINT_TO_INT(step_PRG_A_Interpreter.P1)]\n\t\t\t\t\t\t+ GVL.g_aVisionResult[uiVisionCameraIDA].TrackObjectResult.Objects[DINT_TO_UINT(step_PRG_A_Interpreter.P3)].Pos.A;\n\t\t\t\n\t\t\t\t\t//=====================================================================\n\t\t\t\t\t// 5. COMMAND HOÀN THÀNH\n\t\t\t\t\t//=====================================================================\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tEND_IF;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_VISION_PICK:\n\n\t\t\t\t//=========================================================================\n\t\t\t\t// VISION PICK\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// Hiện tại mới xác nhận Result Vision tồn tại.\n\t\t\t\t// Phần Camera->Robot Transform và tạo Target Pick sẽ bổ sung sau.\n\t\t\t\t//=========================================================================\n\t\t\t\n\t\t\t\tIF GVL.A_VisionHeaderOK THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2202;\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_VISION_CHECK:\n\n\t\t\t\t//=========================================================================\n\t\t\t\t// CHECK LAST VISION RESULT\n\t\t\t\t//-------------------------------------------------------------------------\n\t\t\t\t// TRUE  -> chạy Step tiếp theo.\n\t\t\t\t// FALSE -> nhảy tới ELSE / END_IF.\n\t\t\t\t//=========================================================================\n\t\t\t\n\t\t\t\tIF GVL.A_VisionHeaderOK THEN\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunStep := F_FindElseOrEndIf_A(GVL.A_RunStep);\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t//================================================\n\t\t\t// TRACKING\n\t\t\t//================================================\n\t\t\tE_RobotCmd.CMD_TRACK_ON:\n\t\t\t\tGVL.A_TrackEnable := TRUE;\n\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\tE_RobotCmd.CMD_TRACK_OFF:\n\t\t\t\tGVL.A_TrackEnable := FALSE;\n\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\tGVL.A_RunState := 0;\n\t\n\t\n\t\t\t//==========================================================================\n\t\t\t// TRACK PICK\n\t\t\t//--------------------------------------------------------------------------\n\t\t\t// P1 = RecipeID\n\t\t\t// P2 = Target Pick Count\n\t\t\t// P3 = Tool Mask\n\t\t\t//\n\t\t\t// Ví dụ:\n\t\t\t// P1=1, P2=1, P3=1 -> Recipe 1, Pick 1, chỉ Tool 1.\n\t\t\t// P1=1, P2=2, P3=3 -> Recipe 1, Pick 2, Tool 1 + Tool 2.\n\t\t\t//==========================================================================\n\t\t\tE_RobotCmd.CMD_TRACK_PICK:\n\t\t\t\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\t// 1. CHỈ PHÁT COMMAND MỘT LẦN\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\tIF NOT GVL.A_StepActive THEN\n\t\t\t\n\t\t\t\t\t// Chỉ bắt đầu khi Motion Pipeline trước đó đã sạch.\n\t\t\t\t\tIF (GVL.A_MotionCount <= 0)\n\t\t\t\t\tAND (GVL.A_ActiveMotionCount <= 0)\n\t\t\t\t\tAND NOT GVL.A_MotionManagerBusy THEN\n\t\t\t\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\t// Tạo CommandID mới.\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.CommandID :=\n\t\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.CommandID + 1;\n\t\t\t\n\t\t\t\t\t\tIF GVL.g_stMultiTrackCommandA.CommandID = 0 THEN\n\t\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.CommandID := 1;\n\t\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\t// Nạp tham số từ dòng Interpreter.\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.RecipeID :=\n\t\t\t\t\t\t\tINT_TO_UINT(step_PRG_A_Interpreter.P1);\n\t\t\t\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.TargetPickCountOverride :=\n\t\t\t\t\t\t\tINT_TO_UINT(step_PRG_A_Interpreter.P2);\n\t\t\t\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.ToolMaskOverride :=\n\t\t\t\t\t\t\tDINT_TO_DWORD(step_PRG_A_Interpreter.P3);\n\t\t\t\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\t// Command mới.\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.Reset := FALSE;\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.Abort := FALSE;\n\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.Execute := TRUE;\n\t\t\t\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\t// Nhớ CommandID mà Interpreter đang chờ.\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\tudiTrackCommandIDA :=\n\t\t\t\t\t\t\tGVL.g_stMultiTrackCommandA.CommandID;\n\t\t\t\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\t// Không phát lại command ở scan tiếp theo.\n\t\t\t\t\t\t//--------------------------------------------------------------\n\t\t\t\t\t\tGVL.A_StepActive := TRUE;\n\t\t\t\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\t// 2. TRACKING HOÀN THÀNH ĐÚNG COMMAND\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\tIF GVL.A_StepActive\n\t\t\t\tAND GVL.g_xTrackOKA\n\t\t\t\tAND GVL.g_udiTrackDoneCommandIDA = udiTrackCommandIDA THEN\n\t\t\t\n\t\t\t\t\t// Hạ Execute sau khi Application hoàn thành.\n\t\t\t\t\tGVL.g_stMultiTrackCommandA.Execute := FALSE;\n\t\t\t\n\t\t\t\t\t// Kết thúc transaction của Interpreter.\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tudiTrackCommandIDA := 0;\n\t\t\t\n\t\t\t\t\t// Sang dòng chương trình tiếp theo.\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\t\t// Step Mode: dừng sau khi hoàn thành TRACK_PICK.\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\t// 3. TRACKING ERROR\n\t\t\t\t//----------------------------------------------------------------------\n\t\t\t\tELSIF GVL.A_StepActive\n\t\t\t\tAND GVL.g_xTrackErrorA THEN\n\t\t\t\n\t\t\t\t\tGVL.g_stMultiTrackCommandA.Execute := FALSE;\n\t\t\t\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tudiTrackCommandIDA := 0;\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode :=\n\t\t\t\t\t\tUDINT_TO_INT(GVL.g_udiTrackErrorIDA);\n\t\t\t\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t//=========================================================================\n\t\t\t// TOOL RELEASE\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// P1 = ToolID cần nhả sản phẩm.\n\t\t\t//=========================================================================\n\t\t\tE_RobotCmd.CMD_TOOL_RELEASE:\n\t\t\t\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t// 1. PHÁT LỆNH RELEASE MỘT LẦN\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\tIF NOT GVL.A_StepActive THEN\n\t\t\t\n\t\t\t\t\t// Kiểm tra ToolID hợp lệ.\n\t\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1)\n\t\t\t\t\tAND (step_PRG_A_Interpreter.P1 <= GVL.C_MAX_TOOLS) THEN\n\t\t\t\n\t\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t\t// Chỉ Release Tool đang thực sự giữ sản phẩm.\n\t\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t\tIF GVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].Occupied THEN\n\t\t\t\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\t// Tạo CommandID mới.\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.CommandID :=\n\t\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.CommandID + 1;\n\t\t\t\n\t\t\t\t\t\t\tIF GVL.g_stInterpreterToolCommandA.CommandID = 0 THEN\n\t\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.CommandID := 1;\n\t\t\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\t// Nạp command.\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.ToolID :=\n\t\t\t\t\t\t\t\tINT_TO_UINT(step_PRG_A_Interpreter.P1);\n\t\t\t\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.CommandType :=\n\t\t\t\t\t\t\t\tE_ToolCommandType.RELEASE;\n\t\t\t\n\t\t\t\t\t\t\t// Giữ ObjectID hiện tại để debug/trace.\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.ObjectID :=\n\t\t\t\t\t\t\t\tGVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].HeldObjectID;\n\t\t\t\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.Reset := FALSE;\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.Abort := FALSE;\n\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.Execute := TRUE;\n\t\t\t\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\t// Nhớ CommandID đang chờ.\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\tudiToolReleaseCommandIDA :=\n\t\t\t\t\t\t\t\tGVL.g_stInterpreterToolCommandA.CommandID;\n\t\t\t\n\t\t\t\t\t\t\tGVL.A_StepActive := TRUE;\n\t\t\t\n\t\t\t\t\t\tELSE\n\t\t\t\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\t// Tool không giữ vật -> coi là lỗi dạy chương trình.\n\t\t\t\t\t\t\t//---------------------------------------------------------\n\t\t\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\t\t\tGVL.A_RunAlarmCode := 2502;\n\t\t\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t\tELSE\n\t\t\t\n\t\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t\t// ToolID ngoài phạm vi.\n\t\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\t\tGVL.A_RunAlarmCode := 2501;\n\t\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t// 2. RELEASE HOÀN THÀNH\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\tIF GVL.A_StepActive\n\t\t\t\tAND GVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].Done\n\t\t\t\tAND GVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].ResponseCommandID\n\t\t\t\t\t= udiToolReleaseCommandIDA THEN\n\t\t\t\n\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t// Hạ Execute để tạo lại cạnh cho command sau.\n\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\tGVL.g_stInterpreterToolCommandA.Execute := FALSE;\n\t\t\t\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tudiToolReleaseCommandIDA := 0;\n\t\t\t\n\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\t// Sang step kế tiếp.\n\t\t\t\t\t//-------------------------------------------------------------\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\t// 3. TOOL ERROR\n\t\t\t\t//---------------------------------------------------------------------\n\t\t\t\tELSIF GVL.A_StepActive\n\t\t\t\tAND GVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].Error THEN\n\t\t\t\n\t\t\t\t\tGVL.g_stInterpreterToolCommandA.Execute := FALSE;\n\t\t\t\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tudiToolReleaseCommandIDA := 0;\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarmCode :=\n\t\t\t\t\t\tUDINT_TO_INT(\n\t\t\t\t\t\t\tGVL.g_aToolStatusA[step_PRG_A_Interpreter.P1].ErrorID\n\t\t\t\t\t\t);\n\t\t\t\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\tEND_IF;\n\t\n\n\t\t\tE_RobotCmd.CMD_TRACK_PLACE:\n\t\t\t\tGVL.A_TrackPlaceReq := TRUE;\n\t\n\t\t\t\tIF GVL.A_TrackPlaceDone THEN\n\t\t\t\t\tGVL.A_TrackPlaceReq := FALSE;\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\tE_RobotCmd.CMD_CONV_PICK:\n\n// \t\t\t\t// Không bắt đầu Application khi pipeline motion cũ còn hoạt động.\n// \t\t\t\tIF NOT GVL.A_StepActive THEN\n// \t\t\t\t\tIF GVL.A_MotionCount = 0 AND GVL.A_ActiveMotionCount = 0 THEN\n// \t\t\t\t\t\tGVL.g_stApplicationCommandA.ApplicationID := E_ApplicationID.APP_CONVEYOR_PICK;\n// \t\t\t\t\t\tGVL.g_stApplicationCommandA.RecipeID := TO_UINT(step.P1);\n// \t\t\t\t\t\tGVL.g_stApplicationCommandA.RobotID := 1;\n// \t\t\t\t\t\tGVL.g_stApplicationCommandA.CommandID := GVL.g_stApplicationCommandA.CommandID + 1;\n// \t\t\t\t\t\tGVL.g_stApplicationCommandA.Execute := TRUE;\n// \t\t\t\t\t\tGVL.A_StepActive := TRUE;\n// \t\t\t\t\tEND_IF;\n// \t\t\t\tEND_IF;\n// \t\t\t\n// \t\t\t\t// Application hoàn thành: hạ Execute và chuyển step.\n// \t\t\t\tIF GVL.g_stApplicationResponseA.Done THEN\n// \t\t\t\t\tGVL.g_stApplicationCommandA.Execute := FALSE;\n// \t\t\t\t\tGVL.A_StepActive := FALSE;\n// \t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n// \t\t\t\tEND_IF;\n// \t\t\t\n// \t\t\t\t// Application lỗi: dừng Interpreter.\n// \t\t\t\tIF GVL.g_stApplicationResponseA.Error THEN\n// \t\t\t\t\tGVL.g_stApplicationCommandA.Execute := FALSE;\n// \t\t\t\t\tGVL.A_StepActive := FALSE;\n// \t\t\t\t\tGVL.A_RunAlarm := TRUE;\n// \t\t\t\t\tGVL.A_RunAlarmCode := TO_INT(GVL.g_stApplicationResponseA.ErrorID);\n// \t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n// \t\t\t\tEND_IF;\n\n\t\t\t\t// Chỉ bắt đầu khi Motion Queue và các slot hiện tại đã sạch.\n\t\t\t\tIF NOT GVL.A_StepActive THEN\n\t\t\t\t\tIF GVL.A_MotionCount = 0 AND GVL.A_ActiveMotionCount = 0 THEN\n\t\t\t\t\t\tGVL.A_TrackStartCmd := TRUE;\n\t\t\t\t\t\tGVL.A_StepActive := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t// Sau khi engine nhận cạnh Start, hạ request.\n\t\t\t\tIF GVL.A_TrackEngineBusy THEN\n\t\t\t\t\tGVL.A_TrackStartCmd := FALSE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t// Hoàn thành application thì tăng step.\n\t\t\t\tIF GVL.A_TrackEngineDone THEN\n\t\t\t\t\tGVL.A_TrackStartCmd := FALSE;\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t// Lỗi application thì dừng Interpreter.\n\t\t\t\tIF GVL.A_TrackEngineError THEN\n\t\t\t\t\tGVL.A_TrackStartCmd := FALSE;\n\t\t\t\t\tGVL.A_StepActive := FALSE;\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := TO_INT(GVL.A_TrackEngineErrorID);\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\tEND_IF;\n\n\t\t\t//=========================================================================\n\t\t\t// MODBUS / POINT COMMANDS - ROBOT A\n\t\t\t//=========================================================================\n\t\t\t\n\t\t\tE_RobotCmd.CMD_MB_REG_READ:\n\t\t\t\t// P1 = MODBUS Index [0..1999]\n\t\t\t\t// P2 = A_Reg Destination [1..200]\n\t\t\t\t// GVL.MODBUS[] dùng chung\n\t\t\t\t// Giá trị MODBUS được hiểu là INT16 có dấu\n\t\t\t\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 0) AND (step_PRG_A_Interpreter.P1 <= 1999)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 1) AND (step_PRG_A_Interpreter.P2 <= 200) THEN\n\t\t\t\n\t\t\t\t\tGVL.A_Reg[step_PRG_A_Interpreter.P2] := INT_TO_DINT(WORD_TO_INT(GVL.MODBUS[step_PRG_A_Interpreter.P1]));\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN GVL.A_StepHold := TRUE; END_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2503;\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// CMD_MB_REG_SET\n\t\t\t// P1 = MODBUS Index [0..1999]\n\t\t\t// P2 = Giá trị INT16 signed [-32768..32767]\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_MB_REG_SET:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 0) AND (step_PRG_A_Interpreter.P1 <= 1999) THEN\n\t\t\t\t\tGVL.MODBUS[step_PRG_A_Interpreter.P1] := INT_TO_WORD(step_PRG_A_Interpreter.P2);\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN GVL.A_StepHold := TRUE; END_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2501; // MODBUS index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// CMD_MB_BIT_SET\n\t\t\t// P1 = MODBUS Index [0..1999]\n\t\t\t// P2 = Bit Index [0..15]\n\t\t\t// P3 = 0: Reset bit / <>0: Set bit\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_MB_BIT_SET:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 0) AND (step_PRG_A_Interpreter.P1 <= 1999)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 0) AND (step_PRG_A_Interpreter.P2 <= 15) THEN\n\t\t\t\n\t\t\t\t\tIF step_PRG_A_Interpreter.P3 <> 0 THEN\n\t\t\t\t\t\tGVL.MODBUS[step_PRG_A_Interpreter.P1] := GVL.MODBUS[step_PRG_A_Interpreter.P1] OR SHL(WORD#1, step_PRG_A_Interpreter.P2);\n\t\t\t\t\tELSE\n\t\t\t\t\t\tGVL.MODBUS[step_PRG_A_Interpreter.P1] := GVL.MODBUS[step_PRG_A_Interpreter.P1] AND NOT SHL(WORD#1, step_PRG_A_Interpreter.P2);\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN GVL.A_StepHold := TRUE; END_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2502; // MODBUS index/bit invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//=========================================================================\n\t\t\t// POINT CALCULATION COMMANDS - ROBOT A\n\t\t\t//=========================================================================\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT COPY\n\t\t\t// P1 = Destination Point\n\t\t\t// P2 = Source Point\n\t\t\t// Dest := Source\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_COPY:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 1) AND (step_PRG_A_Interpreter.P2 <= 500) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P2];\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P2];\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P2];\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P2];\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2510; // Point index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT ADD\n\t\t\t// P1 = Destination Point\n\t\t\t// P2 = Base Point\n\t\t\t// P3 = Offset Point\n\t\t\t// Dest := Base + Offset\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_ADD:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 1) AND (step_PRG_A_Interpreter.P2 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P3 >= 1) AND (step_PRG_A_Interpreter.P3 <= 500) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P2] + GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P2] + GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P2] + GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P2] + GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2511; // Point index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT SUB\n\t\t\t// P1 = Destination Point\n\t\t\t// P2 = Base Point\n\t\t\t// P3 = Offset Point\n\t\t\t// Dest := Base - Offset\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_SUB:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 1) AND (step_PRG_A_Interpreter.P2 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P3 >= 1) AND (step_PRG_A_Interpreter.P3 <= 500) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P2] - GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P2] - GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P2] - GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P2] - GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P3];\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2512; // Point index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT ADD VALUE\n\t\t\t// P1 = Point cần thay đổi\n\t\t\t// P2 = X Offset\n\t\t\t// P3 = Y Offset\n\t\t\t// P4 = Z Offset\n\t\t\t// P5 = R Offset\n\t\t\t// Point[P1] := Point[P1] + Value\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_ADD_VALUE:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(step_PRG_A_Interpreter.P2)/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] + DINT_TO_REAL(step_PRG_A_Interpreter.P3)/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(step_PRG_A_Interpreter.P4)/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(step_PRG_A_Interpreter.P5)/1000;\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2513; // Point index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT ADD INTERNAL REGISTER\n\t\t\t// P1 = Point cần thay đổi\n\t\t\t// P2 = A_Reg chứa X Offset\n\t\t\t// P3 = A_Reg chứa Y Offset\n\t\t\t// P4 = A_Reg chứa Z Offset\n\t\t\t// P5 = A_Reg chứa R Offset\n\t\t\t// Point[P1] := Point[P1] + A_Reg[]\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_ADD_REG:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 1) AND (step_PRG_A_Interpreter.P2 <= 200)\n\t\t\t\tAND (step_PRG_A_Interpreter.P3 >= 1) AND (step_PRG_A_Interpreter.P3 <= 200)\n\t\t\t\tAND (step_PRG_A_Interpreter.P4 >= 1) AND (step_PRG_A_Interpreter.P4 <= 200)\n\t\t\t\tAND (step_PRG_A_Interpreter.P5 >= 1) AND (step_PRG_A_Interpreter.P5 <= 200) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] + DINT_TO_REAL(GVL.A_Reg[step_PRG_A_Interpreter.P2])/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] + DINT_TO_REAL(GVL.A_Reg[step_PRG_A_Interpreter.P3])/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] + DINT_TO_REAL(GVL.A_Reg[step_PRG_A_Interpreter.P4])/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] + DINT_TO_REAL(GVL.A_Reg[step_PRG_A_Interpreter.P5])/1000;\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2514; // Point/Reg index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t//-------------------------------------------------------------------------\n\t\t\t// POINT ADD MODBUS REGISTER\n\t\t\t// P1 = Point cần thay đổi\n\t\t\t// P2 = MODBUS X Offset\n\t\t\t// P3 = MODBUS Y Offset\n\t\t\t// P4 = MODBUS Z Offset\n\t\t\t// P5 = MODBUS R Offset\n\t\t\t//\n\t\t\t// MODBUS = 16-bit signed [-32768..32767]\n\t\t\t// Point[P1] := Point[P1] + MODBUS[]\n\t\t\t//-------------------------------------------------------------------------\n\t\t\tE_RobotCmd.CMD_POINT_ADD_MB_REG:\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 500)\n\t\t\t\tAND (step_PRG_A_Interpreter.P2 >= 0) AND (step_PRG_A_Interpreter.P2 <= 1999)\n\t\t\t\tAND (step_PRG_A_Interpreter.P3 >= 0) AND (step_PRG_A_Interpreter.P3 <= 1999)\n\t\t\t\tAND (step_PRG_A_Interpreter.P4 >= 0) AND (step_PRG_A_Interpreter.P4 <= 1999)\n\t\t\t\tAND (step_PRG_A_Interpreter.P5 >= 0) AND (step_PRG_A_Interpreter.P5 <= 1999) THEN\n\t\t\t\n\t\t\t\t\tGVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.X_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(WORD_TO_INT(GVL.MODBUS[step_PRG_A_Interpreter.P2]))/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Y_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(WORD_TO_INT(GVL.MODBUS[step_PRG_A_Interpreter.P3]))/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.Z_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(WORD_TO_INT(GVL.MODBUS[step_PRG_A_Interpreter.P4]))/1000;\n\t\t\t\t\tGVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] := GVL_1.DATA_RB_A.R_POS[step_PRG_A_Interpreter.P1] + INT_TO_REAL(WORD_TO_INT(GVL.MODBUS[step_PRG_A_Interpreter.P5]))/1000;\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2515; // Point/MODBUS index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\n\t\t\t\t\n\t\t\tE_RobotCmd.CMD_REG_SET,\n\t\t\tE_RobotCmd.CMD_REG_ADD,\n\t\t\tE_RobotCmd.CMD_REG_SUB,\n\t\t\tE_RobotCmd.CMD_REG_MUL,\n\t\t\tE_RobotCmd.CMD_REG_DIV,\n\t\t\tE_RobotCmd.CMD_REG_MOD:\n\t\t\t\n\t\t\t\t// P1 = Reg đích\n\t\t\t\t// P2 = SourceMode\n\t\t\t\t// P3 = Value hoặc Reg A\n\t\t\t\t// P4 = Reg B\n\t\t\t\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 200) THEN\n\t\t\t\n\t\t\t\t\tGVL.A_Reg[step_PRG_A_Interpreter.P1] :=\n\t\t\t\t\t\tF_CalcReg_A(\n\t\t\t\t\t\t\tCmd        := step_PRG_A_Interpreter.Cmd,\n\t\t\t\t\t\t\tDestReg    := step_PRG_A_Interpreter.P1,\n\t\t\t\t\t\t\tSourceMode := step_PRG_A_Interpreter.P2,\n\t\t\t\t\t\t\tP3         := step_PRG_A_Interpreter.P3,\n\t\t\t\t\t\t\tP4         := step_PRG_A_Interpreter.P4\n\t\t\t\t\t\t);\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2401; // Reg index invalid\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\t\t\n\t\t\tE_RobotCmd.CMD_VAR_SET,\n\t\t\tE_RobotCmd.CMD_VAR_ADD,\n\t\t\tE_RobotCmd.CMD_VAR_SUB,\n\t\t\tE_RobotCmd.CMD_VAR_MUL,\n\t\t\tE_RobotCmd.CMD_VAR_DIV,\n\t\t\tE_RobotCmd.CMD_VAR_MOD:\n\t\t\t\t// P1 = Var đích\n\t\t\t\t// P2 = SourceMode\n\t\t\t\t// P3 = Value hoặc Var A\n\t\t\t\t// P4 = Var B\n\t\t\t\tIF (step_PRG_A_Interpreter.P1 >= 1) AND (step_PRG_A_Interpreter.P1 <= 200) THEN\n\t\t\t\n\t\t\t\t\tGVL.A_Var[step_PRG_A_Interpreter.P1] :=\n\t\t\t\t\t\tF_CalcVar_A(\n\t\t\t\t\t\t\tCmd        := step_PRG_A_Interpreter.Cmd,\n\t\t\t\t\t\t\tDestVar    := step_PRG_A_Interpreter.P1,\n\t\t\t\t\t\t\tSourceMode := step_PRG_A_Interpreter.P2,\n\t\t\t\t\t\t\tP3         := step_PRG_A_Interpreter.P3,\n\t\t\t\t\t\t\tP4         := step_PRG_A_Interpreter.P4\n\t\t\t\t\t\t);\n\t\t\t\n\t\t\t\t\tGVL.A_RunStep := GVL.A_RunStep + 1;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\t\t// Nếu đang Step Mode thì dừng chờ sau khi chạy xong 1 lệnh\n\t\t\t\t\tIF GVL.A_RunMode = 1 THEN\n\t\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tELSE\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 2402;\n\t\t\t\t\tGVL.A_RunErrorStep := GVL.A_RunStep;\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\t\t\n            E_RobotCmd.CMD_END:\n                GVL.A_RunBusy := FALSE;\n                GVL.A_RunDone := TRUE;\n                GVL.A_RunState := 0;\n\t\t\n\n        ELSE\n            // Lệnh chưa hỗ trợ\n            GVL.A_RunAlarm := TRUE;\n            GVL.A_RunAlarmCode := 2001;\n            GVL.A_RunErrorStep := GVL.A_RunStep;\n            GVL.A_RunState := 900;\n        END_CASE;\n\n\n    100: // FILL PIPELINE\n\n        // Nạp trước motion nếu:\n        // 1. Chưa hết chương trình\n        // 2. Step tiếp theo vẫn là motion\n        // 3. Tổng số motion đang chờ + đang chạy chưa vượt pipeline depth\n        IF (GVL.A_PipelineNextPushStep <= GVL.A_LengthStep)\n           AND F_IsMotionCmd(GVL_1.Step_Cr_A[GVL.A_PipelineNextPushStep].Cmd)\n           AND ((GVL.A_MotionCount + GVL.A_ActiveMotionCount) < GVL.A_PipelineDepth)\n\t\t   // AND (GVL.A_PipelineUsedCount < GVL.A_PipelineDepth)\n        THEN\n            GVL.A_PushMotionItem := F_BuildMotionItem(GVL.A_PipelineNextPushStep);\n            GVL.A_PushMotionReq := TRUE;\n\n            GVL.A_RunState := 110;\n        ELSE\n            // Pipeline đã đầy hoặc gặp lệnh logic\n            GVL.A_RunState := 120;\n        END_IF;\n\n\n    110: // WAIT PUSH DONE\n\t\t\n\t\t\tIF GVL.A_PushMotionDone THEN\n\t\t\t\n\t\t\t\t\tGVL.A_PushMotionReq := FALSE;\n\t\t\t\t\tGVL.A_PushMotionDone := FALSE;\n\t\t\t\t\t\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\t// Một motion chính thức thuộc pipeline\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\tGVL.A_PipelineUsedCount :=\n\t\t\t\t\t\tGVL.A_PipelineUsedCount + 1;\n\t\t\t\n\t\t\t\t\tGVL.A_PipelineNextPushStep :=\n\t\t\t\t\t\tGVL.A_PipelineNextPushStep + 1;\n\n\t\t\t\t\t// Chờ motion hiện tại hoàn thành\n\t\t\t\t\t//GVL.A_RunState := 120;\n\t\t\t\t\t//GVL.A_RunState := 100;\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\t// Kiểm tra BlendMode của Motion hiện tại\n\t\t\t\t\t//\n\t\t\t\t\t// P3:\n\t\t\t\t\t// 0  = Không Blending\n\t\t\t\t\t// >0 = Có Blending\n\t\t\t\t\t//------------------------------------------------\n\t\t\t\t\t\n\t\t\t\t\tIF GVL.A_RunMode = 0 THEN\n\t\t\t\t\t\t//IF (GVL_1.Step_Cr_A[GVL.A_PipelineNextPushStep - 1].P3 > 0) AND (GVL_1.Step_Cr_A[GVL.A_PipelineNextPushStep].P3 > 0) THEN\n\t\t\t\t\t\tIF (GVL_1.Step_Cr_A[GVL.A_PipelineNextPushStep - 1].P3 > 0) THEN\n\t\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t\t// Có Blending:\n\t\t\t\t\t\t\t// quay lại State100 để preload Motion tiếp\n\t\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t\tGVL.A_RunState := 100;\n\t\t\t\t\n\t\t\t\t\t\tELSE\n\t\t\t\t\n\t\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t\t// Không Blending:\n\t\t\t\t\t\t\t// không preload tiếp.\n\t\t\t\t\t\t\t// Chờ Motion hiện tại Done + Check Position.\n\t\t\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t\t\t//GVL.A_RunState := 120;\n\t\t\t\t\t\t\tGVL.A_RunState := 100;\n\t\t\t\t\n\t\t\t\t\t\tEND_IF;\n\t\t\t\t\tELSE\n\t\t\t\t\t\tGVL.A_RunState := 120;\n\t\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n\t\t\t\tELSIF GVL.A_PushMotionError THEN\n\t\t\t\n\t\t\t\t\tGVL.A_PushMotionReq := FALSE;\n\t\t\t\n\t\t\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\t\t\tGVL.A_RunAlarmCode := 3001;\n\t\t\t\t\tGVL.A_RunErrorStep :=\n\t\t\t\t\t\tGVL.A_PipelineNextPushStep;\n\t\t\t\n\t\t\t\t\tGVL.A_RunState := 900;\n\t\t\t\n\t\t\t\tEND_IF;\n\n    120: // WAIT CURRENT STEP DONE\n\t\tIF GVL.A_MotionErrorPulse THEN\n\n\t\t\tGVL.A_RunAlarm := TRUE;\n\t\t\tGVL.A_RunErrorStep := GVL.A_MotionErrorStep;\n\t\t\tGVL.A_RunAlarmCode := GVL.A_MotionErrorCode;\n\t\n\t\t\tGVL.A_MotionErrorPulse := FALSE;\n\t\t\tGVL.A_RunState := 900;\n\t\n\t\n\t\tELSIF GVL.A_MotionDonePulse\n\t\t\t  AND (GVL.A_MotionDoneStep = GVL.A_RunStep)\n\t\tTHEN\n\t\n\t\t\t//--------------------------------------------\n\t\t\t// Tiêu thụ Done của step hiện tại\n\t\t\t//--------------------------------------------\n\t\t\tGVL.A_MotionDonePulse := FALSE;\n\t\t\tGVL.A_MotionDoneStep := 0;\n\t\n\t\t\t//--------------------------------------------\n\t\t\t// Sang step tiếp theo\n\t\t\t//--------------------------------------------\n\t\t\tGVL.A_RunStep :=\n\t\t\t\tGVL.A_RunStep + 1;\n\t\n\t\t\tIF (GVL.A_RunStep <= GVL.A_LengthStep)\n\t\t\t   AND F_IsMotionCmd(\n\t\t\t\t\tGVL_1.Step_Cr_A[GVL.A_RunStep].Cmd\n\t\t\t   )\n\t\t\tTHEN\n\t\n\t\t\t\t//----------------------------------------\n\t\t\t\t// Đồng bộ step tiếp theo cần Push\n\t\t\t\t//----------------------------------------\n// \t\t\t\tGVL.A_PipelineNextPushStep :=\n// \t\t\t\t\tGVL.A_RunStep;\n\t\t\t\tGVL.A_RunState := 100;\n\t\t\t\tIF (GVL.A_RunMode = 1) THEN\n\t\t\t\t\tGVL.A_StepHold := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\n\t\t\tELSE\n\t\n\t\t\t\t// Gặp END_WHILE hoặc logic khác\n\t\t\t\tGVL.A_RunState := 130;\n\t\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\t\t\n\n\n\n    130: // WAIT ALL MOTION CLEAR BEFORE LOGIC\n\n\t\t//--------------------------------------------------------\n\t\t// Chờ queue và toàn bộ slot motion thực sự sạch\n\t\t//--------------------------------------------------------\n\t\tIF (GVL.A_MotionCount <= 0)\n\t\t   AND (GVL.A_ActiveMotionCount <= 0)\n\t\t   AND NOT GVL.A_MotionManagerBusy\n\t\tTHEN\n\t\t\t//----------------------------------------------------\n\t\t\t// Reset trạng thái phiên pipeline vừa kết thúc\n\t\t\t//----------------------------------------------------\n\t\t\tGVL.A_PipelineActive := FALSE;\n// \t\t\tGVL.A_PipelineNextPushStep := 0;\n// \t\n// \t\t\tGVL.A_PushMotionReq := FALSE;\n// \t\t\tGVL.A_PushMotionDone := FALSE;\n// \t\t\tGVL.A_PushMotionError := FALSE;\n// \t\n// \t\t\t//----------------------------------------------------\n// \t\t\t// Xóa phản hồi completion của chuỗi motion vừa chạy\n// \t\t\t//----------------------------------------------------\n// \t\t\tGVL.A_MotionDonePulse := FALSE;\n// \t\t\tGVL.A_MotionDoneStep := 0;\n// \t\n// \t\t\tGVL.A_MotionErrorPulse := FALSE;\n// \t\t\tGVL.A_MotionErrorStep := 0;\n// \t\t\tGVL.A_MotionErrorCode := 0;\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Quay lại READ STEP để chạy lệnh logic:\n\t\t\t// END_WHILE, IF, WAIT, END...\n\t\t\t//----------------------------------------------------\n\t\t\tGVL.A_RunState := 0;\n\t\tEND_IF;\n\t\t\n\t140: // WAIT MOTION CLEAR BEFORE WHILE RESTART\n\n\t\t//--------------------------------------------------------\n\t\t// Chờ toàn bộ motion của vòng hiện tại hoàn thành\n\t\t//--------------------------------------------------------\n\t\tIF (GVL.A_MotionCount <= 0)\n\t\t   AND (GVL.A_ActiveMotionCount <= 0)\n\t\t   AND NOT GVL.A_MotionManagerBusy\n\t\tTHEN\n\t\t\t//----------------------------------------------------\n\t\t\t// Hạ request của pipeline\n\t\t\t//----------------------------------------------------\n\t\t\tGVL.A_PushMotionReq := FALSE;\n\t\t\tGVL.A_PipelineActive := FALSE;\n\t\n\t\t\t//----------------------------------------------------\n\t\t\t// Sang bước reset handshake\n\t\t\t//----------------------------------------------------\n\t\t\tMotionCycleResetScan := 0;\n\t\t\tGVL.A_RunState := 141;\n\t\tEND_IF;\n\t\t\n\t141: // RESET MOTION PIPELINE BEFORE NEXT WHILE LOOP\n\n\t\tCASE MotionCycleResetScan OF\n\t\n\t\t\t0:\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Scan thứ nhất: xóa các tín hiệu phiên cũ\n\t\t\t\t//------------------------------------------------\n\t\t\t\tGVL.A_PushMotionReq := FALSE;\n\t\t\t\tGVL.A_PushMotionDone := FALSE;\n\t\t\t\tGVL.A_PushMotionError := FALSE;\n\t\n\t\t\t\tGVL.A_PipelineActive := FALSE;\n\t\t\t\tGVL.A_PipelineNextPushStep := 0;\n\t\n\t\t\t\tGVL.A_MotionDonePulse := FALSE;\n\t\t\t\tGVL.A_MotionDoneStep := 0;\n\t\n\t\t\t\tGVL.A_MotionErrorPulse := FALSE;\n\t\t\t\tGVL.A_MotionErrorStep := 0;\n\t\t\t\tGVL.A_MotionErrorCode := 0;\n\t\n\t\t\t\tMotionCycleResetScan := 1;\n\t\n\t\n\t\t\t1:\n\t\t\t\t//------------------------------------------------\n\t\t\t\t// Scan thứ hai:\n\t\t\t\t// fbPushMotion đã được gọi với Execute=FALSE.\n\t\t\t\t// Motion FB đã được gọi với Start=FALSE.\n\t\t\t\t//------------------------------------------------\n\t\t\t\tIF NOT GVL.A_PushMotionReq\n\t\t\t\t   AND (GVL.A_MotionCount <= 0)\n\t\t\t\t   AND (GVL.A_ActiveMotionCount <= 0)\n\t\t\t\t   AND NOT GVL.A_MotionManagerBusy\n\t\t\t\tTHEN\n\t\t\t\t\tMotionCycleResetScan := 0;\n\t\n\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\t// Bây giờ mới quay lại WHILE\n\t\t\t\t\t//--------------------------------------------\n\t\t\t\t\tGVL.A_RunStep := WhileReturnStep;\n\t\t\t\t\tGVL.A_RunState := 0;\n\t\t\t\tEND_IF;\n\t\n\t\tEND_CASE;\n\t\n    900: // ERROR\n        GVL.A_RunBusy := FALSE;\n        GVL.A_PushMotionReq := FALSE;\n        GVL.A_PipelineActive := FALSE;\n\nEND_CASE;\n\n\n//====================================================\n// FB Push Motion Queue phải gọi mỗi scan\n//====================================================\nfbPushMotion(\n    Execute := GVL.A_PushMotionReq,\n    Item := GVL.A_PushMotionItem\n);\n\nGVL.A_PushMotionDone  := fbPushMotion.Done;\nGVL.A_PushMotionError := fbPushMotion.Error;","LineInfoPersistence":"(string)508fda55-8ae3-44b1-b2f5-6f298fadabcc_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)1890"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}