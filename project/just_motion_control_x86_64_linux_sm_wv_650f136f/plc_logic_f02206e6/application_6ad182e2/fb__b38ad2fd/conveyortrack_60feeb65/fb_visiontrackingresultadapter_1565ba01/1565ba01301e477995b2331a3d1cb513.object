{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)1565ba01-301e-4779-95b2-331a3d1cb513","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_VisionTrackingResultAdapter","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_VisionTrackingResultAdapter\n//-----------------------------------------------------------------------------\n// Chuyển ST_VISION_RESULT của Vision Framework\n// thành ST_VisionTrackingMultiResult dùng cho Conveyor Tracking.\n//\n// Hỗ trợ:\n// 1. VIS_DATA_POS          -> 1 Tracking Object.\n// 2. VIS_DATA_TRACK_OBJECT -> N Tracking Objects.\n//=============================================================================\n\n\n//=============================================================================\n// DEFAULT PULSE\n//=============================================================================\nNewResultPulse := FALSE;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF Reset OR NOT Enable THEN\n\n    Active := FALSE;\n\n    Error := FALSE;\n    ErrorID := 0;\n\n    udiLastTriggerID := 0;\n\n    TrackingResult.Valid := FALSE;\n    TrackingResult.TriggerID := 0;\n    TrackingResult.CameraID := 0;\n    TrackingResult.JobID := 0;\n    TrackingResult.CaptureConveyorPositionMM := 0.0;\n    TrackingResult.ObjectCount := 0;\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// ACTIVE\n//=============================================================================\nActive := TRUE;\n\n\n//=============================================================================\n// CHƯA CÓ RESULT HỢP LỆ\n//=============================================================================\nIF NOT VisionResult.Header.Valid THEN\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// KHÔNG XỬ LÝ LẠI CÙNG TRIGGER\n//=============================================================================\nIF VisionResult.Header.TriggerID = 0\nOR VisionResult.Header.TriggerID = udiLastTriggerID THEN\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// KIỂM TRA CAMERA\n//=============================================================================\nIF VisionResult.Header.CameraID <> CameraID THEN\n\n    // Không phải Result của Adapter này.\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// KIỂM TRA JOB\n//=============================================================================\nIF VisionResult.Header.JobID <> JobID THEN\n\n    // Không phải Result của Job này.\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// KIỂM TRA RESULT STATUS\n//=============================================================================\nIF VisionResult.Header.ErrorCode <> 0 THEN\n\n    Error := TRUE;\n    ErrorID := 9211;\n\n    // Đánh dấu Trigger đã xử lý để không báo cùng lỗi mỗi scan.\n    udiLastTriggerID := VisionResult.Header.TriggerID;\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// RESET OUTPUT CHO RESULT MỚI\n//=============================================================================\nTrackingResult.Valid := FALSE;\n\nTrackingResult.TriggerID :=\n    VisionResult.Header.TriggerID;\n\nTrackingResult.CameraID :=\n    VisionResult.Header.CameraID;\n\nTrackingResult.JobID :=\n    VisionResult.Header.JobID;\n\n// Quan trọng:\n// Đây phải là Encoder tại lúc CAMERA CAPTURE,\n// không phải Encoder tại lúc Result trả về.\nTrackingResult.CaptureConveyorPositionMM :=\n    REAL_TO_LREAL(VisionResult.Header.CaptureConveyorPos);\n\n// Reset số lượng Object của frame mới.\nTrackingResult.ObjectCount := 0;\n\n// Xóa cờ Valid của dữ liệu frame trước,\n// tránh monitor thấy Object cũ còn tồn tại trong Array.\nFOR uiObject := 1 TO GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME DO\n    TrackingResult.Objects[uiObject].Valid := FALSE;\nEND_FOR;\n\n\n//=============================================================================\n// XỬ LÝ THEO DATA TYPE\n//=============================================================================\nCASE VisionResult.Header.DataType OF\n\n\n    //=========================================================================\n    // MỘT POSE -> MỘT TRACKING OBJECT\n    //=========================================================================\n    E_VisionDataType.VIS_DATA_POS:\n\n        IF VisionResult.PosResult.Valid THEN\n\n            TrackingResult.ObjectCount := 1;\n\n            TrackingResult.Objects[1].Valid := TRUE;\n\n            TrackingResult.Objects[1].RawPos :=\n                VisionResult.PosResult.Pos;\n\n            TrackingResult.Objects[1].Score :=\n                VisionResult.PosResult.Score;\n\n            // PosResult hiện không có ProductClass.\n            // VisionObjectSource sẽ lấy default từ Config.\n            TrackingResult.Objects[1].ProductClassID := 0;\n\n            TrackingResult.Objects[1].FeatureID :=\n                TO_UDINT(VisionResult.PosResult.FeatureID);\n\n            TrackingResult.Valid := TRUE;\n\n        ELSE\n\n            TrackingResult.ObjectCount := 0;\n\n            // Result hợp lệ nhưng không tìm thấy Object.\n            TrackingResult.Valid := TRUE;\n\n        END_IF;\n\n\n    //=========================================================================\n    // N OBJECT -> N TRACKING OBJECT\n    //=========================================================================\n    E_VisionDataType.VIS_DATA_TRACK_OBJECT:\n\n        //---------------------------------------------------------------------\n        // Kiểm tra bộ Multi Object.\n        //---------------------------------------------------------------------\n        IF VisionResult.TrackObjectResult.Valid THEN\n\n            uiObjectCount :=\n                VisionResult.TrackObjectResult.ObjectCount;\n\n            //-----------------------------------------------------------------\n            // Giới hạn theo kích thước Array.\n            //-----------------------------------------------------------------\n            IF uiObjectCount >\n                GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME THEN\n\n                uiObjectCount :=\n                    GVL.C_MAX_VISION_TRACK_OBJECTS_PER_FRAME;\n\n            END_IF;\n\n\n            //-----------------------------------------------------------------\n            // Có thể kiểm tra thêm Header.DataCount.\n            //\n            // Nếu protocol quy ước:\n            // Header.DataCount = số Object\n            // thì lấy MIN của hai giá trị.\n            //-----------------------------------------------------------------\n            IF VisionResult.Header.DataCount < uiObjectCount THEN\n\n                uiObjectCount :=\n                    VisionResult.Header.DataCount;\n\n            END_IF;\n\n\n            TrackingResult.ObjectCount :=\n                uiObjectCount;\n\n\n            //-----------------------------------------------------------------\n            // COPY TỪ VISION RESULT SANG TRACKING RESULT\n            //-----------------------------------------------------------------\n            FOR uiObject := 1 TO uiObjectCount DO\n\n                TrackingResult.Objects[uiObject].Valid :=\n                    VisionResult.TrackObjectResult.Objects[uiObject].Valid;\n\n                TrackingResult.Objects[uiObject].RawPos :=\n                    VisionResult.TrackObjectResult.Objects[uiObject].Pos;\n\n                TrackingResult.Objects[uiObject].Score :=\n                    VisionResult.TrackObjectResult.Objects[uiObject].Score;\n\n                TrackingResult.Objects[uiObject].ProductClassID :=\n                    VisionResult.TrackObjectResult.Objects[uiObject].ProductClassID;\n\n                TrackingResult.Objects[uiObject].FeatureID :=\n                    VisionResult.TrackObjectResult.Objects[uiObject].FeatureID;\n\n            END_FOR;\n\n\n            TrackingResult.Valid := TRUE;\n\n        ELSE\n\n            // Multi Object Result chưa hoàn chỉnh.\n            RETURN;\n\n        END_IF;\n\n\n    //=========================================================================\n    // DATA TYPE KHÁC KHÔNG PHẢI TRACKING\n    //=========================================================================\n    ELSE\n\n        // Không báo Error vì Camera có thể chạy Align/Inspection/Glue.\n        RETURN;\n\nEND_CASE;\n\n\n//=============================================================================\n// RESULT ĐÃ HOÀN THÀNH\n//=============================================================================\nIF TrackingResult.Valid THEN\n\n    // Đánh dấu Trigger đã xử lý.\n    udiLastTriggerID :=\n        VisionResult.Header.TriggerID;\n\n    // Xung thông báo Result mới.\n    NewResultPulse := TRUE;\n\nEND_IF;","LineInfoPersistence":"(string)1565ba01-301e-4779-95b2-331a3d1cb513_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_VisionTrackingResultAdapter\n\nVAR_INPUT\n\n    // Cho phép Adapter.\n    Enable : BOOL;\n\n    // Reset Adapter.\n    Reset : BOOL;\n\n    // Camera/Source mong đợi.\n    CameraID : UINT;\n\n    // Job mong đợi.\n    JobID : UINT;\n\n    // Result chung từ Vision framework.\n    VisionResult : ST_VISION_RESULT;\n\nEND_VAR\n\n\nVAR_OUTPUT\n\n    // Result chuẩn dành cho Conveyor Tracking.\n    TrackingResult : ST_VisionTrackingMultiResult;\n\n    // Xung một scan khi có Result mới hoàn chỉnh.\n    NewResultPulse : BOOL;\n\n    // Adapter đang hoạt động.\n    Active : BOOL;\n\n    // Lỗi Adapter.\n    Error : BOOL;\n\n    ErrorID : UDINT;\n\nEND_VAR\n\n\nVAR\n\n    // Trigger cuối đã xử lý.\n    udiLastTriggerID : UDINT;\n\n    // Số Object thực tế cần copy.\n    uiObjectCount : UINT;\n\n    // Index copy Object.\n    uiObject : UINT;\n\nEND_VAR","LineInfoPersistence":"(string)1565ba01-301e-4779-95b2-331a3d1cb513_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)329","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}