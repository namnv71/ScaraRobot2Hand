{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)88faaecc-47ee-461f-a798-47297b798ce0","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_TriggerVS","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// FB_TriggerVS\n// Trigger Vision + chờ TriggerDone.\n// T_Delay_Trigger_time được dùng làm TIMEOUT tối đa.\n//=============================================================================\n\n\n//=============================================================================\n// ENABLE RISING EDGE\n//=============================================================================\nRTrig_Enable(CLK := Enable);\n\nIF RTrig_Enable.Q THEN\n    State := 0;\n    StartOld := FALSE;\n\n    Busy := FALSE;\n    DoneAll := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    count_Vs_Align := 0;\n    xDelayTrigger := FALSE;\n\n    IF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n        GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n        GVL.g_aVisionCommand[CameraID].Abort := FALSE;\n        GVL.g_aVisionCommand[CameraID].Reset := FALSE;\n    END_IF;\nEND_IF;\n\n\n//=============================================================================\n// DISABLE\n//=============================================================================\nIF NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n\n    Busy := FALSE;\n    DoneAll := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n\n    count_Vs_Align := 0;\n    xDelayTrigger := FALSE;\n\n    IF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n        GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n    END_IF;\n\n    // Reset TON ngay khi Disable.\n    t_Delay_Trigger(IN := FALSE, PT := TO_TIME(T_Delay_Trigger_time) * 100);\n\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// STATE MACHINE\n//=============================================================================\nCASE State OF\n\n    //-------------------------------------------------------------------------\n    // STATE 0 - IDLE\n    //-------------------------------------------------------------------------\n    0:\n        Busy := FALSE;\n        DoneAll := FALSE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        count_Vs_Align := 0;\n        xDelayTrigger := FALSE;\n\n        IF Start AND NOT StartOld THEN\n\n            IF CameraID < 1 OR CameraID > GVL.C_MAX_VISION_CHANNELS THEN\n                Error := TRUE;\n                ErrorID := 1;\n                State := 900;\n\n            ELSIF Mode_ByPass_VS THEN\n                State := 30;\n\n            ELSE\n                Busy := TRUE;\n                State := 5;\n            END_IF;\n\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 5 - PREPARE TRIGGER\n    //\n    // Hạ Execute và reset Timer trước khi phát Trigger mới.\n    // Nếu TriggerDone cũ vẫn TRUE thì chờ nó hạ.\n    //-------------------------------------------------------------------------\n    5:\n        GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n        xDelayTrigger := FALSE;\n\n        IF NOT GVL.g_aVisionModbusStatus[CameraID].TriggerDone THEN\n            State := 10;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 10 - SEND TRIGGER\n    //\n    // Tạo TriggerID mới và bật Execute.\n    //-------------------------------------------------------------------------\n    10:\n        udiTriggerCounter := udiTriggerCounter + 1;\n\n        IF udiTriggerCounter = 0 THEN\n            udiTriggerCounter := 1;\n        END_IF;\n\n        CurrentTriggerID := udiTriggerCounter;\n\n        GVL.g_aVisionCommand[CameraID].CameraID := CameraID;\n        GVL.g_aVisionCommand[CameraID].JobID := JobID;\n        GVL.g_aVisionCommand[CameraID].Application := Application;\n        GVL.g_aVisionCommand[CameraID].TriggerID := CurrentTriggerID;\n\n        GVL.g_aVisionCommand[CameraID].Abort := FALSE;\n        GVL.g_aVisionCommand[CameraID].Reset := FALSE;\n        GVL.g_aVisionCommand[CameraID].Execute := TRUE;\n\n        // Bắt đầu Timeout từ Trigger này.\n        xDelayTrigger := TRUE;\n\n        State := 20;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 20 - WAIT TRIGGER DONE\n    //\n    // Ưu tiên TriggerDone.\n    // Chỉ Timeout nếu hết thời gian mà chưa nhận TriggerDone.\n    //-------------------------------------------------------------------------\n    20:\n        GVL.g_aVisionCommand[CameraID].Execute := TRUE;\n\n        IF GVL.g_aVisionModbusStatus[CameraID].TriggerDone THEN\n            GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n            xDelayTrigger := FALSE;\n\n            State := 30;\n\n        ELSIF t_Delay_Trigger.Q THEN\n            GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n            xDelayTrigger := FALSE;\n\n            count_Vs_Align := count_Vs_Align + 1;\n\n            IF count_Vs_Align < count_Vs_Align_max THEN\n                State := 5;\n            ELSE\n                Error := TRUE;\n                ErrorID := 2;\n                State := 900;\n            END_IF;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 30 - TRIGGER DONE\n    //\n    // Chỉ có nghĩa Trigger handshake đã nhận TriggerDone.\n    // Result Vision sẽ do FB_VisionWaitResult xử lý.\n    //-------------------------------------------------------------------------\n    30:\n        IF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n            GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n        END_IF;\n\n        xDelayTrigger := FALSE;\n\n        Busy := FALSE;\n        DoneAll := TRUE;\n        Error := FALSE;\n        ErrorID := 0;\n\n        IF NOT Start THEN\n            State := 0;\n        END_IF;\n\n\n    //-------------------------------------------------------------------------\n    // STATE 900 - ERROR\n    //\n    // ErrorID:\n    // 1 = CameraID không hợp lệ.\n    // 2 = Trigger Timeout quá số lần cho phép.\n    //-------------------------------------------------------------------------\n    900: // ERROR\n\t\tIF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n\t\t\tGVL.g_aVisionCommand[CameraID].Execute := FALSE;\n\t\tEND_IF;\n\t\n\t\txDelayTrigger := FALSE;\n\t\n\t\tBusy := FALSE;\n\t\tDoneAll := FALSE;\n\t\n\t\t// Nếu người dùng yêu cầu Trigger lại ngay khi Start vẫn còn giữ.\n\t\tIF Trigger_Again THEN\n\t\t\tError := FALSE;\n\t\t\tErrorID := 0;\n\t\t\tcount_Vs_Align := 0;\n\t\n\t\t\tState := 5;\n\t\n\t\t// Khi bên gọi nhả Start thì kết thúc chu trình lỗi,\n\t\t// reset FB để sẵn sàng cho lần Start tiếp theo.\n\t\tELSIF NOT Start THEN\n\t\t\tError := FALSE;\n\t\t\tErrorID := 0;\n\t\t\tcount_Vs_Align := 0;\n\t\n\t\t\tState := 0;\n\t\tEND_IF;\n\nEND_CASE;\n\n\n//=============================================================================\n// TIMER\n//\n// ĐẶT SAU STATE MACHINE.\n// Như vậy xDelayTrigger vừa được thay đổi trong State hiện tại sẽ tác động\n// ngay vào TON trong chính scan này.\n//=============================================================================\nt_Delay_Trigger(\n    IN := xDelayTrigger,\n    PT := TO_TIME(T_Delay_Trigger_time) * 100\n);\n\n\n//=============================================================================\n// SAVE OLD SIGNAL\n//=============================================================================\nStartOld := Start;","LineInfoPersistence":"(string)88faaecc-47ee-461f-a798-47297b798ce0_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_TriggerVS\nVAR_INPUT\n    Enable : BOOL;\n    Start : BOOL;\n\n    CameraID : UINT;\n    JobID : UINT;\n    Application : E_VisionApplication;\n\n    count_Vs_Align_max : INT;\n    T_Delay_Trigger_time : INT;\n\n    Trigger_Again : BOOL;\n    Pass_Triger_VS_NG : BOOL;\n    Mode_ByPass_VS : BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    Busy : BOOL;\n    DoneAll : BOOL;\n    Error : BOOL;\n    ErrorID : INT;\n\n    CurrentTriggerID : UDINT;\nEND_VAR\n\nVAR\n    State : INT;\n    StartOld : BOOL;\n\n    count_Vs_Align : INT;\n\n    t_Delay_Trigger : TON;\n    xDelayTrigger : BOOL;\n\n    RTrig_Enable : R_TRIG;\n\n    udiTriggerCounter : UDINT;\nEND_VAR","LineInfoPersistence":"(string)88faaecc-47ee-461f-a798-47297b798ce0_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)285","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}