{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6b32af32-9da6-4fda-8375-2a97ba94ad33","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B_Auto_Calib_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)42d80ded-8752-4d8a-bf5f-3274bbc10f1e"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Trigger_Calib_Done(CLK := GVL.Pro4_.Man.Result_Trigger_Vs_Align_Done);\nT_Delay_Trigger_Calib(PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Vision_Align)*100);\n//WHILE i_Vs_Align < 12 AND GVL.Pro4_.Man.Run_Calib_Pos DO\nM_CHOOSE_POS_Man(DATA := 1, ID := i_Vs_Align + 34, XYR_CONST := FALSE, Z_CONST:= FALSE); // pos 2\nIF NOT excute_run_P_cam_B AND NOT Run_One_Pos_Calib THEN\n\t// B_Comp := FALSE;\n\texcute_run_P_cam_B := TRUE;\nEND_IF\t\t\nIF MOVP_B.Error OR MOVL_B.Error THEN\n\texcute_run_P_cam_B\t:= FALSE;\t \t \nEND_IF;\t\t\t\t\nIF MOVP_B.Done AND excute_run_P_cam_B THEN\n\tRun_One_Pos_Calib := TRUE;\n\texcute_run_P_cam_B :=FALSE;\t\n\tT_Delay_Trigger_Calib.IN := TRUE;\n\tGVL.Pro4_.Man.Trigger_Vs_Align_On_Off := TRUE;\n\tReal_to_Word_Pos_Calib(\tR_RB_X\t:= TO_REAL(GVL.RB_B_.CUR_X),\n\t\t\t\tR_RB_Y\t:= TO_REAL(GVL.RB_B_.CUR_Y),\n\t\t\t\tR_RB_r\t:= TO_REAL(GVL.RB_B_.CUR_R),\n\t\t\t\tLOW_RB_X\t=> GVL.MODBUS[i_Vs_Align*6 + 16],\n\t\t\t\tHIGH_RB_X\t=> GVL.MODBUS[i_Vs_Align*6 + 17],\n\t\t\t\tLOW_RB_Y\t=> GVL.MODBUS[i_Vs_Align*6 + 18],\n\t\t\t\tHIGH_RB_Y\t=> GVL.MODBUS[i_Vs_Align*6 + 19],\n\t\t\t\tLOW_RB_R\t=> GVL.MODBUS[i_Vs_Align*6 + 20],\n\t\t\t\tHIGH_RB_R\t=> GVL.MODBUS[i_Vs_Align*6 + 21]);\n\tIF (i_Vs_Align = 11) THEN\n\t\tGVL.Pro4_.Man.Run_Calib_Pos_Done := TRUE;\n\tEND_IF;\t\t\t \nEND_IF;\nIF (T_Delay_Trigger_Calib.Q AND Trigger_Calib_Done.Q AND Run_One_Pos_Calib) THEN\n\tT_Delay_Trigger_Calib.IN := FALSE;\n\tGVL.Pro4_.Man.Trigger_Vs_Align_On_Off := FALSE;\n\ti_Vs_Align := i_Vs_Align + 1;\n\tRun_One_Pos_Calib := FALSE;\nEND_IF\n\t\n//END_WHILE","LineInfoPersistence":"(string)6b32af32-9da6-4fda-8375-2a97ba94ad33_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)37"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}