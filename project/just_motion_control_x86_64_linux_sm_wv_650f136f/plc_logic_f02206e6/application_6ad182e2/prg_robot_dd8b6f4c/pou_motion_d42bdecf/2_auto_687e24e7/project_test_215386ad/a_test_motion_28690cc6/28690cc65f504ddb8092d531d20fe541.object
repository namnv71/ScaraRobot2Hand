rocess_A_Test := Process_A_Test + 5;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t10: // Point 2 - BF Pick T1 - 1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 1, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t20: // Point 3 - Pick Product by Tool 1 - 1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 2, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tGVL.RB_A_.Tool_1 := 1;\n\t\t\t\tT_Delay_RB_A_Tool_1.IN := TRUE;\n\t\t\t\t\n\t\t\tEND_IF;\n\t\t\tIF T_Delay_RB_A_Tool_1.Q THEN\t\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\t\tT_Delay_RB_A_Tool_1.IN := FALSE;\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\tEND_IF;\n\t\t30: // Point 2 - Return BF Pick T1 -1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 1, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\t\n\t\t40: // Point 4 - BF Place T1 - 1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 3, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\n\t\t50: // Point 5 - Place T1 - 1 \n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 4, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tGVL.RB_A_.Tool_1 := 0;\n\t\t\t\tT_Delay_RB_A_Tool_1.IN := TRUE;\n\t\t\t\t//Move_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\n\t\t\tIF T_Delay_RB_A_Tool_1.Q THEN\t\t\t\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\t\tT_Delay_RB_A_Tool_1.IN := FALSE;\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\tEND_IF\n\t\t\n\t\t60: // Point 4 - BF Place T1 - 1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 3, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\n\t\t70: // Point 6 - BF Pick T1-2\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 5, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t80: // Point 7 - Pick Tool 1 - 2\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 6, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tGVL.RB_A_.Tool_1 := 1;\n\t\t\t\tT_Delay_RB_A_Tool_2.IN := TRUE;\n\t\t\t\t//Move_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\tIF T_Delay_RB_A_Tool_2.Q THEN\n\t\t\t\tT_Delay_RB_A_Tool_2.IN := FALSE;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\tEND_IF;\n\t\t90: // Point 6 - Return BF Pick T1 - 2 \n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 5, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\t\n\t\t100: // Point 8 - BF Place T1 - 2 \n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 7, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\n\t\t110: // Point 9 - Place T2\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 8, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tGVL.RB_A_.Tool_1 := 0;\n\t\t\t\tT_Delay_RB_A_Tool_2.IN := TRUE;\n\t\t\t\t//Move_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\n\t\t\tIF T_Delay_RB_A_Tool_2.Q THEN\t\t\t\n\t\t\t\tT_Delay_RB_A_Tool_2.IN := FALSE;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\tEND_IF\n\t\t\n\t\t120: // Point 8 - BF Place T2\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_A.Hand_Type, ID := 7, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_A.Enable THEN\n\t\t\t\tMove_Point_Para_A.Enable := TRUE;\n\t\t\t\tMove_Point_Para_A.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_A.Done AND NOT Move_RB_A.Busy THEN\t\n\t\t\t\tProcess_A_Test := Process_A_Test + 10;\n\t\t\t\tMove_Point_Para_A.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\t\n\t\t\n\t\t130: // WAIT XYR\n\t\t\tProcess_A_Test := 5;\n\t\t\tA_Test_Motion_Finish := TRUE;\n\t\t\n\tEND_CASE\nELSE\n\tProcess_A_Test := 0;\nEND_IF","LineInfoPersistence":"(string)28690cc6-5f50-4ddb-8092-d531d20fe541_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)187"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}