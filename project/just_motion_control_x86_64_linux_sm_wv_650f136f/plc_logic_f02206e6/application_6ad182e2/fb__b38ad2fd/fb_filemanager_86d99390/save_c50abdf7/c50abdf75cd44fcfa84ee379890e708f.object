{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c50abdf7-5cd4-4fcf-a84e-e379890e708f","ParentGuid":"(Guid)86d99390-9f83-41e2-b6f3-5545544b4769","Name":"(string)Save","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)f8a58466-d7f6-439f-bbb8-d4600e41d099","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"f8a58466","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// // Ghép đường dẫn\n// sPath := CONCAT('Data_Lock/', sFileName);\n// \n// // 1️⃣ Mở file\n// hFile := sysfile.SysFileOpen(\n//     szFile := sPath,\n//     am := sysfile.ACCESS_MODE.AM_WRITE_PLUS,\n//     pResult := ADR(Result)\n// );\n// \n// \n// // 2️⃣ Nếu mở thành công thì ghi\n// IF hFile <> sysfile.RTS_INVALID_HANDLE THEN\n// \n//     sysfile.SysFileWrite(\n//         hFile := hFile,\n//         pbyBuffer := pData,\n//         ulSize := uiSize,\n//         pResult := ADR(Result)\n//     );\n// \n//     // 3️⃣ Đóng file\n//     sysfile.SysFileClose(hFile);\n// \n//     Save := TRUE;\n// \n// ELSE\n//     Save := FALSE;\n// END_IF\n\n//nmanv0404\nSave := FALSE;\nResult := 0;\nsPath := CONCAT('Data_Lock/', sFileName);\n\nhFile := sysfile.SysFileOpen(\n    szFile := sPath,\n    am := sysfile.ACCESS_MODE.AM_WRITE,\n    pResult := ADR(Result)\n);\n\nIF hFile <> sysfile.RTS_INVALID_HANDLE THEN\n\n    udiWrittenSize := sysfile.SysFileWrite(\n        hFile := hFile,\n        pbyBuffer := pData,\n        ulSize := uiSize,\n        pResult := ADR(Result)\n    );\n\n    sysfile.SysFileFlush(hFile);\n    sysfile.SysFileClose(hFile);\n\n    IF (Result = 0) AND (udiWrittenSize = uiSize) THEN\n        Save := TRUE;\n    ELSE\n        Save := FALSE;\n    END_IF;\n\nELSE\n    Save := FALSE;\nEND_IF;","LineInfoPersistence":"(string)c50abdf7-5cd4-4fcf-a84e-e379890e708f_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)METHOD Save : BOOL\nVAR_INPUT\n\tpData : POINTER TO BYTE;   // con trỏ dữ liệu\n    uiSize : UDINT;            // kích thước\n    sFileName : STRING;        // tên file\nEND_VAR\nVAR\n\tudiWrittenSize: UDINT;\nEND_VAR","LineInfoPersistence":"(string)c50abdf7-5cd4-4fcf-a84e-e379890e708f_Decl_LineIds"}}}}}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","f8a58466":"{f8a58466-d7f6-439f-bbb8-d4600e41d099}","string":"System.String"}}},"FormatVersion":"1.0"}