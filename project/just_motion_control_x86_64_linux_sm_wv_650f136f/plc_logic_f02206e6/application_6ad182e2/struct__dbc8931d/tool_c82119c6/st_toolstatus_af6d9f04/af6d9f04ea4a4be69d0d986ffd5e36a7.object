{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)af6d9f04-ea4a-4be6-9d0d-986ffd5e36a7","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_ToolStatus","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c82119c6-41a8-4a9a-b112-767836bbfe84"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: TOOL STATUS\n//=============================================================================\nTYPE ST_ToolStatus :\nSTRUCT\n\n    // Xung báo đã nhận lệnh.\n    Accepted : BOOL;\n\n    // Tool đang thực thi lệnh.\n    Busy : BOOL;\n\n    // Xung báo lệnh hoàn thành.\n    Done : BOOL;\n\n    // Tool báo lỗi.\n    Error : BOOL;\n\n    // Mã lỗi.\n    ErrorID : UDINT;\n\n    // CommandID vừa xử lý.\n    ResponseCommandID : UDINT;\n\n    // ToolID của Status.\n    ToolID : UINT;\n\n    // State hiện tại của Tool.\n    State : E_ToolRuntimeState;\n\n    // Phản hồi Tool Up.\n    UpOK : BOOL;\n\n    // Phản hồi Tool Down.\n    DownOK : BOOL;\n\n    // Phản hồi Grip.\n    GripOK : BOOL;\n\n    // Phản hồi có sản phẩm.\n    PartPresent : BOOL;\n\n    // TRUE khi Tool đang giữ sản phẩm.\n    Occupied : BOOL;\n\n    // ObjectID đang được giữ.\n    HeldObjectID : UDINT;\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)af6d9f04-ea4a-4be6-9d0d-986ffd5e36a7_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)51"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}