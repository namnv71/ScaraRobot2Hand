{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)8d9892e8-4166-42c7-9bf3-83845897484c","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_VisionTest","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)c6df95bb-64ac-4d71-855a-28b905fd49bd"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// TEST - CAPTURE CONVEYOR POSITION\n//-----------------------------------------------------------------------------\n// Giả lập vị trí Encoder tại đúng thời điểm Camera chụp.\n//=============================================================================\ndiTestCapturePos := F_VisionRealToRawDINT(\n    Value := GVL.g_aConveyorRuntime[1].Status.PositionMM,\n    Scale := GVL.g_aVisionConfig[1].PositionScale\n);\n\n\n\n//=============================================================================\n// TEST VISION CAMERA 1\n//-----------------------------------------------------------------------------\n// Giả lập Vision trả 1 Tracking Object.\n// PositionScale = 0.001.\n//=============================================================================\n\n//-------------------------------------------------------------------------\n// STATUS + HEADER\n//-------------------------------------------------------------------------\nGVL.MODBUS[100] := WORD#16#0049;    // Bit0 Heartbeat + Bit3 ResultReady + Bit6 BlockReady.\n\nGVL.MODBUS[101] := 1;               // JobID.\nGVL.MODBUS[102] := 70;              // VIS_APP_CONVEYOR_PICK.\nGVL.MODBUS[103] := 80;              // VIS_DATA_TRACK_OBJECT.\n\nGVL.MODBUS[104] := 5;               // TriggerID LOW.\nGVL.MODBUS[105] := 0;               // TriggerID HIGH.\n\nGVL.MODBUS[106] := 20;              // VIS_RESULT_OK.\nGVL.MODBUS[107] := 0;               // ErrorCode.\n\nGVL.MODBUS[108] := 1;               // DataCount = 1.\nGVL.MODBUS[109] := 1;               // BlockCount = 1.\nGVL.MODBUS[110] := 1;               // BlockIndex = 1.\nGVL.MODBUS[111] := 1;               // BlockDataCount = 1.\n\nGVL.MODBUS[112] := 0;               // Checksum LOW.\nGVL.MODBUS[113] := 0;               // Checksum HIGH.\n\nGVL.MODBUS[114] := 0;               // CaptureConveyorPos LOW.\nGVL.MODBUS[115] := 0;               // CaptureConveyorPos HIGH.\n\nGVL.MODBUS[114] := F_VisionDINTLowWord(diTestCapturePos);\nGVL.MODBUS[115] := F_VisionDINTHighWord(diTestCapturePos);\n\n//-------------------------------------------------------------------------\n// OBJECT 1\n// X = 10 mm\n// Y = -20 mm\n// A = 90 deg\n//-------------------------------------------------------------------------\nGVL.MODBUS[132] := F_VisionDINTLowWord(20000);\nGVL.MODBUS[133] := F_VisionDINTHighWord(20000);\n\nGVL.MODBUS[134] := F_VisionDINTLowWord(-20000);\nGVL.MODBUS[135] := F_VisionDINTHighWord(-20000);\n\nGVL.MODBUS[136] := F_VisionDINTLowWord(90000);\nGVL.MODBUS[137] := F_VisionDINTHighWord(90000);\n\nGVL.MODBUS[138] := WORD#16#0003;     // Bit0 Valid + Bit1 AngleValid.\nGVL.MODBUS[139] := 95;               // Score.\nGVL.MODBUS[140] := 1;                // ProductClassID.","LineInfoPersistence":"(string)8d9892e8-4166-42c7-9bf3-83845897484c_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_VisionTest\nVAR\nEND_VAR\nVAR\n    diTestCapturePos : DINT;\nEND_VAR","LineInfoPersistence":"(string)8d9892e8-4166-42c7-9bf3-83845897484c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)72","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}