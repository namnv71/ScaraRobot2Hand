{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4638edfb-d125-4d67-a1a9-2c919843da7d","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)M_CHOOSE_POS_VS","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)f3c2e45c-10c1-465d-8b1d-64cc9b397cb8"}]}}}}]},"TypeGuid":"(Guid)f8a58466-d7f6-439f-bbb8-d4600e41d099","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"f8a58466","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)CASE DATA OF\n\t0:\n\t\tIF NOT XYR_CONST AND Z_CONST THEN\n\t\t\tPos_run_auto_A.c.X := GVL_1.DATA_RB_A.X_POS[ID] + GVL.Cam_T1.POS_X_OFFSET;\n\t\t\tPos_run_auto_A.c.Y := GVL_1.DATA_RB_A.Y_POS[ID] + GVL.Cam_T1.POS_Y_OFFSET;\n\t\t\tPos_run_auto_A.c.Z := POU_MONITOR_ROBOT.RB1_POS.c.Z;\n\t\t\tPos_run_auto_A.c.A := GVL_1.DATA_RB_A.R_POS[ID] + GVL.Cam_T1.POS_R_OFFSET;\t\t\t\n\t\tEND_IF\n\t1:\n\t\tIF NOT XYR_CONST AND Z_CONST THEN\n\t\t\tPos_run_auto_B.c.X := GVL_1.DATA_RB_B.X_POS[ID] + GVL.Cam_T1.POS_X_OFFSET;\n\t\t\tPos_run_auto_B.c.Y := GVL_1.DATA_RB_B.Y_POS[ID] + GVL.Cam_T1.POS_Y_OFFSET;\n\t\t\tPos_run_auto_B.c.Z := POU_MONITOR_ROBOT.RB2_POS.c.Z;\n\t\t\tPos_run_auto_B.c.A := GVL_1.DATA_RB_B.R_POS[ID] + GVL.Cam_T1.POS_R_OFFSET;\t\t\t\n\t\tEND_IF\t\nEND_CASE","LineInfoPersistence":"(string)4638edfb-d125-4d67-a1a9-2c919843da7d_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)METHOD M_CHOOSE_POS_VS : BOOL\nVAR_INPUT\n\tDATA, ID : WORD; // 0 : RBA --- 1 : RBB\n\tXYR_CONST, Z_CONST : BOOL;\n\t\nEND_VAR\n","LineInfoPersistence":"(string)4638edfb-d125-4d67-a1a9-2c919843da7d_Decl_LineIds"}}}}}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","f8a58466":"{f8a58466-d7f6-439f-bbb8-d4600e41d099}","string":"System.String"}}},"FormatVersion":"1.0"}