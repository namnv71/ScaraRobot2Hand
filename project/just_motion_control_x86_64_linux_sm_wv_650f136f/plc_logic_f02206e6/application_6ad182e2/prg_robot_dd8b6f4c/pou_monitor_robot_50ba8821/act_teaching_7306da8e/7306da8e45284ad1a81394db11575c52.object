{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7306da8e-4528-4ad1-a813-94db11575c52","ParentGuid":"(Guid)50ba8821-12b7-44cd-9415-f982bd6a7ece","Name":"(string)ACT_Teaching","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Teaching Robot A\nIF GVL.RB_A.Manual AND \tGVL.RB_A.Comfirm_Teach AND GVL.DW_[10] > 0  THEN\n\tCASE GVL.RB_A.Control_w_mode OF\n\t\t0: \n\t\t\tGVL_1.Point_Name_A[GVL.DW_[10]]      := GVL.HMI_A_Edit_Pos_Name;\n\t\t\tGVL_1.DATA_RB_A.X_POS[GVL.DW_[10]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_A.LIMIT_X_BW, GVL.RB_A_.CUR_X, GVL_1.DATA_RB_A.LIMIT_X_FW));\n\t\t\tGVL_1.DATA_RB_A.Y_POS[GVL.DW_[10]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_A.LIMIT_Y_BW, GVL.RB_A_.CUR_Y, GVL_1.DATA_RB_A.LIMIT_Y_FW));\n\t\t\tGVL_1.DATA_RB_A.Z_POS[GVL.DW_[10]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_A.LIMIT_Z_BW, GVL.RB_A_.CUR_Z, GVL_1.DATA_RB_A.LIMIT_Z_FW));\n\t\t\tGVL_1.DATA_RB_A.R_POS[GVL.DW_[10]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_A.LIMIT_R_BW, GVL.RB_A_.CUR_R, GVL_1.DATA_RB_A.LIMIT_R_FW));\n\t\t1:\n\t\t\tGVL_1.Point_Name_A[GVL.DW_[10]]      := GVL.HMI_A_Edit_Pos_Name;\n\t\t\tGVL_1.DATA_RB_A.X_POS[GVL.DW_[10]] := TO_REAL(GVL.RB_A_.CUR_X);\n\t\t\tGVL_1.DATA_RB_A.Y_POS[GVL.DW_[10]] := TO_REAL(GVL.RB_A_.CUR_Y);\n\t\t\tGVL_1.DATA_RB_A.Z_POS[GVL.DW_[10]] := TO_REAL(GVL.RB_A_.CUR_Z);\n\t\t\tGVL_1.DATA_RB_A.R_POS[GVL.DW_[10]] := TO_REAL(GVL.RB_A_.CUR_R);\n\tEND_CASE\n\tGVL.RB_A.Comfirm_Teach := FALSE;\nEND_IF\n\n\nIF GVL.RB_B.Manual AND GVL.RB_B.Comfirm_Teach AND GVL.DW_[12] > 0 THEN\n    CASE GVL.RB_B.Control_w_mode OF\n        0:\n            GVL_1.Point_Name_B[GVL.DW_[12]] := GVL.HMI_B_Edit_Pos_Name;\n            GVL_1.DATA_RB_B.X_POS[GVL.DW_[12]] := TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_X_BW, GVL.RB_B_.CUR_X, GVL_1.DATA_RB_B.LIMIT_X_FW));\n            GVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]] := TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_Y_BW, GVL.RB_B_.CUR_Y, GVL_1.DATA_RB_B.LIMIT_Y_FW));\n            GVL_1.DATA_RB_B.Z_POS[GVL.DW_[12]] := TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_Z_BW, GVL.RB_B_.CUR_Z, GVL_1.DATA_RB_B.LIMIT_Z_FW));\n            GVL_1.DATA_RB_B.R_POS[GVL.DW_[12]] := TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_R_BW, GVL.RB_B_.CUR_R, GVL_1.DATA_RB_B.LIMIT_R_FW));\n        1:\n            GVL_1.Point_Name_B[GVL.DW_[12]] := GVL.HMI_B_Edit_Pos_Name;\n            GVL_1.DATA_RB_B.X_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_X);\n            GVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_Y);\n            GVL_1.DATA_RB_B.Z_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_Z);\n            GVL_1.DATA_RB_B.R_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_R);\n    END_CASE;\n    GVL.RB_B.Comfirm_Teach := FALSE;\nEND_IF;\n\n\t\n// // Teaching Robot B\n// IF GVL.RB_B.Manual AND \tGVL.RB_B.Comfirm_Teach AND GVL.DW_[12] > 0  THEN\n// \tCASE GVL.RB_B.Control_w_mode OF\n// \t\t0:\t\n// \t\t\t//GVL_1.Point_Name_B[GVL.DW_[12]]      := GVL.HMI_B_Edit_Pos_Name;\n// \t\t\tGVL_1.DATA_RB_B.X_POS[GVL.DW_[12]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_X_BW, GVL.RB_B_.CUR_X, GVL_1.DATA_RB_B.LIMIT_X_FW));\n// \t\t\tGVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_Y_BW, GVL.RB_B_.CUR_Y, GVL_1.DATA_RB_B.LIMIT_Y_FW));\n// \t\t\tGVL_1.DATA_RB_B.Z_POS[GVL.DW_[12]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_Z_BW, GVL.RB_B_.CUR_Z, GVL_1.DATA_RB_B.LIMIT_Z_FW));\n// \t\t\tGVL_1.DATA_RB_B.R_POS[GVL.DW_[12]] :=  TO_REAL(LIMIT(GVL_1.DATA_RB_B.LIMIT_R_BW, GVL.RB_B_.CUR_R, GVL_1.DATA_RB_B.LIMIT_R_FW));\t\n// \t\t1:\n// \t\t\tGVL_1.DATA_RB_B.X_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_X);\n// \t\t\tGVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_Y);\n// \t\t\tGVL_1.DATA_RB_b.Z_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_Z);\n// \t\t\tGVL_1.DATA_RB_B.R_POS[GVL.DW_[12]] := TO_REAL(GVL.RB_B_.CUR_R);\n// \tEND_CASE\t\n// GVL.RB_B.Comfirm_Teach := FALSE;\n// END_IF","LineInfoPersistence":"(string)7306da8e-4528-4ad1-a813-94db11575c52_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)56"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}