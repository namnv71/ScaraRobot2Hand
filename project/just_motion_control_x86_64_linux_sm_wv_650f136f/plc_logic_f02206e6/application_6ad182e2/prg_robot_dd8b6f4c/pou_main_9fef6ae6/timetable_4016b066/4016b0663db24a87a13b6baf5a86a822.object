{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4016b066-3db2-4a87-a13b-6baf5a86a822","ParentGuid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","Name":"(string)TimeTable","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ================= RUN =================\n\nGVL.TimeMachine.Run_H := TO_WORD(RunTime_s) / 3600;\nGVL.TimeMachine.Run_M  := (TO_WORD(RunTime_s)  MOD 3600) / 60;\nGVL.TimeMachine.Run_S   := TO_WORD(RunTime_s)  MOD 60;\n\n// ================= STOP =================\n\nGVL.TimeMachine.Stop_H  := TO_WORD(StopTime_s)/ 3600;\nGVL.TimeMachine.Stop_M  := (TO_WORD(StopTime_s) MOD 3600) / 60;\nGVL.TimeMachine.Stop_S  := TO_WORD(StopTime_s) MOD 60;\n\n// ================= WAIT =================\n\nGVL.TimeMachine.Wait_H  := TO_WORD(WaitTime_s) / 3600;\nGVL.TimeMachine.Wait_M  := (TO_WORD(WaitTime_s) MOD 3600) / 60;\nGVL.TimeMachine.Wait_S  := TO_WORD(WaitTime_s) MOD 60;\n\n// ================= TOTAL =================\nGVL.TimeMachine.Total_H  := TO_WORD(TotalTime_s)  / 3600;\nGVL.TimeMachine.Total_M  := (TO_WORD(TotalTime_s)  MOD 3600) / 60;\nGVL.TimeMachine.Total_S  := TO_WORD(TotalTime_s)  MOD 60;\n\n// ================= TIMER 1S =================\nT_1s(IN := TRUE, PT := T#1S);\n\nIF T_1s.Q THEN\n    Pulse_1s := TRUE;\n    T_1s(IN := FALSE);\nELSE\n    Pulse_1s := FALSE;\nEND_IF\n\n\n// ================= ĐIỀU KIỆN CỘNG TGIAN =================\nIF Pulse_1s AND NOT GVL.TimeMachine.CLEAR THEN\n    // Tổng thời gian luôn tăng\n    \tTotalTime_s := TotalTime_s + 1;\n\n    IF GVL.TimeMachine.Run THEN\n        RunTime_s := RunTime_s + 1;\n        \n    ELSIF GVL.TimeMachine.Stop THEN\n        StopTime_s := StopTime_s + 1;\n        \n    ELSIF GVL.TimeMachine.Wait THEN\n        WaitTime_s := WaitTime_s + 1;        \n    END_IF\nELSIF GVL.TimeMachine.CLEAR THEN\n\tTotalTime_s \t := 0;\n\tRunTime_s\t\t := 0;\n\tStopTime_s\t\t := 0;\n\tWaitTime_s\t\t := 0;\nEND_IF","LineInfoPersistence":"(string)4016b066-3db2-4a87-a13b-6baf5a86a822_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)54"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}