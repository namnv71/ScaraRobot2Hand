{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)8f0937bb-6841-4b2e-bdb8-7140fe0a8aff","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_CalibRunPoints","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)b38ad2fd-f083-4d1b-92b1-494a3348b7fe"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PointCount := Nb_Point_X * Nb_Point_Y;\n\nt_Delay_Trigger(PT := TO_TIME(T_Delay_Trigger_time) * 100);\n\nRTrig_Enable(CLK := Enable);\n\nIF RTrig_Enable.Q THEN\n    IF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n        GVL.g_aVisionModbusControl[CameraID].RunCalib := FALSE;\n        GVL.g_aVisionModbusControl[CameraID].CalibPosReady := FALSE;\n        GVL.g_aVisionModbusControl[CameraID].CalibPointCount := 0;\n\n        FOR i_vs := 1 TO 12 DO\n            GVL.g_aVisionModbusControl[CameraID].CalibrationPoints[i_vs].X := 0.0;\n            GVL.g_aVisionModbusControl[CameraID].CalibrationPoints[i_vs].Y := 0.0;\n            GVL.g_aVisionModbusControl[CameraID].CalibrationPoints[i_vs].Z := 0.0;\n            GVL.g_aVisionModbusControl[CameraID].CalibrationPoints[i_vs].A := 0.0;\n        END_FOR;\n    END_IF;\nEND_IF;\n \nFTrig_Enable(CLK := Enable);\nIF FTrig_Enable.Q THEN\n\tIF Hand_No = 1 THEN\n\t\tARunP := FALSE;\n\tEND_IF\n\tIF Hand_No = 2 THEN\n\t\tBRunP := FALSE;\n\tEND_IF\n\tTrigger_RB := FALSE;\n\tRun_Calib_Pos_Done := FALSE;\nEND_IF\n\n//================================================\n// Reset / Disable\n//================================================\n\nIF Reset OR NOT Enable THEN\n    State := 0;\n    StartOld := FALSE;\n    Busy := FALSE;\n    DoneAll := FALSE;\n    Error := FALSE;\n    ErrorID := 0;\n    CurrentIndex := 0;\n\n    IF Hand_No = 1 THEN\n        ARunP := FALSE;\n    END_IF;\n\n    IF Hand_No = 2 THEN\n        BRunP := FALSE;\n    END_IF;\n\n    Trigger_RB := FALSE;\n    Run_Calib_Pos_Done := FALSE;\n\n    IF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n        GVL.g_aVisionModbusControl[CameraID].RunCalib := FALSE;\n        GVL.g_aVisionModbusControl[CameraID].CalibPosReady := FALSE;\n    END_IF;\n\n    tTimeout(IN := FALSE);\n    t_Delay_Trigger.IN := FALSE;\n\n    Trigger_Done_Old := FALSE;\n    Calib_Done_Old := FALSE;\n\n    RETURN;\nEND_IF;\n\n\n//================================================\n// Timeout\n//================================================\n// tTimeout(\n//     IN := Busy AND (State <> 0) AND (State <> 100) AND NOT Error,\n//     PT := TimeoutTime\n// );\n// \n// IF tTimeout.Q THEN\n//     Error := TRUE;\n//     ErrorID := 10; // timeout\n//     State := 900;\n// END_IF;\n\n\n//================================================\n// Motion Error\n//================================================\nIF (A_Error AND Hand_No = 1) THEN\n    Error := TRUE;\n    ErrorID := 20; // motion error\n    State := 900;\nEND_IF;\nIF (B_Error AND Hand_No = 2) THEN\n    Error := TRUE;\n    ErrorID := 20; // motion error\n    State := 900;\nEND_IF;\n\n//================================================\n// State machine\n//================================================\nCASE State OF\n\n    0: // IDLE\n\t\tBusy := FALSE;\n\t\tDoneAll := FALSE;\n\t\tError := FALSE;\n\t\tErrorID := 0;\n\t\n\t\tIF Start AND NOT StartOld THEN\n\t\n\t\t\tIF CameraID < 1 OR CameraID > GVL.C_MAX_VISION_CHANNELS THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 3; // CameraID sai\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF PointCount <= 0 THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 1; // PointCount sai\n\t\t\t\tState := 900;\n\t\n\t\t\tELSIF PointCount > 12 THEN\n\t\t\t\tError := TRUE;\n\t\t\t\tErrorID := 2; // Qua 12 diem calib\n\t\t\t\tState := 900;\n\t\n\t\t\tELSE\n\t\t\t\tCurrentIndex := 1;\n\t\t\t\tBusy := TRUE;\n\t\t\t\tDoneAll := FALSE;\n\t\t\t\tRun_Calib_Pos_Done := FALSE;\n\t\n\t\t\t\tIF NOT Run_No_Trigger THEN\n\t\t\t\t\tGVL.g_aVisionModbusControl[CameraID].RunCalib := TRUE;\n\t\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibPosReady := FALSE;\n\t\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibPointCount := INT_TO_UINT(PointCount);\n\t\n\t\t\t\t\tGVL.g_aVisionCommand[CameraID].CameraID := CameraID;\n\t\t\t\t\tGVL.g_aVisionCommand[CameraID].Application := E_VisionApplication.VIS_APP_CALIBRATION;\n\t\t\t\t\tGVL.g_aVisionCommand[CameraID].Execute := FALSE;\n\t\t\t\t\tGVL.g_aVisionCommand[CameraID].Abort := FALSE;\n\t\t\t\t\tGVL.g_aVisionCommand[CameraID].Reset := FALSE;\n\t\t\t\tEND_IF;\n\t\n\t\t\t\tState := 10;\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\n\n    10: // LOAD POINT\n\t\tIF Run_Mode THEN\n\t\t\tTmp_Delta := FC_CalcCalibPoint(Index := CurrentIndex, PointNo1 := PointNo1, NumberPoint_X := Nb_Point_X, NumberPoint_Y := Nb_Point_Y, Delta_X := Delta_X, Delta_Y := Delta_Y, Delta_A := Delta_A); \n\t\t\tIF Hand_No = 1 THEN\n\t\t\t\tCurrentPoint_Run_A.c.X := GVL_1.DATA_RB_A.X_POS[PointNo1] + Tmp_Delta.X;\n\t\t\t\tCurrentPoint_Run_A.c.Y := GVL_1.DATA_RB_A.Y_POS[PointNo1] + Tmp_Delta.Y;\n\t\t\t\tCurrentPoint_Run_A.c.Z := GVL_1.DATA_RB_A.Z_POS[PointNo1] + Tmp_Delta.Z;\n\t\t\t\tCurrentPoint_Run_A.c.A := GVL_1.DATA_RB_A.R_POS[PointNo1] + Tmp_Delta.A;\n\t\t\tEND_IF;\n\t\t\tIF Hand_No = 2 THEN\n\t\t\t\tCurrentPoint_Run_B.c.X := GVL_1.DATA_RB_B.X_POS[PointNo1] + Tmp_Delta.X;\n\t\t\t\tCurrentPoint_Run_B.c.Y := GVL_1.DATA_RB_B.Y_POS[PointNo1] + Tmp_Delta.Y;\n\t\t\t\tCurrentPoint_Run_B.c.Z := GVL_1.DATA_RB_B.Z_POS[PointNo1] + Tmp_Delta.Z;\n\t\t\t\tCurrentPoint_Run_B.c.A := GVL_1.DATA_RB_B.R_POS[PointNo1] + Tmp_Delta.A;\n\t\t\tEND_IF;\n\t\tELSE\n\t\t\tIF Hand_No = 1 THEN\n\t\t\t\tCurrentPoint_Run_A.c.X := GVL_1.DATA_RB_A.X_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_A.c.Y := GVL_1.DATA_RB_A.Y_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_A.c.Z := GVL_1.DATA_RB_A.Z_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_A.c.A := GVL_1.DATA_RB_A.R_POS[PointNo1 + CurrentIndex - 1];\n\t\t\tEND_IF;\n\t\t\tIF Hand_No = 2 THEN\n\t\t\t\tCurrentPoint_Run_B.c.X := GVL_1.DATA_RB_B.X_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_B.c.Y := GVL_1.DATA_RB_B.Y_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_B.c.Z := GVL_1.DATA_RB_B.Z_POS[PointNo1 + CurrentIndex - 1];\n\t\t\t\tCurrentPoint_Run_B.c.A := GVL_1.DATA_RB_B.R_POS[PointNo1 + CurrentIndex - 1];\n\t\t\tEND_IF;\n\t\tEND_IF;\n        State := 20;\n\n\n    20: // SEND MOVE COMMAND\n        //MoveCmd := TRUE; // xung 1 scan yêu cầu motion chạy điểm\n\t\tIF Hand_No = 1 AND NOT ARunP AND NOT A_Comp THEN\n\t\t\tARunP := TRUE;\n\t\tEND_IF;\n\t\t\n\t\tIF Hand_No = 2 AND NOT BRunP AND NOT B_Comp THEN\n\t\t\tBRunP := TRUE;\n\t\tEND_IF;\n\t\t\n        State := 30;\n\n\n    30: // WAIT MOVE DONE + SAVE ACTUAL POSITION\n\n\t\tIF Hand_No = 1 AND A_Comp THEN\n\t\t\tARunP := FALSE;\n\t\t\tA_Comp := FALSE;\n\t\n\t\t\tIF NOT Run_No_Trigger THEN\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].X := TO_REAL(GVL.RB_A_.CUR_X);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].Y := TO_REAL(GVL.RB_A_.CUR_Y);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].Z := TO_REAL(GVL.RB_A_.CUR_Z);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].A := TO_REAL(GVL.RB_A_.CUR_R);\n\t\t\tEND_IF;\n\t\n\t\t\tState := 40;\n\t\tEND_IF;\n\t\n\t\tIF Hand_No = 2 AND B_Comp THEN\n\t\t\tBRunP := FALSE;\n\t\t\tB_Comp := FALSE;\n\t\n\t\t\tIF NOT Run_No_Trigger THEN\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].X := TO_REAL(GVL.RB_B_.CUR_X);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].Y := TO_REAL(GVL.RB_B_.CUR_Y);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].Z := TO_REAL(GVL.RB_B_.CUR_Z);\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibrationPoints[CurrentIndex].A := TO_REAL(GVL.RB_B_.CUR_R);\n\t\t\tEND_IF;\n\t\n\t\t\tState := 40;\n\t\tEND_IF;\n\t\n\t\n\t40: // DELAY BEFORE CAPTURE\n\t\tt_Delay_Trigger.IN := TRUE;\n\t\n\t\tIF t_Delay_Trigger.Q THEN\n\t\t\tt_Delay_Trigger.IN := FALSE;\n\t\n\t\t\tIF Run_No_Trigger THEN\n\t\t\t\tState := 60;\n\t\t\tELSE\n\t\t\t\tState := 45;\n\t\t\tEND_IF;\n\t\tEND_IF;\n\t\n\t\n\t45: // WAIT OLD TRIGGER DONE = FALSE\n\t\tGVL.g_aVisionCommand[CameraID].Execute := FALSE;\n\n\t\tIF NOT GVL.g_aVisionModbusStatus[CameraID].TriggerDone THEN\n\t\t\tState := 50;\n\t\tEND_IF;\n\t\n\t\n\t50: // TRIGGER CURRENT CALIB POINT\n\t\tGVL.g_aVisionCommand[CameraID].CameraID := CameraID;\n\t\tGVL.g_aVisionCommand[CameraID].Application := E_VisionApplication.VIS_APP_CALIBRATION;\n\t\tGVL.g_aVisionCommand[CameraID].Execute := TRUE;\n\t\n\t\tState := 55;\n\t\n\t\n\t55: // WAIT TRIGGER DONE\n    IF GVL.g_aVisionModbusStatus[CameraID].CalibError THEN\n        Error := TRUE;\n        ErrorID := 41;\n        State := 900;\n\n    ELSIF GVL.g_aVisionModbusStatus[CameraID].Error THEN\n        Error := TRUE;\n        ErrorID := 42;\n        State := 900;\n\n    ELSIF GVL.g_aVisionModbusStatus[CameraID].TriggerDone THEN\n        GVL.g_aVisionCommand[CameraID].Execute := FALSE;\n        State := 60;\n    END_IF;\n\t\n\t\n\t58: // WAIT VISION RELEASE TRIGGER DONE\n\t\tIF NOT GVL.g_aVisionModbusStatus[CameraID].TriggerDone THEN\n\t\t\tState := 60;\n\t\tEND_IF;\n\t\n\t\n\t60: // NEXT POINT / ALL POINTS READY\n\t\tt_Delay_Trigger.IN := FALSE;\n\t\n\t\tIF CurrentIndex >= PointCount THEN\n\t\t\tRun_Calib_Pos_Done := TRUE;\n\t\n\t\t\tIF Run_No_Trigger THEN\n\t\t\t\tBusy := FALSE;\n\t\t\t\tDoneAll := TRUE;\n\t\t\t\tState := 100;\n\t\t\tELSE\n\t\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibPosReady := TRUE;\n\t\t\t\tState := 70;\n\t\t\tEND_IF;\n\t\n\t\tELSE\n\t\t\tCurrentIndex := CurrentIndex + 1;\n\t\t\tState := 10;\n\t\tEND_IF;\n\t\n\t\n\t70: // WAIT VISION CALIBRATION CALCULATION DONE\n\t\tIF GVL.g_aVisionModbusStatus[CameraID].CalibError THEN\n\t\t\tError := TRUE;\n\t\t\tErrorID := 43;\n\t\t\tState := 900;\n\t\n\t\tELSIF GVL.g_aVisionModbusStatus[CameraID].Error THEN\n\t\t\tError := TRUE;\n\t\t\tErrorID := 44;\n\t\t\tState := 900;\n\t\n\t\tELSIF GVL.g_aVisionModbusStatus[CameraID].CalibDone THEN\n\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibPosReady := FALSE;\n\t\t\tGVL.g_aVisionModbusControl[CameraID].RunCalib := FALSE;\n\t\n\t\t\tRun_Calib_Pos_Done := FALSE;\n\t\t\tBusy := FALSE;\n\t\t\tDoneAll := TRUE;\n\t\n\t\t\tState := 100;\n\t\tEND_IF;\n\t\n\t\n\t100: // DONE\n\t\tBusy := FALSE;\n\t\n\t\tIF NOT Start THEN\n\t\t\tState := 0;\n\t\tEND_IF;\n\t\n\t900: // ERROR\n\t\tBusy := FALSE;\n\t\n\t\tTrigger_RB := FALSE;\n\t\tRun_Calib_Pos_Done := FALSE;\n\t\n\t\tt_Delay_Trigger.IN := FALSE;\n\t\n\t\tIF CameraID >= 1 AND CameraID <= GVL.C_MAX_VISION_CHANNELS THEN\n\t\t\tGVL.g_aVisionModbusControl[CameraID].RunCalib := FALSE;\n\t\t\tGVL.g_aVisionModbusControl[CameraID].CalibPosReady := FALSE;\n\t\tEND_IF;\n\t\n\t\tIF Hand_No = 1 THEN\n\t\t\tARunP := FALSE;\n\t\tEND_IF;\n\t\n\t\tIF Hand_No = 2 THEN\n\t\t\tBRunP := FALSE;\n\t\tEND_IF;\n\nEND_CASE;\n\n\n//================================================\n// Save old signals for edge detect\n//================================================\nStartOld := Start;\n// Trigger_Done_Old := Triger_RB_Done;\n// Calib_Done_Old := Calib_Done;","LineInfoPersistence":"(string)8f0937bb-6841-4b2e-bdb8-7140fe0a8aff_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_CalibRunPoints\n\nVAR_INPUT\n    Enable : BOOL;\n    Start : BOOL;\n    Reset : BOOL;\n\n    CameraID : UINT; // Camera theo framework Vision moi: 1..GVL.C_MAX_VISION_CHANNELS\n\n    Hand_No : INT;\n    PointNo1 : INT; // So thu tu diem calib dau tien\n\n    Nb_Point_X : INT;\n    Nb_Point_Y : INT;\n\n    Delta_X : INT; // Khoang cach giua cac diem theo phuong X\n    Delta_Y : INT; // Khoang cach giua cac diem theo phuong Y\n    Delta_A : INT; // Khoang cach giua cac diem theo phuong xoay\n\n    A_Error : BOOL;\n    B_Error : BOOL;\n\n    T_Delay_Trigger_time : INT;\n\n    Run_Mode : BOOL; // TRUE = sinh diem theo quy luat, FALSE = chay array diem day san\n    Run_No_Trigger : BOOL; // TRUE = chi chay robot, khong giao tiep Vision\nEND_VAR\n\n\nVAR_IN_OUT\n    CurrentPoint_Run_A : SM3_Robotics.SMC_POS_REF; // Toa do diem chay calib Robot A\n    CurrentPoint_Run_B : SM3_Robotics.SMC_POS_REF; // Toa do diem chay calib Robot B\n\n    ARunP : BOOL; // Lenh PTP Robot A\n    BRunP : BOOL; // Lenh PTP Robot B\n\n    A_Comp : BOOL; // Robot A da den diem muc tieu\n    B_Comp : BOOL; // Robot B da den diem muc tieu\n\n    // Tam thoi GIU de khong vo interface cu.\n    // Sau khi noi framework Vision moi on dinh se bo.\n    Trigger_RB : BOOL;\n    Triger_RB_Done : BOOL;\n    Run_Calib_Pos_Done : BOOL;\n    Calib_Done : BOOL;\nEND_VAR\n\n\nVAR_OUTPUT\n    Busy : BOOL;\n    DoneAll : BOOL;\n    Error : BOOL;\n    ErrorID : INT;\n\n    CurrentIndex : INT;\n    PointCount : INT;\nEND_VAR\n\n\nVAR\n    State : INT;\n    StartOld : BOOL;\n\n    tTimeout : TON;\n    t_Delay_Trigger : TON;\n\n    Tmp_Delta : ST_POS;\n\n    FTrig_Enable : F_TRIG;\n    RTrig_Enable : R_TRIG;\n\n    i_vs : INT;\n\n    Trigger_Done_Old : BOOL;\n    Calib_Done_Old : BOOL;\nEND_VAR","LineInfoPersistence":"(string)8f0937bb-6841-4b2e-bdb8-7140fe0a8aff_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)439","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}