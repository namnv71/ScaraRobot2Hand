{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)5f6e0da7-c10c-4e92-93f9-75a2107d9207","ParentGuid":"(Guid)e057e6d9-ffb9-40c9-822b-a4f66471454d","Name":"(string)Write","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)f8a58466-d7f6-439f-bbb8-d4600e41d099","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"f8a58466","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(* nếu message giống lần trước thì bỏ qua *)\nIF Message = Logs_old THEN\n    RETURN;\nELSIF Message <> Logs_old THEN\n\n//tMs := SysTimeGetMs();\n(* Lấy thời gian thực *)\n//SysTimeRtcGet(pResult := 7,SysTimeRtcGet => dt_ );\n\n(* Quy đổi *)\n// Hour := tMs / 3600000;\n// Minute := (tMs / 60000) MOD 60;\n// Second := (tMs / 1000) MOD 60;\n\nSecond := GVL.DW_[30];\nMinute := GVL.DW_[31];\nHour := GVL.DW_[32];\n\n(* Format hh:mm:ss *)\nTimeStr := '';\n\n(* Hour *)\nIF Hour < 10 THEN\n    TimeStr := CONCAT('0', UDINT_TO_STRING(Hour));\nELSE\n    TimeStr := UDINT_TO_STRING(Hour);\nEND_IF\n\nTimeStr := CONCAT(TimeStr, ':');\n\n(* Minute *)\nIF Minute < 10 THEN\n    TimeStr := CONCAT(TimeStr, CONCAT('0', UDINT_TO_STRING(Minute)));\nELSE\n    TimeStr := CONCAT(TimeStr, UDINT_TO_STRING(Minute));\nEND_IF\n\nTimeStr := CONCAT(TimeStr, ':');\n\n(* Second *)\nIF Second < 10 THEN\n    TimeStr := CONCAT(TimeStr, CONCAT('0', UDINT_TO_STRING(Second)));\nELSE\n    TimeStr := CONCAT(TimeStr, UDINT_TO_STRING(Second));\nEND_IF\n\n(* Ghép chuỗi *)\nTempStr := CONCAT(TimeStr, ' | ');\nTempStr := CONCAT(TempStr, Message);\n\nBuffer[Index] := TempStr;\n\nLogs_old := Message;\n\nIndex := Index + 1;\n\nIF Index > 20 THEN\n    Index := 1;\nEND_IF\nLastMessage := Message;\nEND_IF;","LineInfoPersistence":"(string)5f6e0da7-c10c-4e92-93f9-75a2107d9207_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)METHOD Write\nVAR_INPUT\n    Message : STRING[255];\nEND_VAR\nVAR\n    LastMessage : STRING[255];\n\t dt_          : DWORD;\nEND_VAR\n","LineInfoPersistence":"(string)5f6e0da7-c10c-4e92-93f9-75a2107d9207_Decl_LineIds"}}}}}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","f8a58466":"{f8a58466-d7f6-439f-bbb8-d4600e41d099}","string":"System.String"}}},"FormatVersion":"1.0"}