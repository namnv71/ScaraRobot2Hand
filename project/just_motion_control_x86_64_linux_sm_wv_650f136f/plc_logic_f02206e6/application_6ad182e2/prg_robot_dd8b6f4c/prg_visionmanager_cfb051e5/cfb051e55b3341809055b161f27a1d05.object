{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)cfb051e5-5b33-4180-9055-b161f27a1d05","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_VisionManager","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_VisionManager\n//=============================================================================\n// Chức năng:\n// - Nhận Vision Align Request từ Robot A và Robot B.\n// - Kiểm tra CameraID, Enable và Robot Assignment.\n// - Mỗi Camera chỉ có một Robot sở hữu tại một thời điểm.\n// - Điều khiển FB_VisionAlign riêng của từng Camera.\n// - Trả Done / Error / Result về đúng Robot đã gửi Request.\n//\n// STATE:\n// 0   = IDLE\n// 10  = START VISION ALIGN\n// 20  = WAIT VISION RESULT\n// 30  = DONE - WAIT ROBOT RELEASE\n// 900 = ERROR - WAIT ROBOT RELEASE\n//=============================================================================\n\n\n//=============================================================================\n// 1. RESET REQUEST A SAU KHI ROBOT ĐÃ HẠ EXECUTE\n//-----------------------------------------------------------------------------\n// Phần này chủ yếu xử lý các lỗi xảy ra trước khi Camera được chiếm quyền,\n// ví dụ CameraID sai, Camera Disable hoặc Camera không thuộc Robot A.\n//=============================================================================\nIF NOT GVL.g_stVisionAlignRequestA.Execute\nAND NOT GVL.g_stVisionAlignRequestA.Busy\nAND GVL.g_stVisionAlignRequestA.Error THEN\n    GVL.g_stVisionAlignRequestA.Error := FALSE;\n    GVL.g_stVisionAlignRequestA.ErrorID := 0;\n    GVL.g_stVisionAlignRequestA.Done := FALSE;\n    GVL.g_stVisionAlignRequestA.ResultOK := FALSE;\n    GVL.g_stVisionAlignRequestA.ResultValid := FALSE;\nEND_IF;\n\n\n//=============================================================================\n// 2. RESET REQUEST B SAU KHI ROBOT ĐÃ HẠ EXECUTE\n//=============================================================================\nIF NOT GVL.g_stVisionAlignRequestB.Execute\nAND NOT GVL.g_stVisionAlignRequestB.Busy\nAND GVL.g_stVisionAlignRequestB.Error THEN\n    GVL.g_stVisionAlignRequestB.Error := FALSE;\n    GVL.g_stVisionAlignRequestB.ErrorID := 0;\n    GVL.g_stVisionAlignRequestB.Done := FALSE;\n    GVL.g_stVisionAlignRequestB.ResultOK := FALSE;\n    GVL.g_stVisionAlignRequestB.ResultValid := FALSE;\nEND_IF;\n\n\n//=============================================================================\n// 3. NHẬN REQUEST TỪ ROBOT A\n//=============================================================================\nIF GVL.g_stVisionAlignRequestA.Execute\nAND NOT GVL.g_stVisionAlignRequestA.Busy\nAND NOT GVL.g_stVisionAlignRequestA.Done\nAND NOT GVL.g_stVisionAlignRequestA.Error THEN\n\n    //-------------------------------------------------------------------------\n    // Kiểm tra CameraID trước khi dùng CameraID làm Array Index.\n    //-------------------------------------------------------------------------\n    IF (GVL.g_stVisionAlignRequestA.CameraID < 1)\n    OR (GVL.g_stVisionAlignRequestA.CameraID > GVL.C_MAX_VISION_CHANNELS) THEN\n        GVL.g_stVisionAlignRequestA.Error := TRUE;\n        GVL.g_stVisionAlignRequestA.ErrorID := 1;\n\n    ELSE\n        uiCamera := GVL.g_stVisionAlignRequestA.CameraID;\n\n        //-------------------------------------------------------------------------\n        // Camera phải được Enable.\n        //-------------------------------------------------------------------------\n        IF NOT GVL.g_aVisionConfig[uiCamera].Enable THEN\n            GVL.g_stVisionAlignRequestA.Error := TRUE;\n            GVL.g_stVisionAlignRequestA.ErrorID := 2;\n\n        //-------------------------------------------------------------------------\n        // Camera phải được cấu hình thuộc Robot A.\n        //-------------------------------------------------------------------------\n        ELSIF GVL.g_aVisionConfig[uiCamera].Robot <> E_VisionRobot.VIS_ROBOT_A THEN\n            GVL.g_stVisionAlignRequestA.Error := TRUE;\n            GVL.g_stVisionAlignRequestA.ErrorID := 3;\n\n        //-------------------------------------------------------------------------\n        // Camera phải đang rảnh.\n        //-------------------------------------------------------------------------\n        ELSIF eRequester[uiCamera] <> E_VisionRobot.VIS_ROBOT_NONE THEN\n            GVL.g_stVisionAlignRequestA.Error := TRUE;\n            GVL.g_stVisionAlignRequestA.ErrorID := 4;\n\n        ELSE\n            // Latch JobID để dữ liệu Request thay đổi bên ngoài không ảnh hưởng\n            // transaction đang chạy.\n            uiJobID[uiCamera] := GVL.g_stVisionAlignRequestA.JobID;\n\n            // Robot A chiếm quyền Camera.\n            eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_A;\n\n            // Xóa status/result cũ trước transaction mới.\n            GVL.g_stVisionAlignRequestA.Busy := TRUE;\n            GVL.g_stVisionAlignRequestA.Done := FALSE;\n            GVL.g_stVisionAlignRequestA.Error := FALSE;\n            GVL.g_stVisionAlignRequestA.ErrorID := 0;\n            GVL.g_stVisionAlignRequestA.ResultOK := FALSE;\n            GVL.g_stVisionAlignRequestA.ResultValid := FALSE;\n            GVL.g_stVisionAlignRequestA.TriggerID := 0;\n            GVL.g_stVisionAlignRequestA.X := 0.0;\n            GVL.g_stVisionAlignRequestA.Y := 0.0;\n            GVL.g_stVisionAlignRequestA.Z := 0.0;\n            GVL.g_stVisionAlignRequestA.A := 0.0;\n            GVL.g_stVisionAlignRequestA.Score := 0.0;\n            GVL.g_stVisionAlignRequestA.FeatureID := 0;\n\n            // Bắt đầu transaction của Camera này.\n            iState[uiCamera] := 10;\n        END_IF;\n    END_IF;\nEND_IF;\n\n\n//=============================================================================\n// 4. NHẬN REQUEST TỪ ROBOT B\n//=============================================================================\nIF GVL.g_stVisionAlignRequestB.Execute\nAND NOT GVL.g_stVisionAlignRequestB.Busy\nAND NOT GVL.g_stVisionAlignRequestB.Done\nAND NOT GVL.g_stVisionAlignRequestB.Error THEN\n\n    //-------------------------------------------------------------------------\n    // Kiểm tra CameraID trước khi dùng làm Array Index.\n    //-------------------------------------------------------------------------\n    IF (GVL.g_stVisionAlignRequestB.CameraID < 1)\n    OR (GVL.g_stVisionAlignRequestB.CameraID > GVL.C_MAX_VISION_CHANNELS) THEN\n        GVL.g_stVisionAlignRequestB.Error := TRUE;\n        GVL.g_stVisionAlignRequestB.ErrorID := 1;\n\n    ELSE\n        uiCamera := GVL.g_stVisionAlignRequestB.CameraID;\n\n        //-------------------------------------------------------------------------\n        // Camera phải được Enable.\n        //-------------------------------------------------------------------------\n        IF NOT GVL.g_aVisionConfig[uiCamera].Enable THEN\n            GVL.g_stVisionAlignRequestB.Error := TRUE;\n            GVL.g_stVisionAlignRequestB.ErrorID := 2;\n\n        //-------------------------------------------------------------------------\n        // Camera phải được cấu hình thuộc Robot B.\n        //-------------------------------------------------------------------------\n        ELSIF GVL.g_aVisionConfig[uiCamera].Robot <> E_VisionRobot.VIS_ROBOT_B THEN\n            GVL.g_stVisionAlignRequestB.Error := TRUE;\n            GVL.g_stVisionAlignRequestB.ErrorID := 3;\n\n        //-------------------------------------------------------------------------\n        // Camera phải đang rảnh.\n        //-------------------------------------------------------------------------\n        ELSIF eRequester[uiCamera] <> E_VisionRobot.VIS_ROBOT_NONE THEN\n            GVL.g_stVisionAlignRequestB.Error := TRUE;\n            GVL.g_stVisionAlignRequestB.ErrorID := 4;\n\n        ELSE\n            // Latch JobID.\n            uiJobID[uiCamera] := GVL.g_stVisionAlignRequestB.JobID;\n\n            // Robot B chiếm quyền Camera.\n            eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_B;\n\n            // Xóa status/result cũ.\n            GVL.g_stVisionAlignRequestB.Busy := TRUE;\n            GVL.g_stVisionAlignRequestB.Done := FALSE;\n            GVL.g_stVisionAlignRequestB.Error := FALSE;\n            GVL.g_stVisionAlignRequestB.ErrorID := 0;\n            GVL.g_stVisionAlignRequestB.ResultOK := FALSE;\n            GVL.g_stVisionAlignRequestB.ResultValid := FALSE;\n            GVL.g_stVisionAlignRequestB.TriggerID := 0;\n            GVL.g_stVisionAlignRequestB.X := 0.0;\n            GVL.g_stVisionAlignRequestB.Y := 0.0;\n            GVL.g_stVisionAlignRequestB.Z := 0.0;\n            GVL.g_stVisionAlignRequestB.A := 0.0;\n            GVL.g_stVisionAlignRequestB.Score := 0.0;\n            GVL.g_stVisionAlignRequestB.FeatureID := 0;\n\n            // Bắt đầu transaction.\n            iState[uiCamera] := 10;\n        END_IF;\n    END_IF;\nEND_IF;\n\n\n//=============================================================================\n// 5. XỬ LÝ STATE CỦA TỪNG CAMERA\n//=============================================================================\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    CASE iState[uiCamera] OF\n\n        //=====================================================================\n        // STATE 0 - IDLE\n        //=====================================================================\n        0:\n            xStartAlign[uiCamera] := FALSE;\n\n        //=====================================================================\n        // STATE 10 - START VISION ALIGN\n        //-------------------------------------------------------------------------\n        // Start được giữ TRUE trong suốt transaction.\n        // FB_VisionAlign tự xử lý Trigger -> Wait Result -> Done/Error.\n        //=====================================================================\n        10:\n            xStartAlign[uiCamera] := TRUE;\n            iState[uiCamera] := 20;\n\n        //=====================================================================\n        // STATE 20 - WAIT RESULT\n        //-------------------------------------------------------------------------\n        // Không xử lý output tại đây.\n        // FB được gọi ở phần 6.\n        // Output FB được đọc ở phần 7 sau khi FB đã được scan.\n        //=====================================================================\n        20:\n            ;\n\n        //=====================================================================\n        // STATE 30 - DONE / WAIT ROBOT RELEASE\n        //=====================================================================\n        30:\n            xStartAlign[uiCamera] := FALSE;\n\n            CASE eRequester[uiCamera] OF\n\n                // Robot A đã nhận Done và hạ Execute.\n                E_VisionRobot.VIS_ROBOT_A:\n                    IF NOT GVL.g_stVisionAlignRequestA.Execute THEN\n                        GVL.g_stVisionAlignRequestA.Busy := FALSE;\n                        GVL.g_stVisionAlignRequestA.Done := FALSE;\n                        GVL.g_stVisionAlignRequestA.Error := FALSE;\n                        GVL.g_stVisionAlignRequestA.ErrorID := 0;\n\n                        eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                        uiJobID[uiCamera] := 0;\n                        iState[uiCamera] := 0;\n                    END_IF;\n\n                // Robot B đã nhận Done và hạ Execute.\n                E_VisionRobot.VIS_ROBOT_B:\n                    IF NOT GVL.g_stVisionAlignRequestB.Execute THEN\n                        GVL.g_stVisionAlignRequestB.Busy := FALSE;\n                        GVL.g_stVisionAlignRequestB.Done := FALSE;\n                        GVL.g_stVisionAlignRequestB.Error := FALSE;\n                        GVL.g_stVisionAlignRequestB.ErrorID := 0;\n\n                        eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                        uiJobID[uiCamera] := 0;\n                        iState[uiCamera] := 0;\n                    END_IF;\n\n                ELSE\n                    // Safety fallback: Camera không có owner hợp lệ.\n                    xStartAlign[uiCamera] := FALSE;\n                    eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                    uiJobID[uiCamera] := 0;\n                    iState[uiCamera] := 0;\n            END_CASE;\n\n        //=====================================================================\n        // STATE 900 - ERROR / WAIT ROBOT RELEASE\n        //=====================================================================\n        900:\n            xStartAlign[uiCamera] := FALSE;\n\n            CASE eRequester[uiCamera] OF\n\n                // Robot A xác nhận Error bằng cách hạ Execute.\n                E_VisionRobot.VIS_ROBOT_A:\n                    IF NOT GVL.g_stVisionAlignRequestA.Execute THEN\n                        GVL.g_stVisionAlignRequestA.Busy := FALSE;\n                        GVL.g_stVisionAlignRequestA.Done := FALSE;\n                        GVL.g_stVisionAlignRequestA.Error := FALSE;\n                        GVL.g_stVisionAlignRequestA.ErrorID := 0;\n\n                        eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                        uiJobID[uiCamera] := 0;\n                        iState[uiCamera] := 0;\n                    END_IF;\n\n                // Robot B xác nhận Error bằng cách hạ Execute.\n                E_VisionRobot.VIS_ROBOT_B:\n                    IF NOT GVL.g_stVisionAlignRequestB.Execute THEN\n                        GVL.g_stVisionAlignRequestB.Busy := FALSE;\n                        GVL.g_stVisionAlignRequestB.Done := FALSE;\n                        GVL.g_stVisionAlignRequestB.Error := FALSE;\n                        GVL.g_stVisionAlignRequestB.ErrorID := 0;\n\n                        eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                        uiJobID[uiCamera] := 0;\n                        iState[uiCamera] := 0;\n                    END_IF;\n\n                ELSE\n                    // Safety fallback.\n                    xStartAlign[uiCamera] := FALSE;\n                    eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n                    uiJobID[uiCamera] := 0;\n                    iState[uiCamera] := 0;\n            END_CASE;\n\n        //=====================================================================\n        // INVALID STATE\n        //=====================================================================\n        ELSE\n            xStartAlign[uiCamera] := FALSE;\n            eRequester[uiCamera] := E_VisionRobot.VIS_ROBOT_NONE;\n            uiJobID[uiCamera] := 0;\n            iState[uiCamera] := 0;\n\n    END_CASE;\n\nEND_FOR;\n\n\n//=============================================================================\n// 6. GỌI FB_VISIONALIGN CHO TẤT CẢ CAMERA\n//-----------------------------------------------------------------------------\n// BẮT BUỘC gọi mỗi instance ở mọi PLC scan.\n//=============================================================================\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    fbVisionAlign[uiCamera](\n        Enable := GVL.g_aVisionConfig[uiCamera].Enable,\n        Start := xStartAlign[uiCamera],\n        CameraID := uiCamera,\n        JobID := uiJobID[uiCamera]\n    );\n\nEND_FOR;\n\n\n//=============================================================================\n// 7. ĐỌC OUTPUT FB SAU KHI FB ĐÃ ĐƯỢC SCAN\n//=============================================================================\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\n    IF iState[uiCamera] = 20 THEN\n\n        //=====================================================================\n        // TRANSACTION DONE\n        //=====================================================================\n        IF fbVisionAlign[uiCamera].Done THEN\n\n            CASE eRequester[uiCamera] OF\n\n                //-------------------------------------------------------------\n                // RESULT -> ROBOT A\n                //-------------------------------------------------------------\n                E_VisionRobot.VIS_ROBOT_A:\n                    GVL.g_stVisionAlignRequestA.TriggerID := fbVisionAlign[uiCamera].TriggerID;\n                    GVL.g_stVisionAlignRequestA.X := fbVisionAlign[uiCamera].VisionX;\n                    GVL.g_stVisionAlignRequestA.Y := fbVisionAlign[uiCamera].VisionY;\n                    GVL.g_stVisionAlignRequestA.Z := fbVisionAlign[uiCamera].VisionZ;\n                    GVL.g_stVisionAlignRequestA.A := fbVisionAlign[uiCamera].VisionA;\n                    GVL.g_stVisionAlignRequestA.Score := fbVisionAlign[uiCamera].VisionScore;\n                    GVL.g_stVisionAlignRequestA.FeatureID := fbVisionAlign[uiCamera].VisionFeatureID;\n                    GVL.g_stVisionAlignRequestA.ResultValid := fbVisionAlign[uiCamera].ResultValid;\n                    GVL.g_stVisionAlignRequestA.ResultStatus := fbVisionAlign[uiCamera].ResultStatus;\n\n                    // Business result:\n                    // OK -> TRUE.\n                    // NG/NOT_FOUND/... -> FALSE nhưng transaction vẫn Done.\n                    GVL.g_stVisionAlignRequestA.ResultOK :=\n                        fbVisionAlign[uiCamera].ResultStatus = E_VisionResultStatus.VIS_RESULT_OK;\n\n                    GVL.g_stVisionAlignRequestA.Busy := FALSE;\n                    GVL.g_stVisionAlignRequestA.Error := FALSE;\n                    GVL.g_stVisionAlignRequestA.ErrorID := 0;\n                    GVL.g_stVisionAlignRequestA.Done := TRUE;\n\n                //-------------------------------------------------------------\n                // RESULT -> ROBOT B\n                //-------------------------------------------------------------\n                E_VisionRobot.VIS_ROBOT_B:\n                    GVL.g_stVisionAlignRequestB.TriggerID := fbVisionAlign[uiCamera].TriggerID;\n                    GVL.g_stVisionAlignRequestB.X := fbVisionAlign[uiCamera].VisionX;\n                    GVL.g_stVisionAlignRequestB.Y := fbVisionAlign[uiCamera].VisionY;\n                    GVL.g_stVisionAlignRequestB.Z := fbVisionAlign[uiCamera].VisionZ;\n                    GVL.g_stVisionAlignRequestB.A := fbVisionAlign[uiCamera].VisionA;\n                    GVL.g_stVisionAlignRequestB.Score := fbVisionAlign[uiCamera].VisionScore;\n                    GVL.g_stVisionAlignRequestB.FeatureID := fbVisionAlign[uiCamera].VisionFeatureID;\n                    GVL.g_stVisionAlignRequestB.ResultValid := fbVisionAlign[uiCamera].ResultValid;\n                    GVL.g_stVisionAlignRequestB.ResultStatus := fbVisionAlign[uiCamera].ResultStatus;\n\n                    GVL.g_stVisionAlignRequestB.ResultOK :=\n                        fbVisionAlign[uiCamera].ResultStatus = E_VisionResultStatus.VIS_RESULT_OK;\n\n                    GVL.g_stVisionAlignRequestB.Busy := FALSE;\n                    GVL.g_stVisionAlignRequestB.Error := FALSE;\n                    GVL.g_stVisionAlignRequestB.ErrorID := 0;\n                    GVL.g_stVisionAlignRequestB.Done := TRUE;\n\n            END_CASE;\n\n            // Hạ Start để FB_VisionAlign thoát State Done sau handshake.\n            xStartAlign[uiCamera] := FALSE;\n\n            // Giữ Camera cho requester cho tới khi requester hạ Execute.\n            iState[uiCamera] := 30;\n\n\n        //=====================================================================\n        // TRANSACTION ERROR\n        //=====================================================================\n        ELSIF fbVisionAlign[uiCamera].Error THEN\n\n            CASE eRequester[uiCamera] OF\n\n                //-------------------------------------------------------------\n                // ERROR -> ROBOT A\n                //-------------------------------------------------------------\n                E_VisionRobot.VIS_ROBOT_A:\n                    GVL.g_stVisionAlignRequestA.Busy := FALSE;\n                    GVL.g_stVisionAlignRequestA.Done := FALSE;\n                    GVL.g_stVisionAlignRequestA.ResultOK := FALSE;\n                    GVL.g_stVisionAlignRequestA.ResultValid := FALSE;\n                    GVL.g_stVisionAlignRequestA.Error := TRUE;\n\n                    // 100 + ErrorID để phân biệt lỗi Manager và lỗi FB.\n                    GVL.g_stVisionAlignRequestA.ErrorID :=\n                        100 + fbVisionAlign[uiCamera].ErrorID;\n\n                //-------------------------------------------------------------\n                // ERROR -> ROBOT B\n                //-------------------------------------------------------------\n                E_VisionRobot.VIS_ROBOT_B:\n                    GVL.g_stVisionAlignRequestB.Busy := FALSE;\n                    GVL.g_stVisionAlignRequestB.Done := FALSE;\n                    GVL.g_stVisionAlignRequestB.ResultOK := FALSE;\n                    GVL.g_stVisionAlignRequestB.ResultValid := FALSE;\n                    GVL.g_stVisionAlignRequestB.Error := TRUE;\n\n                    GVL.g_stVisionAlignRequestB.ErrorID :=\n                        100 + fbVisionAlign[uiCamera].ErrorID;\n\n            END_CASE;\n\n            // Hạ Start để FB bắt đầu reset Error.\n            xStartAlign[uiCamera] := FALSE;\n\n            // Camera chỉ được giải phóng sau khi Robot hạ Execute.\n            iState[uiCamera] := 900;\n\n        END_IF;\n\n    END_IF;\n\nEND_FOR;\n\n// Monitor ControlWord and Status Wword\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\twControl_Tmp := GVL.MODBUS[0 + (uiCamera-1)*300];\n \twStatus_Tmp := GVL.MODBUS[100 + (uiCamera-1)*300];\n\tGVL.g_aVision_ControlWord[uiCamera].HeartBeat := wControl_Tmp.0;\n\tGVL.g_aVision_ControlWord[uiCamera].TriggerCam := wControl_Tmp.1;\n\tGVL.g_aVision_ControlWord[uiCamera].RunCalib := wControl_Tmp.2;\n\tGVL.g_aVision_ControlWord[uiCamera].CalibPosReady := wControl_Tmp.3;\n\tGVL.g_aVision_ControlWord[uiCamera].AckResult := wControl_Tmp.4;\n\tGVL.g_aVision_ControlWord[uiCamera].AckBlock := wControl_Tmp.5;\n\tGVL.g_aVision_ControlWord[uiCamera].ResetVision := wControl_Tmp.6;\n\tGVL.g_aVision_ControlWord[uiCamera].AbortVision := wControl_Tmp.7;\n\t\n\tGVL.g_aVision_StatusWord[uiCamera].HeartBeat := wStatus_Tmp.0;\n\tGVL.g_aVision_StatusWord[uiCamera].TriggerDone := wStatus_Tmp.1;\n\tGVL.g_aVision_StatusWord[uiCamera].CalibDone := wStatus_Tmp.2;\n\tGVL.g_aVision_StatusWord[uiCamera].ResultReady := wStatus_Tmp.3;\n\tGVL.g_aVision_StatusWord[uiCamera].Busy := wStatus_Tmp.4;\n\tGVL.g_aVision_StatusWord[uiCamera].Run1Slot := wStatus_Tmp.5;\n\tGVL.g_aVision_StatusWord[uiCamera].BlockReady := wStatus_Tmp.6;\n\tGVL.g_aVision_StatusWord[uiCamera].Error := wStatus_Tmp.7;\n\tGVL.g_aVision_StatusWord[uiCamera].CalibBusy := wStatus_Tmp.8;\n\tGVL.g_aVision_StatusWord[uiCamera].CalibError := wStatus_Tmp.9;\n\t\nEND_FOR;","LineInfoPersistence":"(string)cfb051e5-5b33-4180-9055-b161f27a1d05_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_VisionManager\nVAR\n    //=========================================================================\n    // VISION ALIGN FUNCTION BLOCKS\n    //-------------------------------------------------------------------------\n    // Mỗi Camera có một instance FB_VisionAlign riêng.\n    // Vì FB có State/Timer/TriggerID nội bộ nên tuyệt đối không dùng chung\n    // một instance cho nhiều Camera.\n    //=========================================================================\n    fbVisionAlign : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF FB_VisionAlign;\n\n    //=========================================================================\n    // CAMERA RUNTIME\n    // Mỗi phần tử Array tương ứng với một Camera.\n    //=========================================================================\n    xStartAlign : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF BOOL;             // Start của FB_VisionAlign từng Camera.\n    uiJobID : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF UINT;                 // JobID đã latch khi nhận Request.\n    eRequester : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF E_VisionRobot;     // Robot đang sở hữu Camera.\n    iState : ARRAY[1..GVL.C_MAX_VISION_CHANNELS] OF INT;                   // State transaction riêng từng Camera.\n\n    //=========================================================================\n    // LOOP VARIABLE\n    //=========================================================================\n    uiCamera : UINT;                                                        // Camera index dùng trong vòng FOR.\n\twControl_Tmp : WORD;\n    wStatus_Tmp : WORD;\nEND_VAR","LineInfoPersistence":"(string)cfb051e5-5b33-4180-9055-b161f27a1d05_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)507","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}