RB_B.Y_POS[GVL.DW_[12]];\n\t\t\t\t\t\t\tPos_run_manual_B.c.Z:= GVL_1.DATA_RB_B.Z_POS[GVL.DW_[12]];\n\t\t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[GVL.DW_[12]];\n\t\t\t\t\t\t\tGVL.RB_B.Comfirm_Move := FALSE;\t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\tEND_IF;\t\t\n\tOther_PosB := Pos_run_manual_B.c.X <> Pos_Run_B_Pre.c.X OR Pos_run_manual_B.c.Y <> Pos_Run_B_Pre.c.Y \n\t\t\t\t  OR Pos_run_manual_B.c.Z <> Pos_Run_B_Pre.c.Z OR Pos_run_manual_B.c.A <> Pos_Run_B_Pre.c.A;\t  \t\t\t\t\t\t\t\t\t\t\t \n\tExcute_Run_goPos_B_UpZ := GVL.RB_B.Manual AND GVL.RB_B.Comfirm_Up_Z AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[12] > 0 AND GVL.DW_[13] > 0;\n\tExcute_Run_goPos_B_UpZ_XY_BF_R := GVL.RB_B.Manual AND GVL.RB_B.Comfirm_Up_Z_XY_BF_R AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[12] > 0 AND GVL.DW_[13] > 0;\n\tExcute_Run_goPos_B_UpZ_R_BF_XY := GVL.RB_B.Manual AND GVL.RB_B.Comfirm_Up_Z_R_BF_XY AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND\n\t\t\t\t\t\t\tGVL.DW_[12] > 0 AND GVL.DW_[13] > 0;\n\t\t\t\t\t\tIF Excute_Run_goPos_B_UpZ AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\tRuningPosB[GVL.DW_[12]] := TRUE;\n\t\t\t\t\t\t\tmode_Run_GoPosB_manual := 1;\t\n\t\t\t\t\t\t\tPos_Run_B_Pre := Pos_0;\t\n\t\t\t\t\t\t\tGVL.RB_B.Comfirm_Up_Z := FALSE;\n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tIF Excute_Run_goPos_B_UpZ_XY_BF_R AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tRuningPosB[GVL.DW_[12]] := TRUE;\n\t\t\t\t\t\t\t\tmode_Run_GoPosB_manual := 2;\t\n\t\t\t\t\t\t\t\tPos_Run_B_Pre := Pos_0;\t\n\t\t\t\t\t\t\t\tGVL.RB_B.Comfirm_Up_Z_XY_BF_R := FALSE;\t \n\t\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\t\tIF Excute_Run_goPos_B_UpZ_R_BF_XY AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n\t\t\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\tRuningPosB[GVL.DW_[12]] := TRUE;\n\t\t\t\t\t\t\t\t\tmode_Run_GoPosB_manual := 3;\t\n\t\t\t\t\t\t\t\t\tPos_Run_B_Pre := Pos_0;\t\n\t\t\t\t\t\t\t\t\tGVL.RB_B.Comfirm_Up_Z_R_BF_XY := FALSE;\n\t\t\t\t\t\t\t\t END_IF;\n\t\t\t\t\t\t\tEND_IF;\n\t\t\t\t\t\tEND_IF;\t\t\t\t\t\t\t \nIF RuningPosB[GVL.DW_[12]] THEN\n\tCASE PRO_B[GVL.DW_[12]] OF\n\t\t\t0: \n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t10:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t20:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\t\tCASE GVL.DW_[13] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_B := TRUE; \n\t\t\t\t\t\t3:  excute_run_P_Upz_B := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\tRuningPosB[GVL.DW_[12]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_B.Done OR MOVP_B.Done THEN\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t\t\tIF mode_Run_GoPosB_manual = 1 THEN\n\t\t\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t\t\tELSE\n\t\t\t\t\t\tIF mode_Run_GoPosB_manual = 2 THEN\n\t\t\t\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 2;\n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tIF mode_Run_GoPosB_manual = 3 THEN\n\t\t\t\t\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 6;\t \n\t\t\t\t\t\t\tEND_IF;\n\t\t\t\t\t\tEND_IF;\n\t\t\t\t\tEND_IF;\n\t\t\t    END_IF\n\t\t\t22:\n\t\t\t\tPos_run_manual_B.c.X :=  GVL_1.DATA_RB_B.X_POS[GVL.DW_[12]];\n\t\t\t\tPos_run_manual_B.c.Y :=  GVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]];\t\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL.RB_B_.CUR_Z;\t\t\t\t\t \n\t\t\t\tPos_run_manual_B.c.A :=  GVL.RB_B_.CUR_R;\t\t  \n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 2;  \n\t\t\t24:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\t\tCASE GVL.DW_[13] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_B := TRUE; \n\t\t\t\t\t\t3:  excute_run_P_Upz_B := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_B_.ERROR OR NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\tRuningPosB[GVL.DW_[12]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_B.Done OR MOVP_B.Done THEN\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t\t\tPRO_B[GVL.DW_[12]] := 30;\n\t\t\t    END_IF\n\t\t\t26:\n\t\t\t\tPos_run_manual_B.c.X :=  GVL.RB_B_.CUR_X;\n\t\t\t\tPos_run_manual_B.c.Y :=  GVL.RB_B_.CUR_Y;\t\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL.RB_B_.CUR_Z;\t\t\t\t\t \n\t\t\t\tPos_run_manual_B.c.A :=  GVL_1.DATA_RB_B.r_POS[GVL.DW_[12]];\t\t  \n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 2;\n\t\t\t28:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\t\tCASE GVL.DW_[13] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_B := TRUE; \n\t\t\t\t\t\t3:  excute_run_P_Upz_B := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_B_.ERROR OR NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\tRuningPosB[GVL.DW_[12]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_B.Done OR MOVP_B.Done THEN\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t\t\tPRO_B[GVL.DW_[12]] := 30;\n\t\t\t    END_IF \n\t\t\t30:\n\t\t\t\tPos_run_manual_B.c.X :=  GVL_1.DATA_RB_B.X_POS[GVL.DW_[12]];\n\t\t\t\tPos_run_manual_B.c.Y :=  GVL_1.DATA_RB_B.Y_POS[GVL.DW_[12]];\t\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL.RB_B_.CUR_Z;\t\t\t\t\t \n\t\t\t\tPos_run_manual_B.c.A :=  GVL_1.DATA_RB_B.r_POS[GVL.DW_[12]];\t\t  \n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10; \n\t\t\t40:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\t\tCASE GVL.DW_[13] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_B := TRUE; \n\t\t\t\t\t\t3:  excute_run_P_Upz_B := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_B_.ERROR OR NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\tRuningPosB[GVL.DW_[12]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_B.Done OR MOVP_B.Done THEN\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t    END_IF\n\t\t\t50:\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\t\t\t \n\t\t\t60:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[GVL.DW_[12]];\n\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t70:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\t\tCASE GVL.DW_[13] OF\n\t\t\t\t\t\t1: \texcute_run_L_Upz_B := TRUE; \n\t\t\t\t\t\t3:  excute_run_P_Upz_B := TRUE;\n\t\t\t\t\tEND_CASE\n\t\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_b_.Ready THEN\n\t\t\t\t\tRuningPosB[GVL.DW_[12]] := FALSE;\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVL_B.Done OR MOVP_B.Done THEN\n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n\t\t\t\t\tPRO_B[GVL.DW_[12]] := PRO_B[GVL.DW_[12]] + 10;\n\t\t\t    END_IF\t\n\t\t\t80:/// HOÀN THÀNH ///  \t   \n\t\t\t\t\texcute_run_L_Upz_B := FALSE; \n\t\t\t\t\texcute_run_P_Upz_B := FALSE;\n \t\t\t        RuningPosB[GVL.DW_[12]] := FALSE;\t\t\t\n\t\t\t\t\tmode_Run_GoPosB_manual := 0;\t \n\t\t END_CASE\nELSE\n\tPRO_B[GVL.DW_[12]] := 0;\t\n\texcute_run_L_Upz_b := FALSE; \n\texcute_run_P_Upz_b := FALSE;\t\t\n\tmode_Run_GoPosB_manual := 0;\t \nEND_IF;\t\t\t\t\t\t\t\t\t\t   \n{endregion}\t\n\t \n{region \"4. Pos Cam\"}\t \n// excute_run_cam_B := GVL.RB_B.Manual AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND GVL.RB_B.move_Pos_cam ;\n// \t \t\t\t\t\t \n// \t\t\t\t\t\tIF GVL.RB_B.move_Pos_cam AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 31 THEN\n// \t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\n// \t\t\t\t\t\t\tPos_run_manual_B := POU_MONITOR_ROBOT.RB1_POS;\n// \t\t\t\t\t\t\tPos_run_manual_B.c.X := GVL_1.DATA_RB_B.X_POS[1];\n// \t\t\t\t\t\t\tPos_run_manual_B.c.Y := GVL_1.DATA_RB_B.Y_POS[1];\n// \t\t\t\t\t\tEND_IF;\t\t  \n// ROBOT B\n\texcute_run_cam_B := GVL.RB_B.Manual AND GVL.RB_B_.Ready AND NOT GVL.RB_B_.Runing AND GVL.RB_B.move_Pos_cam ;\t\n\t  \t\t\t\t\t\t\t\t\t\t\t \n\t\t\t\t\t\tIF excute_run_cam_B AND POU_HMI_CONTROL_ROBOT.D_HMI_SCREEN = 181 THEN\n\t\t\t\t\t\t\tGVL.RB_B.COORD := 1;\t\t\t\t\t\t\n\t\t\t\t\t\t\tRunning_B_Cam := TRUE;\t\n\t\t\t\t\t\t\tPos_Run_B_Pre := Pos_0;\t\n\t\t\t\t\t\t\texcute_run_cam_B := FALSE;\t \n\t\t\t\t\t\tEND_IF;\t\t\t\t\t\t\t \nIF Running_B_Cam THEN\n\tCASE Pro_B_cam OF\n\t\t\t0: \n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t10:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t20:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\texcute_run_P_cam_B := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t    Running_B_Cam := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t    END_IF\n\t\t\t30:\n\t\t\t\tCASE GVL.DW_[20] OF\n\t\t\t\t\t0:\n\t\t\t\t\t\tPos_run_manual_B.c.X :=  GVL.Cam_T1.POS_X_RESULT;\n\t\t\t\t\t\tPos_run_manual_B.c.Y :=  GVL.Cam_T1.POS_Y_RESULT;\t  \t\t\t\t\t \n\t\t\t\t\t1:\t \n\t\t\t\t\t\tPos_run_manual_B.c.X :=  GVL.Cam_T2.POS_X_RESULT;\n\t\t\t\t\t\tPos_run_manual_B.c.Y :=  GVL.Cam_T2.POS_Y_RESULT;\t \n\t\t\t\tEND_CASE\t\t  \n\t\t\t\t\t\tPos_run_manual_B.c.Z :=  GVL.RB_B_.CUR_Z;\t\t\t\t\t \n\t\t\t\t\t\tPos_run_manual_B.c.A :=  GVL_1.DATA_RB_B.r_POS[1];\t\t\t\t\t   \n\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t40:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\texcute_run_P_cam_B := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t    Running_B_Cam := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t    END_IF\t\t\t \n\t\t\t50:\n\t\t\t\tGVL.RB_B.COORD := 1;\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tPro_B_cam := Pro_B_cam + 10;\t\t \n\t\t\t60:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t70:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\texcute_run_P_cam_B := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t    Running_B_Cam := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\texcute_run_P_cam_B := FALSE;\n\t\t\t\t\tPro_B_cam := Pro_B_cam + 10;\n\t\t\t    END_IF\n\t\t\t80:/// HOÀN THÀNH ///  \t   \n\t\t\t\t\texcute_run_P_cam_B:= FALSE; \n \t\t\t        Running_B_Cam := FALSE;\t\t\t\t \n\t\t END_CASE\nELSE\n\tPro_B_cam := 0;\t \n\texcute_run_P_cam_B := FALSE;\t\t \nEND_IF;\t\t\t   \n/// Test Pick by Cam\t\t\t\t\t\t\n\t  \t\t\t\t\t\t\t\t\t\t\t \nIF GVL.MB_[11]  THEN\n\tCASE Test_Pick OF\n\t\t\t0: \n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t10:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t20:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_pick := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t    GVL.MB_[11] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t    END_IF\n\t\t\t30:\n\t\t\t\t CASE GVL.DW_[20] OF\n\t\t\t\t\t0:\n\t\t\t\t\t\tPos_run_manual_B.c.X :=  GVL.Cam_T1.POS_X_RESULT;\n\t\t\t\t\t\tPos_run_manual_B.c.Y :=  GVL.Cam_T1.POS_Y_RESULT;\t\t\t\t\t\n\t\t\t\t\t1:\t  \n\t\t\t\t\t\tPos_run_manual_B.c.X :=  GVL.Cam_T2.POS_X_RESULT;\n\t\t\t\t\t\tPos_run_manual_B.c.Y :=  GVL.Cam_T2.POS_Y_RESULT;\t\t\t\t\t\t \t\t\t\t\t\t\t  \n\t\t\t\t END_CASE\t  \n\t\t\t\tPos_run_manual_B.c.Z :=  GVL.RB_B_.CUR_Z;\t\t\t\t\t \n\t\t\t\tPos_run_manual_B.c.A :=  GVL_1.DATA_RB_B.r_POS[1];\t\n// \t\t\t\t\t IF GVL.Cam_T2.POS_R_RESULT < 180 THEN\n// \t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[1] + GVL.Cam_T2.POS_R_RESULT ;\t  \n// \t\t\t\t\tELSE\n// \t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[1] - (360-GVL.Cam_T2.POS_R_RESULT) ;\t \n// \t\t\t\t\tEND_IF\t  \n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t40:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_pick := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t    GVL.MB_[11] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t    END_IF\n\t\t\t50:\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tTest_Pick := Test_Pick + 10;\t\t \n\t\t\t60:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t70:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_pick := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t    GVL.MB_[11] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t    END_IF\n\t\t\t80:\t\n\t\t\t\t CASE GVL.RB_B.Number_Tool OF\n\t\t\t\t\t1:\n\t\t\t\t\t\tGVL.RB_B.Vacuum_1 := TRUE;\t\t\t\t\n\t\t\t\t\t2:\t  \n\t\t\t\t\t\tGVL.RB_B.Vacuum_2 := TRUE;\t\t\t\t\t\t \t\t\t\t\t\t\t  \n\t\t\t\t END_CASE\t\t\t\t\t \n\t\t\t\t\t//Project_3_Delay_A(IN:= TRUE, PT := T#500MS);\n\t\t\t\tIF Project_3_Delay_A.Q THEN\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\t\n\t\t\t\tEND_IF;\t\t\t\t\t\t  \n\t\t\t90: \n\t\t\t\tProject_3_Delay_A.IN\t:= FALSE;\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t100:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t110:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_pick := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t    GVL.MB_[11] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t    END_IF\t\n\t\t\t120:\n\t\t\t\tPos_run_manual_B.c.X:= GVL_1.DATA_RB_B.X_POS[1];\n\t\t\t\tPos_run_manual_B.c.Y:= GVL_1.DATA_RB_B.Y_POS[1];\n\t\t\t\tPos_run_manual_B.c.Z:= GVL.RB_B_.CUR_Z;\n\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[1];\t\t\t\t \n\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t130:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_pick := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t    GVL.MB_[11] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_pick := FALSE;\n\t\t\t\t\tTest_Pick := Test_Pick + 10;\n\t\t\t    END_IF\t\t\t\t\t\t   \n\t\t\t140:/// HOÀN THÀNH ///  \t   \n\t\t\t\t\trun_P_cam_B_test_pick:= FALSE; \n \t\t\t        GVL.MB_[11] := FALSE;\t\t\t \n\t\t END_CASE\t \nELSE\nrun_P_cam_B_test_pick:= FALSE;\t\t \nTest_Pick := 0;\t\t\t  \nEND_IF;\t\t\t\t\t\t\t \n\nIF GVL.MB_[12]  THEN\n\tCASE Test_Place OF\n\t\t\t0: \n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t10:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t20:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t    END_IF\n\t\t\t30:\n\t\t\t\tPos_run_manual_B.c.X:= GVL_1.DATA_RB_B.X_POS[2];\n\t\t\t\tPos_run_manual_B.c.Y:= GVL_1.DATA_RB_B.Y_POS[2];\n\t\t\t\tPos_run_manual_B.c.Z:= GVL.RB_B_.CUR_Z;\n\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[2];\t \n// \t\t\t\t CASE GVL.DW_[20] OF\n// \t\t\t\t\t0:\n// \t\t\t\t\t\t IF GVL.Cam_T1.POS_R_RESULT < 0 THEN\n// \t\t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[2] - GVL.Cam_T1.POS_R_RESULT ;\t  \n// \t\t\t\t\t\tELSE\n// \t\t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[2] + GVL.Cam_T1.POS_R_RESULT ;\t \n// \t\t\t\t\t\tEND_IF\t\t\t\t\t\n// \t\t\t\t\t1:\t  \n// \t\t\t\t\t\t IF GVL.Cam_T2.POS_R_RESULT < 0 THEN\n// \t\t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[2] - GVL.Cam_T2.POS_R_RESULT ;\t  \n// \t\t\t\t\t\tELSE\n// \t\t\t\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[2] + GVL.Cam_T2.POS_R_RESULT ;\t \n// \t\t\t\t\t\tEND_IF\t\t\t\t\t\t \t\t\t\t\t\t\t  \n// \t\t\t\t END_CASE\t\t\t\t\t  \n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t40:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := test_Place + 1;\n\t\t\t    END_IF\n\t\t\t41:\n\t\t\t\t CASE GVL.DW_[20] OF\n\t\t\t\t\t0:\n\t\t\t\t\t\t IF GVL.Cam_T1.POS_R_RESULT < 0 THEN\n\t\t\t\t\t\t\tPos_run_manual_B.c.A:=  GVL_1.DATA_RB_B.R_POS[2] + GVL.Cam_T1.POS_R_RESULT ;\t  \n\t\t\t\t\t\t\ttest_Place := test_Place + 1;\t \n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tPos_run_manual_B.c.A:=  GVL_1.DATA_RB_B.R_POS[2] - GVL.Cam_T1.POS_R_RESULT ;\t\n \t\t\t\t\t\t\ttest_Place := test_Place + 1;\n\t\t\t\t\t\tEND_IF\t\t\t\t\t\n\t\t\t\t\t1:\t  \n\t\t\t\t\t\t IF GVL.Cam_T2.POS_R_RESULT < 0 THEN\n\t\t\t\t\t\t\tPos_run_manual_B.c.A:=  GVL_1.DATA_RB_B.R_POS[2] + GVL.Cam_T2.POS_R_RESULT ;\n\t\t\t\t\t\t\ttest_Place := test_Place + 1;\n  \n\t\t\t\t\t\tELSE\n\t\t\t\t\t\t\tPos_run_manual_B.c.A:=  GVL_1.DATA_RB_B.R_POS[2] - GVL.Cam_T2.POS_R_RESULT ;\n\t\t\t\t\t\t\ttest_Place := test_Place + 1;\t \n\t\t\t\t\t\tEND_IF\t\t\t\t\t\t \t\t\t\t\t\t\t  \n\t\t\t\t END_CASE\t\t\t\t\t \n\t\t\t42:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := 50;\n\t\t\t    END_IF\t\t\t\t \n\t\t\t\t\t  \n\t\t\t50:\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\ttest_Place := test_Place + 10;\t\t \n\t\t\t60:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[2];\n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t70:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t    END_IF\n\t\t\t80:\t\t \n\t\t\t\tCASE GVL.RB_B.Number_Tool OF\n\t\t\t\t\t0:\n\t\t\t\t\t\tGVL.RB_B.Vacuum_1 := FALSE; \n\t\t\t\t\t\tGVL.RB_B.Vacuum_2 := FALSE;\t \n\t\t\t\t\t1: \t \t\t\t\n\t\t\t\t\t\tGVL.RB_B.Vacuum_1 := FALSE;\n\t\t\t\t\t2:\n\t\t\t\t\t\tGVL.RB_B.Vacuum_2 := FALSE; \n\t\t\t\tEND_CASE\n\t\t\t\t\tProject_3_Delay_B(IN:= TRUE, PT := T#500MS);\n\t\t\t\tIF Project_3_Delay_B.Q THEN\n\t\t\t\t\ttest_Place := test_Place + 10;\t\n\t\t\t\tEND_IF;\t\t\t\t\t\t  \n\t\t\t90: \n\t\t\t\tProject_3_Delay_B.IN\t:= FALSE;\n\t\t\t\tPos_run_manual_B :=  POU_MONITOR_ROBOT.RB2_POS;\n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t100:\n\t\t\t\tPos_run_manual_B.c.Z :=  GVL_1.DATA_RB_B.Z_POS[1];\n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t110:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t    END_IF\t\n\t\t\t120:\n\t\t\t\tPos_run_manual_B.c.X:= GVL_1.DATA_RB_B.X_POS[1];\n\t\t\t\tPos_run_manual_B.c.Y:= GVL_1.DATA_RB_B.Y_POS[1];\n\t\t\t\tPos_run_manual_B.c.Z:= GVL.RB_B_.CUR_Z;\n\t\t\t\tPos_run_manual_B.c.A:= GVL_1.DATA_RB_B.R_POS[1];\t\t\t\t \n\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t130:\n\t\t\t\tIF Other_PosB THEN\n\t\t\t\trun_P_cam_B_test_Place := TRUE;\n\t\t\t\tPos_Run_B_Pre := Pos_run_manual_B; \n\t\t\t\tEND_IF;\n\t\t\t\tIF GVL.RB_B_.ERROR OR  NOT GVL.RB_B_.Ready THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t    GVL.MB_[12] := FALSE;\n\t\t\t    END_IF\n\t\t\t    IF MOVP_B.Done THEN\n\t\t\t\t\trun_P_cam_B_test_Place := FALSE;\n\t\t\t\t\ttest_Place := test_Place + 10;\n\t\t\t    END_IF\t\t\t\t\t\t   \n\t\t\t140:/// HOÀN THÀN