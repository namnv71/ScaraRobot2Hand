{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d7573f91-3b6a-4106-aa98-eb151f865485","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_View_Edit_Point_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// ============================================================\n// CREATE ACTION: ACT_View_Edit_Point_B\n// Parent POU: POU_HMI_CONTROL_ROBOT\n// Source mirrored from: ACT_View_Edit_Point_A\n// ============================================================\n\n// Chuyen doi ten diem khi lam o phan jog va teaching\nIF GVL.HMI_B_ChangeSelectedPoint THEN\n\tGVL.HMI_B_Edit_Pos_Name := GVL_1.Point_Name_B[GVL.DW_[12]];\n\tGVL.HMI_B_ChangeSelectedPoint := FALSE;\nEND_IF\n\n// Lua chon Cac diem can View va Edit \nCASE GVL.HMI_B_PointViewCmd OF\n    1:\n        GVL.HMI_B_ViewStartPoint := MAX(1, GVL.HMI_B_ViewStartPoint - 1);\n\n    2:\n        GVL.HMI_B_ViewStartPoint := MIN(491, GVL.HMI_B_ViewStartPoint + 1);\n\n    3:\n        GVL.HMI_B_ViewStartPoint := MAX(1, GVL.HMI_B_ViewStartPoint - 10);\n\n    4:\n        GVL.HMI_B_ViewStartPoint := MIN(491, GVL.HMI_B_ViewStartPoint + 10);\n\n    5:\n        GVL.HMI_B_ViewStartPoint := 1;\n\n    6:\n        GVL.HMI_B_ViewStartPoint := 491;\n\nEND_CASE;\n\nGVL.HMI_B_PointViewCmd := 0;\n\n// Refresh toa do hien thi tren HMI\nFOR i := 1 TO 10 DO\n    idx := GVL.HMI_B_ViewStartPoint + i - 1;\n\n    GVL.HMI_B_PointNo[i]   := idx;\n    GVL.HMI_B_View_Pos_Name[i] := GVL_1.Point_Name_B[idx];\n    GVL.HMI_B_View_Pos_X[i]    := GVL_1.DATA_RB_B.X_POS[idx];\n\tGVL.HMI_B_View_Pos_Y[i]    := GVL_1.DATA_RB_B.Y_POS[idx];\n\tGVL.HMI_B_View_Pos_Z[i]    := GVL_1.DATA_RB_B.Z_POS[idx];\n\tGVL.HMI_B_View_Pos_R[i]    := GVL_1.DATA_RB_B.R_POS[idx];\nEND_FOR\n\n// Tinh diem lua chon thuc te tren PLC tu HMI\n//GVL.HMI_B_Poi := HMI_PointStartIndex + HMI_PointSelectedRow - 1;\n\n// Xu ly chon dong\nFOR i := 1 TO 10 DO\n    IF (GVL.HMI_B_RowSelectedPoint = i) THEN\n\t\tGVL.HMI_B_RowSelectedPoint_Array[i] := TRUE;\n\t\tGVL.HMI_B_PointNoSelected := i + GVL.HMI_B_ViewStartPoint - 1;\n\tELSE\n\t\tGVL.HMI_B_RowSelectedPoint_Array[i] := FALSE;\n    END_IF;\nEND_FOR;\n\n\n// Edit Point\n// Load Point to Edit\nIF GVL.HMI_B_EditPointReq = 20 THEN\n    GVL.HMI_B_Edit_PointNo   := GVL.HMI_B_PointNoSelected;\n    GVL.HMI_B_Edit_Pos_Name  := GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_X     := GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_Y     := GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_Z     := GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_R     := GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected];\n\n    GVL.HMI_B_EditPointReq := 0;\nEND_IF\n\n// Delete Point to Edit\nDelete_one_point_B(IN:= GVL.HMI_B_EditPointReq_Arr[6], PT := T#2S);\n// IF GVL.HMI_B_EditPointReq = 23 THEN\n//     GVL.HMI_B_Edit_PointNo   := GVL.HMI_B_PointNoSelected;\n//     GVL.HMI_B_Edit_Pos_Name  := '';\n//     GVL.HMI_B_Edit_Pos_X     := 0;\n//     GVL.HMI_B_Edit_Pos_Y     := 0;\n//     GVL.HMI_B_Edit_Pos_Z     := 0;\n//     GVL.HMI_B_Edit_Pos_R     := 0;\n// END_IF\nIF Delete_one_point_B.Q THEN\n\tIF (GVL.HMI_B_PointNoSelected >= 1) AND (GVL.HMI_B_PointNoSelected <= 500) THEN\n\n        //----------------------------------------------------\n        // Xóa dữ liệu thật\n        //----------------------------------------------------\n        GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected] := '';\n\n        GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected] := 0.0;\n\n        GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected] := 0.0;\n\n        GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected] := 0.0;\n\n        GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected] := 0.0;\n\n\tEND_IF;\n\tGVL.HMI_B_EditPointReq := 0;\n\tGVL.HMI_B_EditPointReq_Arr[6] := FALSE;\nEND_IF\n\n// Save Point Data\nIF GVL.HMI_B_EditPointReq = 24 THEN\n    GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected]      := GVL.HMI_B_Edit_Pos_Name;\n    GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected]   := GVL.HMI_B_Edit_Pos_X;\n    GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected]   := GVL.HMI_B_Edit_Pos_Y;\n    GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected]   := GVL.HMI_B_Edit_Pos_Z;\n    GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected]   := GVL.HMI_B_Edit_Pos_R;\n\n    GVL.HMI_B_EditPointReq := 0;\nEND_IF\n\n// Add Point to Step Table\nIF GVL.HMI_B_EditPointReq = 21 THEN\n    GVL.HMI_B_Edit_PointNo   := GVL.HMI_B_PointNoSelected;\n    GVL.HMI_B_Edit_Pos_Name  := GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_X     := GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_Y     := GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_Z     := GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected];\n    GVL.HMI_B_Edit_Pos_R     := GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected];\n\n    GVL.HMI_B_EditPointReq := 0;\nEND_IF\n\n//============================================================\n// COPY POINT\n//\n// HMI_A_EditPointReq = 25\n//\n// Copy toàn bộ dữ liệu của Point đang được chọn\n// vào Clipboard.\n//============================================================\nIF GVL.HMI_B_EditPointReq = 25 THEN\n\n    //--------------------------------------------------------\n    // Kiểm tra PointNo hợp lệ\n    // Thay 500 bằng số Point tối đa thực tế của anh\n    //--------------------------------------------------------\n    IF (GVL.HMI_B_PointNoSelected >= 1)\n       AND (GVL.HMI_B_PointNoSelected <= 500)\n    THEN\n\n        //----------------------------------------------------\n        // Lưu Point nguồn\n        //----------------------------------------------------\n        GVL.B_PointClipboardSourceNo := GVL.HMI_B_PointNoSelected;\n\n        //----------------------------------------------------\n        // Copy Name\n        //----------------------------------------------------\n        GVL.B_PointClipboardName := GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected];\n\n        //----------------------------------------------------\n        // Copy Position\n        //----------------------------------------------------\n        GVL.B_PointClipboardX := GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected];\n\n        GVL.B_PointClipboardY := GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected];\n\n        GVL.B_PointClipboardZ := GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected];\n\n        GVL.B_PointClipboardR := GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected];\n\n        //----------------------------------------------------\n        // Clipboard đã có dữ liệu\n        //----------------------------------------------------\n        GVL.B_PointClipboardValid := TRUE;\n\n    END_IF;\n\n    //--------------------------------------------------------\n    // Reset request\n    //--------------------------------------------------------\n    GVL.HMI_B_EditPointReq := 0;\n\nEND_IF;\n\n//============================================================\n// PASTE POINT\n//\n// HMI_A_EditPointReq = 26\n//\n// Paste dữ liệu Clipboard vào Point đang được chọn.\n//============================================================\nIF GVL.HMI_B_EditPointReq = 26 THEN\n\n    //--------------------------------------------------------\n    // Chỉ Paste khi Clipboard có dữ liệu\n    //--------------------------------------------------------\n    IF GVL.B_PointClipboardValid AND (GVL.HMI_B_PointNoSelected >= 1) AND (GVL.HMI_B_PointNoSelected <= 500) THEN\n\n        //----------------------------------------------------\n        // Paste Name\n        //----------------------------------------------------\n        GVL_1.Point_Name_B[GVL.HMI_B_PointNoSelected] := GVL.B_PointClipboardName;\n\n        //----------------------------------------------------\n        // Paste Position\n        //----------------------------------------------------\n        GVL_1.DATA_RB_B.X_POS[GVL.HMI_B_PointNoSelected] := GVL.B_PointClipboardX;\n\n        GVL_1.DATA_RB_B.Y_POS[GVL.HMI_B_PointNoSelected] := GVL.B_PointClipboardY;\n\n        GVL_1.DATA_RB_B.Z_POS[GVL.HMI_B_PointNoSelected] := GVL.B_PointClipboardZ;\n\n        GVL_1.DATA_RB_B.R_POS[GVL.HMI_B_PointNoSelected] := GVL.B_PointClipboardR;\n\n\n//         //----------------------------------------------------\n//         // Đồng thời cập nhật vùng Edit để HMI hiển thị\n//         // ngay dữ liệu vừa Paste\n//         //----------------------------------------------------\n//         GVL.HMI_B_Edit_PointNo := GVL.HMI_B_PointNoSelected;\n// \n//         GVL.HMI_B_Edit_Pos_Name := GVL.B_PointClipboardName;\n// \n//         GVL.HMI_B_Edit_Pos_X := GVL.B_PointClipboardX;\n// \n//         GVL.HMI_B_Edit_Pos_Y := GVL.B_PointClipboardY;\n// \n//         GVL.HMI_B_Edit_Pos_Z := GVL.B_PointClipboardZ;\n// \n//         GVL.HMI_B_Edit_Pos_R := GVL.B_PointClipboardR;\n\n    END_IF;\n\n    //--------------------------------------------------------\n    // Không xóa Clipboard.\n    //\n    // Nhờ vậy có thể:\n    // Copy P10 → Paste P20 → Paste P21 → Paste P22...\n    //--------------------------------------------------------\n\n    GVL.HMI_B_EditPointReq := 0;\n\nEND_IF;\n\n//============================================================\n// DELETE ALL POINTS\n//\n// HMI_A_EditPointReq = 27\n//\n// Xóa toàn bộ Point Database.\n//============================================================\n\nDelete_all_point_B(IN := GVL.HMI_B_EditPointReq_Arr[7], PT := T#2S);\nIF Delete_all_point_B.Q THEN\n\n    FOR iPoint := 1 TO 500 DO\n\n        //----------------------------------------------------\n        // Clear Name\n        //----------------------------------------------------\n        GVL_1.Point_Name_B[iPoint] := '';\n\n        //----------------------------------------------------\n        // Clear Position\n        //----------------------------------------------------\n        GVL_1.DATA_RB_B.X_POS[iPoint] := 0.0;\n        GVL_1.DATA_RB_B.Y_POS[iPoint] := 0.0;\n        GVL_1.DATA_RB_B.Z_POS[iPoint] := 0.0;\n        GVL_1.DATA_RB_B.R_POS[iPoint] := 0.0;\n\n    END_FOR;\n\n\n    //--------------------------------------------------------\n    // Clear vùng Edit trên HMI\n    //--------------------------------------------------------\n    GVL.HMI_B_Edit_PointNo  := 0;\n    GVL.HMI_B_Edit_Pos_Name := '';\n\n    GVL.HMI_B_Edit_Pos_X := 0.0;\n    GVL.HMI_B_Edit_Pos_Y := 0.0;\n    GVL.HMI_B_Edit_Pos_Z := 0.0;\n    GVL.HMI_B_Edit_Pos_R := 0.0;\n\n\n    //--------------------------------------------------------\n    // Reset Point đang chọn\n    //--------------------------------------------------------\n    GVL.HMI_B_PointNoSelected := 0;\n\n\n    //--------------------------------------------------------\n    // Em khuyên KHÔNG xóa Clipboard.\n    //\n    // Nếu Delete All nhầm, dữ liệu Point vừa Copy vẫn còn\n    // và có thể Paste lại.\n    //--------------------------------------------------------\n\n    GVL.HMI_B_EditPointReq := 0;\n\tGVL.HMI_B_EditPointReq_Arr[7] := FALSE;\n\nEND_IF;","LineInfoPersistence":"(string)d7573f91-3b6a-4106-aa98-eb151f865485_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)300"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}