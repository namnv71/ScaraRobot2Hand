{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9f3f6c08-46ee-4151-8471-09e1956b53ef","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_ToolManager","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)bf8f05de-2ef0-4a76-8958-b734ab9b43c2"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFUNCTION BLOCK\n    FB_ToolManager\n\nDESCRIPTION\n    Điều khiển một Tool độc lập.\n\nSUPPORTED COMMANDS\n    - DOWN\n    - GRIP\n    - UP\n    - RELEASE\n\nFEEDBACK RULE\n    - Nếu DI Channel > 0:\n          Dùng DI làm điều kiện hoàn thành.\n    - Nếu DI Channel = 0:\n          Dùng Timer cấu hình tương ứng.\n    - Nếu UseUpDown = FALSE:\n          DOWN và UP hoàn thành ngay.\n\nIMPORTANT\n    - Chỉ FB này được phép ghi request IO của Tool.\n    - Interpreter không nên ghi trực tiếp vào các DO đã thuộc Tool.\n===============================================================================\n*)\n\n//=============================================================================\n// DEFAULT PULSE OUTPUTS\n//=============================================================================\nStatus.Accepted := FALSE;\nStatus.Done := FALSE;\n\n\n//=============================================================================\n// COPY TOOL ID TO STATUS\n//=============================================================================\nStatus.ToolID := Config.ToolID;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF NOT Enable OR Command.Reset THEN\n\n    Status.Busy := FALSE;\n\n    Status.Error := FALSE;\n    Status.ErrorID := 0;\n\n    Status.State :=\n        E_ToolRuntimeState.IDLE;\n\n    tonAction(IN := FALSE);\n    tonTimeout(IN := FALSE);\n    tonConfirm(IN := FALSE);\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// ABORT\n//=============================================================================\nIF Command.Abort THEN\n\n    Status.Busy := FALSE;\n\n    Status.Error := TRUE;\n    Status.ErrorID := 9299;\n\n    Status.State :=\n        E_ToolRuntimeState.ERROR;\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// DETECT NEW COMMAND\n//=============================================================================\nrtExecute(CLK := Command.Execute);\n\nIF rtExecute.Q AND NOT Status.Busy THEN\n\n    // Lưu loại lệnh hiện tại.\n    eActiveCommand :=\n        Command.CommandType;\n\n    // Handshake.\n    Status.Accepted := TRUE;\n    Status.Busy := TRUE;\n\n    Status.Error := FALSE;\n    Status.ErrorID := 0;\n\n    Status.ResponseCommandID :=\n        Command.CommandID;\n\n    // Reset timer trước khi bắt đầu lệnh mới.\n    tonAction(IN := FALSE);\n    tonTimeout(IN := FALSE);\n    tonConfirm(IN := FALSE);\n\n    // Gán State runtime.\n    CASE eActiveCommand OF\n\n        E_ToolCommandType.DOWN:\n            Status.State :=\n                E_ToolRuntimeState.DOWNING;\n\n        E_ToolCommandType.GRIP:\n            Status.State :=\n                E_ToolRuntimeState.GRIPPING;\n\n        E_ToolCommandType.UP:\n            Status.State :=\n                E_ToolRuntimeState.UPPING;\n\n        E_ToolCommandType.RELEASE:\n            Status.State :=\n                E_ToolRuntimeState.RELEASING;\n\n        ELSE\n            Status.Busy := FALSE;\n            Status.Done := TRUE;\n\n    END_CASE;\n\nEND_IF;\n\n\n//=============================================================================\n// NO ACTIVE COMMAND\n//=============================================================================\nIF NOT Status.Busy THEN\n    RETURN;\nEND_IF;\n\n\n//=============================================================================\n// RESET LOCAL ACTION FLAGS\n//=============================================================================\nxActionOK := FALSE;\nxFeedbackDI := FALSE;\n\ntAction := T#0MS;\ntTimeout := T#1S;\n\n\n//=============================================================================\n// EXECUTE ACTIVE COMMAND\n//=============================================================================\nCASE eActiveCommand OF\n\n\n    //=========================================================================\n    // ACTION: DOWN\n    //=========================================================================\n    E_ToolCommandType.DOWN:\n\n        // Tool không có cơ cấu Up/Down.\n        IF NOT Config.UseUpDown THEN\n\n            xActionOK := TRUE;\n\n        ELSE\n\n            //-----------------------------------------------------------------\n            // COMMAND DOWN OUTPUT\n            //-----------------------------------------------------------------\n\t\t\t\n\t\t\tIF Config.IO.UseSingleUpDownDO THEN\n\t\t\t\t// Single DO: phat muc DOWN.\n\t\t\t\tIF Config.IO.UpDownDOChannel > 0 AND Config.IO.UpDownDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.UpDownDOChannel] := Config.IO.DownDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\tELSE\n\t\t\t\t// Dual DO: bat Down, tat Up.\n\t\t\t\tIF Config.IO.DownDOChannel > 0 AND Config.IO.DownDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.DownDOChannel] := Config.IO.DownDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tIF Config.IO.UpDOChannel > 0 AND Config.IO.UpDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.UpDOChannel] := NOT Config.IO.UpDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\n\n            //-----------------------------------------------------------------\n            // CHECK DOWN FEEDBACK\n            //-----------------------------------------------------------------\n            IF Config.IO.DownOKDIChannel = 0 THEN\n\n                // Không có DI -> dùng Timer.\n                tAction :=\n                    Config.DownTimeNoSensor;\n\n                tonAction(\n                    IN := TRUE,\n                    PT := tAction\n                );\n\n                xActionOK :=\n                    tonAction.Q;\n\n            ELSE\n\n                // Có DI -> dùng Sensor.\n                xActionOK :=\n                    GVL.X[\n                        Config.IO.DownOKDIChannel\n                    ] = Config.IO.DownOKDIActiveLevel;\n\n            END_IF;\n\n\n            // Timeout của DOWN.\n            tTimeout :=\n                Config.DownTimeout;\n\n        END_IF;\n\n\n    //=========================================================================\n    // ACTION: GRIP\n    //=========================================================================\n    E_ToolCommandType.GRIP:\n\n        //---------------------------------------------------------------------\n        // RESET RELEASE OUTPUT\n        //---------------------------------------------------------------------\n        IF Config.IO.UseSingleGripReleaseDO THEN\n\t\t\tIF Config.IO.GripReleaseDOChannel > 0 AND Config.IO.GripReleaseDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.GripReleaseDOChannel] := Config.IO.GripDOActiveLevel;\n\t\t\tEND_IF;\n\t\tELSE\n\t\t\tIF Config.IO.ReleaseDOChannel > 0 AND Config.IO.ReleaseDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.ReleaseDOChannel] := NOT Config.IO.ReleaseDOActiveLevel;\n\t\t\tEND_IF;\n\t\t\tIF Config.IO.GripDOChannel > 0 AND Config.IO.GripDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.GripDOChannel] := Config.IO.GripDOActiveLevel;\n\t\t\tEND_IF;\n\t\tEND_IF;\n\n\n        //---------------------------------------------------------------------\n        // CHECK GRIP FEEDBACK\n        //---------------------------------------------------------------------\n        IF Config.IO.GripOKDIChannel = 0 THEN\n\n            // Không có GripOK DI -> dùng Timer.\n            tAction :=\n                Config.GripTimeNoSensor;\n\n            tonAction(\n                IN := TRUE,\n                PT := tAction\n            );\n\n            xActionOK :=\n                tonAction.Q;\n\n        ELSE\n\n            // Có GripOK DI.\n            xFeedbackDI :=\n                GVL.X[\n                    Config.IO.GripOKDIChannel\n                ] = Config.IO.GripOKDIActiveLevel;\n\n            // Xác nhận tín hiệu ổn định.\n            tonConfirm(\n                IN := xFeedbackDI,\n                PT := Config.GripConfirmDelay\n            );\n\n            xActionOK :=\n                tonConfirm.Q;\n\n        END_IF;\n\n\n        // Timeout của GRIP.\n        tTimeout :=\n            Config.GripTimeout;\n\n\n    //=========================================================================\n    // ACTION: UP\n    //=========================================================================\n    E_ToolCommandType.UP:\n\n        // Tool không có cơ cấu Up/Down.\n        IF NOT Config.UseUpDown THEN\n\n            xActionOK := TRUE;\n\n        ELSE\n\n            //-----------------------------------------------------------------\n            // RESET DOWN OUTPUT\n            //-----------------------------------------------------------------\n\t\t\tIF Config.IO.UseSingleUpDownDO THEN\n\t\t\t\t// Single DO: UP = dao muc DOWN.\n\t\t\t\tIF Config.IO.UpDownDOChannel > 0 AND Config.IO.UpDownDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.UpDownDOChannel] := NOT Config.IO.DownDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\tELSE\n\t\t\t\t// Dual DO: tat Down, bat Up.\n\t\t\t\tIF Config.IO.DownDOChannel > 0 AND Config.IO.DownDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.DownDOChannel] := NOT Config.IO.DownDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tIF Config.IO.UpDOChannel > 0 AND Config.IO.UpDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\t\tGVL.Y[Config.IO.UpDOChannel] := Config.IO.UpDOActiveLevel;\n\t\t\t\tEND_IF;\n\t\t\tEND_IF;\n\n\n            //-----------------------------------------------------------------\n            // CHECK UP FEEDBACK\n            //-----------------------------------------------------------------\n            IF Config.IO.UpOKDIChannel = 0 THEN\n\n                // Không có DI -> dùng Timer.\n                tAction :=\n                    Config.UpTimeNoSensor;\n\n                tonAction(\n                    IN := TRUE,\n                    PT := tAction\n                );\n\n                xActionOK :=\n                    tonAction.Q;\n\n            ELSE\n\n                // Có DI -> dùng Sensor.\n                xActionOK :=\n                    GVL.X[\n                        Config.IO.UpOKDIChannel\n                    ] = Config.IO.UpOKDIActiveLevel;\n\n            END_IF;\n\n\n            // Timeout của UP.\n            tTimeout :=\n                Config.UpTimeout;\n\n        END_IF;\n\n\n    //=========================================================================\n    // ACTION: RELEASE\n    //=========================================================================\n    E_ToolCommandType.RELEASE:\n\n        //---------------------------------------------------------------------\n        // RESET GRIP OUTPUT\n        //---------------------------------------------------------------------\n        IF Config.IO.UseSingleGripReleaseDO THEN\n\t\t\tIF Config.IO.GripReleaseDOChannel > 0 AND Config.IO.GripReleaseDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.GripReleaseDOChannel] := NOT Config.IO.GripDOActiveLevel;\n\t\t\tEND_IF;\n\t\tELSE\n\t\t\tIF Config.IO.GripDOChannel > 0 AND Config.IO.GripDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.GripDOChannel] := NOT Config.IO.GripDOActiveLevel;\n\t\t\tEND_IF;\n\t\t\tIF Config.IO.ReleaseDOChannel > 0 AND Config.IO.ReleaseDOChannel <= GVL.C_MAX_DO THEN\n\t\t\t\tGVL.Y[Config.IO.ReleaseDOChannel] := Config.IO.ReleaseDOActiveLevel;\n\t\t\tEND_IF;\n\t\tEND_IF;\n\n\n        //---------------------------------------------------------------------\n        // RELEASE CURRENTLY USES TIMER\n        //---------------------------------------------------------------------\n        tAction :=\n            Config.ReleaseTimeNoSensor;\n\n        tonAction(\n            IN := TRUE,\n            PT := tAction\n        );\n\n        xActionOK :=\n            tonAction.Q;\n\n\n        // Timeout của RELEASE.\n        tTimeout :=\n            Config.ReleaseTimeout;\n\nEND_CASE;\n\n\n//=============================================================================\n// ACTION TIMEOUT\n//=============================================================================\ntonTimeout(\n    IN := TRUE,\n    PT := tTimeout\n);\n\n\n//=============================================================================\n// COMMAND COMPLETE\n//=============================================================================\nIF xActionOK THEN\n\n    // Reset timer.\n    tonAction(IN := FALSE);\n    tonTimeout(IN := FALSE);\n    tonConfirm(IN := FALSE);\n\n    // Hoàn thành Handshake.\n    Status.Busy := FALSE;\n    Status.Done := TRUE;\n\n    Status.Error := FALSE;\n    Status.ErrorID := 0;\n\n\n    //-------------------------------------------------------------------------\n    // UPDATE TOOL RUNTIME STATE\n    //-------------------------------------------------------------------------\n    CASE eActiveCommand OF\n\n        E_ToolCommandType.DOWN:\n\n            Status.State :=\n                E_ToolRuntimeState.DOWN;\n\n\n        E_ToolCommandType.GRIP:\n\n            Status.State :=\n                E_ToolRuntimeState.OCCUPIED;\n\n            Status.Occupied :=\n                TRUE;\n\n            Status.HeldObjectID :=\n                Command.ObjectID;\n\n            Status.GripOK :=\n                TRUE;\n\n\n        E_ToolCommandType.UP:\n\n            IF Status.Occupied THEN\n\n                Status.State :=\n                    E_ToolRuntimeState.OCCUPIED;\n\n            ELSE\n\n                Status.State :=\n                    E_ToolRuntimeState.UP;\n\n            END_IF;\n\n\n        E_ToolCommandType.RELEASE:\n\n            Status.State :=\n                E_ToolRuntimeState.IDLE;\n\n            Status.Occupied :=\n                FALSE;\n\n            Status.HeldObjectID :=\n                0;\n\n            Status.GripOK :=\n                FALSE;\n\n    END_CASE;\n\n\n//=============================================================================\n// COMMAND ERROR\n//=============================================================================\nELSIF tonTimeout.Q THEN\n\n    Status.Busy := FALSE;\n\n    Status.Error := TRUE;\n\n    // Mã lỗi được tạo từ loại lệnh Tool.\n    Status.ErrorID :=\n        9200 + TO_UDINT(eActiveCommand);\n\n    Status.State :=\n        E_ToolRuntimeState.ERROR;\n\nEND_IF;","LineInfoPersistence":"(string)9f3f6c08-46ee-4151-8471-09e1956b53ef_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_ToolManager\nVAR_INPUT\n\n    // Cho phép Tool Manager.\n    Enable : BOOL;\n\n    // Command hiện tại.\n    Command : ST_ToolCommand;\n\n    // Cấu hình Tool.\n    Config : ST_ToolConfig;\n\nEND_VAR\n\nVAR_IN_OUT\n\n    // Runtime Status của Tool.\n    Status : ST_ToolStatus;\n\nEND_VAR\n\nVAR\n\n    // Bắt cạnh lên của Execute.\n    rtExecute : R_TRIG;\n\n    // Lệnh Tool đang chạy.\n    eActiveCommand : E_ToolCommandType;\n\n    // Timer dùng khi không cấu hình DI.\n    tonAction : TON;\n\n    // Timer giới hạn thời gian lệnh Tool.\n    tonTimeout : TON;\n\n    // Timer xác nhận GripOK ổn định.\n    tonConfirm : TON;\n\n    // Điều kiện lệnh Tool hoàn thành.\n    xActionOK : BOOL;\n\n    // Giá trị DI đang kiểm tra.\n    xFeedbackDI : BOOL;\n\n    // Thời gian giả lập nếu không có Sensor.\n    tAction : TIME;\n\n    // Timeout của lệnh Tool.\n    tTimeout : TIME;\n\nEND_VAR\n","LineInfoPersistence":"(string)9f3f6c08-46ee-4151-8471-09e1956b53ef_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)556","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}