{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)996a7cb4-88bb-4a11-a925-992f4e894d26","ParentGuid":"(Guid)816b64cc-0f9f-4934-8874-fc9591129174","Name":"(string)ACT_LOGIC_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region \"1. Logic Jog\"}\n// JOG ROBOT A\nIF GVL.RB_A.Jog_continue THEN\nJog_FW_A[0]:= GVL.RB_A.JOG_X_FW ;\nJog_FW_A[1]:= GVL.RB_A.JOG_Y_FW ;\nJog_FW_A[2]:= GVL.RB_A.JOG_Z_FW ;\n\nJog_BW_A[0]:= GVL.RB_A.JOG_X_BW ;\nJog_BW_A[1]:= GVL.RB_A.JOG_Y_BW ;\nJog_BW_A[2]:= GVL.RB_A.JOG_Z_BW ;\n\n\tIF  gvl.RB_A.ABC_as_ACS OR GVL.RB_A.COORD = 0 THEN\n\t\tJog_FW_A[3]:= GVL.RB_A.JOG_R_FW ;\t \n\t\tJog_BW_A[3]:= GVL.RB_A.JOG_R_BW ;\t\n\tELSIF NOT gvl.RB_A.ABC_as_ACS AND GVL.RB_A.COORD <> 0 THEN\n\t\tJog_FW_A[5]:= GVL.RB_A.JOG_R_FW ;\t \n\t\tJog_BW_A[5]:= GVL.RB_A.JOG_R_BW ;  \n\tEND_IF;\t\t\t   \nEND_IF;\n\nFOCUS_JOG_A := Jog_FW_A[0] OR Jog_FW_A[1] OR Jog_FW_A[2] OR Jog_FW_A[3] OR Jog_FW_A[4] OR Jog_FW_A[5]\n\t\t\tOR Jog_BW_A[0] OR Jog_BW_A[1] OR Jog_BW_A[2] OR Jog_BW_A[3] OR Jog_BW_A[4] OR Jog_BW_A[5] ;\n\n// CONDITION\nIF GVL.RB_A.Manual AND GVL.RB_A_.Ready AND ( GVL.RB_A_.SAFETY_CHECK OR gvl.RB_A.Control_w_mode = 1) AND FOCUS_JOG_A THEN\n\tSMC_GroupJog2_1.Enable := TRUE;\n\tELSE\n\tSMC_GroupJog2_1.Enable := FALSE;\t\nEND_IF\n\nSMC_GroupJog2_1.ABC_as_ACS := gvl.RB_A.ABC_as_ACS; // true giữ nguyên tool, false : tool quay theo\n{endregion}\n{region \"2. Control Parameter\"}\n/// CONTROL SPEED\nIF GVL.RB_A.Auto THEN\n\tGVL.RB_A.ACC := GVL_1.DATA_RB_A.MOTION_ACC;\n\tGVL.RB_A.DEC := GVL_1.DATA_RB_A.MOTION_DEC;\n\tGVL.RB_A.JERK := GVL_1.DATA_RB_A.MOTION_JERK;\nELSE\n\tGVL.RB_A.ACC :=  GVL_1.DATA_RB_A.MOTION_ACC_MAN;\n\tGVL.RB_A.DEC := GVL_1.DATA_RB_A.MOTION_DEC_MAN;\n\tGVL.RB_A.JERK := GVL_1.DATA_RB_A.MOTION_JERK_MAN;\nEND_IF;\nIF GVL.RB_A.Control_w_speed = 2 THEN\n\tIF GVL.RB_A.Auto THEN\n\t\tGVL.RB_A.SPEED := GVL_1.DATA_RB_A.SPEED_HIGH;\n\tELSE\n\t\tGVL.RB_A.SPEED := GVL.RB_A_Man.SPEED_High_Man;\n\tEND_IF;\nELSIF GVL.RB_A.Control_w_speed = 1 THEN\n\tIF GVL.RB_A.Auto THEN\n\t\tGVL.RB_A.SPEED := GVL_1.DATA_RB_A.SPEED_MID;\n\tELSE\n\t\tGVL.RB_A.SPEED := GVL_1.DATA_RB_A.SPEED_MID_MAN;\n\tEND_IF;\nELSE\n\tIF GVL.RB_A.Auto THEN\n\t\tGVL.RB_A.SPEED := GVL_1.DATA_RB_A.SPEED_LOW;\t\n\tELSE\n\t\tGVL.RB_A.SPEED := GVL_1.DATA_RB_A.SPEED_LOW_MAN;\n\tEND_IF;\nEND_IF\n{endregion}\t \n\t \n{region \"3. Coordinate System\"}\nCASE GVL.RB_A.COORD OF\n\t0:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.ACS;\n\t1:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.MCS;\t \n\t2:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.WCS;\t\n\t3:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.PCS_1;\t\t\t \n\t4:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.PCS_2;\n\t5:\n\t\tCoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.MCS; \n\t\t//CoordSystem_A := SM3_Robotics.SMC_COORD_SYSTEM.TCS;\t\t\t\t  \nEND_CASE\n\n{endregion}","LineInfoPersistence":"(string)996a7cb4-88bb-4a11-a925-992f4e894d26_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)82"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}