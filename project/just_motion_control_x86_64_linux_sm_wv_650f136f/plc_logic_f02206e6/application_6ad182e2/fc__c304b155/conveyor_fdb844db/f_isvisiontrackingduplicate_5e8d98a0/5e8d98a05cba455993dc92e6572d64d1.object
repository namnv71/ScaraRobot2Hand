{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)5e8d98a0-5cba-4559-93dc-92e6572d64d1","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_IsVisionTrackingDuplicate","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)fdb844db-0435-4444-8305-f0123da07eed"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)F_IsVisionTrackingDuplicate := FALSE;\n\nFOR uiObject := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n\n    IF Queue.Objects[uiObject].Valid THEN\n\n        //---------------------------------------------------------------------\n        // Chỉ bỏ qua Object đã không còn đại diện cho vật trên Conveyor.\n        //---------------------------------------------------------------------\n        IF Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_EMPTY\n        AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_PICKED\n        AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_REJECTED\n        AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_EXPIRED\n        //AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_MISSED\n        AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_ABORTED\n        AND Queue.Objects[uiObject].State <> E_TrackingObjectState.OBJ_ERROR THEN\n\n            //-----------------------------------------------------------------\n            // ProductClass tương thích.\n            //-----------------------------------------------------------------\n            IF ProductClassID = 0\n            OR Queue.Objects[uiObject].ProductClassID = ProductClassID THEN\n\n                rDX := ABS(NewCurrentPos.X - Queue.Objects[uiObject].CurrentPos.X);\n                rDY := ABS(NewCurrentPos.Y - Queue.Objects[uiObject].CurrentPos.Y);\n\n                rDA := F_AngleDifferenceDeg(\n                    Angle1 := NewCurrentPos.A,\n                    Angle2 := Queue.Objects[uiObject].CurrentPos.A\n                );\n\n                IF rDX <= Config.DuplicateToleranceXMM\n                AND rDY <= Config.DuplicateToleranceYMM\n                AND rDA <= Config.DuplicateAngleDeg THEN\n                    F_IsVisionTrackingDuplicate := TRUE;\n                    RETURN;\n                END_IF;\n\n            END_IF;\n\n        END_IF;\n\n    END_IF;\n\nEND_FOR;","LineInfoPersistence":"(string)5e8d98a0-5cba-4559-93dc-92e6572d64d1_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_IsVisionTrackingDuplicate : BOOL\nVAR_INPUT\n    NewCurrentPos : ST_POS;\n    ProductClassID : UINT;\n    Config : ST_VisionTrackingSourceConfig;\nEND_VAR\n\nVAR_IN_OUT\n    Queue : ST_TRACKING_QUEUE;\nEND_VAR\n\nVAR\n    uiObject : UINT;\n    rDX : REAL;\n    rDY : REAL;\n    rDA : REAL;\nEND_VAR","LineInfoPersistence":"(string)5e8d98a0-5cba-4559-93dc-92e6572d64d1_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)62","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}