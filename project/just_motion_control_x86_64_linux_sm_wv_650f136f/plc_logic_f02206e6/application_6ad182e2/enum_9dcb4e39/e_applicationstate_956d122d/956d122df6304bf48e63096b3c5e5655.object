{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)956d122d-f630-4bf4-8e63-096b3c5e5655","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_ApplicationState","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)9dcb4e39-219e-4927-8677-e88ae77e3427"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_ApplicationState :\n(\n    APP_IDLE := 0,                    // Application Manager đang rảnh.\n\n    APP_ACCEPT_REQUEST := 10,          // Tiếp nhận yêu cầu từ Interpreter.\n    APP_PREPARE := 20,                 // Chuẩn bị camera, job và dữ liệu capture.\n    APP_START_VISION := 30,            // Phát yêu cầu tới Vision Manager.\n    APP_WAIT_VISION := 40,             // Chờ Vision Manager hoàn thành.\n    APP_PROCESS_RESULT := 50,          // Phân loại và xử lý kết quả vision.\n    APP_PREPARE_MOTION := 60,          // Chuẩn bị offset, path hoặc object.\n    APP_EXECUTE := 70,                 // Thực hiện ứng dụng tương ứng.\n    APP_WAIT_COMPLETE := 80,           // Chờ module con hoàn thành.\n    APP_COMPLETE := 90,                // Toàn bộ yêu cầu hoàn thành.\n    APP_ABORTING := 100,               // Đang hủy ứng dụng.\n    APP_RESETTING := 110,              // Đang reset các module liên quan.\n\n    APP_ERROR := 900                   // Application Manager gặp lỗi.\n);\nEND_TYPE","LineInfoPersistence":"(string)956d122d-f630-4bf4-8e63-096b3c5e5655_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)21"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}