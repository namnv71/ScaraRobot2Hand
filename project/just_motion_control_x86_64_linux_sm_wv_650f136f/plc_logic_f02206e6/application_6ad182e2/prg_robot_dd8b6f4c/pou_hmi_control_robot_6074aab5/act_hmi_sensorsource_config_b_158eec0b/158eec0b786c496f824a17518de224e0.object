{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)158eec0b-786c-496f-824a-17518de224e0","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_HMI_SensorSource_Config_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// CREATE ACTION under POU_HMI_CONTROL_ROBOT: ACT_HMI_SensorSource_Config_B\n\n//=============================================================================\n// SENSOR SOURCE HMI LOAD / SAVE\n//=============================================================================\n\n//=============================================================================\n// 03. KHỞI TẠO INDEX MẶC ĐỊNH\n//=============================================================================\nIF GVL.g_uiHMISensorSourceIndexB = 0 OR GVL.g_uiHMISensorSourceIndexB > GVL.C_MAX_SENSOR_SOURCES THEN\n    GVL.g_uiHMISensorSourceIndexB := 1;\nEND_IF;\n\n\n\n//-----------------------------------------------------------------------------\n// LOAD\n//-----------------------------------------------------------------------------\nIF GVL.g_xHMILoadSensorSourceB THEN\n\n    IF (GVL.g_uiHMISensorSourceIndexB >= 1)\n    AND (GVL.g_uiHMISensorSourceIndexB <= GVL.C_MAX_SENSOR_SOURCES) THEN\n\n        GVL.g_stHMISensorSourceB :=\n            GVL.g_aSensorSourceConfigB[GVL.g_uiHMISensorSourceIndexB];\n\n    END_IF;\n\n    GVL.g_xHMILoadSensorSourceB := FALSE;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// SAVE\n//-----------------------------------------------------------------------------\nIF GVL.g_xHMISaveSensorSourceB THEN\n\n    IF (GVL.g_uiHMISensorSourceIndexB >= 1)\n    AND (GVL.g_uiHMISensorSourceIndexB <= GVL.C_MAX_SENSOR_SOURCES) THEN\n\n        GVL.g_aSensorSourceConfigB[GVL.g_uiHMISensorSourceIndexB] :=\n            GVL.g_stHMISensorSourceB;\n\n    END_IF;\n\n    GVL.g_xHMISaveSensorSourceB := FALSE;\n\tGVL.g_xHMISaveSensorSourceB_All := TRUE;\n\nEND_IF;","LineInfoPersistence":"(string)158eec0b-786c-496f-824a-17518de224e0_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)50"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}