{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)0246906b-6e43-45a6-9c52-76a8067aa362","ParentGuid":"(Guid)583f7b3d-4fc7-4681-b37e-b1d272f834de","Name":"(string)ACT_Home_Z","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)IF GVL.RB_A.M3 AND GVL.RB_A.Manual AND MC_Power_za.Status THEN\n\tHoming_Z1 := TRUE;\nELSIF NOT GVL.X[9] OR NOT MC_Power_za.Status THEN\n\tHoming_Z1 := FALSE;\nEND_IF\nMC_Home_A2.Execute := GVL.RB_A.ORG_M3;\n/// PRocess\nIF Homing_Z1 THEN\nCASE D_HomeZ_RB1 OF\n\t0:\n\t\tIF  GVL.X[3] THEN\n\t\t\tMC_Jog_za.Velocity := 10;\n\t\t\tMC_Jog_za.JogBackward := TRUE;\n\t\tELSE\n\t\t\tMC_Jog_za.JogBackward := FALSE;\n\t\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 10;\n\t\tEND_IF\n\t10:\n\t\tIF NOT GVL.X[3] THEN\n\t\t\tMC_Jog_za.Velocity := 5;\n\t\t\tMC_Jog_za.JogForward := TRUE;\n\t\tELSE\n\t\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 5;\n\t\tEND_IF\n\t15:\n\t\tIF GVL.X[3] THEN\n\t\t\tMC_Jog_za.JogForward := FALSE;\n\t\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 5;\n\t\tEND_IF\n\t20:\n\t\tMC_Jog_za.JogForward := FALSE;\n\t\tMC_Jog_za.JogBackward := FALSE;\n\t\tMC_Home_A2.Execute := TRUE;\n\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 10;\n\t30:\n\t\tIF MC_Home_A2.Done OR MC_Home_A2.Busy THEN\n\t\t\tMC_Home_A2.Execute := FALSE;\n\t\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 10;\n\t\tELSIF MC_Home_A2.Error THEN\n\t\t\tD_HomeZ_RB1 := 900;\n\t\tEND_IF\t\t\t\t\t\n\t40:\t\n\t\tD_HomeZ_RB1 := D_HomeZ_RB1 + 10;\t\n\t50:\n\t\tD_HomeZ_RB1 := 900;\n///////////////////////////////////////// Process Done ////////////////////////////////////\n\t900:\n\t\tHoming_Z1 := FALSE;\nEND_CASE\nELSE\n\tMC_Jog_za.JogForward := FALSE;\n\tMC_Jog_za.JogBackward := FALSE;\n\tD_HomeZ_RB1 := 0;\nEND_IF\n\n\n\n///// Home Z2 robot B\n\nIF GVL.RB_B.M3 AND GVL.RB_B.Manual AND MC_Power_zB.Status THEN\n\tHoming_Z2 := TRUE;\nELSIF NOT GVL.X[9] OR NOT MC_Power_ZB.Status THEN\n\tHoming_Z2 := FALSE;\nEND_IF\nMC_Home_B2.Execute := GVL.RB_B.ORG_M3;\n/// PRocess\nIF Homing_Z2 THEN\nCASE D_HomeZ_RB2 OF\n\t0:\n\t\tIF  GVL.X[2] THEN\n\t\t\tMC_Jog_ZB.Velocity := 10;\n\t\t\tMC_Jog_ZB.JogBackward := TRUE;\n\t\tELSE\n\t\t\tMC_Jog_ZB.JogBackward := FALSE;\n\t\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 10;\n\t\tEND_IF\n\t10:\n\t\tIF NOT GVL.X[2] THEN\n\t\t\tMC_Jog_ZB.Velocity := 5;\n\t\t\tMC_Jog_ZB.JogForward := TRUE;\n\t\tELSE\n\t\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 5;\n\t\tEND_IF\n\t15:\n\t\tIF GVL.X[2] THEN\n\t\t\tMC_Jog_ZB.JogForward := FALSE;\n\t\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 5;\n\t\tEND_IF\n\t20:\n\t\tMC_Jog_ZB.JogForward := FALSE;\n\t\tMC_Jog_ZB.JogBackward := FALSE;\n\t\tMC_Home_b2.Execute := TRUE;\n\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 10;\n\t30:\n\t\tIF MC_Home_b2.Done OR MC_Home_b2.Busy THEN\n\t\t\tMC_Home_b2.Execute := FALSE;\n\t\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 10;\n\t\tELSIF MC_Home_b2.Error THEN\n\t\t\tD_HomeZ_RB2 := 900;\n\t\tEND_IF\t\t\t\t\t\n\t40:\t\n\t\tD_HomeZ_RB2 := D_HomeZ_RB2 + 10;\t\n\t50:\n\t\tD_HomeZ_RB2 := 900;\n///////////////////////////////////////// Process Done ////////////////////////////////////\n\t900:\n\t\tHoming_Z2 := FALSE;\nEND_CASE\nELSE\n\tMC_Jog_ZB.JogForward := FALSE;\n\tMC_Jog_ZB.JogBackward := FALSE;\n\tD_HomeZ_RB2 := 0;\nEND_IF","LineInfoPersistence":"(string)0246906b-6e43-45a6-9c52-76a8067aa362_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)113"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}