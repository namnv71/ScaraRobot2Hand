{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)3fd91f00-80db-439e-af70-eef73d79e4d8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_SensorObjectSource","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFUNCTION BLOCK\n    FB_SensorObjectSource\n\nDESCRIPTION\n    Tạo Object trong Queue khi Sensor phát hiện sản phẩm.\n\nWORKFLOW\n    Sensor cạnh lên\n        -> Debounce\n        -> Kiểm tra khoảng cách tối thiểu\n        -> Tìm Slot trống\n        -> Tạo Object mới\n        -> Ghi vị trí Conveyor tại thời điểm Capture\n\nNOTES\n    - Sensor Source chỉ phù hợp khi vị trí ngang và góc sản phẩm đã được\n      cơ khí định hướng.\n    - Config.CapturePoseInConveyor là Pose mặc định tại vị trí Sensor.\n===============================================================================\n*)\n//=============================================================================\n// DEFAULT PULSE OUTPUT\n//=============================================================================\nNewObjectPulse := FALSE;\n\n\n//=============================================================================\n// RESET / DISABLE\n//=============================================================================\nIF Reset OR NOT Enable THEN\n\n    Active := FALSE;\n\n    Error := FALSE;\n    ErrorID := 0;\n\n    // Reset debounce.\n    tonDebounce(IN := FALSE);\n\n    // Reset trạng thái cạnh Sensor.\n    xPreviousFiltered := FALSE;\n    xFiltered := FALSE;\n    xRaw := FALSE;\n\n    // Reset lịch sử Capture.\n    xHasLastCapture := FALSE;\n    lrLastCapturePosition := 0.0;\n\n    // Reset runtime tìm Slot.\n    uiSlot := 0;\n\n    // Xóa pulse.\n    NewObjectPulse := FALSE;\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// ACTIVE\n//=============================================================================\nActive := TRUE;\n\n\n//=============================================================================\n// VALIDATE SENSOR CHANNEL\n//=============================================================================\nIF Config.DetectInputChannel = 0\nOR Config.DetectInputChannel > GVL.C_MAX_DI THEN\n\n    Error := TRUE;\n    ErrorID := 9101;\n\n    RETURN;\n\nEND_IF;\n\n\n//=============================================================================\n// READ AND FILTER SENSOR\n//=============================================================================\nxRaw :=\n    GVL.X[Config.DetectInputChannel]\n    = Config.DetectActiveLevel;\n\ntonDebounce(\n    IN := xRaw,\n    PT := Config.DebounceTime\n);\n\nxFiltered := tonDebounce.Q;\n\n\n//=============================================================================\n// DETECT RISING EDGE AFTER DEBOUNCE\n//=============================================================================\nIF xFiltered AND NOT xPreviousFiltered THEN\n\n    //-------------------------------------------------------------------------\n    // CHECK MINIMUM OBJECT SPACING\n    //-------------------------------------------------------------------------\n    IF NOT xHasLastCapture\n    OR ABS(ConveyorPositionMM - lrLastCapturePosition)\n       >= REAL_TO_LREAL(Config.MinimumObjectSpacingMM) THEN\n\n        //---------------------------------------------------------------------\n        // FIND EMPTY QUEUE SLOT\n        //---------------------------------------------------------------------\n        uiSlot := 0;\n\n        FOR uiSlot := 1 TO GVL.C_MAX_TRACK_OBJECTS DO\n\n            IF NOT Queue.Objects[uiSlot].Valid THEN\n                EXIT;\n            END_IF;\n\n        END_FOR;\n\n\n        //---------------------------------------------------------------------\n\t\t// CREATE NEW OBJECT\n\t\t//---------------------------------------------------------------------\n\t\tIF uiSlot <= GVL.C_MAX_TRACK_OBJECTS THEN\n\t\t\n\t\t\t// Sinh ObjectID mới.\n\t\t\tQueue.NextObjectID := Queue.NextObjectID + 1;\n\t\t\n\t\t\t// Tránh ObjectID bằng 0.\n\t\t\tIF Queue.NextObjectID = 0 THEN\n\t\t\t\tQueue.NextObjectID := 1;\n\t\t\tEND_IF;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// BASIC OBJECT DATA\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.Objects[uiSlot].Valid := TRUE;\n\t\t\n\t\t\tQueue.Objects[uiSlot].ObjectID :=\n\t\t\t\tQueue.NextObjectID;\n\t\t\n\t\t\tQueue.Objects[uiSlot].ProductClassID :=\n\t\t\t\tConfig.ProductClassID;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// OBJECT SOURCE\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.Objects[uiSlot].SourceType :=\n\t\t\t\tE_ObjectSourceType.SENSOR;\n\t\t\n\t\t\tQueue.Objects[uiSlot].SourceID :=\n\t\t\t\tConfig.SensorSourceID;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// CAPTURE DATA\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.Objects[uiSlot].PoseInConveyor :=\n\t\t\t\tConfig.CapturePoseInConveyor;\n\t\t\n\t\t\tQueue.Objects[uiSlot].CaptureConveyorPositionMM :=\n\t\t\t\tConveyorPositionMM;\n\t\t\n\t\t\tQueue.Objects[uiSlot].CurrentConveyorPositionMM :=\n\t\t\t\tConveyorPositionMM;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// SENSOR OBJECT DEFAULT DATA\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.Objects[uiSlot].VisionScore := 100.0;\n\t\t\tQueue.Objects[uiSlot].OrientationValid := TRUE;\n\t\t\n\t\t\t// Sensor Source không dùng Vision metadata.\n\t\t\tQueue.Objects[uiSlot].TriggerID := 0;\n\t\t\tQueue.Objects[uiSlot].ProductID := 0;\n\t\t\tQueue.Objects[uiSlot].CameraID := 0;\n\t\t\tQueue.Objects[uiSlot].JobID := 0;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// OWNERSHIP / STATE\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.Objects[uiSlot].Reserved := FALSE;\n\t\t\tQueue.Objects[uiSlot].ReservedToolID := 0;\n\t\t\tQueue.Objects[uiSlot].CanPick := FALSE;\n\t\t\tQueue.Objects[uiSlot].AbortRequired := FALSE;\n\t\t\tQueue.Objects[uiSlot].MissCode := 0;\n\t\t\tQueue.Objects[uiSlot].ErrorID := 0;\n\t\t\n\t\t\tQueue.Objects[uiSlot].State :=\n\t\t\t\tE_TrackingObjectState.OBJ_DETECTED;\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// QUEUE COUNT\n\t\t\t//-----------------------------------------------------------------\n\t\t\tQueue.ValidCount :=\n\t\t\t\tMIN(\n\t\t\t\t\tQueue.ValidCount + 1,\n\t\t\t\t\tGVL.C_MAX_TRACK_OBJECTS\n\t\t\t\t);\n\t\t\n\t\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// SAVE LAST CAPTURE\n\t\t\t//-----------------------------------------------------------------\n\t\t\tlrLastCapturePosition :=\n\t\t\t\tConveyorPositionMM;\n\t\t\n\t\t\txHasLastCapture := TRUE;\n\t\t\tNewObjectPulse := TRUE;\n\t\t\n\t\tEND_IF;\n\n    END_IF;\n\nEND_IF;\n\n\n//=============================================================================\n// STORE PREVIOUS SENSOR STATE\n//=============================================================================\nxPreviousFiltered := xFiltered;","LineInfoPersistence":"(string)3fd91f00-80db-439e-af70-eef73d79e4d8_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_SensorObjectSource\nVAR_INPUT\n\n    // Cho phép FB hoạt động.\n    Enable : BOOL;\n\n    // Reset FB.\n    Reset : BOOL;\n\n    // Cấu hình nguồn Sensor.\n    Config : ST_SensorObjectSourceConfig;\n\n    // Vị trí Conveyor hiện tại.\n    ConveyorPositionMM : LREAL;\n\nEND_VAR\n\nVAR_IN_OUT\n\n    // Queue dùng chung.\n    Queue : ST_TRACKING_QUEUE;\n\nEND_VAR\n\nVAR_OUTPUT\n\n    // FB đang hoạt động.\n    Active : BOOL;\n\n    // Xung một cycle khi tạo Object mới.\n    NewObjectPulse : BOOL;\n\n    // FB báo lỗi.\n    Error : BOOL;\n\n    // Mã lỗi.\n    ErrorID : UDINT;\n\nEND_VAR\n\nVAR\n\n    // Tín hiệu Sensor chưa lọc.\n    xRaw : BOOL;\n\n    // Tín hiệu Sensor sau Debounce.\n    xFiltered : BOOL;\n\n    // Trạng thái Sensor ở cycle trước.\n    xPreviousFiltered : BOOL;\n\n    // Timer Debounce.\n    tonDebounce : TON;\n\n    // Vị trí Conveyor của lần Capture trước.\n    lrLastCapturePosition : LREAL;\n\n    // TRUE khi đã từng Capture Object.\n    xHasLastCapture : BOOL;\n\n    // Slot Queue đang kiểm tra.\n    uiSlot : UINT;\n\nEND_VAR\n","LineInfoPersistence":"(string)3fd91f00-80db-439e-af70-eef73d79e4d8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)293","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}