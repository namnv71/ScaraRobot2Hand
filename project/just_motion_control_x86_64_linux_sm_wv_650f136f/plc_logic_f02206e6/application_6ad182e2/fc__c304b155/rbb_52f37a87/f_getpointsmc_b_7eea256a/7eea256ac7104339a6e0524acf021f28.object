{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7eea256a-c710-4339-a6e0-524acf021f28","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)F_GetPointSMC_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)52f37a87-998e-43fa-bf3b-aad613d24cf5"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// IMPLEMENTATION\n//====================================================\n// F_GetPointSMC_B\n// Chuyển dữ liệu điểm dạng mảng X/Y/Z/A của anh\n// sang kiểu SMC_POS_REF để đưa vào FB Motion\n//====================================================\n\n// Kiểm tra giới hạn point\nIF (PointNo < 1) OR (PointNo > 500) THEN\n    // Nếu lỗi point thì trả về điểm 0\n    // Lỗi thật nên bắt thêm ở Build/Run sau\n    F_GetPointSMC_B := pos;\n    RETURN;\nEND_IF;\n\n// Gán tọa độ Cartesian\npos.c.X := GVL_1.DATA_RB_B.X_POS[PointNo]; // X\npos.c.Y := GVL_1.DATA_RB_B.Y_POS[PointNo]; // Y\npos.c.Z := GVL_1.DATA_RB_B.Z_POS[PointNo]; // Z\n\n// Với SCARA thường A là góc quay quanh Z\n// Tùy cấu hình robot, A có thể là c[3] hoặc orientation field khác\npos.c.A := GVL_1.DATA_RB_B.R_POS[PointNo]; // A / Rz\n\n// Trả kết quả\nF_GetPointSMC_B := pos;","LineInfoPersistence":"(string)7eea256a-c710-4339-a6e0-524acf021f28_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION F_GetPointSMC_B : SMC_POS_REF\nVAR_INPUT\n    PointNo : INT;\nEND_VAR\nVAR\n    pos : SMC_POS_REF;\nEND_VAR\n","LineInfoPersistence":"(string)7eea256a-c710-4339-a6e0-524acf021f28_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)34","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}