{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9a892ae2-42b8-46f3-8f7f-d53915b51179","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_JOG_LOGIC","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// CONTINUE --- INCHING ----POINT\n//  RB_A\n\nTRIG_JOG_CONTINUE_1(CLK:= GVL.RB_A.Jog_continue);\nTRIG_JOG_INCHING_1(CLK:= GVL.RB_A.Jog_Inching);\nTRIG_JOG_POINT_1(CLK:= GVL.RB_A.Jog_Point);\n// \nRS_JOG_CONTINUE_1(\n    SET1  := TRIG_JOG_CONTINUE_1.Q  ,\n    RESET := TRIG_JOG_INCHING_1.Q OR TRIG_JOG_POINT_1.Q,\n    Q1    => GVL.RB_A.Jog_continue\n);\n\nRS_JOG_INCHING_1(\n    SET1  := TRIG_JOG_INCHING_1.Q,\n    RESET := TRIG_JOG_CONTINUE_1.Q OR TRIG_JOG_POINT_1.Q,\n    Q1    => GVL.RB_A.Jog_Inching\n);\nRS_JOG_POINT_1(\n    SET1  := TRIG_JOG_POINT_1.Q,\n    RESET := TRIG_JOG_CONTINUE_1.Q OR TRIG_JOG_INCHING_1.Q,\n    Q1    => GVL.RB_A.Jog_Point\n);\n// RB_B\t\n\t\t\t   \nTRIG_JOG_CONTINUE_2(CLK:= GVL.RB_B.Jog_continue );\nTRIG_JOG_INCHING_2(CLK:= GVL.RB_B.Jog_Inching);\nTRIG_JOG_POINT_2(CLK:= GVL.RB_B.Jog_Point);\n// \nRS_JOG_CONTINUE_2(\n    SET1  := TRIG_JOG_CONTINUE_2.Q,\n    RESET := TRIG_JOG_INCHING_2.Q OR TRIG_JOG_POINT_2.Q,\n    Q1    => GVL.RB_B.Jog_continue\n);\n\nRS_JOG_INCHING_2(\n    SET1  := TRIG_JOG_INCHING_2.Q,\n    RESET := TRIG_JOG_CONTINUE_2.Q OR TRIG_JOG_POINT_2.Q,\n    Q1    => GVL.RB_B.Jog_Inching\n);\n\nRS_JOG_POINT_2(\n    SET1  := TRIG_JOG_POINT_2.Q,\n    RESET := TRIG_JOG_CONTINUE_2.Q OR TRIG_JOG_INCHING_2.Q,\n    Q1    => GVL.RB_B.Jog_Point\n);","LineInfoPersistence":"(string)9a892ae2-42b8-46f3-8f7f-d53915b51179_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)46"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}