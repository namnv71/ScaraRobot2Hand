c_Jerk_Man,Fac_Torque_Man : REAL;\n\t\n\tWORK_MIN_X,WORK_MAX_X, WORK_MIN_Y,WORK_MAX_Y : REAL;\n\tTorque_Limit : Torque_Axis;\n\tRB_Working_Dir : INT;\n\tCoordinate_Auto : ARRAY[0..100] OF INT; // Dung cho cac diem\n\tData_Tranform : ARRAY [0..10] OF PCS_Data;\n\t\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)c61ff01e-86b2-43d9-aa34-bfb0eb42241a_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)37"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}