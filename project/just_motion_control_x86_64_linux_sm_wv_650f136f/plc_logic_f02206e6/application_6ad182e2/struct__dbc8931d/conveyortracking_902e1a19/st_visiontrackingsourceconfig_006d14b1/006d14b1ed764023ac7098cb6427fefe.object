{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)006d14b1-ed76-4023-ac70-98cb6427fefe","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_VisionTrackingSourceConfig","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: ST_VisionTrackingSourceConfig\n//-----------------------------------------------------------------------------\n// Cấu hình một nguồn Vision dùng để tạo Object cho Conveyor Tracking.\n// Đây là BẢN THAY THẾ cho DUT hiện tại: giữ toàn bộ field cũ và bổ sung phần\n// BACKGROUND TRIGGER ở cuối.\n//=============================================================================\nTYPE ST_VisionTrackingSourceConfig :\nSTRUCT\n\n    //=========================================================================\n    // SOURCE IDENTITY\n    //=========================================================================\n    Enable : BOOL;                          // TRUE = cho phép Source hoạt động.\n    VisionSourceID : UINT;                  // ID duy nhất của nguồn Vision Tracking.\n    VisionSourceName : STRING[32];          // Tên hiển thị trên HMI/debug.\n    CameraID : UINT;                        // Camera dùng cho Source này.\n    JobID : UINT;                           // Job Vision dùng để tìm Object.\n\n    //=========================================================================\n    // PRODUCT / FILTER\n    //=========================================================================\n    ProductClassID : UINT;                  // Class mặc định nếu Vision trả ProductClassID = 0.\n    MinimumScore : REAL;                    // Object có Score thấp hơn giá trị này sẽ bị loại.\n    MaxObjectCount : UINT;                  // Số Object tối đa nhận từ một frame.\n\n    //=========================================================================\n    // SCALE VISION\n    //-------------------------------------------------------------------------\n    // ResultInPixel = TRUE:\n    //     X/Y raw của Vision được đổi pixel -> mm bằng MMPerPixelX/Y.\n    // ResultInPixel = FALSE:\n    //     X/Y được coi là mm; nên đặt MMPerPixelX/Y = 1.0 để dễ theo dõi.\n    //=========================================================================\n    ResultInPixel : BOOL;\n    MMPerPixelX : REAL;\n    MMPerPixelY : REAL;\n\n    //=========================================================================\n    // VISION OFFSET\n    //-------------------------------------------------------------------------\n    // Fine offset sau khi kết quả Vision đã được chuẩn hóa về Conveyor CS.\n    // Không dùng field này thay cho Tool PickOffset hoặc Product Height.\n    //=========================================================================\n    VisionOffset : ST_POS;\n\n    //=========================================================================\n    // DUPLICATE FILTER\n    //-------------------------------------------------------------------------\n    // Dùng để so Object mới với Object đang có trong Tracking Queue.\n    // Object RESERVED/TRACKING/PICKING vẫn phải được xét duplicate vì Camera\n    // có thể nhìn lại đúng Object đang được Robot xử lý.\n    //=========================================================================\n    DuplicateToleranceXMM : REAL;\n    DuplicateToleranceYMM : REAL;\n    DuplicateAngleDeg : REAL;\n\n    //=========================================================================\n    // BACKGROUND CAMERA TRIGGER - NEW\n    //-------------------------------------------------------------------------\n    // Tracking Vision không trigger trong TRK_PICK/TRK_CREATE_PCS.\n    // Source này chạy nền trong thời gian TRACK_PICK session đang active.\n    //=========================================================================\n    AutoTrigger : BOOL;                     // TRUE = tự trigger theo quãng đường Conveyor.\n    TriggerPitchMM : REAL;                  // Conveyor đi thêm bao nhiêu mm thì phát frame mới.\n    TriggerOnlyWhenMoving : BOOL;           // TRUE = chỉ trigger khi Conveyor đang chạy.\n    MinimumTriggerVelocityMMs : REAL;        // Ngưỡng tốc độ coi là Conveyor đang chạy.\n\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)006d14b1-ed76-4023-ac70-98cb6427fefe_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)71"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}