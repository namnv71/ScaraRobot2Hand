{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7893855d-0fd7-45de-a1b0-3cbc31adc0d7","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)PRG_VisionTrackingTest_A","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// PRG_VisionTrackingTest_A\n//-----------------------------------------------------------------------------\n// Test pipeline:\n// Vision Modbus -> Driver -> Adapter -> ObjectSource -> Tracking Queue.\n//\n// uiTestObjectCount = 1:\n//      Frame chỉ có Object A.\n//\n// uiTestObjectCount = 2:\n//      Frame có Object A + Object B.\n//\n// Có thể thay đổi X/Y/A Online để mô phỏng Object di chuyển theo Conveyor.\n//=============================================================================\n\nrtResetTest(CLK := xResetTest);\nrtStartTest(CLK := xStartTest);\n\n\n//=============================================================================\n// NHẬN LỆNH RESET\n//=============================================================================\nIF rtResetTest.Q THEN\n    uiTestState := 10;\nEND_IF;\n\n\n//=============================================================================\n// NHẬN LỆNH START\n//-----------------------------------------------------------------------------\n// Không tự Clear Queue khi Start.\n// Nhờ vậy có thể test:\n// Frame 1 = A\n// Frame 2 = A + B\n// Frame 3 = A + B\n//=============================================================================\nIF rtStartTest.Q AND uiTestState = 0 THEN\n    uiTestState := 100;\nEND_IF;\n\n\n// rTestObjectAXMM := rTestObjectABaseXMM + rTestMoveMM;\n// rTestObjectBXMM := rTestObjectBBaseXMM + rTestMoveMM;\n\n//=============================================================================\n// MANUAL TEST FRAME\n//-----------------------------------------------------------------------------\n// Chỉ dùng bộ Frame cố định khi test bằng tay.\n// Auto Response sẽ tự tính tọa độ theo Conveyor.\n//=============================================================================\nIF NOT xAutoResponseTest THEN\n\n    CASE uiTestFrame OF\n\n        // Frame 1: chỉ A.\n        1:\n            uiTestObjectCount := 1;\n            rTestObjectAXMM := 100.0;\n            rTestObjectBXMM := 160.0;\n\n        // Frame 2: A + B, dịch +50 mm.\n        2:\n            uiTestObjectCount := 2;\n            rTestObjectAXMM := 150.0;\n            rTestObjectBXMM := 210.0;\n\n        // Frame 3: A + B, dịch thêm +50 mm.\n        3:\n            uiTestObjectCount := 2;\n            rTestObjectAXMM := 200.0;\n            rTestObjectBXMM := 260.0;\n\n    END_CASE;\n\nEND_IF;\n\n//=============================================================================\n// AUTO RESPONSE TEST\n//-----------------------------------------------------------------------------\n// Khi Background Vision Trigger tạo Command mới, chương trình test tự động\n// lấy TriggerID của Command đó để sinh Result giả lập.\n// Không cần bấm xStartTest bằng tay.\n//=============================================================================\nIF xAutoResponseTest\nAND uiTestState = 0\nAND GVL.g_aVisionCommand[1].Execute\nAND GVL.g_aVisionCommand[1].TriggerID <> 0\nAND GVL.g_aVisionCommand[1].TriggerID <> udiLastAutoCommandTriggerID THEN\n\n    // Lấy đúng TriggerID do Background Trigger vừa tạo.\n    udiTestTriggerID := GVL.g_aVisionCommand[1].TriggerID;\n\n    // Ghi nhớ Command đã xử lý để không giả lập lại cùng TriggerID.\n    udiLastAutoCommandTriggerID := GVL.g_aVisionCommand[1].TriggerID;\n\t\n\t// Đếm số frame Auto đã phát.\n    uiAutoFrameCount := uiAutoFrameCount + 1;\n\n    // Đi vào State tạo Vision Result giả lập.\n    uiTestState := 100;\nEND_IF;\n\n\n//=============================================================================\n// STATE MACHINE\n//=============================================================================\nCASE uiTestState OF\n\n\n    //=========================================================================\n    // 0 - IDLE\n    //=========================================================================\n    0:\n        GVL.g_xResetTrackingObjectSourceA := FALSE;\n        GVL.g_xClearTrackingQueueA := FALSE;\n\n\n    //=========================================================================\n    // 10 - RESET PIPELINE TEST\n    //-------------------------------------------------------------------------\n    // Reset ObjectSource / Adapter và Clear Queue.\n    // Không reset TriggerID để tránh sử dụng lại Transaction cũ.\n    //=========================================================================\n    10:\n\t\t//---------------------------------------------------------------------\n\t\t// 0. RESET MỐC AUTO RESPONSE TEST\n\t\t//---------------------------------------------------------------------\n\t\t// Frame Auto đầu tiên sau Reset sẽ lấy lại vị trí Conveyor hiện tại\n\t\t// làm mốc mới.\n\t\txAutoBaseCaptureValid := FALSE;\n\t\tlrAutoBaseCapturePosMM := 0.0;\n\t\tlrAutoMoveMM := 0.0;\n\t\tuiAutoFrameCount := 0;\n\t\n        //---------------------------------------------------------------------\n\t\t// 1. Hạ ResultReady / BlockReady trước khi Reset.\n\t\t//---------------------------------------------------------------------\n\t\tGVL.MODBUS[100] := WORD#16#0001;     // Chỉ giữ Heartbeat.\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// 2. Reset Adapter + Vision Object Source.\n\t\t//---------------------------------------------------------------------\n\t\tGVL.g_xResetTrackingObjectSourceA := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// 3. Reset FB_VisionModbusDriver Camera 1.\n\t\t// Đây là phần trước đó còn thiếu.\n\t\t//---------------------------------------------------------------------\n\t\tGVL.g_aVisionCommand[1].Reset := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// 4. Clear toàn bộ Tracking Queue.\n\t\t//---------------------------------------------------------------------\n\t\tGVL.g_xClearTrackingQueueA := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// 5. Xóa Result runtime cũ.\n\t\t//---------------------------------------------------------------------\n\t\tGVL.g_aVisionResult[1].Header.Valid := FALSE;\n\t\tGVL.g_aVisionResult[1].TrackObjectResult.Valid := FALSE;\n\t\tGVL.g_aVisionResult[1].TrackObjectResult.ObjectCount := 0;\n\t\n\t\tGVL.g_aVisionTrackingMultiResultA[1].Valid := FALSE;\n\t\tGVL.g_aVisionTrackingMultiResultA[1].TriggerID := 0;\n\n        uiTestState := 20;\n\n\n    //=========================================================================\n    // 20 - GIỮ RESET THÊM MỘT SCAN\n    //=========================================================================\n    20:\n        // Giữ ResultReady thấp trong toàn bộ thời gian Reset.\n\t\tGVL.MODBUS[100] := WORD#16#0001;\n\t\n\t\t// Giữ Adapter/ObjectSource Reset.\n\t\tGVL.g_xResetTrackingObjectSourceA := TRUE;\n\t\n\t\t// Giữ Modbus Driver Reset.\n\t\tGVL.g_aVisionCommand[1].Reset := TRUE;\n\n        uiTestState := 30;\n\n\n    //=========================================================================\n\t// 30 - HOLD RESET THÊM MỘT SCAN\n\t//-------------------------------------------------------------------------\n\t30:\n\t\tGVL.MODBUS[100] := WORD#16#0001;\n\t\tGVL.g_xResetTrackingObjectSourceA := TRUE;\n\t\tGVL.g_aVisionCommand[1].Reset := TRUE;\n\t\n\t\tuiTestState := 35;\n\t\t\n\t//=========================================================================\n\t// 35 - RELEASE RESET\n\t//-------------------------------------------------------------------------\n\t35:\n\t\t// Nhả toàn bộ Reset.\n\t\tGVL.g_xResetTrackingObjectSourceA := FALSE;\n\t\tGVL.g_aVisionCommand[1].Reset := FALSE;\n\t\tGVL.g_xClearTrackingQueueA := FALSE;\n\t\n\t\t// Vẫn giữ ResultReady thấp thêm một scan sau khi nhả Reset.\n\t\tGVL.MODBUS[100] := WORD#16#0001;\n\t\n\t\tuiTestState := 40;\n\n\n    //=========================================================================\n    // 40 - VERIFY RESET\n    //=========================================================================\n    40:\n        IF GVL.g_stTrackingQueue_A.ValidCount = 0 AND GVL.g_stTrackingQueue_A.NextObjectID = 0 THEN\n            uiTestState := 0;\n        END_IF;\n\n\n    //=========================================================================\n\t// 100 - CHỐT CAPTURE POSITION + CHUẨN BỊ DATA\n\t//=========================================================================\n\t100:\n\t\n\t\t//=========================================================================\n\t\t// AUTO RESPONSE MODE - TEST 3C\n\t\t//-------------------------------------------------------------------------\n\t\t// Frame 1:\n\t\t//      chỉ có A.\n\t\t//\n\t\t// Frame 2 trở đi:\n\t\t//      có A + B.\n\t\t//\n\t\t// A và B cách nhau cố định 60 mm theo X.\n\t\t// Cả hai cùng dịch theo Conveyor.\n\t\t//=========================================================================\n\t\tIF xAutoResponseTest THEN\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Chốt mốc Conveyor ở frame Auto đầu tiên.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tIF NOT xAutoBaseCaptureValid THEN\n\t\t\t\tlrAutoBaseCapturePosMM :=\n\t\t\t\t\tREAL_TO_LREAL(GVL.g_aVisionCommand[1].CaptureConveyorPos);\n\t\t\n\t\t\t\txAutoBaseCaptureValid := TRUE;\n\t\t\tEND_IF;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Quãng đường Conveyor đã chạy từ frame đầu.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tlrAutoMoveMM :=\n\t\t\t\tREAL_TO_LREAL(GVL.g_aVisionCommand[1].CaptureConveyorPos)\n\t\t\t\t- lrAutoBaseCapturePosMM;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// FRAME 1: chỉ có Object A.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tIF uiAutoFrameCount = 1 THEN\n\t\t\t\tuiTestObjectCount := 1;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// FRAME 2 trở đi: Camera nhìn thấy A + B.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tELSE\n\t\t\t\tuiTestObjectCount := 2;\n\t\t\tEND_IF;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// OBJECT A.\n\t\t\t//---------------------------------------------------------------------\n\t\t\trTestObjectAXMM :=\n\t\t\t\trAutoObjectABaseXMM\n\t\t\t\t+ LREAL_TO_REAL(lrAutoMoveMM);\n\t\t\n\t\t\trTestObjectAYMM := -20.0;\n\t\t\trTestObjectAADeg := 90.0;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// OBJECT B.\n\t\t\t// B luôn cách A +60 mm theo X.\n\t\t\t//---------------------------------------------------------------------\n\t\t\trTestObjectBXMM := rTestObjectAXMM + 60.0;\n\t\t\trTestObjectBYMM := -20.0;\n\t\t\trTestObjectBADeg := 90.0;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Capture Conveyor Position lấy đúng từ Background Trigger.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tdiTestCapturePos :=\n\t\t\t\tF_VisionRealToRawDINT(\n\t\t\t\t\tValue := GVL.g_aVisionCommand[1].CaptureConveyorPos,\n\t\t\t\t\tScale := GVL.g_aVisionConfig[1].PositionScale\n\t\t\t\t);\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// MANUAL MODE\n\t\t//---------------------------------------------------------------------\n\t\tELSE\n\t\n\t\t\tdiTestCapturePos :=\n\t\t\t\tF_VisionRealToRawDINT(\n\t\t\t\t\tValue := GVL.g_aConveyorRuntime[1].Status.PositionMM,\n\t\t\t\t\tScale := GVL.g_aVisionConfig[1].PositionScale\n\t\t\t\t);\n\t\n\t\tEND_IF;\n\t\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// CONVERT OBJECT A\n\t\t//---------------------------------------------------------------------\n\t\tdiTestObjectAXRaw := F_VisionRealToRawDINT(Value := rTestObjectAXMM, Scale := GVL.g_aVisionConfig[1].PositionScale);\n\t\tdiTestObjectAYRaw := F_VisionRealToRawDINT(Value := rTestObjectAYMM, Scale := GVL.g_aVisionConfig[1].PositionScale);\n\t\tdiTestObjectAARaw := F_VisionRealToRawDINT(Value := rTestObjectAADeg, Scale := GVL.g_aVisionConfig[1].AngleScale);\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// CONVERT OBJECT B\n\t\t//---------------------------------------------------------------------\n\t\tdiTestObjectBXRaw := F_VisionRealToRawDINT(Value := rTestObjectBXMM, Scale := GVL.g_aVisionConfig[1].PositionScale);\n\t\tdiTestObjectBYRaw := F_VisionRealToRawDINT(Value := rTestObjectBYMM, Scale := GVL.g_aVisionConfig[1].PositionScale);\n\t\tdiTestObjectBARaw := F_VisionRealToRawDINT(Value := rTestObjectBADeg, Scale := GVL.g_aVisionConfig[1].AngleScale);\n\t\n\t\tuiTestState := 110;\n\n\n    //=========================================================================\n    // 110 - TẠO FRAME VISION HOÀN CHỈNH\n    //-------------------------------------------------------------------------\n    // Ghi toàn bộ Header + Payload trước.\n    // Chỉ bật ResultReady / BlockReady sau khi data đã hoàn chỉnh.\n    //=========================================================================\n    110:\n\n        //---------------------------------------------------------------------\n        // Tạm hạ Ready trong khi đang ghi Frame mới.\n        //---------------------------------------------------------------------\n        GVL.MODBUS[100] := WORD#16#0001;\n\n\n        //---------------------------------------------------------------------\n        // RESULT HEADER\n        //---------------------------------------------------------------------\n        GVL.MODBUS[101] := 1;                                           // JobID.\n        GVL.MODBUS[102] := 70;                                          // VIS_APP_CONVEYOR_PICK.\n        GVL.MODBUS[103] := 80;                                          // VIS_DATA_TRACK_OBJECT.\n\n        GVL.MODBUS[104] := F_VisionUDINTLowWord(udiTestTriggerID);       // TriggerID LOW.\n        GVL.MODBUS[105] := F_VisionUDINTHighWord(udiTestTriggerID);      // TriggerID HIGH.\n\n        GVL.MODBUS[106] := 20;                                          // VIS_RESULT_OK.\n        GVL.MODBUS[107] := 0;                                           // ErrorCode.\n\n        GVL.MODBUS[108] := UINT_TO_WORD(uiTestObjectCount);              // Tổng Object trong Frame.\n        GVL.MODBUS[109] := 1;                                           // BlockCount.\n        GVL.MODBUS[110] := 1;                                           // BlockIndex.\n        GVL.MODBUS[111] := UINT_TO_WORD(uiTestObjectCount);              // Object trong Block này.\n\n        GVL.MODBUS[112] := 0;                                           // Checksum LOW.\n        GVL.MODBUS[113] := 0;                                           // Checksum HIGH.\n\n\n        //---------------------------------------------------------------------\n        // CAPTURE CONVEYOR POSITION\n        //---------------------------------------------------------------------\n        GVL.MODBUS[114] := F_VisionDINTLowWord(diTestCapturePos);\n        GVL.MODBUS[115] := F_VisionDINTHighWord(diTestCapturePos);\n\n\n        //---------------------------------------------------------------------\n        // OBJECT A - RECORD 1\n        // Register 132..140 = 9 WORD.\n        //---------------------------------------------------------------------\n        GVL.MODBUS[132] := F_VisionDINTLowWord(diTestObjectAXRaw);\n        GVL.MODBUS[133] := F_VisionDINTHighWord(diTestObjectAXRaw);\n\n        GVL.MODBUS[134] := F_VisionDINTLowWord(diTestObjectAYRaw);\n        GVL.MODBUS[135] := F_VisionDINTHighWord(diTestObjectAYRaw);\n\n        GVL.MODBUS[136] := F_VisionDINTLowWord(diTestObjectAARaw);\n        GVL.MODBUS[137] := F_VisionDINTHighWord(diTestObjectAARaw);\n\n        GVL.MODBUS[138] := WORD#16#0003;                                 // Bit0 Valid + Bit1 AngleValid.\n        GVL.MODBUS[139] := 95;                                          // Score.\n        GVL.MODBUS[140] := 1;                                           // ProductClassID.\n\n\n        //---------------------------------------------------------------------\n        // OBJECT B - RECORD 2\n        // Chỉ có hiệu lực khi uiTestObjectCount >= 2.\n        // Register 141..149 = 9 WORD.\n        //---------------------------------------------------------------------\n        IF uiTestObjectCount >= 2 THEN\n            GVL.MODBUS[141] := F_VisionDINTLowWord(diTestObjectBXRaw);\n            GVL.MODBUS[142] := F_VisionDINTHighWord(diTestObjectBXRaw);\n\n            GVL.MODBUS[143] := F_VisionDINTLowWord(diTestObjectBYRaw);\n            GVL.MODBUS[144] := F_VisionDINTHighWord(diTestObjectBYRaw);\n\n            GVL.MODBUS[145] := F_VisionDINTLowWord(diTestObjectBARaw);\n            GVL.MODBUS[146] := F_VisionDINTHighWord(diTestObjectBARaw);\n\n            GVL.MODBUS[147] := WORD#16#0003;                             // Bit0 Valid + Bit1 AngleValid.\n            GVL.MODBUS[148] := 96;                                      // Score.\n            GVL.MODBUS[149] := 1;                                       // ProductClassID.\n        ELSE\n            // Clear Record B để tránh nhìn nhầm dữ liệu cũ khi monitor.\n            GVL.MODBUS[141] := 0;\n            GVL.MODBUS[142] := 0;\n            GVL.MODBUS[143] := 0;\n            GVL.MODBUS[144] := 0;\n            GVL.MODBUS[145] := 0;\n            GVL.MODBUS[146] := 0;\n            GVL.MODBUS[147] := 0;\n            GVL.MODBUS[148] := 0;\n            GVL.MODBUS[149] := 0;\n        END_IF;\n\n\n        //---------------------------------------------------------------------\n        // DATA ĐÃ HOÀN CHỈNH -> BẬT RESULT READY + BLOCK READY.\n        //---------------------------------------------------------------------\n        GVL.MODBUS[100] := WORD#16#0049;\n\n        uiTestState := 130;\n\n\n    //=========================================================================\n    // 130 - GIỮ FRAME CHO TỚI KHI ADAPTER NHẬN\n    //-------------------------------------------------------------------------\n    // POU_MODBUS có thể ghi đè vùng Vision -> Robot ở scan sau.\n    // Vì vậy phải giữ lại toàn bộ Frame trong lúc chờ Adapter.\n    //=========================================================================\n    130:\n\n        //---------------------------------------------------------------------\n        // STATUS + HEADER\n        //---------------------------------------------------------------------\n        GVL.MODBUS[100] := WORD#16#0049;\n\n        GVL.MODBUS[101] := 1;\n        GVL.MODBUS[102] := 70;\n        GVL.MODBUS[103] := 80;\n\n        GVL.MODBUS[104] := F_VisionUDINTLowWord(udiTestTriggerID);\n        GVL.MODBUS[105] := F_VisionUDINTHighWord(udiTestTriggerID);\n\n        GVL.MODBUS[106] := 20;\n        GVL.MODBUS[107] := 0;\n\n        GVL.MODBUS[108] := UINT_TO_WORD(uiTestObjectCount);\n        GVL.MODBUS[109] := 1;\n        GVL.MODBUS[110] := 1;\n        GVL.MODBUS[111] := UINT_TO_WORD(uiTestObjectCount);\n\n        GVL.MODBUS[112] := 0;\n        GVL.MODBUS[113] := 0;\n\n\n        //---------------------------------------------------------------------\n        // CAPTURE POSITION\n        //---------------------------------------------------------------------\n        GVL.MODBUS[114] := F_VisionDINTLowWord(diTestCapturePos);\n        GVL.MODBUS[115] := F_VisionDINTHighWord(diTestCapturePos);\n\n\n        //---------------------------------------------------------------------\n        // OBJECT A\n        //---------------------------------------------------------------------\n        GVL.MODBUS[132] := F_VisionDINTLowWord(diTestObjectAXRaw);\n        GVL.MODBUS[133] := F_VisionDINTHighWord(diTestObjectAXRaw);\n\n        GVL.MODBUS[134] := F_VisionDINTLowWord(diTestObjectAYRaw);\n        GVL.MODBUS[135] := F_VisionDINTHighWord(diTestObjectAYRaw);\n\n        GVL.MODBUS[136] := F_VisionDINTLowWord(diTestObjectAARaw);\n        GVL.MODBUS[137] := F_VisionDINTHighWord(diTestObjectAARaw);\n\n        GVL.MODBUS[138] := WORD#16#0003;\n        GVL.MODBUS[139] := 95;\n        GVL.MODBUS[140] := 1;\n\n\n        //---------------------------------------------------------------------\n        // OBJECT B\n        //---------------------------------------------------------------------\n        IF uiTestObjectCount >= 2 THEN\n            GVL.MODBUS[141] := F_VisionDINTLowWord(diTestObjectBXRaw);\n            GVL.MODBUS[142] := F_VisionDINTHighWord(diTestObjectBXRaw);\n\n            GVL.MODBUS[143] := F_VisionDINTLowWord(diTestObjectBYRaw);\n            GVL.MODBUS[144] := F_VisionDINTHighWord(diTestObjectBYRaw);\n\n            GVL.MODBUS[145] := F_VisionDINTLowWord(diTestObjectBARaw);\n            GVL.MODBUS[146] := F_VisionDINTHighWord(diTestObjectBARaw);\n\n            GVL.MODBUS[147] := WORD#16#0003;\n            GVL.MODBUS[148] := 96;\n            GVL.MODBUS[149] := 1;\n        ELSE\n            GVL.MODBUS[141] := 0;\n            GVL.MODBUS[142] := 0;\n            GVL.MODBUS[143] := 0;\n            GVL.MODBUS[144] := 0;\n            GVL.MODBUS[145] := 0;\n            GVL.MODBUS[146] := 0;\n            GVL.MODBUS[147] := 0;\n            GVL.MODBUS[148] := 0;\n            GVL.MODBUS[149] := 0;\n        END_IF;\n\n\n        //---------------------------------------------------------------------\n        // CHỜ ADAPTER NHẬN ĐÚNG TRANSACTION.\n        //---------------------------------------------------------------------\n        IF GVL.g_aVisionTrackingMultiResultA[1].Valid AND GVL.g_aVisionTrackingMultiResultA[1].TriggerID = udiTestTriggerID THEN\n            uiTestState := 140;\n        END_IF;\n\n\n    //=========================================================================\n    // 140 - CHỜ OBJECT SOURCE XỬ LÝ FRAME\n    //-------------------------------------------------------------------------\n    // Không dùng NextObjectID > 0 để xác nhận nữa vì:\n    // - Frame có thể chỉ chứa Duplicate.\n    // - Duplicate không làm NextObjectID tăng.\n    //\n    // ResultAcceptedPulse xác nhận ObjectSource đã nhận transaction.\n    //=========================================================================\n    //=========================================================================\n\t// 140 - CHỜ OBJECT SOURCE XỬ LÝ ĐÚNG TRANSACTION\n\t//-------------------------------------------------------------------------\n\t// Không dùng ResultAcceptedPulse vì đây chỉ là Pulse 1 scan.\n\t// Dùng udiLastProcessedTriggerID để xác nhận Result hiện tại đã được\n\t// ObjectSource nhận và xử lý.\n\t//=========================================================================\n\t140:\n\t\t// Tiếp tục giữ ResultReady trong khi chờ ObjectSource.\n\t\tGVL.MODBUS[100] := WORD#16#0049;\n\t\n\t\t// ObjectSource đã nhận đúng TriggerID hiện tại.\n\t\tIF PRG_TrackingObjectSource_A.fbVisionSourceA[1].udiLastProcessedTriggerID = udiTestTriggerID THEN\n\t\t\tuiTestState := 150;\n\t\tEND_IF;\n\n\n    //=========================================================================\n    // 150 - TEST DONE\n    //-------------------------------------------------------------------------\n    // TriggerID tăng cho Frame kế tiếp.\n    // KHÔNG Clear Queue.\n    //=========================================================================\n    150:\n        // Hạ ResultReady + BlockReady.\n\t\t// Chỉ giữ Heartbeat.\n\t\tGVL.MODBUS[100] := WORD#16#0001;\n\t\n\t\tuiTestState := 160;\n\t//=========================================================================\n\t// 160 - GIỮ RELEASE ÍT NHẤT MỘT SCAN\n\t//-------------------------------------------------------------------------\n\t160:\n\t\tGVL.MODBUS[100] := WORD#16#0001;\n\t\n\t\tuiTestState := 170;\n\t//=========================================================================\n\t// 170 - HOÀN THÀNH FRAME\n\t//-------------------------------------------------------------------------\n\t170:\n// \t\t// Tăng TriggerID cho frame tiếp theo.\n// \t\tudiTestTriggerID := udiTestTriggerID + 1;\n// \t\tIF udiTestTriggerID = 0 THEN udiTestTriggerID := 1; END_IF;\n\t\t\n\t\tIF NOT xAutoResponseTest THEN\n\t\t\t// Manual Test:\n\t\t\t// chương trình test tự quản lý TriggerID.\n\t\t\tudiTestTriggerID := udiTestTriggerID + 1;\n\t\t\tIF udiTestTriggerID = 0 THEN udiTestTriggerID := 1; END_IF;\n\t\tEND_IF;\n\t\n\t\t// Auto Response:\n\t\t// Không tăng TriggerID tại đây.\n\t\t// TriggerID tiếp theo phải lấy từ Background Vision Trigger.\n\t\n\t\tuiTestState := 0;\t\n\t\t\n\nEND_CASE;","LineInfoPersistence":"(string)7893855d-0fd7-45de-a1b0-3cbc31adc0d7_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM PRG_VisionTrackingTest_A\n\nVAR\n    //=========================================================================\n    // TEST CONTROL\n    //=========================================================================\n    xResetTest : BOOL;\n    xStartTest : BOOL;\n\n    rtResetTest : R_TRIG;\n    rtStartTest : R_TRIG;\n\n    uiTestState : UINT := 0;\n    udiTestTriggerID : UDINT := 1;\n\n\n    //=========================================================================\n    // FRAME TEST\n    //-------------------------------------------------------------------------\n    // 1 = Frame chỉ có Object A.\n    // 2 = Frame có Object A + Object B.\n    //=========================================================================\n    uiTestObjectCount : UINT := 1;\n\n\n    //=========================================================================\n    // OBJECT A\n    //=========================================================================\n    rTestObjectAXMM : REAL := 100.0;\n    rTestObjectAYMM : REAL := -20.0;\n    rTestObjectAADeg : REAL := 90.0;\n\n    diTestObjectAXRaw : DINT;\n    diTestObjectAYRaw : DINT;\n    diTestObjectAARaw : DINT;\n\n\n    //=========================================================================\n    // OBJECT B\n    //=========================================================================\n    rTestObjectBXMM : REAL := 160.0;\n    rTestObjectBYMM : REAL := -20.0;\n    rTestObjectBADeg : REAL := 90.0;\n\n    diTestObjectBXRaw : DINT;\n    diTestObjectBYRaw : DINT;\n    diTestObjectBARaw : DINT;\n\n\n    //=========================================================================\n    // CAPTURE\n    //=========================================================================\n    diTestCapturePos : DINT;\n\trTestMoveMM : REAL := 0.0;\n\tuiTestFrame : UINT := 1;\n\t\n\txAutoResponseTest : BOOL := FALSE;\n\tudiLastAutoCommandTriggerID : UDINT := 0;\n\t\n\t//=============================================================================\n\t// AUTO RESPONSE POSITION SIMULATION\n\t//=============================================================================\n\txAutoBaseCaptureValid : BOOL := FALSE;\n\tlrAutoBaseCapturePosMM : LREAL := 0.0;\n\tlrAutoMoveMM : LREAL := 0.0;\n\t\n\trAutoObjectABaseXMM : REAL := 100.0;\n\trAutoObjectBBaseXMM : REAL := 160.0;\n\n\tuiAutoFrameCount : UINT := 0;\nEND_VAR","LineInfoPersistence":"(string)7893855d-0fd7-45de-a1b0-3cbc31adc0d7_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)658","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}