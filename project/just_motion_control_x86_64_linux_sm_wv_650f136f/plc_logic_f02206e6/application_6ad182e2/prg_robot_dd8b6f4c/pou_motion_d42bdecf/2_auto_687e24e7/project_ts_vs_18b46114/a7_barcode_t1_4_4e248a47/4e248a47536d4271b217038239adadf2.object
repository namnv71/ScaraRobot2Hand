{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4e248a47-536d-4271-b217-038239adadf2","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)A7_Barcode_T1_4","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//Project_4_Delay_A7(PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Barcode_Vs)*100);\nT_Wait_Trigger_Bar_VS( PT := TO_TIME(GVL.Pro4_.ST_MC.Delay_Trigger_Barcode_Vs)*100);\nIF Barcode_A4_Run THEN\n\tCASE PRO_A4_[7] OF\n\t\t0: // RESET\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\t\t\t\n\t\t\t\tcount_Vs := 0; // namnv\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10;\n\t\t10: // XY barcode\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 3, XYR_CONST := FALSE, Z_CONST:= TRUE); // pos 4 barcode\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t20: // Barcode Z\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 3, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos 4 barcode\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA3_Run_L\t:= FALSE;\n\t\t\t\tA3_Run_P :=FALSE;\t \t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P :=FALSE;\t\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10;\t\t \n\t\t\tEND_IF;\n\t\n\t\t30: // Trigger Barcode\n\t\t\t// Ontrigger\n\t\t\tCASE D_Barcode_Vs OF\n\t\t\t\t0:\n\t\t\t\t\tIF GVL.Pro4_.ST_MC.Mode_Skip_Barcode_vs THEN\n\t\t\t\t\t\tD_Barcode_Vs:= 30;\n\t\t\t\t\tELSE\n\t\t\t\t\t\t\t//GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off := 1;\n\t\t\t\t\t\t// namnv\n\t\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off := TRUE;\n\t\t\t\t\t\t//Project_4_Delay_A7.IN := TRUE;\n\t\t\t\t\t\t//IF GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off = 1 AND Project_4_Delay_A7.q THEN\n\t\t\t\t\t\t// namnv\n\t\t\t\t\t\t//IF GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off AND Project_4_Delay_A7.q THEN\n\t\t\t\t\t\tIF GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off AND GVL.Pro4_.Signal_In.T_Vs_detect.Q THEN\n\t\t\t\t\t\t\tD_Barcode_Vs := D_Barcode_Vs +10;\n\t\t\t\t\t\tEND_IF\t\n\t\t\t\t\tEND_IF\t\n\t\t\t\t10:\n\t\t\t\t\t//Project_4_Delay_A7.IN := FALSE;\n\t\t\t\t\t//GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off := 0;\n\t\t\t\t\t// namnv\n\t\t\t\t\tGVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off := FALSE;\n\t\t\t\t\t//IF GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off = 0 THEN\n\t\t\t\t\tIF NOT GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off THEN\n\t\t\t\t\t\tcount_Vs := count_Vs +1;\n\t\t\t\t\t\tD_Barcode_Vs := D_Barcode_Vs +10;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_VS.IN := TRUE;\n\t\t\t\t\tEND_IF\n\t\t\t\t20:\n\t\t\t\t\tIF GVL.Pro4_.Signal_In.T_Vs_Result_Scanner.Q OR  GVL.X[30] THEN\n\t\t\t\t\t\tD_Barcode_Vs := D_Barcode_Vs +10;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_VS.IN := FALSE;\n\t\t\t\t\tELSIF NOT GVL.Pro4_.Signal_In.T_Ts_Result_Scanner.Q AND NOT GVL.X[30]  AND count_Vs <= 5 AND T_Wait_Trigger_Bar_VS.Q THEN\n\t\t\t\t\t\tD_Barcode_Vs := 0;\n\t\t\t\t\t\tT_Wait_Trigger_Bar_VS.IN := FALSE;\n\t\t\t\t\tEND_IF\n\t\t\t\t30:\n\t\t\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode_VS := FALSE;\n\t\t\t\t\t// ok barcode vs\n\t\t\tEND_CASE;\n\t\t\tIF count_Vs > 5 AND (GVL.X[8] OR gvl.Pro4_.Process.Re_Trigger_Barcode_Vs) THEN\n\t\t\t\tcount_Vs := 0;\n\t\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode_VS := FALSE;\n\t\t\tEND_IF\n\t\t\t\n\t\t\tIF count_Vs > 5 AND D_Barcode_Vs = 20 AND NOT GVL.Pro4_.Auto.Alarm_Not_barcode_VS  THEN\n\t\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode_VS := TRUE;\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10; \t\n\t\t\tEND_IF\n\t\t\t\n\t\t\tIF D_Barcode_Vs = 30 AND A_Allow_NextStep  THEN\n\t\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode_VS := FALSE;\n\t\t\t\tcount_Vs := 0;\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10; \t\n\t\t\tEND_IF;\n\t\t\t\n\t\t40: // Z WAIT\n\t\t\tD_Barcode_vs := 0;\n\t\t\t\n\t\t\tM_CHOOSE_POS(DATA := 0, ID := 0, XYR_CONST := TRUE, Z_CONST:= FALSE); // pos wait\n\t\t\tIF NOT A4_Run_P THEN\n\t\t\t\tA_Comp := FALSE;\n\t\t\t\tA4_Run_P := TRUE;\n\t\t\tEND_IF\t\t\n\t\t\tIF MOVP_A.Error OR MOVL_A.Error THEN\n\t\t\t\tA4_Run_L\t:= FALSE;\n\t\t\t\tA4_Run_P \t:= FALSE;\t \n\t\t\tEND_IF;\t\t\t\t\n\t\t\tIF A_Comp AND A4_Run_P AND A_Allow_NextStep THEN\n\t\t\t\tA4_Run_L\t := FALSE;\n\t\t\t\tA4_Run_P\t := FALSE;\n\t\t\t\tA_Comp\t\t := FALSE;\n\t\t\t\tPRO_A4_[7] := PRO_A4_[7] + 10;\t\t \n\t\t\tEND_IF;\t\t\n\t\t50:\n\t\t\t// GVL.Pro4_.Process.DATA_TOOL_A1_IN := 3;\n\t\t\t// namnv - Doc barcode xong cho du lieu A_T1 = 2 (OK)\n\t\t\tIF (GVL.Pro4_.Auto.Alarm_Not_barcode_VS) THEN\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 2;\n\t\t\tELSE\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN := 2;\n\t\t\tEND_IF\n\t\t\tGVL.Pro4_.Auto.Alarm_Not_barcode_VS := FALSE;\n\t\t\t//GVL.Pro4_.Process.DATA_TOOL_A1_IN := 2;\n\t\t\tBarcode_A4_Finish := TRUE;\n\t\t\t\n\t\t\t\n\tEND_CASE\nELSE\n\tPRO_A4_[7] := 0;\nEND_IF","LineInfoPersistence":"(string)4e248a47-536d-4271-b217-038239adadf2_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)135"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}