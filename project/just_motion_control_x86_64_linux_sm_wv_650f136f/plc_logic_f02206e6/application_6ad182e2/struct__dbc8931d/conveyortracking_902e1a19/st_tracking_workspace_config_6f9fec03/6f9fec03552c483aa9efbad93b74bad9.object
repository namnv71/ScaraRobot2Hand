{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)6f9fec03-552c-483a-a9ef-bad93b74bad9","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_TRACKING_WORKSPACE_CONFIG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_TRACKING_WORKSPACE_CONFIG :\nSTRUCT\n\t// Vị trí bắt đầu vùng thu nhận object, đơn vị mm.\n    AcquireZoneStartMM : REAL;\n\n    // Vị trí bắt đầu vùng được phép gắp, đơn vị mm.\n    PickZoneStartMM : REAL;\n\n    // Vị trí kết thúc vùng được phép gắp, đơn vị mm.\n    PickZoneEndMM : REAL;\n\n    // Vượt vị trí này mà chưa VacuumOK thì phải bỏ object active.\n    AbortPositionMM : REAL;\n\n    // Vượt vị trí này thì object chưa active bị EXPIRED.\n    ExpirePositionMM : REAL;\n\n//     // Khoảng cách tối thiểu mong muốn giữa hai object, đơn vị mm.\n//     MinimumObjectSpacingMM : REAL;\n\n    // Thời gian tối thiểu robot cần để thực hiện thao tác gắp, đơn vị giây.\n    MinimumPickTimeSec : REAL;\n\n    // Thời gian dự phòng an toàn, đơn vị giây.\n    SafetyMarginTimeSec : REAL;\nEND_STRUCT\nEND_TYPE\n","LineInfoPersistence":"(string)6f9fec03-552c-483a-a9ef-bad93b74bad9_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)28"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}