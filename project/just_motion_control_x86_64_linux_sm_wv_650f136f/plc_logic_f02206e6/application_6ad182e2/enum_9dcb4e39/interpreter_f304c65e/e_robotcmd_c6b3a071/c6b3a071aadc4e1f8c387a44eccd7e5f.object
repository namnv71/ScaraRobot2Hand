{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c6b3a071-aadc-4e1f-8c38-7a44eccd7e5f","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)E_RobotCmd","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)f304c65e-3c5e-4fcb-be56-c4ce4fd9c605"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_RobotCmd :\n(\n\tCMD_NOP := 0,\n    CMD_MovP := 1, // Chay PTP\n    CMD_MovL := 2, // Chay Linear\n\tCMD_MovC := 3, // Chay theo cung tron\n\tCMD_Set_Speed := 4, // Set Toc do\n\tCMD_Set_Fac_Speed := 5, // Set HS toc do\n    CMD_DO_ON := 10, // Output Digital ON\n    CMD_DO_OFF := 11, // Output Digital OFF\n\tCMD_DO_TOGGLE := 12, // Output Digital Reverse\n    CMD_WAIT_IN := 13, // Wait Input Signal\n    CMD_WAIT := 14, // Wait Condition\n\tCMD_Delay := 15, // Delay Time\n\tCMD_Timer_Start := 16, // Timer No\n\tCMD_Timer_Wait := 17, // Timer No\n    CMD_IF := 20, // If loop with condition No\n\tCMD_IF_IN := 21, // If loop with Input No\n\tCMD_IF_VAR := 22, // If loop with Variable No\n\tCMD_IF_REG := 23, // If loop with Reg No\n    CMD_ELSE := 24, // Else cmd\n\tCMD_END_IF := 25, // End of if loop\n    CMD_JUMP := 26, // Jump another step\n    CMD_CALL := 27, // Call another program\n    CMD_RETURN := 28, // Out off Loop\n\tCMD_WHILE := 29, // While loop with condition No\n\tCMD_WHILE_IN := 30, // While loop with Input No\n\tCMD_WHILE_REG := 31, // While loop with Reg No\n\tCMD_END_WHILE := 32, // End of While loop\n    CMD_VISION_TRIGGER := 35, // Trigger VS System\n    CMD_VISION_SET_POINT := 36, // Wait Result VS System\n\tCMD_VISION_PICK := 37, \n\tCMD_VISION_CHECK := 38,\n    CMD_TRACK_ON := 45, // On Conveyor Tracking\n    CMD_TRACK_OFF := 46, // Off Conveyor Tracking\n\tCMD_TRACK_PICK := 47, \n\tCMD_TRACK_PLACE := 48,\n\tCMD_TOOL_RELEASE := 49, // Nha tool da gap\n\tCMD_CONV_PICK := 50,\n\tCMD_REG_SET := 60,\n\tCMD_REG_ADD := 61,\n\tCMD_REG_SUB := 62,\n\tCMD_REG_MUL := 63,\n\tCMD_REG_DIV := 64,\n\tCMD_REG_MOD := 65,\n\t\n\tCMD_VAR_SET := 70,\n\tCMD_VAR_ADD := 71,\n\tCMD_VAR_SUB := 72,\n\tCMD_VAR_MUL := 73,\n\tCMD_VAR_DIV := 74,\n\tCMD_VAR_MOD := 75,\n\t\n\t\n\tCMD_MB_REG_SET         := 77,   // Ghi 1 thanh ghi MODBUS, INT16 signed\n\tCMD_MB_BIT_SET         := 78,   // Set/Reset 1 bit của thanh ghi MODBUS\n\tCMD_MB_REG_READ        := 79,   // Doc 1 thanh ghi MODBUS, INT16 signed\n\t\n\tCMD_POINT_COPY         := 82,   // Point đích = Point nguồn\n\tCMD_POINT_ADD          := 83,   // Point đích = Point gốc + Point offset\n\tCMD_POINT_SUB          := 84,   // Point đích = Point gốc - Point offset\n\tCMD_POINT_ADD_VALUE    := 85,   // Point đích = Point gốc + X/Y/Z/R nhập trực tiếp\n\tCMD_POINT_ADD_REG      := 86,   // Point đích = Point gốc + A_Reg/B_Reg X/Y/Z/R\n\tCMD_POINT_ADD_MB_REG   := 87,   // Point đích = Point gốc + MODBUS X/Y/Z/R\n\n\n    CMD_END := 999\n);\nEND_TYPE\n","LineInfoPersistence":"(string)c6b3a071-aadc-4e1f-8c38-7a44eccd7e5f_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)72"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}