{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)583f7b3d-4fc7-4681-b37e-b1d272f834de","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)POU_HOMING","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// namnv3103\n// TORQUE_LIMIT_A0:= 3600;\n// TORQUE_LIMIT_A1:= 2500;\n// TORQUE_LIMIT_A2:= 2000;\n// TORQUE_LIMIT_A3:= 2000;\n// \n// TORQUE_LIMIT_B0:= 3600;\n// TORQUE_LIMIT_B1:= 2500;\n// TORQUE_LIMIT_B2:= 2000;\n// TORQUE_LIMIT_B3:= 2000;\n\nTORQUE_LIMIT_A0:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_A0;\nTORQUE_LIMIT_A1:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_A1;\nTORQUE_LIMIT_A2:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_A2;\nTORQUE_LIMIT_A3:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_A3;\n\nTORQUE_LIMIT_B0:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_B0;\nTORQUE_LIMIT_B1:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_B1;\nTORQUE_LIMIT_B2:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_B2;\nTORQUE_LIMIT_B3:= GVL.Pro4_.Auto.TORQUE_LIMIT_SET_B3;\n\nIF GVL.Reset_Torque_Max THEN\n\tGVL.Torque_Max.A0 := 0;\n\tGVL.Torque_Max.A1 := 0;\n\tGVL.Torque_Max.A2 := 0;\n\tGVL.Torque_Max.A3 := 0;\n\tGVL.Torque_Max.B0 := 0;\n\tGVL.Torque_Max.B1 := 0;\n\tGVL.Torque_Max.B2 := 0;\n\tGVL.Torque_Max.B3 := 0;\n\tTORQUE_DIFF_MAX_A0 := 0;\n\tTORQUE_DIFF_MAX_A1 := 0;\n\tTORQUE_DIFF_MAX_A2 := 0;\n\tTORQUE_DIFF_MAX_A3 := 0;\n\tTORQUE_DIFF_MAX_B0 := 0;\n\tTORQUE_DIFF_MAX_B1 := 0;\n\tTORQUE_DIFF_MAX_B2 := 0;\n\tTORQUE_DIFF_MAX_B3 := 0;\n\tVEL_MAX_A0 := 0;\n\tVEL_MAX_A1 := 0;\n\tVEL_MAX_A2 := 0;\n\tVEL_MAX_A3 := 0;\n\tVEL_MAX_B0 := 0;\n\tVEL_MAX_B1 := 0;\n\tVEL_MAX_B2 := 0;\n\tVEL_MAX_B3 := 0;\n\tVEL_SET_MAX_A0 := 0;\nEND_IF\nGVL.Torque_Max.A0 := MAX(ABS(TORQUE_ACT_A0), GVL.Torque_Max.A0);\nGVL.Torque_Max.A1 := MAX(ABS(TORQUE_ACT_A1), GVL.Torque_Max.A1);\nGVL.Torque_Max.A2 := MAX(ABS(TORQUE_ACT_A2), GVL.Torque_Max.A2);\nGVL.Torque_Max.A3 := MAX(ABS(TORQUE_ACT_A3), GVL.Torque_Max.A3);\n\nGVL.Torque_Max.B0 := MAX(ABS(TORQUE_ACT_B0), GVL.Torque_Max.B0);\nGVL.Torque_Max.B1 := MAX(ABS(TORQUE_ACT_B1), GVL.Torque_Max.B1);\nGVL.Torque_Max.B2 := MAX(ABS(TORQUE_ACT_B2), GVL.Torque_Max.B2);\nGVL.Torque_Max.B3 := MAX(ABS(TORQUE_ACT_B3), GVL.Torque_Max.B3);\n\n// IF (ABS(TORQUE_ACT_A0) > TORQUE_LIMIT_A0) OR (ABS(TORQUE_ACT_A1) > TORQUE_LIMIT_A1) OR (ABS(TORQUE_ACT_A2) > TORQUE_LIMIT_A2) OR (ABS(TORQUE_ACT_A3) > TORQUE_LIMIT_A3) THEN\n// \tBitStop_Tor_A := TRUE;\n// ELSE\n// \tBitStop_Tor_A := FALSE;\n// END_IF\n// \n// IF (ABS(TORQUE_ACT_B0) > TORQUE_LIMIT_B0) OR (ABS(TORQUE_ACT_B1) > TORQUE_LIMIT_B1) OR (ABS(TORQUE_ACT_B2) > TORQUE_LIMIT_B2) OR (ABS(TORQUE_ACT_B3) > TORQUE_LIMIT_B3) THEN\n// \tBitStop_Tor_B := TRUE;\n// ELSE\n// \tBitStop_Tor_B := FALSE;\n// END_IF\n\n//namnv0804\n\nVEL_MAX_A0 := MAX(VEL_MAX_A0, ABS(VEL_ACT_A0));\nVEL_MAX_A1 := MAX(VEL_MAX_A1, ABS(VEL_ACT_A1));\nVEL_MAX_A2 := MAX(VEL_MAX_A2, ABS(VEL_ACT_A2));\nVEL_MAX_A3 := MAX(VEL_MAX_A3, ABS(VEL_ACT_A3));\nVEL_MAX_B0 := MAX(VEL_MAX_B0, ABS(VEL_ACT_B0));\nVEL_MAX_B1 := MAX(VEL_MAX_B1, ABS(VEL_ACT_B1));\nVEL_MAX_B2 := MAX(VEL_MAX_B2, ABS(VEL_ACT_B2));\nVEL_MAX_B3 := MAX(VEL_MAX_B3, ABS(VEL_ACT_B3));\nVEL_SET_MAX_A0 := MAX(VEL_SET_MAX_A0, ABS(VEL_SET_A0));\nVel_Act_Per_Vel_Set_A0 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_A0) * 100.0) / DINT_TO_LREAL(VEL_SET_A0)\n);\nVel_Act_Per_Vel_Set_A1 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_A1) * 100.0) / DINT_TO_LREAL(VEL_SET_A1)\n);\nVel_Act_Per_Vel_Set_A2 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_A2) * 100.0) / DINT_TO_LREAL(VEL_SET_A2)\n);\nVel_Act_Per_Vel_Set_A3 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_A3) * 100.0) / DINT_TO_LREAL(VEL_SET_A3)\n);\nVel_Act_Per_Vel_Set_B0 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_B0) * 100.0) / DINT_TO_LREAL(VEL_SET_B0)\n);\nVel_Act_Per_Vel_Set_B1 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_B1) * 100.0) / DINT_TO_LREAL(VEL_SET_B1)\n);\nVel_Act_Per_Vel_Set_B2 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_B2) * 100.0) / DINT_TO_LREAL(VEL_SET_B2)\n);\nVel_Act_Per_Vel_Set_B3 := LREAL_TO_INT(\n    (DINT_TO_LREAL(VEL_ACT_B3) * 100.0) / DINT_TO_LREAL(VEL_SET_B3)\n);\n\nTorqueDiff_RB_A0(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_A0,\n\tPercentVel := Vel_Act_Per_Vel_Set_A0,\n\tThreshold := 400,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_A1(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_A1,\n\tPercentVel := Vel_Act_Per_Vel_Set_A1,\n\tThreshold := 500,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_A2(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_A2,\n\tPercentVel := Vel_Act_Per_Vel_Set_A2,\n\tThreshold := 500,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_A3(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_A3,\n\tPercentVel := Vel_Act_Per_Vel_Set_A3,\n\tThreshold := 100,\n\tCycleTime_s := 0.01\n);\n\nTorqueDiff_RB_B0(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_B0,\n\tPercentVel := Vel_Act_Per_Vel_Set_B0,\n\tThreshold := 500,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_B1(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_B1,\n\tPercentVel := Vel_Act_Per_Vel_Set_B1,\n\tThreshold := 500,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_B2(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_B2,\n\tPercentVel := Vel_Act_Per_Vel_Set_B2,\n\tThreshold := 500,\n\tCycleTime_s := 0.01\n);\nTorqueDiff_RB_B3(\n\tEnable := TRUE,\n\tTorqueNow := TORQUE_ACT_B3,\n\tPercentVel := Vel_Act_Per_Vel_Set_B3,\n\tThreshold := 100,\n\tCycleTime_s := 0.01\n);\n\nTORQUE_DIFF_MAX_A0 := MAX(TORQUE_DIFF_MAX_A0, TorqueDiff_RB_A0.AbsDeltaTorque);\nTORQUE_DIFF_MAX_A1 := MAX(TORQUE_DIFF_MAX_A1, TorqueDiff_RB_A1.AbsDeltaTorque);\nTORQUE_DIFF_MAX_A2 := MAX(TORQUE_DIFF_MAX_A2, TorqueDiff_RB_A2.AbsDeltaTorque);\nTORQUE_DIFF_MAX_A3 := MAX(TORQUE_DIFF_MAX_A3, TorqueDiff_RB_A3.AbsDeltaTorque);\nTORQUE_DIFF_MAX_B0 := MAX(TORQUE_DIFF_MAX_B0, TorqueDiff_RB_B0.AbsDeltaTorque);\nTORQUE_DIFF_MAX_B1 := MAX(TORQUE_DIFF_MAX_B1, TorqueDiff_RB_B1.AbsDeltaTorque);\nTORQUE_DIFF_MAX_B2 := MAX(TORQUE_DIFF_MAX_B2, TorqueDiff_RB_B2.AbsDeltaTorque);\nTORQUE_DIFF_MAX_B3 := MAX(TORQUE_DIFF_MAX_B3, TorqueDiff_RB_B3.AbsDeltaTorque);\n\nIF (TorqueDiff_RB_A0.Alarm) OR (TorqueDiff_RB_A1.Alarm) OR (TorqueDiff_RB_A2.Alarm) OR (TorqueDiff_RB_A3.Alarm) THEN\n\tBitStop_TorDiff_A := TRUE;\nELSE\n\tBitStop_TorDiff_A := FALSE;\nEND_IF\n\nIF (TorqueDiff_RB_B0.Alarm) OR (TorqueDiff_RB_B1.Alarm) OR (TorqueDiff_RB_B2.Alarm) OR (TorqueDiff_RB_B3.Alarm) THEN\n\tBitStop_TorDiff_B := TRUE;\nELSE\n\tBitStop_TorDiff_B := FALSE;\nEND_IF\n\n\nACT_HOMING();\nACT_STOP();\nACT_Home_Z();\nACT_SETLIMIT();\nACT_ERROR(); //namnv0304\n\n//Origin_Pos_A.c.X := 550;\n//Origin_Pos_B.c.X := 0;\n//Origin_Pos_B.a.a0 := 0;","LineInfoPersistence":"(string)583f7b3d-4fc7-4681-b37e-b1d272f834de_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM POU_HOMING\nVAR\n\tMC_GroupStop_RBA, MC_GroupStop_RBB : MC_GroupStop;\n\tMC_Stop_A0: MC_Stop;\n\tMC_Stop_A1: MC_Stop;\n\tMC_Stop_A2: MC_Stop;\n\tMC_Stop_A3: MC_Stop;\n\tMC_GroupSetPosition_RB1: MC_GroupSetPosition;\n\tOrigin_Pos_A: SM3_Robotics.SMC_POS_REF;\n\tMC_GroupSetPosition_RB2: MC_GroupSetPosition;\n\tOrigin_Pos_B: SM3_Robotics.SMC_POS_REF;\n\tMC_Stop_B0: MC_Stop;\n\tMC_Stop_B2: MC_Stop;\n\tMC_Stop_B1: MC_Stop;\n\tMC_Stop_B3: MC_Stop;\n\tMC_Home_A0: MC_Home;\n\tMC_Home_A1: MC_Home;\n\tMC_Home_A2: MC_Home;\n\tMC_Home_A3: MC_Home;\n\tMC_Home_B0: MC_Home;\n\tMC_Home_B1: MC_Home;\n\tMC_Home_B2: MC_Home;\n\tMC_Home_B3: MC_Home;\n\tMC_Power_za: MC_Power;\n\tMC_Jog_za: MC_Jog;\n\tMC_Power_ZB: MC_Power;\n\tMC_Jog_ZB: MC_Jog;\n\tSMC_SetSoftwareLimits_A0: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_A1: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_A2: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_A3: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_B0: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_B1: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_B2: SMC_SetSoftwareLimits;\n\tSMC_SetSoftwareLimits_B3: SMC_SetSoftwareLimits;\n\t\n\tMC_ReadError_A0: MC_ReadAxisError;\n\tMC_ReadError_A1: MC_ReadAxisError;\n\tMC_ReadError_A2: MC_ReadAxisError;\n\tMC_ReadError_A3: MC_ReadAxisError;\n\tMC_ReadError_B0: MC_ReadAxisError;\n\tMC_ReadError_B1: MC_ReadAxisError;\n\tMC_ReadError_B2: MC_ReadAxisError;\n\tMC_ReadError_B3: MC_ReadAxisError;\n\t\nEND_VAR\nVAR\n\tBit_Stop, BitStop_Tor_A, BitStop_Tor_B, BitStop_TorDiff_A, BitStop_TorDiff_B, BitStop_Error_Axis_RB_A, BitStop_Error_Axis_RB_B : BOOL;\t\n\t//EMG AT %IX1.1 : BOOL;\n\t\n\t// Home Z \n\tD_HomeZ_RB1, D_HomeZ_RB2 : INT;\n\t//SS_DOG_Z1 AT %IX1.3 : BOOL;\n\t//SS_DOG_Z2 AT %IX1.2 : BOOL;\n\tR_TRIG_Z1, R_TRIG_Z2 : R_TRIG;\n\tHoming_Z1, Homing_Z2, Home_Done_Z1, Home_Done_Z2 : BOOL;\nEND_VAR\n\nVAR // SETLMIT\n\tENABLE_POWER_A,DISABLE_POWER_A, ENABLE_POWER_B, DISABLE_POWER_B : BYTE;\n\t\nEND_VAR\nVAR\n\tTORQUE_ACT_A0 AT %IW40 : INT;\n\tTORQUE_ACT_A1 AT %IW48 : INT;\n\tTORQUE_ACT_A2 AT %IW56 : INT;\n\tTORQUE_ACT_A3 AT %IW64 : INT;\n\tTORQUE_ACT_B0 AT %IW72 : INT;\n\tTORQUE_ACT_B1 AT %IW80 : INT;\n\tTORQUE_ACT_B2 AT %IW88 : INT;\n\tTORQUE_ACT_B3 AT %IW96 : INT;\n\tTORQUE_LIMIT_A0, TORQUE_LIMIT_A1, TORQUE_LIMIT_A2, TORQUE_LIMIT_A3 : INT;\n\tTORQUE_LIMIT_B0, TORQUE_LIMIT_B1, TORQUE_LIMIT_B2, TORQUE_LIMIT_B3 : INT;\n\t\nEND_VAR\n\n//namnv0804\nVAR\n\tVEL_ACT_A0 AT %ID19 : DINT;\n\tVEL_ACT_A1 AT %ID23 : DINT;\n\tVEL_ACT_A2 AT %ID27 : DINT;\n\tVEL_ACT_A3 AT %ID31 : DINT;\n\tVEL_ACT_B0 AT %ID35 : DINT;\n\tVEL_ACT_B1 AT %ID39 : DINT;\n\tVEL_ACT_B2 AT %ID43 : DINT;\n\tVEL_ACT_B3 AT %ID47 : DINT;\n\t\n\tVEL_SET_A0 AT %QD118 : DINT;\n\tVEL_SET_A1 AT %QD122 : DINT;\n\tVEL_SET_A2 AT %QD126 : DINT;\n\tVEL_SET_A3 AT %QD130 : DINT;\n\tVEL_SET_B0 AT %QD134 : DINT;\n\tVEL_SET_B1 AT %QD138 : DINT;\n\tVEL_SET_B2 AT %QD142 : DINT;\n\tVEL_SET_B3 AT %QD146 : DINT;\n\t\n\tTorqueDiff_RB_A0, TorqueDiff_RB_A1, TorqueDiff_RB_A2, TorqueDiff_RB_A3 : FB_TorqueDiff;\n\tTorqueDiff_RB_B0, TorqueDiff_RB_B1, TorqueDiff_RB_B2, TorqueDiff_RB_B3 : FB_TorqueDiff;\n\tTORQUE_DIFF_LIMIT_B0, TORQUE_DIFF_LIMIT_B1, TORQUE_DIFF_LIMIT_B2, TORQUE_DIFF_LIMIT_B3 : INT;\n\tTORQUE_DIFF_MAX_A0, TORQUE_DIFF_MAX_A1, TORQUE_DIFF_MAX_A2, TORQUE_DIFF_MAX_A3 : INT;\n\tTORQUE_DIFF_MAX_B0, TORQUE_DIFF_MAX_B1, TORQUE_DIFF_MAX_B2, TORQUE_DIFF_MAX_B3 : INT;\n\tTORQUE_DIFF_MIN_A0, TORQUE_DIFF_MIN_A1, TORQUE_DIFF_MIN_A2, TORQUE_DIFF_MIN_A3 : INT;\n\tTORQUE_DIFF_MIN_B0, TORQUE_DIFF_MIN_B1, TORQUE_DIFF_MIN_B2, TORQUE_DIFF_MIN_B3 : INT;\n\t\n\tVEL_MAX_A0, VEL_MAX_A1, VEL_MAX_A2, VEL_MAX_A3 : DINT;\n\tVEL_MAX_B0, VEL_MAX_B1, VEL_MAX_B2, VEL_MAX_B3 : DINT;\n\t\n\tVEL_SET_MAX_A0, VEL_SET_MAX_A1, VEL_SET_MAX_A2, VEL_SET_MAX_A3 : DINT;\n\tVEL_SET_MAX_B0, VEL_SET_MAX_B1, VEL_SET_MAX_B2, VEL_SET_MAX_B3 : DINT;\n\tVel_Act_Per_Vel_Set_A0, Vel_Act_Per_Vel_Set_A1, Vel_Act_Per_Vel_Set_A2, Vel_Act_Per_Vel_Set_A3: INT;\n\tVel_Act_Per_Vel_Set_B0, Vel_Act_Per_Vel_Set_B1, Vel_Act_Per_Vel_Set_B2, Vel_Act_Per_Vel_Set_B3: INT;\n\tTorque_arr_A0 : ARRAY[0..20000] OF INT;\n\ti_A0 : INT := 0;\nEND_VAR","LineInfoPersistence":"(string)583f7b3d-4fc7-4681-b37e-b1d272f834de_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)309","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}