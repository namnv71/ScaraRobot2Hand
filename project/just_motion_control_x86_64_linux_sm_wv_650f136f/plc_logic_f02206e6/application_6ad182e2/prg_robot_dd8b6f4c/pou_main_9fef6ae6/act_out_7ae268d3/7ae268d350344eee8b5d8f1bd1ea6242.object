{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)7ae268d3-5034-4eee-8b5d-8f1bd1ea6242","ParentGuid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","Name":"(string)ACT_Out","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// Share all robot\n// green\nGVL.Y[2] := GVL.HMI_MAIN.yStart AND NOT GVL.HMI_MAIN.yStop AND NOT GVL.HMI_MAIN.yLamp_Yellow AND NOT POU_MOTION.HeavyAlarm ;\n// red\nGVL.Y[0] := GVL.HMI_MAIN.yStop AND NOT GVL.HMI_MAIN.yStart OR POU_MOTION.HeavyAlarm;\n// yellow\nGVL.Y[1] := GVL.HMI_MAIN.yLamp_Yellow OR POU_MOTION.LightAlarm;\n// buzz\nGVL.Y[3] := GVL.HMI_MAIN.yBuzz;\n\n// Tool 1 A\nGVL.Y[4] := GVL.RB_A_.Tool_1 OR GVL.Y[4];\n// Tool 2 A\nGVL.Y[5] := GVL.RB_A_.Tool_2;\n// Tool 1 B\t\t\t\nGVL.Y[6] := GVL.RB_B_.Tool_1;\n// Tool 2 B\nGVL.Y[7] := GVL.RB_B_.Tool_2;\n\n// Project 3\nIF GVL.ProjectAndModel.Project_No_Current = 3 THEN\n\t\n\t// PRoject 4\n\tIF GVL.RB_A.Auto OR GVL.RB_B.Auto THEN\n\t\tGVL.Pro4_.Man.TS_On_Off := 0;\n\t\tGVL.Pro4_.Man.Vs_On_Off := 0;\n\t\tGVL.Pro4_.Man.Trigger_Barcode_Ts_On_Off := 0;\n\t\tGVL.Pro4_.Man.Trigger_Barcode_Ts_On_Off := 0;\n\t\tGVL.Pro4_.Man.Cv_NG_On_Off := 0;\n\t\tGVL.Pro4_.Man.Lighting_On_Off := 0;\n\t\tGVL.Pro4_.Man.centering_ts_On_Off := 0;\n\tEND_IF\n\t\n\tIF GVL.RB_A.Manual OR GVL.RB_B.Manual THEN\n\t\tGVL.Pro4_.Auto.TS_On_Off := 0;\n\t\tGVL.Pro4_.Auto.Vs_On_Off := 0;\n\t\tGVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off := 0;\n\t\tGVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off := 0;\n\t\tGVL.Pro4_.Auto.Cv_NG_On_Off := 0;\n\t\tGVL.Pro4_.Auto.Lighting_On_Off := 0;\n\t\tGVL.Pro4_.Auto.centering_ts_On_Off := 0;\n\tEND_IF\n\t\n\t// centering test sóng\n\tGVL.Y[10] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.centering_ts_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.centering_ts_On_Off );\n\t\n\t// test sóng\n\tGVL.Y[20] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.TS_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.TS_On_Off );\n\t// test vision\t\t\t\n\tGVL.Y[21] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.Vs_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.Vs_On_Off );\n\t// trigger Barcode\tts\t\t\t\n\tGVL.Y[22] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.Trigger_Barcode_Ts_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.Trigger_Barcode_Ts_On_Off );\n\t// trigger Barcode vs\n\tGVL.Y[23] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.Trigger_Barcode_Vs_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.Trigger_Barcode_Vs_On_Off );\n\t// Conveyor NG\n\tGVL.Y[27] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.Cv_NG_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.Cv_NG_On_Off );\t\t\t\n\t// Lighting vision align\n\tGVL.Y[28] :=  (GVL.RB_A.Auto AND GVL.RB_B.Auto AND GVL.Pro4_.Auto.Lighting_On_Off )OR \n\t\t\t\t( ( GVL.RB_A.Manual OR GVL.RB_B.Manual) AND GVL.Pro4_.Man.Lighting_On_Off );\t\t\t\n\t\t\t\nEND_IF;","LineInfoPersistence":"(string)7ae268d3-5034-4eee-8b5d-8f1bd1ea6242_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)67"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}