{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)f118e92b-1c5e-4c87-998c-f8a24f75e4c4","ParentGuid":"(Guid)6074aab5-ea8d-4ca8-926f-ed0b90c52886","Name":"(string)ACT_HMI_Recipe_Config_B","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// CREATE ACTION under POU_HMI_CONTROL_ROBOT: ACT_HMI_Recipe_Config_B\n\n//=============================================================================\n// TRACKING RECIPE HMI LOAD / SAVE\n//=============================================================================\n\n//=============================================================================\n// 03. KHỞI TẠO INDEX MẶC ĐỊNH\n//=============================================================================\nIF GVL.g_uiHMITrackingRecipeIndexB = 0 OR GVL.g_uiHMITrackingRecipeIndexB > GVL.C_MAX_TRACK_RECIPES THEN\n    GVL.g_uiHMITrackingRecipeIndexB := 1;\nEND_IF;\n\n//-----------------------------------------------------------------------------\n// LOAD\n//-----------------------------------------------------------------------------\nIF GVL.g_xHMILoadTrackingRecipeB THEN\n\n    IF (GVL.g_uiHMITrackingRecipeIndexB >= 1)\n    AND (GVL.g_uiHMITrackingRecipeIndexB <= GVL.C_MAX_TRACK_RECIPES) THEN\n\n        GVL.g_stHMITrackingRecipeB :=\n            GVL.g_aMultiTrackRecipeB[GVL.g_uiHMITrackingRecipeIndexB];\n\n    END_IF;\n\n    GVL.g_xHMILoadTrackingRecipeB := FALSE;\n\nEND_IF;\n\n\n//-----------------------------------------------------------------------------\n// SAVE\n//-----------------------------------------------------------------------------\nIF GVL.g_xHMISaveTrackingRecipeB THEN\n\n    IF (GVL.g_uiHMITrackingRecipeIndexB >= 1)\n    AND (GVL.g_uiHMITrackingRecipeIndexB <= GVL.C_MAX_TRACK_RECIPES) THEN\n\n        GVL.g_aMultiTrackRecipeB[GVL.g_uiHMITrackingRecipeIndexB] :=\n            GVL.g_stHMITrackingRecipeB;\n\n    END_IF;\n\n    GVL.g_xHMISaveTrackingRecipeB := FALSE;\n\tGVL.g_xHMISaveTrackingRecipeB_All := TRUE;\n\nEND_IF;","LineInfoPersistence":"(string)f118e92b-1c5e-4c87-998c-f8a24f75e4c4_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)48"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}