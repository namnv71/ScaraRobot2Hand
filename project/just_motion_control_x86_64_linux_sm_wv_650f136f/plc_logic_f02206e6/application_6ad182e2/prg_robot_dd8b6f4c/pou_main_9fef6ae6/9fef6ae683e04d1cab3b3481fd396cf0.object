{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)POU_Main","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)dd8b6f4c-294d-4726-adc7-7828f20c8d79"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)// update out - namnv\n\n// namnv3103\nIF NOT First_Scan THEN\n\tRead_Config_First := TRUE;\n\tRead_Model_BF := TRUE;\n\tFirst_Scan := TRUE;\n\tFOR i_cam := 0 TO 10 BY 1 DO\n\t\tGVL.Load_Data_Cam[i_cam] := TRUE;\n\tEND_FOR\nEND_IF\n\n\n// Call PG\nACT_StatusMode();\nACT_Out();\nACT_IN();\nTimeTable();\nACT_SAVE_FILE();\nACT_SelectProjectRun();","LineInfoPersistence":"(string)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)PROGRAM POU_Main\nVAR\n    rTrig_Auto   : R_TRIG;\n    rTrig_Manual : R_TRIG;\n    rTrig_Lock   : R_TRIG;\n\trTrig_B_Auto   : R_TRIG;\n    rTrig_B_Manual : R_TRIG;\n    rTrig_B_Lock   : R_TRIG;\n\t\n\tfiledata : FB_FileManager;\n\ttsave, tload : TON;\n\t\n\ttrigSave, TrigLoad : R_TRIG;\nEND_VAR\n\nVAR\n\t//Input\n\tIn_Start  : BOOL;\n\tIn_Reset  : BOOL;\n\tIn_Stop  : BOOL;\n\tIn_EMG : BOOL;\n\t// Output\n\tOut_Red_Towerlamp : BOOL;\n\tOut_Yellow_Towerlamp  : BOOL;\n\tOut_Green_Towerlamp  : BOOL;\n\tOut_Buzz  : BOOL;\n\t\n\tPulse_1s : BOOL;\n\tT_1s : TON;\n\tRunTime_s  : UDINT;   // Thời gian chạy (giây)\n    StopTime_s : UDINT;   // Thời gian dừng\n    WaitTime_s : UDINT;   // Thời gian chờ\n    TotalTime_s: UDINT;   // Tổng thời gian\n\t\nEND_VAR\n\n\nVAR\n\t// IN\n\t\n\tT_RESET_TS, T_RESET_VS,\n\t T_OUT_RESET_TS, T_OUT_RESET_VS : TON;\n\t First_Scan: BOOL := FALSE;\n\t Read_Model_BF : BOOL;\nEND_VAR\nVAR\n    rSave_RB_A : R_TRIG;\n    rLoad_RB_A : R_TRIG;\n\trSave_RB_B : R_TRIG;\n    rLoad_RB_B : R_TRIG;\n\trSave_DT_Pro4 : R_TRIG;\n    rLoad_DT_Pro4 : R_TRIG;\n\trSave_DT_Pro4_Auto : R_TRIG;\n    rLoad_DT_Pro4_Auto, rReadModel_BF : R_TRIG;\nEND_VAR\n\nVAR\n\ti_1, i_cam : INT;\n\tS_fileName_Model : STRING;\n\tS_Robot_A_Name : STRING := 'file_data_RB_A_Project_';\n\tS_Robot_B_Name : STRING := 'file_data_RB_B_Project_';\n\tS_Robot_Name : STRING := 'file_data_RB_Project_';\n\tS_Robot_A_Name_Full : STRING := '';\n\tS_Robot_B_Name_Full : STRING := '';\n\tS_Robot_Name_Full : STRING := '';\n\tS_Model_No : STRING;\n\trSave_Model : R_TRIG;\n    rCall_Model : R_TRIG;\n\t\n\tr_Save_ToolConfig, r_Read_ToolConfig: R_TRIG;\n\tr_Save_ConveyorConfig,r_Read_ConveyorConfig: R_TRIG;\n\tr_Save_TrackingConfig, r_Read_TrackingConfig: R_TRIG;\n\tRead_Config_First : BOOL;\nEND_VAR\n","LineInfoPersistence":"(string)9fef6ae6-83e0-4d1c-ab3b-3481fd396cf0_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)95","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d