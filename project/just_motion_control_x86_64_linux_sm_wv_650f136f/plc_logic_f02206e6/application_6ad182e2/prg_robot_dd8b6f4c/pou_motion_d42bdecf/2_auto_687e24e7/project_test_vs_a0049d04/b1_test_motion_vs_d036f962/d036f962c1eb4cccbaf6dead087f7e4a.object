{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d036f962-c1eb-4ccc-baf6-dead087f7e4a","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)B1_Test_Motion_VS","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)a0049d04-dec0-43af-9e25-b15f8f1544af"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Ton_Test_B(PT := T#500MS);\nIF B_Test_Motion_Run THEN\n\tCASE Process_B_Test OF\n\t\t0: // Point 1 - Wait\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_B.Hand_Type, ID := 0, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_B.Enable THEN\n\t\t\t\tMove_Point_Para_B.Enable := TRUE;\n\t\t\t\tMove_Point_Para_B.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_B.Done AND NOT Move_RB_B.Busy THEN\t\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tMove_Point_Para_B.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t10: // Point 2 - BF Pick T1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_B.Hand_Type, ID := 1, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_B.Enable THEN\n\t\t\t\tMove_Point_Para_B.Enable := TRUE;\n\t\t\t\tMove_Point_Para_B.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_B.Done AND NOT Move_RB_B.Busy THEN\t\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tMove_Point_Para_B.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\n\t\t20: // WAIT Timer\n\t\t\tProcess_B_Test := Process_B_Test + 10;\n// \t\t\tTon_Test_B.IN := TRUE;\n// \t\t\tIF Ton_Test_B.Q THEN\n// \t\t\t\tProcess_B_Test := 30;\n// \t\t\t\tTon_Test_B.IN := FALSE;\n// \t\t\tEND_IF\n\t\t30: // Point 3 - Pick T1\n\t\t\t\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_B.Hand_Type, ID := 2, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_B.Enable THEN\n\t\t\t\tMove_Point_Para_B.Enable := TRUE;\n\t\t\t\tMove_Point_Para_B.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_B.Done AND NOT Move_RB_B.Busy THEN\t\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tMove_Point_Para_B.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t\n\t\t40: // Point 4 - BF Pick T1\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_B.Hand_Type, ID := 3, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_B.Enable THEN\n\t\t\t\tMove_Point_Para_B.Enable := TRUE;\n\t\t\t\tMove_Point_Para_B.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_B.Done AND NOT Move_RB_B.Busy THEN\t\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tMove_Point_Para_B.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t50: // Point 5 - Trigger VS\n\t\t\tM_CHOOSE_POS(DATA := Move_Point_Para_B.Hand_Type, ID := 4, XYR_CONST := FALSE, Z_CONST:= FALSE);\n\t\t\tIF NOT Move_Point_Para_B.Enable THEN\n\t\t\t\tMove_Point_Para_B.Enable := TRUE;\n\t\t\t\tMove_Point_Para_B.Move_Type := 0;\n\t\t\tEND_IF\n\t\t\tIF Move_RB_B.Done AND NOT Move_RB_B.Busy THEN\t\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tMove_Point_Para_B.Enable := FALSE;\n\t\t\tEND_IF;\n\t\t60: // WAIT Timer\n\t\t\t\n\t\t\tTon_Test_B.IN := TRUE;\n\t\t\tIF Ton_Test_B.Q THEN\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\t\tTon_Test_B.IN := FALSE;\n\t\t\tEND_IF\n\t\t\t\n\t\t70: // Trigger VS\n\t\t\tIF ( NOT GVL.Data_Calib_RB[0].Run_No_Trigger) THEN\n\t\t\t\tGVL.Auto_VS_RB[0].Enable_FB_Trigger_VS := TRUE;\n\t\t\t\tGVL.Auto_VS_RB[0].Start_FB_Trigger_VS := TRUE;\n\t\t\tEND_IF\n\t\t\t\n\t\t\tIF ((Trigger_VS_FB[0].DoneAll AND NOT Trigger_VS_FB[0].Busy) OR GVL.Data_Calib_RB[0].Run_No_Trigger ) THEN\n\t\t\t\tGVL.Auto_VS_RB[0].Enable_FB_Trigger_VS := FALSE;\n\t\t\t\tGVL.Auto_VS_RB[0].Start_FB_Trigger_VS := FALSE;\n\t\t\t\tProcess_B_Test := Process_B_Test + 10;\n\t\t\tEND_IF;\n\t\n\t\t80: // Finish\n\t\t\t//Ton_Test_B.IN := FALSE;\n\t\t\tProcess_B_Test := 0;\n\t\t\tA_Test_Motion_Finish := TRUE;\n\t\t\t\n\t\t\n\tEND_CASE\nELSE\n\tProcess_B_Test := 0;\nEND_IF","LineInfoPersistence":"(string)d036f962-c1eb-4ccc-baf6-dead087f7e4a_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)93"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}