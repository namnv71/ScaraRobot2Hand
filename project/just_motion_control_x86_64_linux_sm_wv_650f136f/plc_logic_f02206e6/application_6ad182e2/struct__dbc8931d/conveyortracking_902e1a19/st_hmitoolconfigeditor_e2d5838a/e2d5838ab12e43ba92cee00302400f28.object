{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)e2d5838a-b12e-43ba-92ce-e00302400f28","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_HMIToolConfigEditor","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)902e1a19-019e-4f5b-a6b4-7a1ed512205e"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)//=============================================================================\n// DUT: HMI TOOL CONFIG EDITOR\n//-----------------------------------------------------------------------------\n// Bộ dữ liệu trung gian để một trang HMI có thể chỉnh nhiều Tool.\n//=============================================================================\nTYPE ST_HMIToolConfigEditor :\nSTRUCT\n    // Index Tool người vận hành đang chọn trên HMI.\n    SelectedIndex : UINT;\n\n    // Index Tool đã được nạp vào EditData.\n    // Khi Save phải dùng LoadedIndex để tránh ghi nhầm Tool.\n    LoadedIndex : UINT;\n\n    // Dữ liệu đang hiển thị và chỉnh sửa trên HMI.\n    EditData : ST_ToolConfig;\n\n    // Bản dữ liệu ban đầu khi Load.\n    // Dùng để Cancel hoặc kiểm tra dữ liệu thay đổi.\n    OriginalData : ST_ToolConfig;\n\n    // Lệnh từ HMI.\n    LoadCommand : BOOL;\n    SaveCommand : BOOL;\n    CancelCommand : BOOL;\n\n    // Phản hồi dạng xung một vòng quét.\n    LoadDone : BOOL;\n    SaveDone : BOOL;\n\n    // Trạng thái xử lý.\n    Busy : BOOL;\n    Error : BOOL;\n    ErrorID : UDINT;\n\n    // HMI đặt TRUE khi người dùng thay đổi bất kỳ ô nhập nào.\n    DataChanged : BOOL;\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)e2d5838a-b12e-43ba-92ce-e00302400f28_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)39"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}