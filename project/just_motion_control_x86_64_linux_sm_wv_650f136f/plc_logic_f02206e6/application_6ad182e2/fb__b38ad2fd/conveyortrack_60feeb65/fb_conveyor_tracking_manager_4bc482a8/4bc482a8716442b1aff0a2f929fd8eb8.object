{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)4bc482a8-7164-42b1-aff0-a2f929fd8eb8","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)FB_CONVEYOR_TRACKING_MANAGER","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)60feeb65-e476-4d84-b0b4-5507ec6bdc22"}]}}}}]},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)(*\n===============================================================================\nFB_CONVEYOR_TRACKING_MANAGER - MULTI-TOOL CORE V2\n===============================================================================\n- Giữ chế độ Tracking Pick cũ khi UseExternalSelection = FALSE.\n- Thêm chế độ Multi-tool khi UseExternalSelection = TRUE.\n- Multi-tool Core chỉ tạo PCS, chạy Approach, chờ PickerSafe và thoát PCS.\n- Tool DOWN/GRIP/UP do FB_ToolManager bên ngoài điều khiển.\n===============================================================================\n*)\n\n//=============================================================================\n// 01. CHUYỂN ĐỔI GỐC CONVEYOR SANG KIỂU POSE CỦA SOFTMOTION\n//=============================================================================\n\n// Chuyển tọa độ X của gốc conveyor.\nstConveyorOriginSMC.X := ConveyorOrigin.X;\n// Chuyển tọa độ Y của gốc conveyor.\nstConveyorOriginSMC.Y := ConveyorOrigin.Y;\n// Chuyển tọa độ Z của gốc conveyor.\nstConveyorOriginSMC.Z := ConveyorOrigin.Z;\n// Chuyển góc A của gốc conveyor.\nstConveyorOriginSMC.A := ConveyorOrigin.A;\n// Chuyển góc B của gốc conveyor.\nstConveyorOriginSMC.B := 0.0;\n// Chuyển góc C của gốc conveyor.\nstConveyorOriginSMC.C := 0.0;\n\n//=============================================================================\n// 02. CHUYỂN ĐỔI POSE OBJECT BAN ĐẦU SANG KIỂU SOFTMOTION\n//=============================================================================\n\n// Chuyển tọa độ X của object ban đầu.\nstInitialObjectSMC.X := Runtime.PCSInfo.InitialObjectPos.X;\n\n// Chuyển tọa độ Y của object ban đầu.\nstInitialObjectSMC.Y := Runtime.PCSInfo.InitialObjectPos.Y;\n\n// Chuyển tọa độ Z của object ban đầu.\nstInitialObjectSMC.Z := Runtime.PCSInfo.InitialObjectPos.Z;\n\n// Chuyển góc A của object ban đầu.\nstInitialObjectSMC.A := Runtime.PCSInfo.InitialObjectPos.A;\n\n// // Chuyển góc B của object ban đầu.\n// stInitialObjectSMC.B :=\n//     REAL_TO_LREAL(Runtime.PCSInfo.InitialObjectPos.B);\n// \n// // Chuyển góc C của object ban đầu.\n// stInitialObjectSMC.C :=\n//     REAL_TO_LREAL(Runtime.PCSInfo.InitialObjectPos.C);\n\n//=============================================================================\n// 03. GỌI MC_TrackConveyorBelt MỖI VÒNG QUÉT\n//-----------------------------------------------------------------------------\n// Không đặt lời gọi này chỉ trong một CASE state.\n// Không hạ xTrackExecute ngay khi fbTrackBelt.Done.\n//=============================================================================\n\nfbTrackBelt(\n    // Axis Group robot SCARA hiện tại.\n    AxisGroup := SCARA_A,\n\n    // Logical Axis conveyor đã chạy trong chương trình test.\n    ConveyorBelt := SM_Drive_Logical,\n\n    // Execute nội bộ điều khiển vòng đời PCS.\n    Execute := xTrackExecute,\n\n    // Gốc conveyor trong hệ robot/base.\n    ConveyorBeltOrigin := stConveyorOriginSMC,\n\n    // Pose object tại thời điểm tham chiếu ban đầu.\n    InitialObjectPosition := stInitialObjectSMC,\n\n    // Dùng PCS_1 cho ứng dụng Conveyor Tracking.\n    CoordSystem := SMC_COORD_SYSTEM.PCS_1\n\n);\n\n//=============================================================================\n// 04. CẬP NHẬT OUTPUT CHUNG\n//=============================================================================\n\n// Done của Manager là xung một chu kỳ.\nRuntime.Response.Done := FALSE;\n\n// SyncOK chỉ TRUE khi Robot đã tới Approach và PCS còn InUse.\nSyncOK := FALSE;\n\n// Released là xung một chu kỳ khi Multi-tool Core đã thoát PCS.\nReleased := FALSE;\n\n// MotionRequest phản ánh trạng thái request nội bộ đang chờ Adapter nhận.\nMotionRequest := xMotionRequestPending;\n\n// TrackingActive TRUE khi Manager Busy, PCS Execute hoặc PCS đang InUse.\nTrackingActive := Runtime.Response.Busy OR xTrackExecute OR fbTrackBelt.InUse;\n\n// Đồng bộ trạng thái InUse của PCS vào Runtime.\nRuntime.PCSInfo.InUse := fbTrackBelt.InUse;\n\n//=============================================================================\n// 05. RESET TOÀN BỘ MANAGER\n//=============================================================================\n\nIF Reset THEN\n    // Đưa state machine về IDLE.\n    Runtime.State := E_TrackingState.TRK_IDLE;\n\n    // Xóa phản hồi Accepted.\n    Runtime.Response.Accepted := FALSE;\n\n    // Xóa phản hồi Busy.\n    Runtime.Response.Busy := FALSE;\n\n    // Xóa phản hồi Done.\n    Runtime.Response.Done := FALSE;\n\n    // Xóa phản hồi Error.\n    Runtime.Response.Error := FALSE;\n\n    // Xóa mã lỗi.\n    Runtime.Response.ErrorID := 0;\n\n    // Xóa index object active.\n    Runtime.SelectedObjectIndex := 0;\n\n    // Xóa ObjectID active.\n    Runtime.SelectedObjectID := 0;\n\n    // Xóa kết quả gắp.\n    Runtime.PickSuccess := FALSE;\n\n    // Đánh dấu PCS chưa hợp lệ.\n    Runtime.PCSInfo.Valid := FALSE;\n\n    // Đánh dấu PCS không còn được sử dụng.\n    Runtime.PCSInfo.InUse := FALSE;\n\n    // Hạ Execute của MC_TrackConveyorBelt.\n    xTrackExecute := FALSE;\n\n    // Xóa cờ đã phát motion.\n    xMotionIssued := FALSE;\n\n    // Xóa request motion đang chờ.\n    xMotionRequestPending := FALSE;\n\n    // Xóa trạng thái motion active.\n    xMotionActive := FALSE;\n\n    // Xóa trạng thái đã hút được vật.\n    xVacuumCaptured := FALSE;\n\n    // Tắt yêu cầu van hút.\n    VacuumCommand := FALSE;\n\n    // Tắt yêu cầu van thổi.\n    BlowCommand := FALSE;\n\n    // Hạ yêu cầu abort motion.\n    MotionAbort := FALSE;\n\n    // Xóa trạng thái đồng bộ và xung Release.\n    SyncOK := FALSE;\n    Released := FALSE;\n\n    // Reset timer PickDelay.\n    tonPickDelay(IN := FALSE);\n\n    // Reset timer VacuumTimeout.\n    tonVacuumTimeout(IN := FALSE);\n\n    // Reset timer Blow.\n    tonBlow(IN := FALSE);\n\t\n\tstToolSyncPos.X := 0.0;\n\tstToolSyncPos.Y := 0.0;\n\tstToolSyncPos.Z := 0.0;\n\tstToolSyncPos.A := 0.0;\n\txPickPositionReady := FALSE;\n\txPickMotionBusySeen := FALSE;\n\txRetractMotionBusySeen := FALSE;\n    // Kết thúc xử lý trong cycle reset.\n\t\n\txPCSStartCaptured := FALSE;\n\tlrConveyorPosAtPCSStart := 0.0;\n\tlrDeltaCaptureToPCS := 0.0;\n\n    RETURN;\nEND_IF;\n\n//=============================================================================\n// 06. HẠ EXECUTE KHI MANAGER ĐANG BUSY -> ABORT CÓ KIỂM SOÁT\n//=============================================================================\n\n//=============================================================================\n// EXECUTE BỊ HẠ TRONG KHI MANAGER CHƯA KẾT THÚC\n//=============================================================================\n//=============================================================================\n// EXECUTE ĐÃ HẠ - KHÔNG CHO STATE MACHINE TIẾP TỤC REQUEST CŨ\n//=============================================================================\n\nIF NOT Execute\nAND Runtime.State <> E_TrackingState.TRK_IDLE\nAND Runtime.State <> E_TrackingState.TRK_COMPLETE\nAND Runtime.State <> E_TrackingState.TRK_ABORTING\nAND Runtime.State <> E_TrackingState.TRK_ERROR THEN\n    Runtime.State := E_TrackingState.TRK_ABORTING;\nEND_IF;\n\n\n//=============================================================================\n// 07. STATE MACHINE CHÍNH\n//=============================================================================\n\nCASE Runtime.State OF\n\n    //=========================================================================\n    // TRK_IDLE\n    // Chờ lệnh Execute từ Application Manager hoặc chương trình test.\n    //=========================================================================\n    E_TrackingState.TRK_IDLE:\n\n        // Manager chưa tiếp nhận lệnh.\n        Runtime.Response.Accepted := FALSE;\n\n        // Manager không bận.\n        Runtime.Response.Busy := FALSE;\n\n        // Xóa lỗi cũ khi về IDLE.\n        Runtime.Response.Error := FALSE;\n\n        // Xóa mã lỗi cũ.\n        Runtime.Response.ErrorID := 0;\n\n        // Không có object active.\n        Runtime.SelectedObjectIndex := 0;\n\n        // Không có ObjectID active.\n        Runtime.SelectedObjectID := 0;\n\n        // Xóa trạng thái gắp.\n        Runtime.PickSuccess := FALSE;\n\n        // Tắt hút.\n        VacuumCommand := FALSE;\n\n        // Tắt thổi.\n        BlowCommand := FALSE;\n\n        // Hạ abort motion.\n        MotionAbort := FALSE;\n\n        // Xóa cờ motion.\n        xMotionIssued := FALSE;\n        xMotionRequestPending := FALSE;\n        xMotionActive := FALSE;\n\n        // Xóa trạng thái tool đã giữ vật.\n        xVacuumCaptured := FALSE;\n\n        // Khi Execute TRUE, tiếp nhận lệnh và bắt đầu tìm object.\n        IF Execute THEN\n            // Báo đã tiếp nhận request.\n            Runtime.Response.Accepted := TRUE;\n\n            // Báo Manager đang bận.\n            Runtime.Response.Busy := TRUE;\n\n            // Chuyển sang Scheduler.\n            Runtime.State := E_TrackingState.TRK_FIND_OBJECT;\n        END_IF;\n\n//     //=========================================================================\n//     // TRK_FIND_OBJECT\n//     // Scheduler tìm object phù hợp nhất trong Queue.\n//     //=========================================================================\n    E_TrackingState.TRK_FIND_OBJECT:\n\n        VacuumCommand := FALSE;\n        BlowCommand := FALSE;\n\n        IF UseExternalSelection THEN\n            IF ExternalObjectIndex = 0 THEN\n\t\t\t\tRuntime.Response.Error := FALSE;\n\t\t\t\tRuntime.Response.ErrorID := 0;\n\t\t\t\n\t\t\tELSIF ExternalObjectIndex > GVL.C_MAX_TRACK_OBJECTS THEN\n\t\t\t\tRuntime.Response.Error := TRUE;\n\t\t\t\tRuntime.Response.ErrorID := 6501;\n\t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n                \n            ELSIF NOT Queue.Objects[ExternalObjectIndex].Valid THEN\n                Runtime.Response.Error := TRUE;\n                Runtime.Response.ErrorID := 6502;\n                Runtime.State := E_TrackingState.TRK_ERROR;\n            ELSE\n                Runtime.SelectedObjectIndex := ExternalObjectIndex;\n                Runtime.SelectedObjectID := Queue.Objects[ExternalObjectIndex].ObjectID;\n                Runtime.State := E_TrackingState.TRK_RESERVE_OBJECT;\n            END_IF;\n\n        ELSIF TestFixedObjectMode THEN\n            Runtime.SelectedObjectIndex := 1;\n            Runtime.SelectedObjectID := 1;\n            Queue.Objects[1].Valid := TRUE;\n            Queue.Objects[1].ObjectID := 1;\n            Queue.Objects[1].Reserved := FALSE;\n            Queue.Objects[1].CanPick := TRUE;\n            Queue.Objects[1].AbortRequired := FALSE;\n            Queue.Objects[1].State := E_TrackingObjectState.OBJ_READY;\n            Runtime.State := E_TrackingState.TRK_RESERVE_OBJECT;\n\n        ELSE\n            uiSelectedIndex := F_SelectTrackingObject(\n                SelectMode := Config.SelectMode,\n                SpecificID := Config.SpecificObjectID,\n                DirectionSign := ConveyorConfig.DirectionSign,\n                MinimumVisionScore := Config.MinimumVisionScore,\n                Queue := Queue\n            );\n\n            IF uiSelectedIndex <> GVL.C_INVALID_INDEX THEN\n                Runtime.SelectedObjectIndex := uiSelectedIndex;\n                Runtime.SelectedObjectID := Queue.Objects[uiSelectedIndex].ObjectID;\n                Runtime.State := E_TrackingState.TRK_RESERVE_OBJECT;\n            END_IF;\n        END_IF;\n\n\n    //=========================================================================\n    // TRK_RESERVE_OBJECT\n    // Kiểm tra object lần cuối rồi khóa quyền sở hữu.\n    //=========================================================================\n    E_TrackingState.TRK_RESERVE_OBJECT:\n\n        // Nếu index không hợp lệ thì quay lại tìm object.\n        IF Runtime.SelectedObjectIndex = GVL.C_INVALID_INDEX THEN\n            Runtime.State := E_TrackingState.TRK_FIND_OBJECT;\n\n        // Nếu slot không còn hợp lệ thì hủy lựa chọn.\n        ELSIF NOT Queue.Objects[Runtime.SelectedObjectIndex].Valid THEN\n\n            Runtime.SelectedObjectIndex := 0;\n            Runtime.SelectedObjectID := 0;\n\n            Runtime.State := E_TrackingState.TRK_FIND_OBJECT;\n\n        // Nếu object đã bị module khác Reserve thì báo lỗi tranh chấp.\n        ELSIF Queue.Objects[Runtime.SelectedObjectIndex].Reserved THEN\n\n            Runtime.Response.Error := TRUE;\n            Runtime.Response.ErrorID := 6001;\n\n            Runtime.State := E_TrackingState.TRK_ERROR;\n\n        // Nếu object không còn đủ điều kiện gắp thì đánh dấu MISSED.\n        ELSIF NOT Queue.Objects[Runtime.SelectedObjectIndex].CanPick THEN\n\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_MISSED;\n\n            // MissCode 1: mất điều kiện trước khi Reserve.\n            Queue.Objects[Runtime.SelectedObjectIndex].MissCode := 1;\n\n            Queue.Objects[Runtime.SelectedObjectIndex].Reserved := FALSE;\n\n            Runtime.SelectedObjectIndex := 0;\n            Runtime.SelectedObjectID := 0;\n\n            Runtime.State := E_TrackingState.TRK_FIND_OBJECT;\n\n        ELSE\n            // Khóa object cho Manager này.\n            Queue.Objects[Runtime.SelectedObjectIndex].Reserved := TRUE;\n\n            // Chuyển trạng thái object sang RESERVED.\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_RESERVED;\n\n            // Ghi ActiveIndex vào Queue.\n            Queue.ActiveIndex := Runtime.SelectedObjectIndex;\n\n            // Xóa trạng thái hút cũ.\n            xVacuumCaptured := FALSE;\n\n            // Xóa kết quả gắp cũ.\n            Runtime.PickSuccess := FALSE;\n\n            // Chuyển sang kiểm tra vùng gắp.\n            Runtime.State := E_TrackingState.TRK_WAIT_PICK_ZONE;\n        END_IF;\n\n    //=========================================================================\n    // TRK_WAIT_PICK_ZONE\n    // Chờ object còn nằm trong vùng an toàn và đủ thời gian.\n    //=========================================================================\n    E_TrackingState.TRK_WAIT_PICK_ZONE:\n\n        // Nếu object mất hiệu lực thì giải phóng.\n        IF NOT Queue.Objects[Runtime.SelectedObjectIndex].Valid THEN\n\n            Runtime.State := E_TrackingState.TRK_RELEASE_OBJECT;\n\n        // Nếu object đã qua mốc Abort trước khi tạo PCS.\n        ELSIF Queue.Objects[Runtime.SelectedObjectIndex].AbortRequired THEN\n\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_MISSED;\n\n            // MissCode 2: quá vùng trong WAIT_PICK_ZONE.\n            Queue.Objects[Runtime.SelectedObjectIndex].MissCode := 2;\n\n            Runtime.State := E_TrackingState.TRK_RELEASE_OBJECT;\n\n        // Nếu object còn đủ điều kiện gắp thì chuẩn bị PCS.\n        ELSIF Queue.Objects[Runtime.SelectedObjectIndex].CanPick THEN\n\n            Runtime.State := E_TrackingState.TRK_PREPARE_PCS;\n        END_IF;\n\n    //=========================================================================\n    // TRK_PREPARE_PCS\n    // Chụp dữ liệu object active và tạo các điểm trong PCS.\n    //=========================================================================\n    E_TrackingState.TRK_PREPARE_PCS:\n\n        // Sao chép object active để tránh đọc rời rạc nhiều lần.\n        stSelectedObject := Queue.Objects[Runtime.SelectedObjectIndex];\n\n        // Lưu ObjectID vào thông tin PCS.\n        Runtime.PCSInfo.ObjectID := stSelectedObject.ObjectID;\n\n        //=========================================================================\n        // CHỌN NGUỒN VỊ TRÍ OBJECT\n        //-------------------------------------------------------------------------\n        // Trong chế độ test:\n        //     dùng vị trí object cố định.\n        //\n        // Trong chế độ chạy thật:\n\t\t//     dùng Pose chuẩn của Object trong Queue.\n\t\t//     Sensor/Vision đều phải chuẩn hóa về PoseInConveyor.\n        //=========================================================================\n        IF TestFixedObjectMode THEN\n        \n            // Gán vị trí object test cố định.\n            Runtime.PCSInfo.InitialObjectPos.X := FixedObjectPosition.X;\n        \n            Runtime.PCSInfo.InitialObjectPos.Y := FixedObjectPosition.Y;\n        \n            Runtime.PCSInfo.InitialObjectPos.Z := FixedObjectPosition.Z;\n        \n            Runtime.PCSInfo.InitialObjectPos.A := FixedObjectPosition.A;\n        \n\n        \n        ELSE\t\t\t\n\t\t\t// Chế độ chạy thật lấy Pose chuẩn của Object trong hệ Conveyor.\n\t\t\t// Sensor/Vision đều phải chuẩn hóa dữ liệu vào PoseInConveyor\n\t\t\t// trước khi đưa Object vào Tracking Queue.\n\t\t\t\n\t\t\t\n\t\t\tRuntime.PCSInfo.InitialObjectPos := stSelectedObject.PoseInConveyor;\n\t\t\t\n\t\t\t//=============================================================\n\t\t\t// BÙ CHIỀU CAO MẶT HÚT SẢN PHẨM\n\t\t\t//=============================================================\n\t\t\tIF UseExternalSelection THEN\n\t\t\n\t\t\t\tRuntime.PCSInfo.InitialObjectPos.Z :=\n\t\t\t\t\tstSelectedObject.PoseInConveyor.Z\n\t\t\t\t\t+ ExternalPickSurfaceHeightMM;\n\t\t\n\t\t\tEND_IF;\n\t\t\t\n\t\t\t\n        END_IF;\n\n        // Lưu gốc conveyor.\n        //Runtime.PCSInfo.ConveyorOrigin := ConveyorOrigin;\n        // Tọa độ X của gốc conveyor trong hệ robot/base.\n        Runtime.PCSInfo.ConveyorOrigin.X := ConveyorOrigin.X;\n        \n        // Tọa độ Y của gốc conveyor trong hệ robot/base.\n        Runtime.PCSInfo.ConveyorOrigin.Y := ConveyorOrigin.Y;\n        \n        // Tọa độ Z của gốc conveyor trong hệ robot/base.\n        Runtime.PCSInfo.ConveyorOrigin.Z := ConveyorOrigin.Z;\n        \n        // Góc A của hệ conveyor.\n        Runtime.PCSInfo.ConveyorOrigin.A := ConveyorOrigin.A;\n    \n\n        // Lưu vị trí conveyor tại thời điểm capture.\n        //Runtime.PCSInfo.ConveyorCapturePos := stSelectedObject.CaptureConveyorPos;\n\t\t\n\t\tRuntime.PCSInfo.ConveyorCapturePos := LREAL_TO_REAL(stSelectedObject.CaptureConveyorPositionMM);\n\t\n\t\n       // Quy ước:\n\t\t// - PickPos: điểm gắp thật của đầu Tool.\n\t\t// - ApproachPos: vị trí robot bắt đầu bám, phía trên PickPos.\n\t\t// - stToolSyncPos: cùng vị trí với ApproachPos.\n\t\t// - UseUpDown chỉ quyết định ai đi quãng cuối:\n\t\t//      TRUE  -> Tool cylinder đi xuống.\n\t\t//      FALSE -> Robot đi xuống.\n\t\t//=========================================================================\n\t\tIF UseExternalSelection THEN\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// 1. ĐIỂM GẮP THẬT\n\t\t\t//---------------------------------------------------------------------\n\t\t\tRuntime.PickPos := ExternalPickOffset;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// 2. ĐIỂM ĐỒNG BỘ CỦA ROBOT\n\t\t\t// Luôn cao hơn điểm gắp bằng ApproachHeight,\n\t\t\t// không phụ thuộc Tool có Up/Down hay không.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tRuntime.ApproachPos := Runtime.PickPos;\n\t\t\n\t\t\tRuntime.ApproachPos.Z := Runtime.PickPos.Z + ExternalApproachHeight;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Robot bám conveyor tại chính điểm Approach.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tstToolSyncPos := Runtime.ApproachPos;\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// 3. ĐIỂM NÂNG SAU KHI GẮP\n\t\t\t// RetractHeight được tính từ điểm gắp thật.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tRuntime.RetractPos := Runtime.PickPos;\n\t\t\n\t\t\tRuntime.RetractPos.Z := Runtime.PickPos.Z+ Config.RetractHeight;\n\t\t\n\t\tELSE\n\t\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// GIỮ LOGIC TRACKING THƯỜNG\n\t\t\t//---------------------------------------------------------------------\n\t\t\tRuntime.PickPos := Config.PickOffset;\n\t\t\n\t\t\tRuntime.ApproachPos := Config.PickOffset;\n\t\t\n\t\t\tRuntime.ApproachPos.Z :=\n\t\t\t\tRuntime.ApproachPos.Z\n\t\t\t\t+ Config.ApproachHeight;\n\t\t\n\t\t\tstToolSyncPos := Runtime.ApproachPos;\n\t\t\n\t\t\tRuntime.RetractPos := Config.PickOffset;\n\t\t\n\t\t\tRuntime.RetractPos.Z :=\n\t\t\t\tRuntime.RetractPos.Z\n\t\t\t\t+ Config.RetractHeight;\n\t\t\n\t\tEND_IF;\n\n\t\n\t\t// Chu trình mới chưa tới vị trí sẵn sàng thao tác Tool.\n\t\txPickPositionReady := FALSE;\n\t\txPickMotionBusySeen := FALSE;\n\t\txRetractMotionBusySeen := FALSE;\n\t\txExitPCSTargetValid := FALSE;\n        // PCS chưa hợp lệ trước khi SoftMotion báo Done.\n        Runtime.PCSInfo.Valid := FALSE;\n\t\t\n\t\t// Cho phép PCS mới chụp lại Conveyor Position.\n\t\t// Mỗi Object mới vào TRK_PREPARE_PCS sẽ reset cờ này.\n\t\txPCSStartCaptured := FALSE;\n\n        // Chuyển sang tạo PCS.\n        Runtime.State := E_TrackingState.TRK_CREATE_PCS;\n\t\t\n\t\t\n\t//=========================================================================\n\t// TRK_CREATE_PCS\n\t// Chốt vị trí Conveyor và tạo cạnh Execute cho MC_TrackConveyorBelt.\n\t//=========================================================================\n\tE_TrackingState.TRK_CREATE_PCS:\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// CHỐT DỮ LIỆU PCS MỘT LẦN\n\t\t//---------------------------------------------------------------------\n\t\tIF NOT xPCSStartCaptured THEN\n\t\n\t\t\t// Vị trí Conveyor gần nhất trước lúc MC_TrackConveyorBelt Execute.\n\t\t\tlrConveyorPosAtPCSStart :=\n\t\t\t\tREAL_TO_LREAL(ConveyorStatus.PositionMM);\n\t\n\t\t\t// Conveyor đã dịch từ lúc Sensor/Vision Capture tới lúc tạo PCS.\n\t\t\tlrDeltaCaptureToPCS :=\n\t\t\t\tlrConveyorPosAtPCSStart\n\t\t\t\t- stSelectedObject.CaptureConveyorPositionMM;\n\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// CẬP NHẬT POSE OBJECT TẠI THỜI ĐIỂM BẮT ĐẦU PCS\n\t\t\t//-----------------------------------------------------------------\n\t\t\tIF NOT TestFixedObjectMode THEN\n\t\n// \t\t\t\t// PoseInConveyor là Pose tại thời điểm Capture.\n// \t\t\t\tRuntime.PCSInfo.InitialObjectPos :=\n// \t\t\t\t\tstSelectedObject.PoseInConveyor;\n\t\n\t\t\t\t// Conveyor chạy theo +X của Conveyor CS.\n\t\t\t\tRuntime.PCSInfo.InitialObjectPos.X :=\n\t\t\t\t\tstSelectedObject.PoseInConveyor.X\n\t\t\t\t\t+ LREAL_TO_REAL(lrDeltaCaptureToPCS);\n\t\n\t\t\tEND_IF;\n\t\n\t\t\t// Đánh dấu đã chốt dữ liệu cho PCS hiện tại.\n\t\t\txPCSStartCaptured := TRUE;\n\t\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// TẠO CẠNH EXECUTE CHO MC_TrackConveyorBelt\n\t\t//---------------------------------------------------------------------\n\t\txTrackExecute := TRUE;\n\t\n\t\t// Sang state chờ SoftMotion tạo PCS.\n\t\tRuntime.State := E_TrackingState.TRK_WAIT_PCS;\n\t\n\t\n\t//=========================================================================\n\t// TRK_WAIT_PCS\n\t// Chờ MC_TrackConveyorBelt hoàn tất tạo PCS.\n\t//=========================================================================\n\tE_TrackingState.TRK_WAIT_PCS:\n\t\n\t\t// Quan trọng:\n\t\t// Giữ Execute TRUE trong toàn bộ vòng đời PCS.\n\t\txTrackExecute := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// TRACK CONVEYOR ERROR\n\t\t//---------------------------------------------------------------------\n\t\tIF fbTrackBelt.Error THEN\n\t\n\t\t\tRuntime.Response.Error := TRUE;\n\t\t\tRuntime.Response.ErrorID :=\n\t\t\t\tTO_UDINT(fbTrackBelt.ErrorID);\n\t\n\t\t\tRuntime.State :=\n\t\t\t\tE_TrackingState.TRK_ERROR;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// PCS ĐÃ ĐƯỢC TẠO\n\t\t//---------------------------------------------------------------------\n\t\tELSIF fbTrackBelt.Done THEN\n\t\n\t\t\t// Không hạ xTrackExecute ở đây.\n\t\t\tRuntime.PCSInfo.Valid := TRUE;\n\t\n\t\t\t// Đánh dấu Object đã có Dynamic PCS.\n\t\t\tQueue.Objects[Runtime.SelectedObjectIndex].State :=\n\t\t\t\tE_TrackingObjectState.OBJ_PCS_READY;\n\t\n\t\t\t// Chuẩn bị phát Motion Approach.\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txMotionActive := FALSE;\n\t\n\t\t\tRuntime.State :=\n\t\t\t\tE_TrackingState.TRK_MOVE_APPROACH;\n\t\n\t\tEND_IF;\n\n//     //=========================================================================\n//     // TRK_CREATE_PCS\n//     // Tạo cạnh Execute cho MC_TrackConveyorBelt.\n//     //=========================================================================\n//     E_TrackingState.TRK_CREATE_PCS:\n// \n//         // Bật Execute PCS.\n//         xTrackExecute := TRUE;\n// \n//         // Chuyển sang chờ SoftMotion tạo PCS.\n//         Runtime.State := E_TrackingState.TRK_WAIT_PCS;\n// \n//     //=========================================================================\n//     // TRK_WAIT_PCS\n//     // Chờ MC_TrackConveyorBelt hoàn tất tạo PCS.\n//     //=========================================================================\n//     E_TrackingState.TRK_WAIT_PCS:\n// \n//         // Nếu SoftMotion báo lỗi.\n//         IF fbTrackBelt.Error THEN\n//             Runtime.Response.Error := TRUE;\n// \n//             // Cast ErrorID theo kiểu Runtime đang sử dụng.\n//             Runtime.Response.ErrorID := TO_UDINT(fbTrackBelt.ErrorID);\n// \n//             Runtime.State := E_TrackingState.TRK_ERROR;\n// \n//         // Khi PCS đã được tạo.\n//         ELSIF fbTrackBelt.Done THEN\n//             // Không hạ xTrackExecute tại đây.\n//             Runtime.PCSInfo.Valid := TRUE;\n// \n//             // Đánh dấu object đã có PCS.\n//             Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_PCS_READY;\n// \n//             // Chuẩn bị phát motion Approach.\n//             xMotionIssued := FALSE;\n//             xMotionRequestPending := FALSE;\n//             xMotionActive := FALSE;\n// \n//             Runtime.State := E_TrackingState.TRK_MOVE_APPROACH;\n//         END_IF;\n\n    //=========================================================================\n    // TRK_MOVE_APPROACH\n    // Đi tới phía trên object trong PCS_1.\n    //=========================================================================\n    E_TrackingState.TRK_MOVE_APPROACH:\n\n    // Trong chế độ test cố định, không cho Updater abort object test.\n    IF TestFixedObjectMode THEN\n        Queue.Objects[Runtime.SelectedObjectIndex].AbortRequired := FALSE;\n    END_IF;\n\n    // Chỉ tạo một request mới khi chưa có request/motion nào active.\n    IF NOT xMotionIssued AND NOT xMotionRequestPending AND NOT xMotionActive THEN\n\n        // Điểm đích Approach trong PCS_1.\n        MotionTarget := Runtime.ApproachPos;\n\n        // Tốc độ Approach lấy từ Tracking Config.\n        MotionSpeed := Config.Motion.Approach.Speed;\n\n        // Gia tốc Approach.\n        MotionAcceleration := Config.Motion.Approach.Acceleration;\n\n        // Giảm tốc Approach.\n        MotionDeceleration := Config.Motion.Approach.Deceleration;\n\n        // Jerk Approach.\n        MotionJerk := Config.Motion.Approach.Jerk;\n\n        // Blend radius của Approach.\n        MotionBlendRadius := Config.Motion.Approach.BlendRadius;\n\n        // Approach được thực hiện trong PCS động số 1.\n        MotionCoordSystem := E_AppCoordSystem.APP_COORD_PCS1;\n\n        // Mã lệnh MoveL.\n        MotionCommand := 2;\n\n        // Chỉ phát request nếu dữ liệu motion hợp lệ.\n        IF MotionSpeed > 0.0 AND MotionAcceleration > 0.0 AND MotionDeceleration > 0.0 THEN\n\n            // Đánh dấu request đang chờ Motion Adapter nhận.\n            xMotionRequestPending := TRUE;\n\n            // Đánh dấu state đã tạo request.\n            xMotionIssued := TRUE;\n\n        ELSE\n            // Thông số Dynamic bằng 0 nên không được phát motion.\n            Runtime.Response.Error := TRUE;\n\n            // Mã lỗi nội bộ: cấu hình Approach không hợp lệ.\n            Runtime.Response.ErrorID := 6101;\n\n            // Chuyển sang state lỗi.\n            Runtime.State := E_TrackingState.TRK_ERROR;\n        END_IF;\n    END_IF;\n\n    // Motion Adapter đã nhận request.\n    IF MotionAccepted AND xMotionRequestPending THEN\n\n        // Hạ request pending.\n        xMotionRequestPending := FALSE;\n\n        // Bắt đầu chờ MotionDone.\n        xMotionActive := TRUE;\n    END_IF;\n\n    // Motion Approach hoàn thành.\n    IF MotionDone AND xMotionActive THEN\n\t\txMotionActive := FALSE;\n\t\txMotionIssued := FALSE;\n\t\txMotionRequestPending := FALSE;\n\t\n\t\tIF UseExternalSelection THEN\n\t\t\tIF ExternalUseUpDown THEN\n\t\t\t\t// Robot đã tới SyncPos.\n\t\t\t\t// Tool cơ khí sẽ thực hiện hành trình xuống.\n\t\t\t\txPickPositionReady := TRUE;\n\t\t\tELSE\n\t\t\t\t// Robot mới chỉ tới SyncPos.\n\t\t\t\t// Bắt buộc phải phát thêm MoveL xuống PickPos.\n\t\t\t\txPickPositionReady := FALSE;\n\t\t\tEND_IF;\n\t\tELSE\n\t\t\txPickPositionReady := FALSE;\n\t\tEND_IF;\n\t\n\t\tRuntime.State := E_TrackingState.TRK_MOVE_PICK;\n\t\n\tELSIF MotionError AND xMotionActive THEN\n\t\txMotionActive := FALSE;\n\t\txMotionIssued := FALSE;\n\t\txMotionRequestPending := FALSE;\n\t\n\t\tRuntime.Response.Error := TRUE;\n\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\tEND_IF;\n\n    //=========================================================================\n    // TRK_MOVE_PICK\n    // Hạ TCP từ Approach xuống PickPos trong PCS_1.\n    //=========================================================================\n    E_TrackingState.TRK_MOVE_PICK:\n\n        IF UseExternalSelection THEN\n            xTrackExecute := TRUE;\n\t\t\tVacuumCommand := FALSE;\n\t\t\tBlowCommand := FALSE;\n\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Chưa tới vị trí sẵn sàng thì phát một MoveL trong PCS_1.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tIF NOT xPickPositionReady THEN\n\n\t\t\t\tIF NOT xMotionIssued AND NOT xMotionRequestPending AND NOT xMotionActive THEN\n\t\t\t\n\t\t\t\t\tQueue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_PICKING;\n\t\t\t\n\t\t\t\t\t// Không có Up/Down:\n\t\t\t\t\t// robot phải tự xuống điểm Pick thật.\n\t\t\t\t\tMotionTarget := Runtime.PickPos;\n\t\t\t\n\t\t\t\t\tMotionSpeed := Config.Motion.Pick.Speed;\n\t\t\t\t\tMotionAcceleration := Config.Motion.Pick.Acceleration;\n\t\t\t\t\tMotionDeceleration := Config.Motion.Pick.Deceleration;\n\t\t\t\t\tMotionJerk := Config.Motion.Pick.Jerk;\n\t\t\t\t\tMotionBlendRadius := Config.Motion.Pick.BlendRadius;\n\t\t\t\t\tMotionCoordSystem := E_AppCoordSystem.APP_COORD_PCS1;\n\t\t\t\t\tMotionCommand := 2;\n\t\t\t\n\t\t\t\t\txPickMotionBusySeen := FALSE;\n\t\t\t\t\txMotionRequestPending := TRUE;\n\t\t\t\t\txMotionIssued := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tIF MotionAccepted AND xMotionRequestPending THEN\n\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\txMotionActive := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tIF xMotionActive AND MotionBusy THEN\n\t\t\t\t\txPickMotionBusySeen := TRUE;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\t\tIF MotionDone\n\t\t\t\tAND xMotionActive\n\t\t\t\tAND xPickMotionBusySeen THEN\n\t\t\t\n\t\t\t\t\txMotionActive := FALSE;\n\t\t\t\t\txMotionIssued := FALSE;\n\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\txPickMotionBusySeen := FALSE;\n\t\t\t\n\t\t\t\t\t// Chỉ tới đây mới xác nhận robot đã xuống PickPos.\n\t\t\t\t\txPickPositionReady := TRUE;\n\t\t\t\n\t\t\t\tELSIF MotionError AND xMotionActive THEN\n\t\t\t\n\t\t\t\t\txMotionActive := FALSE;\n\t\t\t\t\txMotionIssued := FALSE;\n\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\txPickMotionBusySeen := FALSE;\n\t\t\t\n\t\t\t\t\tRuntime.Response.Error := TRUE;\n\t\t\t\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\t\t\tEND_IF;\n\t\t\t\n\t\t\tEND_IF;\n\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Chỉ báo SyncOK sau khi robot tới đúng vị trí thao tác.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tSyncOK := xPickPositionReady AND Runtime.PCSInfo.Valid AND fbTrackBelt.InUse;\n\t\n\t\t\t//---------------------------------------------------------------------\n\t\t\t// Controller đã hoàn thành:\n\t\t\t// - Có Up/Down: DOWN -> GRIP -> UP.\n\t\t\t// - Không Up/Down: GRIP.\n\t\t\t//---------------------------------------------------------------------\n\t\t\tIF PickerSafe AND SyncOK THEN\n\t\n\t\t\t\tRuntime.PickSuccess := TRUE;\n\t\t\t\txVacuumCaptured := TRUE;\n\t\t\t\t\n\t\t\t\txRetractMotionBusySeen := FALSE;\n\t\t\t\txExitPCSTargetValid := FALSE;\n\t\t\t\t\n\t\t\t\tIF ExternalUseUpDown THEN\n\t\t\t\t\t// Tool đã thực hiện DOWN -> GRIP -> UP.\n\t\t\t\t\t// Robot vẫn đang tại Sync/ApproachPos.\n\t\t\t\t\t// Không được chạy xuống RetractPos.\n\t\t\t\t\tRuntime.State := E_TrackingState.TRK_LEAVE_PCS;\n\t\t\t\tELSE\n\t\t\t\t\t// Không có Tool Up/Down.\n\t\t\t\t\t// Robot đang tại PickPos và cần tự nâng lên RetractPos.\n\t\t\t\t\tRuntime.State := E_TrackingState.TRK_MOVE_RETRACT;\n\t\t\t\tEND_IF;\n\t\t\t\t\t\n\t\t\tELSIF fbTrackBelt.Error THEN\n\t\n\t\t\t\tRuntime.Response.Error := TRUE;\n\t\t\t\tRuntime.Response.ErrorID :=\n\t\t\t\t\tTO_UDINT(fbTrackBelt.ErrorID);\n\t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\n\t\t\tEND_IF;\n\n        ELSE\n\n\n            // Chưa VacuumOK nên vẫn có thể abort nếu object quá vùng.\n            IF Queue.Objects[Runtime.SelectedObjectIndex].AbortRequired AND NOT xVacuumCaptured THEN\n\n                Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_MISSED;\n\n                // MissCode 4: quá vùng trong Move Pick.\n                Queue.Objects[Runtime.SelectedObjectIndex].MissCode := 4;\n\n                MotionAbort := TRUE;\n\n                Runtime.State := E_TrackingState.TRK_ABORT_ACTIVE;\n\n            ELSE\n                // Tạo request Pick mới.\n                IF NOT xMotionIssued AND NOT xMotionRequestPending AND NOT xMotionActive THEN\n\n                    // Đánh dấu object đang ở pha Picking.\n                    Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_PICKING;\n\n                    // Gán điểm Pick.\n                    MotionTarget := Runtime.PickPos;\n\n                    // Gán tốc độ Pick.\n                    MotionSpeed := Config.Motion.Pick.Speed;\n\n                    // Gán gia tốc Pick.\n                    MotionAcceleration := Config.Motion.Pick.Acceleration;\n\n                    // Gán giảm tốc Pick.\n                    MotionDeceleration := Config.Motion.Pick.Deceleration;\n\n                    // Gán jerk Pick.\n                    MotionJerk := Config.Motion.Pick.Jerk;\n\n                    // Gán blend Pick.\n                    MotionBlendRadius := Config.Motion.Pick.BlendRadius;\n\n                    // Pick chạy trong PCS_1.\n                    MotionCoordSystem := E_AppCoordSystem.APP_COORD_PCS1;\n\n                    // Mã lệnh MoveL.\n                    MotionCommand := 2;\n\n                    // Bật request pending.\n                    xMotionRequestPending := TRUE;\n\n                    // Đánh dấu đã tạo lệnh.\n                    xMotionIssued := TRUE;\n                END_IF;\n\t\t\t\t\t\n\t\t\t\t\t// Adapter đã nhận đúng request Pick.\n\t\t\t\t\tIF MotionAccepted AND xMotionRequestPending THEN\n\t\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\t\txMotionActive := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\t\t\n\t\t\t\t\t// Phải thấy motion Pick thực sự Busy ít nhất một scan.\n\t\t\t\t\t// Nhờ đó không nhận nhầm Done còn lại từ lệnh Approach.\n\t\t\t\t\tIF xMotionActive AND MotionBusy THEN\n\t\t\t\t\t\txPickMotionBusySeen := TRUE;\n\t\t\t\t\tEND_IF;\n\t\t\t\t\t\n\t\t\t\t\t// Chỉ công nhận Done sau khi motion Pick đã thực sự Busy.\n\t\t\t\t\tIF MotionDone\n\t\t\t\t\tAND xMotionActive\n\t\t\t\t\tAND xPickMotionBusySeen THEN\n\t\t\t\t\t\n\t\t\t\t\t\txMotionActive := FALSE;\n\t\t\t\t\t\txMotionIssued := FALSE;\n\t\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\t\txPickMotionBusySeen := FALSE;\n\t\t\t\t\t\n\t\t\t\t\t\txPickPositionReady := TRUE;\n\t\t\t\t\t\n\t\t\t\t\tELSIF MotionError AND xMotionActive THEN\n\t\t\t\t\t\n\t\t\t\t\t\txMotionActive := FALSE;\n\t\t\t\t\t\txMotionIssued := FALSE;\n\t\t\t\t\t\txMotionRequestPending := FALSE;\n\t\t\t\t\t\txPickMotionBusySeen := FALSE;\n\t\t\t\t\t\n\t\t\t\t\t\tRuntime.Response.Error := TRUE;\n\t\t\t\t\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\t\t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\t\t\t\t\n\t\t\t\t\tEND_IF;\n\n//                 // Adapter đã nhận request.\n//                 IF MotionAccepted AND xMotionRequestPending THEN\n//                     xMotionRequestPending := FALSE;\n//                     xMotionActive := TRUE;\n//                 END_IF;\n// \n//                 // Motion Pick hoàn thành.\n//                 IF MotionDone AND xMotionActive THEN\n//                     xMotionActive := FALSE;\n//                     xMotionIssued := FALSE;\n// \n//                     Runtime.State := E_TrackingState.TRK_GRIP_ON;\n// \n//                 // Motion Pick lỗi.\n//                 ELSIF MotionError AND xMotionActive THEN\n//                     xMotionActive := FALSE;\n// \n//                     Runtime.Response.Error := TRUE;\n//                     Runtime.Response.ErrorID := MotionErrorID;\n// \n//                     Runtime.State := E_TrackingState.TRK_ERROR;\n//                 END_IF;\n            END_IF;\n\n        END_IF;\n\n\n    //=========================================================================\n    // TRK_GRIP_ON\n    // Bật hút và chờ PickDelay.\n    //=========================================================================\n    E_TrackingState.TRK_GRIP_ON:\n\n        // Bật yêu cầu hút.\n        VacuumCommand := TRUE;\n\n        // Chạy timer PickDelay.\n        tonPickDelay(\n            IN := TRUE,\n            PT := Config.PickDelay\n        );\n\n        // Khi hết thời gian chờ.\n        IF tonPickDelay.Q THEN\n            // Reset timer PickDelay.\n            tonPickDelay(IN := FALSE);\n\n            // Reset timer VacuumTimeout.\n            tonVacuumTimeout(IN := FALSE);\n\n            // Chuyển sang chờ VacuumOK.\n            Runtime.State := E_TrackingState.TRK_WAIT_GRIP;\n        END_IF;\n\n    //=========================================================================\n    // TRK_WAIT_GRIP\n    // Chờ VacuumOK hoặc timeout.\n    //=========================================================================\n    E_TrackingState.TRK_WAIT_GRIP:\n\n        // Giữ hút trong toàn bộ thời gian chờ.\n        VacuumCommand := TRUE;\n\n        // Chạy timer VacuumTimeout.\n        tonVacuumTimeout(\n            IN := TRUE,\n            PT := Config.VacuumTimeout\n        );\n\n        // Nếu tool đã giữ được vật.\n        IF VacuumOK THEN\n            // Reset timeout.\n            tonVacuumTimeout(IN := FALSE);\n\n            // Khóa trạng thái đã hút thành công.\n            xVacuumCaptured := TRUE;\n\n            // Báo gắp thành công.\n            Runtime.PickSuccess := TRUE;\n\n            // Chuẩn bị phát motion Retract.\n            xMotionIssued := FALSE;\n            xMotionRequestPending := FALSE;\n            xMotionActive := FALSE;\n\n            Runtime.State := E_TrackingState.TRK_MOVE_RETRACT;\n\n        // Nếu hết timeout mà chưa hút được.\n        ELSIF tonVacuumTimeout.Q THEN\n            // Reset timer.\n            tonVacuumTimeout(IN := FALSE);\n\n            // Tăng số lần thử.\n            Queue.Objects[Runtime.SelectedObjectIndex].PickAttempts := Queue.Objects[Runtime.SelectedObjectIndex].PickAttempts + 1;\n\n            // Nếu object đã vượt vùng an toàn thì không thử lại.\n            IF Queue.Objects[Runtime.SelectedObjectIndex].AbortRequired THEN\n\n                VacuumCommand := FALSE;\n\n                Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_MISSED;\n\n                // MissCode 5: timeout và đã vượt vùng.\n                Queue.Objects[Runtime.SelectedObjectIndex].MissCode := 5;\n\n                Runtime.State := E_TrackingState.TRK_ABORT_ACTIVE;\n\n            // Nếu còn lượt thử.\n            ELSIF Queue.Objects[Runtime.SelectedObjectIndex].PickAttempts < Config.MaxPickAttempts THEN\n\n                // Tắt hút trước lần thử tiếp theo.\n                VacuumCommand := FALSE;\n\n                // Cho phép phát lại lệnh Pick.\n                xMotionIssued := FALSE;\n                xMotionRequestPending := FALSE;\n                xMotionActive := FALSE;\n\n                Runtime.State := E_TrackingState.TRK_MOVE_PICK;\n\n            ELSE\n                // Hết số lần thử.\n                VacuumCommand := FALSE;\n\n                Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_MISSED;\n\n                // MissCode 6: hết số lần thử hút.\n                Queue.Objects[Runtime.SelectedObjectIndex].MissCode := 6;\n\n                Runtime.State := E_TrackingState.TRK_ABORT_ACTIVE;\n            END_IF;\n        END_IF;\n\n    //=========================================================================\n\t// TRK_MOVE_RETRACT\n\t// Nâng sản phẩm trong PCS_1.\n\t//=========================================================================\n\tE_TrackingState.TRK_MOVE_RETRACT:\n\t\n\t\t// Giữ sản phẩm trong khi nâng.\n\t\tVacuumCommand := xVacuumCaptured;\n\t\txTrackExecute := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// PHÁT LỆNH RETRACT MỘT LẦN\n\t\t//---------------------------------------------------------------------\n\t\tIF NOT xMotionIssued\n\t\tAND NOT xMotionRequestPending\n\t\tAND NOT xMotionActive THEN\n\t\n\t\t\t// X/Y/A giữ nguyên theo PickPos; chỉ Z tăng.\n\t\t\tMotionTarget := Runtime.RetractPos;\n\t\n\t\t\tMotionSpeed := Config.Motion.Retract.Speed;\n\t\t\tMotionAcceleration := Config.Motion.Retract.Acceleration;\n\t\t\tMotionDeceleration := Config.Motion.Retract.Deceleration;\n\t\t\tMotionJerk := Config.Motion.Retract.Jerk;\n\t\t\tMotionBlendRadius := 0.0;\n\t\n\t\t\t// Vẫn bám vật trong lúc nâng.\n\t\t\tMotionCoordSystem := E_AppCoordSystem.APP_COORD_PCS1;\n\t\t\tMotionCommand := 2;\n\t\n\t\t\txRetractMotionBusySeen := FALSE;\n\t\t\txMotionRequestPending := TRUE;\n\t\t\txMotionIssued := TRUE;\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// ADAPTER ĐÃ NHẬN LỆNH RETRACT\n\t\t//---------------------------------------------------------------------\n\t\tIF MotionAccepted AND xMotionRequestPending THEN\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txMotionActive := TRUE;\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// CHÍNH LỆNH RETRACT ĐÃ THỰC SỰ CHẠY\n\t\t//---------------------------------------------------------------------\n\t\tIF xMotionActive AND MotionBusy THEN\n\t\t\txRetractMotionBusySeen := TRUE;\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// RETRACT HOÀN THÀNH THẬT\n\t\t//---------------------------------------------------------------------\n\t\tIF MotionDone\n\t\tAND xMotionActive\n\t\tAND xRetractMotionBusySeen THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txRetractMotionBusySeen := FALSE;\n\t\t\n\t\t\txExitPCSTargetValid := FALSE;\n\t\t\n\t\t\tRuntime.State := E_TrackingState.TRK_LEAVE_PCS;\n// \t\t\txMotionActive := FALSE;\n// \t\t\txMotionIssued := FALSE;\n// \t\t\txMotionRequestPending := FALSE;\n// \t\t\txRetractMotionBusySeen := FALSE;\n// \t\n// \t\t\txExitPCSTargetValid := FALSE;\n// \t\n// \t\t\t//-----------------------------------------------------------------\n// \t\t\t// Chỉ sau khi nâng xong mới chụp vị trí MCS hiện tại.\n// \t\t\t//-----------------------------------------------------------------\n// \t\t\tstExitPCSTarget.X :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.X);\n// \t\n// \t\t\tstExitPCSTarget.Y :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.Y);\n// \t\n// \t\t\tstExitPCSTarget.Z :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.Z);\n// \t\n// \t\t\tstExitPCSTarget.A :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.A);\n// \t\n// \t\t\t// Chỉ cộng thêm Z, không thay đổi X/Y/A.\n// \t\t\tstExitPCSTarget.Z :=\n// \t\t\t\tstExitPCSTarget.Z + rExitPCSOffsetZ;\n// \t\n// \t\t\tIF stExitPCSTarget.Z < 0.0\n// \t\t\tOR stExitPCSTarget.Z > rExitPCSMaxZ THEN\n// \t\n// \t\t\t\tRuntime.Response.Error := TRUE;\n// \t\t\t\tRuntime.Response.ErrorID := 6130;\n// \t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n// \t\n// \t\t\tELSE\n// \t\n// \t\t\t\txExitPCSTargetValid := TRUE;\n// \t\t\t\tRuntime.State := E_TrackingState.TRK_LEAVE_PCS;\n// \t\n// \t\t\tEND_IF;\n\t\n\t\tELSIF MotionError AND xMotionActive THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txRetractMotionBusySeen := FALSE;\n\t\n\t\t\tRuntime.Response.Error := TRUE;\n\t\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\n\t\tEND_IF;\n\n\n\t//=============================================================================\n\t// TRK_LEAVE_PCS — STATE 120\n\t//-----------------------------------------------------------------------------\n\t// Phát một motion ngắn trong Robot Base/MCS để AxisGroup rời PCS_1.\n\t//\n\t// stExitPCSTarget đã được chụp một lần tại cuối Retract.\n\t// Không cập nhật stExitPCSTarget trong state này.\n\t//=============================================================================\n\tE_TrackingState.TRK_LEAVE_PCS:\n\t\n\t\t// Tiếp tục giữ sản phẩm.\n\t\tVacuumCommand := xVacuumCaptured;\n\t\n\t\t// Giữ MC_TrackConveyorBelt hoạt động cho tới khi AxisGroup rời PCS.\n\t\txTrackExecute := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// CHỤP TARGET MCS VÀ PHÁT MOTION EXIT PCS MỘT LẦN\n\t\t//---------------------------------------------------------------------\n\t\tIF NOT xMotionIssued\n\t\tAND NOT xMotionRequestPending\n\t\tAND NOT xMotionActive THEN\n\t\n\t\t\t// Chụp vị trí MCS muộn nhất có thể,\n\t\t\t// ngay trước khi tạo request Motion Queue.\n// \t\t\tstExitPCSTarget.X :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.X);\n// \t\n// \t\t\tstExitPCSTarget.Y :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.Y);\n// \t\n// \t\t\tstExitPCSTarget.Z :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.Z);\n// \t\n// \t\t\tstExitPCSTarget.A :=\n// \t\t\t\tTO_REAL(POU_MONITOR_ROBOT.RB1_POS.c.A);\n\n\t\t\tstExitPCSTarget.X :=\n\t\t\t\tTO_REAL(POU_COORDINATE_.Pos_Out_A_MCS.c.X);\n\t\n\t\t\tstExitPCSTarget.Y :=\n\t\t\t\tTO_REAL(POU_COORDINATE_.Pos_Out_A_MCS.c.Y);\n\t\n\t\t\tstExitPCSTarget.Z :=\n\t\t\t\tTO_REAL(POU_COORDINATE_.Pos_Out_A_MCS.c.Z);\n\t\n\t\t\tstExitPCSTarget.A :=\n\t\t\t\tTO_REAL(POU_COORDINATE_.Pos_Out_A_MCS.c.A);\n\t\n\t\t\t// Chỉ nâng thêm Z; không cộng offset X/Y/A.\n\t\t\tstExitPCSTarget.X := stExitPCSTarget.X - rExitPCSOffsetX;\n\t\t\tstExitPCSTarget.Z := stExitPCSTarget.Z + rExitPCSOffsetZ;\n\t\n\t\t\t//-----------------------------------------------------------------\n\t\t\t// KIỂM TRA TARGET\n\t\t\t//-----------------------------------------------------------------\n\t\t\tIF stExitPCSTarget.Z < 0.0\n\t\t\tOR stExitPCSTarget.Z > rExitPCSMaxZ THEN\n\t\n\t\t\t\tRuntime.Response.Error := TRUE;\n\t\t\t\tRuntime.Response.ErrorID := 6130;\n\t\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\n\t\t\tELSE\n\t\n\t\t\t\txExitPCSTargetValid := TRUE;\n\t\n\t\t\t\tMotionTarget := stExitPCSTarget;\n\t\n\t\t\t\tMotionSpeed := 80.0;\n\t\t\t\tMotionAcceleration := 300.0;\n\t\t\t\tMotionDeceleration := 300.0;\n\t\t\t\tMotionJerk := 1000.0;\n\t\t\t\tMotionBlendRadius := 0.0;\n\t\n\t\t\t\t// Chạy trong Robot Base/MCS để thoát khỏi PCS_1.\n\t\t\t\tMotionCoordSystem :=\n\t\t\t\t\tE_AppCoordSystem.APP_COORD_ROBOT_BASE;\n\t\n\t\t\t\tMotionCommand := 2;\n\t\n\t\t\t\txMotionRequestPending := TRUE;\n\t\t\t\txMotionIssued := TRUE;\n\t\n\t\t\tEND_IF;\n\t\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// ADAPTER ĐÃ NHẬN MOTION EXIT PCS\n\t\t//---------------------------------------------------------------------\n\t\tIF MotionAccepted AND xMotionRequestPending THEN\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txMotionActive := TRUE;\n\t\tEND_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// EXIT PCS HOÀN THÀNH\n\t\t//---------------------------------------------------------------------\n\t\tIF MotionDone AND xMotionActive THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\n\t\t\tRuntime.State := E_TrackingState.TRK_RELEASE_PCS;\n\t\n\t\tELSIF MotionError AND xMotionActive THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\n\t\t\tRuntime.Response.Error := TRUE;\n\t\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\n\t\tEND_IF;\n\n\n\t//=============================================================================\n\t// TRK_RELEASE_PCS — STATE 130\n\t//-----------------------------------------------------------------------------\n\t// Motion Exit PCS trong MCS đã hoàn thành.\n\t// Chờ SoftMotion xác nhận PCS_1 không còn được AxisGroup sử dụng.\n\t//=============================================================================\n\tE_TrackingState.TRK_RELEASE_PCS:\n\t\n\t\t// Tiếp tục giữ sản phẩm.\n\t\tVacuumCommand := xVacuumCaptured;\n\t\n\t\t// Không còn motion pending.\n\t\txMotionIssued := FALSE;\n\t\txMotionRequestPending := FALSE;\n\t\txMotionActive := FALSE;\n\t\n\t\t// Trong lúc InUse vẫn TRUE, giữ FB Track còn Execute.\n\t\txTrackExecute := TRUE;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// AXIS GROUP ĐÃ RỜI PCS_1\n\t\t//---------------------------------------------------------------------\n\t\tIF NOT fbTrackBelt.InUse THEN\n\t\n\t\t\t// Bây giờ mới được hạ Execute của MC_TrackConveyorBelt.\n\t\t\txTrackExecute := FALSE;\n\t\n\t\t\tRuntime.PCSInfo.Valid := FALSE;\n\t\t\tRuntime.PCSInfo.InUse := FALSE;\n\t\n\t\t\txExitPCSTargetValid := FALSE;\n\t\n\t\t\tIF UseExternalSelection THEN\n                Released := TRUE;\n                Runtime.Response.Done := TRUE;\n                Runtime.Response.Busy := FALSE;\n                Runtime.State := E_TrackingState.TRK_COMPLETE;\n            ELSE\n                Runtime.State := E_TrackingState.TRK_MOVE_SAFE_LEAVE;\n            END_IF;\n\t\n\t\t//---------------------------------------------------------------------\n\t\t// TRACK CONVEYOR BÁO LỖI\n\t\t//---------------------------------------------------------------------\n\t\tELSIF fbTrackBelt.Error THEN\n\t\n\t\t\tRuntime.Response.Error := TRUE;\n\t\t\tRuntime.Response.ErrorID := fbTrackBelt.ErrorID;\n\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\tEND_IF;\n\t\n\t//=============================================================================\n\t// TRK_MOVE_SAFE_LEAVE\n\t//-----------------------------------------------------------------------------\n\t// PCS đã được release hoàn toàn.\n\t// Robot thực hiện MoveL tới điểm an toàn tuyệt đối trong Robot Base.\n\t//\n\t// Config.LeavePos phải là một điểm đã được dạy và test bằng Jog/MoveL riêng.\n\t// Không tính bằng cách cộng offset từ TCP hiện tại.\n\t//=============================================================================\n\tE_TrackingState.TRK_MOVE_SAFE_LEAVE:\n\t\n\t\t// Tiếp tục giữ sản phẩm.\n\t\tVacuumCommand := xVacuumCaptured;\n\t\n\t\t// Không cho MC_TrackConveyorBelt hoạt động lại.\n\t\txTrackExecute := FALSE;\n\t\n\t\t// Tạo request motion một lần.\n\t\tIF NOT xMotionIssued\n\t\tAND NOT xMotionRequestPending\n\t\tAND NOT xMotionActive THEN\n\t\n\t\t\t// Điểm an toàn tuyệt đối trong Robot Base.\n\t\t\tMotionTarget := Config.LeavePos;\n\t\n\t\t\t// Thông số chuyển động Leave.\n\t\t\tMotionSpeed := Config.Motion.Leave.Speed;\n\t\t\tMotionAcceleration := Config.Motion.Leave.Acceleration;\n\t\t\tMotionDeceleration := Config.Motion.Leave.Deceleration;\n\t\t\tMotionJerk := Config.Motion.Leave.Jerk;\n\t\n\t\t\t// Không blend tại bước chuyển hệ tọa độ.\n\t\t\tMotionBlendRadius := 0.0;\n\t\n\t\t\t// Motion chạy trong Robot Base/MCS.\n\t\t\tMotionCoordSystem := E_AppCoordSystem.APP_COORD_ROBOT_BASE;\n\t\n\t\t\t// MoveL.\n\t\t\tMotionCommand := 2;\n\t\n\t\t\t// Phát yêu cầu tới Motion Adapter.\n\t\t\txMotionRequestPending := TRUE;\n\t\t\txMotionIssued := TRUE;\n\t\n\t\tEND_IF;\n\t\n\t\t// Motion Adapter đã nhận lệnh.\n\t\tIF MotionAccepted AND xMotionRequestPending THEN\n\t\t\txMotionRequestPending := FALSE;\n\t\t\txMotionActive := TRUE;\n\t\tEND_IF;\n\t\n\t\t// Điểm Safe Leave hoàn thành.\n\t\tIF MotionDone AND xMotionActive THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\n\t\t\tRuntime.State := E_TrackingState.TRK_MOVE_PLACE;\n\t\n\t\t// Motion Safe Leave báo lỗi.\n\t\tELSIF MotionError AND xMotionActive THEN\n\t\n\t\t\txMotionActive := FALSE;\n\t\t\txMotionIssued := FALSE;\n\t\t\txMotionRequestPending := FALSE;\n\t\n\t\t\tRuntime.Response.Error := TRUE;\n\t\t\tRuntime.Response.ErrorID := MotionErrorID;\n\t\n\t\t\tRuntime.State := E_TrackingState.TRK_ERROR;\n\t\n\t\tEND_IF;\n\t\t\n\n    //=========================================================================\n    // TRK_MOVE_PLACE\n    // Di chuyển từ LeavePos tới PlacePos trong hệ robot/base.\n    //=========================================================================\n    E_TrackingState.TRK_MOVE_PLACE:\n\n        // Giữ hút tới khi tới điểm đặt.\n        VacuumCommand := xVacuumCaptured;\n\n        // Tạo request Place mới.\n        IF NOT xMotionIssued AND NOT xMotionRequestPending AND NOT xMotionActive THEN\n\n            // Gán điểm Place.\n            MotionTarget := Config.PlacePos;\n\n            // Gán tốc độ Place.\n            MotionSpeed := Config.Motion.Place.Speed;\n\n            // Gán gia tốc Place.\n            MotionAcceleration := Config.Motion.Place.Acceleration;\n\n            // Gán giảm tốc Place.\n            MotionDeceleration := Config.Motion.Place.Deceleration;\n\n            // Gán jerk Place.\n            MotionJerk := Config.Motion.Place.Jerk;\n\n            // Gán blend Place.\n            MotionBlendRadius := Config.Motion.Place.BlendRadius;\n\n            // Place chạy trong hệ robot/base.\n            MotionCoordSystem := E_AppCoordSystem.APP_COORD_ROBOT_BASE;\n\n            // Mã lệnh MoveL.\n            MotionCommand := 2;\n\n            // Bật request pending.\n            xMotionRequestPending := TRUE;\n\n            // Đánh dấu đã tạo lệnh.\n            xMotionIssued := TRUE;\n        END_IF;\n\n        // Adapter đã nhận request.\n        IF MotionAccepted AND xMotionRequestPending THEN\n            xMotionRequestPending := FALSE;\n            xMotionActive := TRUE;\n        END_IF;\n\n        // Place hoàn thành.\n        IF MotionDone AND xMotionActive THEN\n            xMotionActive := FALSE;\n            xMotionIssued := FALSE;\n\n            Runtime.State := E_TrackingState.TRK_RELEASE_PRODUCT;\n\n        // Place lỗi.\n        ELSIF MotionError AND xMotionActive THEN\n            xMotionActive := FALSE;\n\n            Runtime.Response.Error := TRUE;\n            Runtime.Response.ErrorID := MotionErrorID;\n\n            Runtime.State := E_TrackingState.TRK_ERROR;\n        END_IF;\n\n    //=========================================================================\n    // TRK_RELEASE_PRODUCT\n    // Tắt hút, bật thổi và chuẩn bị timer.\n    //=========================================================================\n    E_TrackingState.TRK_RELEASE_PRODUCT:\n\n        // Tắt hút để nhả sản phẩm.\n        VacuumCommand := FALSE;\n\n        // Bật van thổi.\n        BlowCommand := TRUE;\n\n        // Reset timer thổi trước khi vào state chờ.\n        tonBlow(IN := FALSE);\n\n        // Chuyển sang chờ đủ thời gian thổi.\n        Runtime.State := E_TrackingState.TRK_WAIT_BLOW;\n\n    //=========================================================================\n    // TRK_WAIT_BLOW\n    // Giữ thổi trong Config.BlowTime.\n    //=========================================================================\n    E_TrackingState.TRK_WAIT_BLOW:\n\n        // Bảo đảm hút tắt.\n        VacuumCommand := FALSE;\n\n        // Giữ van thổi bật.\n        BlowCommand := TRUE;\n\n        // Chạy timer thổi.\n        tonBlow(\n            IN := TRUE,\n            PT := Config.BlowTime\n        );\n\n        // Khi hết thời gian thổi.\n        IF tonBlow.Q THEN\n            // Reset timer.\n            tonBlow(IN := FALSE);\n\n            // Tắt thổi.\n            BlowCommand := FALSE;\n\n            // Đánh dấu object đã PICKED.\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_PICKED;\n\n            // Giải phóng cờ Reserved.\n            Queue.Objects[Runtime.SelectedObjectIndex].Reserved := FALSE;\n\n            // Giải phóng ActiveIndex.\n            Queue.ActiveIndex := GVL.C_INVALID_INDEX;\n\n            // Báo gắp thành công.\n            Runtime.PickSuccess := TRUE;\n\n            // Xóa object active trong Runtime.\n            Runtime.SelectedObjectIndex := 0;\n            Runtime.SelectedObjectID := 0;\n\n            // Xóa trạng thái đã giữ vật.\n            xVacuumCaptured := FALSE;\n\n            // Phát Done.\n            Runtime.Response.Done := TRUE;\n\n            // Chuyển sang Complete.\n            Runtime.State := E_TrackingState.TRK_COMPLETE;\n        END_IF;\n\n    //=========================================================================\n    // TRK_COMPLETE\n    // Kết thúc một object; nếu Execute còn TRUE thì tìm object tiếp theo.\n    //=========================================================================\n    E_TrackingState.TRK_COMPLETE:\n\n        // Chu trình một object đã hoàn thành.\n\t\tRuntime.Response.Busy := FALSE;\n\t\tRuntime.Response.Done := TRUE;\n\t\n\t\t// Giữ output ở trạng thái an toàn.\n\t\tVacuumCommand := FALSE;\n\t\tBlowCommand := FALSE;\n\t\n\t\t// Chỉ về IDLE khi tầng Command Engine hạ Execute.\n\t\tIF NOT Execute THEN\n\t\t\tRuntime.Response.Accepted := FALSE;\n\t\t\tRuntime.Response.Done := FALSE;\n\t\t\tRuntime.State := E_TrackingState.TRK_IDLE;\n\t\tEND_IF;\n\n\n    //=========================================================================\n    // TRK_ABORT_ACTIVE\n    // Hủy motion vì object vượt vùng trước khi VacuumOK.\n    //=========================================================================\n    E_TrackingState.TRK_ABORT_ACTIVE:\n\n        // Tắt hút vì chưa giữ được vật.\n        VacuumCommand := FALSE;\n\n        // Tắt thổi.\n        BlowCommand := FALSE;\n\n        // Bật yêu cầu abort motion.\n        MotionAbort := TRUE;\n\n        // Khi Motion Manager xác nhận abort hoàn tất.\n        IF MotionAbortDone THEN\n            // Hạ yêu cầu abort.\n            MotionAbort := FALSE;\n\n            // Xóa trạng thái motion.\n            xMotionIssued := FALSE;\n            xMotionRequestPending := FALSE;\n            xMotionActive := FALSE;\n\n            // Nếu PCS không còn InUse thì có thể tắt tracking.\n            IF NOT fbTrackBelt.InUse THEN\n                xTrackExecute := FALSE;\n\n                // Chuyển sang vị trí an toàn.\n                Runtime.State := E_TrackingState.TRK_MOVE_SAFE;\n            END_IF;\n        END_IF;\n\n    //=========================================================================\n    // TRK_MOVE_SAFE\n    // Đưa robot về LeavePos sau khi bỏ object.\n    //=========================================================================\n    E_TrackingState.TRK_MOVE_SAFE:\n\n        // Tắt hút.\n        VacuumCommand := FALSE;\n\n        // Tạo request Move Safe.\n        IF NOT xMotionIssued AND NOT xMotionRequestPending AND NOT xMotionActive THEN\n\n            // Dùng LeavePos làm điểm an toàn.\n            MotionTarget := Config.LeavePos;\n\n            // Dùng thông số Leave.\n            MotionSpeed := Config.Motion.Leave.Speed;\n\n            MotionAcceleration := Config.Motion.Leave.Acceleration;\n\n            MotionDeceleration := Config.Motion.Leave.Deceleration;\n\n            MotionJerk := Config.Motion.Leave.Jerk;\n\n            MotionBlendRadius := Config.Motion.Leave.BlendRadius;\n\n            // Chạy trong hệ robot/base.\n            MotionCoordSystem := E_AppCoordSystem.APP_COORD_ROBOT_BASE;\n\n            // Mã lệnh MoveL.\n            MotionCommand := 2;\n\n            // Bật request pending.\n            xMotionRequestPending := TRUE;\n\n            // Đánh dấu đã tạo lệnh.\n            xMotionIssued := TRUE;\n        END_IF;\n\n        // Adapter đã nhận request.\n        IF MotionAccepted AND xMotionRequestPending THEN\n            xMotionRequestPending := FALSE;\n            xMotionActive := TRUE;\n        END_IF;\n\n        // Move Safe hoàn thành.\n        IF MotionDone AND xMotionActive THEN\n            xMotionActive := FALSE;\n            xMotionIssued := FALSE;\n\n            Runtime.State := E_TrackingState.TRK_RELEASE_OBJECT;\n\n        // Move Safe lỗi.\n        ELSIF MotionError AND xMotionActive THEN\n            xMotionActive := FALSE;\n\n            Runtime.Response.Error := TRUE;\n            Runtime.Response.ErrorID := MotionErrorID;\n\n            Runtime.State := E_TrackingState.TRK_ERROR;\n        END_IF;\n\n    //=========================================================================\n    // TRK_RELEASE_OBJECT\n    // Giải phóng object MISSED và tiếp tục object kế tiếp.\n    //=========================================================================\n    E_TrackingState.TRK_RELEASE_OBJECT:\n\n        // Tắt hút.\n        VacuumCommand := FALSE;\n\n        // Chỉ release khi PCS không còn InUse.\n        IF NOT fbTrackBelt.InUse THEN\n            // Tắt tracking PCS.\n            xTrackExecute := FALSE;\n\n            // Kiểm tra index trước khi truy cập Queue.\n            IF Runtime.SelectedObjectIndex >= 1 AND Runtime.SelectedObjectIndex <= GVL.C_MAX_TRACK_OBJECTS THEN\n\n                // Giải phóng object.\n                Queue.Objects[Runtime.SelectedObjectIndex].Reserved := FALSE;\n            END_IF;\n\n            // Giải phóng ActiveIndex.\n            Queue.ActiveIndex := GVL.C_INVALID_INDEX;\n\n            // Xóa object active trong Runtime.\n            Runtime.SelectedObjectIndex := 0;\n            Runtime.SelectedObjectID := 0;\n\n            // Xóa thông tin PCS.\n            Runtime.PCSInfo.Valid := FALSE;\n            Runtime.PCSInfo.InUse := FALSE;\n\n            // Xóa trạng thái tool.\n            xVacuumCaptured := FALSE;\n\n            // Xóa trạng thái motion.\n            xMotionIssued := FALSE;\n            xMotionRequestPending := FALSE;\n            xMotionActive := FALSE;\n\n            // Tiếp tục tìm object khác.\n            Runtime.State := E_TrackingState.TRK_FIND_OBJECT;\n        END_IF;\n\n    //=========================================================================\n    // TRK_ABORTING\n    // Hủy toàn ứng dụng khi Execute bị hạ.\n    //=========================================================================\n    E_TrackingState.TRK_ABORTING:\n\n        // Tắt hút.\n        VacuumCommand := FALSE;\n\n        // Tắt thổi.\n        BlowCommand := FALSE;\n\n        // Yêu cầu abort motion.\n        MotionAbort := TRUE;\n\n        // Nếu có object active thì đánh dấu ABORTED.\n        IF Runtime.SelectedObjectIndex >= 1 AND Runtime.SelectedObjectIndex <= GVL.C_MAX_TRACK_OBJECTS THEN\n\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_ABORTED;\n\n            Queue.Objects[Runtime.SelectedObjectIndex].Reserved := FALSE;\n        END_IF;\n\n        // Khi abort motion xong và PCS không còn InUse.\n        IF MotionAbortDone AND NOT fbTrackBelt.InUse THEN\n\n            // Hạ abort.\n            MotionAbort := FALSE;\n\n            // Tắt tracking PCS.\n            xTrackExecute := FALSE;\n\n            // Giải phóng ActiveIndex.\n            Queue.ActiveIndex := GVL.C_INVALID_INDEX;\n\n            // Xóa object active.\n            Runtime.SelectedObjectIndex := 0;\n            Runtime.SelectedObjectID := 0;\n\n            // Xóa Busy và Accepted.\n            Runtime.Response.Busy := FALSE;\n            Runtime.Response.Accepted := FALSE;\n\n            // Về IDLE.\n            Runtime.State := E_TrackingState.TRK_IDLE;\n        END_IF;\n\n    //=========================================================================\n    // TRK_ERROR\n    // Giữ lỗi để Application Manager/HMI đọc.\n    //=========================================================================\n    E_TrackingState.TRK_ERROR:\n\n        // Manager không còn xử lý bình thường.\n        Runtime.Response.Busy := FALSE;\n\n        // Giữ cờ Error.\n        Runtime.Response.Error := TRUE;\n\n        // Tắt hút.\n        VacuumCommand := FALSE;\n\n        // Tắt thổi.\n        BlowCommand := FALSE;\n\n        // Yêu cầu abort motion.\n        MotionAbort := TRUE;\n\n        // Nếu có object active thì đánh dấu ERROR.\n        IF Runtime.SelectedObjectIndex >= 1 AND Runtime.SelectedObjectIndex <= GVL.C_MAX_TRACK_OBJECTS THEN\n\n            Queue.Objects[Runtime.SelectedObjectIndex].State := E_TrackingObjectState.OBJ_ERROR;\n\n            Queue.Objects[Runtime.SelectedObjectIndex].Reserved := FALSE;\n        END_IF;\n\n        // Chỉ tắt tracking khi PCS không còn InUse.\n        IF NOT fbTrackBelt.InUse THEN\n            xTrackExecute := FALSE;\n        END_IF;\n\n    //=========================================================================\n    // STATE KHÔNG HỢP LỆ\n    //=========================================================================\n    ELSE\n        // Báo lỗi state không hợp lệ.\n        Runtime.Response.Error := TRUE;\n\n        // Mã lỗi nội bộ cho state không hợp lệ.\n        Runtime.Response.ErrorID := 6999;\n\n        // Chuyển về TRK_ERROR.\n        Runtime.State := E_TrackingState.TRK_ERROR;\n\nEND_CASE;","LineInfoPersistence":"(string)4bc482a8-7164-42b1-aff0-a2f929fd8eb8_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK FB_CONVEYOR_TRACKING_MANAGER\nVAR_INPUT\n    Execute : BOOL;\n    Reset : BOOL;\n    Config : ST_TRACKING_CONFIG;\n    ConveyorConfig : ST_CONVEYOR_CONFIG;\n    ConveyorStatus : ST_CONVEYOR_STATUS;\n    ConveyorOrigin : MC_COORD_REF;\n    VacuumOK : BOOL;\n    MotionAccepted : BOOL;\n    MotionBusy : BOOL;\n    MotionDone : BOOL;\n    MotionError : BOOL;\n    MotionErrorID : UDINT;\n    MotionAbortDone : BOOL;\n    TestFixedObjectMode : BOOL;\n    FixedObjectPosition : MC_COORD_REF;\n\n    // Multi-tool external control.\n    UseExternalSelection : BOOL;\n    ExternalObjectIndex : UINT;\n    ExternalPickOffset : ST_POS;\n    ExternalApproachHeight : REAL;\n    PickerSafe : BOOL;\n\tExternalUseUpDown : BOOL;\n\tExternalUpDownStroke : REAL;\n\t// Chiều cao mặt cần hút của sản phẩm.\n\t// Được lấy từ Recipe khi chạy MultiTool.\n\tExternalPickSurfaceHeightMM : REAL;\nEND_VAR\n\nVAR_OUTPUT\n    VacuumCommand : BOOL;\n    BlowCommand : BOOL;\n    TrackingActive : BOOL;\n    MotionRequest : BOOL;\n    MotionAbort : BOOL;\n    MotionTarget : ST_POS;\n    MotionSpeed : REAL;\n    MotionAcceleration : REAL;\n    MotionDeceleration : REAL;\n    MotionJerk : REAL;\n    MotionBlendRadius : REAL;\n    MotionCoordSystem : E_AppCoordSystem;\n    MotionCommand : UINT;\n\n    // Multi-tool handshake.\n    SyncOK : BOOL;\n    Released : BOOL;\nEND_VAR\n\nVAR_IN_OUT\n    Queue : ST_TRACKING_QUEUE;\n    Runtime : ST_TRACKING_RUNTIME;\nEND_VAR\n\nVAR\n    fbTrackBelt : MC_TrackConveyorBelt;\n    xTrackExecute : BOOL;\n    uiSelectedIndex : UINT;\n    stSelectedObject : ST_TRACKING_OBJECT;\n    xMotionIssued : BOOL;\n    xMotionRequestPending : BOOL;\n    xMotionActive : BOOL;\n    xVacuumCaptured : BOOL;\n    tonPickDelay : TON;\n    tonVacuumTimeout : TON;\n    tonBlow : TON;\n    stConveyorOriginSMC : MC_COORD_REF;\n    stInitialObjectSMC : MC_COORD_REF;\n    stExitPCSTarget : ST_POS;\n    xExitPCSTargetValid : BOOL := FALSE;\n    rExitPCSOffsetZ : REAL := 5.0;\n\trExitPCSOffsetX : REAL := 15.0;\n    rExitPCSMaxZ : REAL := 320.0;\n\tstToolSyncPos : ST_POS;\n\txPickPositionReady : BOOL;\n\txPickerSafeArmed : BOOL;\n\txMotionDoneArmed : BOOL;\n\txPickMotionBusySeen : BOOL; //xác nhận lệnh xuống Pick thực sự chạy.\n\txRetractMotionBusySeen : BOOL; // xác nhận lệnh nâng Retract thực sự chạy.\n\tlrConveyorDeltaAtPCS : LREAL;\nEND_VAR\nVAR\n    // TRUE khi đã chụp vị trí Conveyor cho lần tạo PCS hiện tại.\n    xPCSStartCaptured : BOOL;\n\n    // Vị trí Conveyor tại thời điểm chuẩn bị phát cạnh Track Execute.\n    lrConveyorPosAtPCSStart : LREAL;\n\n    // Conveyor đã dịch từ lúc Object được Sensor/Vision Capture tới lúc tạo PCS.\n    lrDeltaCaptureToPCS : LREAL;\nEND_VAR","LineInfoPersistence":"(string)4bc482a8-7164-42b1-aff0-a2f929fd8eb8_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)1998","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}