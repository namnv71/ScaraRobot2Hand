able_1: MC_GroupEnable;\n\tMC_GroupEnable_2: MC_GroupEnable;\n\tMC_GroupReset_1: MC_GroupReset;\n\tMC_GroupReset_2: MC_GroupReset;\n\tMC_Power_R: MC_Power;\n\tMC_Home_R_MAIN : MC_Home;\n\tMC_Reset_R: MC_Reset;\n\tMC_Reset_M1: MC_Reset;\n\tMC_Reset_M2: MC_Reset;\n\tMC_Reset_M3: MC_Reset;\n\tMC_Reset_M4: MC_Reset;\n\t\n\t\n\t//IdError: SM3_Robotics.SMC_ERROR;\n\tMC_Reset_M21: MC_Reset;\n\tMC_Reset_M22: MC_Reset;\n\tMC_Reset_M23: MC_Reset;\n\tMC_Reset_M24: MC_Reset;\n\t//RBA_compatibiloty: SM3_Robotics.SMC_AXIS_GROUP_COMPATIBILITY_OPTIONS;\n\t//RBb_compatibiloty: SM3_Robotics.SMC_AXIS_GROUP_COMPATIBILITY_OPTIONS;\n\tMC_GroupDisable_1: MC_GroupDisable;\n\tMC_GroupDisable_2: MC_GroupDisable;\n\t\n\t\n\tSMC_GroupSetAxisLimitFactors_A: SMC_GroupSetAxisLimitFactors;\n\tVEL_A , ACC_A, DEC_A, JERK_A, TORQUE_A : ARRAY [0..(SMC_RCNST.MAX_AXES - 1)] OF LREAL;\n\tSMC_GroupSetAxisLimitFactors_B: SMC_GroupSetAxisLimitFactors;\n\tVEL_B , ACC_B, DEC_B, JERK_B, TORQUE_B : ARRAY [0..(SMC_RCNST.MAX_AXES - 1)] OF LREAL;\n\n\tMC_Power_AX6: MC_Power;\n\tMC_ReadActualPosition_AX6: MC_ReadActualPosition;\n\tMC_TrackConveyorBelt_0: MC_TrackConveyorBelt;\n\tMC_ReadActualVelocity_AX6: MC_ReadActualVelocity;\n\tMC_ReadActualPosition_0: MC_ReadActualPosition;\n\tSMC_GroupSetPathTolerance_0: SMC_GroupSetPathTolerance;\n\tMC_Power_0: MC_Power;\n\tMC_MoveVelocity_0: MC_MoveVelocity;\n\tMC_Reset_AX6: MC_Reset;\nEND_VAR\nVAR\n\t\n\tRB_A_POWER_ON, RB_B_POWER_ON : BOOL;\n\tR_POWER_ON: BOOL;\n\tCASE_A_ON, CASE_A_OFF, CASE_B_ON, CASE_B_OFF, CASE_R_ON, CASE_R_OFF : INT;\n\n\t\n\tI : INT;\n\tbResetEtherCAT: BOOL;\n\t\n\tstMaxAxisLag : TRAFO.AXISPOS_REF;\n\tJ1_PosError,J2_PosError,J1_VelError,J2_VelError: LREAL;\nEND_VAR\n","LineInfoPersistence":"(string)c00f9ee8-970d-4983-83b8-3aaea5126e60_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)71","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{