{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)d391eff8-a9e4-49dd-9f70-ef320a1345ed","ParentGuid":"(Guid)e8af2abb-8523-4b22-86d2-5a09e65c321b","Name":"(string)ACT_TCP_Sever","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Modbus_TCP_slave_0(en := TRUE,\n\t\t\t\t\tiniID := 1,\n\t\t\t\t\tport\t:= 1010,\n\t\t\t\t\tTCP_UDP\t:= \t0,\n\t\t\t\t\tDelayRespTime := 300,\n\t\t\t\t\tconnected =>,\n\t\t\t\t\terrID =>,\n\t\t\t\t\tInfo\t=>,\n\t\t\t\t\terrTotal =>);\nslaveRegisters_0(\tiniID := 1,\n\t\t\t\t\tmodeTCP_RTU := 0,\n\t\t\t\t\tstartAddr := 0,\n\t\t\t\t\ttotal\t\t:= 2000,\n\t\t\t\t\ttrans_data\t:= DATA,\n\t\t\t\t\terrId =>,\n\t\t\t\t\tInfo\t=>,\n\t\t\t\t\tCMDTimes\t=>);\n\t\t\t\t\t\n\n//Enable_Modbus_Camera[1] := TRUE;\nFOR uiCamera := 1 TO GVL.C_MAX_VISION_CHANNELS DO\n\tIF (GVL.g_aVisionConfig[uiCamera].Enable) THEN\n\t\tiCameraBase := (UINT_TO_INT(uiCamera) - 1) * 300;\n\t\n\t\t// Robot -> Vision: chỉ ghi 100 register đầu của Camera.\n\t\tFOR id := 0 TO 99 DO\n\t\t\tDATA[iCameraBase + id] := TO_INT(GVL.MODBUS[iCameraBase + id]);\n\t\tEND_FOR;\n\t\n\t\t// Vision -> Robot: chỉ đọc 200 register sau của Camera.\n\t\tFOR id2 := 100 TO 299 DO\n\t\t\tGVL.MODBUS[iCameraBase + id2] := TO_WORD(DATA[iCameraBase + id2]);\n\t\tEND_FOR;\n\tEND_IF;\nEND_FOR;\n\n// User Modbus\nFOR id := 1200 TO 1599 DO\n\tDATA[id] := TO_INT(GVL.MODBUS[id]);\nEND_FOR;\n\n// Vision -> Robot: chỉ đọc 200 register sau của Camera.\nFOR id2 := 1600 TO 1999 DO\n\tGVL.MODBUS[id2] := TO_WORD(DATA[id2]);\nEND_FOR;\n\n// iCameraBase := 0;\n// \t\n// // Robot -> Vision: chỉ ghi 100 register đầu của Camera.\n// FOR id := 0 TO 99 DO\n// \tDATA[iCameraBase + id] := TO_INT(GVL.MODBUS[iCameraBase + id]);\n// END_FOR;\n// \n// // Vision -> Robot: chỉ đọc 200 register sau của Camera.\n// FOR id2 := 100 TO 299 DO\n// \tGVL.MODBUS[iCameraBase + id2] := TO_WORD(DATA[iCameraBase + id2]);\n// END_FOR;\n// \n// FOR id3 := 1500 TO 1999 DO\n// \tGVL.MODBUS[id3] := TO_WORD(DATA[id3]);   // luôn cập nhật\n// END_FOR;\n\n\nModbus_TCP_slave_1(en := FALSE,\n\t\t\t\t\tiniID := 2,\n\t\t\t\t\tport\t:= 1012,\n\t\t\t\t\tTCP_UDP\t:= \t0,\n\t\t\t\t\tDelayRespTime := 300,\n\t\t\t\t\tconnected =>,\n\t\t\t\t\terrID =>,\n\t\t\t\t\tInfo\t=>,\n\t\t\t\t\terrTotal =>);\nslaveRegisters_1(\tiniID := 2,\n\t\t\t\t\tmodeTCP_RTU := 0,\n\t\t\t\t\tstartAddr := 0,\n\t\t\t\t\ttotal\t\t:= 2000,\n\t\t\t\t\ttrans_data\t:= DATA1,\n\t\t\t\t\terrId =>,\n\t\t\t\t\tInfo\t=>,\n\t\t\t\t\tCMDTimes\t=>);","LineInfoPersistence":"(string)d391eff8-a9e4-49dd-9f70-ef320a1345ed_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)80"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}