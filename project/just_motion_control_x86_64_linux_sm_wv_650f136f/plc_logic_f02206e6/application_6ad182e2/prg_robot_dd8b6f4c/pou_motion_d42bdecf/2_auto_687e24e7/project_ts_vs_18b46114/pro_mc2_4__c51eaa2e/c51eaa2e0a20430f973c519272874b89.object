{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c51eaa2e-0a20-430f-973c-519272874b89","ParentGuid":"(Guid)d42bdecf-5947-4894-8152-45755ded5bed","Name":"(string)Pro_MC2_4_","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)18b46114-a94e-4006-a545-5f4f21244051"}]}}}}]},"TypeGuid":"(Guid)8ac092e5-3128-4e26-9e7e-11016c6684f2","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"8ac092e5","@Value":{"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)Ton_OK_MC2_4(PT := T#5S);\nT_MC2_4(PT := T#1S, Q =>, ET =>);\nTon_Limit_Test_VS(PT := T#20S);\nCASE Pro_MC2_4 OF\n\t\t0: // Check Data\n\t\t\tT_MC2_4.IN := FALSE;\n\t\t\tTon_Limit_Test_VS.IN := FALSE;\n\t\t\t//GVL.Pro4_.Process.DATA_MC_VS := 0;\n\t\t\tTon_OK_MC2_4.IN := FALSE;\n\t\t\tPro_MC2_4 := 5;\n\t\t5:\n\t\t\tT_MC2_4.IN := FALSE;\n\t\t\tCASE GVL.Pro4_.Process.DATA_MC_VS OF\n\t\t\t\t0 : // None\n\t\t\t\t\tPro_MC2_4 := 10;\n\t\t\t\t1: // Busy - checking\n\t\t\t\t\tPro_MC2_4 := 20;\n\t\t\t\t2: // Allow Place\n\t\t\t\t\tPro_MC2_4 := 30;\n\t\t\t\t3: // Allow Pick OK\n\t\t\t\t\tPro_MC2_4 := 40;\n\t\t\t\t4: // Allow Pick NG\n\t\t\t\t\tPro_MC2_4 := 50;\n\t\t\t\t5: // Allow Pick NG - TS\n\t\t\t\t\tPro_MC2_4 := 60;\n\t\t\tEND_CASE;\n\t\t10: // init - Stop - cylinder press UP\n\t\t\t\n\t\t\t// IF NOT GVL.Pro4_.Signal_In.T_Vs_detect.Q THEN\n\t\t\t// namnv\n\t\t\tIF GVL.Pro4_.Signal_In.T_Vs_detect.Q THEN\n\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 2 ; // allow place\n\t\t\t\tPro_MC2_4 := 5;\n\t\t\tEND_IF;\n\t\t20: // Checking\n\t\t\tTon_OK_MC2_4.IN := TRUE;\n\t\t\tT_MC2_4.IN := TRUE;\n\t\t\tTon_Limit_Test_VS.IN := TRUE;\n\t\t\t// namnv them dieu kien xac nhan Pass - Fail: Phai co tin hieu jig o ben ngoai :  AND GVL.Pro4_.Signal_In.T_Vs_detect.Q \n\t\t\tIF  T_MC2_4.q AND ( GVL.Pro4_.Signal_In.T_Vs_Pass.Q) AND GVL.Pro4_.Signal_In.T_Vs_detect.Q THEN\n\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 3 ;\n\t\t\t\t//GVL.Pro4_.Process.DATA_MC_VS := 4 ;  // namnv\n\t\t\t\tPro_MC2_4  := 5;\n\t\t\t\t// namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_2 := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out_2 := TRUE;\n\t\t\tELSIF T_MC2_4.q AND GVL.Pro4_.Signal_In.T_Vs_Fail.Q AND GVL.Pro4_.Signal_In.T_Vs_detect.Q THEN\n\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := FALSE;\n\t\t\t\t//GVL.Pro4_.Process.DATA_MC_VS := 3 ; // namnv\n\t\t\t\tIF ((GVL.Pro4_.ST_MC.Mode_Dry OR GVL.Pro4_.ST_MC.Mode_Auto_Pass_Vs)) THEN\n\t\t\t\t\tIF Ton_OK_MC2_4.Q THEN\n\t\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 3 ;\n\t\t\t\t\tEND_IF;\n\t\t\t\tELSE\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 4 ;\n\t\t\t\tEND_IF\n\t\t\t\t\n\t\t\t\tPro_MC2_4  := 5;\n\t\t\t\t// namnv1104\n\t\t\t\tMonitor_Production.Pulse_In_2 := FALSE;\n\t\t\t\tMonitor_Production.Pulse_Out_2 := TRUE;\n\t\t\tEND_IF\n\t\n\t\t30: // Place\n\t\t\t//IF GVL.Pro4_.Process.DATA_TOOL_A1_IN = 0 AND Place_OK_A4_T1_Finish  OR Place_NG_A4_T1_Finish THEN\n\t\t\t// namnv - bo dieu kien dat hang NG\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A1_IN = 0 AND ( Place_OK_A4_T1_Finish OR PRO_A4_[2] >= 80) THEN\n\t\t\t\t//GVL.Pro4_.Auto.Vs_On_Off := TRUE; // bat test vision\n\t\t\t\t//GVL.Pro4_.Process.DATA_MC_VS := 1 ;\n\t\t\t\t//namnv them trang thai tool\n\t\t\t\tIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD = 3) THEN\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 5;\n\t\t\t\tELSIF (GVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD = 2) THEN\n\t\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 1 ;\n\t\t\t\t\tIF (GVL.Pro4_.ST_MC.Mode_Dry) THEN\n\t\t\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := FALSE; // bat test vision\n\t\t\t\t\tELSE\n\t\t\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := TRUE; // bat test vision\n\t\t\t\t\tEND_IF\n\t\t\t\t\t\n\t\t\t\t\t// namnv1104\n\t\t\t\t\tMonitor_Production.Pulse_In_2 := TRUE;\n\t\t\t\t\tMonitor_Production.Pulse_Out_2 := FALSE;\n\t\t\t\tEND_IF\n\t\t\t\t// namnv - dieu kien tat tin hieu test vision\n\t\t\t\tIF GVL.Pro4_.Auto.Vs_On_Off  AND (GVL.Pro4_.Process.DATA_MC_VS = 1) THEN\n\t\t\t\t\tIF NOT GVL.Pro4_.Signal_In.T_Vs_detect.Q  THEN\n\t\t\t\t\t\tGVL.Pro4_.Auto.Vs_On_Off := FALSE;\n\t\t\t\t\t\tPro_MC2_4 := 5;\n\t\t\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := 0;\n\t\t\t\t\tELSE\n\t\t\t\t\t\t//log\n\t\t\t\t\tEND_IF\n\t\t\t\tELSE\n\t\t\t\t\tPro_MC2_4 := 5;\n\t\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := 0;\n\t\t\t\tEND_IF;\n\t\t\t\t\n\t\t\tEND_IF\n\t\t40:\t// Pick OK\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A2_OUT  = 2 AND Pick_A4_T2_Finish  THEN\n\t\t\t\t//GVL.Pro4_.Process.DATA_TOOL_A2_OUT := 2;\n\t\t\t\tTon_OK_MC2_4.IN := FALSE;\n\t\t\t\tTon_Limit_Test_VS.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 0;\n\t\t\t\tPro_MC2_4 := 5;\n\t\t\tEND_IF\t\n\t\t50: // Pick NG\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A2_OUT  = 3 AND Pick_A4_T2_Finish  THEN\n\t\t\t\t//GVL.Pro4_.Process.DATA_TOOL_A2_OUT := 3;\n\t\t\t\tTon_OK_MC2_4.IN := FALSE;\n\t\t\t\tTon_Limit_Test_VS.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 0;\n\t\t\t\tPro_MC2_4 := 5;\n\t\t\tEND_IF\n\t\t\t\n\t\t60: // Pick NG - TS\n\t\t\tIF GVL.Pro4_.Process.DATA_TOOL_A2_OUT  = 4 AND Pick_A4_T2_Finish  THEN\n\t\t\t\t//GVL.Pro4_.Process.DATA_TOOL_A2_OUT := 3;\n\t\t\t\tTon_OK_MC2_4.IN := FALSE;\n\t\t\t\tTon_Limit_Test_VS.IN := FALSE;\n\t\t\t\tGVL.Pro4_.Process.DATA_MC_VS := 0;\n\t\t\t\tGVL.Pro4_.Process.DATA_TOOL_A1_IN_OLD := 0;\n\t\t\t\tPro_MC2_4 := 5;\n\t\t\tEND_IF\n\tEND_CASE","LineInfoPersistence":"(string)c51eaa2e-0a20-430f-973c-519272874b89_Impl_LineIds"}}}},"UniqueIdGenerator":"(string)128"}},"TypeInfos":{"3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","8ac092e5":"{8ac092e5-3128-4e26-9e7e-11016c6684f2}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}