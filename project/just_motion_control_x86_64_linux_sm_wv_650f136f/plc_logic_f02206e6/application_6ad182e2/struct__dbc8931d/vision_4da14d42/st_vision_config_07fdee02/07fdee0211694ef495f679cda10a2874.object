{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)07fdee02-1169-4ef4-95f6-79cda10a2874","ParentGuid":"(Guid)6ad182e2-ce46-4dff-8808-e828b3f27822","Name":"(string)ST_VISION_CONFIG","Properties":{"@Type":"2c41fa04:IDictionary","@Value":[{"@Key":"(Guid)829a18f2-c514-4f6e-9634-1df173429203","@Value":{"@Type":"829a18f2","@Value":{"ParentObjects":{"@Type":"fa2ee218:IDictionary","@Value":[{"@Key":"(Guid)d9b2b2cc-ea99-4c3b-aa42-1e5c49e65b84","@Value":"(Guid)4da14d42-d241-4712-a403-b48098f8db54"}]}}}}]},"TypeGuid":"(Guid)2db5746d-d284-4425-9f7f-2663a34b0ebc","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","829a18f2":"{829a18f2-c514-4f6e-9634-1df173429203}","fa2ee218":"{fa2ee218-a39b-4b6d-b249-49dbddbd168a}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"2db5746d","@Value":{"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)TYPE ST_VISION_CONFIG :\nSTRUCT\n    Enable              : BOOL;     // Cho phép sử dụng camera.\n    SimulationMode      : BOOL;     // TRUE khi dùng dữ liệu mô phỏng.\n\n    CameraID            : UINT;     // ID camera.\n\t\n\tRobot : E_VisionRobot;    // Tay Robot được phép sử dụng Camera này.\n\t\n    BaseAddress         : UINT;     // Địa chỉ Modbus bắt đầu của camera.\n\n    CommandOffset       : UINT;     // Offset vùng lệnh PLC gửi vision.\n    StatusOffset        : UINT;     // Offset vùng trạng thái vision.\n    HeaderOffset        : UINT;     // Offset vùng header kết quả.\n    DataOffset          : UINT;     // Offset vùng dữ liệu kết quả.\n\n    PositionScale       : REAL;     // Hệ số chuyển dữ liệu vị trí thành mm.\n    AngleScale          : REAL;     // Hệ số chuyển dữ liệu góc thành độ.\n    ScoreScale          : REAL;     // Hệ số chuyển score thô thành giá trị thực.\n\n    TriggerTimeout      : TIME;     // Thời gian tối đa chờ vision nhận trigger.\n    ResultTimeout       : TIME;     // Thời gian tối đa chờ kết quả.\n    BlockTimeout        : TIME;     // Thời gian tối đa chờ một block dữ liệu.\n\n    MaxPointCount       : UINT;     // Số điểm tối đa camera được phép trả.\n    MaxRetry            : UINT;     // Số lần chụp lại tối đa.\n\n    CameraToRobot       : ST_Transform2D;\n    // Phép biến đổi từ hệ tọa độ camera sang hệ robot.\n\t\nEND_STRUCT\nEND_TYPE","LineInfoPersistence":"(string)07fdee02-1169-4ef4-95f6-79cda10a2874_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)32"}},"TypeInfos":{"2db5746d":"{2db5746d-d284-4425-9f7f-2663a34b0ebc}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}